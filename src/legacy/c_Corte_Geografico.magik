_package user
$
#remex(:c_Corte_Geografico)
$
def_slotted_exemplar(:c_Corte_Geografico,
		      {
			      {:oApp,smallworld_product.pni_application()},# Objeto que representa la aplicación

			      {:oAppLayout,_unset}, #Objeto que contiene el plugin :viewport_mapper del layout_designer
			      {:oRwoArranque,_unset},#Objeto que representa el elemento a partir del cual se creará un corte geo.
			      {:oMapPlugin,_unset}   #Objeto que contiene la vista del mapa actual, misma que se obtiene de :map_plugin
		      },{:layout_element,:layout_element_mixin,:viewport_layout_mixin} )
$

