_method c_Corte_Geografico.defined_attributes
## Objetivo: Contar con un método para definir los atributos que mostrará
##	    el  layout_element en diseño.
## Parámetros de entrada:  NA
## Parámetros de salida:   NA
## Regresa: Un vector de atributos
## Fecha de última modificación: 23/12/2004
## Autor de la modificación : jesalaza
## Descripción de la modificación: Se documentó
	## 
	## 
	attribs << rope.new_from( _super.defined_attributes)
	attribs.add ( _self.viewport_attribute_definition )
	attribs.add ( layout_attribute_definition.new(:Dibuja_Calles?, :string,
						      :description, "Dibuja Calles",
						      :default_value, "Si",
						      :allowed_on_properties_page?, _true,
						      :enum_method, :metodo1,
						      :editor, _unset))
	>> attribs
_endmethod
$ 
c_Corte_Geografico.define_attributes ()
$


_pragma(classify_level=restricted, usage={redefinable})
_method c_Corte_Geografico.Opciones
## Objetivo: Definir las opciones que se usarán en los
##           comboboxes que apliquen del layout element.
## Parámetros de entrada:  NA
## Parámetros de salida:   NA
## Regresa: Un vector con las opciones SI o NO
## Fecha de última modificación: 23/12/2004
## Autor de la modificación : jesalaza
## Descripción de la modificación: Se documentó
_local LaOpciones ## Arreglo con las opciones "Si","No".
	LaOpciones << rope.new()
	LaOpciones.add("No")
	LaOpciones.add("Si")
	>> LaOpciones
_endmethod
$


_pragma(classify_level=restricted)
_method c_Corte_Geografico.initialise_for_page ( a_layout_page )
## Objetivo: Definir el método de inicialización de la clase c_Corte_Geografico
## Parámetros de entrada:  NA
##	Objeto - a_layout_page - Valor que servirá para conectar la página del layout al primer viewport.
## Parámetros de salida:   NA
## Regresa: NA
## Fecha de última modificación: 23/12/2004
## Autor de la modificación : jesalaza
## Descripción de la modificación: Se documentó
	## 
	## Checks if there already is a viewport on the page and if so
	## connects to it directly.
	_self.connect_to_first_viewport_on_page(a_layout_page)
_endmethod
$



_pragma(classify_level=restricted)
_method c_Corte_Geografico.Dibuja_Corte(window)
## Objetivo: Dibujar el corte geográfico.
## Parámetros de entrada:  
##	Canvas - window - Lienzo donde se dibujará la imagen.
## Parámetros de salida:   NA
## Regresa: NA
## Fecha de última modificación: 23/12/2004
## Autor de la modificación : jesalaza
## Descripción de la modificación: Se documentó

	
	_local LoViewport		# Objeto viewport que se utiliza para mapear la información del mapa actual.
	_local LoVpBound		# Tamaño del viewport anterior.
	_local LoMapView		# Vista del mapa actual.
	_local LoViewMapperPlugin	# Plugin :viewport_mapper que sirve para hacer el mapeo del mapa actual al viewport.
	_local LoLista_Geometrias	# Lista de elementos que se necesitan pintar por el corte geográfico.
	_local LdsDataSet		# Dataset en el cual se buscará la tabla.
	_local LdscTabla		# Tabla de la cual se tomará el campo geométrico.
	_local LdsrCampoG		# Campo Geométrico que se necesita pintar.
	## 
	##		
	#Se esta creando la caja del viewport
	LoVpBound<<bounding_box.new(200,200,1500,1500)
	#se va a crear el vp
	LoViewport<<viewport_layout.new_with(:bounds,LoVpBound)
	#se le quito el color al vp
	LoViewport.set_fill_colour(_unset)
	#se le quito la linea al vp
	
	LoViewport.outline_style<<_unset
	#LoViewport.selection<<_false
	LoViewport.name<<"Viewport 1"
	#se le puso un nombre
	#se va a agregar a la pagina
	_self.layout_page.add_element(LoViewport)
	LoMapView<<.oMapPlugin.current_map_view
	#se oculta el ace
	LoMapView.map.ace_name<<"OCULTOS"

	#se mapea		
	LoViewMapperPlugin<<.oAppLayout.plugin(:viewport_mapper)
	LoViewMapperPlugin.map_viewport_on_map_view(LoViewport,LoMapView,LoMapView.current_view_bounds)
	#se extrae el viewport
	vp<<_self.viewports.an_element()
	_if LoViewport _isnt _unset 
	_then
		#se dibuja la geometría a partir de la cual se creará el corte
		_self.dibuja_geometria_en_viewport(window,.oRwoArranque,LoViewport.name,_unset,
					   _true,:route,:linea,:blue,3,
					   _false,"",0,
					   _true,:blue,:spec_id,8)

		#se genera la lista de elementos que pintará el corte		
		LoLista_Geometrias << {  c_Tipo_Geom.new("landbase","colonia",:limite),
 		           c_Tipo_Geom.new("landbase","user!_lote",:user!_lote_linea),
			   c_Tipo_Geom.new("landbase","user!_distrito",:user!_limite_distrito)
			 }
		
		#recorre dicha lista para que se pinte
		_for LoRegistro _over LoLista_Geometrias.elements()
		_loop
			#se extrae el dataset de la lista para pasarlo en el método.
			LdsDataSet<<LoRegistro.perform(:oDataset)
			#se extrae la tabla de la lista para pasarla en el método.
			LdscTabla<<LoRegistro.perform(:oTabla)
			#se extrae el campo geométrico a partir de la lista.
			LdsrCampoG<<LoRegistro.perform(:oTipo_geom)

			#se dibuja el buffer
			_self.dibuja_contenido_en_buffer(window,LoViewport.name,.oRwoArranque.route,_true,500000,
				 LdsDataSet,LdscTabla,LdsrCampoG,:linea)
			
		_endloop
	_endif 
	
_endmethod
$
		
_pragma(classify_level=restricted)
_method c_Corte_Geografico.draw_content_on(window)
## Objetivo: Es el evento que se dispara cuando se refresca la vista
## Parámetros de entrada:  NA
##	Canvas - window - Lienzo donde se dibujará la imagen.
## Parámetros de salida:   NA
## Regresa: NA
## Fecha de última modificación: 21/12/2004
## Autor de la modificación : jesalaza
## Descripción de la modificación: Se documentó	
	## 
	## 
	#Si la propiedad Dibuja_Calles? es Si, entonces sí se dibuja el corte
	_if _self.Dibuja_Calles?="Si"
	_then
		#se dibuja el corte
		_self.Dibuja_Corte(window)
	_endif
_endmethod
$
