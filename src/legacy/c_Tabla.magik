_package user
$
#remex(:c_tabla)
$
def_slotted_exemplar (:c_tabla,
        {
           {:sNombre,                    _true},# Nombre con el que se identifica la tabla
	   {:bDibuja_columnas_internas,  _true},# indica si debe o no dibujar las lineas
                                                # verticales  internas de la tabla
           {:bDibuja_renglones_internos, _true},# Indica si se debe o no dibujar las lineas
		                                # horizontales
	   {:oRenglones,                _unset},# Coleccion de filas que representa a los renglones
   	   {:oColumnas,                 _unset},# Coleccion de filas que representa a las columnas
	   {:oCeldas,                   _unset},# Coleccion de celdas que almacena las celdas
           {:oLayout,                   _unset},# Layout al que pertnece la tabla
	   {:ocoordenada_origen,        _unset},# Coordenada donde inicia a dibujar la tabla y esta
	                                        # representa el punto superior izquierdo
	   {:sColorLinea,               _unset} # Color de la línea
        } 
)
$
c_tabla.define_slot_access( :sNombre,                    :writable, :private)
$
c_tabla.define_slot_access( :bDibuja_columnas_internas,  :writable, :private)
$
c_tabla.define_slot_access( :bDibuja_renglones_internos, :writable, :private)
$
c_tabla.define_slot_access( :oCeldas,                    :writable, :private)
$
c_tabla.define_slot_access( :oColumnas,                  :writable, :private)
$
c_tabla.define_slot_access( :oCoordenada_origen,         :writable, :private)
$
c_tabla.define_slot_access( :oLayout,                    :writable, :private)
$
c_tabla.define_slot_access( :oRenglones,                 :writable, :private)
$
c_tabla.define_slot_access( :sColorLinea,                :writable, :private)
$
_pragma(classify_level=restricted, usage={redefinable})
_method c_tabla.Agrega_LYM( layout_page )
## Objetivo: 
## Parámetros de entrada: NA
## Parámetros de salida:   NA
## Regresa:  NA
## Fecha de última modificación : 28 / Octubre / 2004
## Autor de la modificación fdiaz
## Descripción de la modificación : Creación
	
	_for LnRe _over range(1,_self.oRenglones.Total_Elementos)
	_loop
		_for LnCo _over range(1, _self.oColumnas.Total_Elementos)
		_loop
			# Se utiliza elemento, para almacenar objetos c_captura_texto
			_if _self.oCeldas.celda(LnRe,LnCo).oElemento <> _unset
			_then
			      LoElemento << _self.oCeldas.celda(LnRe,LnCo).oElemento

			      # Solo si el objeto es de tipo c_captura_texto
			      # de lo contrario se ignora
			      _if LoElemento.is_kind_of?(c_base_layout)
			      _then
        			      LoElem_Cap << LoElemento.Obten_Elemento_captura
				      layout_page.add_element(LoElem_Cap)
			      _endif
			_endif
		_endloop
	_endloop
	
	
_endmethod
$
_pragma(classify_level=restricted, usage={redefinable})
_method c_tabla.bDibuja_bordes? << RbValor
## Objetivo: Asignar un valor al slot bDibuja_columnas_internas
##           Indica si los bordes externos de la tabla se dibujaran	
## Parámetros de entrada: 
##    Boolean - RbValor - Verdad, Si se dibujan las columnas externas
##                        Falso, No se sibujan las columnas externa
##
## Parámetros de salida:   NA
## Regresa:  NA
## Fecha de última modificación : 28 / Octubre / 2004
## Autor de la modificación fdiaz
## Descripción de la modificación : Creación
## 20/12/05 DSB Se modificaron los comentarios	

	# Borde Superior
	_for LnCo _over range(1, _self.oColumnas.Total_Elementos)
	_loop
		_local LnRe # Numero del rengon que se utilizara
		LnRe << 1
		_if _self.oCeldas.celda(LnRe,LnCo).oElementos <> _unset
		_then
		      _local LoCelda # Objeto que contiene la celda
		      
		      LoCelda << _self.oCeldas.celda(LnRe,LnCo).oElementos.obten_elemento(:bordes_celda)
		      LoCelda.color_linea << _self.color_linea
		      LoCelda.bBorde_Sup? << RbValor
		_endif
	_endloop

	#Borde Inferior
	_for LnCo _over range(1, _self.oColumnas.Total_Elementos)
	_loop
		_local LnRe # Numero del renglon que se utilizara
		
		LnRe << _self.oRenglones.Total_Elementos
		_if _self.oCeldas.celda(LnRe,LnCo).oElementos <> _unset
		_then
		      _local LoCelda # Objeto que contiene la celda
		      
      		      LoCelda << _self.oCeldas.celda(LnRe,LnCo).oElementos.obten_elemento(:bordes_celda)
		      LoCelda.color_linea << _self.color_linea
		      LoCelda.bBorde_Inf? << RbValor
		_endif
	_endloop	

	#Borde Izquierdo
	_for LnRe _over range(1, _self.oRenglones.Total_Elementos)
	_loop
		_local LnCo # Número de columna que se utilizara
		
		LnCo << 1
		_if _self.oCeldas.celda(LnRe,LnCo).oElementos <> _unset
		_then
		      _local LoCelda # Objeto que contiene la celda
		      
		      LoCelda << _self.oCeldas.celda(LnRe,LnCo).oElementos.obten_elemento(:bordes_celda)
		      LoCelda.color_linea << _self.color_linea
		      LoCelda.bBorde_Izq? << RbValor
		_endif
	_endloop

	#Borde Derecho
	_for LnRe _over range(1, _self.oRenglones.Total_Elementos)
	_loop
		_local LnCo # Número del renglon que se utilizara
		
		LnCo << _self.oColumnas.Total_Elementos
		_if _self.oCeldas.celda(LnRe,LnCo).oElementos <> _unset
		_then
		      _local LoCelda # Objeto que contiene la celda
		      
      		      LoCelda << _self.oCeldas.celda(LnRe,LnCo).oElementos.obten_elemento(:bordes_celda)
		      LoCelda.color_linea << _self.color_linea
		      LoCelda.bBorde_Der? << RbValor
		_endif
	_endloop	
	
	.bDibuja_columnas_internas << RbValor
	
_endmethod
$
_pragma(classify_level=restricted, usage={redefinable})
_method c_tabla.bDibuja_columnas_internas?
## Objetivo: Conocer si se dibujan columnas internas, este
## valor se almacena en el slot bDibuja_columnas_internas
## Parámetros de entrada: NA
## Parámetros de salida:  NA
## Regresa:  
##    Boolean - RbValor - Verdad, Si se dibujan las columnas internas
##                        Falso, No se dibujan las columnas internas
## Fecha de última modificación : 28 / Octubre / 2004
## Autor de la modificación fdiaz
## Descripción de la modificación : Documentacion

	_return .bDibuja_columnas_internas
	
_endmethod
$
_pragma(classify_level=restricted, usage={redefinable})
_method c_tabla.bDibuja_columnas_internas? << RbValor
## Objetivo: Asignar un valor al slot bDibuja_columnas_internas
## y configurar las celdas para que se dibujen de acuerdo al
## valor proporcionado
## Parámetros de entrada: 
##    Boolean - RbValor - Verdad, Si se dibujan las columnas internas
##                        Falso, No se sibujan las columnas internas
## Parámetros de salida:   NA
## Regresa:  NA
## Fecha de última modificación : 28 / Octubre / 2004
## Autor de la modificación fdiaz
## Descripción de la modificación : Documentacion

	_for LnRe _over range(1,_self.oRenglones.Total_Elementos)
	_loop
		_for LnCo _over range(1, _self.oColumnas.Total_Elementos-1)
		_loop

			_if _self.oCeldas.celda(LnRe,LnCo).oElementos <> _unset
			_then
			      _local LoCelda # Objeto que contiene la celda	
			      
			      LoCelda << _self.oCeldas.celda(LnRe,LnCo).oElementos.obten_elemento(:bordes_celda)
			      LoCelda.color_linea << _self.color_linea
			      LoCelda.bBorde_Der? << RbValor
			_endif
			
		_endloop
	_endloop		
	
	.bDibuja_columnas_internas << RbValor
	
_endmethod
$
_pragma(classify_level=restricted, usage={redefinable})
_method c_tabla.bDibuja_renglones_internos?
