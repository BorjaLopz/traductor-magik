_pragma(classify_level=restricted, usage={redefinable})
_method c_tabla.Calcula_area_tabla(RoLayout)
## Objetivo: calcula el área que ocupa la tabla
## Parámetros de entrada: NA
## Parámetros de salida:   NA
## Regresa:  NA
## Fecha de última modificación : 28 / Octubre / 2004
## Autor de la modificación fdiaz
## Descripción de la modificación : Creación
	
_local LnCx	# Coordenada X superior izquierda del layout      
_local LnCy     # Coordenada Y superior izquierda del layout 	  
_local LnPosX1  # Coordenada X inferior izquierda                 
_local LnPosY1	# Coordenada Y inferior izquierda		  		
_local LnPosX2  # Coordenada X superior derecha                   
_local LnPosY2	# Coordenada Y superior derecha			  						
_local LoPuntos # Almacena coordenas 
_local LoCaja	# Almacena el area

	#Se almacenan las coordenadas de la tabla a generar
	LoPuntos << coords_rope.new()
	LoPuntos.empty()
	
	#Coordenadas superior izquierda del layout
	LnCx << _self.oCoordenada_Origen.x
	LnCy << _self.oCoordenada_Origen.y
	
	_for LnRe _over range(1,_self.oRenglones.Total_Elementos)
	_loop
		_for LnCo _over range(1, _self.oColumnas.Total_Elementos)
		_loop
			
			#Coordenada inferior izquierda
			LnPosX1 <<  RoLayout.Bounds.Xmin +
				    _self.oColumnas.Inicia_Elemento(LnCo) 
			LnPosY1 <<  RoLayout.Bounds.Ymax -
				    _self.oRenglones.Inicia_Elemento(LnRe) -
				    _self.ORenglones.Elemento(LnRe).nLongitud
			
			#Coordenada superior derecha
			LnPosX2 <<  RoLayout.Bounds.Xmin +
				    _self.oColumnas.Inicia_Elemento(LnCo) +
				    _self.OColumnas.Elemento(LnCo).nLongitud
			LnPosY2 <<  RoLayout.Bounds.Ymax -
				    _self.oRenglones.Inicia_Elemento(LnRe)

			#Se agrega el desplazamiento
			LnPosX1 << LnPosX1 + LnCx
			LnPosY1 << LnPosY1 + LnCy

			LnPosX2 << LnPosX2 + LnCx
			LnPosY2 << LnPosY2 + LnCy
			
			#Se crea el objeto area para esa celda
			LoPuntos.add(coordinate(LnPosX1,LnPosY1))
			LoPuntos.add(coordinate(LnPosX2,LnPosY2))
			
		_endloop
	_endloop
	
        LoCaja << Lopuntos.bounds
	
	_return LoCaja
	
_endmethod
$
_pragma(classify_level=restricted, usage={redefinable})
_method c_tabla.color_linea
	## 
	## 
	_return .sColorLinea
	
_endmethod
$
_method c_tabla.color_linea << RsColor
	## 
	##
	.sColorLinea << colour.new_rgb(RsColor[1],RsColor[2],RsColor[3])
	
	_for LnRe _over range(1,_self.oRenglones.Total_Elementos)
	_loop
		_for LnCo _over range(1, _self.oColumnas.Total_Elementos)
		_loop
			_if _self.oCeldas.celda(LnRe,LnCo).oElementos <> _unset
			_then
		      
			      LoCelda << _self.oCeldas.celda(LnRe,LnCo).oElementos.obten_elemento(:bordes_celda)
			      LoCelda.color_linea << _self.sColorLinea
			      
			_endif
			
		_endloop
	_endloop	
	
	
_endmethod
$
_pragma(classify_level=restricted, usage={redefinable})
_method c_tabla.Despliega(RoVentana)
## Objetivo: Genera  la tabla a dibujar
## Parámetros de entrada: NA
## Parámetros de salida:  NA
## Regresa:  NA
## Fecha de última modificación : 28 / Octubre / 2004
## Autor de la modificación fdiaz
## Descripción de la modificación : Se documentó

_local LnPosX		# Contador para calcular columnas internas
_local LnPosY		# Contador para calcular renglones internos
_local LnCont		# Se utiliza para saber cuando abandonar los ciclos
_local LnCx       	# Coordenada X superior izquierda del layout
_local LnCy		# Coordenada Y superior izquierda del layout
_local LnContador       # Contador para agregar las lineas a dibujar a oLista
_local oPuntos 		# Almacena las coordenas de las lineas que se dibujaran
_local oLista		# Alamacena todas las coordenadas de las lineas a dibujar

   # Se generan las áreas para cada celda que tenga un elemento asignado
   _self.genera_areas()

   LnContador << 0	
   oLista <<  property_list.new()
   oPuntos << coords_rope.new()
   oPuntos.empty()

   # Coordenadas superior izquierda del layout
   LnCx << _self.oCoordenada_Origen.x
   LnCy << _self.oCoordenada_Origen.y

   # Se dibuja el contorno exterior de la tabla
   LnContador << 1
   oPuntos.add(coordinate(LnCx,LnCy))
   oPuntos.add(coordinate(LnCx + _self.oColumnas.Longitud_Total(), LnCy))
   oPuntos.add(coordinate(LnCx + _self.oColumnas.Longitud_Total(),LnCy - _self.oRenglones.Longitud_Total()))
   oPuntos.add(coordinate(LnCx, LnCy - _self.oRenglones.Longitud_Total()))
   oPuntos.add(coordinate(LnCx,LnCy))
   
   oLista[LnContador] << {:area, :white, :black, oPuntos.copy()}

      _if _self.bDibuja_columnas_internas? = _true _then 
      
	      # Se agregan las columnas
	      LnPosX << 0  
	      LnCont << 1
	      _loop
		      oPuntos.empty()   
		      
		      # Se obtiene la longitud de cada columna y se va a acumulando
		      LnPosX << LnPosX + _self.oColumnas.elemento(LnCont).nLongitud
		      oPuntos.add(coordinate(LnCx + LnPosX, LnCy))
		      oPuntos.add(coordinate(LnCx + LnPosX, LnCy - _self.oRenglones.Longitud_Total()))

		      LnContador << LnContador + 1
		      oLista[LnContador] << {:area, :white, :black, oPuntos.copy()}

		      _if LnCont >= _self.oColumnas.Total_Elementos  _then _leave _endif
		      LnCont << LnCont + 1
	      _endloop
      _endif

      _if _self.bDibuja_renglones_internos? = _true  _then
	      # Se agregan los renglones
	      LnPosY << 0  
	      LnCont << 1
	      _loop
		      oPuntos.empty()   
		      
		      # Se obtiene la longitud de cada renglon y se va a acumulando
		      LnPosY << LnPosY + _self.oRenglones.elemento(LnCont).nLongitud
		      oPuntos.add(coordinate(LnCx, LnCy - LnPosY))
		      oPuntos.add(coordinate(LnCx + _self.oColumnas.Longitud_Total(), LnCy -LnPosY ))

		      LnContador << LnContador + 1
		      oLista[LnContador] << {:area, :white, :black, oPuntos.copy()}

		      _if LnCont >= _self.oRenglones.Total_Elementos  _then _leave _endif
		      LnCont << LnCont + 1
	      _endloop
      _endif      

   _self.Imprime(RoVentana)
   
_endmethod
$
_pragma(classify_level=restricted, usage={redefinable})
_method c_tabla.genera_areas()
## Objetivo: Genera el area que ocupa la tabla
## Parámetros de entrada: NA
## Parámetros de salida:   NA
## Regresa:  NA
## Fecha de última modificación : 28 / Octubre / 2004
## Autor de la modificación fdiaz
## Descripción de la modificación : Creación

_local LnCx        # Coordenada X superior izquierda del layout
_local LnCy	   # Coordenada Y superior izquierda del layout 	
_local LnPosX1	   # Coordenada X inferior izquierda
_local LnPosY1	   # Coordenada Y inferior izquierda		
_local LnPosX2	   # Coordenada X superior derecha
_local LnPosY2	   # Coordenada Y superior derecha							
_local LoAreaCelda # Nueva area

	# Coordenadas superior izquierda del layout
	LnCx << _self.oCoordenada_Origen.x
	LnCy << _self.oCoordenada_Origen.y
	
	_for LnRe _over range(1,_self.oRenglones.Total_Elementos)
	_loop
		_for LnCo _over range(1, _self.oColumnas.Total_Elementos)
		_loop
		
			# Coordenada inferior izquierda
			LnPosX1 <<  _self.oLayout.Bounds.Xmin +
				    _self.oColumnas.Inicia_Elemento(LnCo) 
			LnPosY1 <<  _self.oLayout.Bounds.Ymax -
				    _self.oRenglones.Inicia_Elemento(LnRe) -
				    _self.ORenglones.Elemento(LnRe).nLongitud
			
			# Coordenada superior derecha
			LnPosX2 <<  _self.oLayout.Bounds.Xmin +
				    _self.oColumnas.Inicia_Elemento(LnCo) +
				    _self.OColumnas.Elemento(LnCo).nLongitud
			LnPosY2 <<  _self.oLayout.Bounds.Ymax -
				    _self.oRenglones.Inicia_Elemento(LnRe)

			# Se agrega el desplazamiento
			LnPosX1 << LnPosX1 + LnCx
			LnPosY1 << LnPosY1 + LnCy

			LnPosX2 << LnPosX2 + LnCx
			LnPosY2 << LnPosY2 + LnCy
			
			# Se crea el objeto area para esa celda
			LoAreaCelda << bounding_box.new(LnPosX1,LnPosY1,LnPosX2,LnPosY2)

			_if _self.oCeldas.celda(LnRe,LnCo).oElemento <> _unset
			_then
			      _self.oCeldas.celda(LnRe,LnCo).oElemento.oArea << LoAreaCelda
			_endif

			_if _self.oCeldas.celda(LnRe,LnCo).oElementos <> _unset
			_then
			      _self.oCeldas.celda(LnRe,LnCo).oElementos.oArea << LoAreaCelda
			_endif

			_if _self.oCeldas.celda(LnRe,LnCo).oElementos_captura <> _unset
			_then
			      _self.oCeldas.celda(LnRe,LnCo).oElementos_captura.oArea << LoAreaCelda
			_endif
			
		_endloop
	_endloop

_endmethod
$
_pragma(classify_level=restricted, usage={redefinable})
_method c_tabla.Imprime(RoVentana)
## Objetivo: Genera la tabla a dibujar
## Parámetros de entrada: NA
## Parámetros de salida:   NA
## Regresa:  NA
## Fecha de última modificación : 28 / Octubre / 2004
## Autor de la modificación fdiaz
## Descripción de la modificación :
## 07/03/05 FAD Se elimino la distincion entre clases que
##              heredan de elemento grafico	
	

	# Se calcula para cada celda la coordenada para mostrar el texto
	_for LnRe _over range(1,_self.oRenglones.Total_Elementos)
	_loop
		_for LnCo _over range(1, _self.oColumnas.Total_Elementos)
		_loop

			#Se despliega el elemento que no es coleccion * * * * * 
			_if _self.oCeldas.celda(LnRe,LnCo).oElemento <> _unset
			_then
				
                            LoElemento << _self.oCeldas.celda(LnRe,LnCo).oElemento
			    
			    _self.oCeldas.celda(LnRe,LnCo).oElemento.oVentana << RoVentana
			    _self.oCeldas.celda(LnRe,LnCo).oElemento.Actualiza_Area_Elemento()	    
			    _self.oCeldas.celda(LnRe,LnCo).oElemento.Despliega()

			_endif

			_if _self.oCeldas.celda(LnRe,LnCo).oElementos <> _unset
			_then
			
			    # Se despliega el elemento que es coleccion	
			    _self.oCeldas.celda(LnRe,LnCo).oElementos.oVentana << RoVentana
    			    _self.oCeldas.celda(LnRe,LnCo).oElementos.Despliega()
			_endif

		_endloop
	_endloop

_endmethod	
$
_pragma(classify_level=restricted)
_method c_tabla.init_with( props )

	_for key, value _over props.fast_keys_and_elements()
	_loop
		_try _with cond
		     _self.perform_private( key.with_chevron, value )
		_when does_not_understand
		_endtry 
	_endloop

	_return _self
	
_endmethod
$
_pragma(classify_level=restricted, usage={redefinable})
_method c_tabla.new(RnRenglones,RnColumnas, _optional PsColorLinea)
## Objetivo: Crear una nueva instancia del objeto
## Parámetros de entrada:
##   Entero - RnRenglones - Número de renglones
##   Entero - RnColumnas  - Número de columnas
## Parámetros de salida:   NA
## Regresa:  
##  c_Tabla - Un objeto tabla
## Fecha de última modificación : 28 / Octubre / 2004
## Autor de la modificación fdiaz
## Descripción de la modificación : Creación

	# Cuando se crea el objeto, la coordenada de origen es 0,0
	# Esquina superior derecha del layout
        _self.oCoordenada_Origen << coordinate.new(0,0)

	# Se crean las celdas
	_self.oCeldas << c_celdas.new(RnRenglones, RnColumnas)
	
	# Se crea M instancias de la clase Fila (Columnas)
        _self.oColumnas << c_filas.new(RnColumnas)

	# Se crean N instancias la clase Fila (Renglones)
	_self.oRenglones << c_filas.new(RnRenglones)

	_if PsColorLinea _is _unset
	_then
		_self.color_linea << {0.0, 0.0, 0.0}
	_else
		_self.color_linea << PsColorLinea
	_endif
	
	_self.bDibuja_renglones_internos? << _true
	_self.bDibuja_columnas_internas? << _true
	_self.bDibuja_Bordes? << _true

	_return _clone
	
_endmethod
$
_pragma(classify_level=restricted)
_method c_tabla.new_from_serial( keys, xml_values )

	props << property_list.new()
	
	_for nr, key _over keys.fast_keys_and_elements()
	_loop
		props[key] << xml_values[nr]
	_endloop
	
	_return _clone.init_with( props )
	
_endmethod
$
