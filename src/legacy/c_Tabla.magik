			_if _self.oCeldas.celda(LnRe,LnCo).oElementos <> _unset
			_then
			      _local LoCelda # Objeto que contiene la celda	 
			      
			      LoCelda << _self.oCeldas.celda(LnRe,LnCo).oElementos.obten_elemento(:bordes_celda)
			      LoCelda.color_linea << _self.color_linea
			      LoCelda.bBorde_Inf? << RbValor

			_endif
			
		_endloop
	_endloop
	
	.bDibuja_renglones_internos << RbValor
	
_endmethod
