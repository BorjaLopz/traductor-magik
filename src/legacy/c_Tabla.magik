_pragma(classify_level=restricted)
_method c_tabla.celda(pRen, pCol)
	#---------------------------------------------------
	## <Req. #> : Regresa la celda que se ubica en pRen, pCol
	##
	#
	# Customization for Project : 
	#
	#---------------- Revision History -----------------
	# (22/07/22 des_david) : Created
	#-------------- End Revision History ---------------

	_local cel
	cel << .oCeldas.celda(pRen, pCol)	
	_return cel
	
_endmethod
$


_pragma(classify_level=restricted)
_method c_tabla.activa_borde_celda(pRen, pCol, pBordeUbicacion) << pActivo
	#---------------------------------------------------
	## <Req. #> : Sincroniza la activación de los bordes de dos
	## celdas. La celda q se ubica en pRen, pCol y la celda
	## adyacente.
	## Ejemplo:
	## Si la tabla es de un renglon por dos columnas
	## Se desea deshabilitar, que no se vea, el borde de la derecha de la celda [1,1]
	## su celda adyacente es la celda [1,2] y a está se la
	## deshabilitará el borde izq.
	## 
	## 
	
	#
	# Customization for Project : 
	#
	#---------------- Revision History -----------------
	# (22/07/22 des_david) : Created
	#-------------- End Revision History ---------------
	_local cel, celAdyacente, totRens, totCols

	celAdyacente << _unset 
	totRens << _self.orenglones.total_elementos
	totCols << _self.oColumnas.total_elementos
	cel << _self.celda(pRen, pCol)

	cel.bordes(pBordeUbicacion) << pActivo
	_if pBordeUbicacion = :derecha
	_then
		_if pCol < totCols
		_then
			celAdyacente << _self.celda(pRen , pCol + 1)
			bordeAdyacente << :izquierda
		_endif

	_elif pBordeUbicacion = :izquierda 
	_then
		_if pCol > 1 
		_then
			celAdyacente << _self.celda(pRen , pCol - 1)
			bordeAdyacente << :derecha					
		_endif

	_elif pBordeUbicacion = :superior 
	_then
		_if pRen > 1
		_then
			celAdyacente << _self.celda(pRen - 1, pCol)
			bordeAdyacente << :inferior					
		_endif

	_elif pBordeUbicacion = :inferior 
	_then
		_if pRen < totRens
		_then
			celAdyacente << _self.celda(pRen + 1, pCol)
			bordeAdyacente << :superior
		_endif
	_else
		condition.raise(:warning, :string, "ERROR en el nombre de la orientación " + pBordeUbicacion )	
	_endif
	_if celAdyacente _isnt _unset 
	_then
		celAdyacente.bordes(bordeAdyacente) << pActivo			
	_endif

_endmethod
$

