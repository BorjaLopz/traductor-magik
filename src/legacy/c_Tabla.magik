_pragma(classify_level=restricted)
_method c_tabla.serial_slots()

	keys << rope.new_with(:bDibuja_columnas_internas,:bDibuja_renglones_internos,:oRenglones,
			:oColumnas,:oCeldas,:ocoordenada_origen,:ColorLinea)
	values << rope.new_with(.bDibuja_columnas_internas,.bDibuja_renglones_internos,.oRenglones,
			.oColumnas,.oCeldas,.oCoordenada_Origen,.sColorLinea)
	
	>> keys, values
	
_endmethod
