_pragma(classify_level=advanced, topic={plotting}, usage={subclassable})
_method c_base_sello_cobre.nombre_plano()

	_try
		diseno << swg_dsn_admin_engine.active_scheme
		_return _self.layout.layout_document.identificador_de_plano(diseno)
	_when does_not_understand
		_return ""
	_endtry
	
_endmethod
$
_pragma(classify_level=advanced, topic={plotting}, usage={subclassable})
_method c_base_sello_cobre.obten_oe()

	_try
		_if .s_tipo_plano = :ruta_cables _orif .s_tipo_plano = :fosa_cables
		_then
			_return smallworld_product.pni_application().plugin(:gen_planos).oe_seleccionada
		_else
			_return _self.layout_document.user!_oe
		_endif
	_when does_not_understand
		_return _unset
	_endtry
	
_endmethod
