_pragma(classify_level=advanced, topic={plotting}, usage={subclassable})
_method c_base_sello_cobre.obten_valor_oe()

#	_try
#		_return _self.obten_oe().user!_valor_oe.write_string
#	_when does_not_understand
#		_return ""
#	_endtry

	proy_act << swg_dsn_admin_engine.active_scheme
	LoDisenoActivo << swg_dsn_admin_engine.active_design
	#Se recupera el valor de la oe para los proyectos de tipo Falc
	_if LoDisenoActivo.tipo_diseno = :secundaria _andif
	    proy_act.project.name.matches?("FALC*") _andif
	    (oeis<<swg_dsn_admin_engine.active_design.user!_oei_locals).size = 1
	_then
		LoOEI << oeis.an_element()
		#08/Agosto/2011
		#Validar la oe
		_if  LoOEI.user!_oe_locals.an_element() _isnt _unset 
		_then
			LoOE << LoOEI.user!_oe_locals.an_element()
			_return LoOE.user!_num_oe
		_else
			_return _unset 
		_endif		
	_endif
	
	_if proy_act.project.user!_opbs _isnt _unset 
	_then
	     _for op _over proy_act.project.user!_opbs.elements()
	     _loop
		  _if proy_act.name.matches?("Principales*") _is _true _and op.user!_tipo_opb = "PRINCIPAL"
		  _then
		       _if op.user!_oeis _isnt _unset _andif op.user!_oeis.an_element().user!_oes _isnt _unset 
		       _then
			    _return  op.user!_oeis.an_element().user!_oes.an_element().user!_valor_oe
		       _endif
		       
		  _elif op.user!_tipo_opb = "SECUNDARIO"
		  _then
		       _if op.user!_oeis _isnt _unset _andif op.user!_oeis.an_element().user!_oes _isnt _unset 
		       _then
			    _return op.user!_oeis.an_element().user!_oes.an_element().user!_valor_oe
		       _endif
		  _endif
	     _endloop
	_endif

	_return _unset 

	
_endmethod
$
_pragma(classify_level=advanced, topic={plotting}, usage={subclassable})
_method c_base_sello_cobre.obten_valor_oei()

#	_try
#		_return _self.obten_oei().user!_valor_oei.write_string
#	_when does_not_understand
#		_return ""
#	_endtry

	proy_act << swg_dsn_admin_engine.active_scheme
	LoDisenoActivo << swg_dsn_admin_engine.active_design
	
	#Se recupera el valor de la oei para los proyectos de tipo Falc
	_if LoDisenoActivo.tipo_diseno = :secundaria _andif
	    proy_act.project.name.matches?("FALC*") _andif
	    (oeis<<swg_dsn_admin_engine.active_design.user!_oei_locals).size = 1
	_then
		LoOEI << oeis.an_element()
		_return LoOEI.user!_num_oei
	_endif
	
	_if proy_act.project.user!_opbs _isnt _unset 
	_then
	     _for op _over proy_act.project.user!_opbs.elements()
	     _loop
		  _if proy_act.name.matches?("Principales*") _is _true _and op.user!_tipo_opb = "PRINCIPAL"
		  _then
			  write("uno")
		       _if op.user!_oeis _isnt _unset 
		       _then
			     _return  op.user!_oeis.an_element().user!_valor_oei
		       _endif
		       
		  _elif op.user!_tipo_opb = "SECUNDARIO"
		  _then
		       _if op.user!_oeis _isnt _unset
		       _then
			    _return op.user!_oeis.an_element().user!_valor_oei
		       _endif
		  _endif
	     _endloop
	_endif
	
	_return _unset
	
_endmethod
$
_pragma(classify_level=advanced, topic={plotting}, usage={subclassable})
_method c_base_sello_cobre.obten_valor_opb()

#	_try
#		_return _self.obten_opb().user!_valor_opb.write_string
#	_when does_not_understand
#		_return ""
#	_endtry

	proy_act << swg_dsn_admin_engine.active_scheme
	LoDisenoActivo << swg_dsn_admin_engine.active_design
	
	#Se recupera el valor de la opb para los proyectos de tipo Falc
	_if LoDisenoActivo.tipo_diseno = :secundaria _andif
	    proy_act.project.name.matches?("FALC*") _andif
	    (oeis<<swg_dsn_admin_engine.active_design.user!_oei_locals).size = 1
	_then
		LoOEI << oeis.an_element()
		LoOpb << LoOEI.user!_op_local
		_return LoOpb.user!_num_op
	_endif

	
	_if proy_act.project.user!_opbs _isnt _unset _andif
	    proy_act.project.user!_opbs.size >0
	_then
             _for op _over proy_act.project.user!_opbs.elements()
	     _loop
		  _if proy_act.name.matches?("Principales*") _is _true _and
		      op.user!_tipo_opb = "PRINCIPAL"
		  _then
		       opb<< op.user!_valor_opb
		       _return opb
		  _elif op.user!_tipo_opb = "SECUNDARIO"
		  _then 
		       opb<< op.user!_valor_opb
		       _return opb	
		  _endif
	     _endloop
	_else
	     _return _unset 
	_endif

		
	
_endmethod
$
_pragma(classify_level=advanced, topic={plotting}, usage={subclassable})
_method c_base_sello_cobre.obten_valor_pep()

	_local ls_pep
	_if .s_tipo_plano = :principales _orif .s_tipo_plano = :fosa_cables
	_then
		ls_pep << .o_proyecto.pep_cons_princ
	_elif .s_tipo_plano = :diagrama_empalmes _orif .s_tipo_plano = :esquema_secundario
	_then
		ls_pep << .o_proyecto.pep_cons_sec
	_elif .s_tipo_plano = :esquema_principal
	_then
		ls_pep << .o_proyecto.pep_cons_princ
	_endif

	_return ls_pep.write_string
	
_endmethod
$
_pragma(classify_level=restricted)
_method c_base_sello_cobre.s_tipo_plano << valor

	.s_tipo_plano << valor
	
_endmethod
$
_pragma(classify_level=restricted)
_method c_base_sello_cobre.serial_slots()

	(keys,values) << _super.serial_slots()

	keys.add_all_last( rope.new_with(:s_tipo_plano,:lst_celdas_color) )
	values.add_all_last( rope.new_with(.s_tipo_plano,.lst_celdas_color) )

	>> keys, values
	
_endmethod
$
_pragma(classify_level=advanced, topic={plotting}, usage={subclassable})
_method c_base_sello_cobre.tipo_plano()
	## regresa en un symbol el tipo de plano asignado al layout document
	## (vbluna-26/oct/06)
	_try
		_return _self.layout_document.user!_tipo_plano.as_symbol()
	_when does_not_understand
		_return _unset
	_endtry
	
_endmethod                                                                                                              
