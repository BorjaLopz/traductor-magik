_package user
$
def_slotted_exemplar(:c_base_sello_cobre,
{
	{:o_proyecto,        _unset,  :writable},
	{:o_distrito,        _unset,  :writable},
	{:s_tipo_plano,      _unset,  :writable},
	{:lst_celdas_color,  _unset,  :writable}
}, :c_base_sello)
$
_pragma(classify_level=advanced, topic={plotting}, usage={subclassable})
_method c_base_sello_cobre.asigna_celdas_a_colorear()
## Asigna las celdas que van en color diferente en cada sello,
## este método tiene que regresar un rope con un conjunto de
## property_list que incluya:
##	{nombre_tabla, num_renglon, num_columna, color_celda}
## vbluna(17-nov-2006)

	# Redefinible

	_return rope.new()
	
_endmethod
$
_pragma(classify_level=advanced, topic={plotting}, usage={subclassable})
_method c_base_sello_cobre.configura_color_sello()

	_if _self.attributes[:blanco_negro].value = "SI"
	_then
		_for celda_color _over .lst_celdas_color.fast_elements()
		_loop
			nombre_tabla << celda_color[1]
			num_renglon  << celda_color[2]
			num_columna  << celda_color[3]
			color        << colour.new_rgb(0.0, 0.0, 0.0)

			celda << .o_tablas.elemento(nombre_tabla).oCeldas.Celda(num_renglon,num_columna)

			_if (texto << celda.oElemento) _isnt _unset
			_then
				texto.sColor << color
			_endif
		_endloop
	_else
		_for celda_color _over .lst_celdas_color.fast_elements()
		_loop
			nombre_tabla << celda_color[1]
			num_renglon  << celda_color[2]
			num_columna  << celda_color[3]
			color << colour.new_rgb(celda_color[4][1],celda_color[4][2],celda_color[4][3])

			celda << .o_tablas.elemento(nombre_tabla).oCeldas.Celda(num_renglon,num_columna)

			_if (texto << celda.oElemento) _isnt _unset
			_then
				texto.sColor << color
			_endif			
		_endloop
	_endif
	
_endmethod
$
_pragma(classify_level=restricted, usage={redefinable})
_method c_base_sello_cobre.defined_attributes

	attribs << rope.new_from (_super.defined_attributes)
	
	# Atributo que indica si el sello debe presentarse en color
	# negro o en color rojo (vbluna-16-nov-2006)
	attribs.add(layout_attribute_definition.new(:blanco_negro,  :string,
		                                    :description,   "blanco_negro",
						    :enum_method,   :enum_bool,
						    :default_value, "NO"))
	>> attribs
	
_endmethod
$
c_base_sello_cobre.define_attributes()
$
_pragma(classify_level=restricted, usage={redefinable})
_method c_base_sello_cobre.draw_content_on(window)

	_self.configura_color_sello()
	_super.draw_content_on(window)
	
_endmethod
$
_pragma(classify_level=restricted, usage={redefinable})
_method c_base_sello_cobre.enum_bool

	_local lht_bool << hash_table.new()
	
	lht_bool[1] <<  "SI"
	lht_bool[2] <<  "NO"

	_return lht_bool	
	
_endmethod
$
_pragma(classify_level=restricted, usage={redefinable})
_method c_base_sello_cobre.enum_pep_cobre
	## Se subclasea este metodo para que ahora tome la descripcion
	## de las pep asociadas al proyecto.
	##
	l_pep_asoc_proj << rope.new()
	l_pep_asoc_proj.add_last("")
	_if (l_design << swg_dsn_admin_engine.active_design) _isnt _unset	
	_then
		l_peps << l_design.project.user!_peps		
		_for a_pep _over l_peps.fast_elements()
		_loop
			l_tipo << ""
			_if (l_tipo_pep << a_pep.user!_catalogo_pep) _isnt _unset 
			_then
				l_tipo << l_tipo_pep.user!_descripcion
			_endif

			l_pep_asoc_proj.add_last(a_pep.user!_clave.write_string + " -- " + l_tipo)
			
		_endloop		
	_endif

	_return l_pep_asoc_proj
	
_endmethod
$
_pragma(classify_level=advanced, topic={plotting}, usage={subclassable})
_method c_base_sello_cobre.escala()
	#31/03/2011  aalarcon, se modifica para mostrar la F/E en la
	# escala de los planos de esquematicos
        _try
		lo_viewport << _self.layout_page.get_first_element_of(
				       .viewport_principal.default(viewport_layout))
		
		#31/03/2011 aalarcon, obtener el tipo de plano		
		ls_TipoPlano << _self.tipo_plano().write_string		
    
		lo_escala << lo_viewport.view_scale.rounded

		# INICIO DEL CAMBIO
		# (2010-07-22 Aarón Hernández Ramírez, SIGMATAO) : 
		# se modifica dato de escala pues por unidades de la base de
		# datos lo da erroneo (la aplicacion esta e n mmm y debe ser en
		# CM como lo esta definida la base de datos.

		_if lo_viewport.class_name = "c_vp_plano_proy_can"
		_then	
			un_v<<unit_value.new(lo_escala ,:mm)    
			LoEscala   <<  un_v.convert_to(:cm).value
			(LoEscala, LoDecimal)   <<  LoEscala.integral_and_fraction() 		 
		        ls_escala << "1:" + loEscala.write_string
			#25/03/2011 fmejiar,aalarcon, se coloca el return ls_escala
			_return ls_escala			
			#
		# FIN DEL CAMBIO

		_endif

		#31/03/2011 fmejiar,aalarcon, mostrar la F/E en la
   	        # escala de los planos de esquematicos
                _if ls_TipoPlano.index_of_seq("esquema") _isnt _unset 
		_then
			_return "F/E"			
		_endif
		#25/03/2011 fmejiar,aalarcon, se coloca el _return "1:" + lo_escala.write_string
		_return "1:" + lo_escala.write_string
	_when does_not_understand
		_return "F/E"
	_endtry
	
_endmethod
$
_pragma(classify_level=restricted, usage={redefinable})
_method c_base_sello_cobre.inicializa( properties )

	# vbluna(23-feb-07)
	# - Se agrega el parámetro: properties como resultado de las
	#   modificaciones para almacenar los valores del sello
	#   en archivo .xml

	_super.inicializa( properties )
	.lst_celdas_color << _self.asigna_celdas_a_colorear()

	.o_proyecto << c_proyecto.new()
	.o_distrito << c_distrito.new()
	
_endmethod
$
_pragma(classify_level=restricted)
_method c_base_sello_cobre.lst_celdas_color << valor

	.lst_celdas_color << valor
	
_endmethod
