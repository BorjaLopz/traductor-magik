_package user
$

def_slotted_exemplar(:c_base_sello_fibra,
{
	{:distribuidor_datos,   _unset,  :writable},
	{:col_tablas,           _unset,  :writable},
	{:lst_celdas_color,     _unset,  :writable}
}, :c_base_sello)
$

_pragma(classify_level=restricted, usage={redefinable})
_method c_base_sello_fibra.defined_attributes

	attribs << rope.new_from (_super.defined_attributes)
	
	# Atributo que indica si el sello debe presentarse en color
	# negro o en color rojo
	attribs.add(layout_attribute_definition.new(:blanco_negro,  :string,
		                                    :description,   "blanco_negro",
						    :enum_method,   :enum_bool,
						    :default_value, "NO"))
	>> attribs
	
_endmethod
$

c_base_sello_fibra.define_attributes()
$
_pragma(classify_level=restricted, usage={redefinable})
_method c_base_sello_fibra.draw_content_on(window)

	lotitulo << "Generando Plano"
	lolabel << "Generando Sellos..."
	_self.configura_color_sello()
	_super.draw_content_on(window)
	_if .col_tablas _isnt _unset
	_then
		_for tabla _over .col_tablas.fast_elements()
		_loop
			tabla.Despliega(window)
		_endloop
	_endif

_endmethod
$
_pragma(classify_level=restricted, usage={redefinable})
_method c_base_sello_fibra.inicializa( properties )

	_super.inicializa( properties )
	
	.lst_celdas_color << _self.asigna_celdas_a_colorear()

	_if _self.origen_xml? _andif .col_tablas _isnt _unset
	_then
		_for key, tabla_gral  _over .col_tablas.fast_keys_and_elements()
		_loop
			tabla_gral.oLayout << _self
			tabla_gral.oTablas.o_Layout << _self
			_for k, tabla _over tabla_gral.oTablas.tablas.fast_keys_and_elements()
			_loop
				tabla.oLayout << _self
			_endloop
		_endloop
	_endif
	
_endmethod
$

_pragma(classify_level=restricted, usage={redefinable})
_method c_base_sello_fibra.obten_registros()

	.distribuidor_datos << c_distribuidor_datos_sellos.obten_instancia()
	
	_return .distribuidor_datos.obten_datos_sello( _self )
	
_endmethod
$

_pragma(classify_level=advanced, topic={plotting}, usage={subclassable})
_method c_base_sello_fibra.tipo_plano

	_try
		_return _self.layout_document.user!_tipo_plano.as_symbol()
	_when does_not_understand
		_return _unset
	_endtry
	
_endmethod
$
_pragma(classify_level=advanced, topic={plotting}, usage={subclassable})
_method c_base_sello_fibra.nombre_plano()

	_try
		diseno << swg_dsn_admin_engine.active_scheme
		_return _self.layout.layout_document.identificador_de_plano(diseno)

	_when does_not_understand
		_return ""
	_endtry
	
_endmethod
$
_pragma(classify_level=advanced, topic={plotting}, usage={subclassable})
_method c_base_sello_fibra.escala

	_if _self.tipo_plano = :ruta_cables_fo
	_then
		lo_viewport << _self.layout_page.get_first_element_of(c_vp_ruta_de_cables_fo)
	_else
		lo_viewport << _self.layout_page.get_first_element_of(viewport_layout)
	_endif
	
        _try
		lo_escala << lo_viewport.view_scale.rounded
		ls_escala << "1:" + lo_escala.write_string
		_return ls_escala
	_when does_not_understand
		_return "F/E"
	_endtry
	
_endmethod
$

_pragma(classify_level=advanced, topic={plotting}, usage={subclassable})
_method c_base_sello_fibra.configura_color_sello()

	_if _self.attributes[:blanco_negro].value = "SI"
	_then
		_for celda_color _over .lst_celdas_color.fast_elements()
		_loop
			nombre_tabla << celda_color[1]
			num_renglon  << celda_color[2]
			num_columna  << celda_color[3]
			color        << colour.new_rgb(0.0, 0.0, 0.0)

			celda << .o_tablas.elemento(nombre_tabla).oCeldas.Celda(num_renglon,num_columna)

			_if (texto << celda.oElemento) _isnt _unset
			_then
				texto.sColor << color
			_endif
		_endloop
	_else
		_for celda_color _over .lst_celdas_color.fast_elements()
		_loop
			nombre_tabla << celda_color[1]
			num_renglon  << celda_color[2]
			num_columna  << celda_color[3]
			color << colour.new_rgb(celda_color[4][1],celda_color[4][2],celda_color[4][3])

			celda << .o_tablas.elemento(nombre_tabla).oCeldas.Celda(num_renglon,num_columna)

			_if (texto << celda.oElemento) _isnt _unset
			_then
				texto.sColor << color
			_endif			
		_endloop
	_endif
	
_endmethod
$

_pragma(classify_level=advanced, topic={plotting}, usage={subclassable})
_method c_base_sello_fibra.asigna_celdas_a_colorear()
## Asigna las celdas que van en color diferente en cada sello,
## este método tiene que regresar un rope con un conjunto de
## property_list que incluya:
##	{nombre_tabla, num_renglon, num_columna, color_celda}
## vbluna(17-nov-2006)

	# Redefinible

	_return rope.new()
	
_endmethod
$

_pragma(classify_level=advanced, topic={plotting}, usage={subclassable})
_method c_base_sello_fibra.oculta_bordes_celdas(po_tabla, pcol_celdas)

	_if pcol_celdas[:borde_der_izq] _isnt _unset
	_then
		_for celdas _over pcol_celdas[:borde_der_izq].fast_elements()
		_loop
			lo_num_ren << celdas[1]
			lo_num_col << celdas[2]

			lo_celda << po_tabla.oCeldas.Celda(lo_num_ren,lo_num_col).oElementos
			lo_bordes << lo_celda.obten_elemento(:bordes_celda)
			lo_bordes.bBorde_der? << _false
			lo_bordes.bBorde_izq? << _false
		_endloop
	_endif

	_if pcol_celdas[:borde_der] _isnt _unset 
	_then
		_for celdas _over pcol_celdas[:borde_der].fast_elements()
		_loop
			lo_num_ren << celdas[1]
			lo_num_col << celdas[2]
			
			lo_celda << po_tabla.oCeldas.Celda(lo_num_ren,lo_num_col).oElementos
			lo_bordes << lo_celda.obten_elemento(:bordes_celda)
			lo_bordes.bBorde_der? << _false
		_endloop
	_endif

	_if pcol_celdas[:borde_izq] _isnt _unset
	_then
		_for celdas _over pcol_celdas[:borde_izq].fast_elements()
		_loop
			lo_num_ren << celdas[1]
			lo_num_col << celdas[2]
			
			lo_celda << po_tabla.oCeldas.Celda(lo_num_ren,lo_num_col).oElementos
			lo_bordes << lo_celda.obten_elemento(:bordes_celda)
			lo_bordes.bBorde_izq? << _false
		_endloop
	_endif

	_if pcol_celdas[:borde_sup_inf] _isnt _unset
	_then
		_for celdas _over pcol_celdas[:borde_sup_inf].fast_elements()
		_loop
			lo_num_ren << celdas[1]
			lo_num_col << celdas[2]
			
			lo_celda << po_tabla.oCeldas.Celda(lo_num_ren,lo_num_col).oElementos
			lo_bordes << lo_celda.obten_elemento(:bordes_celda)
			lo_bordes.bBorde_sup? << _false
			lo_bordes.bBorde_inf? << _false
		_endloop
	_endif

	_if pcol_celdas[:borde_sup] _isnt _unset
	_then
		_for celdas _over pcol_celdas[:borde_sup].fast_elements()
		_loop
			lo_num_ren << celdas[1]
			lo_num_col << celdas[2]
			
			lo_celda << po_tabla.oCeldas.Celda(lo_num_ren,lo_num_col).oElementos
			lo_bordes << lo_celda.obten_elemento(:bordes_celda)
			lo_bordes.bBorde_sup? << _false
		_endloop
	_endif

	_if pcol_celdas[:borde_inf] _isnt _unset
	_then
		_for celdas _over pcol_celdas[:borde_inf].fast_elements()
		_loop
			lo_num_ren << celdas[1]
			lo_num_col << celdas[2]
			
			lo_celda << po_tabla.oCeldas.Celda(lo_num_ren,lo_num_col).oElementos
			lo_bordes << lo_celda.obten_elemento(:bordes_celda)
			lo_bordes.bBorde_inf? << _false
		_endloop
	_endif
	
_endmethod
$

_pragma(classify_level=restricted, usage={redefinable})
_method c_base_sello_fibra.serial_slots()

	(keys,values) << _super.serial_slots()

	keys.add_all_last(rope.new_with(:lst_celdas_color,:col_tablas))
	values.add_all_last(rope.new_with(.lst_celdas_color,.col_tablas))

	>> keys, values
	
_endmethod
$

_pragma(classify_level=restricted, usage={redefinable})
_method c_base_sello_fibra.pep_fibra
	## --------------------------------
	#  Para el combo de las pep's
	## --------------------------------

	_local lp_pep_fibra << hash_table.new()

	lp_pep_fibra[1] << "PEP Canalizacion Aligerada Fibra UT"
	lp_pep_fibra[2] << "PEP Canalizacion Encofrada Fibra UT"
	lp_pep_fibra[3] << "PEP Fibra Aerea UT"
	lp_pep_fibra[4] << "PEP Fibra Subterranea UT"
	lp_pep_fibra[5] << "PEP Canalizacion Aligerada Fibra ZO"
        lp_pep_fibra[6] << "PEP Canalizacion Encofrada Fibra ZO"
        lp_pep_fibra[7] << "PEP Fibra Aerea ZO"
        lp_pep_fibra[8] << "PEP Fibra Subterranea ZO"
        lp_pep_fibra[9] << ""

	_return lp_pep_fibra
	
_endmethod
$
