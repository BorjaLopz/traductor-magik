_pragma(classify_level=restricted, usage={redefinable})
_method c_captura_texto.sTexto << RsValor
## Objetivo: Asignar el texto a desplegar, este se almacena en
## el slot sTexto
## Parámetros de entrada:
## 	Cadena - RsValor - Texto a desplegar
## Parámetros de salida:   NA
## Regresa: NA
## Fecha de última modificación: 4/11/2004
## Autor de la modificación : dsanchez
## Descripción de la modificación: Se documento
	
        _self.oCaja_Texto.text << RsValor
        
_endmethod

$
_pragma(classify_level=restricted, usage={redefinable})
_method c_captura_texto.sTexto
## Objetivo: retornar en valor del slot sTexto
## Parámetros de entrada:  NA
## Parámetros de salida:   NA
## Regresa: 
## 	Cadena - sTexto : Texto a desplegar
## Fecha de última modificación: 4/11/2004
## Autor de la modificación : dsanchez
## Descripción de la modificación: Se documento
	
	_return _self.oCaja_Texto.text
	
_endmethod

$
_pragma(classify_level=restricted, usage={redefinable})
_method c_captura_texto.sOrientacion << RsValor
## Objetivo: Asignar un valor permitido al slot sOrientacion
## Parámetros de entrada:
## 	Cadena - RsValor - Orientacion del texto
##                         :left_right Horizontal
##                         :top_bottom Vertical 
## Parámetros de salida: NA
## Regresa: NA
## Fecha de última modificación: 3/11/2004
## Autor de la modificación : dsanchez
## Descripción de la modificación: Se documento
	
	_if RsValor = :left_right _or RsValor = :top_bottom
	_then
	     _self.oCaja_Texto.Orientation      << RsValor.write_string
	_else
	     condition.raise(:warning, :string, "Error al asignar la Orientación")	
	_endif
	
_endmethod

$
_pragma(classify_level=restricted, usage={redefinable})
_method c_captura_texto.sOrientacion
## Objetivo: retornar en valor del slot sOrientacion
## Parámetros de entrada:  NA
## Parámetros de salida:   NA
## Regresa: 
## 	Cadena - sOrientacion : Orientacion del Texto
## Fecha de última modificación: 3/11/2004
## Autor de la modificación : dsanchez
## Descripción de la modificación: Se documento

	# Se devuelve :left_right o :top_bottom
	_local LsOrien

	LsOrien << _self.oCaja_Texto.Orientation
	
	_return LsOrien.as_symbol()
	
_endmethod

$
_pragma(classify_level=restricted, usage={redefinable})
_method c_captura_texto.sAlineacion << RsValor
## Objetivo: Asignar un valor permitido al slot sAlineacion
## Parámetros de entrada:
## 	simbolo - RsValor - Alineacion del texto
## Parámetros de salida:   NA
## Regresa: NA
## Fecha de última modificación: 3/11/2004
## Autor de la modificación : dsanchez
## Descripción de la modificación: Se documentó

_local LsAlinVert
_local LsAlinHor
	
	_if RsValor = :centre_right _or RsValor = :centre_centre _or RsValor = :centre_left _or
	    RsValor = :top_right    _or RsValor = :top_centre    _or RsValor = :top_left _or
    	    RsValor = :bottom_right _or RsValor = :bottom_centre _or RsValor = :bottom_left 
	_then 

	   # Se extrae la alineacion Horizontal y Vertical

	   LsCadena << RsValor.write_string

	   _for LnCont  _over range(1, LsCadena.size)
	   _loop
		   _if LsCadena.subseq(LnCont,1) = "_"
		   _then
			   #Se obtiene la alineacion vertical y horizontal
			   LsAlinVert << LsCadena.subseq(1,LnCont-1)
			   LsAlinHor  << LsCadena.subseq(LnCont+1, LsCadena.size - LnCont )
		   _endif
	   _endloop
		
	   _self.Ocaja_Texto.align_Horizontal << LsAlinHor
	   _self.Ocaja_Texto.align_Vertical << LsAlinVert
	   
	_else
	   condition.raise(:warning, :string, "Error al asignar la alineación")	
	_endif
	
_endmethod

$
_pragma(classify_level=restricted, usage={redefinable})
_method c_captura_texto.sAlineacion
## Objetivo: retornar en valor del slot sAlineacion
## Parámetros de entrada:  NA
## Parámetros de salida:   NA
## Regresa: 
## 	Cadena - sAlineacion : Alineacion del texto
## Fecha de última modificación: 3/11/2004
## Autor de la modificación : dsanchez
## Descripción de la modificación: Se documentó

	# Se devuelve un valor como : :centre_right / :centre_centre / :centre_left

	_local LsAlinea

        LsAlinea << _self.Ocaja_Texto.align_Vertical + "_" + _self.Ocaja_Texto.align_Horizontal
	
	_return LsAlinea.as_symbol()
	
_endmethod

$
_pragma(classify_level=restricted, usage={redefinable})
_method c_captura_texto.nTamanio << RnValor
## Objetivo: Asignar un valor permitido al slot nTamanio
## Parámetros de entrada:
## 	Entero - RnValor : Tamanio de letra del texto
## Parámetros de salida:   NA
## Regresa: NA
## Fecha de última modificación: 4/11/2004
## Autor de la modificación : dsanchez
## Descripción de la modificación: Se documentó

	_if RnValor > 0 
	_then
	    _self.oCaja_Texto.Font_Size << RnValor
	_else
	   condition.raise(:warning, :string, "Debe ser un número positivo.")	
	_endif
	
_endmethod

