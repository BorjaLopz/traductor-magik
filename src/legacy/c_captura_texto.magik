_package user
#remex(:c_captura_texto)

$
def_slotted_exemplar(:c_captura_texto,
		     {
			{:sTexto,        _unset}, # Texto a desplegar
			{:sOrientacion,  _unset}, # Orientacion del Texto
			{:sAlineacion,   _unset}, # Alineacion del Texto
			{:nTamanio,      _unset}, # Tamaño de letra OK
			{:sEstilo,       _unset}, # Estilo
			{:sColor,        _unset}, # Color
			{:oCaja_Texto,   _unset}, # Elemento caja de texto
			{:bAjuste_Linea?,   _unset}, # Alineacion del Texto uso interno OK
			{:bRecorte?, _unset}         # Alineacion del Texto uso interno OK
			
		     },
		     :c_base_layout
)


$
c_captura_texto.define_slot_access(:sTexto,            :writable, :private)
c_captura_texto.define_slot_access(:sOrientacion,      :writable, :private)
c_captura_texto.define_slot_access(:sAlineacion,       :writable, :private)
c_captura_texto.define_slot_access(:nTamanio,          :writable, :private)
c_captura_texto.define_slot_access(:sEstilo,           :writable, :private)
c_captura_texto.define_slot_access(:sColor,            :writable, :private)
c_captura_texto.define_slot_access(:oCaja_Texto,       :writable, :private)
c_captura_texto.define_slot_access(:bAjuste_Linea?,    :writable, :private)
c_captura_texto.define_slot_access(:bRecorte?,         :writable, :private)



$
_pragma(classify_level=restricted, usage={redefinable})
_method c_captura_texto.new(RsNombre)
## Objetivo: Crear una instancia de celda
## Parámetros de entrada:
## 	Cadena - RsNombre - Número del elemento grafico
## Parámetros de salida:   NA
## Regresa: 
## 	c_texto_grafico - regresa un objeto c_texto_grafico
## Fecha de última modificación: 11/Noviembre/2004
## Autor de la modificación : dsanchez
## Descripción de la modificación: Se documentó

        # Se crea la instancia
        oCaja << bounding_box.new(0,0,100,100)
	_self.oCaja_Texto << textbox_layout.new_with(:bounds,oCaja)

	# Se asigna el texto
        _self.sTexto << RsNombre
        _self.oCaja_Texto.text << _self.sTexto
	
	# Se quita los bordes
        _self.oCaja_Texto.outline_style  << _unset
	_self.oCaja_Texto.set_fill_colour(_unset)

		# Por default se cancela el ajuste de linea y el recorte de texto
        _self.bAjuste_Linea? << _false 
        _self.bRecorte?      << _false 

	_self.sAlineacion  << :centre_left
	_self.sOrientacion << :left_right
		
	#	_self.oCaja_Texto.set_fill_colour(colour.called("green"))  OK
	#       _self.oCaja_Texto.set_foreground_line_colour(colour.called("white"))  OK


	#valores por defecto de las celdas
	_self.sColor << "black"
	_self.nTamanio << 10
	_self.sEstilo << "bold"
	
	_return _clone
	
_endmethod
$

_pragma(classify_level=restricted, usage={redefinable})
_method c_captura_texto.new_from(RoObjeto, _optional RsTexto)
## Objetivo: Constructor de copia
## Parámetros de entrada: 
##    c_simbolo_grafico - RoObjeto - Objeto del cual se copiaran los atributos
## Parámetros de salida:   NA
## Regresa:  
##    c_Simbolo_grafico - Instancia de Simbolo_grafico 
## Fecha de última modificación : 04/01/04
## Autor de la modificación :
## Descripción de la modificación :
##    10/03/05 DSB Se movieron las instrucciones que crean el bounding_box
##                 antes de la asignacion sTexto	
##    08/03/05 DSB Se implemento la copia de los margenes	
##    23/12/04    se valido que el objeto sea de tipo c_simbolo_grafico


   _if RoObjeto.is_kind_of?(c_captura_texto)
   _then

	# Se crea la instancia del bounding_box
        # estos valores no importan, los valores definitivos los toma de la celda
        LoCaja << bounding_box.new(0,0,100,100)
	_self.oCaja_Texto << textbox_layout.new_with(:bounds, LoCaja)
	   
        _if RsTexto = _unset 
	_then
           _self.sTexto << RoObjeto.sTexto	
	_else
	   _self.sTexto << RsTexto
	_endif


	# Se quita los bordes
        _self.oCaja_Texto.outline_style  << _unset
	_self.oCaja_Texto.set_fill_colour(_unset)

	# Por default se cancela el ajuste de linea y el recorte de texto
        _self.bAjuste_Linea? << RoObjeto.bAjuste_Linea? 
        _self.bRecorte?      << RoObjeto.bRecorte?

	_self.sAlineacion  << RoObjeto.sAlineacion
	_self.sOrientacion << RoObjeto.sOrientacion
		
	#valores por defecto de las celdas
	LoRojo  << RoObjeto.oCaja_Texto.colour.red
	LoAzul  << RoObjeto.oCaja_Texto.colour.blue
	LoVerde << RoObjeto.oCaja_Texto.colour.green

	
	_self.oCaja_Texto.colour << colour.new_with_properties(:red,LoRojo, :green, LoVerde, :blue, LoAzul)
	
	_self.nTamanio << RoObjeto.nTamanio
	_self.sEstilo  << RoObjeto.sEstilo 

        _self.nMargen_inf << RoObjeto.nMargen_inf / 10
        _self.nMargen_sup << RoObjeto.nMargen_sup / 10
        _self.nMargen_izq << RoObjeto.nMargen_izq / 10
        _self.nMargen_der << RoObjeto.nMargen_der / 10 	
	
	_return _clone
   _else
	condition.raise(:warning, :string, "El objeto que se proporciono, no es de tipo c_captura_texto")	
   _endif 	         
	
_endmethod
$

_pragma(classify_level=restricted, usage={redefinable})
_method c_captura_texto.Despliega()
## Objetivo: Realizar el dibujo del los textos
## Parámetros de entrada: NA
## Parámetros de salida:  NA 
## Regresa: NA
## Fecha de última modificación: 28/10/2004
## Autor de la modificación : fdiaz
## Descripción de la modificación: Se documentó


 	 _self.oCaja_texto.bounds << _self.oArea


_endmethod

