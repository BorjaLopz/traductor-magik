$
c_celdas_grafico.define_slot_access(:bVoltear_H,         :writable, :private)
$
c_celdas_grafico.define_slot_access(:bVoltear_V,         :writable, :private)
$
c_celdas_grafico.define_slot_access(:nGrados,            :writable, :private)
$
c_celdas_grafico.define_slot_access(:sColorLinea,        :writable, :private)
$
c_celdas_grafico.define_slot_access(:sNombre_grafico,    :writable, :private)
$
