_pragma(classify_level=restricted, usage={redefinable})
_method c_celdas_grafico.Despliega()
## Objetivo: Realizar el dibujo de la celda
## Parámetros de entrada : NA 
## Parámetros de salida: NA  
## Regresa: NA
## Fecha de última modificación: 28/10/2004
## Autor de la modificación : fdiaz
## Descripción de la modificación: Se documentó

_local LoEstiloLinea # Objeto del tipo Line_Style, utilizada para dibujar.

	# Se define el estilo de linea
	LoEstiloLinea << line_style.new_with_properties(
                  :foreground_colour, _self.color_linea, 
                  :width, 2)


	# Dibuja el borde superior si se solicito	 
	_if _self.bBordeSup _is _true 
	_then
		_local LoCoordena # Almacena dos coordenadas para dibujar una linea
		
		LoCoordenada << coords_vector.new(2)
		LoCoordenada[1] << coordinate.new(_self.oArea.Xmax ,_self.oArea.YMax)
		LoCoordenada[2] << coordinate.new(_self.oArea.Xmin ,_self.oArea.YMax)
		_self.oVentana.draw_line_transform(LoEstiloLinea, LoCoordenada)
	_endif

	# Dibuja el borde inferior si se solicito	 
	_if _self.bBordeInf _is _true 
	_then
		_local LoCoordena # Almacena dos coordenadas para dibujar una linea
		
		LoCoordenada << coords_vector.new(2)
		LoCoordenada[1] << coordinate.new(_self.oArea.Xmin, _self.oArea.Ymin)
		LoCoordenada[2] << coordinate.new(_self.oArea.Xmax ,_self.oArea.YMin)
		_self.oVentana.draw_line_transform(LoEstiloLinea, LoCoordenada)
	_endif

	# Dibuja el borde izquierdo si se solicito	 
	_if _self.bBordeIzq _is _true 
	_then
		_local LoCoordena # Almacena dos coordenadas para dibujar una linea
		
		LoCoordenada << coords_vector.new(2)
		LoCoordenada[1] << coordinate.new(_self.oArea.Xmin ,_self.oArea.YMax)
		LoCoordenada[2] << coordinate.new(_self.oArea.Xmin ,_self.oArea.Ymin)		
		_self.oVentana.draw_line_transform(LoEstiloLinea, LoCoordenada)
	_endif

	# Dibuja el borde derecho si se solicito	 
	_if _self.bBordeDer _is _true 
	_then
		_local LoCoordena # Almacena dos coordenadas para dibujar una linea
		
		LoCoordenada << coords_vector.new(2)
		LoCoordenada[1] << coordinate.new(_self.oArea.Xmax ,_self.oArea.YMin)
		LoCoordenada[2] << coordinate.new(_self.oArea.Xmax ,_self.oArea.YMax)
		_self.oVentana.draw_line_transform(LoEstiloLinea, LoCoordenada)
	_endif
	
_endmethod
$
_pragma(classify_level=restricted, usage={redefinable})
_method c_celdas_grafico.init()
	## 
	## 
	_self.color_linea << colour.new_rgb(0.0, 0.0, 0.0)
	_return _self
	
_endmethod
$
_pragma(classify_level=advanced, topic={plotting}, usage={subclassable})
_method c_celdas_grafico.init_with( props )

	_super.init_with( props )

	_self.bborde_der? << props[:bBordeDer]
	_self.bborde_inf? << props[:bBordeInf]
	_self.bborde_izq? << props[:bBordeIzq]
	_self.bborde_sup? << props[:bBordeSup]

	>> _self
	
_endmethod
$
_pragma(classify_level=restricted, usage={redefinable})
_method c_celdas_grafico.new()
## Objetivo: Metodo que se crea una nueva instancia
## Parámetros de entrada: NA
## Parámetros de salida:   NA
## Regresa:  
## 	c_celdas_grafico - Una instancia de la clase
## Fecha de última modificación : 28 / Octubre / 2004
## Autor de la modificación fdiaz
## Descripción de la modificación : Creación
	
	_return _clone.init()
	
_endmethod
$
_pragma(classify_level=restricted)
_method c_celdas_grafico.serial_slots()

	( keys , values ) << _super.serial_slots()
	
	keys.add_all_last(rope.new_with(:bBordeSup,:bBordeInf,:bBordeIzq,:bBordeDer,:ColorLinea))
	values.add_all_last(rope.new_with(.bBordeSup,.bBordeInf,.bBordeIzq,.bBordeDer,.sColorLinea))
	
	_return keys, values

_endmethod
$
