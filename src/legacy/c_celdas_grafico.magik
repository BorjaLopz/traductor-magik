_package user
$
def_slotted_exemplar(:c_celdas_grafico,
		     {
			     {:sNombre_Grafico, _unset}, # Nombre del grafico
			     {:bVoltear_H,  _false },    # La imagen se volteara horizontalmente
			     {:bVoltear_V,  _false },    # La imagen se volteara verticalmente
			     {:nGrados,     0},          # La imagen se girara N grados
			     {:bBordeSup, _false},       # Se dibuja el borde superior
			     {:bBordeInf, _false},       # Se dibuja el borde inferior
			     {:bBordeIzq, _false},       # Se dibuja el borde izquierdo
			     {:bBordeDer, _false}, 	 # Se dibuja el borde derecho
			     {:sColorLinea, _unset} 	 # Se dibuja el borde derecho
		     },
		     :c_elemento_grafico
)

$
c_celdas_grafico.define_slot_access(:bBordeDer,          :writable, :private)
$
c_celdas_grafico.define_slot_access(:bBordeInf,          :writable, :private)
