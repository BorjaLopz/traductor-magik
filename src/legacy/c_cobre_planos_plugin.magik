$
c_cobre_planos_plugin.define_shared_constant(:databus_consumer_data_types,
						  {
							  :map_selection,
							  :record_selection,
							  :active_map_view
						  },
						  :public)
$
c_cobre_planos_plugin.define_shared_constant(:CARTA_LARGO,2160.00,:public )
$
c_cobre_planos_plugin.define_shared_constant(:CARTA_ALTO,2790.00,:public )
$
c_cobre_planos_plugin.define_shared_constant(:s_msg_area_act,"Debe existir un estudio activo",:public )
