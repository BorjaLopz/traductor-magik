_pragma(classify_level=restricted, usage={redefinable})
_method c_cobre_planos_plugin.AddNorte(PoPage)
	## 
	##
_local LoBounds
_local LoNorte
_local LoPage

        LoPage<<PoPage
	
	_if LoPage _isnt _unset _andif LoPage.is_kind_of?(layout_page)
	_then
		Lobounds<<bounding_box.new(LoPage.bounds.xmin,LoPage.bounds.ymax-1500,
					   LoPage.bounds.xmin+1000,LoPage.bounds.ymax)
		LoNorte << c_norte.new_with(:bounds,Lobounds)
		LoNorte.limites<<_unset
		LoPage.add_element(LoNorte)
	_endif
_endmethod
$
_pragma(classify_level=restricted, usage={redefinable})
_method c_cobre_planos_plugin.GetDtosDeUserBuilding(PoUserBuilding)
	## 
	##
_local LcollTabDtos
_local LcollRes
_local LcollDtosEncontrados

       # Buscar Distritos fuera del edificio.
       LcollDtosEncontrados<<rope.new()
       LcollTabDtos<<gis_program_manager.cached_dataset(:landbase).collections[:user!_distrito]
       LcollRes<<LcollTabDtos.select(predicate.interacts(:user!_limite,PoUserBuilding.location))
       _if LcollRes.empty?
       _then
	       # Buscar Distritos dentro del edificio.
	       LoSpatialContext<<PoUserBuilding.get_spatial_context(:internal)
	       LcollInternalGeoms<<LoSpatialContext.elements[1].world.geometry_set()
	       LcollRegistros<<LcollInternalGeoms.select(:collection,
							 {:user!_distrito}).rwo_set()

	       _if LcollRegistros.empty?.not
	       _then
		       _for LoRec _over LcollRegistros.fast_elements()
		       _loop
			       LcollDtosEncontrados.add(LoRec)
		       _endloop
	       _endif
       _else
	       _for LoRec _over LcollRes.fast_elements()
	       _loop
		       LcollDtosEncontrados.add(LoRec)
	       _endloop
	_endif
	_return LcollRes
_endmethod
$
