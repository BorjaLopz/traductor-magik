_pragma(classify_level=restricted, usage={redefinable})
_method c_construccion_canalizacion.serial_slots()

	keys << rope.new_with( :oTablas, :celdas_color, :blanco_negro )
	values << rope.new_with( .oTablas, .lst_celdas_color, .b_blanco_negro? )

	>> keys, values
	
_endmethod
$
_pragma(classify_level=restricted, usage={redefinable})
_method c_construccion_canalizacion.serial_structure

	>> :slotted
	
_endmethod
$
