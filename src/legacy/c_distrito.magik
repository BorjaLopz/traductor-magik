_pragma(classify_level=restricted, usage={redefinable})
_method c_distrito.reservas_existentes
   	## Parámetros de entrada:
   	## Parámetros de salida:
	##    col_reservas - rope con las reservas existentes
	##                   asociadas al distrito
	## vbluna(11-nov-06)
	
	_local col_reservas << rope.new()

        _try
		_for reserva _over .objeto.user!_reservas.fast_elements()
		_loop
			_if reserva.construction_status = "EXISTENTE"
			_then
				col_reservas.add(reserva)
			_endif
		_endloop
	_when does_not_understand
		write("Error al obtener las reservas existentes")
	_endtry

	_return col_reservas
	
_endmethod
