_pragma(classify_level=restricted, usage={redefinable})
_method c_distrito.pep_referencias(p_tipo, Ptipo_diseno )
	#busca en todas las pep las referencias segun las oes
	#
        # p_tipo : CONSTRUCCCION, DESMONTAJE , RECONCENTRACION , _unset 
	# p_tipo_diseno :principales,  :secundaria, :canalizacion
	
	_local diseno_activo   << swg_dsn_admin_engine.active_design
	_local tipo_diseno     << diseno_activo.tipo_diseno
	_local proyecto_activo << diseno_activo.project
	_local l_clave_pep     << ""
	_local LcInfo          << property_list.new()

	_for iterScheme  _over proyecto_activo.schemes.fast_elements()
	_loop
		_for  iterOE _over iterScheme.user!_oe_locals.elements()
		_loop
			info << iterOE.informacion_administrativa

			_if p_tipo _is _unset 
			_then
				cond <<  info[:tipo_diseno] _is  Ptipo_diseno
			_else
				cond << info[:tipo_pep] = p_tipo _andif info[:tipo_diseno] _is  Ptipo_diseno
			_endif

			_if  cond
			_then
				LcInfo[iterOE.id] << info
				l_clave_pep << info[:clave_pep]		
			_endif			
		_endloop	
	_endloop
	
	_return LcInfo, l_clave_pep
_endmethod
$
_pragma(classify_level=restricted, usage={redefinable})
_method c_distrito.ordena_cables_secundariosXcuenta(LoCables_Secundarios)
   ## Método para ordenar los cables secundarios en base a la
   ## cuenta que poseen.
   ##
   #1.- primero obtenemos la cuenta "menor" de cada cable 

   lista_cables_secundarios << hash_table.new()
   lista_ordenada << rope.new()    
          
    _for cable_sec  _over LoCables_Secundarios.fast_elements()
    _loop
	# cuenta_menor << "A1"
	contador << 1 
	_for mfp _over cable_sec.get_all_in_fiber_pins().fast_elements()
	_loop
	    _if contador = 1
	    _then
		cuenta_menor <<  mfp.obtener_cuenta()		 
	    _elif mfp.obtener_cuenta().write_string.size > 0 _andif
		  cuenta_menor >= mfp.obtener_cuenta()		    
	    _then
		  cuenta_menor <<  mfp.obtener_cuenta()		      
	    _endif
	    contador +<< 1
	    #write("@PREVALEECEE CUENTA MENOR VALEEE  ", cuenta_menor) 	  	       
	_endloop	    
	
	lista_cables_secundarios[cuenta_menor.as_symbol()] << cable_sec 
    _endloop
    
    _if lista_cables_secundarios.size > 0
    _then
       _loop
	   _if lista_cables_secundarios.size = 0
	   _then
		   _leave
	   _else
		   elemento_menor << lista_cables_secundarios.a_key()
		   #write("@@ELEMENTOOO MENOR ", elemento_menor)
		   
		   _for key, elemento _over lista_cables_secundarios.fast_keys_and_elements()
		   _loop
			   #write("@KEEEY ", key)
			   #write("@elemento  ", elemento)
			   _if elemento_menor.write_string >=  key.write_string
			   _then
				   elemento_menor << key
				   #write("ELEMENTO ASIGNADOOO MENORRR ", elemento_menor)		   
				   cable_menor << elemento
				   llave_eliminar << key
			   _endif
		   _endloop 
		    
		   lista_ordenada.add(cable_menor)
		   lista_cables_secundarios.remove_key(elemento_menor) 
	   _endif
       _endloop 	
    _endif
    
    _return lista_ordenada 
    #_return lista_cables_secundarios
    
_endmethod 
$
_pragma(classify_level=restricted, usage={redefinable})
_method c_distrito.primera_cd_existente
	## En caso de existir más de una cd existente en el distrito,
	## se retorna la cd que tenga asignadas las primeras cuentas (A) 

	_if (cd_exist << _self.cajas_existentes).size > 1
	_then
		_for caja _over cd_exist.fast_elements()
		_loop
			_for mufa _over caja.user!_mufas.fast_elements()
			_loop
				_for ocup_sec _over mufa.user!_ocup_secundarias.fast_elements()
				_loop
					_if ocup_sec.user!_ocup_sec = "A"
					_then
						_return caja
					_endif
				_endloop
			_endloop
		_endloop
		_return cd_exist.an_element()
	_elif _self.cajas_existentes.size = 1
	_then
		_return _self.cajas_existentes.an_element()
	_endif
	
_endmethod
$
_pragma(classify_level=restricted, usage={redefinable})
_method c_distrito.red_secundaria_dentro(LoEdificio)
	## 
	##

	LoRegistros << rope.new()
	Paff << smallworld_product.pni_application()
	## Ir al mundo interno del edificio
	Paff.manager.goto_context(LoEdificio,:internal)	
	LoMv      << paff.plugin(:map_plugin).current_map_view
	LoGeoms   << LoMv.get_visible_geometry_set()
	Limite    << pseudo_area.new_with_sectors(LoGeoms.bounds.sectors)
	LoPred2   << predicate.within(:inside_location, {Limite})
	Registros << LoGeoms.select(:predicate,{:user!_registro_tablero, LoPred2})
	_for LoReg _over Registros.fast_elements()
	_loop
            _if LoReg.class_name _is :point
	    _then
		## valimos que registros tableros traen mufas
		_if LoReg.rwo.user!_mufas.size > 0
		_then
	            LoRegistros.add(LoReg.rwo)
		_endif
	    _endif		   
	_endloop

	## Regresar al mundo del Gis
	
	#Paff.manager.goto_primary_context(LoEdificio.location)
	
	_return LoRegistros
	
_endmethod
