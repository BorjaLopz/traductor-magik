_pragma(classify_level=restricted, usage={redefinable})
_method c_distrito.es_terminal_doble?(PoLista_hash_terminales,PoCuentaSec )
  ## Met. para determinar si un terminal de fo es de tipo doble o no. 
  ##

 loBandera << _false
 
  _for k,i _over PoLista_hash_terminales.fast_keys_and_elements()
  _loop
	 # write("K " ,k)
	#  write("II ",i ) 
	_if k.write_string.size > 2 _andif
	    (k.write_string.slice(1,2) = PoCuentaSec _orif
	     k.write_string.slice_to_end(4) = PoCuentaSec ) 
	_then 
	     bandera << _true 
	     _return bandera, i
	    # (13/05/08 rhernan) : se comenta el return false para que no
	    # devuelva false sin antes haber revisado el resto.
	    #	_else 
	    #	     _return _false
	_endif
  _endloop
  
  _return bandera 
 
_endmethod
