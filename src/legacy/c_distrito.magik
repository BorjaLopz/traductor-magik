_pragma(classify_level=restricted, usage={redefinable})
_method c_distrito.cantidad_lotes

   	## Parámetros de entrada:
   	## Parámetros de salida:
	##     - número de lotes en el distrito
	## vbluna

	_return .col_lotes.size
	
_endmethod
$
_pragma(classify_level=restricted, usage={redefinable})
_method c_distrito.cantidad_manzanas

	_local lb_es_manzana
	_local ln_cantidad_manzanas_en_lote << 0
	_local ln_cantidad_manzanas_en_distrito << 0
	
	ln_cantidad_manzanas_en_distrito << _self.cantidad_manzanas_geograficas
	
	_for e_lote _over _self.lotes.fast_elements()
	_loop
		(lb_es_manzana,ln_cantidad_manzanas_en_lote) <<  e_lote.manzanas_en_lote()

		_if lb_es_manzana
		_then
			ln_cantidad_manzanas_en_distrito +<< ln_cantidad_manzanas_en_lote
		_endif
	_endloop

	_return  ln_cantidad_manzanas_en_distrito  
	
_endmethod
$
_pragma(classify_level=restricted, usage={redefinable})
_method c_distrito.cantidad_manzanas_geograficas

   	## Parámetros de entrada:
   	## Parámetros de salida:
	##     - número de manzanas en el distrito considerando que si
	## un límite de distrito no abarca la manzana completa solo se
	## contabiliza el porcentaje de la manzana que está dentro del
	## límite de distrito
	## (vbluna-10-julio-06)

	_try
		_local ln_manzanas << 0
		
		l_tbl_mzna  << gis_program_manager.cached_dataset(:landbase).collections[:user!_manzana]
		l_predicate << predicate.interacts(:user!_limite, .objeto.user!_limite)
		l_sel_mzna  << l_tbl_mzna.select(l_predicate)

		_for e_mzna _over l_sel_mzna.fast_elements()
		_loop
			_if e_mzna.user!_limite.porcentaje_de_interseccion_con(.objeto.user!_limite)/100 = 1
			_then
				ln_manzanas +<<1 
			_endif
		_endloop

		_return ln_manzanas
		
	_when does_not_understand
		_return 0
	_endtry
	
_endmethod
$
_pragma(classify_level=restricted, usage={redefinable})
_method c_distrito.codigo_postal

   	## Parámetros de entrada:
   	## Parámetros de salida:
	##    - string con el código postal asociado a la colonia en la
	##    cual se encuentra la cd del distrito
	## vbluna

	_try
		_return _self.colonia.user!_cp.write_string
	_when does_not_understand
	      _return ""
	_endtry

_endmethod
$
_pragma(classify_level=restricted, usage={redefinable})
_method c_distrito.colonia

	## Asigna al slot el objeto user!_colonia en el cual se
	## encuentra ubicada la cd existente
	## (vbluna/11-10-06)

	_if .colonia_cd _is _unset
	_then
		_try
			gpm << gis_program_manager
			l_tbl_colonia << gpm.cached_dataset(:landbase).collections[:user!_colonia]

			## Para Distritos que no son abiertos, la red se encuentra dentro
			## de Edificios, validar sino hay CD en Gis, entonces
			## probablemente toda la Red se encuentra dentro de Edificios.

			LoCd << _self.cajas_existentes.an_element()
			
			_if LoCd _is _unset 
			_then			    
			    LoTablaEdi << gis_program_manager.cached_dataset(:gis).collection(:user!_building)
			    LoEdi << predicate.interacts(:boundary, .objeto.user!_limite)
			    LoseEdi << LoTablaEdi.select(LoEdi)
			    _if LoseEdi.size > 0
			    _then
				# Se obtiene la Colonia respecto al Edificio encontrado
			        l_predicate   << predicate.contains(:user!_limite,
						     LoseEdi.an_element().location)
			    _endif
			    
			_else
			    # Se obtiene la Colonia respecto a la CD encontrada
			    l_predicate   << predicate.contains(:user!_limite,
						     _self.cajas_existentes.an_element().location)
			_endif
			
			l_sel_colonia << l_tbl_colonia.select(l_predicate)

			.colonia_cd << l_sel_colonia.an_element()
		_when does_not_understand
		_endtry
	_endif

	_return .colonia_cd
	
_endmethod
$
_pragma(classify_level=restricted, usage={redefinable})
_method c_distrito.corte_caja_red_princ
	
	## Objetivo:
	##     - Obtener la ocupacion principal asociada al distrito
   	## Parámetros de entrada:
   	## Parámetros de salida:    col_corte_princ << hash_table
	##    - [:|Numero_Strip|] << Ocupacion x strip
	##    - [:|Total|]        << Ocupacion total
	## vbluna

	_local col_corte_princ << hash_table.new()
	_local ls_id_strip
	_local ln_ocup_strip

	## Fhramire
	## Bloque para determinar si el Plano de Construccion
	## es sobre Edificio (distrito cerrado).
	## La red de cobre se encuentra dentro del edificio	

	## Determinar si el corte de caja es en distrito cobre abierto.
	## La variable LoRedSecun es un rope con todas las caja de distribucion
	## existentes dentro del distrito.
	## para el caso de edificios, entonces sera un rope con
	## registros tableros.
	_Local LoBanSec << _false 
	LoRedSecun << _self.cajas_existentes

	_for LoCD _over LoRedSecun.fast_elements()
	_loop
	     LoMufas << _self.mufas_existentes(LoCD)
	     _if LoMufas.size > 0
	     _then
		 LoBanSec << _true
	     _endif	     	
	_endloop

	
	## Si LoRedSec es true, entonces quiere decir que el corte de Caja
	## es en Dto. Abierto, de otra manera buscamos si existe red en
	## Edificios.

	_if LoBanSec _is _false 
	_then
	    ## Buscar si hay edificios, ademas si hay
	    ## red secundaria dentro
	    LoEdificio << _self.busca_edificio
	    # Si hay edificios, entonces buscar red secundaria
	    # dentro del edificio.
	    _if LoEdificio _isnt _unset 
	    _then	    
	        LoRedSecun << _self.red_secundaria_dentro(LoEdificio)
	    _endif
	_endif	
	
	
	#Para cada caja existente en el distrito
	#_for caja _over _self.cajas_existentes.fast_elements()

	_for caja _over LoRedSecun.fast_elements()
	_loop
		#Recorrer las mufas existentes asociadas al distrito
		_for mufa _over _self.mufas_existentes(caja).fast_elements()
		_loop
			#Para cada mufa recorrer los strips asociados
			_for strip _over mufa.user!_strips.fast_elements()
			_loop
				#Asignar el id del strip y su ocupación asociada
				ls_id_strip   << strip.user!_numero.write_string.as_symbol()
				ln_ocup_strip << strip.user!_ocupacion.default(0)

				#Asignar los valores por cada strip y el valor total a la hash
				# table 
				col_corte_princ[ls_id_strip] <<
					col_corte_princ[ls_id_strip].default(0) + ln_ocup_strip
				col_corte_princ[:|Total|] <<
					col_corte_princ[:|Total|].default(0) + ln_ocup_strip
			_endloop
		_endloop
	_endloop

	_return col_corte_princ
	
_endmethod
$
_pragma(classify_level=restricted, usage={redefinable})
_method c_distrito.corte_caja_red_sec

	## Objetivo:
	##     - Obtener la ocupacion secundaria asociada al distrito
   	## Parámetros de entrada:
   	## Parámetros de salida:    col_corte_sec << dual_key_a_table
	##    - [:|Letra_Terminal|, :|Número_Terminal|] << Ocupacion_x_Terminal
	##    - [:|Letra Terminal|, :|SUMA|]           << Ocupacion_x_letra_Terminal
	##    - [:|Total|        , :|Total|]          << Ocupacion_x_todas_Terminales
	## vbluna

	_local col_corte_sec << dual_key_a_table.new()
	_local ls_id_terminal
	_local ln_ocup_terminal

	# Fhramire, 7/septiembre/2012
	_Local LoBanSec << _false	
	LoRedSecun << _self.cajas_existentes

	_for LoCD _over LoRedSecun.fast_elements()
	_loop
	     LoMufas << _self.mufas_existentes(LoCD)
	     _if LoMufas.size > 0
	     _then
		 LoBanSec << _true
	     _endif	     	
	_endloop

	## Si LoRedSec es true, entonces quiere decir que el corte de Caja
	## es en Dto. Abierto, de otra manera buscamos si existe red en
	## Edificios.

	_if LoBanSec _is _false 
	_then
	    ## Buscar si hay edificios, ademas si hay
	    ## red secundaria dentro
	    LoEdificio << _self.busca_edificio
	    # Si hay edificios, entonces buscar red secundaria
	    # dentro del edificio.
	    _if LoEdificio _isnt _unset 
	    _then	    
	        LoRedSecun << _self.red_secundaria_dentro(LoEdificio)
	    _endif
	_endif			

	#Para cada caja existente en el distrito
	#_for caja _over _self.cajas_existentes.fast_elements()

	_for caja _over LoRedSecun.fast_elements()
	_loop
	    #Recorrer las mufas asociadas a cada caja
	    _for mufa _over _self.mufas_existentes(caja).fast_elements()
	    _loop
		#Recorrer las ocupaciones secundarias asociadas a las mufas
		_for terminal _over mufa.user!_ocup_secundarias.fast_elements()
		_loop
		    #Asignar la id de la terminal
		    ls_id_terminal << terminal.user!_ocup_sec.write_string.as_symbol()
			
		    #Asignar el valor de la terminal para cada numero
		    col_corte_sec[ls_id_terminal,:|1|] << terminal.user!_uno.default(0) +
							  col_corte_sec[ls_id_terminal,:|1|].default(0)
		    col_corte_sec[ls_id_terminal,:|2|] << terminal.user!_dos.default(0) +
							  col_corte_sec[ls_id_terminal,:|2|].default(0)
		    col_corte_sec[ls_id_terminal,:|3|] << terminal.user!_tres.default(0) +
							  col_corte_sec[ls_id_terminal,:|3|].default(0)
		    col_corte_sec[ls_id_terminal,:|4|] << terminal.user!_cuatro.default(0) +
							  col_corte_sec[ls_id_terminal,:|4|].default(0)
		    col_corte_sec[ls_id_terminal,:|5|] << terminal.user!_cinco.default(0) +
							  col_corte_sec[ls_id_terminal,:|5|].default(0)
				
		    #Asignar la ocupacion total de cada terminal
		    ln_ocup_terminal << terminal.user!_uno.default(0) +
					terminal.user!_dos.default(0) +
					terminal.user!_tres.default(0) +
					terminal.user!_cuatro.default(0) +
					terminal.user!_cinco.default(0)
		    
		    col_corte_sec[ls_id_terminal,:|SUMA|] << ln_ocup_terminal +
							     col_corte_sec[ls_id_terminal,:|SUMA|].default(0)
		    
		    col_corte_sec[:|Total|,:|Total|] << ln_ocup_terminal +
							col_corte_sec[:|Total|,:|Total|].default(0)
		_endloop
	    _endloop
	_endloop
	
	_return col_corte_sec
	
_endmethod
