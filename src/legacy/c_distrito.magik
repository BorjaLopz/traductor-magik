	_return _self
	
_endmethod
$
_pragma(classify_level=restricted, usage={redefinable})
_method c_distrito.lineas_saturacion

	## Objetivo:
	##    - Obtener las lineas a saturacion X NSE en el distrito =
	##    (Viviendas sin servicio * Factor de penetracion) + Lineas
   	## Parámetros de entrada:
   	## Parámetros de salida:
	##    .col_lin_sat - hash_table con el numero de lineas a
	##                   saturacion x cada NSE asociadas al distrito
	## vbluna

	_local l_col_lineas  << _self.viviendas_lineas

	.col_lin_sat.default_value << 0.0
	
	_local ln_factor_pen
	_local ln_viv_sin_serv
	_local ln_num_lineas
	_local ln_lineas_satura

	_for nse, value _over _self.factor_pen_nse.keys_and_elements()
	_loop
		ln_factor_pen   << value.default(0.0)
		ln_viv_sin_serv << l_col_lineas[nse][:viv_sin_servicio].default(0)
		ln_num_lineas   << l_col_lineas[nse][:abonados].default(0)
		ln_lineas_satura << (ln_viv_sin_serv * ln_factor_pen) + ln_num_lineas

		_if ln_num_lineas > ln_lineas_satura
		_then
			.col_lin_sat[nse] << .o_format_float.format(ln_num_lineas)
		_else
			.col_lin_sat[nse] << .o_format_float.format(ln_lineas_satura)
		_endif
		
		.col_lin_sat[:|Total|] +<< .col_lin_sat[nse].as_number()
	_endloop

	.col_lin_sat[:|Total|] << .col_lin_sat[:|Total|].ceiling
	
	_return .col_lin_sat
	
_endmethod
