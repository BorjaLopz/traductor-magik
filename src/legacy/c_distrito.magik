_pragma(classify_level=restricted, usage={redefinable})
_method c_distrito.nombre_delegacion_municipio

	## String con el nombre de la delegacion o municipio en donde
	## se encuentra ubicada la cd existente
	## (vbluna/11-10-06)
	
	_try
		gpm << gis_program_manager
		l_tbl_mpo << gpm.cached_dataset(:landbase).collections[:user!_municipio]


		LoCd << _self.cajas_existentes.an_element()
			
		_if LoCd _is _unset 
		_then			    
		    LoTablaEdi << gis_program_manager.cached_dataset(:gis).collection(:user!_building)
		    LoEdi << predicate.interacts(:boundary, .objeto.user!_limite)
		    LoseEdi << LoTablaEdi.select(LoEdi)
		    _if LoseEdi.size > 0
		    _then
			    # Se obtiene la Delegacion/Municipio respecto al Edificio encontrado
			    l_predicate   << predicate.contains(:user!_limite,
								LoseEdi.an_element().location)
		    _endif		    
		_else
			# Se obtiene la Delegacion/Municipio respecto a la CD encontrada
			l_predicate   << predicate.contains(:user!_limite,
							    _self.cajas_existentes.an_element().location)
		_endif

		
		_return l_sel_mpo << l_tbl_mpo.select(l_predicate).an_element().user!_nombre_telmex
		
	_when does_not_understand
		_return ""
	_endtry
	
	
_endmethod
