_pragma(classify_level=restricted, usage={redefinable})
_method c_distrito.mufas_existentes(p_caja)

	## Objetivo:
	##     - Obtener las mufas con estado de
	##     construccion = "EXISTENTE" asociadas a p_caja
   	## Parámetros de entrada:
	##     p_caja - objeto mit_terminal_enclosure
   	## Parámetros de salida:
	##     col_mufas_exis - rope con las mufas existentes
	## vbluna

	_local col_mufas_exis << rope.new()
	
	_for mufa _over p_caja.user!_mufas.fast_elements()
	_loop
		_if mufa.construction_status = "EXISTENTE"
		_then
			col_mufas_exis.add(mufa)
		_endif
	_endloop

	_return col_mufas_exis
	
_endmethod
