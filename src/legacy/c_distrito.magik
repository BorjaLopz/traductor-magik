def_slotted_exemplar(:c_distrito,
{
	{:objeto,           _unset, :writable},
	{:inventario,       _unset, :writable},
	{:col_viv_lin,      _unset, :writable},
	{:col_tel_publicos, _unset, :writable},
	{:col_lotes,        _unset, :writable},
	{:col_lin_sat,      _unset, :writable},
	{:dto_nse_pred,     _unset, :writable},
	{:colonia_cd,       _unset, :writable},
	{:o_format_float,   _unset, :writable}
})
