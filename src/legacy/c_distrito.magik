_pragma(classify_level=restricted, usage={redefinable})
_method c_distrito.agrupa_fibras_muertas_y_reservas(p_datos)
	## Metodo para agrupar en un solo renglon las fibras muertas y
	## en reserva de los cables.
	##
	_local LoDatos << rope.new()
	_local LoGis << gis_program_manager.cached_dataset(:gis)
	_local LoTabCable << LoGis.collection(:sheath)
	_for idCable,valores _over p_datos.fast_keys_and_elements()
	_loop
		fibrasMuertas << sorted_set.new()
		fibrasReservas << sorted_set.new()
		id << idCable.write_string.safe_as_integer()
		cable << LoTabCable.at(id)
		_for llave, fibras _over valores.fast_keys_and_elements()
		_loop
			_for fibra _over fibras.fast_elements()
			_loop
				_if llave _is :muertas
				_then
					fibnum << fibra.fiber_number.as_integer()
					fibrasMuertas.add(fibnum)
#					fibrasMuertas.add(fibra.fiber_number)				
				_elif llave _is :reservas
				_then 
					fibnum << fibra.fiber_number.as_integer()
					fibrasReservas.add(fibnum)
#					fibrasReservas.add(fibra.fiber_number)
				_endif
			_endloop
		_endloop

		LoStrCabSec << _self.arma_cadena_cable(cable)
#		LoStrFoSec << fibrasMuertas.join_as_strings(",")
		
		#Muertas		
		# edwaldo se agrega codigo para dar formato a etiquetas de las fibras
		LoStrFoSecRope << rope.new_from(fibrasMuertas)		
		LoStrFoSecMuertas << c_cuentas_fo_engine.parser_cuentas("",LoStrFoSecRope)
		_if LoStrFoSecMuertas.write_string <> ""
		_then				
			plDatos << property_list.new_with(:no_cable,"",:fo_prin,"",:divisor,"",
						  :cable_sec, LoStrCabSec.write_string,
						  :fo_sec,    LoStrFoSecMuertas.write_string,
						  :terminal,"MUERTAS",:puertos,"")
			LoDatos.add(plDatos)
		_endif 	

		#Reservas
#		LoStrFoSec << fibrasReservas.join_as_strings(",")
		LoStrFoSecRope << rope.new_from(fibrasReservas)
		LoStrFoSecReserva << c_cuentas_fo_engine.parser_cuentas("",LoStrFoSecRope)
               _if LoStrFoSecReserva <> ""
	       _then		
		       plDatos << property_list.new_with(:no_cable,"",:fo_prin,"",:divisor,"",
						  :cable_sec, LoStrCabSec.write_string,
						  :fo_sec,    LoStrFoSecReserva.write_string,
						  :terminal,"RESERVAS",:puertos,"")
		       LoDatos.add(plDatos)
	       _endif 
	_endloop
	
	_return LoDatos
	
_endmethod
$
_pragma(classify_level=restricted, usage={redefinable})
_method c_distrito.arma_cadena_cable(p_cable)
	## Metodo para armar la cadena que se requiere en el sello de
	## correspondencia del diagrama de empalmes, se recibe como
	## parametro el p_cable y se retorn una cadena con el spec_id,
	## el año del proyecto, y la cuenta.
	##
	LoText << ""  
	LoYear << c_proyecto.proyecto_activo.user!_programa_anyo
	LoYear << c_proyecto.proyecto_activo.user!_programa_anyo.slice_to_end(LoYear.size-1)
	
	# (12/03/29 rhernan) : se cambia por la nueva nomenclatura
	# solicitada en la version 11.7.3


	#LoSpec << p_cable.spec_id. 

	
	LoSpec << p_cable.spec_info.fiber_quantity.write_string + "FO" +  "("+p_cable.spec_info.user!_clase+")"   


	#19/Mayo/2011 se agrega el numero del cable.	
	LoNum << p_cable.user!_numero_cable.default("").write_string 	
	(Lformat,Lstring)<<c_cuentas_fo_engine.GeneraCuenta(p_cable,_true)
	
	# (11/11/24 rhernan) : se obtienen las fibras muertas de los
	# cables secundarios. 
	Num_fibras_muertas << p_cable.obtener_fibras_muertas
	
	# (11/11/24 rhernan) : se agregan las fibras muertas.
	#LoText +<< LoSpec + %newline + LoNum + " (" + LoYear.write_string + ") " #+ Lstring
	_if Num_fibras_muertas _isnt _unset _andif 
	    Num_fibras_muertas > 0 
	_then
	  # (12/04/02 rhernan) : 
	  #LoText +<< LoSpec + %newline + LoNum + " (" + LoYear.write_string + ") "  + 
	  #	      " ("+ Num_fibras_muertas.write_string +")"
		LoText +<< LoSpec + %newline + " (" + LoYear.write_string + ") "  + 
			   " ("+ Num_fibras_muertas.write_string +")"
	_else	
		#LoText +<< LoSpec + %newline + LoNum + " (" + LoYear.write_string + ") "
		LoText +<< LoSpec + %newline +  " (" + LoYear.write_string + ") " 
	_endif
	
	#write("@@@LoText ---> ", LoText )

	
	_return LoText 
	
_endmethod
$
_pragma(classify_level=restricted, usage={redefinable})
_method c_distrito.asigna_distrito(p_distrito, _optional pb_lotes?)

	## Objetivo:
	##     - Asigna a .objeto << p_distrito
	##     - Asigna a .inventario << inventario por NSE en el distrito
	##     - Asigna a .dto_nse_pred << NSE predominante
	##     - Asigna a .col_lotes << los lotes que se encuentran
	##     dentro del límite del distrito
   	## Parámetros de entrada:
	##     p_distrito - objeto user!_distrito
	##     pb_lotes?  - false = NO obtiene el resumen de lotificacion en el distrito
	##                - true = obtiene el resumen de lotificacion en el distrito
   	## Parámetros de salida:
	## (vbluna-27-oct-06)

	.objeto << p_distrito

	_if pb_lotes? = _false
	_then
		_return
	_endif
	
	(.inventario, .col_lotes, .dto_nse_pred) <<	.objeto.get_resumen_lotificacion()

	_for nse, inventario _over .inventario.fast_keys_and_elements()
	_loop
		pl_inventario << property_list.new()
		pl_tel_publicos << property_list.new()

		lin_competencia << inventario[4][1][2] + inventario[4][2][2] + inventario[4][3][2]
		
		pl_inventario[:viviendas] << inventario[1]
		pl_inventario[:abonados] << inventario[2]                           ##lineas telmex?
		pl_inventario[:lineas_multiplicador] << inventario[3][6][2]
		pl_inventario[:lineas_competencia] << lin_competencia               ###telefono
		pl_inventario[:lineas_inalambricas]<< inventario[3][3][2]          ###telefono
		pl_inventario[:solicitudes]<< inventario[3][1][2]                  ###telefono
		pl_inventario[:viv_sin_servicio]<< inventario[5]

		pl_tel_publicos[:ltc] << inventario[3][4][2]
		pl_tel_publicos[:pslt]<< inventario[3][5][2]                       ###telefono
		pl_tel_publicos[:publicos_comp]<< inventario[4][3][2]              ###telefono
		
		.col_viv_lin[nse] << pl_inventario
		.col_tel_publicos[nse] << pl_tel_publicos
	_endloop

_endmethod
$
_pragma(classify_level=restricted, usage={redefinable})
_method c_distrito.busca_edificio
	## fhramire, 7/septiembre/2012
	## Para el limite de distrito, buscamos la existencia de un
	## edificio, si lo encontramos, entoces regresamos el edificio.

	LoDis << _self.objeto.user!_limite
	LoGpm     << gis_program_manager
	tab_edi   << LoGpm.cached_dataset(:gis).collection(:user!_building)
	Edificios << tab_edi.select(predicate.interacts(:location,LoDis))

	# Para el caso de que el plano de construccion tenga mas edificios
	# debemos regresar todos.
	_if Edificios.size > 0
	_then
            _return Edificios.an_element()
	_else
	    _return _unset 
	_endif
	
_endmethod
$
_pragma(classify_level=restricted, usage={redefinable})
_method c_distrito.cables_conectados()
## Filtra los datos que obtiene el método
## generate_downstream_cable_tree para obtener solo los cables
##  - Cuando se trata de los cables de un puente bidireccional
##    solo se considera uno de los dos cables
## (vbluna-12-oct-2006)

	_local eqs_cables << equality_set.new()
	_local eqs_cables_puente << equality_set.new()
	
	_for caja _over _self.cajas_distribucion.fast_elements()
	_loop
		# Para cada caja de distribución asociada al distrito se
		# obtienen los elementos y las estructuras que estan
		# downstream, sin embargo solo nos interesa la primera
		# coleccion que es la que contiene un rope con uno o varios
		# trees de elementos conectados que no son estructuras
		(rope_arbol_elem, estructuras) << caja.generate_downstream_cable_tree()

		# Se recorre el rope para obtener los trees de elementos
		_for arbol_elem _over rope_arbol_elem.fast_elements()
		_loop
			#Se recorre cada tree para obtener los cables
			_for elem, tree _over arbol_elem.fast_keys_and_trees()
			_loop @elementos_del_arbol
				_if elem.is_kind_of?(copper_cable)
				_then
					#Si el cable se encuentra en la coleccion
					#de cables que no se considerarán, continua
					#con el siguiente elemento del tree
					_if eqs_cables_puente.includes?(elem)
					_then
						_continue @elementos_del_arbol
					_endif

					#Si el cable pertenece a un puente
					_if elem.puente _isnt _unset 
					_then
						#Si el puente es bidireccional
						_if elem.puente.tipo_puente = 2
						_then
							#Agregar el siguiente cable del puente
							#a la colección de cables
							#que no se consideran
							cables_int << elem.puente.cables_internos()
							indx << cables_int.index_of_eq(elem)
							_if indx = 1
							_then
								eqs_cables_puente.add(cables_int[2])
							_else
								eqs_cables_puente.add(cables_int[1])
							_endif
						_endif
					_endif

					#El cable se agrega a la coleccion que regresa el método
					eqs_cables.add(elem)
				_endif
			_endloop
		_endloop
	_endloop

	_return eqs_cables
	
_endmethod
$
_pragma(classify_level=restricted, usage={redefinable})
_method c_distrito.cajas_distribucion
	## Obtener las mit_terminal_enclosures asociadas al distrito
	## sin importar el estado de construccion
	## (vbluna/11-oct-2006)
	
	_local col_cajas << rope.new()
	LoViewport << _self.obten_viewport_principal()
	LoGis << gis_program_manager.cached_dataset(:gis)
	_if LoViewport _isnt _unset _andif
	    LoViewport.elementos_modificados _isnt _unset _andif
	    LoViewport.elementos_modificados[:mit_terminal_enclosure_sim] _isnt _unset
	_then
		objetos << LoViewport.elementos_modificados
		_for datosCaja _over objetos[:mit_terminal_enclosure_sim].fast_elements()
		_loop
			caja << LoGis.collection(:mit_terminal_enclosure).at(datosCaja[2])
			col_cajas.add(caja)
		_endloop
	_else
		## Si el viewport se copio de otro plano o de otra hoja.
		_if _self.objeto _isnt _unset 
		_then	    
			LoArea    << _self.objeto.user!_limite
			LoGpm     << gis_program_manager	
			tab_cajas << LoGpm.cached_dataset(:gis).collection(:mit_terminal_enclosure)	    
			cajas << tab_cajas.select(predicate.interacts(:location,LoArea))
			_if cajas.size > 0
			_then
				_for Lcaj _over cajas.fast_elements()
				_loop		  
					col_cajas.add(Lcaj)
				_endloop
			_endif
		_endif	
	_endif
	
	_return col_cajas
	
_endmethod
$
_pragma(classify_level=restricted, usage={redefinable})
_method c_distrito.cajas_existentes

	## Objetivo:
	##     - Obtener las mit_terminal_enclosures con estado de
	##     construccion = "EXISTENTE" asociadas al distrito
   	## Parámetros de entrada:
   	## Parámetros de salida:
	##     col_cajas_exis - rope con las cajas existentes
	## vbluna
	
	_local col_cajas_exis << rope.new()
	LoViewport << _self.obten_viewport_principal()
	LoGis << gis_program_manager.cached_dataset(:gis)
	
	_if LoViewport _isnt _unset _andif
	    LoViewport.elementos_modificados _isnt _unset _andif 
	    LoViewport.elementos_modificados[:mit_terminal_enclosure_sim] _is  _unset 
	_then
		LoArea    << _self.objeto.user!_limite
		LoGpm     << gis_program_manager	
		tab_cajas << LoGpm.cached_dataset(:gis).collection(:mit_terminal_enclosure)	    
		cajas << tab_cajas.select(predicate.interacts(:location,LoArea))
		_if cajas.size > 0
		_then
			_for Lcaj _over cajas.fast_elements()
			_loop
				_if Lcaj.construction_status = "EXISTENTE"
				_then
					col_cajas_exis.add(Lcaj)
				_endif
			_endloop
		_endif	    
	_else	
		_if LoViewport _isnt _unset _andif
		    LoViewport.elementos_modificados _isnt _unset  _andif 
		LoViewport.elementos_modificados[:mit_terminal_enclosure_sim] _isnt _unset
		_then
			objetos << LoViewport.elementos_modificados
			_try
				_for datosCaja _over objetos[:mit_terminal_enclosure_sim].fast_elements()
				_loop
					caja << LoGis.collection(:mit_terminal_enclosure).at(datosCaja[2])
					_if caja.construction_status = "EXISTENTE"
					_then
						col_cajas_exis.add(caja)
					_endif
				_endloop		   
			_when does_not_understand
			_endtry
			
		_endif
	_endif 
	_return col_cajas_exis
	
_endmethod
$
_pragma(classify_level=restricted, usage={redefinable})
_method c_distrito.cajas_proyectadas

	## Objetivo:
	##     - Obtener las mit_terminal_enclosures con estado de
	##     construccion = "PROYECTADO" asociadas al distrito
   	## Parámetros de entrada:
   	## Parámetros de salida:
	##     col_cajas_proy - rope con las cajas proyectadas
	## vbluna

	_local col_cajas_proys << rope.new()
	LoViewport << _self.obten_viewport_principal()
	LoGis << gis_program_manager.cached_dataset(:gis)
	_if LoViewport _isnt _unset _andif
	    LoViewport.elementos_modificados _isnt _unset _andif 
	    LoViewport.elementos_modificados[:mit_terminal_enclosure_sim] _isnt _unset
	_then
	    objetos << LoViewport.elementos_modificados
	    _try
	       _for datosCaja _over objetos[:mit_terminal_enclosure_sim].fast_elements()
	       _loop
		   caja << LoGis.collection(:mit_terminal_enclosure).at(datosCaja[2])
		  # _if caja.construction_status = "EXISTENTE"
		   _if caja.construction_status = "PROYECTADO"
		   _then
		       col_cajas_proys.add(caja)
		   _endif
	       _endloop
	    _when does_not_understand
	    _endtry
	_else
	    ## Si el viewport se copio de otro plano o de otra hoja.
	    _if _self.objeto _isnt _unset 
	    _then	    
	        LoArea    << _self.objeto.user!_limite
		LoGpm     << gis_program_manager	
		tab_cajas << LoGpm.cached_dataset(:gis).collection(:mit_terminal_enclosure)	    
		cajas << tab_cajas.select(predicate.interacts(:location,LoArea))
		_if cajas.size > 0
		_then
		    _for Lcaj _over cajas.fast_elements()
		    _loop
			    # (13/08/16 bflores) : SE AGREGABAN TODAS LAS CAJAS QUE ENCONTRABA.
			    _if caja.construction_status = "PROYECTADO"
			    _then
				    col_cajas_proys.add(caja)
			    _endif
		    _endloop
		_endif
	    _endif		
	_endif
	_return col_cajas_proys
	
_endmethod
