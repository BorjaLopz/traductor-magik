_pragma(classify_level=restricted, usage={redefinable})
_method c_distrito.obten_cables_secundarios_agrupados(p_distrito_optico_id)
	## Metodo para obtener los cables que salen de todos los cedos
	## asociados a un limite de distrito optico, esto para llenar
	## el sello de la lista de cables a proyectar en el plano de
	## diagrama de empalmes.
	##
	paf << smallworld_product.pni_application()
	plug << paf.plugin(:esquema_tab_plugin)
	LoEsqGui << plug.sys!slot(:esq_gui)			
	LoCedos <<  LoEsqGui.get_esquema().user!_empalme_distribucions	
	
	LoCables << rwo_set.new()
	
	_for cedo _over LoCedos.fast_elements()
	_loop
		LoCables.add_all(cedo.obten_cables_secundarios())
	_endloop  

	_global mis_cablesec
	        mis_cablesec << LoCables
		
	_local grupos << property_list.new()	
	_local sumaTotal << 0.0

	
	_for IterCable _over LoCables.fast_elements()
	_loop
		_local LoCapacidad << IterCable.get_spec_record().fiber_quantity

		# (15/08/06 bautistaja) : Modified. Se asigna default() 
		_local tipo << IterCable.get_spec_record().user!_clase.default("")
		_local LoKey << LoCapacidad.write_string + "$" + tipo

		#SHOW(:LoKey, LoKey, IterCable.user!_long_opt)

		
		_local LiLongGaza << 0.0		
		
		_if LoCapacidad _isnt _unset _andif 
		    tipo _isnt _unset _andif
		    grupos[LoKey.write_string.as_symbol()] _is _unset 
		_then
			grupos[LoKey.write_string.as_symbol()] << property_list.new_with(:capacidad,"",
											 :tipo,"",
											 :longitud,0,
											 :cables,rope.new())
		_endif
		
		_if grupos[LoKey.write_string.as_symbol()] _isnt _unset _andif
		    grupos[LoKey.write_string.as_symbol()][:cables].includes?(IterCable).not
		_then
			
			grupos[LoKey.write_string.as_symbol()][:capacidad] << LoCapacidad.write_string +
									      " F.O"
			grupos[LoKey.write_string.as_symbol()][:tipo] << tipo.write_string
			
			# (12/08/10 hramosr) : se toma el km_real_medido por la
			# long. calc. user carlos linares.
			#si hay gazas se acumula en la distancia del cable f.o. 			
			
			grupos[LoKey.write_string.as_symbol()][:longitud] +<< IterCable.user!_long_opt.value_in(:m)
			
			grupos[LoKey.write_string.as_symbol()][:cables].add(IterCable)
		_endif
		
	_endloop


	_return grupos
	
_endmethod
$
_pragma(classify_level=restricted, usage={redefinable})
_method c_distrito.obten_datos_correspondencia(p_cedo_id)
	##  (11/05/17 fmejia) : Metodo que retorna un rope de
	## proerty_list con la estructura para el sello de
	## correspondencias en el diagrama de empalmes. Retorna una
	## lista de property_list's con los 7 valores de las columnas
	## requeridas en base a las terminales que atiende el cedo con
	## el id p_cedo_id
	##

   _local LoTerminales << _self.obten_terminales_fo(p_cedo_id)	
   _local LoDatos             << rope.new()
   
   _local LoCedo_actual       << _unset 
   _local LoDivisores_en_Cedo << _unset

    LoConectividad      << c_servicios_conectividad.singleton()
    
     LoCedo_actual       << mit_manager.modelit_dataset.collection(:user!_empalme_distribucion).at(p_cedo_id)
     LoDivisores_en_Cedo << LoCedo_actual.obtener_divisores()
	


     #_global terminales      
     #terminales << LoTerminales     
     
     _for terminal _over LoTerminales.fast_elements()
     _loop
	     
	     # SE OBTIENEN LOS DIVISORES POR CADA TERMINAL.
	     LoDivisores << terminal.obtener_divisores()		
	     _for divisor _over LoDivisores.fast_elements()
	     _loop 
		     #write("DIVISOR--->>>  ", divisor)
		     #write("@NOMBREeee ====> ", divisor.name)		     		     
		     #puerto de entrada en el divisor de la terminal
		     LoPuertoIN << divisor.input_ports()[1]
		     
		     #pin que atiende al divisor de la terminal
		     #write("@@@LoConectividad --->> ",LoConectividad)
		     
		     LoPinSec << LoConectividad.obten_objeto_extremo(LoPuertoIN)
		     
		     
			_if LoPinSec _isnt _unset 
			_then
				#write("@@LoPinSec --->> ", LoPinSec)				
				#puertos de salida del divisor de la terminal ordenados por el numero
				LoPuertosOUT << sorted_set.new()
				LoPuertosOUT.add_all(divisor.output_ports())
				LoPuertosOUT << LoPuertosOUT.as_sorted_collection()
				#Dato de :puertos p.e 1-8.
				LoStrPuertos << LoPuertosOUT.first.user!_numero +
						"-" + LoPuertosOUT.last.user!_numero 
   
				#Nombre de la terminal para el dato :terminal
				LoStrTerminal << terminal.user!_nombre

				#cable y atributo del pin que atiende al divisor de terminal
				#write("@@@VALOR DE PINSEC ====>>> ", LoPinSec)
				
				# (11/11/24 rhernan) :
		## AQUI SE OBTIENE EL CABLE SEC Y LA FIBRA LA FIBRA QUE VIVE EN EL CEDO DE LA TERMINAL
				## REQUERIREMOS BUSCAR EL MIT_FIBER_PIN DEL CABLE SEC,  QUE VIVE EN
				## EL CEDO.
				
			        (LoCabSec,LoAtrSec)<<LoPinSec.get_cab_and_fiber_attribute

				#write("@@@@@---->>>>OBTENIENDO CABLECIIIIIIN ", LoCabSec) 
				#lista_pin_secs.add(LoPinSec)						
				
				LoStrFoSec << ""
				LoStrCabSec << ""				
				
			    _if LoAtrSec _isnt _unset 
			    _then 
				#LoStrFoSec << LoAtrSec.fiber_number
				#edwaldo se agrega codigo para dar formato a etiquetas de las fibras.
				# (11/11/24 rhernan) :
				#LoStrFoSecRope << rope.new_from(LoPinSec.fiber_number)

				#LoStrFoSec << c_cuentas_fo_engine.parser_cuentas("",LoStrFoSecRope)
				#comentarrr  
				#LoStrCabSec << _self.arma_cadena_cable(LoCabSec) 		
				#Divisor en el CEDO
				LoDivisorCedo << LoAtrSec.optical_splitter
			    _endif			    
 
			     #19/Mayo/2011 se agrega la validacion de la variable LoDivisorCedo
			     LoStrDivisor << ""
			     LoStrFoPrin << ""
			     LoStrNumCab << "" 
				
			     _if LoDivisorCedo _isnt _unset
			     _then
				 #Puerto de entrada del Divisor del CEDO
				  LoPuertoINPrin << LoDivisorCedo.input_ports()[1]			  
				  # (11/11/25 rhernan) :
				  #OBTENEMOS LOS OUTPUT_PORTS DEL CEDO EN TURNO
				  LoPuertosOUTSecs   << LoDivisorCedo.output_ports()
				  
				  #Recorremos el puerto que tiene la misma cuenta de la terminal.
				  _for puerto _over LoPuertosOUTSecs.fast_elements()
				  _loop 
				      pin_salida << LoConectividad.obten_objeto_extremo(puerto)     

				      _if LoStrTerminal.split_by(%-).size > 1
				      _then
					  cadena_comparar    << LoStrTerminal.split_by(%-)[2]
				      _elif LoStrTerminal.split_by(%-).size = 1
				      _then 
					    cadena_comparar << LoStrTerminal.split_by(%O)[2]
				      _endif
				      
				      _if pin_salida _isnt _unset _andif 
					  pin_salida.obtener_cuenta() = cadena_comparar
				      _then 
					#LoNumeroFibra << pin_salida.fiber_number
					#LoStrFoSecRope << rope.new_from(pin_salida.fiber_number)
				        #LoStrFoSec<<c_cuentas_fo_engine.parser_cuentas("",LoStrFoSecRope)
					 
					LoStrFoSec << pin_salida.fiber_number
					 _if pin_salida.sheath_pin.sheath _isnt _unset 
					 _then
					  LoStrCabSec<<_self.arma_cadena_cable(pin_salida.sheath_pin.sheath)
					 _endif
					  #_leave					 
				      _endif
				  _endloop
				  
				  #Pin que atiende al puerto de entrada del divisor en CEDO
				  LoPinPrin << LoConectividad.obten_objeto_extremo(LoPuertoINPrin)
				       
				  LoStrDivisor<<_self.divisor_equivalencia[LoDivisorCedo.
									   name.as_symbol()]
				  
				  #Cable y atributo del pin que atiende al divisor del CEDO.
				   _if LoPinPrin _isnt _unset 
				   _then				
				     (LoCabPrin,LoAtrPrin)<<LoPinPrin.get_cab_and_fiber_attribute   
				     fiber_AT << LoAtrPrin
				     
				     _if LoAtrPrin _isnt _unset 
				     _then
					  # (11/11/24 rhernan) :
					  # se cambia la cuenta por el numero de fibra.
					  # LoStrFoPrin << LoAtrPrin.fiber_number
					  LoStrFoPrin << LoAtrPrin.user!_cuenta
				     _endif
				     
				     LoStrNumCab << LoCabPrin.user!_numero_cable			     
				     LoListaCablesFo << LoConectividad.cables_arriba(divisor.gis_owner,
									:strw_connect_point,
									LoPinPrin.sheath_pin.sheath)	     
			                 # (11/11/23 rhernan) : 
					 # Obtener el cable que sale de la central. 
			                 _if LoListaCablesFo.size > 0
					 _then 
						LoStrNumCab << LoListaCablesFo[1].user!_numero_cable
					 _endif						
				   _endif
			       _endif
			_endif		
			
			#Creamos el property_list con los valores para cada columna del sello.
			plDatos << property_list.new_with(:no_cable, LoStrNumCab.write_string.default(""),
						     :fo_prin,  LoStrFoPrin.write_string.default(""),
						     :divisor,  LoStrDivisor.write_string.default(""),
						     :cable_sec,LoStrCabSec.write_string.default(""),
						     :fo_sec,   LoStrFoSec.write_string.default(""), 
						     :terminal, LoStrTerminal.write_string.default(""),
						     :puertos,  LoStrPuertos.write_string.default(""))
			
			#Agregamos el property_list a un rope, esto equivale a los
			# renglones del sello.
			LoDatos.add(plDatos)			
		_endloop
	_endloop     
     
	LoInfoFibras<<_self.obten_fibras_muertas_y_reservas(p_cedo_id)
	LoDatos.add_all_last(_self.agrupa_fibras_muertas_y_reservas(LoInfoFibras)) 
	
	_return LoDatos 
	
_endmethod
$
_pragma(classify_level=restricted, usage={redefinable})
_method c_distrito.obten_datos_correspondenciaII(p_cedo_id)

  _local LoTerminales << _self.obten_terminales_fo(p_cedo_id)   
   _local ArreNombreTerminales << rope.new()   
          LoDatos              << rope.new() 
   _local LoCedo_actual        << _unset 
   _local LoDivisores_en_Cedo  << _unset
   _local LoLista_hash_terminales << hash_table.new()
   _local terminal_doble? << _unset
   _local LoContador << 0
   _local mis_puertos_terminal_doble << "" 

  # write("@######################################## OBTEN DATOS CORRESPONDENCIAAAAaaa ")   

  _if LoTerminales.size > 0
  _then 
    _for LoTerminal2 _over LoTerminales.fast_elements()
    _loop
	 #  write("LoTerminal2 --> ",LoTerminal2)  
	 LoLista_hash_terminales[LoTerminal2.user!_nombre.slice_to_end(3).as_symbol()] << LoTerminal2 
    _endloop    
   
    LoConectividad      << c_servicios_conectividad.singleton()    
    LoCedo_actual       << mit_manager.modelit_dataset.collection(:user!_empalme_distribucion).at(p_cedo_id)  
    
    LoCables_Secundarios << LoCedo_actual.cables_secundarios()    
    #19/Mayo/2011 se agrega la validacion de la variable LoDivisorCedo
    LoStrDivisor << ""
    LoStrFoPrin << ""
    LoStrNumCab << ""

    LoCables_Secundarios << _self.ordena_cables_secundariosXcuenta(LoCables_Secundarios)
    
    _for LoCableSecundario _over LoCables_Secundarios.fast_elements()
    _loop
	_for LoPinSec _over LoCableSecundario.obtener_pines().fast_elements()
	_loop
          LoCuentaSec << LoPinSec.obtener_cuenta()
	  
	 (terminal_doble?, LoTerminalDoble)<<_self.es_terminal_doble?(LoLista_hash_terminales,LoCuentaSec) 
	    
	  _if LoCuentaSec.write_string.size > 0 _andif
	      (LoLista_hash_terminales.includes_key?(LoCuentaSec.as_symbol()) _orif
	      terminal_doble? = _true )     #_self.es_terminal_doble?(LoLista_hash_terminales,LoCuentaSec))
	  _then	
		LoStrFoSec << ""  
		LoStrCabSec << ""				
		LoStrDivisor << ""
		LoStrFoPrin  << "" 
		LoStrNumCab  << "" 
		
		# (12/04/03 rhernan) :	buscamos la fibra secundaria.	
		LoStrFoSec << LoPinSec.fiber_number
		_if LoPinSec _isnt _unset 
		_then
			(LoCable, LoAtrSec) << LoPinSec.get_cab_and_fiber_attribute	
		_endif
		
		 
		_if LoAtrSec _isnt _unset 
		_then
			    
		  #Obtenemos el Divisor optico de esta fibra.
		  LoDivisorCedo << LoAtrSec.optical_splitter
		  #Obtenemos el pin principal para obtener el cable principal. 
		_if LoDivisorCedo _isnt _unset _andif
		    LoDivisorCedo.input_ports()[1] _isnt _unset 
		_then
		     LoStrDivisor<<_self.divisor_equivalencia[LoDivisorCedo.
							      name.as_symbol()]
		     
   		    LoPinPrin << LoConectividad.obten_objeto_extremo(LoDivisorCedo.input_ports()[1])
		    _if LoPinPrin _isnt _unset 
		    _then
			    (LoCabPrin,LoAtrPrin) << LoPinPrin.get_cab_and_fiber_attribute
		    _endif		    
		    
		    _if LoAtrPrin _isnt _unset 
		    _then
			# (11/11/24 rhernan) :
			# se cambia la cuenta por el numero de fibra.
			# LoStrFoPrin << LoAtrPrin.fiber_number
			LoStrFoPrin << LoAtrPrin.user!_cuenta
			LoStrNumCab << LoCabPrin.user!_numero_cable
			#write("MI PRINCIPAL   ", LoPinPrin)
			#write("MI SHEATH PIN ",LoPinPrin.sheath_pin) 
			LoListaCablesFo << LoConectividad.cables_arriba(LoDivisorCedo.gis_owner,
								     :strw_connect_point,
								     LoPinPrin.sheath_pin.sheath)
			# (11/11/23 rhernan) : 
		    # Obtener el cable que sale de la central. 
		     _if LoListaCablesFo.size > 0
		     _then 
			     LoStrNumCab << LoListaCablesFo[1].user!_numero_cable
		     _endif		     
		    _endif   # (12/10/16 cerramos if para no abarcar la nomenclatura de la terminales fo) :
		    
		     #Obtenemos el rango de los puertos de salida.		     
		     LoPuertosOUT << sorted_set.new()
		    
		     LoDivisorTerminal << LoLista_hash_terminales.lookup_key(LoCuentaSec.as_symbol())
		     
		     # probable es una terminal "dobble" 
                     _if LoDivisorTerminal _is _unset _andif LoTerminalDoble _isnt _unset 
		     _then
		       LoDivisorTerminal << LoTerminalDoble.obtener_divisor_correspondiente(LoCuentaSec)
		       LoStrTerminal     << LoTerminalDoble.user!_nombre.slice_to_end(3)

		     _elif LoDivisorTerminal _isnt _unset _andif
			   LoDivisorTerminal.obtener_divisores().size > 0		     
		     _then			 
			 LoStrTerminal << LoCuentaSec.write_string			 
		         LoDivisorTerminal << LoDivisorTerminal.obtener_divisores()[1]
		     _endif
		     #write("############# DIVISOR TERMINAL ########## ")		     
		     #write("LoDivisorTerminal ---> ",LoDivisorTerminal.p)
		     
		     #OBTENEMOS LOS PUERTOSS .. por cada Terminal FO.		     
		      LoPuertosOUT.add_all(LoDivisorTerminal.output_ports())
		      LoPuertosOUT << LoPuertosOUT.as_sorted_collection()
		      LoStrPuertos << LoPuertosOUT.first.user!_numero +
				       "-" + LoPuertosOUT.last.user!_numero
		_endif		
		_endif
	        
		#write("@VALOR DE LoSTRPuertossss   ", LoStrPuertos)
		
	      _if LoPinSec.sheath_pin.sheath _isnt _unset 
	      _then
		   LoStrCabSec << _self.arma_cadena_cable(LoPinSec.sheath_pin.sheath) 
	      _endif
	      
	       # (13/05/07 rhernan) : para no agregar renglones dobles con la
	       # misma informacion..
	       _if terminal_doble? = _true 
	       _then
	          # write("@@LoStrPuertos --->>> ",LoStrPuertos.write_string)
		   LoContador +<< 1		   
		   #cachar el string de los puertos para armar los rangos.
		   _if mis_puertos_terminal_doble  = "" 
		   _then
		       mis_puertos_terminal_doble +<<  LoStrPuertos.write_string.default("")+ " "
		   _else
			   mis_puertos_terminal_doble +<< " " + LoStrPuertos.write_string.default("")+ " "
		   _endif		   
		   #write("@mis_puertos_terminal_doble -> ",mis_puertos_terminal_doble)
		   
		   numeros_strings << mis_puertos_terminal_doble.numbers_and_strings		   
		   pivote_mayor << numeros_strings.an_element()
		   pivote_menor << numeros_strings.an_element()
		   
		   _for i _over numeros_strings.fast_elements()
		   _loop			   
		      _if i.as_number() _isnt _unset 
		      _then
		         _if i >= pivote_mayor
			 _then
			     pivote_mayor << i
			 _elif i <= pivote_menor
			 _then 
			     pivote_menor << i 
			 _endif 
		      _endif 		
		   _endloop

				   
		   #write("mis_puertos_terminal_doble ---> ",mis_puertos_terminal_doble)		   
		   mis_puertos_terminal_doble << pivote_menor.write_string+"-"+ pivote_mayor.write_string
		   #write("CADENAAA ", mis_puertos_terminal_doble )		   
		   LoStrPuertos << mis_puertos_terminal_doble		   
	       _else
		       mis_puertos_terminal_doble << ""  
	       _endif
	       
	       plDatos << property_list.new_with(:no_cable, LoStrNumCab.write_string.default(""),
						:fo_prin,   LoStrFoPrin.write_string.default(""),
						:divisor,   LoStrDivisor.write_string.default(""),
						:cable_sec, LoStrCabSec.write_string.default(""),
						:fo_sec,    LoStrFoSec.write_string.default(""), 
						:terminal,  "FO" + LoStrTerminal.write_string.default(""),
						:puertos,   LoStrPuertos.write_string.default(""))
       
	       _if terminal_doble? = _true _andif
		     LoContador > 1
	       _then
		     LoDatos.add(plDatos)
		     LoContador << 0
		     mis_puertos_terminal_doble << ""
	       _elif terminal_doble? = _false _orif
		     terminal_doble? _is _unset 
	       _then 
		     LoDatos.add(plDatos)
		     LoContador << 0
		     #mis_puertos_terminal_doble << ""
	       _endif 	       
	  _endif 	   
	_endloop  
	
	LoInfoFibras<< _self.obten_fibras_muertas_y_reservas_por_cable_secundario(LoCableSecundario) 
	LoDatos.add_all_last(_self.agrupa_fibras_muertas_y_reservas(LoInfoFibras)) 
    _endloop   
  _endif  
	  
  _return LoDatos  
   
_endmethod
$
_pragma(classify_level=restricted, usage={redefinable})
_method c_distrito.obten_fibras_muertas_y_reservas(p_id_cedo)
	## Metodo para devolver grupos de fibras agrupadas por estado
	## (MUERTAS, RESERVA ) de los cables que salen del CEDO. Para
	## encontrar el CEDO lo hacemos por el p_id_cedo.
	##
	_local LoTabCedo << gis_program_manager.cached_dataset(:gis).collection(:user!_empalme_distribucion)
	_local LoCedo << LoTabCedo.at(p_id_cedo)
	_local LoCables << LoCedo.cables_secundarios()
	_local LoInfoCables << property_list.new()
	
	_for cable _over LoCables.fast_elements()
	_loop
		LoLlave << cable.id.write_string.as_symbol()
		LoInfoCables[LoLlave] << property_list.new_with(:muertas,rope.new(),
								:reservas,rope.new())
		_for atributo _over cable.fiber_attributes.fast_elements()
		_loop
			_if atributo.user!_estado = "M"
			_then
				LoInfoCables[LoLlave][:muertas].add(atributo)
			_elif atributo.user!_estado = "R"
			_then
				LoInfoCables[LoLlave][:reservas].add(atributo)
			_endif
		_endloop

		_if LoInfoCables[LoLlave][:muertas].size = 0 _andif
		    LoInfoCables[LoLlave][:reservas].size = 0
		_then
			LoInfoCables.remove_key(LoLlave)
		_endif
	_endloop
	
	_return LoInfoCables
_endmethod
$
_pragma(classify_level=restricted, usage={redefinable})
_method c_distrito.obten_fibras_muertas_y_reservas_por_cable_secundario(PoCableSecundario)
	## Metodo para devolver grupos de fibras agrupadas por estado
	## (MUERTAS, RESERVA ) por un cable secundario.
	## # (12/04/04 rhernan) : 
	  
	_local LoInfoCables << property_list.new()
	
	LoLlave << PoCableSecundario.id.write_string.as_symbol()
	LoInfoCables[LoLlave] << property_list.new_with(:muertas,rope.new(),
								:reservas,rope.new())		
	_for atributo _over PoCableSecundario.fiber_attributes.fast_elements()
	_loop
		_if atributo.user!_estado = "R"
		_then
			LoInfoCables[LoLlave][:reservas].add(atributo)
		_elif atributo.user!_estado = "M"
		_then
			LoInfoCables[LoLlave][:muertas].add(atributo)
		_endif
	_endloop
	
	_if LoInfoCables[LoLlave][:reservas].size = 0 _andif
	    LoInfoCables[LoLlave][:muertas].size = 0
	_then
		LoInfoCables.remove_key(LoLlave)
	_endif
	
	_return LoInfoCables
_endmethod
$
_pragma(classify_level=restricted, usage={redefinable})
_method c_distrito.obten_reservas()
	## 
	## 
	LoViewport << _self.obten_viewport_principal()
	LoReservas << rope.new()
	LoTabReservas << gis_program_manager.cached_dataset(:gis).collection(:user!_reserva)
	_if LoViewport _isnt _unset 
	_then
	    _if LoViewport.elementos_modificados _is _unset 
	    _then
		LoArea     << _self.objeto.user!_limite		
		Reservas << LoTabReservas.select(predicate.interacts(:location,LoArea))
		_if Reservas.size > 0
		_then
		    _for Lcaj _over Reservas.fast_elements()
		    _loop
			LoReservas.add(Lcaj)				
		    _endloop
		_endif  
	    _else 	
		LoDatosReservas << LoViewport.elementos_modificados[:user!_reserva_sim]
		_if LoDatosReservas _isnt _unset 
		_then
		    _for datos _over LoDatosReservas.fast_elements()
		    _loop
			LoReservas.add(LoTabReservas.at(datos[2]))
		    _endloop
		_endif
	    _endif 
	_endif
	LoReservas << _self.valida_conectividad_a_caja(LoReservas)
	
	_return LoReservas
_endmethod
$
_pragma(classify_level=restricted, usage={redefinable})
_method c_distrito.obten_terminales()
	## 
	## 
	LoViewport << _self.obten_viewport_principal()
	LoTerminales << rope.new()
	LoTabTerminales << gis_program_manager.cached_dataset(:gis).collection(:copper_terminal)
	_if LoViewport _isnt _unset 
	_then
	    _if LoViewport.elementos_modificados _is _unset 
	    _then
		LoArea     << _self.objeto.user!_limite		
		Terminales << LoTabTerminales.select(predicate.interacts(:location,LoArea))
		_if Terminales.size > 0
		_then
		    _for Lcaj _over Terminales.fast_elements()
		    _loop
			LoTerminales.add(Lcaj)				
		    _endloop
		_endif  
	    _else 
		LoDatosTerminales << LoViewport.elementos_modificados[:copper_terminal_sim]
		_if LoDatosTerminales _isnt _unset 
		_then
			_for datos _over LoDatosTerminales.fast_elements()
			_loop
				LoTerminales.add(LoTabTerminales.at(datos[2]))
			_endloop
		_endif
	    _endif 
	_endif
	LoTerminales << _self.valida_conectividad_a_caja(LoTerminales)
	_return LoTerminales	
_endmethod
$
_pragma(classify_level=restricted, usage={redefinable})
_method c_distrito.obten_terminales_fo(p_id_cedo)
	## (11/05/17 fmejia) : Metodo para obtener todas las temrinales que atiende un CEDO
	## en base al id del cedo (p_id_cedo), retornando un sorted_set
	## ordenado por el nombre de la terminal.
	##
	_local LoTerminales << sorted_set.new()
	_local LoTabCedo << gis_program_manager.cached_dataset(:gis).collection(:user!_empalme_distribucion)
	_local LoCedo << LoTabCedo.at(p_id_cedo)

	_if LoCedo _isnt _unset 
	_then
		LoTerminales.add_all(LoCedo.obten_terminales_atendidas())
	_endif
	LoTerminales.sort_by(:user!_nombre)
	
	_return LoTerminales
_endmethod
$
_pragma(classify_level=restricted, usage={redefinable})
_method c_distrito.obten_terminales_fibra

	       term << _unset 
	
		_if _self.objeto _isnt _unset 
		_then	    
			LoArea    << _self.objeto.user!_limite
			LoGpm     << gis_program_manager	
			tab       << LoGpm.cached_dataset(:gis).collection(:user!_terminal_fo)	    
			term      << tab.select(predicate.interacts(:location,LoArea))                        
		_endif
		
		_return term 
_endmethod
$


_pragma(classify_level=restricted, usage={redefinable})
_method c_distrito.obten_viewport_principal()
	## 
	## 
	LoPaf << smallworld_product.pni_application()
	LoLayPlug << LoPaf.plugin(:layout_plugin)
	LoAppl << LoLayPlug.dialogs[:layout_designer]
	
	#---------------------------------------------------------
	LoPlugMan << LoAppl.plugin(:layout_manager)
	LoDoc << LoPlugMan.current_document
	LoViewport << _unset
	_for el _over LoDoc.current_page.elements.fast_elements()
	_loop
		_if (el.responds_to?(:class_name) _andif
		    el.class_name _is :c_viewport_layout_sigc _andif
		    el.stipoplano = "CONSTRUCCION") _or
		    (el.responds_to?(:class_name) _andif
		    el.class_name _is :c_viewport_layout_sigc _andif
		    el.stipoplano = "CONSTRUCCION_FO")
		_then
			LoViewport << el
			_leave
		_endif
	_endloop

	_return LoViewport
	
_endmethod
$
_pragma(classify_level=restricted, usage={redefinable})
_method c_distrito.ocupacion

	## Objetivo:
	##    - Obtener la ocupacion de lineas en el distrito =
	##      - Inicial = Total lineas Telmex / Pares conectados actual *100
	##      - Final   = Total lineas Telmex / Total de pares actual
	## * 100 + Total de pares de aumento
	##      - Saturacion = Total lineas Distrito / Total de pares * 100
   	## Parámetros de entrada:
   	## Parámetros de salida:
	##    l_col_ocupacion - hash_table con:
	##       [:|Inicial|] << string con el porcentaje de la ocupacion inicial
	##       [:|Final|]   << string con el porcentaje de la ocupacion final
	##       [:|Saturacion|] << string con el porcentaje de la
	##                          ocupacion a saturacion	
	## vbluna

	_local l_col_ocupacion << hash_table.new()
	_local ln_pares_con_act << _self.resumen_pares[:|Con|,:|Act|]
        _local ln_pares_tot_tot << _self.resumen_pares[:|Tot|,:|Tot|]

	l_col_ocupacion.default_value << 0

	_if (ln_pares_con_act) > 0
	_then
		ln_ocup_ini << (_self.total_lineas_telmex/ln_pares_con_act).as_float *100
	_endif
	_if (ln_pares_tot_tot) > 0
	_then
		ln_ocup_fin << (_self.total_lineas_telmex/ln_pares_tot_tot).as_float *100
		ln_ocup_sat << (_self.total_lineas_distrito/ln_pares_tot_tot).as_float *100
	_endif

	l_col_ocupacion[:|Inicial|]    << .o_format_float.format(ln_ocup_ini.default(0))+" % "
	l_col_ocupacion[:|Final|]      << .o_format_float.format(ln_ocup_fin.default(0))+" % "
	l_col_ocupacion[:|Saturacion|] << .o_format_float.format(ln_ocup_sat.default(0))+" % "

	_return l_col_ocupacion
	
_endmethod
$
