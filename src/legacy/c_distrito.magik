_pragma(classify_level=restricted, usage={redefinable})
_method c_distrito.factor_pen_nse

   	## Parámetros de entrada:
   	## Parámetros de salida:
	##     col_factor_pen - hash_table con:
	##                      [:NSE] << user!_factor_pen
	## vbluna

	_local col_factor_pen << hash_table.new()
	col_factor_pen.default_value << 0.0

	_try
		col_factor_pen[:|A|]  << .objeto.user!_factor_pen.user!_nse_a
		col_factor_pen[:|B|]  << .objeto.user!_factor_pen.user!_nse_b
		col_factor_pen[:|C|]  << .objeto.user!_factor_pen.user!_nse_c
		col_factor_pen[:|D|]  << .objeto.user!_factor_pen.user!_nse_d
		col_factor_pen[:|E|]  << .objeto.user!_factor_pen.user!_nse_e
		col_factor_pen[:|C1|] << .objeto.user!_factor_pen.user!_nse_c1
		col_factor_pen[:|C2|] << .objeto.user!_factor_pen.user!_nse_c2
		col_factor_pen[:|C3|] << .objeto.user!_factor_pen.user!_nse_c3
		col_factor_pen[:|IL|] << .objeto.user!_factor_pen.user!_nse_il
		col_factor_pen[:|IM|] << .objeto.user!_factor_pen.user!_nse_im
		col_factor_pen[:|IP|] << .objeto.user!_factor_pen.user!_nse_ip
	_when does_not_understand
	_endtry

	_return col_factor_pen
	
_endmethod
