_pragma(classify_level=restricted, usage={redefinable})
_method c_distrito.pep(p_tipo)
	
	_local diseno_activo   << swg_dsn_admin_engine.active_design
	_local proyecto_activo << diseno_activo.project
	_local l_clave_pep << ""
	_local pl << property_list.new()
	pl["D".as_symbol()] << "CONSTRUCCION" 
	pl["J".as_symbol()] << "DESMONTAJE"
	pl["Y".as_symbol()] << "RECONCENTRACION"
	
	_for iteroe _over diseno_activo.user!_oe_locals.fast_elements()
	_loop
		
		l_pep << proyecto_activo.user!_peps.an_element().source_collection.at(iteroe.user!_pep_id).user!_clave
		l_pep_tipo << l_pep.slice(1,1).as_symbol()
		
		_if pl[l_pep_tipo] = p_tipo.write_string.uppercase
		_then
			L_clave_pep << l_pep
			_leave
		_endif
		
	_endloop

	_return l_clave_pep
_endmethod
