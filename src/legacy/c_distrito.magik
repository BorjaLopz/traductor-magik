	_when does_not_understand
		write("Error al obtener las reservas proyectadas")
	_endtry

	_return col_reservas
	
_endmethod
$
_pragma(classify_level=restricted, usage={redefinable})
_method c_distrito.resumen_km_cable()

	## Generar un resumen de kilometros de pares de cable en el
	## distrito agrupados por pares muertos, existentes y
	## proyectados.
	##  - El Km de pares de un cable está dado por:
	##          (num. de pares * longitud de cable)/1000
	##  - Para los pares muertos se consideran solo los
	##    cables proyectados
	##  - No se consideran los cables que no tengan asignado estado
	##    de construcción y especificacion
	## (vbluna/11-10-2006)

	_local ht_km_ps_dto << hash_table.new() # Almacena los km de cables
	_local ln_cap_cable                     # Capacidad de un cable
	_local ln_ps_muertos                    # Num. Pares muertos de un cable
	_local ln_long_cable                    # Longitud de un cable
	_local ln_km_ps_cable                   # Km en total de pares de un cable
	_local ln_km_ps_muertos                 # Km en pares muertos de un cable

	ht_km_ps_dto.default_value << 0.0
	
	_for cable _over _self.cables_conectados().fast_elements()
	_loop
		#Si el cable no tiene asignada especificación
		#y estado de construccion, no se considera
		_if cable.spec_info _isnt _unset _andif
		    cable.construction_status _isnt _unset
		_then
			# obtener la capacidad del cable
			ln_cap_cable << cable.spec_info.size.as_number()

			# obtener la longitud medida del cable,
			# si ésta es = unset, se tomará la calculada
			_if cable.measured_length _isnt _unset
			_then
				ln_long_cable << cable.measured_length.value
			_else
				ln_long_cable << cable.calculated_length.value
			_endif

			#calcular los kms de pares por cable
			ln_km_ps_cable << (ln_cap_cable * ln_long_cable)/1000
							
			#Si el cable es existente
			_if cable.construction_status = "EXISTENTE"
			_then
				#Se acumulan los kms al total de km existentes
				ht_km_ps_dto[:km_ps_exis] +<< ln_km_ps_cable

			#Si el cable es proyectado
			_elif cable.construction_status = "PROYECTADO"
			_then
				#Se acumulan los kms al total de km proyectados
				ht_km_ps_dto[:km_ps_proy] +<< ln_km_ps_cable

				#Obtener los pares muertos del cable
				ln_ps_muertos << cable.user!_pares_muertos.default(0)

				_if ln_ps_muertos > 0
				_then
					#calcular los kms de pares muertos por cable
					ln_km_ps_muertos << (ln_ps_muertos * ln_long_cable)/1000

					#Se acumulan los kms al total de km muertos
					ht_km_ps_dto[:km_ps_muertos] +<< ln_km_ps_muertos
				_endif
			_endif
		_endif
	_endloop

	_return ht_km_ps_dto
	
_endmethod
$
_pragma(classify_level=restricted, usage={redefinable})
_method c_distrito.resumen_pares

	## Objetivo:
	##    - Obtener el resumen de pares conectados y en reserva de
	##      todo el distrito
   	## Parámetros de entrada:
   	## Parámetros de salida:
	##    l_col_pares -  dual_key_a_table
	##    [:|Con|,:|Act|] << Suma de las cuentas lógicas de las terminales existentes
	##    [:|Con|,:|Aum|] << Suma de las cuentas lógicas de las terminales
	##                   proyectadas siempre y cuando no sean una sustitucíón
	##    [:|Con|,:|Tot|] << Conectados Actual + Conectados Aumento
	##    [:|Res|,:|Act|] << Suma del numero de pares de las reservas existentes
	##    [:|Res|,:|Aum|] << Suma del numero de pares de las reservas proyectadas
	##    [:|Res|,:|Tot|] << Reseva Actual + Reseva Aumento
	##    [:|Tot|,:|Act|] << Conectados Actual + Reserva Actual
	##    [:|Tot|,:|Aum|] << Conectados Actual + Reseva Aumento
	##    [:|Tot|,:|Tot|] << Total Actual + Total Aumento
	## vbluna(11-nov-06)

	_local l_col_pares << dual_key_a_table.new()


	l_col_pares[:|Con|,:|Act|] << 0
	l_col_pares[:|Con|,:|Aum|] << 0
	l_col_pares[:|Con|,:|Tot|] << 0
	l_col_pares[:|Res|,:|Act|] << 0
	l_col_pares[:|Res|,:|Aum|] << 0
	l_col_pares[:|Res|,:|Tot|] << 0
	l_col_pares[:|Tot|,:|Act|] << 0
	l_col_pares[:|Tot|,:|Aum|] << 0
	l_col_pares[:|Tot|,:|Tot|] << 0

	# Pares conectados Actual
	
	LoTerminales << _self.obten_terminales()
	_for terminal _over LoTerminales.fast_elements()#_self.terminales_existentes.fast_elements()
	_loop
		_for cuenta _over terminal.copper_line_of_counts.fast_elements()
		_loop
			_if cuenta.user!_cuenta <> "Física" _andif
			    terminal.construction_status = "EXISTENTE"
			_then
				l_col_pares[:|Con|,:|Act|] +<< cuenta.high_range.default(0) -
							        cuenta.low_range.default(0) + 1
			_endif
		_endloop
	_endloop

	# Pares conectados Aumento
	_for terminal _over LoTerminales.fast_elements()#_self.terminales_proyectadas.fast_elements()
	_loop
		_if terminal.user!_sustitucion <> "SI"
		_then
			_for cuenta _over terminal.copper_line_of_counts.fast_elements()
			_loop
				_if cuenta.user!_cuenta <> "Física" _andif
				    terminal.construction_status = "PROYECTADO"
				_then
					l_col_pares[:|Con|,:|Aum|]+<<cuenta.high_range.default(0)-
  							               cuenta.low_range.default(0)+1
				_endif
			_endloop
		_endif
	_endloop
	
	# Pares en reserva Actual
	LoReservas << _self.obten_reservas()
	_for reserva _over LoReservas.fast_elements()#_self.reservas_existentes.fast_elements()
	_loop
		_if reserva.construction_status = "EXISTENTE"
		_then
			l_col_pares[:|Res|,:|Act|] +<< reserva.user!_cantidad_pares.default(0)
		_endif
	_endloop

	# Pares en reserva Aumento
	_for reserva _over LoReservas.fast_elements()#_self.reservas_proyectadas.fast_elements()
	_loop
		_if reserva.construction_status = "PROYECTADO"
		_then
			l_col_pares[:|Res|,:|Aum|] +<< reserva.user!_cantidad_pares.default(0)
		_endif
	_endloop
	
	l_col_pares[:|Con|,:|Tot|] << l_col_pares[:|Con|,:|Act|] + l_col_pares[:|Con|,:|Aum|]
	l_col_pares[:|Res|,:|Tot|] << l_col_pares[:|Res|,:|Act|] + l_col_pares[:|Res|,:|Aum|]
	l_col_pares[:|Tot|,:|Act|] << l_col_pares[:|Con|,:|Act|] + l_col_pares[:|Res|,:|Act|]
	l_col_pares[:|Tot|,:|Aum|] << l_col_pares[:|Con|,:|Aum|] + l_col_pares[:|Res|,:|Aum|]
	l_col_pares[:|Tot|,:|Tot|] << l_col_pares[:|Tot|,:|Act|] + l_col_pares[:|Tot|,:|Aum|]
		
	_return l_col_pares
	
_endmethod
$
_pragma(classify_level=restricted, usage={redefinable})
_method c_distrito.superficie_km

   	## Parámetros de salida:
	##    - Superficie del distrito en km cuadrados
	## vbluna

	_try
		_return .objeto.para_kilometros_quadrados( .objeto.user!_limite.area)		
	_when does_not_understand
		_return 0
	_endtry
		
_endmethod
$
_pragma(classify_level=restricted, usage={redefinable})
_method c_distrito.tam_lote_promedio_m

   	## Parámetros de salida:
	##     - Tamaño promedio de lote en el distrito en metros cuadrados
	## vbluna

	_try
		_local ln_total_mts << 0

		_for lote _over _self.lotes.fast_elements()
		_loop
			ln_total_mts +<< lote.para_metros_quadrados(lote.user!_limite.area) #   /100
		_endloop

		_return ln_total_mts/_self.cantidad_lotes
	_when does_not_understand
		_return 0
	_endtry
		
_endmethod
$
_pragma(classify_level=restricted, usage={redefinable})
_method c_distrito.telefonos_publicos

   	## Parámetros de entrada:
   	## Parámetros de salida:
	##     l_col_casetas - hash_table con:
	##                      [:Tipo_caseta] << cantidad casetas
	##                      [:Total_Tmx] << suma de tipos caseta,
	##                                      excepto las operteles
	## vbluna

	_local l_tbl_caseta
	_local l_predicate
	_local l_sel_caseta
	_local l_col_casetas << hash_table.new()
	l_col_casetas.default_value << 0
	_local ln_num_casetas
	_local ls_tipo_caseta

	_try
		l_tbl_caseta << gis_program_manager.cached_dataset(:landbase).collections[:caseta_tel]
		l_predicate  << predicate.inside(:posicion, .objeto.user!_limite)
		l_sel_caseta << l_tbl_caseta.select(l_predicate)

		_for caseta _over l_sel_caseta.fast_elements()
		_loop
			ls_tipo_caseta <<
				c_traductor.tipo_caseta(caseta.user!_tipo.write_string.as_symbol())

			_if ls_tipo_caseta = :|TPTC|
			_then
				l_col_casetas[ls_tipo_caseta] +<< 1
			_endif
		_endloop
	_when does_not_understand
	_endtry

	_for casetas _over .col_tel_publicos.fast_elements()
	_loop
		l_col_casetas[:|PSLT|] +<< casetas[:pslt]
		l_col_casetas[:|LTC|] +<< casetas[:ltc]
		l_col_casetas[:|OPERT|] +<< casetas[:publicos_comp]
	_endloop

	l_col_casetas[:|Total_Tmx|] << l_col_casetas[:|PSLT|] + l_col_casetas[:|LTC|] +
				         l_col_casetas[:|TPTC|]
	
	_return l_col_casetas
	
_endmethod
$
_pragma(classify_level=restricted, usage={redefinable})
_method c_distrito.terminales_existentes
   	## Parámetros de entrada:
   	## Parámetros de salida:
	##    col_terminales - rope con las terminales proyectadas
	##       asociadas al distrito, no se consideran las terminales
	##       con tipo de instalación = "SIN SERVICIO"
	## vbluna

	_local col_terminales << rope.new()

        _try
		_for terminal _over .objeto.copper_terminals.fast_elements()
		_loop
			_if terminal.construction_status = "EXISTENTE"
			_then
				_if terminal.user!_instalacion <> "SIN SERVICIO"
				_then
					col_terminales.add(terminal)
				_endif
			_endif
		_endloop
	_when does_not_understand
	      write("Error al obtener las terminales existentes")
	_endtry

	_return col_terminales
	
_endmethod
$
_pragma(classify_level=restricted, usage={redefinable})
_method c_distrito.terminales_proyectadas

   	## Parámetros de entrada:
   	## Parámetros de salida:
	##    col_terminales - rope con las terminales proyectadas
	##       asociadas al distrito, no se consideran las terminales
	##       con tipo de instalación = "SIN SERVICIO"
	## vbluna

	_local col_terminales << rope.new()

        _try
		_for terminal _over .objeto.copper_terminals.fast_elements()
		_loop
			_if terminal.construction_status = "PROYECTADO"
			_then
				_if terminal.user!_instalacion <> "SIN SERVICIO"
				_then
					col_terminales.add(terminal)
				_endif
			_endif
		_endloop
	_when does_not_understand
	      write("Error al obtener las terminales proyectadas")
	_endtry

	_return col_terminales
	
_endmethod
$
_pragma(classify_level=restricted, usage={redefinable})
_method c_distrito.tipo_caja

   	## Parámetros de salida:
	##    - string con el valor del código del material asociada a p_caja
	## vbluna

	_try
		_return _self.primera_cd_existente.spec_info.type.default("").write_string
	_when does_not_understand
	        _return ""
	_endtry
	
_endmethod
$
_pragma(classify_level=restricted, usage={redefinable})
_method c_distrito.total_lineas_distrito

	## Objetivo:
	##    - Obtener el total de lineas conectadas en el distrito =
	##   Total lineas saturación + Total de teléfonos públicos telmex
	## Parámetros de entrada:
   	## Parámetros de salida:
	##    - cantidad de líneas conectadas en todo el distrito
	## vbluna

	_local l_col_publicos << _self.telefonos_publicos

	_return _self.total_lineas_saturacion + l_col_publicos[:|Total_Tmx|]
	
_endmethod
$
_pragma(classify_level=restricted, usage={redefinable})
_method c_distrito.total_lineas_saturacion

   	## Parámetros de entrada:
   	## Parámetros de salida:
	##    .col_lin_sat[:|Total|] - total de lineas a saturacion en
	##                             el distrito
	## vbluna

	_return .col_lin_sat[:|Total|].default(0)
		
_endmethod
$
_pragma(classify_level=restricted, usage={redefinable})
_method c_distrito.total_lineas_telmex

   	## Parámetros de entrada:
   	## Parámetros de salida:
	##     - suma de telefonos publicos telmex + # lineas en el distrito
	## vbluna

	_try
		_return _self.telefonos_publicos[:|Total_Tmx|] + _self.total_viv_lin[:abonados]
	_when does_not_understand
		_return 0
	_endtry
	
_endmethod
$
_pragma(classify_level=restricted, usage={redefinable})
_method c_distrito.total_viv_lin

   	## Parámetros de entrada:
   	## Parámetros de salida:
	##    lst_totales - hash_table con el total de inventario
	##                  de todos los NSE
	## vbluna

	_local lht_totales << hash_table.new()
	lht_totales.default_value << 0
	
	_for inventario _over .col_viv_lin.fast_elements()
	_loop
		lht_totales[:viviendas] +<< inventario[:viviendas]
		lht_totales[:abonados]  +<< inventario[:abonados] 
		lht_totales[:lineas_multiplicador] +<< inventario[:lineas_multiplicador]
		lht_totales[:lineas_competencia]   +<< inventario[:lineas_competencia]
		lht_totales[:lineas_inalambricas]  +<< inventario[:lineas_inalambricas]
		lht_totales[:solicitudes]      +<< inventario[:solicitudes]
		lht_totales[:viv_sin_servicio] +<< inventario[:viv_sin_servicio]
	_endloop

	_return lht_totales
	
_endmethod
$
_pragma(classify_level=restricted, usage={redefinable})
_method c_distrito.valida_conectividad_a_caja(p_objetos)
	## 
	##
	LoObjetos << rope.new()
	_for obj _over p_objetos.elements()
	_loop
		con << obj.get_upstream_connector()
		_if con _isnt _unset
		_then
			_loop @salir
				cables << con.get_upstream_cables()
				_for cable _over cables.elements()
				_loop
					cab << cable
					con << cable.get_upstream_connector()
				_endloop
				# (10/10/19 jtlelo) : se corrigio el problema del ciclado del
				# metodo al generar el sello se detecto el caso que un empalme
				# exista sin cables.
				_if con _is _unset _orif
				    con.get_upstream_cables().size = 0
				_then
					_leave @salir
				_endif
			_endloop
		_endif
		_if .objeto.get_cd _isnt _unset _andif
		    .objeto.get_cd.cables_de_salida().includes_string?(cab)
		_then
			LoObjetos.add(obj)
		_endif
	_endloop
	
	_return LoObjetos
_endmethod
$
_pragma(classify_level=restricted, usage={redefinable})
_method c_distrito.viviendas_lineas

   	## Parámetros de entrada:
   	## Parámetros de salida:
	##    .col_viv_lin - hash_table con:
	##       [:NSE] << property_list con:
	##                  :viviendas
	##                  :abonados
	##                  :lineas_multiplicador
	##                  :lineas_competencia
	##                  :lineas_inalambricas
	##                  :solicitudes
	##                  :viv_sin_servicio
	## vbluna

	_return .col_viv_lin
	
_endmethod
$
_pragma(classify_level=restricted, usage={redefinable})
_method c_distrito.objetos_modificados_gis
	paf         << smallworld_product.pni_application()
	objects     <<  paf.plugin(:job_component_plugin).job_component_gui.get_items().an_element()
	lista       <<  swg_dsn_admin_engine.active_design.dsm_created_and_modified_objects( _true  )	
	gis_objects << rope.new()
	_if objects _isnt _unset 
	_then
	    _for iterk, iterv _over objects.fast_keys_and_trees()
	    _loop
		    _if iterk.class_name _isnt :symbol
		    _then
			    lista.add(iterk)	
		    _endif		
	    _endloop
	_endif
	_if lista _isnt _unset 
	_then
	   _for iterl   _over lista.fast_elements()
	   _loop
		   _if  iterl.source_collection.source_view.name.write_string.lowercase = "gis"
		   _then
			gis_objects.add(iterl)			   
		   _endif 
	   _endloop
	_return gis_objects
	_endif	
_endmethod
$ 
_pragma(classify_level=restricted, usage={redefinable})
_method c_distrito.faltas_y_danios

	## Objetivo:
	##    - Obtener las faltas y daños de los elementos asociados
	##      al distrito.


	_local col_faltas << hash_table.new()
	_local ls_clave
	_local ls_descripcion
	_local ln_cantidad_faltas

	col_faltas.default_value << simple_vector.new_with("",0)
	

	LoGis << gis_program_manager.cached_dataset(:gis)
		
	objetos << _self.objetos_modificados_gis
	
	_for Elemento _over objetos.fast_elements()
	_loop
		_if Elemento.responds_to?(:user!_faltas_dannoss)
		_then
			_for falta _over Elemento.perform(:user!_faltas_dannoss).fast_elements()
			_loop
				ls_clave            << falta.user!_clave.write_string.as_symbol()
				ls_descripcion       << falta.user!_descripcion.write_string
				ln_cantidad_faltas   << col_faltas[ls_clave][2].default(0)
				col_faltas[ls_clave] << {ls_descripcion,ln_cantidad_faltas +<< 1}
			_endloop
			
		_endif
		
	_endloop				
	
	_return col_faltas
	
_endmethod
$
_pragma(classify_level=restricted, usage={redefinable})
_method c_distrito.fecha_recorrido
	
	_local ls_fecha << c_traductor.mes(date_now().month_number) + " / " + date_now().year.write_string
	_return ls_fecha
_endmethod
$

_pragma(classify_level=restricted, usage={redefinable})
_method c_distrito.fecha_inventario
	_local ls_fecha << c_traductor.mes(date_now().month_number) + " / " + date_now().year.write_string
	_return ls_fecha
_endmethod
