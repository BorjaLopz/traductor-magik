_package user
#remex(:c_dto_pronostico)

$
def_slotted_exemplar(:c_dto_pronostico,
                     {
		        {:otablas,               _unset}, # Alamcena un objeto tablas
			{:oCoordOrigen,          _unset}, # Coord donde inicia el sello
	    		{:oWindow,               _unset}, # canvas en el que se desplegara el sello
	     		{:bTablas_Creadas,       _false}  # Indica si las tabals ya fueron creadas
		     },
		      :layout_element 
)
$
c_dto_pronostico.define_shared_constant(:allowed_on_menu?, _false, :public)
$


c_dto_pronostico.define_slot_access(:oTablas,              :writable, :public)
c_dto_pronostico.define_slot_access(:oCoordOrigen,         :writable, :public)
c_dto_pronostico.define_slot_access(:oWindow,              :writable, :public)
c_dto_pronostico.define_slot_access(:bTablas_creadas,      :writable, :public)
$

_pragma(classify_level=restricted, usage={redefinable})
_method c_dto_pronostico.defined_attributes
	## 
	##

	attribs << rope.new_from (_super.defined_attributes)

	>> attribs
	
_endmethod
$

_pragma(classify_level=restricted, usage={redefinable})
c_dto_pronostico.define_attributes()

_pragma(classify_level=restricted, usage={redefinable})
_method c_dto_pronostico.draw_content_on(window)

	_self.oWindow << window

	_if _self.bTablas_Creadas = _false  
	_then

	   _local LoPAF << smallworld_product.pni_application()
	   _local LoLYP << LoPAF.plugin(:layout_plugin)	
	   _local LoLYD << LoLYP.start_layout_designer()
	   _local LoLYM << LoLYD.plugin(:layout_manager)	
	   
           _self.inicializa(coordinate.new(0,0))	

   	   _self.Agrega_LYM(LoLYM)
	   LoLYM.current_document.current_page.send_to_back(_self )

	_endif

	 _self.oTablas.Despliega(window)
	 
_endmethod
$

_pragma(classify_level=restricted, usage={redefinable})
_method c_dto_pronostico.inicializa(_optional RoCoord)

##  Objetivo: Manda llamar todos los metodos que crean e
##            inicializan las tablas
##  Parámetros de entrada: 
##    coordinate - RoCoord -
##                 Coordenada donde iniciara el resumen de
##                 materiales dentro del layout
##  Parámetros de salida:   NA
##  Regresa: NA
## Fecha de última modificación: 03/04/2005
## Autor de la modificación : dsanchez
## Descripción de la modificación: Se creo

	# Configuracion del sello transparente
	_self.set_fill_colour(_unset )
	
	_if RoCoord _is _unset 
	_then
		RoCoord << coordinate.new(0,0)
	_endif

	_self.oCoordOrigen << RoCoord
	
	# sepasa como parametro el layout
	# Crea el objeto que contiene todas las tablas del sello estandar
	_self.oTablas << c_tablas.new(_self)

	#Crea y configura cada una de las tablas 
	_self.prvCrea_Cfg_Tablas()

	#Se conoce el area de la tabla dibujada
	LoArea << _self.oTablas.area_total()

	#Se ajustan los limites del layout de acuerdo  a las tablas definidas
	_self.bounds << LoArea

	#Crea a los objetos que tendra c/u de las tablas
	_self.prvLlena_Celdas_de_tablas()

	#Indica que los objetos tabla ya fueron creados 
	_self.bTablas_creadas << _true

_endmethod
$


_pragma(classify_level=restricted, usage={redefinable})
_private _method c_dto_pronostico.prvCrea_Cfg_Tablas()

##  Objetivo: Manda llamar los metodos que crean y configuran 
##            las tablas 
##  Parámetros de entrada: 
##    coordinate - RoCoord -
##                 Coordenada donde iniciara el resumen de
##                 materiales dentro del layout
##  Parámetros de salida:   NA
##  Regresa: NA
## Fecha de última modificación: 03/04/2005
## Autor de la modificación : dsanchez
## Descripción de la modificación: Se creo

	_local LnAltura << 1
	LnAltura << _self.prvCreaCfgTbl_titulo(_self.oCoordOrigen)

	#se calcula la coordenada donde se dibujara la siguiente tabla,
	# pero incluyendo el desplazamianto en y "LnAltura" de la tabla anterior
	LoCoord  << coordinate.new(_self.oCoordOrigen.x, _self.oCoordOrigen.y - LnAltura)
	LnAltura << _self.PrvCreaCfgTbl_pares(LoCoord)

	#se calcula la coordenada donde se dibujara la siguiente tabla,
	# pero incluyendo el desplazamianto en y "LnAltura" de la tabla anterior	
	LoCoord << coordinate.new(_self.oCoordOrigen.x, LoCoord.y - LnAltura)
        LnAltura << _self.PrvCreaCfgTbl_Pronostico(LoCoord)

_endmethod
$

_pragma(classify_level=restricted, usage={redefinable})
_private _method c_dto_pronostico.prvLlena_Celdas_de_tablas()

##  Objetivo: Manda llamar los metodos que llenan las celdas de 
##            las tablas 
##  Parámetros de entrada: NA
##  Parámetros de salida:   NA
##  Regresa: NA
##  Fecha de última modificación: 03/04/2005
##  Autor de la modificación : dsanchez
##  Descripción de la modificación: Se creo

	_self.prvLlenaTbl_titulo()
        _self.prvLlenaTbl_pares()
	_self.prvLlenaTbl_Pronostico()

_endmethod
$

_pragma(classify_level=restricted, usage={redefinable})
_private _method c_dto_pronostico.PrvCreaCfgTbl_titulo(RoCoord)

##  Objetivo: Crea y configura los objetos necesarios para la
##            tabla titulo
##  Parámetros de entrada:
##   RoCoord. Coordenada donde iniciara a dibujarse la tabla 
##  Parámetros de salida:   NA
##  Regresa: NA
##  Fecha de última modificación: 03/04/2005
##  Autor de la modificación : dsanchez
##  Descripción de la modificación: Se creo	
	
	_local LoTblTitulo
	_local LoTblCuerpo
	
	LoTblTitulo << _self.oTablas.crea_tabla(2,2,:tbl_Titulo)

	#lineas internas de la tabla no se dibujaran
	LoTblTitulo.bDibuja_bordes? << _false 
	LoTblTitulo.bDibuja_Columnas_Internas?  << _false
	LoTblTitulo.bDibuja_Renglones_Internos? << _false

	#Coordenada donde iniciara la tabla
	LoTblTitulo.oCoordenada_Origen << RoCoord

	#longitudes de los renglones de la tabla, esta dada en mm 
	LoTblTitulo.oRenglones.elemento(1).nLongitud << 5
	LoTblTitulo.oRenglones.elemento(2).nLongitud << 5

	#longitud de las columnas, esta dada en mm 
	LoTblTitulo.oColumnas.elemento(1).nLongitud  << 10
	LoTblTitulo.oColumnas.elemento(2).nLongitud  << 23

	# configura que el borde inf se active
	LoCelda << LoTblTitulo.oCeldas.Celda(1,2).oElementos.obten_elemento(:bordes_celda)
	LoCelda.bBorde_inf? << _true	

	
	LnAltura << _self.oTablas.Longitud_total_renglones({:tbl_titulo})
	_return LnAltura
_endmethod
$

_pragma(classify_level=restricted, usage={redefinable})
_method c_dto_pronostico.prvLlenaTbl_titulo()
##  Objetivo: Asigna el objeto que contendra cada celda de la tabla
##  Parámetros de entrada: NA
##  Parámetros de salida:   NA
##  Regresa: NA
##  Fecha de última modificación: 03/04/2005
##  Autor de la modificación : dsanchez
##  Descripción de la modificación: Se creo

	# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
	# Texto de fijos columna 1
	# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
	
	#se crean los objetos que almacenara la tabla
	LoTit1  << c_texto_grafico.new("DTO.")
        LoTit1.sAlineacion << :centre_left
	LoTit1.nTamanio << 26
	
	LoTit2  << c_texto_grafico.new("D.A O.C.")
        LoTit2.sAlineacion << :centre_left
	LoTit2.nTamanio << 26

	#asigna los objetos creados a su correspondiente celda
	_self.oTablas.elemento(:tbl_Titulo).oCeldas.Celda(1,1).oElemento << LoTit1
	_self.oTablas.elemento(:tbl_Titulo).oCeldas.Celda(2,1).oElemento << LoTit2

	# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
	# Texto de captura columna 2
	# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
	
	#Se crea el objeto que se tomara como base para el resto de los objetos
	
	LoCapTxt1 << c_Captura_Texto.new("LJC-1")
	LoCapTxt1.nTamanio << 4
	LoCapTxt1.sAlineacion << :centre_left
	
	LoCapTxt2 << c_Captura_Texto.new("538.3 MTS")
	LoCapTxt2.nTamanio << 4
	LoCapTxt2.sAlineacion << :centre_left
	
	
	#asigna los objetos creados a su correspondiente celda
	_self.oTablas.elemento(:tbl_Titulo).oCeldas.Celda(1,2).oElemento << LoCapTxt1
	_self.oTablas.elemento(:tbl_Titulo).oCeldas.Celda(2,2).oElemento << LoCapTxt2

_endmethod
$


_pragma(classify_level=restricted, usage={redefinable})
_private _method c_dto_pronostico.prvCreaCfgTbl_Pares(RoCoord)

#  Objetivo: Crea y configura lso objetos necesarios para la
#            tabla pares
#  Parámetros de entrada:
#   RoCoord. Coordenada donde iniciara a dibujarse la tabla
#  Parámetros de salida:   NA
#  Regresa: NA
#  Fecha de última modificación: 03/05/2005
#  Autor de la modificación : dsanchez
#  Descripción de la modificación: Se creo

	_local LoTbl
		
	LoTbl << _self.oTablas.crea_tabla(3,2,:tbl_pares)

	#lineas internas de la tabla no se dibujaran
	LoTbl.bDibuja_bordes? << _true 
	LoTbl.bDibuja_Columnas_Internas?  << _false
	LoTbl.bDibuja_Renglones_Internos? << _true
	
	#Coordenada donde iniciara la tabla
	LoTbl.oCoordenada_Origen << RoCoord

	#longitudes de los renglones de la tabla, esta dada en mm 
	LoTbl.oRenglones.elemento(1).nLongitud << 3
	LoTbl.oRenglones.elemento(2).nLongitud << 3
	LoTbl.oRenglones.elemento(3).nLongitud << 3

	#longitud de las columnas, esta dada en mm 
	LoTbl.oColumnas.elemento(1).nLongitud  << 15
	LoTbl.oColumnas.elemento(2).nLongitud  << 18


	LnAltura << _self.oTablas.Longitud_total_renglones({:tbl_pares})

	_return LnAltura
	
_endmethod
$


_pragma(classify_level=restricted, usage={redefinable})
_method c_dto_pronostico.prvLlenaTbl_pares()

##  Objetivo: Asigna el objeto que le corresponde a cada una de
##            las celdas
##  Parámetros de entrada: NA
##  Parámetros de salida:   NA
##  Regresa: NA
##  Fecha de última modificación: 03/04/2005
##  Autor de la modificación : dsanchez
##  Descripción de la modificación: Se creo

	# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
	# Texto de fijos columna 1
	# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

	#se crean los objetos que almacenara la tabla
	# LoTit1 es la base para los otros titulos
	LoTit1  << c_texto_grafico.new("P.PRINC.")
	LoTit1.sAlineacion << :centre_left
	LoTit1.nTamanio << 18
	
	LoTit2  << c_texto_grafico.new_from(LoTit1, "P.SEC")
	LoTit3  << c_texto_grafico.new_from(LoTit1, "ABNS. EXIST.")

	#asigna los objetos creados a su correspondiente celda
	_self.oTablas.elemento(:tbl_pares).oCeldas.Celda(1,1).oElemento << LoTit1
	_self.oTablas.elemento(:tbl_pares).oCeldas.Celda(2,1).oElemento << LoTit2
	_self.oTablas.elemento(:tbl_pares).oCeldas.Celda(3,1).oElemento << LoTit3

	# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
	# Texto de captura columna 2
	# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
	
	#Se crea el objeto que se tomara como base para el resto de los objetos
	LoCapTxt1 << c_Captura_Texto.new("300+200")
	LoCapTxt1.nTamanio << 3
	LoCapTxt1.sAlineacion << :centre_left
	
	LoCapTxt2 << c_Captura_Texto.new_from(LoCapTxt1, "230+380")
	LoCapTxt3 << c_Captura_Texto.new_from(LoCapTxt1, "166")
	
	#asigna los objetos creados a su correspondiente celda
	_self.oTablas.elemento(:tbl_pares).oCeldas.Celda(1,2).oElemento << LoCapTxt1
	_self.oTablas.elemento(:tbl_pares).oCeldas.Celda(2,2).oElemento << LoCapTxt2
	_self.oTablas.elemento(:tbl_pares).oCeldas.Celda(3,2).oElemento << LoCapTxt3
	
_endmethod
$


_pragma(classify_level=restricted, usage={redefinable})
_private _method c_dto_pronostico.prvCreaCfgTbl_pronostico(RoCoord)

##  Objetivo: Crea y configura lso objetos necesarios para la
##            tabla de pronosticos
##  Parámetros de entrada:
##   RoCoord. Coordenada donde iniciara a dibujarse la tabla
##  Parámetros de salida:   NA
##  Regresa: NA
##  Fecha de última modificación: 03/04/2005
##  Autor de la modificación : dsanchez
## Descripción de la modificación: Se creo


	_local LoTbl # Tabla a la que hacemos referencia
		
	LoTbl << _self.oTablas.crea_tabla(3,3,:tbl_pronosticos)

	#lineas internas de la tabla no se dibujaran
	#LoTbl.bDibuja_bordes? << _false 
	#LoTbl.bDibuja_Columnas_Internas?  << _false
	#LoTbl.bDibuja_Renglones_Internos? << _false
	
	#Coordenada donde iniciara la tabla
	LoTbl.oCoordenada_Origen << RoCoord

	#longitudes de los renglones de la tabla, esta dada en mm 
	LoTbl.oRenglones.elemento(1).nLongitud << 3
	LoTbl.oRenglones.elemento(2).nLongitud << 3
	LoTbl.oRenglones.elemento(3).nLongitud << 3

	#longitud de las columnas, esta dada en mm 
	LoTbl.oColumnas.elemento(1).nLongitud  <<  7
	LoTbl.oColumnas.elemento(2).nLongitud  <<  8
	LoTbl.oColumnas.elemento(3).nLongitud  << 18

	LnAltura << _self.oTablas.Longitud_total_renglones({:tbl_pronosticos})

	_return LnAltura 

_endmethod
$

_pragma(classify_level=restricted, usage={redefinable})
_method c_dto_pronostico.prvLlenaTbl_pronostico()

##  Objetivo: Asigna el objeto que le corresponde a cada una de
##            las celdas
##  Parámetros de entrada: NA
##  Parámetros de salida:   NA
##  Regresa: NA
##  Fecha de última modificación: 03/04/2005
##  Autor de la modificación : dsanchez
##  Descripción de la modificación: Se creo

	# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
	# Texto de fijos columna 1
	# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

	# se crean los objetos que almacenara la tabla
	# LoTit1 surve como base para los otros titulos
	LoTit1  << c_texto_grafico.new("N")
	LoTit1.sAlineacion << :centre_left
	LoTit1.nTamanio << 18
	
	LoTit2  << c_texto_grafico.new_from(LoTit1, "N+1")
	LoTit3  << c_texto_grafico.new_from(LoTit1, "SAT.")

	# asigna los objetos creados a su correspondiente celda
	_self.oTablas.elemento(:tbl_pronosticos).oCeldas.Celda(1,1).oElemento << LoTit1
	_self.oTablas.elemento(:tbl_pronosticos).oCeldas.Celda(2,1).oElemento << LoTit2
	_self.oTablas.elemento(:tbl_pronosticos).oCeldas.Celda(3,1).oElemento << LoTit3

	# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
	# Texto de captura columna 2
	# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
	
	# Se crea el objeto que se tomara como base para el resto de los objetos
	LoCapTxt1 << c_Captura_Texto.new("")
	LoCapTxt1.nTamanio << 2
	LoCapTxt1.sAlineacion << :centre_left
	
	LoCapTxt2 << c_Captura_Texto.new_from(LoCapTxt1)
	LoCapTxt3 << c_Captura_Texto.new_from(LoCapTxt1)
	
	# asigna los objetos creados a su correspondiente celda
	_self.oTablas.elemento(:tbl_pronosticos).oCeldas.Celda(1,2).oElemento << LoCapTxt1
	_self.oTablas.elemento(:tbl_pronosticos).oCeldas.Celda(2,2).oElemento << LoCapTxt2
	_self.oTablas.elemento(:tbl_pronosticos).oCeldas.Celda(3,2).oElemento << LoCapTxt3
	
	# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
	# Texto de captura columna 3
	# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
	
	# Se crea el objeto que se tomara como base para el resto de los objetos
	LoCapTxt1 << c_Captura_Texto.new("")
	LoCapTxt1.nTamanio << 2
	LoCapTxt1.sAlineacion << :centre_left
	
	LoCapTxt2 << c_Captura_Texto.new_from(LoCapTxt1)
	LoCapTxt3 << c_Captura_Texto.new_from(LoCapTxt1)
	
	
	# asigna los objetos creados a su correspondiente celda
	_self.oTablas.elemento(:tbl_pronosticos).oCeldas.Celda(1,3).oElemento << LoCapTxt1
	_self.oTablas.elemento(:tbl_pronosticos).oCeldas.Celda(2,3).oElemento << LoCapTxt2
	_self.oTablas.elemento(:tbl_pronosticos).oCeldas.Celda(3,3).oElemento << LoCapTxt3	
	
_endmethod
$

_pragma(classify_level=restricted, usage={redefinable})
_method c_dto_pronostico.Agrega_LYM(RoLym)

## Objetivo: Permite agregar todos los elementos Layout a la pagina
## Parámetros de entrada:  
##    :layout_manager - RoLym : Referencia al LayoutManager
## Parámetros de salida:   NA
## Regresa: NA
## Fecha de última modificación: 3/Marzo/2005
## Autor de la modificación : FADD
## Descripción de la modificación: Se documentó

	_self.oTablas.Agrega_LYM(RoLym)


_endmethod

