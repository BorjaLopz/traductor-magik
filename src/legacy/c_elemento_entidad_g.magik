_package user
#remex(:c_elemento_entidad_g)

$
def_slotted_exemplar(:c_elemento_entidad_g,
    {
           {:oArea,           _unset }, # Area que debe cubrir la seccion
           {:oVentana,        _unset }, # Layout
	   {:oEntidad,        _unset }, # Entidad del negocio
	   {:sNombre_Simbolo, _unset }, # Simbolo que representa el elemento
	   {:sDescripcion,    _unset }, # Descripcion que acompaña al elemento	   
	   {:oElementos,      _unset }, # Elementos que contendrá el dibujo
	   {:oPto_contacto,   _unset }, # Coordenada donde se debe hacer contacto
           {:nLong_grafica,   _unset }, # Longitud grafica del elemento
	   {:bHabilitar,      _unset }, # descartar elementos para calcular el ajuste de las long
           {:collEtiquetas,   _unset }  # Posicion de las etiquetas
    }
)
$
c_elemento_entidad_g.define_slot_access(:oArea,            :writable, :public)
c_elemento_entidad_g.define_slot_access(:oVentana,         :writable, :public)
c_elemento_entidad_g.define_slot_access(:oEntidad,         :writable, :private)
c_elemento_entidad_g.define_slot_access(:oElementos,       :writable, :public)
c_elemento_entidad_g.define_slot_access(:sNombre_Simbolo,  :writable, :private)
c_elemento_entidad_g.define_slot_access(:sDescripcion,     :writable, :private)
c_elemento_entidad_g.define_slot_access(:oPto_Contacto,    :writable, :private)
c_elemento_entidad_g.define_slot_access(:nLong_Grafica,    :writable, :private)
c_elemento_entidad_g.define_slot_access(:bHabilitar,       :writable, :private)
c_elemento_entidad_g.define_slot_access(:collEtiquetas,    :writable, :private)
$

_pragma(classify_level=restricted, usage={redefinable})
_method c_elemento_entidad_g.new(RoObjeto)

## Objetivo: Crear una instancia de la clase c_elemento_entidad_g
## Parámetros de entrada:
##     Entidad - RoObjeto:  Objeto entidad que va a representar
##                   graficamente
## Parámetros de salida:  NA
## Regresa: NA	
## Fecha de última modificación:
##   04/04/05 DSB : Se establecio el valor por defecto de
##                  bHabilitar a true	
##   12/02/05 DSB Se creo

   _self.oElementos       << c_elementos.new()
   _self.oPto_Contacto    << coordinate.new(0,0)
   _self.collEtiquetas    << hash_table.new()
   _self.oEntidad         << RoObjeto
   _self.bHabilitar       << _true
   _self.sNombre_Simbolo  << _unset 
   
   
#   _self.configurar_elementos(_Self.oEntidad)

   _return _clone
	
_endmethod
$


