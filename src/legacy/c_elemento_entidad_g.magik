_pragma(classify_level=restricted, usage={redefinable})
_method c_elemento_entidad_g.despliega()

## Objetivo: Despliega los elementos graficos 
## Parámetros de entrada: NA
## Parámetros de salida:  NA
## Regresa: NA	
## Fecha de última modificación:
##   04/04/05 DSB Se creo

   # calcula la nueva posicion del area de acuerdo al pto de
   # contacto externo	
   _self.oElementos.oArea << _self.reposicionar_Area(_self.oArea)   

   _self.oElementos.oVentana << _self.oVentana

   _self.dfn_ubicacion_elementos_internos()

   _self.oElementos.despliega()
	
_endmethod
$

_pragma(classify_level=restricted, usage={redefinable})
_method c_elemento_entidad_g.asigna_valor_etiqueta(PsEtiqueta) << PsValor

## Objetivo: Asigna el valor a una etiqueta
## Parámetros de entrada:
##    PsEtiqueta : Etiqueta que identifica el elemento al cual
##               se le desea cambiar su contenido
##    PsValor : Valor que almacenara la etiqueta	
## Parámetros de salida:  NA
## Regresa: NA	
## Fecha de última modificación:
##   01/04/05 DSB Se subio a la clase entidad
	
   LoLbl << _self.oElementos.obten_elemento(PsEtiqueta)
   LoLbl.sTexto << PsValor
   
_endmethod
$

_pragma(classify_level=restricted, usage={redefinable})
_method c_elemento_entidad_g.obten_valor_etiqueta(PsEtiqueta) 

## Objetivo: Obtiene  el valor de una etiqueta
## Parámetros de entrada:
##    PsEtiqueta : Etiqueta que identifica el elemento al cual
##               se le desea cambiar su contenido
## Parámetros de salida:  NA
## Regresa:
##   String - Cadena que desplegara el elemento	
## Fecha de última modificación:
##   01/04/05 DSB Se subio a la clase entidad
	
   LoLbl << _self.oElementos.obten_elemento(PsEtiqueta)
   _return LoLbl.sTexto 
   
_endmethod
$


