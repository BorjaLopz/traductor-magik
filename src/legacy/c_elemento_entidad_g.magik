_pragma(classify_level=restricted, usage={redefinable})
_method c_elemento_entidad_g.reposicionar_Area(RoArea)
	
## Objetivo: Calcular la nueva posicion del area (bounding_box)
##           de acuerdo al punto de contacto
## Parámetros de entrada: NA
## Parámetros de salida:  NA
## Regresa: NA	
## Fecha de última modificación:
##   01/04/05 DSB Se creo


   # Calcular las distancias del pto de contacto interior a las
   # coordenadas inferior y a la superior

   LnAlturaArea << ( RoArea.YMax - RoArea.YMin )

	
   LnDistEnXInf << 0
   LnDistEnYInf << LnAlturaArea / 2

   LnDistEnXSup << _self.nLong_grafica
   LnDistEnYSup << LnAlturaArea / 2

   _return  bounding_box.new( _self.oPto_Contacto.X + LnDistEnXInf,
                              _self.oPto_Contacto.Y - LnDistEnYInf,
                              _self.oPto_Contacto.X + LnDistEnXSup,
                              _self.oPto_Contacto.Y + LnDistEnYSup )
	
_endmethod
$


