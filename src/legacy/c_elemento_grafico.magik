_package user
$
def_slotted_exemplar(:c_elemento_grafico,
		     {
			     {:oVentana,    _unset}, #ventana donde se dibujaran los elementos
			     {:oArea,       _unset}, #Superficie que cubre el layout
			     {:nMargen_Sup,     0},  #Margen Supeior para el contenido de la celda
     			     {:nMargen_Inf,     0},  #Margen Inferior para el contenido de la celda
     			     {:nMargen_Izq,     0},  #Margen Izquierdo para el contenido de la celda 
			     {:nMargen_Der,     0}   #Margen Derecho para el contenido de la celda			     
		     }
)
$
c_elemento_grafico.define_slot_access(:nMargen_Der, :writable, :private)
$
c_elemento_grafico.define_slot_access(:nMargen_Inf, :writable, :private)
$
c_elemento_grafico.define_slot_access(:nMargen_Izq, :writable, :private)
$
c_elemento_grafico.define_slot_access(:nMargen_Sup, :writable, :private)
$
c_elemento_grafico.define_slot_access(:oArea,       :writable, :private)
$
c_elemento_grafico.define_slot_access(:oVentana,    :writable, :private)
$
_pragma(classify_level=restricted, usage={redefinable})
_method c_elemento_grafico.Actualiza_Area_Elemento()
## Objetivo: Metodo que permite Establecer el area del elemento
## Parámetros de entrada: NA
## Parámetros de salida:  NA
## Regresa:  NA
## Fecha de última modificación : 28 / Octubre / 2004
## Autor de la modificación fdiaz
## Descripción de la modificación : Creación

_Local LnXMin # Posicion X Min de la nueva área
_Local LnYMin # Posicion Y Min de la nueva área
_Local LnXMax # Posicion X Max de la nueva área
_Local LnYMax # Posicion Y Max de la nueva área

	# Se aplica el margen indicado por el usuario
	LnXMin << _self.oArea.Xmin + _self.nMargen_Izq
	LnYMin << _self.oArea.Ymin + _self.nMargen_Inf
	LnXMax << _self.oArea.Xmax - _self.nMargen_Der
	LnYMax << _self.oArea.Ymax - _self.nMargen_Sup	

	# Se establece la nueva area
	_self.oArea << bounding_box.new(LnXMin,LnYMin,LnXMax,LnYMax)	
	
_endmethod
