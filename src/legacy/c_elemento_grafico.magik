##           Constructor de copia
## Parámetros de entrada: NA
## 	c_elemento_grafico - RoObjeto : Objeto apartir del cual se creara uno nuevo
## Parámetros de salida:   NA
## Regresa:  NA
## Fecha de última modificación : 11 / Noviemnre / 2004
## Autor de la modificación fdiaz
## Descripción de la modificación : Creación
	
_endmethod
$
_pragma(classify_level=advanced, topic={plotting}, usage={subclassable})
_method c_elemento_grafico.new_from_serial( keys, xml_values )

	props << property_list.new()
	
	_for nr, key _over keys.fast_keys_and_elements()
	_loop
		props[key] << xml_values[nr]
	_endloop
	
	_return _clone.init_with( props )
	
_endmethod
