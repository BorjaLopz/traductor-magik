_pragma(classify_level=advanced, topic={plotting}, usage={subclassable})
_method c_elemento_grafico.init_with( props )

	_for key, value _over props.fast_keys_and_elements()
	_loop
		_try _with cond
		     _self.perform_private( key.with_chevron, value )
		_when does_not_understand
		_endtry 
	_endloop

	_return _self
	
_endmethod
$
