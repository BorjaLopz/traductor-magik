_pragma(classify_level=restricted)
_method c_elemento_grafico.serial_slots()

	_local ln_margen_sup,ln_margen_inf,ln_margen_izq,ln_margen_der
	
	_try
		ln_margen_sup << .nMargen_Sup/10
		ln_margen_inf << .nMargen_Inf/10
		ln_margen_izq << .nMargen_Izq/10
		ln_margen_der << .nMargen_Der/10
	_when does_not_understand
		ln_margen_sup << 0
		ln_margen_inf << 0
		ln_margen_izq << 0
		ln_margen_der << 0
	_endtry
		
	keys << rope.new_with(:oArea,:nMargen_Sup,:nMargen_Inf,:nMargen_Izq,:nMargen_Der)
	values << rope.new_with(.oArea,ln_margen_sup,ln_margen_inf,ln_margen_izq,ln_margen_der)

	_return keys, values
	
_endmethod
$
_pragma(classify_level=restricted)
_method c_elemento_grafico.serial_structure

	>> :slotted
	
_endmethod
