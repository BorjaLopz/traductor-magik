_package user
$
def_slotted_exemplar(:c_elementos,
                    {
	             {:nTotal_Elementos,      0}, # Num total de elementos
		     {:collElementos,    _unset}, # Coleccion de elementos que 
		                                  # contiene la celda
		     {:oVentana,         _unset}, # Superficie que cubre el layout
		     {:oArea,            _unset}  # Area sobre la que se dibuja
		    }
)

$
c_elementos.define_slot_access(:collElementos,      :writable) 
$
c_elementos.define_slot_access(:nTotal_Elementos,   :writable) 
$
c_elementos.define_slot_access(:oArea,              :writable, :private)
$
c_elementos.define_slot_access(:oVentana,           :writable) 
$
_pragma(classify_level=restricted, usage={redefinable})
_method c_elementos.Agregar_elemento(RoElemento, RsNombre)
## Objetivo: Agrega un elemento a la celda
## Parámetros de entrada:  
## 	RoElemento - c_elemento_grafico : Elemento grafico a dibujar en la celda
##      Cadena - RsNombre : Nombre del elemento grafico
## Parámetros de salida:   NA
## Regresa: NA
## Fecha de última modificación: 28/Octubre/2004
## Descripción de la modificación: Creación 

	_self.collElementos[RsNombre] << RoElemento
	_self.nTotal_Elementos <<  _self.nTotal_Elementos + 1

_endmethod
$
_pragma(classify_level=restricted)
_method c_elementos.collElementos << valor

	.collElementos << valor
	
_endmethod
$
_pragma(classify_level=restricted, usage={redefinable})
_method c_elementos.Despliega()
## Objetivo: Dibujar el elemento grafico
## Parámetros de entrada:  NA
## Parámetros de salida:   NA
## Regresa: NA
## Fecha de última modificación: 28/10/2004
## Descripción de la modificación: Creación 

	# Se despliegan todos los elementos graficos contenidos en la celda		
	_for LoElemento  _over _self.collElementos.fast_elements()
	_loop
		LoElemento.oVentana << _self.oVentana
		LoElemento.oArea << _self.oArea
		LoElemento.Actualiza_Area_Elemento()
		LoElemento.Despliega()
	_endloop
	
_endmethod
$
_pragma(classify_level=restricted)
_method c_elementos.init_with( props )

	_for key, value _over props.fast_keys_and_elements()
	_loop
		_try _with cond
		     _self.perform_private( key.with_chevron, value )
		_when does_not_understand
		_endtry 
	_endloop

	_return _self
	
_endmethod
$
_pragma(classify_level=restricted, usage={redefinable})
_method c_elementos.new()
## Objetivo: Crear una instancia de filas
## Parámetros de entrada: NA
## Parámetros de salida:  NA
## Regresa: 
## 	c_elementos - regresa un objeto c_elementos
## Fecha de última modificación: 28/10/2004
## Descripción de la modificación: 

	_self.nTotal_Elementos << 0
	_self.collElementos << hash_table.new()	
	
	_return _clone
	
_endmethod
$
_pragma(classify_level=restricted)
_method c_elementos.new_from_serial( keys, xml_values )

	props << property_list.new()
	
	_for nr, key _over keys.fast_keys_and_elements()
	_loop
		props[key] << xml_values[nr]
	_endloop
	
	_return _clone.init_with( props )
	
_endmethod
$
_pragma(classify_level=restricted, usage={redefinable})
_method c_elementos.nTotal_Elementos
## Objetivo: retornar el valor del slot nTotal_Elementos
## Parámetros de entrada: NA
## Parámetros de salida:  NA
## Regresa:  
## 	Entero - nToTal_Elementos : Numero de elementos
## Fecha de última modificación : 28 / Octubre / 2004
## Autor de la modificación fdiaz
## Descripción de la modificación : Creación
	
	_return .nTotal_Elementos
	
_endmethod
$
_pragma(classify_level=restricted)
_method c_elementos.nTotal_elementos << valor

	.nTotal_elementos << valor
	
_endmethod
$
_pragma(classify_level=restricted, usage={redefinable})
_method c_elementos.oArea << RoArea
## Objetivo: Permite asignar al slot oArea el área a dibujar 
## Parámetros de entrada:
## 	boundig_box - RoVentana : Objeto que representa un área
## Parámetros de salida:   NA
## Regresa:  NA
## Fecha de última modificación : 23 / Diciembre / 2004
## Autor de la modificación fdiaz
## Descripción de la modificación : Se modificó la descripción del objetivo

        .oArea << RoArea
	
_endmethod
$
_pragma(classify_level=restricted, usage={redefinable})
_method c_elementos.obten_elemento(RsNombre)
## Objetivo: Busca y Regresa un elemento grafico por su nombre
## Parámetros de entrada:  
## 	Cadena - RsNombre : Nombre del elemento grafico a buscar
## Parámetros de salida:   
##	c_elemento_grafico : Elemento grafico
## Regresa: 
## 	c_elementos - regresa un objeto c_elemento_grafico
## Fecha de última modificación: 28/10/2004
## Descripción de la modificación: Creación 
	
        >> _self.collElementos[RsNombre]
        
_endmethod
$
_pragma(classify_level=restricted, usage={redefinable})
_method c_elementos.oVentana << RoVentana
## Objetivo: Metodo que permite recibir el canvas "ventana" y asignarlo 
##           al slot oVentana
## Parámetros de entrada:
## 	window - RoVentana : Objeto donde se dibujara
## Parámetros de salida:   NA
## Regresa:  NA
## Fecha de última modificación : 23 / Diciembre / 2004
## Autor de la modificación fdiaz
## Descripción de la modificación : Se modificó la descripción del objetivo

        .oVentana << RoVentana
	
_endmethod
$
_pragma(classify_level=restricted)
_method c_elementos.serial_slots()

	keys << rope.new_with(:nTotal_Elementos,:collElementos,:oArea)
	values << rope.new_with(.nTotal_Elementos,.collElementos,.oArea)

	_return keys, values
	
_endmethod
$
_pragma(classify_level=restricted)
_method c_elementos.serial_structure

	>> :slotted
	
_endmethod
$
