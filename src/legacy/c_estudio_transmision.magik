_pragma(classify_level=advanced, topic={plotting}, usage={subclassable})
_method c_estudio_transmision.post_initialisation ()

## Objetivo: Acciones que se realizan despues de crear la
## instancia 
## Parámetros de entrada: NA
## Parámetros de salida:  NA
## Regresa: NA
## Fecha de última modificación: 04/02/05
## Autor de la modificación : dsanchez
## Descripción de la modificación: Se creo


   _local LoPAF << smallworld_product.pni_application()
   _local LoLYP << LoPAF.plugin(:layout_plugin)	
   _local LoLYD << LoLYP.start_layout_designer()
   _local LoLYM << LoLYD.plugin(:layout_manager)		

        _self.inicializa(coordinate.new(0,0))

        _self.Agrega_LYM(LoLYM)
	LoLYM.current_document.current_page.send_to_back(_self )


# _self.asigna_num_tramo("97", "1")

_endmethod
$

_pragma(classify_level=restricted, usage={redefinable})
_method c_estudio_transmision.inicializa(_optional RoCoord)

## Objetivo: Manda llamar todos los metodos necesarios para
## crear el sello 
## Parámetros de entrada:
##   RoCoord - Coordenada donde debe iniciar a dibujar la tabla	
## Parámetros de salida:  NA
## Regresa: NA
## Fecha de última modificación: 24/02/2005
## Autor de la modificación : dsanchez
## Descripción de la modificación: Se documentó	
	
	# Configuracion del sello transparente
	_self.set_fill_colour(_unset )
	
	#-----------------------------------------------------------
	#Se Inicializa la coordenada de origen
	#-----------------------------------------------------------
	_if RoCoord _is _unset 
	_then
		RoCoord << coordinate.new(0,0)
	_endif

	_self.oCoordOrigen << RoCoord
	
	# se pasa como parametro el layout
	# Crea el objeto que contiene todas las tablas del sello estandar
	_self.oTablas << c_tablas.new(_self)

	#Crea y configura cada una de las tablas 
	_self.prvCreaCfgTablas(RoCoord)

	#Se conoce el area de la tabla dibujada
        LoArea << _self.oTablas.area_total()

	#Se ajustan los limites del layout de acuerdo  a las tablas definidas
	_self.bounds << LoArea

	#Crea a los objetos que tendra c/u de las tablas
	_self.prvCrea_Asigna_Obj_A_Celdas()

	#Indica que los objetos tabla ya fueron creados 
	_self.bTablas_creadas << _true
	
_endmethod
$

_pragma(classify_level=restricted, usage={redefinable})
_private _method c_estudio_transmision.prvCreaCfgTablas(RoCoord)

## Objetivo: Manda llamar lso metodos que crean y configuran
## las tablas que compoenen el sello
## Parámetros de entrada:
##   RoCoord - Coordenada donde debe iniciar a dibujar la tabla	
## Parámetros de salida:  NA
## Regresa: NA
## Fecha de última modificación: 24/02/2005
## Autor de la modificación : dsanchez
## Descripción de la modificación: Se documentó		

	_local LnDesY # Desplazamiento en y de cada una de las secciones
	
	LnDesY << _self.prvCreaCfgTbl_Seccion1(RoCoord)

        LoCoord << coordinate.new(RoCoord.x , RoCoord.y - LnDesY)
	LnDesY << LnDesY + _self.prvCreaCfgTbl_Seccion2(LoCoord)

        LoCoord << coordinate.new(RoCoord.x , RoCoord.y - LnDesY)
	LnDesY << _self.prvCreaCfgTbl_Seccion3(LoCoord)
#
#        LoCoord << coordinate.new(LoCoord.x , LoCoord.y - LnDesY)
#	_self.prvCreaCfgTbl_Seccion4(LoCoord)

_endmethod
$

_pragma(classify_level=restricted, usage={redefinable})
_private _method c_estudio_transmision.PrvCreaCfgTbl_Seccion1(RoCoord)

## Objetivo: Crea y configura las tablas que componen la
## seccion 1
## Parámetros de entrada:
##   RoCoord - Coordenada donde debe iniciar a dibujar la tabla	
## Parámetros de salida:  NA
## Regresa: NA
## Fecha de última modificación: 24/02/2005
## Autor de la modificación : dsanchez
## Descripción de la modificación: Se documentó	
	
	_local LoTabla     # Almacena la tabla con la que se esta trabajado
	_local LnRenglones # Numero de renglones que contendra la tabla 
	_local LnColumnas  # Numero de columnas que contendra la tabla
	_local LnDesX      # Desplazamineto en X de la tabla 
	_local LnDesY      # desplazamiento en Y de la tabla

	#-----------------------------------------------------------
	#Tabla titulo
	#-----------------------------------------------------------
	LnRenglones << 1
	LnColumnas  << 4

	LnDesY << 0
	
	LoTabla << _self.oTablas.crea_tabla(LnRenglones,LnColumnas,:tbl_titulo)

	#Coordenada donde iniciara la tabla
	LoTabla.oCoordenada_Origen << RoCoord

	LoTabla.bDibuja_bordes? << _true
	LoTabla.bDibuja_Columnas_Internas?  << _true
	LoTabla.bDibuja_Renglones_Internos? << _true

	
	#longitudes de los renglones de la tabla, esta dada en mm 
	LoTabla.oRenglones.elemento(1).nLongitud <<  23

	
	LoTabla.oColumnas.elemento(1).nLongitud  <<  30
	LoTabla.oColumnas.elemento(2).nLongitud  <<  93
	LoTabla.oColumnas.elemento(3).nLongitud  << 162 
	LoTabla.oColumnas.elemento(4).nLongitud  <<  85

	# Quita el bolde derecho de la primera celda donde esta el Logo de telmex
	LoCelda << LoTabla.oCeldas.Celda(1,1).oElementos.obten_elemento(:bordes_celda)
	LoCelda.bBorde_der? << _false

        LnDesY << LnDesY + _self.oTablas.Longitud_total_Renglones({:tbl_titulo})

	_return  LnDesY
_endmethod
$

_pragma(classify_level=restricted, usage={redefinable})
_private _method c_estudio_transmision.PrvCreaCfgTbl_Seccion2(RoCoord)

## Objetivo: Crea y configura las tablas que componen la
## seccion 2
## Parámetros de entrada:
##   RoCoord - Coordenada donde debe iniciar a dibujar la tabla	
## Parámetros de salida:  NA
## Regresa: NA
## Fecha de última modificación: 24/02/2005
## Autor de la modificación : dsanchez
## Descripción de la modificación: Se documentó	
	
	_local LoTabla         # Almacena la tabla con la que se esta trabajado
	_local LnRenglones     # Numero de renglones que contendra la tabla 
	_local LnColumnas      # Numero de columnas que contendra la tabla
	_local LnDesX          # Desplazamineto en X de la tabla 
	_local LnDesY          # desplazamiento en Y de la tabla
	_local LnColBordesInf  # Columna donde se presentan los bordes inferiores  

	#-----------------------------------------------------------
	#Tabla encabezado detalle
	#-----------------------------------------------------------
	LnRenglones << 2
	LnColumnas  << 3

        LnDesY << 0
	LnDesX << 0
	
	LoTabla << _self.oTablas.crea_tabla(LnRenglones,LnColumnas,:tbl_encabezado_detalle)

	#Coordenada donde iniciara la tabla
	LoTabla.oCoordenada_Origen << RoCoord

	LoTabla.bDibuja_bordes? << _true
	LoTabla.bDibuja_Columnas_Internas?  << _false
	LoTabla.bDibuja_Renglones_Internos? << _false

	
	#longitudes de los renglones de la tabla, esta dada en mm 
	LoTabla.oRenglones.elemento(1).nLongitud <<  7
	LoTabla.oRenglones.elemento(2).nLongitud <<  7

	
	LoTabla.oColumnas.elemento(1).nLongitud  << 123
	LoTabla.oColumnas.elemento(2).nLongitud  << 162
	LoTabla.oColumnas.elemento(3).nLongitud  <<  85 


	_for LnNumCol  _over range(1,LnColumnas)
	_loop
	   LoCelda << LoTabla.oCeldas.Celda(LnRenglones, LnNumCol).oElementos.
		      obten_elemento(:bordes_celda)
	   LoCelda.bBorde_inf? << _false		
	_endloop

        LnDesY << LnDesY + _self.oTablas.Longitud_total_Renglones({:tbl_encabezado_detalle})

	#-----------------------------------------------------------
	# Tabla long total
	#-----------------------------------------------------------

	LnRenglones << 2
	LnColumnas  << 5

	LoTabla << _self.oTablas.crea_tabla(LnRenglones,LnColumnas,:tbl_long_total)

	#Coordenada donde iniciara la tabla
	LoTabla.oCoordenada_Origen << coordinate.new(RoCoord.x, RoCoord.y - LnDesY)

	LoTabla.bDibuja_bordes? << _false
	LoTabla.bDibuja_Columnas_Internas?  << _false
	LoTabla.bDibuja_Renglones_Internos? << _false

	
	#longitudes de los renglones de la tabla, esta dada en mm 
	LoTabla.oRenglones.elemento(1).nLongitud <<  6 # 30
	LoTabla.oRenglones.elemento(2).nLongitud <<  3 # 30
	
	LoTabla.oColumnas.elemento(1).nLongitud  <<   5
	LoTabla.oColumnas.elemento(2).nLongitud  <<   5
	LoTabla.oColumnas.elemento(3).nLongitud  << 350
	LoTabla.oColumnas.elemento(4).nLongitud  <<   5
	LoTabla.oColumnas.elemento(5).nLongitud  <<   5	

	_for LnPos  _over range(1,LnRenglones)
	_loop
	   LoCelda << LoTabla.oCeldas.Celda(LnPos, 1).oElementos.
		      obten_elemento(:bordes_celda)
	   LoCelda.bBorde_izq? << _true
	   
	   LoCelda << LoTabla.oCeldas.Celda(LnPos, LnColumnas).oElementos.
		      obten_elemento(:bordes_celda)
	   LoCelda.bBorde_der? << _true

	_endloop


	# Activa los borde para que aparente uan linea long total del cable
        LoCelda << LoTabla.oCeldas.Celda(1, 2).oElementos.
	              obten_elemento(:bordes_celda)
        LoCelda.bBorde_inf? << _true
	LoCelda.bBorde_der? << _true			

        LoCelda << LoTabla.oCeldas.Celda(1, 3).oElementos.
	              obten_elemento(:bordes_celda)
        LoCelda.bBorde_inf? << _true
	LoCelda.bBorde_der? << _true			

        LoCelda << LoTabla.oCeldas.Celda(1, 4).oElementos.
	              obten_elemento(:bordes_celda)
        LoCelda.bBorde_inf? << _true

	# configura los bordes del segundo renglon
        LoCelda << LoTabla.oCeldas.Celda(2, 2).oElementos.
	              obten_elemento(:bordes_celda)
	LoCelda.bBorde_der? << _true			

        LoCelda << LoTabla.oCeldas.Celda(2, 3).oElementos.
	              obten_elemento(:bordes_celda)
	LoCelda.bBorde_der? << _true			


	
        LnDesY << LnDesY + _self.oTablas.Longitud_total_Renglones({:tbl_long_total})


	
	#-----------------------------------------------------------
	# Tabla imagen detalle
	#-----------------------------------------------------------

	LnRenglones << 1
	LnColumnas  << 1

	LoTabla << _self.oTablas.crea_tabla(LnRenglones,LnColumnas,:tbl_imagen_detalle)

	#Coordenada donde iniciara la tabla
	LoTabla.oCoordenada_Origen << coordinate.new(RoCoord.x, RoCoord.y - LnDesY)

	LoTabla.bDibuja_bordes? << _false
	LoTabla.bDibuja_Columnas_Internas?  << _false
	LoTabla.bDibuja_Renglones_Internos? << _false

	
	#longitudes de los renglones de la tabla, esta dada en mm 
	LoTabla.oRenglones.elemento(1).nLongitud <<  28 # 30
	
	LoTabla.oColumnas.elemento(1).nLongitud  << 370

	_for LnNumCol  _over range(1,LnColumnas)
	_loop
	   LoCelda << LoTabla.oCeldas.Celda(LnRenglones, LnNumCol).oElementos.
		      obten_elemento(:bordes_celda)
	   LoCelda.bBorde_der? << _true
	   LoCelda.bBorde_izq? << _true			   
	_endloop

        LnDesY << LnDesY + _self.oTablas.Longitud_total_Renglones({:tbl_imagen_detalle})

	#-----------------------------------------------------------
	# Tabla Equipo
	#-----------------------------------------------------------

	LnRenglones << 2
	LnColumnas  << 1

	LoTabla << _self.oTablas.crea_tabla(LnRenglones,LnColumnas,:tbl_equipo)

	#Coordenada donde iniciara la tabla
	LoTabla.oCoordenada_Origen << coordinate.new(RoCoord.x, RoCoord.y - LnDesY)

	LoTabla.bDibuja_bordes? << _false
	LoTabla.bDibuja_Columnas_Internas?  << _false
	LoTabla.bDibuja_Renglones_Internos? << _false 

	
	#longitudes de los renglones de la tabla, esta dada en mm 
	LoTabla.oRenglones.elemento(1).nLongitud <<  13
	LoTabla.oRenglones.elemento(2).nLongitud <<  71
	
	LoTabla.oColumnas.elemento(1).nLongitud  <<  45

	# activa el borde izq para el margen exterior
	_for LnPos  _over range(1,LnRenglones)
	_loop
	   LoCelda << LoTabla.oCeldas.Celda(LnPos, 1).oElementos.
		      obten_elemento(:bordes_celda)
	   LoCelda.bBorde_izq? << _true			   
	_endloop

        LnDesX << LnDesX + _self.oTablas.Longitud_total_Columnas({:tbl_equipo})

	#-----------------------------------------------------------
	# Tabla Potencia
	#-----------------------------------------------------------

	LnRenglones << 12
	LnColumnas  <<  2

	LoTabla << _self.oTablas.crea_tabla(LnRenglones,LnColumnas,:tbl_potencia)

	#Coordenada donde iniciara la tabla
	LoTabla.oCoordenada_Origen << coordinate.new(RoCoord.x + LnDesX, RoCoord.y - LnDesY)

	LoTabla.bDibuja_bordes? << _false
	LoTabla.bDibuja_Columnas_Internas?  << _false
	LoTabla.bDibuja_Renglones_Internos? << _false

	
	#longitudes de los renglones de la tabla, esta dada en mm 
	LoTabla.oRenglones.elemento( 1).nLongitud <<  13
	LoTabla.oRenglones.elemento( 2).nLongitud <<   9
	LoTabla.oRenglones.elemento( 3).nLongitud <<   5
	LoTabla.oRenglones.elemento( 4).nLongitud <<   5
	LoTabla.oRenglones.elemento( 5).nLongitud <<   5
	LoTabla.oRenglones.elemento( 6).nLongitud <<   5
	LoTabla.oRenglones.elemento( 7).nLongitud <<   5
	LoTabla.oRenglones.elemento( 8).nLongitud <<   5
	LoTabla.oRenglones.elemento( 9).nLongitud <<   5
	LoTabla.oRenglones.elemento(10).nLongitud <<   5
	LoTabla.oRenglones.elemento(11).nLongitud <<   5
	LoTabla.oRenglones.elemento(12).nLongitud <<  17 
	
	
	LoTabla.oColumnas.elemento(1).nLongitud  <<  90
	LoTabla.oColumnas.elemento(2).nLongitud  <<  75	

	_self.prvActiva_Borde_Ext_Tbl_Logica(LoTabla, 2, LnRenglones - 1,
	                                     1, LnColumnas)

	LnColBordesInf << 2
	_self.prvActiva_borde_Inf(LoTabla,  2, LnRenglones - 1, LnColBordesInf)

        LnDesX << LnDesX + _self.oTablas.Longitud_total_Columnas({:tbl_potencia})

	#-----------------------------------------------------------
	# Tabla vacia 1
	#-----------------------------------------------------------

	LnRenglones << 1
	LnColumnas  << 1

	LoTabla << _self.oTablas.crea_tabla(LnRenglones,LnColumnas,:tbl_vacia_1)

	#Coordenada donde iniciara la tabla
	LoTabla.oCoordenada_Origen << coordinate.new(RoCoord.x + LnDesX, RoCoord.y - LnDesY)

	LoTabla.bDibuja_bordes? << _false
	LoTabla.bDibuja_Columnas_Internas?  << _false
	LoTabla.bDibuja_Renglones_Internos? << _false

	
	#longitudes de los renglones de la tabla, esta dada en mm 
	LoTabla.oRenglones.elemento( 1).nLongitud <<  84
	
	LoTabla.oColumnas.elemento(1).nLongitud  <<  53

        LnDesX << LnDesX + _self.oTablas.Longitud_total_Columnas({:tbl_vacia_1})
	
	#-----------------------------------------------------------
	# Tabla Empalmes
	#-----------------------------------------------------------

	LnRenglones << 5
	LnColumnas  << 2

	LoTabla << _self.oTablas.crea_tabla(LnRenglones,LnColumnas,:tbl_empalmes)

	#Coordenada donde iniciara la tabla
	LoTabla.oCoordenada_Origen << coordinate.new(RoCoord.x + LnDesX, RoCoord.y - LnDesY)

	LoTabla.bDibuja_bordes? << _false
	LoTabla.bDibuja_Columnas_Internas?  << _false
	LoTabla.bDibuja_Renglones_Internos? << _false

	
	#longitudes de los renglones de la tabla, esta dada en mm
	LoTabla.oRenglones.elemento( 1).nLongitud <<  13
	LoTabla.oRenglones.elemento( 2).nLongitud <<   9
	LoTabla.oRenglones.elemento( 3).nLongitud <<   5
	LoTabla.oRenglones.elemento( 4).nLongitud <<   5
	LoTabla.oRenglones.elemento( 5).nLongitud <<   5
	
	
	LoTabla.oColumnas.elemento(1).nLongitud  <<  40
	LoTabla.oColumnas.elemento(2).nLongitud  <<  40

	_self.prvActiva_Borde_Ext_Tbl_Logica(LoTabla, 2, LnRenglones,
	                                     1, LnColumnas)

	LnColBordesInf << 2
	_self.prvActiva_borde_Inf(LoTabla,  2, LnRenglones - 1, LnColBordesInf)
	
        LnSubDesY << LnDesY + _self.oTablas.Longitud_total_renglones({:tbl_empalmes})
	
	#-----------------------------------------------------------
	# Tabla requiere
	#-----------------------------------------------------------

	LnRenglones << 7
	LnColumnas  << 5

	LoTabla << _self.oTablas.crea_tabla(LnRenglones,LnColumnas,:tbl_requiere)

	#Coordenada donde iniciara la tabla
	LoTabla.oCoordenada_Origen << coordinate.new(RoCoord.x + LnDesX, RoCoord.y - LnSubDesY)

	LoTabla.bDibuja_bordes? << _false
	LoTabla.bDibuja_Columnas_Internas?  << _false
	LoTabla.bDibuja_Renglones_Internos? << _false

	
	#longitudes de los renglones de la tabla, esta dada en mm
	LoTabla.oRenglones.elemento(1).nLongitud <<   5
	LoTabla.oRenglones.elemento(2).nLongitud <<   5
	LoTabla.oRenglones.elemento(3).nLongitud <<   5
	LoTabla.oRenglones.elemento(4).nLongitud <<   5
	LoTabla.oRenglones.elemento(5).nLongitud <<   5
	LoTabla.oRenglones.elemento(6).nLongitud <<   5
	LoTabla.oRenglones.elemento(7).nLongitud <<  17 
	
	
	LoTabla.oColumnas.elemento(1).nLongitud  <<  19
	LoTabla.oColumnas.elemento(2).nLongitud  <<  19
	LoTabla.oColumnas.elemento(3).nLongitud  <<   4
	LoTabla.oColumnas.elemento(4).nLongitud  <<  19
	LoTabla.oColumnas.elemento(5).nLongitud  <<  19


	_self.prvActiva_Borde_Ext_Tbl_Logica(LoTabla, 4, LnRenglones - 1,
	                                     1, LnColumnas)
#	LnRenIniBordesInf << 
#	LnColBordesInf << 2
#	_self.prvActiva_borde_Inf(LoTabla,  2, LnRenglones - 1, LnColBordesInf)
	
        LnDesX << LnDesX + _self.oTablas.Longitud_total_Columnas({:tbl_requiere})
	
	#-----------------------------------------------------------
	# Tabla vacia 2
	#-----------------------------------------------------------

	LnRenglones << 1
	LnColumnas  << 1

	LoTabla << _self.oTablas.crea_tabla(LnRenglones,LnColumnas,:tbl_vacia_2)

	#Coordenada donde iniciara la tabla
	LoTabla.oCoordenada_Origen << coordinate.new(RoCoord.x + LnDesX, RoCoord.y - LnDesY)

	LoTabla.bDibuja_bordes? << _false
	LoTabla.bDibuja_Columnas_Internas?  << _false
	LoTabla.bDibuja_Renglones_Internos? << _false

	
	#longitudes de los renglones de la tabla, esta dada en mm 
	LoTabla.oRenglones.elemento( 1).nLongitud <<  84
	
	LoTabla.oColumnas.elemento(1).nLongitud   <<  27

        LnDesX << LnDesX + _self.oTablas.Longitud_total_Columnas({:tbl_vacia_1})

	# activa el borde der para el margen exterior
	_for LnPos  _over range(1,LnRenglones)
	_loop
	   LoCelda << LoTabla.oCeldas.Celda(LnPos, 1).oElementos.
		      obten_elemento(:bordes_celda)
	   LoCelda.bBorde_der? << _true			   
	_endloop
	
	
        LnDesY << LnDesY + _self.oTablas.Longitud_total_Renglones({:tbl_vacia_2})
	
	_return  LnDesY
	
_endmethod
$


_pragma(classify_level=restricted, usage={redefinable})
_private _method c_estudio_transmision.PrvCreaCfgTbl_Seccion3(RoCoord)

## Objetivo: Crea y configura las tablas que componen la
## seccion 3
## Parámetros de entrada:
##   RoCoord - Coordenada donde debe iniciar a dibujar la tabla	
## Parámetros de salida:  NA
## Regresa: NA
## Fecha de última modificación: 24/02/2005
## Autor de la modificación : dsanchez
## Descripción de la modificación: Se documentó	
	
	_local LoTabla         # Almacena la tabla con la que se esta trabajado
	_local LnRenglones     # Numero de renglones que contendra la tabla 
	_local LnColumnas      # Numero de columnas que contendra la tabla
	_local LnDesX          # Desplazamineto en X de la tabla 
	_local LnDesY          # desplazamiento en Y de la tabla
	_local LnColBordesInf  # Columna donde se presentan los bordes inferiores  

	#-----------------------------------------------------------
	#Tabla VoBo
	#-----------------------------------------------------------
	LnRenglones << 4
	LnColumnas  << 4

        LnDesY << 0
	LnDesX << 0
	
	LoTabla << _self.oTablas.crea_tabla(LnRenglones,LnColumnas,:tbl_VoBo)

	#Coordenada donde iniciara la tabla
	LoTabla.oCoordenada_Origen << RoCoord

	LoTabla.bDibuja_bordes? << false
	LoTabla.bDibuja_Columnas_Internas?  << _false
	LoTabla.bDibuja_Renglones_Internos? << _false

	
	#longitudes de los renglones de la tabla, esta dada en mm 
	LoTabla.oRenglones.elemento(1).nLongitud <<  6
	LoTabla.oRenglones.elemento(2).nLongitud <<  5
	LoTabla.oRenglones.elemento(3).nLongitud <<  5
	LoTabla.oRenglones.elemento(4).nLongitud <<  5	

	
	LoTabla.oColumnas.elemento(1).nLongitud  <<  15
	LoTabla.oColumnas.elemento(2).nLongitud  <<  65
	LoTabla.oColumnas.elemento(3).nLongitud  <<  15
	LoTabla.oColumnas.elemento(4).nLongitud  <<  65 	

	# Activa la tabla logica que representa el Primer VoBo
	LnRenIniTblLogica << 1
	LnRenFinTblLogica << LnRenglones
	LnColIniTblLogica << 1
	LnColFinTblLogica << 2
	_self.prvActiva_Borde_Ext_Tbl_Logica(LoTabla, LnRenIniTblLogica,  LnRenFinTblLogica,
	                                     LnColIniTblLogica, LnColFinTblLogica)
	
	LnRenIniBordesInf << 1
	LnRenFinBordesInf << LnRenglones - 1
	LnColBordesInf    << 2
	_self.prvActiva_borde_Inf(LoTabla,  LnRenIniBordesInf, LnRenFinBordesInf, LnColBordesInf)

	# Activa la tabla logica que representa el Segundo VoBo
	LnRenIniTblLogica << 1
	LnRenFinTblLogica << LnRenglones
	LnColIniTblLogica << 3
	LnColFinTblLogica << 4
	_self.prvActiva_Borde_Ext_Tbl_Logica(LoTabla, LnRenIniTblLogica,  LnRenFinTblLogica,
	                                     LnColIniTblLogica, LnColFinTblLogica)
	
	LnRenIniBordesInf << 1
	LnRenFinBordesInf << LnRenglones - 1
	LnColBordesInf    << 4
	_self.prvActiva_borde_Inf(LoTabla,  LnRenIniBordesInf, LnRenFinBordesInf, LnColBordesInf)
	
	
        LnDesX << LnDesX + _self.oTablas.Longitud_total_Columnas({:tbl_VoBo})

	#-----------------------------------------------------------
	# Tabla observaciones
	#-----------------------------------------------------------

	LnRenglones << 1
	LnColumnas  << 2

	LoTabla << _self.oTablas.crea_tabla(LnRenglones,LnColumnas,:tbl_Observaciones)

	#Coordenada donde iniciara la tabla
	LoTabla.oCoordenada_Origen << coordinate.new(RoCoord.x + LnDesX, RoCoord.y)

	LoTabla.bDibuja_bordes? << _true
	LoTabla.bDibuja_Columnas_Internas?  << _false
	LoTabla.bDibuja_Renglones_Internos? << _false

	
	#longitudes de los renglones de la tabla, esta dada en mm 
	LoTabla.oRenglones.elemento(1).nLongitud <<   6
	
	LoTabla.oColumnas.elemento(1).nLongitud  <<  35
	LoTabla.oColumnas.elemento(2).nLongitud  << 175	


        LnDesY << LnDesY + _self.oTablas.Longitud_total_Renglones({:tbl_Observaciones})

	#-----------------------------------------------------------
	# Tabla mas observaciones
	#-----------------------------------------------------------

	LnRenglones << 3
	LnColumnas  << 1

	LoTabla << _self.oTablas.crea_tabla(LnRenglones,LnColumnas,:tbl_mas_observaciones)

	#Coordenada donde iniciara la tabla
	LoTabla.oCoordenada_Origen << coordinate.new(RoCoord.x + LnDesX, RoCoord.y - LnDesY)

#	LoTabla.bDibuja_bordes? << _false
#	LoTabla.bDibuja_Columnas_Internas?  << _false
#	LoTabla.bDibuja_Renglones_Internos? << _false 

	
	#longitudes de los renglones de la tabla, esta dada en mm 
	LoTabla.oRenglones.elemento(1).nLongitud <<   5
	LoTabla.oRenglones.elemento(2).nLongitud <<   5
	LoTabla.oRenglones.elemento(3).nLongitud <<   5	
	
	LoTabla.oColumnas.elemento(1).nLongitud  << 210

        LnDesY << LnDesY + _self.oTablas.Longitud_total_Columnas({:tbl_mas_observaciones})

_endmethod 

