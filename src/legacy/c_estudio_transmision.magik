_pragma(classify_level=restricted, usage={redefinable})
_method c_estudio_transmision.prvCrea_Asigna_Obj_A_Celdas_Seccion1()

## Objetivo: Crea y asigna los objetos a las celdas de las
## tablas de la seccion 1
## Parámetros de entrada: NA
## Parámetros de salida:  NA
## Regresa: NA
## Fecha de última modificación: 24/02/2005
## Autor de la modificación : dsanchez
## Descripción de la modificación: Se documentó	

	_local LoNum # Numero de renglon
	_local LoTxt # texto del renglon
	_local LoTxt2 # texto del renglon
	_local LoTxt3 # texto del renglon		
	_local LsCad # almacena el texto que desplegara el renglon
	_local LcollCadenas # Almacena las cadenas que debera desplegar el ren 4 y ren 8
	

	#-----------------------------------------------------------
	#Tabla Titulo
	#-----------------------------------------------------------

	_local LoLogo   # Almacena el logo de telmex
	_local LoLbl    # Almacena Telefonos de Mexico
	_local LoLbl1   # Almacena las etiquetas de la tabla
	_local LoLbl2   # Almacena las etiquetas de la tabla
	
	#se crean los objetos que almacenara la tabla
	LoLogo  << c_simbolo_grafico.new("LOGO_telmex_1")


	#se crean los objetos que almacenara la tabla
	LoLbl  << c_texto_grafico.new("TELEFONOS DE MEXICO")
	LoLbl.nTamanio << 55

	LoLbl1  << c_texto_grafico.new_from(LoLbl, "ESTUDIO DE TRANSMISION F.O.")
	LoLbl2  << c_texto_grafico.new_from(LoLbl, "EST. NO. 1")
	
	
	#asigna los objetos creados a su correspondiente celda
	_self.oTablas.elemento(:tbl_Titulo).oCeldas.Celda(1,1).oElemento << LoLogo
	_self.oTablas.elemento(:tbl_Titulo).oCeldas.Celda(1,2).oElemento << LoLbl
	_self.oTablas.elemento(:tbl_Titulo).oCeldas.Celda(1,3).oElemento << LoLbl1
	_self.oTablas.elemento(:tbl_Titulo).oCeldas.Celda(1,4).oElemento << LoLbl2
	
_endmethod
$

_pragma(classify_level=restricted, usage={redefinable})
_method c_estudio_transmision.prvCrea_Asigna_Obj_A_Celdas_Seccion2()

## Objetivo: Crea y asigna los objetos a las celdas de las
## tablas de la seccion 2
## Parámetros de entrada: NA
## Parámetros de salida:  NA
## Regresa: NA
## Fecha de última modificación: 24/02/2005
## Autor de la modificación : dsanchez
## Descripción de la modificación: Se documentó	


	#-----------------------------------------------------------
	#Tabla Encabezado detalle
	#-----------------------------------------------------------

	_local LoLbl    # Almacena Telefonos de Mexico
	_local LoLbl1   # Almacena las etiquetas de la tabla
	_local LoLbl2   # Almacena las etiquetas de la tabla
	_local LoLbl3   # Almacena las etiquetas de la tabla	
	
	#se crean los objetos que almacenara la tabla
	LoLbl  << c_texto_grafico.new("TIPO DE CABLE 24 F.O.")
	LoLbl.nTamanio << 35

	LoLbl1  << c_texto_grafico.new_from(LoLbl, "TM-13 DISPERSION NO CERO (LEAF)")

	LoLbl2  << c_texto_grafico.new_from(LoLbl, "ENLACE.- ROSARIO DE ARRIBA - GUERRERO NEGRO")
	LoLbl2.nTamanio << 45
	
	LoLbl3 << c_texto_grafico.new_from(LoLbl, "TRAMO REP. PUNTA PRIETA - GUERRERO NEGRO (GNE)")
	LoLbl3.nTamanio << 55
	
	#asigna los objetos creados a su correspondiente celda
	_self.oTablas.elemento(:tbl_encabezado_detalle).oCeldas.Celda(1,1).oElemento << LoLbl
	_self.oTablas.elemento(:tbl_encabezado_detalle).oCeldas.Celda(2,1).oElemento << LoLbl1
	_self.oTablas.elemento(:tbl_encabezado_detalle).oCeldas.Celda(1,2).oElemento << LoLbl2
	_self.oTablas.elemento(:tbl_encabezado_detalle).oCeldas.Celda(2,2).oElemento << LoLbl3

	#-----------------------------------------------------------
	#Tabla long total
	#-----------------------------------------------------------

	#se crean los objetos que almacenara la tabla
	LoLbl  << c_texto_grafico.new("LONG. TOTAL DEL CABLE 24 F.O. = ")
	LoLbl.nTamanio << 35

	#asigna los objetos creados a su correspondiente celda
	_self.oTablas.elemento(:tbl_long_total).oCeldas.Celda(1,3).oElemento << LoLbl
	
	#-----------------------------------------------------------
	# Tabla imagen detalle
	#-----------------------------------------------------------

        #  Objeto texto grafico normal
	#	LoTramo  << c_tramo_fo_grafico.new("97","1")
	#	LoTramo.nMargen_izq << 5
	#	LoTramo.nMargen_der << 5	
	
	LoTramo  << c_texto_grafico.new("Aqui va la imagen de la ruta")
	LoTramo.nTamanio << 35

	_self.oTablas.elemento(:tbl_imagen_detalle).oCeldas.Celda(1,1).oElemento << LoTramo
	
	#-----------------------------------------------------------
	# Tabla Equipo
	#-----------------------------------------------------------

	LoLbl  << c_texto_grafico.new("EQUIPO-")
	LoLbl.nTamanio << 35
	LoLbl.sAlineacion << :centre_left

	_self.oTablas.elemento(:tbl_equipo).oCeldas.Celda(1,1).oElemento << LoLbl

	#-----------------------------------------------------------
	# Tabla Potencia
	#-----------------------------------------------------------

	#se crean los objetos que almacenara la tabla
	LoLbl  << c_texto_grafico.new("POTENCIA DE SALIDA DEL EMISOR")
	LoLbl.nTamanio << 35
	LoLbl.sAlineacion << :centre_left

	LoLbl1  << c_texto_grafico.new_from(LoLbl, "SENSIBILIDAD DEL RECEPTOR")
	LoLbl2  << c_texto_grafico.new_from(LoLbl, "MAXIMA POTENCIA DE ENTRADA PERMISIBLE")
	LoLbl3  << c_texto_grafico.new_from(LoLbl, "ATENUACION PERMISIBLE EN EL CABLE")
	LoLbl4  << c_texto_grafico.new_from(LoLbl, "ATENUACION EN LA FIBRA")
	LoLbl5  << c_texto_grafico.new_from(LoLbl, "PERDIDA POR EMPALMES")
	LoLbl6  << c_texto_grafico.new_from(LoLbl, "PERDIDA POR  CONECTORES")
	LoLbl7  << c_texto_grafico.new_from(LoLbl, "MARGEN DE RES. PARA MANTENIMIENTO")
	LoLbl8  << c_texto_grafico.new_from(LoLbl, "ATENUACION TOTAL")
	LoLbl9  << c_texto_grafico.new_from(LoLbl, "MARGEN RESERVA ADICIONAL")

	_self.oTablas.elemento(:tbl_potencia).oCeldas.Celda( 2,1).oElemento << LoLbl
	_self.oTablas.elemento(:tbl_potencia).oCeldas.Celda( 3,1).oElemento << LoLbl1
	_self.oTablas.elemento(:tbl_potencia).oCeldas.Celda( 4,1).oElemento << LoLbl2
	_self.oTablas.elemento(:tbl_potencia).oCeldas.Celda( 5,1).oElemento << LoLbl3
	_self.oTablas.elemento(:tbl_potencia).oCeldas.Celda( 6,1).oElemento << LoLbl4
	_self.oTablas.elemento(:tbl_potencia).oCeldas.Celda( 7,1).oElemento << LoLbl5
	_self.oTablas.elemento(:tbl_potencia).oCeldas.Celda( 8,1).oElemento << LoLbl6
	_self.oTablas.elemento(:tbl_potencia).oCeldas.Celda( 9,1).oElemento << LoLbl7
	_self.oTablas.elemento(:tbl_potencia).oCeldas.Celda(10,1).oElemento << LoLbl8
	_self.oTablas.elemento(:tbl_potencia).oCeldas.Celda(11,1).oElemento << LoLbl9	

	LoCapTxt << c_Captura_Texto.new("1")
	LoCapTxt.nTamanio << 4
	LoCapTxt.sAlineacion << :centre_left

	LoCapTxt1  << c_Captura_Texto.new_from(LoCapTxt,"2")
	LoCapTxt2  << c_Captura_Texto.new_from(LoCapTxt,"3")
	LoCapTxt3  << c_Captura_Texto.new_from(LoCapTxt,"33 DB")
	LoCapTxt4  << c_Captura_Texto.new_from(LoCapTxt,"0.25 DB X 123.79 KM 30.95 DB")
	LoCapTxt5  << c_Captura_Texto.new_from(LoCapTxt,"0.20 DB X 22 EMP 4.40 DB")
	LoCapTxt6  << c_Captura_Texto.new_from(LoCapTxt,"0.80 DB X 4 CONECTORES 2.56 DB")
	LoCapTxt7  << c_Captura_Texto.new_from(LoCapTxt,"3 DB")
	LoCapTxt8  << c_Captura_Texto.new_from(LoCapTxt,"37.91 DB")
	LoCapTxt9  << c_Captura_Texto.new_from(LoCapTxt,"DB")	

	_self.oTablas.elemento(:tbl_potencia).oCeldas.Celda( 2,2).oElemento << LoCapTxt
	_self.oTablas.elemento(:tbl_potencia).oCeldas.Celda( 3,2).oElemento << LoCapTxt1
	_self.oTablas.elemento(:tbl_potencia).oCeldas.Celda( 4,2).oElemento << LoCapTxt2
	_self.oTablas.elemento(:tbl_potencia).oCeldas.Celda( 5,2).oElemento << LoCapTxt3
	_self.oTablas.elemento(:tbl_potencia).oCeldas.Celda( 6,2).oElemento << LoCapTxt4
	_self.oTablas.elemento(:tbl_potencia).oCeldas.Celda( 7,2).oElemento << LoCapTxt5
	_self.oTablas.elemento(:tbl_potencia).oCeldas.Celda( 8,2).oElemento << LoCapTxt6
	_self.oTablas.elemento(:tbl_potencia).oCeldas.Celda( 9,2).oElemento << LoCapTxt7
	_self.oTablas.elemento(:tbl_potencia).oCeldas.Celda(10,2).oElemento << LoCapTxt8
	_self.oTablas.elemento(:tbl_potencia).oCeldas.Celda(11,2).oElemento << LoCapTxt9

	#-----------------------------------------------------------
	# Tabla Empalmes
	#-----------------------------------------------------------

	#se crean los objetos que almacenara la tabla
	LoLbl  << c_texto_grafico.new("NO. EMPALMES")
	LoLbl.nTamanio << 35
	LoLbl.sAlineacion << :centre_left

	LoLbl1  << c_texto_grafico.new_from(LoLbl, "NO. CONECTORES")
	LoLbl2  << c_texto_grafico.new_from(LoLbl, "CONFIGURACION")
	LoLbl3  << c_texto_grafico.new_from(LoLbl, "AUMENTO")

	_self.oTablas.elemento(:tbl_Empalmes).oCeldas.Celda( 2,1).oElemento << LoLbl
	_self.oTablas.elemento(:tbl_Empalmes).oCeldas.Celda( 3,1).oElemento << LoLbl1
	_self.oTablas.elemento(:tbl_Empalmes).oCeldas.Celda( 4,1).oElemento << LoLbl2
	_self.oTablas.elemento(:tbl_Empalmes).oCeldas.Celda( 5,1).oElemento << LoLbl3


	LoCapTxt << c_Captura_Texto.new("22")
	LoCapTxt.nTamanio << 4
	LoCapTxt.sAlineacion << :centre_left

	LoCapTxt1  << c_Captura_Texto.new_from(LoCapTxt,"4")
	LoCapTxt2  << c_Captura_Texto.new_from(LoCapTxt,"-")
	LoCapTxt3  << c_Captura_Texto.new_from(LoCapTxt,"-")

	_self.oTablas.elemento(:tbl_Empalmes).oCeldas.Celda( 2,2).oElemento << LoCapTxt
	_self.oTablas.elemento(:tbl_Empalmes).oCeldas.Celda( 3,2).oElemento << LoCapTxt1
	_self.oTablas.elemento(:tbl_Empalmes).oCeldas.Celda( 4,2).oElemento << LoCapTxt2
	_self.oTablas.elemento(:tbl_Empalmes).oCeldas.Celda( 5,2).oElemento << LoCapTxt3

	#-----------------------------------------------------------
	# Tabla requiere
	#-----------------------------------------------------------	

	#se crean los objetos que almacenara la tabla
	LoLbl  << c_texto_grafico.new("REQUIERE ATENUADOR")
	LoLbl.nTamanio << 35
	LoLbl.sAlineacion << :centre_centre

	LoLbl1  << c_texto_grafico.new_from(LoLbl, "SI")
	LoLbl2  << c_texto_grafico.new_from(LoLbl, "NO")
	LoLbl3  << c_texto_grafico.new_from(LoLbl, "VALOR MINIMO")

	_self.oTablas.elemento(:tbl_requiere).oCeldas.Celda( 4,3).oElemento << LoLbl
	_self.oTablas.elemento(:tbl_requiere).oCeldas.Celda( 5,1).oElemento << LoLbl1
	_self.oTablas.elemento(:tbl_requiere).oCeldas.Celda( 5,4).oElemento << LoLbl2
	_self.oTablas.elemento(:tbl_requiere).oCeldas.Celda( 6,2).oElemento << LoLbl3


	LoCapTxt << c_Captura_Texto.new("(   )")
	LoCapTxt.nTamanio << 4
	LoCapTxt.sAlineacion << :centre_left

	LoCapTxt1  << c_Captura_Texto.new_from(LoCapTxt,"(  )")
	LoCapTxt2  << c_Captura_Texto.new_from(LoCapTxt,"0")

	_self.oTablas.elemento(:tbl_requiere).oCeldas.Celda( 5,2).oElemento << LoCapTxt
	_self.oTablas.elemento(:tbl_requiere).oCeldas.Celda( 5,5).oElemento << LoCapTxt1
	_self.oTablas.elemento(:tbl_requiere).oCeldas.Celda( 6,4).oElemento << LoCapTxt2

	
_endmethod
$

_pragma(classify_level=restricted, usage={redefinable})
_method c_estudio_transmision.prvCrea_Asigna_Obj_A_Celdas_Seccion3()

## Objetivo: Crea y asigna los objetos a las celdas de las
## tablas de la seccion 3
## Parámetros de entrada: NA
## Parámetros de salida:  NA
## Regresa: NA
## Fecha de última modificación: 04/04/05
## Autor de la modificación : dsanchez
## Descripción de la modificación: Se creo


	#-----------------------------------------------------------
	#Tabla VoBo
	#-----------------------------------------------------------

	_local LoLbl    # Almacena Telefonos de Mexico
	_local LoLbl1   # Almacena las etiquetas de la tabla
	_local LoLbl2   # Almacena las etiquetas de la tabla
	_local LoLbl3   # Almacena las etiquetas de la tabla	
	
	#se crean los objetos que almacenara la tabla de la PRIMER VoBo
	LoLbl  << c_texto_grafico.new("VO.BO.")
	LoLbl.nTamanio << 35
	LoLbl.sAlineacion << :centre_left

	LoLbl1  << c_texto_grafico.new_from(LoLbl, "NOMBRE")
	LoLbl2  << c_texto_grafico.new_from(LoLbl, "FIRMA")
	LoLbl3 << c_texto_grafico.new_from(LoLbl, "FECHA")
	
	#asigna los objetos creados a su correspondiente celda
	_self.oTablas.elemento(:tbl_VoBo).oCeldas.Celda(1,1).oElemento << LoLbl
	_self.oTablas.elemento(:tbl_VoBo).oCeldas.Celda(2,1).oElemento << LoLbl1
	_self.oTablas.elemento(:tbl_VoBo).oCeldas.Celda(3,1).oElemento << LoLbl2
	_self.oTablas.elemento(:tbl_VoBo).oCeldas.Celda(4,1).oElemento << LoLbl3

	LoCapTxt << c_Captura_Texto.new("")
	LoCapTxt.nTamanio << 4
	LoCapTxt.sAlineacion << :centre_left

	LoCapTxt1  << c_Captura_Texto.new_from(LoCapTxt)
	LoCapTxt2  << c_Captura_Texto.new_from(LoCapTxt)
	LoCapTxt3  << c_Captura_Texto.new_from(LoCapTxt)

	_self.oTablas.elemento(:tbl_VoBo).oCeldas.Celda( 1,2).oElemento << LoCapTxt
	_self.oTablas.elemento(:tbl_VoBo).oCeldas.Celda( 2,2).oElemento << LoCapTxt1
	_self.oTablas.elemento(:tbl_VoBo).oCeldas.Celda( 3,2).oElemento << LoCapTxt2
	_self.oTablas.elemento(:tbl_VoBo).oCeldas.Celda( 4,2).oElemento << LoCapTxt3	

	#se crean los objetos que almacenara la tabla de la SEGUNDO VoBo
	LoLbl  << c_texto_grafico.new("VO.BO.")
	LoLbl.nTamanio << 35
	LoLbl.sAlineacion << :centre_left	

	LoLbl1  << c_texto_grafico.new_from(LoLbl, "NOMBRE")
	LoLbl2  << c_texto_grafico.new_from(LoLbl, "FIRMA")
	LoLbl3 << c_texto_grafico.new_from(LoLbl, "FECHA")
	
	#asigna los objetos creados a su correspondiente celda
	_self.oTablas.elemento(:tbl_VoBo).oCeldas.Celda(1,3).oElemento << LoLbl
	_self.oTablas.elemento(:tbl_VoBo).oCeldas.Celda(2,3).oElemento << LoLbl1
	_self.oTablas.elemento(:tbl_VoBo).oCeldas.Celda(3,3).oElemento << LoLbl2
	_self.oTablas.elemento(:tbl_VoBo).oCeldas.Celda(4,3).oElemento << LoLbl3

	LoCapTxt << c_Captura_Texto.new("")
	LoCapTxt.nTamanio << 4
	LoCapTxt.sAlineacion << :centre_left

	LoCapTxt1  << c_Captura_Texto.new_from(LoCapTxt)
	LoCapTxt2  << c_Captura_Texto.new_from(LoCapTxt)
	LoCapTxt3  << c_Captura_Texto.new_from(LoCapTxt)

	_self.oTablas.elemento(:tbl_VoBo).oCeldas.Celda( 1,4).oElemento << LoCapTxt
	_self.oTablas.elemento(:tbl_VoBo).oCeldas.Celda( 2,4).oElemento << LoCapTxt1
	_self.oTablas.elemento(:tbl_VoBo).oCeldas.Celda( 3,4).oElemento << LoCapTxt2
	_self.oTablas.elemento(:tbl_VoBo).oCeldas.Celda( 4,4).oElemento << LoCapTxt3	
	
	#-----------------------------------------------------------
	# Tabla observaciones
	#-----------------------------------------------------------

	#se crean los objetos que almacenara la tabla de la PRIMER VoBo
	LoLbl  << c_texto_grafico.new("OBSERVACIONES : ")
	LoLbl.nTamanio << 35
	LoLbl.sAlineacion << :centre_left

	#asigna los objetos creados a su correspondiente celda
	_self.oTablas.elemento(:tbl_Observaciones).oCeldas.Celda(1,1).oElemento << LoLbl


	LoCapTxt << c_Captura_Texto.new("")
	LoCapTxt.nTamanio << 4
	LoCapTxt.sAlineacion << :centre_left

	_self.oTablas.elemento(:tbl_Observaciones).oCeldas.Celda( 1,2).oElemento << LoCapTxt

	#-----------------------------------------------------------
	# Tabla mas observaciones
	#-----------------------------------------------------------

	LoCapTxt << c_Captura_Texto.new("")
	LoCapTxt.nTamanio << 4
	LoCapTxt.sAlineacion << :centre_left

	LoCapTxt1  << c_Captura_Texto.new_from(LoCapTxt)
	LoCapTxt2  << c_Captura_Texto.new_from(LoCapTxt)
	
	_self.oTablas.elemento(:tbl_mas_Observaciones).oCeldas.Celda( 1,1).oElemento << LoCapTxt
	_self.oTablas.elemento(:tbl_mas_Observaciones).oCeldas.Celda( 2,1).oElemento << LoCapTxt1
	_self.oTablas.elemento(:tbl_mas_Observaciones).oCeldas.Celda( 3,1).oElemento << LoCapTxt2

	
_endmethod 

_pragma(classify_level=restricted, usage={redefinable})
_method c_estudio_transmision.prvActiva_Borde_Ext_Tbl_Logica(RoTabla, RnRenIni, RnRenFin,
			                                     RnColIni, RnColFin)
## Objetivo: Activar los bordes de una tabla fisica para
## aparentar una tabla logica
## Parámetros de entrada:
##   c_tabla - RoTabla: Tabla fisica de la cual se desea
##               aparentar una tabla logica.
##   entero - RnRenIni: Numero de renglon de la tabla fisica
##               donde inciara a dibujar la tabla logica
##   entero - RnRenFin: Numero de renglon de la tabla fisica
##               donde terminara a dibujar la tabla logica
##   entero - RnColIni: Numero de columna de la tabla fisica
##               donde inciara a dibujar la tabla logica
##   entero - RnColFin: Numero de columna de la tabla fisica
##               donde terminara a dibujar la tabla logica	
## Parámetros de salida:  NA
## Regresa: NA
## Fecha de última modificación: 03/04/2005
## Autor de la modificación : dsanchez
## Descripción de la modificación: Se documentó
##  04/04/05 DSB Se puso un ciclo para las columnas	

	# Activar el borde exterior de la sub tabla (dentro de la tabla
	# fisica hay una tabla logica)
	# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - 

	# activacion de los bordes verticales de la segunda columna renglones interiores
	_for LnPos  _over range(RnRenIni, RnRenFin)
	_loop
	   LoCelda << RoTabla.oCeldas.Celda(LnPos,RnColIni).oElementos.
		      obten_elemento(:bordes_celda)
	   LoCelda.bBorde_izq? << _true

   	   LoCelda << RoTabla.oCeldas.Celda(LnPos,RnColFin).oElementos.
		      obten_elemento(:bordes_celda)
	   LoCelda.bBorde_der? << _true
	_endloop


	_for LnPos  _over range(RnColIni, RnColFin) 
	_loop
	   # activacion de los bordes horizontales SUPERIORES
           LoCelda << RoTabla.oCeldas.Celda(RnRenIni,LnPos).oElementos.
	                 obten_elemento(:bordes_celda)
           LoCelda.bBorde_Sup? << _true	   

	   
  	   # activacion de los bordes horizontales INFERIORES
           LoCelda << RoTabla.oCeldas.Celda(RnRenFin, LnPos).oElementos.
	                 obten_elemento(:bordes_celda)
           LoCelda.bBorde_inf? << _true	   
		
	_endloop

_endmethod
$

_pragma(classify_level=restricted, usage={redefinable})
_method c_estudio_transmision.prvActiva_borde_Inf(RoTabla,
						  RnRenIni, RnRenFin,
				  		  RnCol
			      )

	# Activar el borde inferior de los renglones interiores de la
	# tabla logica
	# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - 

	_for LnNumRen  _over range(RnRenIni,RnRenFin)
	_loop
	   # activacion de borde inferior de la  columna 2	   
	   LoCelda << RoTabla.oCeldas.Celda(LnNumRen, RnCol).oElementos.
		      obten_elemento(:bordes_celda)	   
	   LoCelda.bBorde_inf? << _true
	   
	_endloop
	
	
_endmethod
$

_pragma(classify_level=restricted, usage={redefinable})
_method c_estudio_transmision.asigna_num_tramo(PsCve_Ruta, PsCve_tramo)
   
   
	## 
	##

	_if _self.oTramo_fo = _unset 
	_then
	   _self.oTramo_fo << c_Tramo_fo_e.new()	
	   
	_endif

	_self.oTramo_fo.asigna_num_tramo(PsCve_Ruta, PsCve_tramo)
	
	_self.prvAsigna_txt_enlace()
	_self.prvAsigna_txt_tramo()
	_self.prvAsigna_txt_Num_empalmes()
	_self.prvAsigna_txt_Long_total_cable()

	_self.prvAsigna_tramo_a_celda()
	
_endmethod
$

_pragma(classify_level=restricted, usage={redefinable})
_private _method c_estudio_transmision.prvAsigna_txt_Enlace()

## Objetivo: Asignar el texto que debe llevar el renglon 2
## Parámetros de entrada: NA
## Parámetros de salida:  NA
## Regresa: NA
## Fecha de última modificación: 02/03/2005
## Autor de la modificación : dsanchez
## Descripción de la modificación: Se documentó	

	
     _Local LsTxt # texto que debe tener la cadena

     LsTxt << "ENLACE.- " +  _self.oTramo_fo.nombre_ruta

     _self.oTablas.elemento(:tbl_encabezado_detalle).oCeldas.Celda(1,2).oElemento.sTexto << LsTxt

_endmethod
$

