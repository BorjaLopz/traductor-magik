_pragma(classify_level=restricted, usage={redefinable})
_private _method c_estudio_transmision.prvAsigna_txt_Long_total_cable()

## Objetivo: Asignar el texto que debe llevar el renglon 2
## Parámetros de entrada: NA
## Parámetros de salida:  NA
## Regresa: NA
## Fecha de última modificación: 02/03/2005
## Autor de la modificación : dsanchez
## Descripción de la modificación: Se documentó	

	
     _Local LsTxt # texto que debe tener la cadena

     LsTxt << "LONG. TOTAL DEL CABLE 24 F.O. = " +  _self.oTramo_fo.long_tramo.write_string + " MTS. "

     _self.oTablas.elemento(:tbl_long_total).oCeldas.Celda(1,3).oElemento.sTexto << LsTxt

_endmethod
$

_pragma(classify_level=restricted, usage={redefinable})
_private _method c_estudio_transmision.prvAsigna_tramo_a_celda()

## Objetivo: Asignar el texto que debe llevar el renglon 2
## Parámetros de entrada: NA
## Parámetros de salida:  NA
## Regresa: NA
## Fecha de última modificación: 02/03/2005
## Autor de la modificación : dsanchez
## Descripción de la modificación: Se documentó	
##  12/04/05 DSB Se valido que existan los elementos para poder dibujarse


   _if _self.oTramo_fo.obten_elementos_tramo.size > 1
   _then 
      LoTramo  << c_tramo_fo_grafico.new( _self.oTramo_fo.sNum_Ruta,
					    _self.oTramo_fo.sNum_Tramo,
					    "ET"
				       )
      LoTramo.nMargen_izq << 5
      LoTramo.nMargen_der << 5	

     _self.oTablas.elemento(:tbl_imagen_detalle).oCeldas.Celda(1,1).oElemento << LoTramo
   _else 
      
	LoTramo  << c_texto_grafico.new("No hay información")
	LoTramo.nTamanio << 35

	_self.oTablas.elemento(:tbl_imagen_detalle).oCeldas.Celda(1,1).oElemento << LoTramo

   _endif

_endmethod
$
