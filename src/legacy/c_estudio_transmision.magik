_package user
#remex(:c_estudio_transmision)
$
def_slotted_exemplar(:c_estudio_transmision,
                    {
		       {:oTablas,         _unset}, # almacena las tablas que compoenen el sello
		       {:oCoordOrigen ,   _unset}, # Coord donde inicia el sello
	    	       {:oWindow,         _unset}, # canvas en el que se desplegara el sello
	     	       {:bTablas_Creadas, _false}, # Indica si las tablas ya fueron creadas
		       {:nAncho_Sello,      180 }, # ancho en mm del sello
		       {:oTramo_fo,       _unset}  # Trae los datos del tramo 
		     },
		      :layout_element 
)
$
c_estudio_transmision.define_shared_constant(:allowed_on_menu?, _false, :public)
$
c_estudio_transmision.define_slot_access(:oCoordOrigen,    :writable, :public)
c_estudio_transmision.define_slot_access(:oTablas,         :writable, :public)
c_estudio_transmision.define_slot_access(:bTablas_creadas, :writable, :public)
c_estudio_transmision.define_slot_access(:oWindow,         :writable, :public)
c_estudio_transmision.define_slot_access(:nAncho_Sello,    :writable, :private)
c_estudio_transmision.define_slot_access(:oTramo_fo,       :writable, :private)
$

_pragma(classify_level=restricted, usage={redefinable})
