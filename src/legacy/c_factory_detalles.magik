_package user
$
def_slotted_exemplar(:c_factory_detalles,{
		       {:oEngine, _unset, :writable,:private}, #Engine para la ruta
		        {:oCable, _unset, :writable,:public},  #Cable
		       {:oPafManager, _unset, :writable,:private} #Application manager
                     },:c_factory_planos)
$
_pragma(classify_level=restricted, usage={redefinable})
_private _method c_factory_detalles.init(PoEngine)
## Metodo para inicializar la instancia
##
    .oEngine      << PoEngine
    .oPafManager  << smallworld_product.pni_application().manager
    _return _self 
	
_endmethod
$
_pragma(classify_level=restricted, usage={redefinable})
_method c_factory_detalles.new(_optional PoEngine)
## Metodo para crear un _clone de _self
##	
    _return _clone.init(PoEngine)
	
_endmethod
