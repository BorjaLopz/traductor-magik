_package user 
$
#remex(:c_factory_planos)
$

def_slotted_exemplar(:c_factory_planos,{
		       {:oPage, _unset , :writable, :private}, # Pagina del Layout
		       {:oViewMapperPlugin, _unset ,:writable,:private} # Plugin del layout
		       
                     })

$
_pragma(classify_level=restricted, usage={redefinable})
_method c_factory_planos.new()
## Metodo para crear un _clone de _self
##
    _return _clone.init()
	
_endmethod
$
_pragma(classify_level=restricted, usage={redefinable})
_private _method c_factory_planos.init()
## Metodo para inicializar la instancia
##
    _return _self 
	
_endmethod
$
_pragma(classify_level=restricted, usage={redefinable})
_method c_factory_planos.inicia_layout()
## Objetivo: Iniciar el Layout Designer
## Parametros de Entrada: Ninguno
## Regresa: LoPage << Pagina del documento
##          LoViewMapperPlugin << plugin del viewport 	
## Fecha de Ultima modificacion:18/08/2008
## Autor de la modificacion: rraragon
## Descripcion de la modificacion: Metodo nuevo 

_local LoLayoutPlugin
_local LoLayoutDesigner
_local LoLayoutManager
_local LoViewMapperPlugin
_local LoDoc
_local LoPage

        LoLayoutPlugin    << smallworld_product.pni_application().plugin(:layout_plugin)
	LoLayoutDesigner  << LoLayoutPlugin.start_layout_designer()
	LoLayoutManager   << LoLayoutDesigner.plugin(:layout_manager)
	LoViewMapperPlugin<<LoLayoutDesigner.plugin(:viewport_mapper)


	LoDoc  << LoLayoutManager.current_document
	LoPage << LoLayoutManager.current_page

	# INICIO DEL CAMBIO
	# (14/11/11 bflores) : 
	#
	_if LoPage.empty?.not  
	_then
		#w("ya existe.")
		condition.raise(:user_error,:string, "El diseñador de planos ya tiene uno activo." + %newline +
				"Favor de cerrarlo antes de generar otro plano. ")
	_endif

	#
	# FIN DEL CAMBIO	

	#Configurar Pagina 84 cm (Ancho) X 124 cm (Largo)
	LoPage.set_paper_size(12400,8400)

	>>(LoPage,LoViewMapperPlugin)
	
	
_endmethod
$
_pragma(classify_level=restricted, usage={redefinable})
_method c_factory_planos.GetMapView(PoGeom)
## Objetivo: Obtener el map_view para la(s) geometrias
## Parametros de Entrada: PoGeom << Geometrias	
## Regresa: LoMapView << map_view
## Fecha de Ultima modificacion:18/08/2008
## Autor de la modificacion: rraragon
## Descripcion de la modificacion: Metodo nuevo 
	
_local LoMapView
_local LoMapPlugin

        LoMapPlugin<<smallworld_product.pni_application().plugin(:map_plugin)
	_if PoGeom _isnt _unset 
	_then
		LoMapView<<LoMapPlugin.current_map_view
		LoMapView.goto(PoGeom)
		LoMapView<<LoMapPlugin.current_map_view
	_else
		LoMapView<<LoMapPlugin.current_map_view
	_endif
	>>LoMapView

	
_endmethod
$
_pragma(classify_level=restricted, usage={redefinable})
_method c_factory_planos.genera_plano()
## Objetivo: Generar un plano, este metodo se debe subclasear
## si se desean agregar acciones extras al generar un plano
## Parametros de Entrada: Ninguno.
## Regresa: Ninguno
## Fecha de Ultima modificacion:18/08/2008
## Autor de la modificacion: rraragon
## Descripcion de la modificacion: Metodo nuevo 


    (.oPage,.oViewMapperPlugin) <<_self.inicia_layout()
    _self.AddElementos_comunes()

_endmethod
$
_pragma(classify_level=restricted, usage={redefinable})
_method c_factory_planos.AddElementos_comunes()
## Objetivo: Agregar los objetos comunes para los planos
## Parametros de Entrada: Ninguno.
## Regresa: Ninguno
## Fecha de Ultima modificacion:18/08/2008
## Autor de la modificacion: rraragon
## Descripcion de la modificacion: Metodo nuevo 

    _if .oPage _isnt _unset 
    _then
	LoMarco << _self.AddMarco()
	_self.AddTitulo(LoMarco)
	_self.AddSellos()

    _endif

_endmethod
$
_pragma(classify_level=restricted, usage={redefinable})
_method c_factory_planos.AddMarco()
## Objetivo: Agregar el marco a la pagina del Layout
## Parametros de Entrada: Ninguno.
## Regresa: Lomarco << c_marco
## Fecha de Ultima modificacion:18/08/2008
## Autor de la modificacion: rraragon
## Descripcion de la modificacion: Metodo nuevo 

    LoMarco << c_marco.new_with(:bounds,bounding_box.new(0, 0, 1, 1))
    LoMarco.Largo << 6
    LoMarco.Alto << 3
    LoMarco.set_fill_colour(_unset)
    .oPage.add_element(LoMarco)	
    _return LoMarco
    
    
_endmethod
$
_pragma(classify_level=restricted, usage={redefinable})
_method c_factory_planos.AddTitulo(PoMarco)
## Objetivo: Agregar el titulo al plano
## Parametros de Entrada: Ninguno.
## Regresa: Ninguno
## Fecha de Ultima modificacion:18/08/2008
## Autor de la modificacion: rraragon
## Descripcion de la modificacion: Metodo nuevo 

    LoTitulo << _self.crea_titulo
    
    LoBB << bounding_box.new(PoMarco.bounds.xmax-2200,
			     PoMarco.bounds.ymin+200,
			     PoMarco.bounds.xmax-200,
			     PoMarco.bounds.ymin+600)
    
    LoTitulo << c_titulo_de_plano.new_with(:bounds,           LoBB,
					   :font_name,        "bold",
					   :font_size,        8,
					   :fill_style,       _unset,
					   :outline_style,    _unset,
					   :text,             LoTitulo,
					   :wrap,             _false,
					   :align_horizontal, :centre,
					   :align_vertical,   :centre,
					   :orientation,      :left_right)
    
    .oPage.add_element(LoTitulo)	

	
_endmethod
$
_pragma(classify_level=restricted, usage={redefinable})
_method c_factory_planos.AddSellos()
## Objetivo: Agregar los sellos comunes a los plano
## Parametros de Entrada: Ninguno.
## Regresa: Ninguno
## Fecha de Ultima modificacion:18/08/2008
## Autor de la modificacion: rraragon
## Descripcion de la modificacion: Metodo nuevo 

	LoSello << c_sello_ruta_cables_fo.new_with(:bounds,bounding_box.new(450,400,2100,3000 ))
	.oPage.add_element(LoSello)
	LoGenSellos << c_generador_sellos.obten_instancia()
	LoGenSellos.genera_sello(.oPage,c_sello_estandar_base_fo, bounding_box.new(285,400,2100,3000 ))
	LoGenSellos.genera_sello(.oPage,c_notas_constructor, bounding_box.new(450,400,2100,5000 ))
    	
_endmethod
$
_pragma(classify_level=restricted, usage={redefinable})
_method c_factory_planos.crea_titulo
## Objetivo: Regresar la cadena que ira en el titulo del plano,
## este metodo se puede subclasear para cada tipo de plano
## Parametros de Entrada: Ninguno.
## Regresa: Ninguno
## Fecha de Ultima modificacion:18/08/2008
## Autor de la modificacion: rraragon
## Descripcion de la modificacion: Metodo nuevo 
	
	_return "Titulo"
	
_endmethod
$


_pragma(classify_level=restricted, usage={redefinable})
_method c_factory_planos.asigna_pagina_y_viewport(Popagina,Poviewport)
	## se crea este metodo para poder hacer dinamica la asignacion
	## de la pagina desde cualquier otra clase.
	## 
	.oPage << Popagina
	.oViewMapperPlugin << Poviewport
_endmethod
$
