_pragma(classify_level=restricted)
_method c_geom_set_layout.agrega_nombre_plano(LoMarco)
	## Agrega nombre del plano.
	
	_if _self.sTipoPlano = "PLANO_DE_RUTA"
	_then
                LoTitulo << _self.layout_page.all_elements_of(c_titulo_de_plano).an_element()
                _if LoTitulo _is _unset
                _then
                        LoTitulo << c_titulo_de_plano.new_with(:bounds,bounding_box.new(0, 0, 2000, 1000),
                                                               :font_name,        "bold",
                                                               :font_size,        12,
                                                               :fill_style,       _unset,
                                                               :outline_style,    _unset,
                                                               :text,             _self.sNombrePlano,
                                                               :wrap,             _false,
                                                               :align_horizontal, :centre,
                                                               :align_vertical,   :centre,
                                                               :orientation,      :left_right)
                        _self.layout_page.add_element(LoTitulo)
                _endif
                LoTitulo.oBoundContenedor << bounding_box.new(LoMarco.bounds.xmin + 50,
						              LoMarco.bounds.ymin + 50,
						              LoMarco.bounds.xmax,
						              LoMarco.bounds.ymax)
	_elif _self.sTipoPlano = "Plano_desmontaje_CD"
	_then
                LoTitulo << _self.layout_page.all_elements_of(textbox_layout).an_element()
		_if LoTitulo _is _unset
		_then
			LoTitulo << textbox_layout.new_with(:align_horizontal, :centre,
                                                            :align_vertical,   :centre,
                                                            :angle,            90,
                                                            :bounds,           bounding_box.new(600, 400, 100, 300),
                                                            :fill_style,       _unset,
                                                            :font_name,        "bold",
                                                            :font_orientation, :vertical,
                                                            :font_size,        3,
                                                            :orientation,      :vertical,
                                                            :outline_style,     _unset,
                                                            :text,             _self.sNombrePlano,
                                                            :wrap,             _false)
                        _self.layout_page.add_element(LoTitulo)
                _endif
	_else
                LoTitulo << _self.layout_page.all_elements_of(c_titulo_de_plano).an_element()
                _if LoTitulo _is _unset
                _then
                        LoTitulo << c_titulo_de_plano.new_with(:bounds,           bounding_box.new(0, 0, 3000, 1400),
                                                               :font_name,        "bold",
                                                               :font_size,        12,
                                                               :fill_style,       _unset,
                                                               :outline_style,    _unset,
                                                               :text,             _self.sNombrePlano,
                                                               :wrap,             _false,
                                                               :align_horizontal, :centre,
                                                               :align_vertical,   :centre,
                                                               :orientation,      :left_right)
                        _self.layout_page.add_element(LoTitulo)
                _endif
                LoTitulo.oBoundContenedor << bounding_box.new(LoMarco.bounds.xmin + 50,
						              LoMarco.bounds.ymin + 50,
						              LoMarco.bounds.xmax,
						              LoMarco.bounds.ymax)
	_endif

_endmethod
$
_pragma(classify_level=restricted, usage={redefinable})
_method c_geom_set_layout.defined_attributes
# Objetivo: Definir los atributos de la clase que seran
#           visualizados en el cuadro de dialogo de las propiedades de
#           la clase.
# Parametros de Entrada: Ninguno.
# Parametros de Salida: Ninguno
# Regresa: La definicio de los atributos.
#   attribs: Definicion de los atributos.
# Fecha de ultima modificacion: 18/Ene./2005.
# Autor de la modificacion: rbsaldan.
# Descripcion de la modificacion: Metodo Nuevo.
#
# Fecha de ultima modificacion: 10/Feb./2005.
# Autor de la modificacion: rbsaldan.
# Descripcion de la modificacion: Documentacion.

_local LcollAtributos  ## Contiene los atributos de la clase c_geom_set_layout.
	LcollAtributos << rope.new_from(_super.defined_attributes)

	LcollAtributos.add ( _self.viewport_attribute_definition )

	## Propiedad que define el angulo del estilo.
	LcollAtributos.add ( layout_attribute_definition.new(:nIdRegistro, :integer,
							     :description, "Identificador del Objeto",
							     :default_value, 0,
							     :allowed_on_properties_page?, _false,
							     :editor, _unset))
	LcollAtributos.add ( layout_attribute_definition.new(:sIdRegistro, :string,
							     :description, "Identificadores de objetos",
							     :default_value, 0,
							     :allowed_on_properties_page?, _false,
							     :editor, _unset))
	LcollAtributos.add ( layout_attribute_definition.new(:sNombreAce, :string,
							     :description, "Nombre del Ace",
							     :default_value, 0,
							     :allowed_on_properties_page?, _false,
							     :editor, _unset))
# Autor:                          vnguzman
# ID de requerimiento:            
# Fecha de modificación:          Jueves 25 de Mayo de 2006
# Descripción de la modificación: Agrego una o
#	LcollAtributos.add ( layout_attribute_definition.new(:sNombrePlan , :string,
	LcollAtributos.add ( layout_attribute_definition.new(:sNombrePlano , :string,
# Fin de la modificación							     
							     :description, "Nombre del Plano",
							     :default_value, 0,
							     :allowed_on_properties_page?, _false,
							     :editor, _unset))
	LcollAtributos.add ( layout_attribute_definition.new(:nMargenVp, :integer,
							     :description, "Margen del Viewport",
							     :default_value, 0,
							     :allowed_on_properties_page?, _false,
							     :editor, _unset))
	LcollAtributos.add ( layout_attribute_definition.new(:modulos_ancho, :integer,
							     :description, "Modulos Ancho",
							     :default_value, 1,
							     :allowed_on_properties_page?, _false,
							     :editor, _unset))
	LcollAtributos.add ( layout_attribute_definition.new(:modulos_alto, :string,
							     :description, "Modulos Alto",
							     :default_value, 1,
							     :allowed_on_properties_page?, _false,
							     :editor, _unset))
	LcollAtributos.add ( layout_attribute_definition.new(:bIndicadores, :boolean,
							     :description, "Indicadores de pozo",
							     :default_value, _false,
							     :allowed_on_properties_page?, _false,
							     :editor, _unset))
	LcollAtributos.add ( layout_attribute_definition.new(:bInventaDto, :boolean,
							     :description, "Inventario distrito",
							     :default_value, _false,
							     :allowed_on_properties_page?, _false,
							     :editor, _unset))
	LcollAtributos.add ( layout_attribute_definition.new(:sIdProyecto, :string,
							     :description, "Identificador del proyecto.",
							     :default_value, _false,
							     :allowed_on_properties_page?, _false,
							     :editor, _unset))
	LcollAtributos.add ( layout_attribute_definition.new(:sTipoPlano, :string,
							      :description, "Tipo de Plano",
							      :default_value, "",
							      :allowed_on_properties_page?, _true,
							      :editor, _unset))
	>> LcollAtributos
_endmethod
