def_slotted_exemplar(:c_geom_set_layout,
                     {
			     {:oApp, _unset, :readable, :public},
			     {:oAppLayoutDesigner, _unset, :writable, :public},
			     {:oRegistro, _unset, :writable, :public}
		     },{:layout_element, :viewport_layout_mixin})
