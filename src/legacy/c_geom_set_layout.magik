_pragma(classify_level=restricted)
_method c_geom_set_layout.depends_on?(another)
# Objetivo: Indica si hay dependencia entre el c_geom_set_layout y another.
# Parametros de Entrada:
#     another: Cualquier objeto.
# Parametros de Salida: Ninguno
# Regresa: _false o _true
# Fecha de ultima modificacion: 18/Ene./2005
# Autor de la modificacion: rbsaldan
# Descripcion de la modificacion: Metodo Nuevo.
#
# Fecha de ultima modificacion: 10/Feb./2005
# Autor de la modificacion: rbsaldan
# Descripcion de la modificacion: Documentacion.
	
	>> _super(viewport_layout_mixin).depends_on?(another)
_endmethod
$
_pragma(classify_level=restricted)
_method c_geom_set_layout.dibuja_linea_entre_pozos()
# Objetivo: Define la coordenadas de una linea y el texto que
#           sebe ser colocado  entres dos pozos seleccionados en una
#           pagina (en la aplicacion layout_designer).
# Parametros de Entrada: Ninguno.
# Parametros de Salida: Ninguno.
# Regresa: Ninguno.
# Fecha de ultima modificacion: 18/Ene./2005
# Autor de la modificacion: rbsaldan
# Descripcion de la modificacion: Metodo nuevo.
#
# Fecha de ultima modificacion: 10/Feb./2005
# Autor de la modificacion: rbsaldan
# Descripcion de la modificacion: Documentacion.
	
_local LcollSeleccion ## Seleccion actual en Layout Designer.
_local LcollPozos     ## Arreglo de pozos.
_local LcollCoords    ## Coordenadas de la linea que une a los pozos
#_local LoElem        ## Referencia a un objeto de una pagina de Layout Designer
_local LoTexto        ## Texto


        # Verificar si hay un objeto seleccionado en la pagina.
	LcollSeleccion << .oAppLayoutDesigner.plugin(:layout_manager).current_layout_view.current_selection
	_if LcollSeleccion _is _unset 
	_then
		write("Debe haber una seleccion.")
		_return 
	_endif

	# Extraer los objetos que representan un apuntador al pozo.
	LcollPozos << rope.new()
	_for LoElem _over LcollSeleccion.fast_elements()
	_loop
		_if LoElem.responds_to?(:LoObjRel) _andif LoElem.LoObjRel _isnt _unset
		_then
			LcollPozos.add(LoElem)
		_endif
	_endloop
	## Verificar que el numero de objetos seleccionados en la
	## pagina sean dos.
	_if LcollPozos.size = 2
	_then
		## Ordenar las coordenadas con respecto la coordenada X
		LcollCoords << sorted_collection.new()
		LcollCoords.order_proc << _proc (c1, c2)
				       _return c1.x _cf c2.x
				     _endproc
		_for LoElemPozo _over LcollPozos.fast_elements()
		_loop
			LcollCoords.add(LoElemPozo.bounds.centre)
		_endloop

		## Si las coordenadas coinciden en su valor X, entonces se toma
		## encuenta el valor del Y.
		_if LcollCoords[1].x.rounded = LcollCoords[2].x.rounded
		_then
			_if  LcollCoords[1].x > _self.layout_page.bounds.centre.x
			_then
				_if LcollCoords[1].y < LcollCoords[2].y
				_then
					LcollCoords << LcollCoords.reversed()
				_endif
			_else
				_if LcollCoords[1].y > LcollCoords[2].y
				_then
					LcollCoords << LcollCoords.reversed()
				_endif
			_endif
		_endif

		# Definir el texto que debe llevar la linea (es la diferencia
		# del km. topografico).
		LoTexto << (LcollPozos[1].LoObjRel.user!_km_topo.default(0.0) -
			    LcollPozos[2].LoObjRel.user!_km_topo.default(0.0)).abs.write_string
		LcollPozos[1].agrega_linea(LcollCoords, _self.layout_page, LoTexto)
	_else
		write("Debe seleccionar dos indicadores del pozo.")
	_endif
_endmethod
$
_pragma(classify_level=restricted)
_method c_geom_set_layout.distritos_afectados()
	
	texto << ""
	
	_for i _over glorutaopb.mit_terminal_enclosures.fast_elements()
	_loop
		_if texto <> ""
		_then
			texto << texto + ", "
		_endif
		
		texto << texto + i.user!_nombre_distrito
	_endloop
	
	texto << "Distritos afectados: " + texto 
	
	LoTitulo << textbox_layout.new_with(:bounds, bounding_box.new(1280, 620, 2920, 1420),
					    :text,   texto)
	
	_self.layout_page.add_element(LoTitulo)
	
_endmethod
$
