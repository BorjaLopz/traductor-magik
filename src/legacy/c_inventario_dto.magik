_pragma(classify_level=restricted, usage={redefinable})
_private _method c_inventario_dto.AsignaCelda(RoTabla, RoRenglon ,RcollValores, RnTotal_Elementos)

## Objetivo: Asignar los valores de una coleccion a un renglon determinado
## Parámetros de entrada:
##      RoTabla - Tabla a la cual se le asignara los valores
##      RoRenglon - numero del renglon en el cual se insertaran los valores
## 	RcollValores - Valores que van en el renglon
##      RnTotal_elementos - numero de elementos que se asignaran de la coleccion
## Parámetros de salida: NA
## Regresa: NA
## Fecha de última modificación: 24/02/2005
## Autor de la modificación : dsanchez
## Descripción de la modificación: Se documento

	
        _for LnCont  _over range(1,RnTotal_Elementos ) 
	_loop
		_self.AsignaCelda2(RoTabla,RoRenglon, LnCont+1, RcollValores[LnCont]) 
	_endloop
	
_endmethod
$
_pragma(classify_level=restricted, usage={redefinable})
_private _method c_inventario_dto.AsignaCelda2(RoTabla, RoRenglon, RoColumna ,RoValor)

## Objetivo: Asigna un valor a una celda determinada por renglon y columna, de la tabla RoTabla
##
## Parámetros de entrada:
## 	RoTabla - Nombre de la tabla en la que se desea asignar un valor
##      RoRenglon, RoColumna - Numero del renglon y de la columna donse se insertara
##                el valor
##      RoValor - Valor que se insertara en la celda 
## Parámetros de salida: NA
## Regresa: NA
## Fecha de última modificación: 24/02/2005
## Autor de la modificación : dsanchez
## Descripción de la modificación: Se documento
	
   # si no existe el objeto que almacenara los datos lo crea		
   _if _self.oTablas.elemento(RoTabla.as_symbol()).oCeldas.Celda(RoRenglon,RoColumna).oElemento _is unset
   _then
      _local LoDato  # Objeto de texto para asignar texto a una celda			
      
      LoDato  << c_texto_grafico.new(RoValor.write_string)
      LoDato.nTamanio << 25
      _self.oTablas.elemento(RoTabla.as_symbol()).oCeldas.Celda(RoRenglon,RoColumna).oElemento << LoDato
   _else
      _self.oTablas.elemento(RoTabla.as_symbol()).oCeldas.Celda(RoRenglon,RoColumna).oElemento.sTexto << RoValor.write_string
   _endif	  
	
_endmethod
$

_pragma(classify_level=restricted, usage={redefinable})
_method c_inventario_dto.collAumento_Sec << RsValor

