_pragma(classify_level=restricted, usage={redefinable})
_private _method c_inventario_dto.prvAsigna_Viv_Loc << PcollsValor

## Objetivo: Se muestran los datos de vivienda localidad
## Parámetros de entrada:  
##    coleccion - PcollsValor : Coleccion que contiene los elementos a mostrar
## Parámetros de salida:   NA
## Regresa: NA
## Fecha de última modificación: 3/Marzo/2005
## Autor de la modificación : dsanchez
## Descripción de la modificación: Se documentó

	_if  PcollsValor.size <= 11 
	_then
		_local LnRenglon   # Contador de renglones
		LnRenglon << 1
	
		#Se obtienen cada uno de los datos y se imprimen	
		_for LsValor  _over  PcollsValor.fast_elements()
		_loop
			_self.oTablas.elemento(:tbl_Resultados).oCeldas.Celda( LnRenglon,2).oElemento.stexto << LsValor
			
			LnRenglon << LnRenglon + 1
		_endloop
	_else
		condition.raise(:warning, :string, "El numero de datos Viv_Loc en la tabla Tbl_Resultados debe ser maximo de 11 elementos.")
		
	_endif
	
_endmethod
$

_pragma(classify_level=restricted, usage={redefinable})
_private _method c_inventario_dto.prvAsigna_Lineas << PcollsValor

## Objetivo: Se muestran los datos de lineas
## Parámetros de entrada:  
##    coleccion - PcollsValor : Coleccion que contiene los elementos a mostrar
## Parámetros de salida:   NA
## Regresa: NA
## Fecha de última modificación: 3/Marzo/2005
## Autor de la modificación : dsanchez
## Descripción de la modificación: Se documentó

	_if  PcollsValor.size <= 11 
	_then
		_local LnRenglon   # Contador de renglones
		LnRenglon << 1
	
		#Se obtienen cada uno de los datos y se imprimen	
		_for LsValor  _over  PcollsValor.fast_elements()
		_loop
			_self.oTablas.elemento(:tbl_Resultados).oCeldas.Celda( LnRenglon,3).oElemento.stexto << LsValor
			
			LnRenglon << LnRenglon + 1
		_endloop
	_else
		condition.raise(:warning, :string, "El numero de datos Viv_Loc en la tabla Tbl_Resultados debe ser maximo de 11 elementos.")
		
	_endif
	
_endmethod


