_pragma(classify_level=restricted, usage={redefinable})
_method c_inventario_dto.prvOrdena_DeAcuerdo_Sello(Rcoll)

## Objetivo: Permite ordenar los elementos de acuerdo al sello
## Parámetros de entrada:  
##    coleccion - Rcoll : Coleccion que contiene los elementos
## Parámetros de salida:   NA
## Regresa: 
##    rope - Lista ordenada de elementos
## Fecha de última modificación: 3/Marzo/2005
## Autor de la modificación : dsanchez
## Descripción de la modificación: Se documentó

   _local LcollOrdenada   # Coleccion de datos a ordenar
	
   LcollOrdenada << rope.new()

   LcollOrdenada.add(Rcoll[:|RESIDENCIAL A|].write_string)
   LcollOrdenada.add(Rcoll[:|RESIDENCIAL B|].write_string)
   LcollOrdenada.add(Rcoll[:|RESIDENCIAL C|].write_string)
   LcollOrdenada.add(Rcoll[:|RESIDENCIAL D|].write_string)
   LcollOrdenada.add(Rcoll[:|RESIDENCIAL E|].write_string)
   LcollOrdenada.add(Rcoll[:|COMERCIAL 1ª.|].write_string)
   LcollOrdenada.add(Rcoll[:|COMERCIAL 2ª.|].write_string)
   LcollOrdenada.add(Rcoll[:|COMERCIAL 3ª.|].write_string)
   LcollOrdenada.add(Rcoll[:|INDUSTRIAL PESADA|].write_string)
   LcollOrdenada.add(Rcoll[:|INDUSTRIAL MEDIANA|].write_string)
   LcollOrdenada.add(Rcoll[:|INDUSTRIAL LIGERA|].write_string)
  
   _return LcollOrdenada
   
_endmethod
