_pragma(classify_level=restricted, usage={redefinable})
_method c_inventario_dto.collTotal << RcollValores

## Objetivo: Asigna los valores al renglon (3) de la tabla
## totales. El renglon de total
## Parámetros de entrada:
## 	RcollValores - Valores que van en el renglon
## Parámetros de salida: NA
## Regresa: NA
## Fecha de última modificación: 24/02/2005
## Autor de la modificación : dsanchez
## Descripción de la modificación: Se documentó	

	_if RcollValores.size = 5
	_then
	   _self.AsignaCelda2(:tbl_Totales,  3, 2 ,RcollValores[1])
	   _self.AsignaCelda2(:tbl_Totales,  3, 3 ,RcollValores[2])
	   _self.AsignaCelda2(:tbl_Totales,  3, 4 ,RcollValores[3])
	   _self.AsignaCelda2(:tbl_Totales,  3, 5 ,RcollValores[4])
	   _self.AsignaCelda2(:tbl_Totales,  3, 6 ,RcollValores[5])	   
	_else	
	   condition.raise(:warning, :string, "El número de totales debe ser de cinco.")
	_endif

	
_endmethod
$

_pragma(classify_level=restricted, usage={redefinable})
_method c_inventario_dto.Siglas_CtlDto << RsValor

## Objetivo: Asigna La clave de la central y dto a la tabla
## Parámetros de entrada:
## 	RsValor - Valor que va en el renglon
## Parámetros de salida: NA
## Regresa: NA
## Fecha de última modificación: 23/03/2005
## Autor de la modificación : dsanchez
## Descripción de la modificación: Se documentó	

	_self.sSiglas_Central_Distrito << RsValor	

	
        _self.AsignaCelda2(:tbl_Titulo, 1, 1,_self.sSiglas_Central_Distrito)

        _self.oDto << c_distrito_e.new()
	_self.oDto.distrito << _self.sSiglas_Central_Distrito
	
        #write(_self.oDto.numero_viviendas_NSE.p)
_endmethod
$


