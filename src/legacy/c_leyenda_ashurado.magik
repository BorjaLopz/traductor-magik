_pragma(classify_level=restricted)
_method c_leyenda_ashurado.construir_arco(PnRadio,PoCentro,PnAngIni,PnAngFin)
	## 
	##  
	Lcollsector<<sector.new()
	_for LnAng _over PnAngIni.upto(PnAngFin)
	_loop 
		LnX << PoCentro.x+PnRadio * cos(LnAng.degrees_to_radians) 
		LnY << PoCentro.y+PnRadio * sin(LnAng.degrees_to_radians)	  
		Lcollsector.add(coordinate(LnX,LnY))	  
	_endloop
	_return  Lcollsector
_endmethod
$



_pragma(classify_level=restricted)
_method c_leyenda_ashurado.construir_leyenda(window)
	## 
	##

_local LcollSectores<<sector_rope.new()
_local PoSecRop 
_local Lcollsector
_local LoBound

      cordy << 0 
      _for cont _over 1.upto(3) 
      _loop
	      cordy << cordy + 250
	      _self.bounds << bounding_box.new(8000,
					       2000-cordy,
					       8000,
					       2000-cordy)
	      
	      # Linea Horizontal abajo
	      PoSecRop << sector_rope.new()
	      Lcollsector<<sector.new()
	      Lcollsector.add(coordinate(_self.bounds.centre.x,_self.bounds.centre.y))
	      Lcollsector.add(Lcollsector.last_coord+coordinate(150,0))
	      PoSecRop.add(Lcollsector)
	      
	      # Linea vertical derecha
	      Lcollsector<<sector.new()
	      Lcollsector.add(coordinate(_self.bounds.centre.x+150,_self.bounds.centre.y+150))
	      Lcollsector.add(Lcollsector.last_coord-coordinate(0,150))
	      PoSecRop.add(Lcollsector)
	      
	      # Linea vertical Izquierda
	      Lcollsector<<sector.new()
	      Lcollsector.add(coordinate(_self.bounds.centre.x,_self.bounds.centre.y))
	      Lcollsector.add(Lcollsector.last_coord+coordinate(0,150))
	      PoSecRop.add(Lcollsector)
	      
	      # Linea horizontal arriba
	      Lcollsector<<sector.new()
	      Lcollsector.add(coordinate(_self.bounds.centre.x,_self.bounds.centre.y+150))
	      Lcollsector.add(Lcollsector.last_coord+coordinate(150,0))
	      PoSecRop.add(Lcollsector)
	      
	      PoSecRop.draw_on(window,line_style.new(colour.called(:black),3))
	      
	      ######################################################################################################
	      # diagonal derecha
	      _if cont = 1 _or cont = 2
	      _then
		      PoSecRop << sector_rope.new()
		      
		      Lcollsector << sector.new()
		      Lcollsector.add(coordinate(_self.bounds.centre.x,_self.bounds.centre.y))
		      Lcollsector.add(Lcollsector.last_coord+coordinate(150,150))
		      PoSecRop.add(Lcollsector)
		      
		      Lcollsector << sector.new()
		      Lcollsector.add(coordinate(_self.bounds.centre.x+25,_self.bounds.centre.y))
		      Lcollsector.add(Lcollsector.last_coord+coordinate(125,125))
		      PoSecRop.add(Lcollsector)
		      
		      Lcollsector<<sector.new()
		      Lcollsector.add(coordinate(_self.bounds.centre.x+50,_self.bounds.centre.y))
		      Lcollsector.add(Lcollsector.last_coord+coordinate(100,100))
		      PoSecRop.add(Lcollsector)
		      
		      Lcollsector<<sector.new()
		      Lcollsector.add(coordinate(_self.bounds.centre.x+75,_self.bounds.centre.y))
		      Lcollsector.add(Lcollsector.last_coord+coordinate(75,75))
		      PoSecRop.add(Lcollsector)
		      
		      Lcollsector<<sector.new()
		      Lcollsector.add(coordinate(_self.bounds.centre.x+100,_self.bounds.centre.y))
		      Lcollsector.add(Lcollsector.last_coord+coordinate(50,50))
		      PoSecRop.add(Lcollsector)

		      Lcollsector<<sector.new()
		      Lcollsector.add(coordinate(_self.bounds.centre.x+125,_self.bounds.centre.y))
		      Lcollsector.add(Lcollsector.last_coord+coordinate(25,25))
		      PoSecRop.add(Lcollsector)
		      
		      Lcollsector<<sector.new()
		      Lcollsector.add(coordinate(_self.bounds.centre.x,_self.bounds.centre.y+25))
		      Lcollsector.add(Lcollsector.last_coord+coordinate(125,125))
		      PoSecRop.add(Lcollsector)
		      
		      Lcollsector<<sector.new()
		      Lcollsector.add(coordinate(_self.bounds.centre.x,_self.bounds.centre.y+50))
		      Lcollsector.add(Lcollsector.last_coord+coordinate(100,100))
		      PoSecRop.add(Lcollsector)
		      
		      Lcollsector<<sector.new()
		      Lcollsector.add(coordinate(_self.bounds.centre.x,_self.bounds.centre.y+75))
		      Lcollsector.add(Lcollsector.last_coord+coordinate(75,75))
		      PoSecRop.add(Lcollsector)
		      
		      Lcollsector<<sector.new()
		      Lcollsector.add(coordinate(_self.bounds.centre.x,_self.bounds.centre.y+100))
		      Lcollsector.add(Lcollsector.last_coord+coordinate(50,50))
		      PoSecRop.add(Lcollsector)

		      Lcollsector<<sector.new()
		      Lcollsector.add(coordinate(_self.bounds.centre.x,_self.bounds.centre.y+125))
		      Lcollsector.add(Lcollsector.last_coord+coordinate(25,25))
		      PoSecRop.add(Lcollsector)
		      
		      PoSecRop.draw_on(window,line_style.new(colour.called(:red),2))
		      
	      _endif 
		      #################################################################################################################
	      
	      # diagonal izquierda
	      _if cont = 1 _or cont = 3
	      _then
		      PoSecRop << sector_rope.new()
		      Lcollsector<<sector.new()
		      Lcollsector.add(coordinate(_self.bounds.centre.x,_self.bounds.centre.y+150))
		      Lcollsector.add(Lcollsector.last_coord+coordinate(150,-150))
		      PoSecRop.add(Lcollsector)
		      
		      Lcollsector<<sector.new()
		      Lcollsector.add(coordinate(_self.bounds.centre.x,_self.bounds.centre.y+125))
		      Lcollsector.add(Lcollsector.last_coord+coordinate(125,-125))
		      PoSecRop.add(Lcollsector)
		      
		      Lcollsector<<sector.new()
		      Lcollsector.add(coordinate(_self.bounds.centre.x,_self.bounds.centre.y+100))
		      Lcollsector.add(Lcollsector.last_coord+coordinate(100,-100))
		      PoSecRop.add(Lcollsector)
		      
		      Lcollsector<<sector.new()
		      Lcollsector.add(coordinate(_self.bounds.centre.x,_self.bounds.centre.y+75))
		      Lcollsector.add(Lcollsector.last_coord+coordinate(75,-75))
		      PoSecRop.add(Lcollsector)
		      
		      Lcollsector<<sector.new()
		      Lcollsector.add(coordinate(_self.bounds.centre.x,_self.bounds.centre.y+50))
		      Lcollsector.add(Lcollsector.last_coord+coordinate(50,-50))
		      PoSecRop.add(Lcollsector)

		      Lcollsector<<sector.new()
		      Lcollsector.add(coordinate(_self.bounds.centre.x,_self.bounds.centre.y+25))
		      Lcollsector.add(Lcollsector.last_coord+coordinate(25,-25))
		      PoSecRop.add(Lcollsector)
       
		      Lcollsector<<sector.new()
		      Lcollsector.add(coordinate(_self.bounds.centre.x+25,_self.bounds.centre.y+150))
		      Lcollsector.add(Lcollsector.last_coord+coordinate(125,-125))
		      PoSecRop.add(Lcollsector)
		      
		      Lcollsector<<sector.new()
		      Lcollsector.add(coordinate(_self.bounds.centre.x+50,_self.bounds.centre.y+150))
		      Lcollsector.add(Lcollsector.last_coord+coordinate(100,-100))
		      PoSecRop.add(Lcollsector)
		      
		      Lcollsector<<sector.new()
		      Lcollsector.add(coordinate(_self.bounds.centre.x+75,_self.bounds.centre.y+150))
		      Lcollsector.add(Lcollsector.last_coord+coordinate(75,-75))
		      PoSecRop.add(Lcollsector)
	      
		      Lcollsector<<sector.new()
		      Lcollsector.add(coordinate(_self.bounds.centre.x+100,_self.bounds.centre.y+150))
		      Lcollsector.add(Lcollsector.last_coord+coordinate(50,-50))
		      PoSecRop.add(Lcollsector)

		      Lcollsector<<sector.new()
		      Lcollsector.add(coordinate(_self.bounds.centre.x+125,_self.bounds.centre.y+150))
		      Lcollsector.add(Lcollsector.last_coord+coordinate(25,-25))
		      PoSecRop.add(Lcollsector)
		      
		      PoSecRop.draw_on(window,line_style.new(colour.called(:green),2))
	      _endif 
      _endloop    
       	
_endmethod
$
_pragma(classify_level=restricted)
_method c_leyenda_ashurado.draw_content_on(window)
	## 
	##

	_self.construir_leyenda(window) 

_endmethod 
$
