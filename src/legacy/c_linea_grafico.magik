_package user
$
def_slotted_exemplar(:c_linea_grafico,
		     {

         	         {:oCoordenadaMin,  _unset}, # Desplazamineto en X y Y en el punto minimo
         	         {:oCoordenadaMax,  _unset}, # Desplazamiento en X y Y en el punto maximo
			 {:sColor,          _unset }
			 
		     },
		     :c_elemento_grafico
)
$
c_linea_grafico.define_slot_access(:oCoordenadaMax,              :writable, :private)
$
c_linea_grafico.define_slot_access(:oCoordenadaMin,              :writable, :private)
$
c_linea_grafico.define_slot_access(:sColor,                      :writable, :private)
$
_method c_linea_grafico.Color
## Objetivo: Obteiene el color de la linea
## Parámetros de entrada: NA
## Parámetros de salida:  NA
## Regresa:  NA
## Fecha de última modificación : 28 / Octubre / 2004
## Autor de la modificación fdiaz
## Descripción de la modificación : Creación
##    


	_return _self.sColor
	
_endmethod
$
_pragma(classify_level=restricted, usage={redefinable})
_method c_linea_grafico.Color << PsColor
## Objetivo: Establece el color de la línea
## Parámetros de entrada: NA
## Parámetros de salida:  NA
## Regresa:  NA
## Fecha de última modificación : 28 / Octubre / 2004
## Autor de la modificación fdiaz
## Descripción de la modificación : Creación

	_self.sColor << PsColor	
	
_endmethod
$
_method c_linea_grafico.coordenadaMax << PoCoordenada
## Objetivo: asigna la coordenada que almacena las proporciones
## de la linea
## Parámetros de entrada: NA
## Parámetros de salida:  NA
## Regresa:  NA
## Fecha de última modificación : 28 / Octubre / 2004
## Autor de la modificación fdiaz
## Descripción de la modificación : Creación
##    

	_self.oCoordendaMax << PoCoordenada
	
_endmethod
$
_method c_linea_grafico.coordenadaMin << PoCoordenada
## Objetivo: asigna la coordenada que almacena las proporciones
## de la linea
## Parámetros de entrada: NA
## Parámetros de salida:  NA
## Regresa:  NA
## Fecha de última modificación : 28 / Octubre / 2004
## Autor de la modificación fdiaz
## Descripción de la modificación : Creación
##    

	_self.oCoordendaMin << PoCoordenada
	
_endmethod
$
_pragma(classify_level=restricted, usage={redefinable})
_method c_linea_grafico.Despliega()
## Objetivo: Desplegar un texto con una línea debajo de el
## Parámetros de entrada: NA
## Parámetros de salida:  NA
## Regresa:  NA
## Fecha de última modificación : 28 / Octubre / 2004
## Autor de la modificación fdiaz
## Descripción de la modificación : Creación

_local LoEstilo_Linea # Objeto Line_Style, se utilizara para el dibujo
_local LoCoordenada   # Almacenara una coordenada

# Se establecen los margenes por default
_Local LnMargIzq << 1
_local LnMargDer << 1
_Local LnMargInf << 1
_Local LnMargSup << 1

	# Se crea un estilo de linea
         LoEstilo_Linea << line_style.new_with_properties(
                  :foreground_colour, colour.called(_self.scolor), 
                  :width, 2)
	
	# Se crea una coordenada
	LoCoordenada << coords_vector.new(2)


#	_if _self.sEstilo = "DERECHA"
#	_then
#		LnProporXMin << 0
#		LnProporYMin << 0
#		LnProporXMax << 1
#		LnProporYMax << 1
#		
#        _elif _self.sEstilo = "IZQUIERDA"
#	_then 
#		LnProporXMin << 1
#		LnProporYMin << 0
#		LnProporXMax << 0
#		LnProporYMax << 1
#	_endif 

	LnLongEnX << _self.oArea.Xmax - _self.oArea.Xmin
	LnLongEnY << _self.oArea.Ymax - _self.oArea.Ymin

	LnXmin << _self.oArea.Xmin + ( LnLongEnX * _self.oCoordenadaMin.x )
	LnYmin << _self.oArea.Ymin + ( LnLongEnY * _self.oCoordenadaMin.y )

#        write("c_linea_grafico_dsb X ", _self.oArea.Xmin," - ", LnXMin," y ", _self.oArea.Ymin, " - " , LnYMin)
	
	LnXmax << _self.oArea.Xmax - ( LnLongEnX * (1 - _self.oCoordenadaMax.x ) )
	LnYmax << _self.oArea.Ymax - ( LnLongEnY * (1 - _self.oCoordenadaMax.y) )	

#        write("c_linea_grafico_dsb X ", _self.oArea.Xmax," - ", LnXMax," Y ", _self.oArea.Ymax, " - " , LnYMax)	
	
        LoCoordenada[1] << coordinate.new( LnXmin , LnYmin )
	LoCoordenada[2] << coordinate.new( LnXmax , LnYMax )
	
	# Se dibuja la línea
	_self.oVentana.draw_line_transform( LoEstilo_Linea, LoCoordenada) 
	
_endmethod
$
_pragma(classify_level=restricted, usage={redefinable})
_method c_linea_grafico.new(PoCoordenadaMin, PoCoordenadaMax)
## Objetivo: Crear una instancia de celda
## Parámetros de entrada:
## 	Cadena - RsNombre - Número del elemento grafico
## Parámetros de salida:   NA
## Regresa: 
## 	c_texto_grafico - regresa un objeto c_texto_grafico
## Fecha de última modificación: 11/Noviembre/2004
## Autor de la modificación : dsanchez
## Descripción de la modificación: Se documentó

   _self.oCoordenadaMin << PoCoordenadaMin
   _self.oCoordenadaMax << PoCoordenadaMax
   _self.sColor         << :black
   
   _return _clone
	
_endmethod
$
_pragma(classify_level=restricted, usage={redefinable})
_method c_linea_grafico.serial_slots()

	(keys, values) << _super.serial_slots()

	keys.add_all_last(rope.new_with(:oCoordenadaMin, :oCoordenadaMax, :sColor))
	values.add_all_last(rope.new_with(.oCoordenadaMin, .oCoordenadaMax, .sColor))

	_return keys, values
	
_endmethod
$
