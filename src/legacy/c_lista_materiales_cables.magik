_package user
$
#remex(:c_lista_materiales_cables)
$
def_slotted_exemplar(:c_lista_materiales_cables,
{
	 {:tipo, _unset},  
	 {:LoElemResumen, _unset},
	 {:ht,_unset },
	 {:principales, _unset }
}, :c_base_sello_fibra)
$
_pragma(classify_level=advanced, topic={plotting}, usage={subclassable})
_method c_lista_materiales_cables.new_with(Ptipo, _gather args)
	#---------------------------------------------------
	##  Objetivo  : generar una instancisa del sello de lista de
	## materiales inicializada segun el tipo de elementos que se
	## desea exponer, donde 
	## PoDatos contiene el tipo de elementos que se listaran  y sus
	## valores son :red o :estructuras.
	.tipo << Ptipo	
	>> _super.new_with(property_list.new_from_gathered ( args ))
	
_endmethod
$
_pragma(classify_level=advanced, topic={plotting}, usage={subclassable})
_method c_lista_materiales_cables.configura_tabla()
	##Define la estructura del sello de la lista de materiales

	.o_color_linea <<  {1.0, 0.0, 0.0}
	
	  _self.obten_lista_materiales()
	
	renglones_agregar << .ht.size

	_if .ht _isnt _unset
	_then
		lo_tabla << .o_tablas.crea_tabla(2+renglones_agregar,4,:tbl_lista_materiales)
	_else
		lo_tabla << .o_tablas.crea_tabla(2,4,:tbl_lista_materiales)
	_endif

	# coordenada donde inicia la tabla
	lo_tabla.ocoordenada_origen << .o_coord_inicio

	# longitud de los renglones de la tabla, dada en mm 
	_for n_reng _over range(1,2+renglones_agregar)
	_loop
		lo_tabla.orenglones.elemento(n_reng).nlongitud << 6
	_endloop

	# longitud de las columnas de la tabla, dada en mm 
	lo_tabla.ocolumnas.elemento(1).nlongitud  << 6
	lo_tabla.ocolumnas.elemento(2).nlongitud  << 12
	lo_tabla.ocolumnas.elemento(3).nlongitud  << 35
	lo_tabla.ocolumnas.elemento(4).nlongitud  << 20
		
	# se ocultan bordes de celdas
	oculta << rope.new_with({1,1},{1,2},{1,3},{1,4})
	_for e _over oculta.fast_elements()
	_loop
	lo_celda << lo_tabla.oceldas.celda(e[1].as_number(),e[2].as_number()).oelementos.obten_elemento(:bordes_celda)
	lo_celda.bBorde_Sup? << _false
	lo_celda.bBorde_Der? << _false
	lo_celda.bBorde_Izq? << _false 
	_endloop
	
_endmethod
$

_pragma(classify_level=advanced, topic={plotting}, usage={subclassable})
_method c_lista_materiales_cables.obten_lista_materiales()
	#---------------------------------------------------
	##  Objetivo  : obtener la lista de materiales.
	##
	 _self.elementos_de_proyecto()
	
_endmethod
$
_pragma(classify_level=advanced, topic={plotting}, usage={subclassable})
_method c_lista_materiales_cables.buscar_elementos_en_mapa()
	## Busca los cables proyectados
	paf << smallworld_product.pni_application()
	mv << paf.plugin(:map_plugin).current_map_view 
	Lovp << mv.get_geometry_set()
	_if Lovp _is _unset
	_then _return _endif
	_if Lovp.world _is _unset 
	_then _return _unset 
	_endif
	gset << Lovp.world.geometry_set()

	elementos << rope.new()
	
	_for geom _over gset.fast_elements()
	_loop
		 reg_gis << geom.rwo.source_rwo_records().an_element()
		 
		_if reg_gis _isnt _unset _andif
		    reg_gis.method(:rwo_type) _isnt _unset _andif
		    reg_gis.rwo_type _is :sheath
		_then
			_if reg_gis.construction_status = "PROYECTADO"
			_then
				elementos.add ( reg_gis )				 
			_endif
		_endif
	_endloop
	
#	_if elementos.size = 0
#	_then
#		_return _unset 
#	_endif
	
	_return elementos
		
_endmethod
$


_pragma(classify_level=advanced, topic={plotting}, usage={subclassable})
_method c_lista_materiales_cables.consultar_Lista_materiales()
	#---------------------------------------------------
	##  Objetivo  : Obtener una lista de materiales del proyecto
	## actual , almacenados en un hash_table ,donde cada elemento
	## del hash_table es una lista de objetos. 
	##
	## donde:
	## PoType puede ser : :oestructuras,
	##                    :obasinicio,
	##                    :ocanalizacion,
	##                    :oelementos,
	##                    :ocables,
	##                   :obasfinal
	##
        ## y PoCriterioGrupo es un campo que me permite agrupar los
        ## objetos por "clase de elemento" p/e  
        ## Potype--> :ocanalizacion, PoCriterioGrupo-->  :user!_tipo_obra_co 
	
	mm << hash_table.new()

	lista << swg_dsn_admin_engine.active_design.scan_geometries
	lista.add_all(_self.buscar_elementos_en_mapa() )
	principales <<  equality_set.new()
	mcables <<  rope.new()
	_for k _over lista.elements()
	_loop
		_if k.responds_to?(:construction_status) _andif
		    k.responds_to?(:source_collection)  _andif
		    k.source_collection.name _is :sheath  _andif
		    k.construction_status =  "PROYECTADO"
		_then
			mcables.add(k)
			
			# (22/11/16 des_aaron) : validar que no es principal
			_if k.get_upstream_connector() _isnt _unset _andif
			    k.get_upstream_connector().source_collection.external_name.uppercase = "CEDO" _andif
			    k.get_upstream_connector().get_Upstream_cables().an_element() _isnt _unset 
			_then
				principales.add_all( k.get_upstream_connector().get_Upstream_cables())
				#show(:pral)
				#print(principales)
			_endif			
		_endif
	_endloop	

	_for k  _over mcables.elements()
	_loop
		#show(:iterk, k)
		
		_if principales.includes?(k).not
		_then	
			_if k.responds_to?(:spec_id) 
			_then	       
				mkey << (k.source_collection.external_name.write_string + "|"  + k.spec_id).as_symbol()
			_else
				mkey << (k.source_collection.external_name.write_string + "|"  ).as_symbol()
			_endif
			
			_if mm[mkey] _is _unset 
			_then		
				mm[mkey] << equality_set.new()			
			_endif
			
			mm[mkey].add(k)
			#show(:cable,k)
			
		_endif
		
	_endloop
	
			
	_return mm, principales

_endmethod
$
_pragma(classify_level=advanced, topic={plotting}, usage={subclassable})
_method c_lista_materiales_cables.elementos_de_proyecto()
	#---------------------------------------------------
	##  Objetivo  : Hacer una lista de todos los materiales del
	## proyecto.
	##

	LoElementos << rope.new()
	ht  << hash_table.new()

	_if .tipo _is :red
	_then
		(.ht, .principales) << _self.consultar_Lista_materiales( _unset  ,_unset )	
	_endif 
	
	#genera una lista de todos los elementos.
	
	_if .ht.size > 0 
      _then
	      _for iterObjetoName,lista _over ht.keys_and_elements()  
	      _loop
		      _for LoOBjeto _over lista.elements()
		      _loop	      
			     LoElementos.add(LoObjeto )
		      _endloop
	      _endloop
	      
	_endif

	.LoElemResumen  << LoElementos

_endmethod
$
_pragma(classify_level=advanced, topic={plotting}, usage={subclassable})
_method c_lista_materiales_cables.etiqueta_celdas()
	_self.asigna_texto_celda(:tbl_lista_materiales,1,3,"CANTIDAD DE CABLE A PROYECTAR" ,30,_unset )
	_self.asigna_texto_celda(:tbl_lista_materiales,2,1,"No",20,_unset)
	_self.asigna_texto_celda(:tbl_lista_materiales,2,2,"CAPACIDAD",20,_unset)
	_self.asigna_texto_celda(:tbl_lista_materiales,2,3,"TIPO DE CABLE",20,_unset)
	_self.asigna_texto_celda(:tbl_lista_materiales,2,4,"LONGITUD(mts)",20,_unset)
_endmethod
$
_method c_lista_materiales_cables.actualiza_datos()
        ## actualiza la informacion de las celdas.
	_self.llena_datos_celdas()
	_self.draw_content_on(.window)
_endmethod
$
_pragma(classify_level=advanced, topic={plotting}, usage={subclassable})
_method c_lista_materiales_cables.llena_datos_celdas()
	## Obtiene la lista de materiales y asigna los valores.
	##	
	LoFormato << float_format.new(:float_decimal_places,2)

	v <<  mit_manager.modelit_dataset
	material << property_list.new()
	
	#Cantidad de renglones de la tabla actual
	_local ren_tbl << _self.o_tablas.elemento(:tbl_lista_materiales).oceldas.sys!slot(:nnumren)
	
	_if .ht.size > 0
	_then
		
		cont << 2
	      keys_o << _self.keys_Order(.ht )
	      
		_for  Iterkeyc _over keys_o.elements()
		_loop
			
			Iterkey	<< Iterkeyc.as_symbol()
			values << .ht[Iterkey.as_symbol()]
			
			cont+<<1

			IterObject << values.an_element()

			_if .principales _isnt _unset _andif
			    .principales.size > 0
			_then
				principal? << .principales.includes?(IterObject)	
			_endif

			#dvalenci 17/Enero/2023
			#se agrega validacion de principal? que no sea unset 
			_if principal? _isnt _unset _andif principal?.not
			_then
				material[:cantidad] << values.size.write_string
				material[:desc_uc] << IterObject.source_collection.external_name.write_string
				material[:desc_mat] << ""
				
				_if IterObject.responds_to?(:primary_geometry)   _andif
				    IterObject.primary_geometry _is :route
				_then
					material[:desc_unidad] << ""
					material[:cantidad] << 0
					
					_for record _over values.fast_elements()
					_loop
						cable? << record.source_collection.name _is :sheath
						
						_if cable?
						_then
							
							_if record.user!_long_opt _isnt _unset 
							_then
								Longitud << record.user!_long_opt.value_in(:m)
							_endif
							
							
							_if Longitud <=0
							_then
								longitud << record.calculated_fiber_length.value_in(:m)
							_endif
						_else
							Longitud << record.measured_length.value_in(:m)
						_endif
						
						material[:cantidad] +<<  longitud
						
					_endloop
					
					material[:cantidad] << material[:cantidad].as_fixed_string(5,2)
					
					
				_endif 
				
				_if   IterObject.source_collection.name _is :sheath
				_then		
					mspec  << IterObject.get_spec_record()				
					material[:desc_mat] << mspec.fiber_quantity.write_string + " F.O."
					material[:desc_unidad] << mspec.user!_clase.write_string
				_endif
				
				
				_if ren_tbl >= cont
				_then
					_self.asigna_texto_celda(:tbl_lista_materiales,cont,1,cont-2                ,18,_unset)
					_self.asigna_texto_celda(:tbl_lista_materiales,cont,2,material[:desc_mat]    ,18,_unset )
					_self.asigna_texto_celda(:tbl_lista_materiales,cont,3,material[:desc_unidad],18,_unset )
					_self.asigna_texto_celda(:tbl_lista_materiales,cont,4,material[:cantidad]   ,18,_unset )
				_endif
				
			_endif
				     
		_endloop
		
	_endif
	
_endmethod
$
_pragma(classify_level=advanced, topic={plotting}, usage={subclassable})
_method c_lista_materiales_cables.valida_cables()

	
	
_endmethod
$


_pragma(classify_level=advanced, topic={plotting}, usage={subclassable})
_method c_lista_materiales_cables.asigna_celdas_a_colorear()

	_local lst_celdas_color << rope.new()
	_local ren_tbl << _self.o_tablas.elemento(:tbl_lista_materiales).oceldas.sys!slot(:nnumren)
		
	lst_celdas_color.add({:tbl_lista_materiales,1,3,.o_color_linea})

	_for  iterIndice   _over 3.upto(ren_tbl)
		_loop
			lst_celdas_color.add({:tbl_lista_materiales,iterIndice,1,.o_color_linea})
			lst_celdas_color.add({:tbl_lista_materiales,iterIndice,2,.o_color_linea})
			lst_celdas_color.add({:tbl_lista_materiales,iterIndice,3,.o_color_linea})
			lst_celdas_color.add({:tbl_lista_materiales,iterIndice,4,.o_color_linea})			
		_endloop

	_return lst_celdas_color
	
_endmethod
$


_pragma(classify_level=advanced, topic={plotting}, usage={subclassable})
_method c_lista_materiales_cables.keys_Order(Loelementos )
	#---------------------------------------------------
	##  Objetivo  : Ordenar los keys de un hash_table
	##
	
	_local snproc << sorted_collection.figure_order_proc (
			:strings_with_numbers )

	order_proc << _proc ( d1, d2 )
			      _import snproc
			      >> snproc ( d1,d2 )
		      _endproc 
	
	lista << sorted_collection.new ( _unset, order_proc )

	
	 keys_order  << Loelementos.keys

	 _for iterKey  _over keys_order.fast_elements()
	 _loop	
		 lista.add(iterKey.write_string)
	 _endloop

	 _return lista
		
_endmethod
$
_pragma(classify_level=advanced, topic={plotting}, usage={subclassable})
_method c_lista_materiales_cables.elementos_en_secundarios()
   ## Se obtienen los elementos de Red en nivel de secundarios.
   ##
	
  _local LoListaObjetosSec << rope.new()
  _local LoDisenoActivo
  _local LoOei
   LoDisenoActivo << swg_dsn_admin_engine.active_scheme

   #LoOei << LoDisenoActivo.user!_oei_locals.an_element()
   
   ##_if LoOei _isnt _unset _andif
   ##    LoOei.user!_oe_locals.size > 0
   ##_then
       ##BUSCAMOS POR CADA OE LOS ELEMENTOS y esto es por conectividad
       ## desde el CEDO HACIA "afuera"
	    LoCedos << swg_dsn_admin_engine.active_scheme.distrito_optico.cedos_fo
	    
	    _for cedo _over LoCedos.fast_elements()
	    _loop
		 LoDivisores <<  cedo.obtener_divisores_conectados()
		 _for Divisor  _over LoDivisores.fast_elements()
		 _loop
		     _for pto_salida _over Divisor.output_ports().fast_elements()
		     _loop
			pc << c_path_connectivity.new(pto_salida, _true)
			pc.set_oPto  << pto_salida
			LoConect     << pc.run_get_connectivity_network(pto_salida)			
			LoNetwork    << pc.build_tree_network_base(LoConect)
			_if LoNetwork _isnt _unset 
			_then
			   _for j,k  _over LoNetwork.fast_keys_and_trees()
			   _loop
			      _if j.responds_to?(:construction_status) # _andif
				  #j.construction_status = "PROYECTADO"
			      _then
				      LoListaObjetosSec.add(j)
			      _endif
			   _endloop   
			_endif 
			
			LoStructures << pc.build_tree_structure_network_base(LoConect)
			_if LoStructures _isnt _unset 
			_then
			  _for l,m _over LoStructures.fast_keys_and_trees() 
			  _loop
				  _if l.responds_to?(:construction_status) _andif
				      l.construction_status = "PROYECTADO"
				  _then
					  LoListaObjetosSec.add(l) 
				  _endif 
			  _endloop 			      
			_endif			  
		     _endloop	 		   
		 _endloop
	    _endloop   
##   _endif
    
   _return LoListaObjetosSec
	
_endmethod
$
