def_slotted_exemplar(:c_lista_materiales_fibra,
{
	 {:tipo, _unset},  #se indica si la lista de materiales es de elementos de red o estructuras
	 {:LoElemResumen, _unset},
	 {:LoDesc,        _unset},
	 {:pl_datos,      _unset},
	 {:ht,           _unset }
}, :c_base_sello_fibra)
$
_pragma(classify_level=advanced, topic={plotting}, usage={subclassable})
_method c_lista_materiales_fibra.new_with(Podatos, _gather args)
	#---------------------------------------------------
	##  Objetivo  : generar una instancisa del sello de lista de
	## materiales inicializada segun el tipo de elementos que se
	## desea exponer, donde 
	## PoDatos contiene el tipo de elementos que se listaran  y sus
	## valores son :red o :estructuras.

	.tipo << Podatos

	.loDesc << {
	          {"Cierre FOSC 450BS (CEDO)"},
		  {"Intervención Cierre FOSC 450BS (subterráneo)"},
		  {"Jgo de Reent FOSC 450 BS"},
		  {"Cierre FOSC 350 C  Subterráneo (Recto)"},
		  {"Cierre FOSC 350 C  Aéreo (Recto)"},
		  {"Cierre FOSC 350 C  Subterráneo (1E/2S)"},		 
		  {"Cierre FOSC 350 C  Aéreo (1E/2S)"},		  
		  {"Cierre FOSC 350 C  Subterráneo (1E/3S)"},
		  {"Cierre FOSC 350 C  Aéreo (1E/3S)"},
		  {"Cierre FOSC 350 C  Subterráneo (1E/4S)"},
		  {"Cierre FOSC 350 C  Aéreo (1E/4S)"},
		  {"Intervención FOSC 350 C (subterráneo)"},
		  {"Jgo de Reent FOSC 350 C (subterráneo)"},
		  {"Intervención FOSC 350 C (aéreo)"},
		  {"Jgo de Reent FOSC 350 C (aéreo)"},		  
		  {"Divisor 1:8"},	
		  {"Fusiones por fibra"},
		  {"Terminal optica de 8 puertos"},
		  {"Terminal optica de 16 puertos"},
		  {"Etiqueta tipo bandera para cable"},
		  {"Bajante óptico"},		
		  {"Cantidad de gazas"}}


        .pl_datos << property_list.new()

	.pl_datos[:c_fosc_450cedo]     <<   0     #"Cierre FOSC 450BS (CEDO)" ))
	.pl_datos[:i_fosc_450_sub]     <<   0     #"Intervención FOSC 450 BS FOSC 450BS (subterráneo)" ))
	.pl_datos[:jgo_fosc_450]       <<   0     #"Jgo de Reent FOSC 450 BS" ))
	.pl_datos[:c_fosc_350_sub_r]   <<   0     #"Cierre FOSC 350 C  Subterráneo (Recto)" ))
	.pl_datos[:c_fosc_350_ae_r]    <<   0     #"Cierre FOSC 350 C  Aéreo (Recto)" ))
	.pl_datos[:c_fosc_350_sub_12]  <<   0     #"Cierre FOSC 350 C  Subterráneo (1E/2S)" ))
	.pl_datos[:c_fosc_350_ae_12]   <<   0     #"Cierre FOSC 350 C  Aéreo (1E/2S)" ))
	.pl_datos[:c_fosc_350_sub_13]  <<   0     #"Cierre FOSC 350 C  Subterráneo (1E/3S)" ))
	.pl_datos[:c_fosc_350_ae_13]   <<   0     #"Cierre FOSC 350 C  Aéreo (1E/3S)" ))
	.pl_datos[:c_fosc_350_sub_14]  <<   0     #"Cierre FOSC 350 C  Subterráneo (1E/4S)" ))
	.pl_datos[:c_fosc_350_ae_14]   <<   0     #"Cierre FOSC 350 C  Aéreo (1E/4S)" ))
	.pl_datos[:i_fosc_350_sub]     <<   0     #"Intervención FOSC 350 C (subterráneo)" ))
	.pl_datos[:jgo_fosc_350_sub]   <<   0     #"Jgo de Reent FOSC 350 C (subterráneo)" ))
	.pl_datos[:i_fosc_350_ae]      <<   0     #"Intervención FOSC 350 C (aéreo)" ))
	.pl_datos[:jgo_fosc_350_ae]    <<   0     #"Jgo de Reent FOSC 350 C (aéreo)"  ))
	.pl_datos[:divisor_18]         <<   0     #"Divisor 1:8"  ))
	.pl_datos[:fusiones_fibra]     <<   0     #"Fusiones por fibra"  ))
	.pl_datos[:terminal_optica_8]  <<   0     #"Terminal optica de 8 puertos" ))
	.pl_datos[:terminal_optica_16] <<   0     #"Terminal optica de 16 puertos"  ))
	.pl_datos[:etiqueta_bandera]   <<   0     #"Etiqueta tipo bandera para cable" ))
	.pl_datos[:bajante_optico]     <<   0     #"Bajante óptico" ))
	.pl_datos[:gazas]              <<   0     #"Cantidad de gazas" ))


	>> _super.new_with(property_list.new_from_gathered ( args ))
	
_endmethod
$
