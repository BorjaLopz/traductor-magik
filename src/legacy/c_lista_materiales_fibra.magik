	attribs.add(layout_attribute_definition.new(:c_fosc_350_ae_12,  :string,:default_value,"",:description,"Cierre FOSC 350 C  Aéreo (1E/2S)" ))
	attribs.add(layout_attribute_definition.new(:c_fosc_350_sub_13, :string,:default_value,"",:description,"Cierre FOSC 350 C  Subterráneo (1E/3S)" ))
