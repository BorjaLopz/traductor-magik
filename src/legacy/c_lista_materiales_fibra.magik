	attribs.add(layout_attribute_definition.new(:i_fosc_350_ae,     :string,:default_value,"",:description,"Intervención FOSC 350 C (aéreo)" ))
	attribs.add(layout_attribute_definition.new(:jgo_fosc_350_ae,   :string,:default_value,"",:description,"Jgo de Reent FOSC 350 C (aéreo)"  ))
