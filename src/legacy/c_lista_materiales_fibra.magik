	attribs.add(layout_attribute_definition.new(:fusiones_fibra,    :string,:default_value,"",:description,"Fusiones por fibra"  ))
	attribs.add(layout_attribute_definition.new(:terminal_optica_8, :string,:default_value,"",:description,"Terminal optica de 8 puertos" ))
	attribs.add(layout_attribute_definition.new(:terminal_optica_16,:string,:default_value,"",:description,"Terminal optica de 16 puertos"  ))
	attribs.add(layout_attribute_definition.new(:etiqueta_bandera,  :string,:default_value,"",:description,"Etiqueta tipo bandera para cable" ))
	attribs.add(layout_attribute_definition.new(:bajante_optico,    :string,:default_value,"",:description,"Bajante óptico" ))
