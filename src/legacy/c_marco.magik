       LcollSector.add(LcollSector.first_coord)
       
       LcollSectorRope.add(LcollSector)

       ## Poner las marcas Largo
       _for LnMod _over 1.upto(_self.Largo-1)
       _loop   
	       LcollSector<<sector.new()
	       LcollSector.add(coordinate(_self.bounds.xmin+LnMod*_self.CARTA_LARGO,_self.bounds.ymin) + coordinate(0,50))
	       LcollSector.add(LcollSector.last_coord + coordinate(0,50))
	       LcollSectorRope.add(LcollSector)

	       LcollSector<<sector.new()
	       LcollSector.add(coordinate(_self.bounds.xmin+LnMod*_self.CARTA_LARGO,_self.bounds.ymax) - coordinate(0,50))
	       LcollSector.add(LcollSector.last_coord - coordinate(0,50))
	       LcollSectorRope.add(LcollSector)
       _endloop
		
       # Dibujar el Marco.
       LcollSectorRope.draw_on(window,line_style.new(colour.called(:black),2))
_endmethod
$
_pragma(classify_level=restricted, usage={redefinable})
_method c_marco.draw_content_on ( window )
	## 
	##
	_if _self.marco="Larguillo"
	_then
		_if _self.Alto = 1
		_then
			_self.dibuja_marco_larguillo_1(window)
		_elif _self.Alto = 2
		_then 
			_self.dibuja_marco_larguillo_2(window)
		_else
			_self.dibuja_marco_larguillo_3(window)
		_endif

	_else
		_self.dibuja_marco(window)
	_endif

_endmethod
$
_pragma(classify_level=restricted, usage={redefinable})
_method c_marco.initialise_for_page(a_layout_page)
##	
##
## Objetivo: Formatea la pagina de acuerdo al numero de modulos especificados.
## Parametros de Salida: Ninguno
## Regresa: Ninguno.
## Fecha de ultima modificacion: 17/mayo/2005
## Autor de la modificacion: hramirea
## Descripcion de la modificacion: Metodo nuevo
##
	_local LoBound

	_if _self.marco="Larguillo"
	_then
		a_layout_page.set_paper_size(_self.SANGRIA_HOR*3 + _self.CARTA_LARGO*_self.Largo,
						 _self.SANGRIA_VER*4 + _self.CARTA_ALTO*_self.Alto)
	_else
		a_layout_page.set_paper_size(_self.SANGRIA_HOR*2+_self.CARTA_LARGO*_self.Largo,
				     _self.SANGRIA_VER*2+_self.CARTA_ALTO*_self.Alto)		
	_endif
	
	LoBound<<a_layout_page.bounds

	_self.bounds<< bounding_box.new(LoBound.xmin+_self.SANGRIA_HOR,
					LoBound.ymin+_self.SANGRIA_VER,
					LoBound.xmax-_self.SANGRIA_HOR,
					LoBound.ymax-_self.SANGRIA_VER)
	
	_self.outline_style<<_unset
	_self.set_fill_colour(_unset)
_endmethod
$
_pragma(classify_level=restricted, usage={redefinable})
_method c_marco.nombre_plano
## 
## 
## Objetivo: Regresar un arreglo con los nombres de los planos.
## Parametros de Salida: Ninguno
## Regresa: LasTipoPlano
## Fecha de ultima modificacion: 12/4/2005
## Autor de la modificacion: rbsaldan
## Descripcion de la modificacion: Metodo nuevo.

_local LasTipoPlano    # Arreglo con los valores para los diferentes marcos.

	LasTipoPlano<<rope.new()

	## Agrega valores para identificar los marcos.
	LasTipoPlano.add("")
	LasTipoPlano.add("T1")
	LasTipoPlano.add("T2")
	LasTipoPlano.add("T3")
	LasTipoPlano.add("2 X 4 Módulos")
        LasTipoPlano.add("Larguillo")
	#LasTipoPlano.add("Itinerario1")
	#LasTipoPlano.add("Itinerario2")
	#LasTipoPlano.add("Itinerario3")
	#LasTipoPlano.add("Construccion1")
	#LasTipoPlano.add("Construccion2")
	#LasTipoPlano.add("Empalmes")
	#LasTipoPlano.add("Topologico1")
	#LasTipoPlano.add("Topologico2")
	#LasTipoPlano.add("Topologico3")

	>> LasTipoPlano
_endmethod
$
