_package user
# remex(:c_norte)
$ 
def_slotted_exemplar (:c_norte,
                       {{:limites, _unset ,:writable, :public},
			{:oFlag, _false,:writable,:private}},
                        {:layout_element, :viewport_layout_mixin})
$
c_norte.define_shared_constant(:activate_properties_dialog_on_insert?,
						 _false,
		 				 :public)
$
c_norte.define_shared_constant(:allowed_on_menu?,_false,:public)
$
_pragma(classify_level=restricted, usage={redefinable})
_method c_norte.defined_attributes
# Objetivo: Definir los atributos de la clase que seran
#           visualizados en el cuadro de dialogo de las propiedades de
#           la clase.
# Parametros de Entrada: Ninguno.
# Parametros de Salida: Ninguno
# Regresa: La definicio de los atributos.
#   attribs: Definicion de los atributos.
# Fecha de ultima modificacion: 2/Mrz./2005.
# Autor de la modificacion: rbsaldan.
# Descripcion de la modificacion: Metodo nuevo.

_local LcollAtributos
	## Atributos basicos de la clase.
	LcollAtributos << rope.new_from( _super.defined_attributes)

	## Atributos basicos de la clase correspondientes a un viewport.
	LcollAtributos.add ( _self.viewport_attribute_definition )

	LcollAtributos.add ( layout_attribute_definition.new (:Tamano, :string,
							      :description, "Norte",
							      :default_value, "A",
							      :allowed_on_properties_page?, _true,
							      :enum_method, :tamano_norte,
							      :editor, _unset))
	

	>> LcollAtributos
_endmethod
$
_pragma(classify_level=restricted, usage={redefinable})
_method c_norte.tamano_norte
	## 
	## 
## Objetivo: Regresar un arreglo con los  valores "Si, "No"
## Parametros de Salida: Ninguno
## Regresa: LasTipoPlano
## Fecha de ultima modificacion: 12/4/2005
## Autor de la modificacion: rbsaldan
## Descripcion de la modificacion: Metodo nuevo.

_local LasTipoPlano    ##Arreglo con los valores para los diferentes marcos.
	LasTipoPlano<<rope.new()
	## Agrega valores para identificar los tamanos del norte.
	LasTipoPlano.add("A")
	LasTipoPlano.add("B")
	LasTipoPlano.add("C")
	>> LasTipoPlano
_endmethod
$
c_norte.define_attributes ()
$
