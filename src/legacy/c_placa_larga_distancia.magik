_package user
$

def_slotted_exemplar(:c_placa_larga_distancia,
{}, :c_base_sello_fibra)
$
_method c_placa_larga_distancia.configura_tabla()

	#----------------------------------------------------------
	# Tabla 1
	#-----------------------------------------------------------
        lo_tabla << .o_tablas.crea_tabla(1,1, :tbl_1)
	lo_tabla.oCoordenada_Origen << .o_coord_inicio
	lo_tabla.orenglones.elemento(1).nlongitud << 50
	lo_tabla.ocolumnas.elemento(1).nlongitud  << 130
	#----------------------------------------------------------
	# Tabla 2
	#-----------------------------------------------------------
        lo_tabla << .o_tablas.crea_tabla(1,1, :tbl_2)
	lo_tabla.oCoordenada_Origen << coordinate.new(.o_coord_inicio.x + 50,
						      .o_coord_inicio.y - 50)
	lo_tabla.orenglones.elemento(1).nlongitud << 40
	lo_tabla.ocolumnas.elemento(1).nlongitud  << 120
	#-----------------------------------------------------------
	#  Tabla 3
	#-----------------------------------------------------------
	lo_tabla << .o_tablas.crea_tabla(1,1, :tbl_3)
	lo_tabla.oCoordenada_Origen << coordinate.new(.o_coord_inicio.x + 50,
						      .o_coord_inicio.y - 50)
	lo_tabla.orenglones.elemento(1).nlongitud << 40
	lo_tabla.ocolumnas.elemento(1).nlongitud  << 26

	#-----------------------------------------------------------
	#  Tabla 4
	#-----------------------------------------------------------
	lo_tabla << .o_tablas.crea_tabla(1,1, :tbl_4)
	lo_tabla.oCoordenada_Origen << coordinate.new(.o_coord_inicio.x + 330,
						      .o_coord_inicio.y - 70)
	lo_tabla.orenglones.elemento(1).nlongitud << 15
	lo_tabla.ocolumnas.elemento(1).nlongitud  << 90
	lo_celda << lo_tabla.oceldas.celda(1,1).oelementos.obten_elemento(:bordes_celda)
		lo_celda.bBorde_Izq? << _false
		lo_celda.bBorde_Inf? << _false
		lo_celda.bBorde_Sup? << _false
		lo_celda.bBorde_Der? << _false 
	#-----------------------------------------------------------
	#  Tabla 5
	#-----------------------------------------------------------
	lo_tabla << .o_tablas.crea_tabla(1,4, :tbl_5)
	lo_tabla.oCoordenada_Origen << coordinate.new(.o_coord_inicio.x + 330,
						      .o_coord_inicio.y - 240)
	lo_tabla.orenglones.elemento(1).nlongitud << 7.5
	lo_tabla.ocolumnas.elemento(1).nlongitud  << 22.5
	lo_tabla.ocolumnas.elemento(2).nlongitud  << 22.5
	lo_tabla.ocolumnas.elemento(3).nlongitud  << 22.5
	lo_tabla.ocolumnas.elemento(4).nlongitud  << 22.5
	ocultar << rope.new_with({1,1},{1,3})
	_for elem _over ocultar.fast_elements()
	_loop
		lo_celda << lo_tabla.oceldas.celda(elem[1].as_number(),elem[2].as_number()).oelementos.obten_elemento(:bordes_celda)
		lo_celda.bBorde_Izq? << _false
		lo_celda.bBorde_Inf? << _false
		lo_celda.bBorde_Sup? << _false
	_endloop
	#-----------------------------------------------------------
	#  Tabla 6
	#-----------------------------------------------------------
	lo_tabla << .o_tablas.crea_tabla(1,4, :tbl_6)
	lo_tabla.oCoordenada_Origen << coordinate.new(.o_coord_inicio.x + 330,
						      .o_coord_inicio.y - 340)
	lo_tabla.orenglones.elemento(1).nlongitud << 7.5
	lo_tabla.ocolumnas.elemento(1).nlongitud  << 22.5
	lo_tabla.ocolumnas.elemento(2).nlongitud  << 22.5
	lo_tabla.ocolumnas.elemento(3).nlongitud  << 22.5
	lo_tabla.ocolumnas.elemento(4).nlongitud  << 22.5
	ocultar << rope.new_with({1,1},{1,3})
	_for elem _over ocultar.fast_elements()
	_loop
		lo_celda << lo_tabla.oceldas.celda(elem[1].as_number(),elem[2].as_number()).oelementos.obten_elemento(:bordes_celda)
		lo_celda.bBorde_Izq? << _false
		lo_celda.bBorde_Inf? << _false
		lo_celda.bBorde_Sup? << _false
	_endloop

	_self.set_fill_colour(colour.new_rgb(1,0.83,0.75))
	
_endmethod
$
_pragma(classify_level=advanced, topic={plotting}, usage={subclassable})
_method c_placa_larga_distancia.llena_datos_celdas()

	

	
_endmethod
$
_pragma(classify_level=advanced, topic={plotting}, usage={subclassable})
_method c_placa_larga_distancia.etiqueta_celdas()

	texto1 << "PRECAUCION"+%newline
	texto1 +<< "CABLE DE FIBRA OPTICA"+%newline
	texto1 +<< "LARGA DISTANCIA"

	_self.asigna_simbolo_celda(:tbl_3,1,1,"logo_sellos")
	
	_self.asigna_texto_celda(:tbl_4, 1,1, texto1, 36,:top_centre)
		
	_self.asigna_texto_celda(:tbl_5, 1,1, "RUTA", 28,_unset)
	_self.asigna_texto_celda(:tbl_5, 1,3, "LONG.", 28,_unset)
	
	_self.asigna_texto_celda(:tbl_6, 1,1, "POZO", 28,_unset)
	_self.asigna_texto_celda(:tbl_6, 1,3, "EMPALME", 28,_unset)
		
_endmethod
$
_pragma(classify_level=advanced, topic={plotting}, usage={subclassable})
_method c_placa_larga_distancia.defined_attributes
	## 
	## 
	attribs << rope.new_from (_super.defined_attributes)

	attribs.add(layout_attribute_definition.new(:ruta, :string,
						    :description, "RUTA"))
	attribs.add(layout_attribute_definition.new(:long, :string,
						    :description, "LONG."))
	attribs.add(layout_attribute_definition.new(:pozo, :string,
						    :description, "POZO"))
	attribs.add(layout_attribute_definition.new(:empalme, :string,
						    :description, "EMPALME"))
	
	>>attribs
_endmethod
$
c_placa_larga_distancia.define_attributes()

_pragma(classify_level=advanced, topic={plotting}, usage={subclassable})
_method c_placa_larga_distancia.llena_datos_dinamicos()
	## 
	## 
	# (10/12/10 lgranados) : Se asignan los valores capturados por
	# el usuario.
	
	_self.asigna_texto_celda(:tbl_5,1,2,_self.ruta,22)
	_self.asigna_texto_celda(:tbl_5,1,4,_self.long,22)
	_self.asigna_texto_celda(:tbl_6,1,2,_self.pozo,22)
	_self.asigna_texto_celda(:tbl_6,1,4,_self.empalme,22)
	
_endmethod
$
