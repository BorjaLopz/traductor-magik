_package user
$

def_slotted_exemplar(:c_placa_troncal_zonal,
{}, :c_base_sello_fibra)
$
_method c_placa_troncal_zonal.configura_tabla()

	#----------------------------------------------------------
	# Tabla 1
	#-----------------------------------------------------------
        lo_tabla << .o_tablas.crea_tabla(1,1, :tbl_1)
	lo_tabla.oCoordenada_Origen << .o_coord_inicio
	lo_tabla.orenglones.elemento(1).nlongitud << 50
	lo_tabla.ocolumnas.elemento(1).nlongitud  << 130
	#----------------------------------------------------------
	# Tabla 2
	#-----------------------------------------------------------
        lo_tabla << .o_tablas.crea_tabla(1,1, :tbl_2)
	lo_tabla.oCoordenada_Origen << coordinate.new(.o_coord_inicio.x + 25,
						      .o_coord_inicio.y - 25)
	lo_tabla.orenglones.elemento(1).nlongitud << 45
	lo_tabla.ocolumnas.elemento(1).nlongitud  << 125
	#-----------------------------------------------------------
	#  Tabla 3
	#-----------------------------------------------------------
	lo_tabla << .o_tablas.crea_tabla(1, 1, :tbl_3)
	lo_tabla.oCoordenada_Origen << coordinate.new(.o_coord_inicio.x + 25,
						      .o_coord_inicio.y - 25)
	lo_tabla.orenglones.elemento(1).nlongitud << 45
	lo_tabla.ocolumnas.elemento(1).nlongitud  << 26
	#-----------------------------------------------------------
	#  Tabla 4
	#-----------------------------------------------------------
	lo_tabla << .o_tablas.crea_tabla(1,8, :tbl_4)
	lo_tabla.oCoordenada_Origen << coordinate.new(.o_coord_inicio.x + 285,
						      .o_coord_inicio.y - 70)
	lo_tabla.orenglones.elemento(1).nlongitud << 7.5
	lo_tabla.ocolumnas.elemento(1).nlongitud << 7.5
	lo_tabla.ocolumnas.elemento(2).nlongitud << 15
	lo_tabla.ocolumnas.elemento(3).nlongitud << 7.5
	lo_tabla.ocolumnas.elemento(4).nlongitud << 15
	lo_tabla.ocolumnas.elemento(5).nlongitud << 7.5
	_for n_col _over range(6,8)
	_loop
		lo_tabla.ocolumnas.elemento(n_col).nlongitud  << 15
	_endloop
	ocultar << rope.new_with({1,1},{1,3},{1,5},{1,7})
	_for elem _over ocultar.fast_elements()
	_loop
		lo_celda << lo_tabla.oceldas.celda(elem[1].as_number(),elem[2].as_number()).oelementos.obten_elemento(:bordes_celda)
		lo_celda.bBorde_Izq? << _false
		lo_celda.bBorde_Inf? << _false
		lo_celda.bBorde_Sup? << _false
	_endloop
	#-----------------------------------------------------------
	#  Tabla 5
	#-----------------------------------------------------------
	lo_tabla << .o_tablas.crea_tabla(1,8, :tbl_5)
	lo_tabla.oCoordenada_Origen << coordinate.new(.o_coord_inicio.x + 285,
						      .o_coord_inicio.y - 165)
	lo_tabla.orenglones.elemento(1).nlongitud << 7.5
	lo_tabla.ocolumnas.elemento(1).nlongitud << 16
	lo_tabla.ocolumnas.elemento(2).nlongitud << 10.5
	lo_tabla.ocolumnas.elemento(3).nlongitud << 11
	lo_tabla.ocolumnas.elemento(4).nlongitud << 11
	lo_tabla.ocolumnas.elemento(5).nlongitud << 16
	lo_tabla.ocolumnas.elemento(6).nlongitud << 11
	lo_tabla.ocolumnas.elemento(7).nlongitud << 11
	lo_tabla.ocolumnas.elemento(8).nlongitud << 11

	ocultar << rope.new_with({1,1},{1,3},{1,5},{1,7})
	_for elem _over ocultar.fast_elements()
	_loop
		lo_celda << lo_tabla.oceldas.celda(elem[1].as_number(),elem[2].as_number()).oelementos.obten_elemento(:bordes_celda)
		lo_celda.bBorde_Izq? << _false
		lo_celda.bBorde_Inf? << _false
		lo_celda.bBorde_Sup? << _false
	_endloop

	#-----------------------------------------------------------
	#  Tabla 6
	#-----------------------------------------------------------
	lo_tabla << .o_tablas.crea_tabla(1,10, :tbl_6)
	lo_tabla.oCoordenada_Origen << coordinate.new(.o_coord_inicio.x + 285,
						      .o_coord_inicio.y - 260)
	lo_tabla.orenglones.elemento(1).nlongitud << 7.5
	_for n_col _over range(1,10)
	_loop
		lo_tabla.ocolumnas.elemento(n_col).nlongitud  << 9.75
	_endloop
	ocultar << rope.new_with({1,1},{1,3},{1,5},{1,7},{1,9})
	_for elem _over ocultar.fast_elements()
	_loop
		lo_celda << lo_tabla.oceldas.celda(elem[1].as_number(),elem[2].as_number()).oelementos.obten_elemento(:bordes_celda)
		lo_celda.bBorde_Izq? << _false
		lo_celda.bBorde_Inf? << _false
		lo_celda.bBorde_Sup? << _false
	_endloop	
	#-----------------------------------------------------------
	#  Tabla 7
	#-----------------------------------------------------------
	lo_tabla << .o_tablas.crea_tabla(1,10, :tbl_7)
	lo_tabla.oCoordenada_Origen << coordinate.new(.o_coord_inicio.x + 285,
						      .o_coord_inicio.y - 355)
	
	lo_tabla.orenglones.elemento(1).nlongitud << 7.5
	_for n_col _over range(1,10)
	_loop
		lo_tabla.ocolumnas.elemento(n_col).nlongitud  << 9.75
	_endloop

	ocultar << rope.new_with({1,1},{1,3},{1,5},{1,7},{1,9})
	_for elem _over ocultar.fast_elements()
	_loop
		lo_celda << lo_tabla.oceldas.celda(elem[1].as_number(),elem[2].as_number()).oelementos.obten_elemento(:bordes_celda)
		lo_celda.bBorde_Izq? << _false
		lo_celda.bBorde_Inf? << _false
		lo_celda.bBorde_Sup? << _false
	_endloop


	_self.set_fill_colour(colour.new_rgb(1,0.80,0.80))
	
_endmethod
$
_pragma(classify_level=advanced, topic={plotting}, usage={subclassable})
_method c_placa_troncal_zonal.llena_datos_celdas()

	
	
_endmethod
$
_pragma(classify_level=advanced, topic={plotting}, usage={subclassable})
_method c_placa_troncal_zonal.etiqueta_celdas()

	_self.asigna_simbolo_celda(:tbl_3,1,1,"logo_sellos")
	
	_self.asigna_texto_celda(:tbl_4, 1,1, "TK", 22,_unset)
	_self.asigna_texto_celda(:tbl_4, 1,3, "RUTA", 22,_unset)
	_self.asigna_texto_celda(:tbl_4, 1,5, "PEP", 22,_unset)
	_self.asigna_texto_celda(:tbl_4, 1,7, "NO.DE CABLE", 22,_unset)
	
	_self.asigna_texto_celda(:tbl_5, 1,1, "CAPACIDAD PS", 22,_unset)
	_self.asigna_texto_celda(:tbl_5, 1,3, "CALIBRE", 22,_unset)
	_self.asigna_texto_celda(:tbl_5, 1,5, "TIPO DE CABLE",22,_unset)
	_self.asigna_texto_celda(:tbl_5, 1,7, "NO.P.REP",22,_unset)
	
	_self.asigna_texto_celda(:tbl_6, 1,1, "CTL", 22,_unset)
	_self.asigna_texto_celda(:tbl_6, 1,3, "SECCION", 22,_unset)
	_self.asigna_texto_celda(:tbl_6, 1,5, "VERTICAL", 22,_unset)
	_self.asigna_texto_celda(:tbl_6, 1,7, "STRIPS", 22,_unset)
	_self.asigna_texto_celda(:tbl_6, 1,9, "IND.", 22,_unset)
		
	_self.asigna_texto_celda(:tbl_7, 1,1, "CTL", 22,_unset)
	_self.asigna_texto_celda(:tbl_7, 1,3, "SECCION", 22,_unset)
	_self.asigna_texto_celda(:tbl_7, 1,5, "VERTICAL", 22,_unset)
	_self.asigna_texto_celda(:tbl_7, 1,7, "STRIPS", 22,_unset)
	_self.asigna_texto_celda(:tbl_7, 1,9, "IND.", 22,_unset)

		
_endmethod
$
_pragma(classify_level=advanced, topic={plotting}, usage={subclassable})
_method c_placa_troncal_zonal.defined_attributes
	## 
	## 
	attribs << rope.new_from (_super.defined_attributes)
	
	attribs.add(layout_attribute_definition.new(:tk, :string,
						    :description, "TK"))
	attribs.add(layout_attribute_definition.new(:ruta, :string,
						    :description, "RUTA"))
	attribs.add(layout_attribute_definition.new(:pep, :string,
						    :description, "PEP"))
	attribs.add(layout_attribute_definition.new(:no_cable, :string,
						    :description, "No.DE CABLE"))
	attribs.add(layout_attribute_definition.new(:capacidad_ps, :string,
						    :description, "CAPACIDAD PS"))
	attribs.add(layout_attribute_definition.new(:calibre, :string,
						    :description, "CALIBRE"))
	attribs.add(layout_attribute_definition.new(:tipo_cable, :string,
						    :description, "TIPO DE CABLE"))
	attribs.add(layout_attribute_definition.new(:no_p_rep, :string,
						    :description, "NO.P.REP"))
	attribs.add(layout_attribute_definition.new(:ctl_origen, :string,
						    :description, "CTL"))
	attribs.add(layout_attribute_definition.new(:seccion_origen, :string,
						    :description, "SECCION"))
	attribs.add(layout_attribute_definition.new(:vertical_origen, :string,
						    :description, "VERTICAL"))
	attribs.add(layout_attribute_definition.new(:strips_origen, :string,
						    :description, "STRIPS"))
	attribs.add(layout_attribute_definition.new(:ind_origen, :string,
						    :description, "IND"))
	attribs.add(layout_attribute_definition.new(:ctl_destino, :string,
						    :description, "CTL"))
	attribs.add(layout_attribute_definition.new(:seccion_destino, :string,
						    :description, "SECCION"))
	attribs.add(layout_attribute_definition.new(:vertical_destino, :string,
						    :description, "VERTICAL"))
	attribs.add(layout_attribute_definition.new(:strips_destino, :string,
						    :description, "STRIPS"))
	attribs.add(layout_attribute_definition.new(:ind_destino, :string,
						    :description, "IND"))
	
	
	>>attribs
_endmethod
$
c_placa_troncal_zonal.define_attributes()

_pragma(classify_level=advanced, topic={plotting}, usage={subclassable})
_method c_placa_troncal_zonal.llena_datos_dinamicos()
	## 
	## 
	# (10/12/10 lgranados) : Se asignan los valores capturados por
	# el usuario.
	
	_self.asigna_texto_celda(:tbl_4,1,2,_self.tk,28)
	_self.asigna_texto_celda(:tbl_4,1,4,_self.ruta,28)
	_self.asigna_texto_celda(:tbl_4,1,6,_self.pep,28)
	_self.asigna_texto_celda(:tbl_4,1,8,_self.no_cable,28)
	
	_self.asigna_texto_celda(:tbl_5,1,2,_self.capacidad_ps,28)
	_self.asigna_texto_celda(:tbl_5,1,4,_self.calibre,28)
	_self.asigna_texto_celda(:tbl_5,1,2,_self.tipo_cable,28)
	_self.asigna_texto_celda(:tbl_5,1,4,_self.no_p_rep,28)
	
	_self.asigna_texto_celda(:tbl_6,1,2,_self.ctl_origen,28)
	_self.asigna_texto_celda(:tbl_6,1,4,_self.seccion_origen,28)
	_self.asigna_texto_celda(:tbl_6,1,6,_self.vertical_origen,28)
	_self.asigna_texto_celda(:tbl_6,1,8,_self.strips_origen,28)
	_self.asigna_texto_celda(:tbl_6,1,10,_self.ind_origen,28)
	
	_self.asigna_texto_celda(:tbl_7,1,2,_self.ctl_destino,28)
	_self.asigna_texto_celda(:tbl_7,1,4,_self.seccion_destino,28)
	_self.asigna_texto_celda(:tbl_7,1,6,_self.vertical_destino,28)
	_self.asigna_texto_celda(:tbl_7,1,8,_self.strips_destino,28)
	_self.asigna_texto_celda(:tbl_7,1,10,_self.ind_destino,28)

	
_endmethod
$
