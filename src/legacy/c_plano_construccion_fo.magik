_package user
$
def_slotted_exemplar(:c_plano_construccion_fo,{
			      {:oGpm,_unset,:writable},
			      {:oPaf,_unset,:writable},
			      {:oPam,_unset,:writable},
                              {:oPage, _unset ,:writable , :private},
		              {:oLayoutDesigner,_unset,:writable},
			      {:oLayoutPlugin,_unset,:writable},
			      {:oLayoutManager,_unset,:writable},
			      {:oViewportMapper,_unset,:writable},
			      {:oMarco,_unset,:writable},
			      {:oDtoOptico,_unset,:writable},
			      {:oEdificios,_unset,:writable}
		     },
		     {:c_geom_set_layout, :viewport_layout_mixin})
$
_method c_plano_construccion_fo.new()
	_return _clone.init()
_endmethod
$
_pragma(classify_level=advanced, topic={if_mit_cable_model})
_method c_plano_construccion_fo.init()
	## 
	##
	.oPaf << smallworld_product.pni_application()
	.oGpm << gis_program_manager
	.oPam << .oPaf.manager 	 
	.oEdificios << rwo_set.new()	
	_return _self
_endmethod
$
_pragma(classify_level=advanced, topic={if_mit_cable_model})
_method c_plano_construccion_fo.inicia_layout()
	## 
	##
	.oLayoutPlugin   << .oPaf.plugin(:layout_plugin)
	.oLayoutPlugin.start_layout_designer()
	.oLayoutDesigner << .oLayoutPlugin.dialogs[:layout_designer]
	.oLayoutManager  << .oLayoutDesigner.plugin(:layout_manager)    
	.oViewportMapper << .oLayoutDesigner.plugin(:viewport_mapper)
	LoDoc << .oLayoutManager.current_document
	.oPage << .oLayoutManager.current_page
	LoDoc.user!_tipo_plano << :construccion_fo
_endmethod
$
_pragma(classify_level=advanced, topic={if_mit_cable_model})
_method c_plano_construccion_fo.genera_plano(PODtoOptico)
	## 
	##
	_local LoPaf << smallworld_product.pni_application()
	_local genp << LoPaf.plugin(:gen_planos)
	
	.oDtoOptico << PODtoOptico
	_self.inicia_layout()
	_self.add_marco()
	_self.AddNorte()
	_self.add_sellos()
	_self.add_viewport_principal()
	## agrega el viewport_detalle_canalizacion
	_self.AddViewportDetalleCanal()
	_self.busca_edificios()
	#Regresa el mapa al gis
	.oPam.goto_context(.oDtoOptico, .oDtoOptico.primary_spatial_context_name)

	###############################
        genp.publicalo( _unset )   
	###############################

	
_endmethod
$
_pragma(classify_level=advanced, topic={if_mit_cable_model})
_method c_plano_construccion_fo.add_marco()
	.oMarco << c_marco.new_with(:bounds,bounding_box.new(0, 0, 1, 1))
	.oMarco.Largo << 4
	.oMarco.Alto  << 2
	.oMarco.set_fill_colour(_unset)
	.oPage.add_element( .oMarco )
	_self.AddTitulo( .oMarco )
_endmethod
