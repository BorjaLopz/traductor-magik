#----------------------------------------------------------------
_package user
$
#remex(:c_plano_esquematico_de_principales)
$
def_slotted_exemplar(:c_plano_esquematico_de_principales,{
		       {:oEngine, _unset, :writable,:private}, #Engine para la ruta		     
		       {:oBuffer, _unset, :writable,:private}, #Engine para la ruta
		       {:oMarco,_unset,:writable}
		       
		     },:c_factory_planos)
$
_pragma(classify_level=restricted, usage={redefinable})
_method c_plano_esquematico_de_principales.new(_optional PoEngine)
## Metodo para crear un _clone de _self
##	
    _return _clone.init(PoEngine)
	
_endmethod
$
_pragma(classify_level=restricted, usage={redefinable})
_private _method c_plano_esquematico_de_principales.init(PoEngine)
	## Metodo para inicializar la instancia
	##
	.oEngine << PoEngine
	_return _self 	
_endmethod
$
_pragma(classify_level=restricted, usage={redefinable})
_method c_plano_esquematico_de_principales.cables_esquema_sigp()
	#---------------------------------------------------
	paf << smallworld_product.pni_application()
	mv << paf.plugin(:map_plugin).current_map_view
	objs << mv.get_visible_geometry_set()

	_if mv.ace_name _is :gs!schematic 
	_then
  cables_esquema << rope.new()
	
	_for itergeom  _over objs.fast_elements()
	_loop		
		_if itergeom.rwo.source_rwo_records().size > 0 _andif
		    itergeom.rwo.source_rwo_records().an_element().source_collection.name _is :sheath
		_then
			cables_esquema.add(itergeom.rwo.source_rwo_records().an_element())
		_endif
	_endloop

	PoCable << cables_esquema
	
	_endif
	
      	
	>> PoCable	
_endmethod
$
_pragma(classify_level=restricted, usage={redefinable})
_method c_plano_esquematico_de_principales.genera_plano(_optional PoCable,Penlace)
	## Objetivo: Metodo que subclaseable para generar el plano,
	## llama a la super y carga los elementos particulares para
	## este tipo de plano
	## Parametros de entrada: PoCable = Sheath para la ruta	
	(.oPage,.oViewMapperPlugin) <<_self.inicia_layout()	
	_local LrEstructuras
	_local LrElementos
	_local LrCanalizacion
	_local LoPaf << smallworld_product.pni_application()
	_local genp << LoPaf.plugin(:gen_planos)

	## Recorrer la ruta y obtener las estructuras
	_if PoCable _isnt _unset 
	_then
		#.oEngine.recorrer_ruta(PoCable)
		#	LrEstructuras  << .oEngine.getEstructuras()
		#	LrCanalizacion << .oEngine.getCanalizacion()
		#	LrElementos    << .oEngine.getElementos()
		genp.o_enlace << Penlace		
	_endif
	
	###############################
	genp.publicalo(_self.oEngine)   
	###############################
        _self.add_marco()
	_self.addNorte()
	_self.add_sellos()
	_self.add_viewport_principal()
	LoDoc << .oPage.layout_document
	LoDoc.user!_tipo_plano << :esquema_principales
#	_super.AddElementos_comunes()
#       _self.activa_series(LoBuffer_plano)
	
_endmethod
$
_pragma(classify_level=restricted, usage={redefinable})
_method c_plano_esquematico_de_principales.add_marco()
	## 
	## 
	.oMarco << c_marco.new_with(:bounds,bounding_box.new(0, 0, 1, 1))
	.oMarco.Largo <<  4
	.oMarco.Alto  <<  2
	.oMarco.set_fill_colour(_unset)
	.oPage.add_element( .oMarco )
	_self.AddTitulo( .oMarco )
_endmethod
$
_pragma(classify_level=restricted, usage={redefinable})
_method c_plano_esquematico_de_principales.agrega_simbolo(pNombreSimbolo, pbounds)
        
	LoBound<< pbounds
		
	LoSimbolo<<symbol_layout.new_with(:bounds,Lobound)

		_if (LoSimbolo<<symbol_layout.new_with(:bounds,LoBound,
						       :name,pNombreSimbolo,
						       :fill_style,_unset,
						       :outline_style,_unset)) _isnt _unset 
		_then
			.oPage.add_element(LoSimbolo)
		_endif 
	
_endmethod
$
_pragma(classify_level=restricted, usage={redefinable})
_method c_plano_esquematico_de_principales.AddNorte()
	## 
	## lgranados: Se agrega el norte por default al plano
	
	_local LoBounds
	_local LoNorte
	_local LoPage
	
        LoPage<< .oPage
	
	_if LoPage _isnt _unset _andif LoPage.is_kind_of?(layout_page)
	_then
		Lobounds<<bounding_box.new(LoPage.bounds.xmin,LoPage.bounds.ymax-1500,
					   LoPage.bounds.xmin+4000,LoPage.bounds.ymax)
		LoNorte << c_norte.new_with(:bounds,Lobounds)
		LoNorte.limites<<_unset
		LoPage.add_element(LoNorte)
	_endif
	
_endmethod
$
_pragma(classify_level=restricted, usage={redefinable})
_method c_plano_esquematico_de_principales.add_sellos()
	## 
	## 
	
	LoSello << c_notas_constructor.new_with(:bounds,bounding_box.new(555,3759,2355,4330))	
	.opage.add_element(LoSello)
									  
	bounds_simbologia << bounding_box.new(.oMarco.bounds.xmin+220,
					      .oMarco.bounds.ymin+4230,
					      .oMarco.bounds.xmin+1520,
					      .oMarco.bounds.ymin+5500)
	
	_self.agrega_simbolo("simbolos_planos_esquematico" ,bounds_simbologia)
	
	bounds_sello_estandar <<bounding_box.new(.oMarco.bounds.xmin+55,
						 .oMarco.bounds.ymin+400,
						 .oMarco.bounds.xmin+2000,
						 .oMarco.bounds.ymin+3000)

	LoSello << c_sello_estandar_base_fo.new_with(:bounds,bounds_sello_estandar)	
	.opage.add_element(LoSello)

	bounds_sello_ruta_cables << bounding_box.new(.oMarco.bounds.xmin+450,
						     .oMarco.bounds.ymin+1000,
						     .oMarco.bounds.xmin+2100,
						     .oMarco.bounds.ymin+1600 )
	
	LoSello << c_sello_ruta_cables_fo_sigp.new_with(:bounds,bounds_sello_ruta_cables)	
	.opage.add_element(LoSello)

	lo_sello << c_resumen_del_proyecto.new_with(:bounds,bounding_box.new(4500,627,5490,5687 ))
	.oPage.add_element(lo_sello) 				

	lo_sello << c_resumen_distritos_ruta.new_with(:bounds,bounding_box.new(450,3100,2100,4500 ))
	.oPage.add_element(lo_sello) 				

	
	_self.add_sello_tabla_equivalencias_x_cable()


_endmethod
$
_pragma(classify_level=restricted, usage={redefinable})
_method c_plano_esquematico_de_principales.add_viewport_principal()
	## 
	## 
	_local oPaf << smallworld_product.pni_application()
	
	LoMapPlugin << oPaf.plugin(:map_plugin)
	
	LoVpArea << bounding_box.new( .oMarco.bounds.xmin + 3000,
				      .oMarco.bounds.ymin + 500,
				      .oMarco.bounds.xmax - 750,
				      .oMarco.bounds.ymax - 750)
	
	
	LoMapView << LoMapPlugin.current_map_view	
	LoBoundsMv << LoMapView.current_view_bounds
	LoViewport << c_viewport_layout_sigc.new_with(:bounds, LoVpArea)
	LoViewport.set_fill_colour(_unset)
	LoViewport.outline_style << _unset
	LoViewport.trail << _false
	LoViewport.selection << _false
	LoViewport.sTipoPlano << "DIAGRAMA_ESQUEMATICO_PRINCIPALES"
	.oPage.add_element(LoViewport)
	.oViewMapperPlugin.map_viewport_on_map_view(LoViewport,LoMapView, LoBoundsMv,_true)
	
_endmethod
$
_method c_plano_esquematico_de_principales.AddParticulares()
	## Objetivo: Metodo para cargar los elementos particulares de
	## este tipo de plano
	## este tipo de plano

_endmethod
$
_pragma(classify_level=restricted, usage={redefinable})
_method c_plano_esquematico_de_principales.crea_titulo
	## Objetivo: Crear el titulo para los planos RDA
## Parametros de salida: Ninguno
	
	LoTitulo << "PLANO ESQUEMATICO  DE PRINCIPALES" + %newline + " CTL - " + 
		    swg_dsn_admin_engine.active_scheme.project.user!_central.user!_nombre
	
	_return LoTitulo
	
_endmethod
$
_pragma(classify_level=restricted, usage={redefinable})
_method c_plano_esquematico_de_principales.AddTitulo(PoMarco)
## Objetivo: Agregar el titulo al plano
## Parametros de Entrada: Ninguno.
## Regresa: Ninguno
## Fecha de Ultima modificacion:20/10/2009
## Autor de la modificacion: rmrosale
## Descripcion de la modificacion: Metodo nuevo 

    LoTitulo << _self.crea_titulo
    
    LoBB << bounding_box.new(PoMarco.bounds.xmax-2800,
			     PoMarco.bounds.ymin+200,
			     PoMarco.bounds.xmax-200,
			     PoMarco.bounds.ymin+600)
    
    LoTitulo << c_titulo_de_plano.new_with(:bounds,           LoBB,
					   :font_name,        "bold",
					   :font_size,        8,
					   :fill_style,       _unset,
					   :outline_style,    _unset,
					   :text,             LoTitulo,
					   :wrap,             _false,
					   :align_horizontal, :centre,
					   :align_vertical,   :centre,
					   :orientation,      :left_right)
    
    .oPage.add_element(LoTitulo)	

	
_endmethod
$
_pragma(classify_level=restricted, usage={redefinable})
_method c_plano_esquematico_de_principales.busca_bastidores()

	paf << smallworld_product.pni_application()
	mv << paf.plugin(:map_plugin).current_map_view
	objs << mv.get_visible_geometry_set()
	bastidores << equality_set.new()
	
	_if mv.ace_name _is :gs!schematic 
	_then	
		_for itergeom  _over objs.fast_elements()
		_loop		
			_if  (reg <<  itergeom.rwo.source_rwo_records().an_element()) _isnt _unset  _andif
			     reg.source_collection.name _is :mit_bay
			_then
				bastidores.add(reg)
			_endif
		_endloop
		
	_endif
	
	>> bastidores

	
_endmethod
$



_pragma(classify_level=restricted, usage={redefinable})
_method c_plano_esquematico_de_principales.add_sello_tabla_equivalencias_x_cable()
	#---------------------------------------------------
	##  Objetivo  : Agrega la tabla de equiovalencias del cable.
	##
	bastidores     << _self.busca_bastidores()

	_for bastidor  _over bastidores.fast_elements() 
	_loop

		LocableSalida << bastidor.obtener_conexion_de_cables().keys.an_element()
		
		_if Bastidor _isnt _unset _andif
		    LocableSalida _isnt _unset 
		_then
			
			datos <<  property_list.new()
			
			datos[:LoCable]         <<   LocableSalida
			datos[:rme]             <<   Bastidor
			datos[:LoCableObjeto]   <<   c_cable_fo.new(LocableSalida,_false)
			datos[:Central]         <<   Bastidor.user!_central
			datos[:num_de_grupos]   <<   datos[:LoCableObjeto].getgrupos().size
			
			_for iterNF _over 1.upto(datos[:num_de_grupos])
			_loop
				_if datos[:LoCableObjeto].getgrupos()[iterNF][:fibras].size > 0 
				_then
					datos[:numero_fibras] << datos[:LoCableObjeto].getgrupos()[iterNF][:fibras].size
					_leave
				_endif
			_endloop
			
			datos[:capacidad_cable] <<   datos[:num_de_grupos] * datos[:numero_fibras]		 	
			datos[:piso]            <<   Bastidor.ObtenerNumeroDePiso()
			datos[:sala]            <<   Bastidor.ObtenerTipoSala()
			datos[:fila]            <<   Bastidor.ObtenerFila()
			datos[:bastidor]        <<   Bastidor.ObtenerPosBastidor()
			
			_if datos[:num_de_grupos] = 0 _orif
			    datos[:numero_fibras] = 0
			_then
				
				condition.raise(:information,
						:string,
						"No se puede generar tabla de equivalencias por falta de información en las fibras del cable")
			_else
				
				lo_sello << c_tabla_equivalencias_x_cable.new_with(datos ,
										   :bounds,
										   bounding_box.new(2500,627,3490,5687 ))
				.oPage.add_element(lo_sello) 				
			_endif 
			
			
		_endif
			
	_endloop
		
_endmethod
$


