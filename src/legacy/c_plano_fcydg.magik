_pragma(classify_level=restricted, usage={redefinable})
_method c_plano_fcydg.new(_optional oe, tipo_plano)
	## Objetivo:              Este método genera una nueva instancia
	##                        del plano de fosa de cables y
	##                        distribuidor general
	## Parámetros de entrada: N/A.
	## Parámetros de salida:  
	## Regresa:               Una nueva instancia del plano fosa de
	##                        cables y distribuidor general

	
	.LoOE << oe
#write("@ estoy en c_plano_fcydg.new ", tipo_plano)
#        .Stipo_plano << tipo_plano
#	write("------------------------> ", .Stipo_plano)
        >> _clone.init()
	
	
_endmethod
