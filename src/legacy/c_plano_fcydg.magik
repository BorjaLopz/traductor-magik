_package user
$
def_slotted_exemplar (:c_plano_fcydg
                     ,{
                       {:app,       smallworld_product.pni_application(), :writable, :public}
		       ,{:origen,    coordinate.new(200,200),              :writable, :public}
		       ,{:vp_nombre, _unset,                               :writable, :public}
		       ,{:marco,     _unset,                               :writable, :public}
		       ,{:rutas,     _unset,                               :writable, :private}
		       ,{:LoOE,     _unset,                               :writable, :private}
		      }
		     ,{:layout_element, :viewport_layout_mixin}
                     )
$
c_plano_fcydg.define_shared_constant(:allowed_on_menu?, _false, :public)
$
_pragma(classify_level=restricted, usage={redefinable})
_method c_plano_fcydg.abreviaturas(LoPagina)
        ##  Objetivo:              Este método genera el cuadro de abreviaturas del plano Fosa de
	##                         cables y distribuidor general.
        ##  Parámetros de entrada: a sw_layout_page - LoPagina - Página actual del Layout Designer.
        ##  Parámetros de salida:  .
        ##  Regresa:               N/A
	
        _local LoPolilinea       << polyline_layout.new()
        _local LoSector          << _unset
        _local LoSectorRope      << sector_rope.new()
        _local LnDistanciaCorte  << 50
        _local LoTexto           << _unset
	_local LnY0              << 1300
	_local LnPulgada         << 254

	LoPolilinea.line_style   << line_style.new(colour.new_rgb(0, 0, 0), 2)
	
        LoSector                 << sector.new()
        LoSector.add(coordinate(LnPulgada+LnDistanciaCorte+200, LnPulgada+LnDistanciaCorte+LnY0))
        LoSector.add(coordinate(LnPulgada+LnDistanciaCorte+200, LnPulgada+LnDistanciaCorte+LnY0+1000))
        LoSector.add(coordinate(LnPulgada+LnDistanciaCorte+570, LnPulgada+LnDistanciaCorte+LnY0+1000))
        LoSector.add(coordinate(LnPulgada+LnDistanciaCorte+570, LnPulgada+LnDistanciaCorte+LnY0))
        LoSector.add(coordinate(LnPulgada+LnDistanciaCorte+200, LnPulgada+LnDistanciaCorte+LnY0))
        LoSectorRope.add(LoSector)
        LoSector                 << sector.new()
        LoSector.add(coordinate(LnPulgada+LnDistanciaCorte+200, LnPulgada+LnDistanciaCorte+LnY0+900))
        LoSector.add(coordinate(LnPulgada+LnDistanciaCorte+570, LnPulgada+LnDistanciaCorte+LnY0+900))
        LoSectorRope.add(LoSector)
        _for LiLinea _over 1.upto(17)
        _loop
                LoSector         << sector.new()
        		LoSector.add(coordinate(LnPulgada+LnDistanciaCorte+200, LnPulgada+LnDistanciaCorte+LnY0+900-LiLinea*50))
        		LoSector.add(coordinate(LnPulgada+LnDistanciaCorte+570, LnPulgada+LnDistanciaCorte+LnY0+900-LiLinea*50))
        		LoSectorRope.add(LoSector)
       	_endloop
       	LoSector                 << sector.new()
       	LoSector.add(coordinate(LnPulgada+LnDistanciaCorte+300, LnPulgada+LnDistanciaCorte+LnY0+900))
       	LoSector.add(coordinate(LnPulgada+LnDistanciaCorte+300, LnPulgada+LnDistanciaCorte+LnY0))
       	LoSectorRope.add(LoSector)
       	LoTexto                  << textbox_layout.new()
       	LoTexto.text             << "ABREVIATURAS PARA CAPACIDAD DE CABLE"
       	LoTexto.bounds           << bounding_box.new(LnPulgada+LnDistanciaCorte+200, LnPulgada+LnDistanciaCorte+LnY0+900,
       						     LnPulgada+LnDistanciaCorte+570, LnPulgada+LnDistanciaCorte+LnY0+1000)
        LoTexto.outline_style    << _unset
        LoTexto.align_vertical   << :centre
        LoTexto.align_horizontal << :centre
        LoTexto.font_size        << 3
        LoPagina.add_element(LoTexto)
        LoTexto                  << textbox_layout.new()
        LoTexto.text             << "ABREVIATURAS PARA CAPACIDAD DE CABLE"
        LoTexto.bounds           << bounding_box.new(LnPulgada+LnDistanciaCorte+200, LnPulgada+LnDistanciaCorte+LnY0+900,
        					     LnPulgada+LnDistanciaCorte+570, LnPulgada+LnDistanciaCorte+LnY0+1000)
        LoTexto.outline_style    << _unset
        LoTexto.align_vertical   << :centre
        LoTexto.align_horizontal << :centre
        LoTexto.font_size        << 3
        LoPagina.add_element(LoTexto)
        LoTexto                  << textbox_layout.new()
        LoTexto.text             << "A"	
        LoTexto.bounds           << bounding_box.new(LnPulgada+LnDistanciaCorte+200, LnPulgada+LnDistanciaCorte+LnY0+900,
        					     LnPulgada+LnDistanciaCorte+300, LnPulgada+LnDistanciaCorte+LnY0+850)
        LoTexto.outline_style    << _unset
        LoTexto.align_vertical   << :centre
        #	LoTexto.align_horizontal << :centre
        LoTexto.font_size        << 3
        LoPagina.add_element(LoTexto)
        LoTexto                  << textbox_layout.new()
        LoTexto.text             << "10 ps."
        LoTexto.bounds           << bounding_box.new(LnPulgada+LnDistanciaCorte+300, LnPulgada+LnDistanciaCorte+LnY0+900,
        					     LnPulgada+LnDistanciaCorte+570, LnPulgada+LnDistanciaCorte+LnY0+850)
        LoTexto.outline_style    << _unset
        LoTexto.align_vertical   << :centre
        #	LoTexto.align_horizontal << :centre
        LoTexto.font_size        << 3
        LoPagina.add_element(LoTexto)
        LoTexto                  << textbox_layout.new()
        LoTexto.text             << "B"
        LoTexto.bounds           << bounding_box.new(LnPulgada+LnDistanciaCorte+200, LnPulgada+LnDistanciaCorte+LnY0+850,
        				             LnPulgada+LnDistanciaCorte+300, LnPulgada+LnDistanciaCorte+LnY0+800)
        LoTexto.outline_style    << _unset
        LoTexto.align_vertical   << :centre
        #	LoTexto.align_horizontal << :centre
        LoTexto.font_size        << 3
        LoPagina.add_element(LoTexto)
        LoTexto                  << textbox_layout.new()
        LoTexto.text             << "20 ps."
