_pragma(classify_level=restricted, usage={redefinable})
_method c_plano_fcydg.pie_de_plano(LoPagina)
        ##  Objetivo:              Este método genera el pié de plano del plano Fosa de cables y
	##                         distribuidor general.
        ##  Parámetros de entrada: a sw_layout_page - LoPagina - Página actual del Layout Designer.
        ##  Parámetros de salida:  .
        ##  Regresa:               N/A
	
        _local LnDistanciaCorte  << 50
        _local LoSectorRope      << sector_rope.new()
        _local LoPolilinea       << polyline_layout.new()
        _local LoTexto

	LoPolilinea.line_style   << line_style.new(colour.new_rgb(0, 0, 0), 2)	
	
        #Pié de plano
        LoSector                 << sector.new()
        LoSector.add(coordinate(2*LnDistanciaCorte,      2*LnDistanciaCorte+2790))
        LoSector.add(coordinate(2*LnDistanciaCorte+150,  2*LnDistanciaCorte+2790))
        LoSector.add(coordinate(2*LnDistanciaCorte+150,  2*LnDistanciaCorte+150))
        LoSector.add(coordinate(2*LnDistanciaCorte+2050, 2*LnDistanciaCorte+150))
        LoSector.add(coordinate(2*LnDistanciaCorte+2050, 2*LnDistanciaCorte))	
        LoSectorRope.add(LoSector)
        LoSector                 << sector.new()
        LoSector.add(coordinate(2*LnDistanciaCorte+150, 2*LnDistanciaCorte+150))
        LoSector.add(coordinate(2*LnDistanciaCorte+150, 2*LnDistanciaCorte))
        LoSectorRope.add(LoSector)
        LoSector                 << sector.new()
        LoSector.add(coordinate(2*LnDistanciaCorte+400, 2*LnDistanciaCorte+150))
        LoSector.add(coordinate(2*LnDistanciaCorte+400, 2*LnDistanciaCorte))
        LoSectorRope.add(LoSector)
        LoSector                 << sector.new()
        LoSector.add(coordinate(2*LnDistanciaCorte+400, 2*LnDistanciaCorte+100))
        LoSector.add(coordinate(2*LnDistanciaCorte+900, 2*LnDistanciaCorte+100))
        LoSectorRope.add(LoSector)
        LoSector                 << sector.new()
        LoSector.add(coordinate(2*LnDistanciaCorte+400, 2*LnDistanciaCorte+50))
        LoSector.add(coordinate(2*LnDistanciaCorte+750, 2*LnDistanciaCorte+50))
        LoSectorRope.add(LoSector)	
        LoSector                 << sector.new()
        LoSector.add(coordinate(2*LnDistanciaCorte+550, 2*LnDistanciaCorte+150))
        LoSector.add(coordinate(2*LnDistanciaCorte+550, 2*LnDistanciaCorte))
        LoSectorRope.add(LoSector)
        LoSector                 << sector.new()
        LoSector.add(coordinate(2*LnDistanciaCorte+750, 2*LnDistanciaCorte+150))
        LoSector.add(coordinate(2*LnDistanciaCorte+750, 2*LnDistanciaCorte))
        LoSectorRope.add(LoSector)
        LoSector                 << sector.new()
        LoSector.add(coordinate(2*LnDistanciaCorte+900, 2*LnDistanciaCorte+150))
        LoSector.add(coordinate(2*LnDistanciaCorte+900, 2*LnDistanciaCorte))
        LoSectorRope.add(LoSector)
        LoSector                 << sector.new()
        LoSector.add(coordinate(2*LnDistanciaCorte+1600, 2*LnDistanciaCorte+150))
        LoSector.add(coordinate(2*LnDistanciaCorte+1600, 2*LnDistanciaCorte))
        LoSectorRope.add(LoSector)
        LoSector                 << sector.new()
        LoSector.add(coordinate(2*LnDistanciaCorte+2050, 2*LnDistanciaCorte+150))
        LoSector.add(coordinate(2*LnDistanciaCorte+2050, 2*LnDistanciaCorte))
        LoSectorRope.add(LoSector)
        LoPolilinea.sectors      << LoSectorRope
        LoPagina.add_element(LoPolilinea)		

        #Texto	
        LoTexto                  << textbox_layout.new()
        LoTexto.text             << "FOSA DE CABLES Y DISTRIBUIDOR GENERAL"
        LoTexto.bounds           << bounding_box.new(2*LnDistanciaCorte+1020,
                                    2*LnDistanciaCorte+170,
                                    2*LnDistanciaCorte+2400,
                                    2*LnDistanciaCorte+300)
        LoTexto.outline_style    << _unset
        LoPagina.add_element(LoTexto)	
        LoTexto                  << textbox_layout.new()
        LoTexto.text             << "Delegación o municipio:"
        LoTexto.bounds           << bounding_box.new(2*LnDistanciaCorte+2090,
                                    2*LnDistanciaCorte+20,
                                    2*LnDistanciaCorte+2794,
                                    2*LnDistanciaCorte+110)
        LoTexto.outline_style    << _unset	
        LoPagina.add_element(LoTexto)
        LoTexto                  << textbox_layout.new()
        LoTexto.text             << "TELEFONOS DE MEXICO S.A. de C.V."
        LoTexto.bounds           << bounding_box.new(2*LnDistanciaCorte+155,
						            2*LnDistanciaCorte+5,
						            2*LnDistanciaCorte+395,
						            2*LnDistanciaCorte+145)
        LoTexto.outline_style    << _unset
        LoTexto.align_vertical   << :centre
        LoTexto.align_horizontal << :centre
        LoTexto.font_size        << 3
        LoPagina.add_element(LoTexto)
        LoTexto                  << textbox_layout.new()
        LoTexto.text             << "FECHA"
        LoTexto.bounds           << bounding_box.new(2*LnDistanciaCorte+405,
                                    2*LnDistanciaCorte+105,
                                    2*LnDistanciaCorte+545,
                                    2*LnDistanciaCorte+145)
        LoTexto.align_vertical   << :centre
        LoTexto.outline_style    << _unset
        LoTexto.font_size        << 3
        LoPagina.add_element(LoTexto)
        LoTexto                  << textbox_layout.new()
        LoTexto.text             << "DIBUJÓ"
        LoTexto.bounds           << bounding_box.new(2*LnDistanciaCorte+405,
                                    2*LnDistanciaCorte+55,
                                    2*LnDistanciaCorte+545,
                                    2*LnDistanciaCorte+95)
        LoTexto.align_vertical   << :centre	
        LoTexto.outline_style    << _unset
        LoTexto.font_size        << 3
        LoPagina.add_element(LoTexto)
        LoTexto                  << textbox_layout.new()
        LoTexto.text             << "REVISÓ"
        LoTexto.bounds           << bounding_box.new(2*LnDistanciaCorte+405,
                                                     2*LnDistanciaCorte+5,
                                                     2*LnDistanciaCorte+545,
                                                     2*LnDistanciaCorte+45)
        LoTexto.align_vertical   << :centre	
        LoTexto.outline_style    << _unset
        LoTexto.font_size        << 3
        LoPagina.add_element(LoTexto)
        LoTexto << textbox_layout.new()
       	LoTexto.text             << "ESCALA"
        LoTexto.bounds           << bounding_box.new(2*LnDistanciaCorte+755,
                                                     2*LnDistanciaCorte+105,
                                                     2*LnDistanciaCorte+895,
                                                     2*LnDistanciaCorte+145)
        LoTexto.align_vertical   << :centre	
        LoTexto.outline_style    << _unset
        LoTexto.font_size        << 3
        LoPagina.add_element(LoTexto)	
_endmethod
