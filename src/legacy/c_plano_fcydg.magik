                                                     LnPulgada+LnDistanciaCorte+570, LnPulgada+LnDistanciaCorte+LnY0+800)
        LoTexto.outline_style    << _unset
        LoTexto.align_vertical   << :centre
        #	LoTexto.align_horizontal << :centre
        LoTexto.font_size        << 3
        LoPagina.add_element(LoTexto)
        LoTexto                  << textbox_layout.new()
        LoTexto.text             << "C"
        LoTexto.bounds           << bounding_box.new( LnPulgada+LnDistanciaCorte+200,  LnPulgada+LnDistanciaCorte+LnY0+800,
        				              LnPulgada+LnDistanciaCorte+300,  LnPulgada+LnDistanciaCorte+LnY0+750)
        LoTexto.outline_style    << _unset
        LoTexto.align_vertical   << :centre
        #	LoTexto.align_horizontal << :centre
