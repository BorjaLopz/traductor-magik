        				              LnPulgada+LnDistanciaCorte+300,  LnPulgada+LnDistanciaCorte+LnY0+700)
        LoTexto.outline_style    << _unset
        LoTexto.align_vertical   << :centre
        #	LoTexto.align_horizontal << :centre
