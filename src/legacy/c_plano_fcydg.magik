        LoTexto                  << textbox_layout.new()
        LoTexto.text             << "COAXIAL"
        LoTexto.bounds           << bounding_box.new(LnPulgada+LnDistanciaCorte+300, LnPulgada+LnDistanciaCorte+LnY0+100,
                                                     LnPulgada+LnDistanciaCorte+570, LnPulgada+LnDistanciaCorte+LnY0+50)
        LoTexto.outline_style    << _unset
        LoTexto.align_vertical   << :centre
        LoTexto.font_size        << 3
        LoPagina.add_element(LoTexto)
        LoTexto                  << textbox_layout.new()
        LoTexto.text             << "Z"
        LoTexto.bounds           << bounding_box.new(LnPulgada+LnDistanciaCorte+200, LnPulgada+LnDistanciaCorte+LnY0+50,
                                                     LnPulgada+LnDistanciaCorte+300, LnPulgada+LnDistanciaCorte+LnY0)
        LoTexto.outline_style    << _unset
        LoTexto.align_vertical   << :centre
        LoTexto.font_size        << 3
        LoPagina.add_element(LoTexto)
        LoTexto                  << textbox_layout.new()
        LoTexto.text             << "FIBRA OPTICA"
        LoTexto.bounds           << bounding_box.new(LnPulgada+LnDistanciaCorte+300, LnPulgada+LnDistanciaCorte+LnY0+50,
                                                     LnPulgada+LnDistanciaCorte+570, LnPulgada+LnDistanciaCorte+LnY0)
        LoTexto.outline_style    << _unset
        LoTexto.align_vertical   << :centre
        LoTexto.font_size        << 3
        LoPagina.add_element(LoTexto)
        LoPolilinea.sectors      << LoSectorRope
        LoPagina.add_element(LoPolilinea)
_endmethod
$
_pragma(classify_level=restricted, usage={redefinable})
_method c_plano_fcydg.AddTitulo(PoMarco)
	## Objetivo: Agregar el titulo al plano
	## Autor: lgranados
	
	LoPage << .app.plugin(:layout_plugin).start_layout_designer().plugin(:layout_manager).current_document.current_page
	LoTitulo << _self.crea_titulo
	
	LoBB << bounding_box.new(PoMarco.bounds.xmax-2200,
				 PoMarco.bounds.ymin+200,
				 PoMarco.bounds.xmax-200,
				 PoMarco.bounds.ymin+600)
	
	LoTitulo << c_titulo_de_plano.new_with(:bounds,           LoBB,
					       :font_name,        "bold",
					       :font_size,        8,
					       :fill_style,       _unset,
					       :outline_style,    _unset,
					       :text,             LoTitulo,
					       :wrap,             _false,
					       :align_horizontal, :centre,
					       :align_vertical,   :centre,
					       :orientation,      :left_right)
	
	LoPage.add_element(LoTitulo)	
	
	
_endmethod
$
_pragma(classify_level=restricted, usage={redefinable})
_method c_plano_fcydg.crea_titulo
	## Objetivo: Crea el texto del titulo
	## Autor: lgranados
	
	LoProyecto << swg_dsn_admin_engine.active_scheme.project
	LoTitulo << "FOSA DE CABLES" + %newline +
		    "CENTRAL: " + LoProyecto.user!_central.user!_nombre + %newline +
		    LoProyecto.user!_central.user!_central + %newline +
		    LoProyecto.user!_programa_tipo + %newline +
		    LoProyecto.user!_fecha_entrega.write_string

	_return LoTitulo
	
_endmethod
$
_pragma(classify_level=restricted, usage={redefinable})
_method c_plano_fcydg.defined_attributes
        ##  Objetivo:              Este método define atirbutos de este plano.
        ##  Parámetros de entrada: N/A.
        ##  Parámetros de salida:  sw:rope:[1-4] - _super.defined_attributes -
	##                         atributos de viewport_layout_mixin.
        ##                         sw:layout_attribute_definition -
	##                         _self.viewport_attribute_definition - .
        ##  Regresa:               sw:rope:[1-5] - attribs - Regresa Los atributos de este plano.
	
        attribs                    << rope.new_from(_super.defined_attributes)
        attribs.add (_self.viewport_attribute_definition)
        >> attribs
_endmethod
$
c_plano_fcydg.define_attributes()
$
_pragma(classify_level=restricted, usage={redefinable})
_method c_plano_fcydg.genera_plano(tipo_plano)
        ##  Objetivo:              Este método genera el plano Fosa de cables y distribuidor
	##                         general.
        ##  Parámetros de entrada: N/A.
        ##  Parámetros de salida:  a sw:layout_page - LoPagina - Página actual del Layout Designer.
        ##  Regresa:               N/A

        _local LoDocumento        << .app.plugin(:layout_plugin).start_layout_designer().plugin(:layout_manager).current_document
        LoDocumento.name          << "Plano fosa de cables y distribuidor general"
	LoDocumento.user!_tipo_plano << tipo_plano
        _local LoPagina           << LoDocumento.current_page
        _local LnDistanciaCorte   << 50
        _local LnPulgada          << 254
        _local LnCartaHorizontal  << 8.5*LnPulgada
        _local LnCartaVertical    << 11*LnPulgada
        _local LnMarcoHorizontal  << 2*3*LnCartaHorizontal
        _local LnMarcoVertical    << 3*LnCartaVertical
        _local LnPaginaHorizontal << 2*LnDistanciaCorte+2*LnPulgada+LnMarcoHorizontal
        _local LnPaginaVertical   << 2*LnDistanciaCorte+2*LnPulgada+LnMarcoVertical
        LoPagina.set_paper_size(LnPaginaHorizontal, LnPaginaVertical)

       .marco << _self.marco(LoPagina)
       _self.AddTitulo(.marco)
  
        _local LoSello << c_sello_estandar_ctl_edo.new_with(:bounds,
							    bounding_box.new(LnPulgada+50,
									     LnPulgada+50,
									     LnPulgada+50+2950,
									     LnPulgada+50+2740))
	LoPagina.add_element(LoSello)
        _local LoPep << c_pep.new_with(:bounds,
				       bounding_box.new(LnPulgada+250,
							LnPulgada+1300,
							LnPulgada+2950,
							LnPulgada))
	LoPep.oe << .LoOE

	LoPagina.add_element(LoPep)
        _self.abreviaturas(LoPagina)
	
_endmethod
$
_pragma(classify_level=restricted, usage={redefinable})
_method c_plano_fcydg.init()
	## Objetivo:              Este método inicializa una nueva instancia
	##                        del plano de fosa de cables y
	##                        distribuidor general
	## Parámetros de entrada: N/A
	## Parámetros de salida:  N/A
	## Regresa:               Esta instancia
	
	.app                      << smallworld_product.pni_application()
	>> _self
_endmethod
$
_pragma(classify_level=restricted, usage={redefinable})
_method c_plano_fcydg.marco(LoPagina)
        ##  Objetivo:              Este método genera el marco del plano Fosa de cables y
	##                         distribuidor general.
        ##  Parámetros de entrada: a sw_layout_page - LoPagina - Página actual del Layout Designer.
        ##  Parámetros de salida:  .
        ##  Regresa:               N/A
	
	LoMarco << c_marco.new_with(:bounds,bounding_box.new(0, 0, 1, 1))
	LoMarco.Largo << 6
	LoMarco.Alto << 3
	LoMarco.set_fill_colour(_unset)
	LoPagina.add_element(LoMarco)
	
	_return LoMarco
_endmethod
