                                                     2*LnDistanciaCorte+300, 2*LnDistanciaCorte+LnY0+200)
        LoTexto.outline_style    << _unset
        LoTexto.align_vertical   << :centre
        LoTexto.font_size        << 3
        LoPagina.add_element(LoTexto)
        LoTexto                  << textbox_layout.new()
        LoTexto.text             << "2400 ps."
        LoTexto.bounds           << bounding_box.new(2*LnDistanciaCorte+300, 2*LnDistanciaCorte+LnY0+250,
                                                     2*LnDistanciaCorte+570, 2*LnDistanciaCorte+LnY0+200)
        LoTexto.outline_style    << _unset
        LoTexto.align_vertical   << :centre
        LoTexto.font_size        << 3
        LoPagina.add_element(LoTexto)	
        LoTexto                  << textbox_layout.new()
        LoTexto.text             << "T"
        LoTexto.bounds           << bounding_box.new(2*LnDistanciaCorte+200, 2*LnDistanciaCorte+LnY0+200,
                                                     2*LnDistanciaCorte+300, 2*LnDistanciaCorte+LnY0+150)
        LoTexto.outline_style    << _unset
        LoTexto.align_vertical   << :centre
        LoTexto.font_size        << 3
        LoPagina.add_element(LoTexto)
        LoTexto                  << textbox_layout.new()
        LoTexto.text             << "TRONCAL"
        LoTexto.bounds           << bounding_box.new(2*LnDistanciaCorte+300, 2*LnDistanciaCorte+LnY0+200,
                                                     2*LnDistanciaCorte+570, 2*LnDistanciaCorte+LnY0+150)
        LoTexto.outline_style    << _unset
        LoTexto.align_vertical   << :centre
        LoTexto.font_size        << 3
        LoPagina.add_element(LoTexto)
        LoTexto                  << textbox_layout.new()
        LoTexto.text             << "V"
        LoTexto.bounds           << bounding_box.new(2*LnDistanciaCorte+200, 2*LnDistanciaCorte+LnY0+150,
                                                     2*LnDistanciaCorte+300, 2*LnDistanciaCorte+LnY0+100)
        LoTexto.outline_style    << _unset
        LoTexto.align_vertical   << :centre
        LoTexto.font_size        << 3
        LoPagina.add_element(LoTexto)
        LoTexto                  << textbox_layout.new()
        LoTexto.text             << "VIDEO"
        LoTexto.bounds           << bounding_box.new(2*LnDistanciaCorte+300, 2*LnDistanciaCorte+LnY0+150,
                                                     2*LnDistanciaCorte+570, 2*LnDistanciaCorte+LnY0+100)
        LoTexto.outline_style    << _unset
        LoTexto.align_vertical   << :centre
        LoTexto.font_size        << 3
        LoPagina.add_element(LoTexto)
        LoTexto                  << textbox_layout.new()
        LoTexto.text             << "X"
        LoTexto.bounds           << bounding_box.new(2*LnDistanciaCorte+200, 2*LnDistanciaCorte+LnY0+100,
                                                     2*LnDistanciaCorte+300, 2*LnDistanciaCorte+LnY0+50)
        LoTexto.outline_style    << _unset
        LoTexto.align_vertical   << :centre
        LoTexto.font_size        << 3
        LoPagina.add_element(LoTexto)
        LoTexto                  << textbox_layout.new()
        LoTexto.text             << "COAXIAL"
        LoTexto.bounds           << bounding_box.new(2*LnDistanciaCorte+300, 2*LnDistanciaCorte+LnY0+100,
                                                     2*LnDistanciaCorte+570, 2*LnDistanciaCorte+LnY0+50)
        LoTexto.outline_style    << _unset
        LoTexto.align_vertical   << :centre
