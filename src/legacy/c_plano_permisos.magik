_pragma(classify_level=restricted, usage={redefinable})
_method c_plano_permisos.defined_attributes
        ##  Objetivo:              Este método define atributos de este plano.
        ##  Parámetros de entrada: N/A.
        ##  Parámetros de salida:  sw:rope:[1-4] - _super.defined_attributes -
	##                         atributos de viewport_layout_mixin.
        ##                         sw:layout_attribute_definition -
	##                         _self.viewport_attribute_definition - .
        ##  Regresa:               sw:rope:[1-5] - attribs - Regresa Los atributos de este plano.
	
        attribs                    << rope.new_from(_super.defined_attributes)
        attribs.add (_self.viewport_attribute_definition)
        >> attribs
_endmethod
$
c_plano_permisos.define_attributes()
