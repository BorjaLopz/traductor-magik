_pragma(classify_level=restricted, usage={redefinable})
_method c_plano_permisos.sello_pep(LoPagina)
        ##  Objetivo:              Este método genera el cuadro de
        ##                         sello pep del plano de permisos.
        ##  Parámetros de entrada: a sw_layout_page - LoPagina - Página actual del Layout Designer.
        ##  Parámetros de salida:  .
        ##  Regresa:               N/A
	
        _local LoSector
        _local LoSectorRope      << sector_rope.new()
        _local LoPolilinea       << polyline_layout.new()
        _local LnDistanciaCorte  << _unset

	LoPolilinea.line_style   << line_style.new(colour.new_rgb(0, 0, 0), 2)
        LnDistanciaCorte         << 50

        #Sello PEP
        LoSector                 << sector.new()
        LoSector.add(coordinate(2*LnDistanciaCorte+200, 2*LnDistanciaCorte+200))
        LoSector.add(coordinate(2*LnDistanciaCorte+200, 2*LnDistanciaCorte+270))
        LoSector.add(coordinate(2*LnDistanciaCorte+980, 2*LnDistanciaCorte+270))
        LoSector.add(coordinate(2*LnDistanciaCorte+980, 2*LnDistanciaCorte+200))
        LoSector.add(coordinate(2*LnDistanciaCorte+200, 2*LnDistanciaCorte+200))
        LoSectorRope.add(LoSector)
        LoSector                 << sector.new()
        LoSector.add(coordinate(2*LnDistanciaCorte+200, 2*LnDistanciaCorte+320))
        LoSector.add(coordinate(2*LnDistanciaCorte+200, 2*LnDistanciaCorte+470))
        LoSector.add(coordinate(2*LnDistanciaCorte+980, 2*LnDistanciaCorte+470))
        LoSector.add(coordinate(2*LnDistanciaCorte+980, 2*LnDistanciaCorte+320))
        LoSector.add(coordinate(2*LnDistanciaCorte+200, 2*LnDistanciaCorte+320))
        LoSectorRope.add(LoSector)
        LoSector                 << sector.new()
        LoSector.add(coordinate(2*LnDistanciaCorte+200, 2*LnDistanciaCorte+420))
        LoSector.add(coordinate(2*LnDistanciaCorte+980, 2*LnDistanciaCorte+420))
        LoSectorRope.add(LoSector)
        LoSector                 << sector.new()
        LoSector.add(coordinate(2*LnDistanciaCorte+460, 2*LnDistanciaCorte+320))
        LoSector.add(coordinate(2*LnDistanciaCorte+460, 2*LnDistanciaCorte+470))
        LoSectorRope.add(LoSector)
        LoSector                 << sector.new()
        LoSector.add(coordinate(2*LnDistanciaCorte+720, 2*LnDistanciaCorte+320))
        LoSector.add(coordinate(2*LnDistanciaCorte+720, 2*LnDistanciaCorte+470))
        LoSectorRope.add(LoSector)
        LoSector                 << sector.new()
        LoSector.add(coordinate(2*LnDistanciaCorte+200, 2*LnDistanciaCorte+520))
        LoSector.add(coordinate(2*LnDistanciaCorte+200, 2*LnDistanciaCorte+770))
        LoSector.add(coordinate(2*LnDistanciaCorte+980, 2*LnDistanciaCorte+770))
        LoSector.add(coordinate(2*LnDistanciaCorte+980, 2*LnDistanciaCorte+520))
        LoSector.add(coordinate(2*LnDistanciaCorte+200, 2*LnDistanciaCorte+520))	
        LoSectorRope.add(LoSector)
        LoSector                 << sector.new()
        LoSector.add(coordinate(2*LnDistanciaCorte+200, 2*LnDistanciaCorte+570))
        LoSector.add(coordinate(2*LnDistanciaCorte+980, 2*LnDistanciaCorte+570))
        LoSectorRope.add(LoSector)	
        LoSector                 << sector.new()
        LoSector.add(coordinate(2*LnDistanciaCorte+200, 2*LnDistanciaCorte+620))
        LoSector.add(coordinate(2*LnDistanciaCorte+980, 2*LnDistanciaCorte+620))
        LoSectorRope.add(LoSector)	
        LoSector                 << sector.new()
        LoSector.add(coordinate(2*LnDistanciaCorte+200, 2*LnDistanciaCorte+670))
        LoSector.add(coordinate(2*LnDistanciaCorte+980, 2*LnDistanciaCorte+670))
        LoSectorRope.add(LoSector)	
        LoSector                 << sector.new()
        LoSector.add(coordinate(2*LnDistanciaCorte+200, 2*LnDistanciaCorte+720))
        LoSector.add(coordinate(2*LnDistanciaCorte+980, 2*LnDistanciaCorte+720))
        LoSectorRope.add(LoSector)
        LoSector                 << sector.new()
        LoSector.add(coordinate(2*LnDistanciaCorte+590, 2*LnDistanciaCorte+520))
        LoSector.add(coordinate(2*LnDistanciaCorte+590, 2*LnDistanciaCorte+720))
        LoSectorRope.add(LoSector)
        LoSector                 << sector.new()
        LoSector.add(coordinate(2*LnDistanciaCorte+200, 2*LnDistanciaCorte+800))
        LoSector.add(coordinate(2*LnDistanciaCorte+200, 2*LnDistanciaCorte+950))
        LoSector.add(coordinate(2*LnDistanciaCorte+980, 2*LnDistanciaCorte+950))
        LoSector.add(coordinate(2*LnDistanciaCorte+980, 2*LnDistanciaCorte+800))
        LoSector.add(coordinate(2*LnDistanciaCorte+200, 2*LnDistanciaCorte+800))
        LoSectorRope.add(LoSector)
        LoSector                 << sector.new()
        LoSector.add(coordinate(2*LnDistanciaCorte+200, 2*LnDistanciaCorte+880))
        LoSector.add(coordinate(2*LnDistanciaCorte+980, 2*LnDistanciaCorte+880))
        LoSectorRope.add(LoSector)
        LoSector                 << sector.new()
        LoSector.add(coordinate(2*LnDistanciaCorte+460, 2*LnDistanciaCorte+800))
        LoSector.add(coordinate(2*LnDistanciaCorte+460, 2*LnDistanciaCorte+950))	
        LoSectorRope.add(LoSector)
        LoSector                 << sector.new()
        LoSector.add(coordinate(2*LnDistanciaCorte+720, 2*LnDistanciaCorte+800))
        LoSector.add(coordinate(2*LnDistanciaCorte+720, 2*LnDistanciaCorte+950))	
        LoSectorRope.add(LoSector)	
        LoSector                 << sector.new()
        LoSector.add(coordinate(2*LnDistanciaCorte+200, 2*LnDistanciaCorte+980))
        LoSector.add(coordinate(2*LnDistanciaCorte+200, 2*LnDistanciaCorte+1070))
