_pragma(classify_level=restricted, usage={redefinable})
_method c_plano_permisos.init()
	## Objetivo:              Este método inicializa una nueva instancia
	##                        del plano de permisos
	## Parámetros de entrada: N/A
	## Parámetros de salida:  N/A
	## Regresa:               Esta instancia
	
	.app                      << smallworld_product.pni_application()
	.ancho                    << 5
	.alto                     << 2
	>> _self
_endmethod
