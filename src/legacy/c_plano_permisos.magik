        LoPagina.add_element(LoTexto)
        LoTexto                  << textbox_layout.new()
        LoTexto.text             << "1200 ps."
        LoTexto.bounds           << bounding_box.new(2*LnDistanciaCorte+300, 2*LnDistanciaCorte+LnY0+350,
        					     2*LnDistanciaCorte+570, 2*LnDistanciaCorte+LnY0+300)
        LoTexto.outline_style    << _unset
        LoTexto.align_vertical   << :centre
        #	LoTexto.align_horizontal << :centre
        LoTexto.font_size        << 3
        LoPagina.add_element(LoTexto)		
        	
        LoPolilinea.sectors      << LoSectorRope
        LoPagina.add_element(LoPolilinea)
        LoTexto                  << textbox_layout.new()
        LoTexto.text             << "M"
        LoTexto.bounds           << bounding_box.new(2*LnDistanciaCorte+200, 2*LnDistanciaCorte+LnY0+300,
        					     2*LnDistanciaCorte+300, 2*LnDistanciaCorte+LnY0+250)
        LoTexto.outline_style    << _unset
        LoTexto.align_vertical   << :centre
        LoTexto.font_size        << 3
