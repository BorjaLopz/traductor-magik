def_slotted_exemplar (:c_plano_permisos
                     ,{
                       {:app,   _unset, :writable, :public}
		      ,{:ancho, _unset, :writable, :private}
		      ,{:alto,  _unset, :writable, :private}
		      }
		     ,{:layout_element, :viewport_layout_mixin}
                     )
