_pragma(classify_level=restricted, usage={redefinable})
_method c_plano_permisos.new()
	## Objetivo:              Este método genera una nueva instancia
	##                        del plano de permisos
	## Parámetros de entrada: N/A.
	## Parámetros de salida:  
	## Regresa:               Una nueva instancia del plano de permisos
	
        >> _clone.init()
	
	
_endmethod
