_pragma(classify_level=restricted, usage={redefinable})
_method c_plano_permisos.abreviaturas(LoPagina)
        ##  Objetivo:              Este método genera el cuadro de
        ##                         abreviaturas del plano de permisos.
        ##  Parámetros de entrada: a sw_layout_page - LoPagina - Página actual del Layout Designer.
        ##  Parámetros de salida:  .
        ##  Regresa:               N/A
	
        _local LoPolilinea       << polyline_layout.new()
        _local LoSector          << _unset
        _local LoSectorRope      << sector_rope.new()
        _local LnDistanciaCorte  << 50
        _local LoTexto           << _unset
	_local LnY0              << 1300

	LoPolilinea.line_style   << line_style.new(colour.new_rgb(0, 0, 0), 2)
	
        LoSector                 << sector.new()
        LoSector.add(coordinate(2*LnDistanciaCorte+200, 2*LnDistanciaCorte+LnY0))
        LoSector.add(coordinate(2*LnDistanciaCorte+200, 2*LnDistanciaCorte+LnY0+1000))
        LoSector.add(coordinate(2*LnDistanciaCorte+570, 2*LnDistanciaCorte+LnY0+1000))
        LoSector.add(coordinate(2*LnDistanciaCorte+570, 2*LnDistanciaCorte+LnY0))
        LoSector.add(coordinate(2*LnDistanciaCorte+200, 2*LnDistanciaCorte+LnY0))
        LoSectorRope.add(LoSector)
        LoSector                 << sector.new()
        LoSector.add(coordinate(2*LnDistanciaCorte+200, 2*LnDistanciaCorte+LnY0+900))
        LoSector.add(coordinate(2*LnDistanciaCorte+570, 2*LnDistanciaCorte+LnY0+900))
        LoSectorRope.add(LoSector)
        _for LiLinea _over 1.upto(17)
        _loop
                LoSector         << sector.new()
        		LoSector.add(coordinate(2*LnDistanciaCorte+200, 2*LnDistanciaCorte+LnY0+900-LiLinea*50))
        		LoSector.add(coordinate(2*LnDistanciaCorte+570, 2*LnDistanciaCorte+LnY0+900-LiLinea*50))
        		LoSectorRope.add(LoSector)
       	_endloop
       	LoSector                 << sector.new()
       	LoSector.add(coordinate(2*LnDistanciaCorte+300, 2*LnDistanciaCorte+LnY0+900))
       	LoSector.add(coordinate(2*LnDistanciaCorte+300, 2*LnDistanciaCorte+LnY0))
       	LoSectorRope.add(LoSector)
       	LoTexto                  << textbox_layout.new()
       	LoTexto.text             << "ABREVIATURAS PARA CAPACIDAD DE CABLE"
       	LoTexto.bounds           << bounding_box.new(2*LnDistanciaCorte+200, 2*LnDistanciaCorte+LnY0+900,
       						     2*LnDistanciaCorte+570, 2*LnDistanciaCorte+LnY0+1000)
        LoTexto.outline_style    << _unset
        LoTexto.align_vertical   << :centre
        LoTexto.align_horizontal << :centre
        LoTexto.font_size        << 3
        LoPagina.add_element(LoTexto)
        LoTexto                  << textbox_layout.new()
        LoTexto.text             << "ABREVIATURAS PARA CAPACIDAD DE CABLE"
        LoTexto.bounds           << bounding_box.new(2*LnDistanciaCorte+200, 2*LnDistanciaCorte+LnY0+900,
        					     2*LnDistanciaCorte+570, 2*LnDistanciaCorte+LnY0+1000)
        LoTexto.outline_style    << _unset
        LoTexto.align_vertical   << :centre
        LoTexto.align_horizontal << :centre
        LoTexto.font_size        << 3
        LoPagina.add_element(LoTexto)
        LoTexto                  << textbox_layout.new()
        LoTexto.text             << "A"	
        LoTexto.bounds           << bounding_box.new(2*LnDistanciaCorte+200, 2*LnDistanciaCorte+LnY0+900,
        					     2*LnDistanciaCorte+300, 2*LnDistanciaCorte+LnY0+850)
        LoTexto.outline_style    << _unset
        LoTexto.align_vertical   << :centre
        #	LoTexto.align_horizontal << :centre
        LoTexto.font_size        << 3
        LoPagina.add_element(LoTexto)
        LoTexto                  << textbox_layout.new()
        LoTexto.text             << "10 ps."
        LoTexto.bounds           << bounding_box.new(2*LnDistanciaCorte+300, 2*LnDistanciaCorte+LnY0+900,
        					     2*LnDistanciaCorte+570, 2*LnDistanciaCorte+LnY0+850)
        LoTexto.outline_style    << _unset
        LoTexto.align_vertical   << :centre
        #	LoTexto.align_horizontal << :centre
        LoTexto.font_size        << 3
        LoPagina.add_element(LoTexto)
        LoTexto                  << textbox_layout.new()
        LoTexto.text             << "B"
