#							    bounding_box.new(LnPulgada+50,
#									     LnPulgada+50,
#									     LnPulgada+50+2950,
#									     LnPulgada+50+2740))
#	LoSello.Inicializa()
#	LoPagina.add_element(LoSello)
#
#        _local LoPep << c_pep.new_with(:bounds,
#				       bounding_box.new(LnPulgada+250,
#							LnPulgada+1300,
#							LnPulgada+2950,
#							LnPulgada))
#	LoPep.Inicializa()
#	LoPagina.add_element(LoPep)

#
#        _self.sello_pep(LoPagina)
#        _self.abreviaturas(LoPagina)

