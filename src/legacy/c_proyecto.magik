_pragma(classify_level=restricted, usage={redefinable})
_method c_Proyecto.obten_peps_por_tipo()
	## Metodo para obtener todas las peps del proyecto agrupadas
	## por rubro y tipo (rubro: contruccion o desmontaje), (tipo:
	## fibra, cobre, canalizacion), asi como cada unidad contable
	## (opbs, oeis, oes) de cada rubro y tipo de pep.
	##	
	plInfo << property_list.new_with(:construccion,
					 property_list.new_with(:fibra,rope.new(),
								:cobre,rope.new(),
								:canal,rope.new()),
					 :desmontaje,
					 property_list.new_with(:fibra,rope.new(),
								:cobre,rope.new(),
								:canal,rope.new()))

	
	_if (disenio_activo<< _self.disenio_Activo) = ""
	_then
		_return plInfo
	_endif

			_for oe _over disenio_activo.user!_oe_locals.elements()
			_loop
				
				(pep,tipo_pep) << _self.obten_pep_de_oe(oe)
				
				plValores << property_list.new_with(:pep,pep,
								    :opb,oe.user!_oei_local.user!_op_local.user!_num_op,
								    :oei,oe.user!_oei_local.user!_num_oei,
								    :oe,oe.user!_num_oe)
				_if pep<>"" _andif
				    pep _isnt _unset _andif 
				    pep.slice(1,1) = "D"
				_then		      
					plInfo[:construccion][tipo_pep].add(plValores)
				_elif pep<>"" _andif
				      pep _isnt _unset _andif 
				      pep.slice(1,1) = "J"
				_then 
					plInfo[:desmontaje][tipo_pep].add(plValores)
				_endif
				
			_endloop
	
	_return plInfo
_endmethod
$
_pragma(classify_level=restricted, usage={redefinable})
_method c_Proyecto.OEI(PoOPB, PsTipoOEI)

	## Parámetros de entrada:
	##       PoOPB     - objeto user!_opb
	##       PsTipoOEI - "CANALIZACION", "PRINCIPAL", "SECUNDARIO"
   	## Parámetros de salida:
	##       LoI  - objeto user!_oei correspondiente al tipo y obp solicitados
	##       LoIs - string con el valor de la oei correspondiente al tipo y obp solicitados
	## vbluna
	
	_try
		_for LoI _over PoOPB.user!_oeis.fast_elements()
		_loop
			_if LoI.user!_tipo_oei = PsTipoOEI
			_then
				_return LoI, LoI.user!_valor_oei.write_string
			_endif
		_endloop
		
	_when does_not_understand
		_return "",""
	_endtry
	
_endmethod
$
_pragma(classify_level=restricted, usage={redefinable})
_method c_Proyecto.oei_distrito_activo
	## Regresa el objeto user!_oei asociado al distrito del diseño
	## activo
	## (vbluna-26/oct/2006)

	_try
		_return _self.distrito.user!_oei.an_element()
	_when does_not_understand
		_return _unset
	_endtry
	
_endmethod
$
_pragma(classify_level=restricted, usage={redefinable})
_method c_Proyecto.OEs(PoOEI)

	## Parámetros de entrada:
	##       PoOEI - objeto user!_oei
   	## Parámetros de salida:
	##       LcolOE - property_list con las oes asociadas a la oei
	##       LsOEs  - string con las oes asociadas a la oei = "OE1,OE2"
	## vbluna
	
	_try
		_local LcolOE  << property_list.new()
		_local LnIndex << 1
		_local LsOEs		
		
		_for LoI _over PoOEI.user!_oes.fast_elements()
		_loop
			LcolOE[LnIndex] << LoI
			_if LnIndex = 1
			_then
				LsOEs << LoI.user!_valor_oe.write_string
			_else
				LsOEs << LsOEs.write_string +" ,"+ LoI.user!_valor_oe.write_string
			_endif
			LnIndex << LnIndex + 1
		_endloop

		_return LcolOE, LsOEs.write_string
		
	_when does_not_understand
		_return "",""
	_endtry
	
_endmethod
