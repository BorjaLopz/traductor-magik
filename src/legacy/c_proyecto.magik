_pragma(classify_level=restricted, usage={redefinable})
_method c_Proyecto.Mes_Anio

   	## Parámetros de entrada:
   	## Parámetros de salida:
	##      - string con la fecha de entrega asociada al proyecto activo en
	##      formato MM/AA
	## vbluna

	_try
		_local LsMes  << c_Traductor.Mes(_self.Fecha_Entrega.month_number)
		# (16/06/03 bautistaja) : Modified. SIMA 5993810
		_local LsAnio << _self.Fecha_Entrega.year.write_string#.slice(3,4)
		_if LsAnio _isnt _unset _andif
		    LsAnio <> ""
		_then
			LsAnio << LsAnio.slice(LsAnio.size-1, LsAnio.size)
		_endif
		#
		_return LsMes + "/" + LsAnio
	_when does_not_understand
		_return ""
	_endtry
	
_endmethod
