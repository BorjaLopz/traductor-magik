_pragma(classify_level=restricted, usage={redefinable})
_method c_Proyecto.PEP_Cons_Sec

   	## Parámetros de entrada:
   	## Parámetros de salida:
	##       - string con el valor de la pep de construccion de
	##       red secundaria asociada al proyecto activo
	## vbluna
	
	_try
		_local l_pep_cons_sec << ""
		_local diseno_activo << swg_dsn_admin_engine.active_design

		_if diseno_activo.tipo_diseno = :secundaria _andif
		    diseno_activo.project.name.matches?("FALC*") _andif
		    (oei << diseno_activo.user!_oei_locals.an_element()) _isnt _unset 
		_then
			_for an_oe _over oei.user!_oe_locals.elements()
			_loop
				ls_tipo_oe << an_oe.user!_pep.user!_catalogo_pep.user!_tipo_trabajo
				# validar que sea no sea una oe de canalizacion,
				# que no sea una oe de principales y que sea de CONSTRUCCION
				_if an_oe.user!_tramo_cobre _is _unset _andif
				    an_oe.user!_segmento_locals.size = 0 _andif				
				    ls_tipo_oe.write_string = "CONSTRUCCION"
				_then
					l_pep_cons_sec << an_oe.user!_pep.user!_clave.write_string
					_leave 
				_endif
			_endloop
		_else
			l_pep_cons_sec << _self.proyecto_activo.user!_pep_cons_secu.write_string
		_endif

		_return l_pep_cons_sec
		
	_when does_not_understand
	        _return ""
	_endtry
	
_endmethod
