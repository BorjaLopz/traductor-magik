_pragma(classify_level=restricted, usage={redefinable})
_method c_Proyecto.nodo()
	## Devuelve el building asociado a la central sobre la cual se
	## genera el proyecto
	## (vbluna-17-10-2006)

	_if .o_nodo _is _unset
	_then
		gpm << gis_program_manager
		lo_pred_ctl << predicate.eq(:user!_siglas, _self.Cve_Central)
		lo_ctl << gpm.cached_dataset(:gis).collection(:building).select(lo_pred_ctl)

		_if lo_ctl.size > 0
		_then
			.o_nodo << lo_ctl.an_element()
		_endif
	_endif
	
	_return .o_nodo
	
_endmethod
