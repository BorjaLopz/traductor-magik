_pragma(classify_level=restricted, usage={redefinable})
_method c_Proyecto.oe_reg_scheme(p_tipo)

   	## Parámetros de entrada:
	##    p_tipo - "CONSTRUCCION (D)", "DESMONTAJE(J)", "RECONCENTRACION(Y)"

	_local diseno_activo   << swg_dsn_admin_engine.active_design
	_local proyecto_activo << diseno_activo.project
	_local l_pep << ""
	_local l_oe << _unset 
	_local pl << property_list.new()
	pl["D".as_symbol()] << "CONSTRUCCION" 
	pl["J".as_symbol()] << "DESMONTAJE"
	pl["Y".as_symbol()] << "RECONCENTRACION"
		
	#_if  diseno_activo.tipo_diseno = :secundaria	
	#_then
		_for iteroe _over _self.Disenio_Activo.user!_oe_locals.fast_elements()
		_loop

			l_pep << proyecto_activo.user!_peps.an_element().source_collection.at(iteroe.user!_pep_id).user!_clave
			l_pep_tipo << l_pep.slice(1,1).as_symbol()
			
			_if pl[l_pep_tipo] = p_tipo.write_string.uppercase
			_then
			       L_oE << iteroe
			      
			       _leave
			_endif
			
		_endloop
		
	#_endif
	
	_return l_oe
        
	
_endmethod
$
_pragma(classify_level=restricted, usage={redefinable})
_method c_Proyecto.obten_pep_de_oe(p_oe)
	## Metodo para obtener la pep que tiene relacionada una oe, en
	## este metodo se obtiene de dos maneras, una tomando si la
	## relacion de la oe esta llena obtenemos la pep de la tabla de
	## peps, si no obtenemos la pep del campo del proyecto. Ademas
	## de retornar tambien el tipo de pep (:fibra, :cobre, :canal)
	## 

	LoPep << ""
	LoTipoPep << ""

	dadmin    << gis_program_manager.cached_dataset(:design_admin)
	tabla_pep << dadmin.collection(:user!_pep)
        oe_pep << tabla_pep.at(p_oe.user!_pep_id)
	
	_if oe_pep _isnt _unset
	_then		
		LoPep     << oe_pep.user!_clave
		LoTipoPep << _self.disenio_activo.tipo_proyecto.lowercase
		_if LoTipoPep.matches?("fibra*")
		_then
			LoTipoPep << :fibra
		_else
			LoTipoPep << :cobre
		_endif
	_endif

	_return LoPep, LoTipoPep
_endmethod
$
