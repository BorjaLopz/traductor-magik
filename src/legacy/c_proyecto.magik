_pragma(classify_level=restricted, usage={redefinable})
_method c_Proyecto.colonia

	colonia <<  _self.distrito.get_geo_user!_colonia
	nombre << ""
	_if colonia    _isnt _unset 
	_then
	        nombre << colonia.user!_nombre 	
	_endif
       _return nombre
       
_endmethod
