_method c_Proyecto.Ubicacion

   	## Parámetros de entrada:
   	## Parámetros de salida:
	##      - string con Division/Area/Central/Ruta del diseño activo
	## (vbluna-26/oct/2006)
	
	_try
		_return  _self.division_telmex + "  /  " + _self.area_telmex + "  /  " +
			 _self.nombre_central + " / " + _self.disenio_activo.name
	_when does_not_understand
		
		_return "División/Área/Central/"
		
	_endtry
	
_endmethod
