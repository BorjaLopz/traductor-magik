_pragma(classify_level=restricted, usage={redefinable})
_method c_proyecto_red.obten_tramo(PsCve_tramo, _optional PsCve_ruta)

## Objetivo: Obtener el tramo de acuerdo a la clave que se le proporcione
## Parámetros de entrada:
##  String - PsNum_Tramo:Numero del tramo que se desea obtener	
## Parámetros de salida:  NA
## Regresa:
##   c_tramo_fo_e -  Tramo del proyecto que se desea conultar
## Fecha de última modificación: 17/01/2005
## Autor de la modificación : dsanchez
## Descripción de la modificación: Creación
##	
## 11/04/05 DSB - se deshabilito el condition raise, y se
## cambio por un write 	
## 08/04/05 DSB Se agrego el parametro de numero de ruta, para
## que se proporcione de los sellos. Este se definio como
## opcional, si no se pasa se toma del diseño
## NOTA: - El numero de ruta se tomara de SCHEME si no se proporciona

    # Si esta vacio se crea el objeto oTramo_fo
	
   _if _self.oTramo_fo = _unset
   _then
	 _self.oTramo_fo << c_Tramo_fo_e.new()

   _endif


   # Si existe el tramo y la clave del tramo que se solicita es
   # diferente a la existente, se asigna nuevamente al objeto
   # tramo la clave

   _if _self.oTramo_fo _isnt _unset _and ( _self.oTramo_fo.sNum_Ruta <> PsCve_Ruta _or 
       _self.oTramo_fo.sNum_Tramo <> PsCve_tramo )
   _then

      # se verifica si se mando como parametro el numero de ruta
      # si no se mando se toma del dise;o	   
      _if PsCve_Ruta _is  _unset 
      _then 
         LsCve_ruta << _self.numero_ruta
	 write("Se tomó el nümero de ruta  del diseño")
      _else
         LsCve_Ruta  << PsCve_Ruta
 	 write("Se tomó el número de ruta del parámetro")
      _endif    

      _self.oTramo_fo.asigna_num_tramo( LsCve_ruta, PsCve_Tramo)
	    
   _endif

   # se verifica que exista el tramo para regresarlo, si no existe
   # se manda un mensaje de error
    _if _self.oTramo_fo _isnt _unset 
    _then
       _return   _self.oTramo_fo
    _else
        write("No se localizó el tramo.")		 
     _endif

_endmethod
$

