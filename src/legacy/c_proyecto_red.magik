_pragma(classify_level=restricted, usage={redefinable})
_method c_proyecto_red.cve_central
   
## Objetivo: Proporcionar la clave de la central
## Parámetros de entrada: NA
## Parámetros de salida:  NA
## Regresa:
##   string -  clave de la central
## Fecha de última modificación: 17/01/2005
## Autor de la modificación : dsanchez
## Descripción de la modificación: Creación
## 16/12/05 DSB Se cambio el atributo el cual proporciona la
##              clave de la centra, el user!_central contiene
##              el objeto central

   _local LbTodoBien
   _local LbExisteCampo
   
   LbTodoBien << _self.prvValida_proyecto()
   
   _if LbTodoBien 
   _then
      LbExisteCampo << _self.collProyecto.field(:user!_central) <> _unset 
      _if LbExisteCampo
      _then
         _return _self.collProyecto.an_element().user!_central.user!_central.write_string
      _else
	_return "_ABC_"
      _endif

   _else
      _return _self.sValor_defecto 	   
   _endif
	
_endmethod 	      	      	      	   
$

