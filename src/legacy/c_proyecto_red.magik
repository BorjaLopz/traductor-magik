_pragma(classify_level=restricted, usage={redefinable})
_method c_proyecto_red.mes_anio(RsFecha)
	
## Objetivo: convierte de una fecha con formato dd/mm/aaaa a mmm/aa
##	el proyecto 
## Parámetros de entrada:
##  String - RsFecha - en formato dd/mm/aaaa
## Parámetros de salida:  NA
## Regresa:
##   string  -  mmm/aa   OCT/04
## Fecha de última modificación: 26/01/2005
## Autor de la modificación : dsanchez
## Descripción de la modificación: Creación

	_if RsFecha <> _unset _andif RsFecha <> .sValor_defecto
        _then
		_local LsMes, LsAnio # Cadena que almacena el numero de mes y anio respectivamente
		_local LoCollMeses  << {"ENE","FEB","MAR","ABR","MAY","JUN","JUL","AGO","SEP","OCT","NOV","DIC"}
	
		_if RsFecha.size <> 10 _and (RsFecha.subseq(4,2).as_number() > 12 _or RsFecha.subseq(4,2).as_number() < 1)
		_then
			condition.raise(:warning, :string, "Fecha incorrecta. "+RsFecha)
		_endif 

		LsMes << RsFecha.subseq(4,2)
		LsAnio << RsFecha.subseq(9,2)

		_return LoCollMeses[LsMes.as_number()] + "/" + LsAnio
	_else 
		_return _self.sValor_defecto  	   
	_endif 
	
_endmethod
$

