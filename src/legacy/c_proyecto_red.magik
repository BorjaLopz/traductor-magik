_pragma(classify_level=restricted, usage={redefinable})
_method c_proyecto_red.Central


	_if _self.oCtl _is _unset 
	_then
		#- - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - 
		# Prepara todo lo relacionado para obtenr los datos de CENTRAL
		#- - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -     

		.oCtl << c_central_e.new()

		.oCtl.siglas << _self.collProyecto.an_element().user!_central.user!_central.write_string
		
	_endif
	
	_return .oCtl
	
_endmethod
$

_pragma(classify_level=restricted, usage={redefinable})
_method c_proyecto_red.Plano(IdPlano)

	_if _self.oPlano _is _unset 
	_then
	
		LoApp   << smallworld_product.pni_application()
		LtPlano << LoApp.database.dataset(:design_admin).collection(:user!_plano)

		LoPred << predicate.eq(:id, IdPlano)

		LoPlano << LtPlano.select(LoPred)

		.oPlano << c_plano_e.new(LoPlano.an_element())
	_endif
	
	_return .oPlano
	
_endmethod
$