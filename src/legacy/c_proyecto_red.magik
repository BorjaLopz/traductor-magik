#----------------------------------------------------------------
# Nobre de la empresa: Sigma Tao
# Traza: Planos
# Objetivo: Proporcionar la clase que puede almacenar las caracteristicas
#           de una celda
# Autor: dsanchez
# Fecha de creacion: 27-Octubre-2004
#
# 
# Nota: Hay una validacion que si regresa la palbra "vacio" o ""
#       se le asigna la ruta 97, en el metodo:
#               obten_tramo(PsCve_tramo)
# falta definir el OPB en la tabla proyecto_red
#
# ---------------- Revision History -----------------
# Ult Mod.
#  16/12/05 DSB - Se modificaron los metodo
#                  cve_central
#                  central
#  25/05/05 DSB - se comento el codigo que accedia a los campos
#                 PEP, OE, OEI, OPB y los metodos ahora
#                 regresan el valor por defecto
#  27/04/05 DSB - se modifico el metodo operacion ya que
#                 verificaba que el campo existiera en una
#                 tabla que no le correspondia
#  11/04/05 DSB - Se deshabilito la excepcion y se manda con un
#                 write en el metodo:
#                    obten_tramo(PsCve_tramo, _optional PsCve_ruta)
# Reviso.
# fdiaz 
# -------------- end revision history ---------------
_package user
$
#remex(:c_proyecto_red)
$
def_slotted_exemplar(:c_proyecto_red,
    {

	   {:yTabla,         :user!_proyecto_red },# tabla donde se almacenan los proyectos de red
	   {:yBdD,           :design_admin       },# B de D donde se localiza la tabla
           {:collProyecto,                _unset },# almacena el proyecto que se desea consultar
           {:collScheme,                  _unset },# Almacena el scheme que se desea consultar 
           {:collCentral,                 _unset },# Almacena los datos de la central
	   {:oDto,                        _unset },# ALmacena información del dto
	   {:oCtl,                        _unset },# ALmacena información de la central
	   {:oPlano,                      _unset },# ALmacena información del Plano
           {:oScheme,                     _unset },# Scheme activo
           {:oTramo_fo,                   _unset },# Un Tramo que se desea obtener de la ruta
	                                           # en la que esta el proyecto
	   {:sValor_Defecto,              ""} # valor que regresa cuando no hay proyecto
                                              	   # seleccionado
    }
)
$
c_proyecto_red.define_slot_access(:yTabla,           :writable, :public)
c_proyecto_red.define_slot_access(:yBdD,             :writable, :public)
c_proyecto_red.define_slot_access(:collScheme,       :writable, :public)
c_proyecto_red.define_slot_access(:collProyecto,     :writable, :public)
c_proyecto_red.define_slot_access(:collCentral,      :writable, :public)
c_proyecto_red.define_slot_access(:oDto,             :writable, :public)
c_proyecto_red.define_slot_access(:oCtl,             :writable, :private)
c_proyecto_red.define_slot_access(:oPlano,           :writable, :private)
c_proyecto_red.define_slot_access(:oScheme,          :writable, :private)
c_proyecto_red.define_slot_access(:oTramo_fo,        :writable, :private)
c_proyecto_red.define_slot_access(:sValor_Defecto,   :writable, :private)
$

_pragma(classify_level=restricted, usage={redefinable})
_method c_proyecto_red.new()

## Objetivo: Crear una instancia de celda
## Parámetros de entrada:
## Parámetros de salida:   NA
## Regresa: 
## Fecha de última modificación: 25/01/2005
## Autor de la modificación : dsanchez
## Descripción de la modificación: Se creo

   .oDto << _unset 
	
   _return _clone
   
_endmethod 
$

_pragma(classify_level=restricted, usage={redefinable})
_method c_proyecto_red.identificador_proyecto(RsValor)

## Objetivo: Mandar llamar el metodo con el cual se obteienen
## los datos del proyecto
## Parámetros de entrada:
##	RsValor Identificador del proyecto	
## Parámetros de salida:   NA
## Regresa: NA
## Fecha de última modificación: 25/01/2005
## Autor de la modificación : dsanchez
## Descripción de la modificación: Se creo
## NOTA: Por el momento se toma el valor del identificador del
## proyecto del diseño que se encuentre activo	

   .oDto << _unset 
   _self.prvLeer_Proyecto_BdD(RsValor)
	
_endmethod
$


_pragma(classify_level=restricted, usage={redefinable})
_private  _method c_proyecto_red.prvLeer_Proyecto_BdD(RsID_Proyecto, _optional RsID_Schema)

## Objetivo: obtener el proyecto de acuerdo al valor que se le proporcione 
##           como parametro
## Parámetros de entrada:
## 	 - RsID_Proyecto - Clave con la que identifica el proyecto
##       - RSID_Schema   - Clave con la que se identifica el dise;o	
## Parámetros de salida:   NA
## Regresa: NA	
## Fecha de última modificación:
##   12/02/05 DSB Se escribio la consulta correcta para obtener
##                el proyecto
##   17/01/05 DSB Creacion


 _local LoPAF         # pni_application   
 _local LoScheme_BD   # Tabla de la B de D donde se almacenan los proyectos
 _local LoProyecto_BD # Tabla de la B de D donde se almacenan los proyectos
 _local LoCemntral_BD # Tabla de la B de D donde se almacenan los proyectos 
 _local LnID_Scheme   # Identificador de scheme 
 _local LnID_Proyecto # Identificador de proyecto
 _local LsCve_Ctl     # Identificador o clave de la central
 _local LoPredicado_proyecto # Sentencia que se define para la busqueda
 _local LoPredicado_scheme   # Sentencia que se define para la busqueda 
 _local LoPredicado_Central  # Sentencia que se define para la busqueda
 _local LsDistrito # Distrito que se buscara

    _self.oScheme << swg_dsn_admin_engine.active_scheme

    LsDistrito << _unset
    
    _if _self.oScheme <> _unset 
    _then
	    
       LoPAF     << smallworld_product.pni_application()
    
       #- - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - 
       # Prepara todo lo relacionado para obtenr los datos de  SCHEME 
       #- - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -     
    
       # recupera los objetos de Scheme
       LoScheme_BD   << LoPAF.database.collection(:design_admin, :swg_dsn_scheme)        
    
       # Prepara el predicado para obtener el Scheme correspondiente
       LnID_Scheme << _self.oScheme.id 
       LoPredicado_Scheme << predicate.eq(:id, LnID_Scheme)    
       
       # Aplica el predicado para obtener el scheme seleccionado
        _self.collScheme   << LoScheme_BD.select(LoPredicado_scheme)

       #- - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - 
       # Prepara todo lo relacionado para obtenr los datos de PROYECTO
       #- - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -     
    
       # recupera los objetos proyecto
       LoProyecto_BD << LoPAF.database.collection(:design_admin, :swg_dsn_project)    

       # Prepara el predicado para obtener el proyecto al que pertenece el 
       # scheme seleccionado

       LnID_Proyecto << _self.collScheme.an_element().swg_dsn_project_id
       #LsID_Proyecto << RsID_Proyecto.default("CAN0001")
       LoPredicado_Proyecto << predicate.eq(:id, LnID_Proyecto)    

       # Aplica el predicadpo para obtener el proyecto al que pertenece el scheme
       _self.collProyecto << LoProyecto_BD.select(LoPredicado_proyecto)

       #- - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - 
       # Prepara todo lo relacionado para obtenr los datos de CENTRAL
       #- - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -     

       # recupera lso objetos proyecto
       LoCentral_BD << LoPAF.database.collection(:catalogos, :user!_cat_nodos_cm)    

       # Prepara el predicado para obtener la central 
       LsCveCtl << _self.collProyecto.an_element().user!_central
       LoPredicado_Central << predicate.eq(:user!_siglas, LsCveCtl)

       # Aplica el predicadpo para obtener el proyecto al que pertenece el scheme
       _self.collCentral << LoCentral_BD.select(LoPredicado_central)

       LsDistrito <<  _self.collScheme.an_element().user!_distrito.write_string
       
    _endif

    #- - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - 
    # Crea la instancia de DISTRITO, se coloco afuera porque
    # independientemente de que haya esquema activo se debe generar
    # la instancia
    #- - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -     

       _self.oDto << c_distrito_e.new()

       _if LsDistrito _isnt _unset 
       _then
	       _self.oDto.distrito << LsDistrito	       
       _endif
    
_endmethod 
$

_pragma(classify_level=restricted, usage={redefinable})
_private _method c_proyecto_red.prvValida_proyecto()

## Objetivo: validar que se tenga un registro, si no existe
## lanza una excepcion
## Parámetros de entrada: NA
## Parámetros de salida:  NA
## Regresa: NA
## Fecha de última modificación: 17/01/2005
## Autor de la modificación : dsanchez
## Descripción de la modificación: Creación
	
   _if _self.oScheme = _unset 
   _then
      _return _false 
   _else
      _return _true 
   _endif	

_endmethod
$


_pragma(classify_level=restricted, usage={redefinable})
_method c_proyecto_red.direccion_divisional

## Objetivo: Regresar el nombre de la dirección divisional a la que pertenece el proyecto
##           
## Parámetros de entrada: NA
## Parámetros de salida:  NA
## Regresa:
##   string -  el nombre de la direccion divisional 
## Fecha de última modificación: 17/01/2005
## Autor de la modificación : dsanchez
## Descripción de la modificación: Creación

   _local LbTodoBien 	
   LbTodoBien << _self.prvValida_proyecto()
   
   _if LbTodoBien 
   _then
      _return _self.collProyecto.an_element().user!_direccion_divisional.write_string
   _else
      _return _self.sValor_defecto
   _endif

_endmethod 	   
$

