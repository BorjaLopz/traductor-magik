_pragma(classify_level=advanced, topic={plotting}, usage={subclassable})
_method c_resumen_competencia_tvpaga.llena_datos_celdas()
	## 
	##
	_if _self.elementos_bd_lb _isnt _unset _andif
	    _self.elementos_bd_lb.size > 0
	_then
		.oDtoOptico << _self.obtener_elementos_bd_landbase()[1]
	_endif
	valores << _self.calcula_datos()
	_self.asigna_texto_celda(:tbl_contenido,1,2,"",20,:centre_centre,0,{0.0,0.2993,0.0})
	_self.asigna_texto_celda(:tbl_contenido,2,2,valores[:tv_satelital],20,:centre_centre,0,{0.0,0.2993,0.0})
	_self.asigna_texto_celda(:tbl_contenido,3,2,valores[:tv_dish],20,:centre_centre,0,{0.0,0.2993,0.0})
	_self.asigna_texto_celda(:tbl_contenido,4,2,valores[:tv_cable],20,:centre_centre,0,{0.0,0.2993,0.0})	
	_self.asigna_texto_celda(:tbl_contenido,5,2,valores[:lineas_competencia_cobre],20,:centre_centre,0,{0.0,0.2993,0.0})
	_self.asigna_texto_celda(:tbl_contenido,6,2,valores[:lineas_competencia_inalambrica],20,:centre_centre,0,{0.0,0.2993,0.0})
	_self.asigna_texto_celda(:tbl_contenido,7,2,valores[:lineas_inalambricas],20,:centre_centre,0,{0.0,0.2993,0.0})
	_self.asigna_texto_celda(:tbl_contenido,8,2,valores[:telefono_publico_competencia],20,:centre_centre,0,{0.0,0.2993,0.0})
	_self.asigna_texto_celda(:tbl_contenido,9,2,valores[:lineas_ladafon],20,:centre_centre,0,{0.0,0.2993,0.0})
	_self.asigna_texto_celda(:tbl_contenido,10,2,valores[:lineas_ladatel],20,:centre_centre,0,{0.0,0.2993,0.0})
	_self.asigna_texto_celda(:tbl_contenido,11,2,valores[:solicitudes],20,:centre_centre,0,{0.0,0.2993,0.0})
	_self.asigna_texto_celda(:tbl_contenido,12,2,valores[:infinitum],20,:centre_centre,0,{0.0,0.2993,0.0})
	_self.asigna_texto_celda(:tbl_contenido,13,2,valores[:lineas_pslt],20,:centre_centre,0,{0.0,0.2993,0.0})
        _self.asigna_texto_celda(:tbl_contenido,14,2,valores[:fibra_telmex],20,:centre_centre,0,{0.0,0.2993,0.0})
	_self.asigna_texto_celda(:tbl_contenido,15,2,valores[:fibra_competencia],20,:centre_centre,0,{0.0,0.2993,0.0})
	
_endmethod
