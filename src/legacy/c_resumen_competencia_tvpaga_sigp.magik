_pragma(classify_level=advanced, topic={plotting}, usage={subclassable})
_method c_resumen_competencia_tvpaga_sigp.calcula_datos()
	## 
	##
	LoDesigAdmin << gis_program_manager.cached_dataset(:gis)	
	LoTabVivienda << LoDesigAdmin.collection(:user!_vivienda)
	lo_valores << property_list.new()
	
	LoDis << c_distrito.new()
	LoPro << c_proyecto.new()
	LoDis.asigna_distrito(LoPro.distrito)
	.oDtoOptico << LoDis.objeto

	LoTelPublicos << LoDis.telefonos_publicos

        #print( LoTelPublicos)
	
	lo_valores[:lineas_ladafon] << 0
	lo_valores[:lineas_cobre]   << 0
	lo_valores[:lineas_pslt]    << 0
	lo_valores[:fibra_competencia] << 0

	Lo_valores[:baldio] << LoDis.numero_baldios
	lo_valores[:lineas_ladatel] << LoTelPublicos[:|TPTC|].default(0)      ##lineas_ladatel (casetas)
	
	lo_valores[:tv_satelital] << 0
	lo_valores[:tv_cable] << 0
	lo_valores[:opertel] << 0                ##lineas competencia cobre
	lo_valores[:opertel_inalambrica] << 0    ##lineas_competencia_inalambrica
	lo_valores[:lineas_inalambricas] << 0
	lo_valores[:telefono_publico_competencia] << 0
	
	lo_valores[:tv_dish]  << 0	         ##dish  
	lo_valores[:lineas_ftth] << 0            ##fibra_telmex
	lo_valores[:infinitum] << 0              ##clientes_existentes_datos                      
	lo_valores[:solicitudes] << 0 
	lo_valores[:ganancia_comercial] << 0
	lo_valores[:clientes_existentes_datos_sd] << 0
	lo_valores[:solicitudes_p_s_d] << 0


	_if .oDtoOptico.user!_limite _isnt _unset 
	_then
		LoPsa << pseudo_area.new_for_world(.oDtoOptico.user!_limite, LoDesigAdmin.world)
		LoSelViviendas << LoTabVivienda.select(predicate.interacts(:location,LoPsa))
	_endif
	
	_if LoSelViviendas _isnt _unset
	_then
		_for LoVivienda _over LoSelViviendas.fast_elements()
		_loop			
			_for inv _over LoVivienda.user!_inventario_viviendas.fast_elements()
			_loop
				_if inv.user!_servicio = "TELEFONO"
				_then
					_if inv.user!_producto = "LINEAS INALAMBRICAS" 
					_then
						lo_valores[:lineas_inalambricas] +<< inv.user!_cantidad.default(0)
						
					_elif inv.user!_producto = "LINEAS LADAFON" 
					_then
						lo_valores[:lineas_ladafon] +<< inv.user!_cantidad.default(0)
						
					_elif inv.user!_producto = "LINEAS COBRE" 
					_then
						lo_valores[:lineas_cobre] +<< inv.user!_cantidad.default(0)
						
					_elif inv.user!_producto = "LINEAS PSLT" 
					_then
						lo_valores[:lineas_pslt] +<< inv.user!_cantidad.default(0)
						
					_elif inv.user!_producto = "SOLICITUDES" 
					_then
						lo_valores[:solicitudes] +<< inv.user!_cantidad.default(0)
						
					_elif inv.user!_producto = "LINEAS COMPETENCIA COBRE" 
					_then
						lo_valores[:opertel] +<< inv.user!_cantidad.default(0)
						
					_elif inv.user!_producto = "LINEAS COMPETENCIA INALAMBRICAS" 
					_then
						lo_valores[:opertel_inalambrica] +<< inv.user!_cantidad.default(0)
						
					_elif inv.user!_producto = "TELEFONO PUBLICO COMPETENCIA" 
					_then
						lo_valores[:telefono_publico_competencia] +<< inv.user!_cantidad.default(0)
						
					_elif inv.user!_producto = "TELMEX LINEAS FIBRA" 
					_then
						lo_valores[:lineas_ftth] +<< inv.user!_cantidad.default(0)  ##fibra_telmex
						
					_elif inv.user!_producto = "COMPETENCIA LINEAS FIBRA" 
					_then
						lo_valores[:fibra_competencia] +<< inv.user!_cantidad.default(0)				
					_endif
					
				_elif inv.user!_servicio = "TV"
				_then
					# (12/08/10 lunal) : Modificacion, se filtra para que los
					# servicios de tipo DISH no se cuenten en SATELITAL, y para el
					# caso de servicios tipo CABLE, se suman todas las cableras en
					# uno solo, independiente de la compañia
					
					_if inv.user!_tipo_servicio = "SATELITAL" _and inv.user!_empresa <> "DISH"
					_then
						
						lo_valores[:tv_satelital] +<< inv.user!_cantidad.default(0)
						
					_endif 
					_if inv.user!_empresa = "DISH"
					_then						
						lo_valores[:tv_dish] +<< inv.user!_cantidad.default(0)						
					_endif
					_if inv.user!_tipo_servicio = "CABLE" 
					_then						
						lo_valores[:tv_cable] +<< inv.user!_cantidad.default(0)						
					_endif
					_if inv.user!_producto = "TELMEX LINEAS FIBRA" 
					_then
						lo_valores[:lineas_ftth] +<< inv.user!_cantidad.default(0)   #fibra_telmex
						
					_elif inv.user!_producto = "COMPETENCIA LINEAS FIBRA" 
					_then
						lo_valores[:fibra_competencia] +<< inv.user!_cantidad.default(0)				
					_endif
					
				_elif inv.user!_servicio = "INTERNET"
				_then
					_if inv.user!_producto = "INFINITUM"
					_then
						lo_valores[:infinitum] +<< inv.user!_cantidad.default(0)
						
					_elif inv.user!_producto = "TELMEX LINEAS FIBRA" 
					_then
						lo_valores[:lineas_ftth] +<< inv.user!_cantidad.default(0)    #fibra_telmex
						
					_elif inv.user!_producto = "COMPETENCIA LINEAS FIBRA" 
					_then						
						lo_valores[:fibra_competencia] +<< inv.user!_cantidad.default(0)				
					_endif 					
				_endif
			_endloop					
		_endloop    					
	_endif


        datos << .oDtoOptico.inventario_datos_sin_ubicacion

	lo_valores[:ganancia_comercial]           << datos[:|GANANCIA COMERCIAL|]
	lo_valores[:clientes_existentes_datos_sd] << datos[:|CLIENTES EXISTENTES DE DATOS SIN DOMICILIO|]
	lo_valores[:solicitudes_p_s_d]            << datos[:|SOLICITUDES PENDIENTES SIN DOMICILIO|]	
	lo_valores[:solicitudes]                  << datos[:|SOLICITUDES|]
#	lo_valores[:lineas_ladafon]               << datos[:|LINEAS LADAFON|]
	lo_valores[:lineas_cobre]                 << datos[:|LINEAS COBRE|]
#	lo_valores[:lineas_inalambricas]          << datos[:|LINEAS INALAMBRICAS|]
#	lo_valores[:fibra_competencia]            << datos[:|COMPETENCIA LINEAS FIBRA|]
#	lo_valores[:lineas_ftth]                  << datos[:|TELMEX LINEAS FIBRA|] 
#	lo_valores[:opertel_inalambrica]          << datos[:|LINEAS COMPETENCIA INALAMBRICAS|]
	lo_valores[:INFINITUM]                    << datos[:|INFINITUM|] 


	
        _self.info_sello_propiedades(lo_valores)
	
	_return  lo_valores
_endmethod
$
_pragma(classify_level=advanced, topic={plotting}, usage={subclassable})
_method c_resumen_competencia_tvpaga_sigp.info_sello_propiedades(Lo_valores)

	lo_valores[:baldio]                       <<  _self.valor_propiedad(:baldio,Lo_valores[:baldio])
	lo_valores[:tv_satelital]                 <<  _self.valor_propiedad(:tv_satelital,Lo_valores[:tv_satelital])
	lo_valores[:tv_cable]                     <<  _self.valor_propiedad(:tv_cable,Lo_valores[:tv_cable])
	lo_valores[:opertel]                      <<  _self.valor_propiedad(:opertel,Lo_valores[:opertel])
	lo_valores[:opertel_inalambrica]          <<  _self.valor_propiedad(:opertel_inalambrica,Lo_valores[:opertel_inalambrica])
	lo_valores[:lineas_inalambricas]          <<  _self.valor_propiedad(:lineas_inalambricas,Lo_valores[:lineas_inalambricas])
	lo_valores[:telefono_publico_competencia] <<  _self.valor_propiedad(:telefono_publico_competencia,Lo_valores[:telefono_publico_competencia])
	lo_valores[:lineas_ladatel]               <<  _self.valor_propiedad(:lineas_ladatel,Lo_valores[:lineas_ladatel])
	lo_valores[:tv_dish]                      <<  _self.valor_propiedad(:tv_dish,Lo_valores[:tv_dish])
	lo_valores[:lineas_ftth]                  <<  _self.valor_propiedad(:lineas_ftth,Lo_valores[:lineas_ftth])
	lo_valores[:infinitum]                    <<  _self.valor_propiedad(:infinitum,Lo_valores[:infinitum])
	lo_valores[:solicitudes]                  <<  _self.valor_propiedad(:solicitudes,Lo_valores[:solicitudes])
	lo_valores[:ganancia_comercial]           <<  _self.valor_propiedad(:ganancia_comercial,Lo_valores[:ganancia_comercial])
	lo_valores[:clientes_existentes_datos_sd] <<  _self.valor_propiedad(:clientes_existentes_datos_sd,Lo_valores[:clientes_existentes_datos_sd])
	lo_valores[:solicitudes_p_s_d]              <<  _self.valor_propiedad(:solicitudes_p_s_d,Lo_valores[:solicitudes_p_s_d])

	_return lo_valores
_endmethod
$
_pragma(classify_level=advanced, topic={plotting}, usage={subclassable})
_method c_resumen_competencia_tvpaga_sigp.valor_propiedad(Propiedad, dato_actual)
	## 
	##

	LoPropiedad << ""
	
	_if _self.attributes[Propiedad]  _isnt _unset  _andif
	    _self.attributes[Propiedad].value _isnt _unset _andif
	    _self.attributes[Propiedad].value > 0
	_then
	
		LoPropiedad << _self.attributes[Propiedad].value.write_string
	_else
		LoPropiedad << dato_actual
	_endif

	_return LoPropiedad
		
_endmethod
$


	






