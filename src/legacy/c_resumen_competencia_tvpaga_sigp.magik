_pragma(classify_level=advanced, topic={plotting}, usage={subclassable})
_method c_resumen_competencia_tvpaga_sigp.configura_tabla()
	
	_local LoTblTitulo
	_local LoTblContenido
	_local LoTbl
	_local LfDesplazaY
	
	# Titulo1 (tabla 1)
	LoTblTitulo<<property_list.new_with_properties(:ren,{6},:col,{50})
	LoTbl<<.o_tablas.crea_tabla(1,1,:tbl_titulo)
	LoTbl.ocoordenada_origen << .o_coord_inicio
	_self.asigna_medidas_tabla(LoTbl, LoTblTitulo)
	
	# Titulo2 (tabla 2)
	LoTblTitulo2<<property_list.new_with_properties(:ren,{6},:col,{11,30,9})
	LfDesplazaY << .o_tablas.longitud_total_renglones({:tbl_titulo})
	LoTbl2<<.o_tablas.crea_tabla(1,3,:tbl_titulo2)
	LoTbl2.ocoordenada_origen << coordinate.new( .o_coord_inicio.x,.o_coord_inicio.y - LfDesplazaY)
	_self.asigna_medidas_tabla(LoTbl2, LoTblTitulo2)
	
	# Contenido (tabla 3)
	LoTblContenido << property_list.new_with_properties(:ren,{6,6,6,6,6,6,6,6,6,6,6,6,7,6,6}, :col,{11,30,9})
	LfDesplazaY << LfDesplazaY+.o_tablas.longitud_total_renglones({:tbl_titulo2})
	LoTbl <<.o_tablas.crea_tabla(15,3, :tbl_contenido)
	LoTbl.ocoordenada_origen << coordinate.new( .o_coord_inicio.x,.o_coord_inicio.y - LfDesplazaY)
	_self.asigna_medidas_tabla(LoTbl, LoTblContenido)
_endmethod
$
