_pragma(classify_level=advanced, topic={plotting}, usage={subclassable})
_method c_resumen_competencia_tvpaga_sigp.defined_attributes
				
	attribs << rope.new_from (_super.defined_attributes)
	attribs.add(layout_attribute_definition.new(:baldio,                      :integer,:default_value,0,:description, "PREDIO BALDIO" ))
	attribs.add(layout_attribute_definition.new(:tv_satelital,                :integer,:default_value,0,:description, "TELEVISION SATELITAL"))	
	attribs.add(layout_attribute_definition.new(:tv_cable,                    :integer,:default_value,0,:description, "SERVICIO DE CABLE"))
	attribs.add(layout_attribute_definition.new(:opertel,                     :integer,:default_value,0,:description, "OPERTEL"))
	attribs.add(layout_attribute_definition.new(:opertel_inalambrica,         :integer,:default_value,0,:description, "INALAMBRICA OPERTELES"))
	attribs.add(layout_attribute_definition.new(:lineas_inalambricas,         :integer,:default_value,0,:description, "INALAMBRICA CONS/SOLIC" ))
	attribs.add(layout_attribute_definition.new(:telefono_publico_competencia,:integer,:default_value,0,:description, "TEL/PUB COMPET." ))	
	attribs.add(layout_attribute_definition.new(:lineas_ladatel,              :integer,:default_value,0,:description, "CASETA CONS/SOLIC" ))    
	attribs.add(layout_attribute_definition.new(:tv_dish,                     :integer,:default_value,0,:description, "TELEVISION SATELITAL DISH"))
	attribs.add(layout_attribute_definition.new(:lineas_ftth,                 :integer,:default_value,0,:description,"LINEAS FTTH EXISTENTES CONCESIONARIO SOLICITANTE"))
	attribs.add(layout_attribute_definition.new(:infinitum,                   :integer,:default_value,0,:description,"CLIENTES EXISTENTES DE DATOS")) 
	attribs.add(layout_attribute_definition.new(:solicitudes,                 :integer,:default_value,0,:description, "SOLICITUDES PENDIENTES"))
	attribs.add(layout_attribute_definition.new(:ganancia_comercial,          :integer,:default_value,0,:description, "GANANCIA COMERCIAL"))
	attribs.add(layout_attribute_definition.new(:clientes_existentes_datos_sd,:integer,:default_value,0,:description,"CLIENTES EXISTENTES DE DATOS S/D"))
	attribs.add(layout_attribute_definition.new(:solicitudes_p_s_d,           :integer,:default_value,0,:description, "SOLICITUDES PENDIENTES S/D" ))

	
	>> attribs
	
_endmethod
$
c_resumen_competencia_tvpaga_sigp.define_attributes()
