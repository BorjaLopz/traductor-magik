	_self.asigna_texto_celda(:tbl_contenido,8,3,valores[:lineas_ladatel],                 20,:centre_centre,0,{0.0,0.2993,0.0})   ##casetas
	_self.asigna_texto_celda(:tbl_contenido,9,3,valores[:tv_dish],                        20,:centre_centre,0,{0.0,0.2993,0.0})
	_self.asigna_texto_celda(:tbl_contenido,10,3,valores[:lineas_ftth],                   20,:centre_centre,0,{0.0,0.2993,0.0})
