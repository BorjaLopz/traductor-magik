_pragma(classify_level=advanced, topic={plotting}, usage={subclassable})
_method c_resumen_del_proyecto.new_with( _gather args)
	#---------------------------------------------------
	##  Objetivo  : generar una instancisa del sello de lista de
	## materiales inicializada segun el tipo de elementos que se
	## desea exponer, donde 
	## PoDatos contiene el tipo de elementos que se listaran  y sus
	## valores son :red o :estructuras.

	.loDesc << {
	          {"LONGITUD DEL TRAMO A CONSTRUIR KMS","------"},
		  {"LONGITUD TOTAL DE LA RUTA","------" },
		  {"DERIVACIONES" , "------"  },
		  {"CABLE PRECON CON/SCUPC 144 F.O", "TMX-RISER"},
		  {"CABLE PRECON CON/SCUPC 96 F.O","TMX-RISER"},
		  {"CABLE PRECON CON/SCUPC 48 F.O","TMX-RISER"},
		  {"CABLE SUBTERRANEO 144 F.O","SFDTP-2YF"},
		  {"CABLE SUBTERRANEO 96 F.O","SFDTP-2YF"},
		  {"CABLE SUBTERRANEO 48 F.O","SFDTP-2YF"},
		  {"CABLE SUBTERRANEO 24 F.O","SFDTP-2YF"},
		  {"CABLE SUBTERRANEO 12 F.O","SFDTP-2YF"},
		  {"CABLE SUBTERRANEO 6 F.O","SFDTP-2YF"},
		  {"CABLE SUBTERRANEO 4 F.O","SFDTP-2YF"},
		  {"CABLE AEREO 96 F.O","AFDTP-2YF"},
		  {"CABLE AEREO 48 F.O","AFDTP-2YF"},
		  {"CABLE AEREO 24 F.O","AFDTP-2YF"},
		  {"CABLE AEREO 12 F.O","AFDTP-2YF"},
		  {"CABLE AEREO 6 F.O","AFDTP-2YF"},
		  {"No DE GAZAS","------"},
		  {"INTERVENCION A CIERRE SUBTERRANEO","FOSC 350 C"},
		  {"INTERVENCION A CIERRE SUBTERRANEO","FOSC 450 BS"},
		  {"INTERVENCION A CIERRE SUBTERRANEO","LUCIERNAGA"},
		  {"CIERRE DE EMPALME RECTO HASTA 36 F.O","FOSC 350 C"},
		  {"CIERRE DE EMPALME RECTO ENTRE 37 Y 108 F.O","FOSC 350 C"},
		  {"CIERRE DE EMPALME RECTO MAYOR A 108","FOSC 450 BS"},
		  {"CIERRE DE EMPALME 1E/2S ENTRE 37 Y 108","FOSC 350 C"},
		  {"CIERRE DE EMPALME 1E/2S MAYOR A 108","FOSC 450 BS"},
		  {"CIERRE DE EMPALME 1E/3S MAYOR A 37","FOSC"},
		  {"CIERRE DE EMPALME 1E/4S HASTA 36","FOSC"},
		  {"CIERRE DE EMPALME 1E/4S MAYOR A 37","FOSC 450 BS"},
		  {"CONEXIONES POR FUSION POR FIBRA","------"},
		  {"PLACAS DE IDENTIFICACION","ALUMINIO"},
		  {"TAPA PARA SUBDIVISION DE VIAS","------"},
		  {"FLEXODUCTO DE 35 MM MTS","------"},
		  {"TUBO RANURADO DE PVC","------"},	
		  {"COLOCACION DE SOPORTES","------"},	
		  {"INSTALACION DE VIA OCUPADA","------"},	
		  {"CAPUCHON TERMOCONTRACTIL","------"},	
		  {"CABLE ENGRAPADO","------"},	
		  {"QUITAR GUIA","------"},	
		  {"INSTALACION DE CABLE EN ESCALERILLA","------"},	
		  {"INSTALACION DE ESCALERILLA DE ALUMINIO", "------"}	}
	
	
	>> _super.new_with(property_list.new_from_gathered ( args ))
	
_endmethod
$
