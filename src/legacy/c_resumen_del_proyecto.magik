def_slotted_exemplar(:c_resumen_del_proyecto,
{
	 {:tipo, _unset},  #se indica si la lista de materiales es de elementos de red o estructuras
	 {:LoElemResumen, _unset},
	 {:LoDesc,       _unset},
	 {:ht,_unset }
}, :c_base_sello_fibra)
