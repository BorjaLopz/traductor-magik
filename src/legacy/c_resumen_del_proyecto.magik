_pragma(classify_level=advanced, topic={plotting}, usage={subclassable})
_method c_resumen_del_proyecto.llena_datos_celdas_old()
	## Obtiene la lista de materiales y asigna los valores.
	##	
	LoFormato << float_format.new(:float_decimal_places,2)

	v <<  mit_manager.modelit_dataset
	material << property_list.new()

	##(LoElementoss,ht) << _self.obten_lista_materiales()

	#Cantidad de renglones de la tabla actual
	_local ren_tbl << _self.o_tablas.elemento(:tbl_lista_materiales).oceldas.sys!slot(:nnumren)
	
	_if .ht.size > 0
	_then
		
		cont << 2
	      keys_o << _self.keys_Order(.ht )
	      
#		_for Iterkey,values _over .ht.keys_and_elements()
		_for  Iterkeyc _over keys_o.elements()
		_loop

			Iterkey	<< Iterkeyc.as_symbol()
			values << .ht[Iterkey.as_symbol()]
			
			cont+<<1
			IterObject << values.an_element() 
			material[:cantidad] << values.size.write_string
			material[:desc_uc] << IterObject.source_collection.external_name.write_string
			material[:desc_mat] << ""

                        _if IterObject.responds_to?(:primary_geometry)   _andif
			    IterObject.primary_geometry _is :route
			_then
				material[:desc_unidad] << "metros"
                                material[:cantidad] << 0
				
				_for record _over values.fast_elements()
				_loop
					cable? << record.source_collection.name _is :sheath
					
					_if cable?
					_then
						Longitud << record.measured_length.value_in(:m)

						_if Longitud <=0
						_then
							longitud << record.calculated_fiber_length.value_in(:m)
						_endif
					_else
						Longitud << record.measured_length.value_in(:m)
					_endif
					
					material[:cantidad] +<<  longitud
	
				_endloop
				
				material[:cantidad] << material[:cantidad].as_fixed_string(5,2)
				
			_else
				material[:desc_unidad] << "pzas"
			_endif 
			
			_if   IterObject.source_collection.name _is :sheath
			_then
			        mspec  << IterObject.get_spec_record()
				desc <<  mspec.user!_clase.write_string + %space +
					 mspec.fiber_quantity.write_string
				
				material[:desc_mat] <<  IterObject.source_collection.external_name +   desc
				material[:desc_uc] << ""
	
			_elif IterObject.responds_to?(:spec_id)
			_then
				material[:desc_mat]  << IterObject.spec_id.write_string
				
			_elif IterObject.responds_to?(:user!_tipo_conexion)
			_then
				material[:desc_mat]  << IterObject.user!_tipo_conexion.write_string
				
			_elif IterObject.source_collection.name _is :underground_route 
			_then				
				# (15/08/13 bautistaja) : Modified.
				rpmaterial << Iterkey.write_string.split_by("|")
				_if rpmaterial.size > 1
				_then
					material[:desc_mat]  << Iterkey.write_string.split_by("|")[2]
				_else
					material[:desc_mat] << Iterkey.write_string.split_by("|")[1]
				_endif
				
                        _elif  IterObject.source_collection.name _is :figure_eight 
			_then
				# (15/08/13 bautistaja) : Modified.
				rpmaterial << Iterkey.write_string.split_by("|")
				_if rpmaterial.size > 1
				_then
					material[:desc_mat]  << Iterkey.write_string.split_by("|")[2]
				_else
					material[:desc_mat]  << Iterkey.write_string.split_by("|")[1]
				_endif
			        material[:desc_uc] << ""
			_else
				material[:desc_mat]  << ""
			_endif

			material[:desc_uc] +<<  %space  +  material[:desc_mat]				 

			#(10/02/15 bautistaja): Se valida la cantidad de renglones de
			# la tabla actual.
			_if ren_tbl >= cont
			_then
				_self.asigna_texto_celda(:tbl_lista_materiales,cont,1,cont-2                ,18,_unset)
				_self.asigna_texto_celda(:tbl_lista_materiales,cont,2,material[:desc_uc]    ,18,:centre_left )
			##	_self.asigna_texto_celda(:tbl_lista_materiales,cont,3,material[:desc_unidad],18,_unset )
				_self.asigna_texto_celda(:tbl_lista_materiales,cont,3,material[:cantidad]   ,18,_unset )
			_endif
				     
		_endloop
		
	_endif
	
_endmethod
$

_pragma(classify_level=advanced, topic={plotting}, usage={subclassable})
_method c_resumen_del_proyecto.llena_datos_celdas()


	valores << _self.calcula_datos()
	
	LoFormato << float_format.new(:float_decimal_places,2)
	
	v <<  mit_manager.modelit_dataset
	material << property_list.new()
	cont << 2
	
	#Cantidad de renglones de la tabla actual
	_local ren_tbl << _self.o_tablas.elemento(:tbl_lista_materiales).oceldas.sys!slot(:nnumren)
	
#	_for  Iterkeyc _over  .LoDesc.elements()
#	_loop
#		
#		show(:Iterkeyc, Iterkeyc)
#		cont+<<1		
#
#		material[:desc_uc] <<  Iterkeyc[1]
#		material[:desc_mat] << Iterkeyc[2]
#		material[:cantidad] << "0"
#			
#		#(10/02/15 bautistaja): Se valida la cantidad de renglones de
#		# la tabla actual.
#		_if ren_tbl >= cont
#		_then
#			_self.asigna_texto_celda(:tbl_lista_materiales,cont,1, cont-2                ,25,_unset)
#			_self.asigna_texto_celda(:tbl_lista_materiales,cont,2,material[:desc_uc]     ,25,:centre_left )
#			_self.asigna_texto_celda(:tbl_lista_materiales,cont,3,material[:desc_mat]    ,25,_unset )
#			_self.asigna_texto_celda(:tbl_lista_materiales,cont,4,material[:cantidad]    ,25,_unset )
#		_endif
#		
#	_endloop
	

	cont << 2
	_for iterk,itervalue _over valores.keys_and_elements()
	_loop
		cont+<<1
		#show(cont,iterk, itervalue )
		_self.asigna_texto_celda(:tbl_lista_materiales,cont,4, itervalue   ,25,_unset )
	_endloop
	
	
_endmethod
$
_pragma(classify_level=advanced, topic={plotting}, usage={subclassable})
_method c_resumen_del_proyecto.etiqueta_celdas_desc()
	
	LoFormato << float_format.new(:float_decimal_places,2)
	
	v <<  mit_manager.modelit_dataset
	material << property_list.new()
	cont << 2
	
	#Cantidad de renglones de la tabla actual
	_local ren_tbl << _self.o_tablas.elemento(:tbl_lista_materiales).oceldas.sys!slot(:nnumren)
	
	_for  Iterkeyc _over  .LoDesc.elements()
	_loop
		
		
		cont+<<1		

		material[:desc_uc] <<  Iterkeyc[1]
		material[:desc_mat] << Iterkeyc[2]
		material[:cantidad] << "0"
			
		#(10/02/15 bautistaja): Se valida la cantidad de renglones de
		# la tabla actual.
		_if ren_tbl >= cont
		_then
			_self.asigna_texto_celda(:tbl_lista_materiales,cont,1, cont-2                ,25,_unset)
			_self.asigna_texto_celda(:tbl_lista_materiales,cont,2,material[:desc_uc]     ,25,:centre_left )
			_self.asigna_texto_celda(:tbl_lista_materiales,cont,3,material[:desc_mat] ,25,_unset )
			_self.asigna_texto_celda(:tbl_lista_materiales,cont,4,material[:cantidad]    ,25,_unset )
		_endif
		
	_endloop
	

_endmethod
$




_pragma(classify_level=advanced, topic={plotting}, usage={subclassable})
_method c_resumen_del_proyecto.contar_fusiones()
	#---------------------------------------------------
	##  Objetivo  : Obtener el numero de fusiones proyectadas en
	## los elementos CEDO, Empalme, y Terminal.
	## esta consulta se basa en los elementos de la red en el
	## recorrido de la genración del plano de detalles.

	paf << smallworld_product.pni_application()
	generador_planos <<paf.plugin(:gen_Planos)
        Lista <<  generador_planos.obtener_registros_de(:oelementos)
	ht  << hash_table.new()
	ht[:mit_internal_connection] << rope.new()
       _for IterObject _over lista.fast_elements()
       _loop
	      # w(:IterObject,IterObject)
	       
	       _if IterObject.responds_to?(:mit_internal_connections)
	       _then
                  _for iterMit _over IterObject.mit_internal_connections.fast_elements()
		  _loop
			  _if iterMit.user!_tipo_conexion.uppercase = "FUSION" _andif
			      iterMit.construction_status = "PROYECTADO"
			  _then						
				 ht[:mit_internal_connection].add(iterMit) 
			  _else
				  
			  _endif
		  _endloop		    		 
	       _endif
       _endloop

       _return ht
_endmethod
$
_pragma(classify_level=advanced, topic={plotting}, usage={subclassable})
_method c_resumen_del_proyecto.keys_Order(Loelementos )
	#---------------------------------------------------
	##  Objetivo  : Ordenar los keys de un hash_table
	##
	
	_local snproc << sorted_collection.figure_order_proc (
			:strings_with_numbers )

	order_proc << _proc ( d1, d2 )
			      _import snproc
			      >> snproc ( d1,d2 )
		      _endproc 
	
	lista << sorted_collection.new ( _unset, order_proc )

	
	 keys_order  << Loelementos.keys

	 _for iterKey  _over keys_order.fast_elements()
	 _loop	
		 lista.add(iterKey.write_string)
	 _endloop

	 _return lista
		
_endmethod
$
_pragma(classify_level=advanced, topic={plotting}, usage={subclassable})
_method c_resumen_del_proyecto.elementos_en_secundarios()
   ## Se obtienen los elementos de Red en nivel de secundarios.
   ##
	
  _local LoListaObjetosSec << rope.new()
  _local LoDisenoActivo
  _local LoOei
   LoDisenoActivo << swg_dsn_admin_engine.active_scheme

   #LoOei << LoDisenoActivo.user!_oei_locals.an_element()
   
   ##_if LoOei _isnt _unset _andif
   ##    LoOei.user!_oe_locals.size > 0
   ##_then
       ##BUSCAMOS POR CADA OE LOS ELEMENTOS y esto es por conectividad
       ## desde el CEDO HACIA "afuera"
	    LoCedos << swg_dsn_admin_engine.active_scheme.distrito_optico.cedos_fo
	    
	    _for cedo _over LoCedos.fast_elements()
	    _loop
		 LoDivisores <<  cedo.obtener_divisores_conectados()
		 _for Divisor  _over LoDivisores.fast_elements()
		 _loop
		     _for pto_salida _over Divisor.output_ports().fast_elements()
		     _loop
			pc << c_path_connectivity.new(pto_salida, _true)
			pc.set_oPto  << pto_salida
			LoConect     << pc.run_get_connectivity_network(pto_salida)			
			LoNetwork    << pc.build_tree_network_base(LoConect)
			_if LoNetwork _isnt _unset 
			_then
			   _for j,k  _over LoNetwork.fast_keys_and_trees()
			   _loop
			      _if j.responds_to?(:construction_status) # _andif
				  #j.construction_status = "PROYECTADO"
			      _then
				      LoListaObjetosSec.add(j)
			      _endif
			   _endloop   
			_endif 
			
			LoStructures << pc.build_tree_structure_network_base(LoConect)
			_if LoStructures _isnt _unset 
			_then
			  _for l,m _over LoStructures.fast_keys_and_trees() 
			  _loop
				  _if l.responds_to?(:construction_status) _andif
				      l.construction_status = "PROYECTADO"
				  _then
					  LoListaObjetosSec.add(l) 
				  _endif 
			  _endloop 			      
			_endif			  
		     _endloop	 		   
		 _endloop
	    _endloop   
##   _endif
    
   _return LoListaObjetosSec
	
_endmethod
$
_pragma(classify_level=advanced, topic={plotting}, usage={subclassable})
_method c_resumen_del_proyecto.descripcionObj(obj)

		
	_if obj.is_kind_of?(splice_closure)
	_then
		desc_uc  <<  "CIERRE DE EMPALME "  + obj.user!_capacidad.write_string
		desc_mat <<  obj.spec_id.write_string.substitute_string("CIERRE","").trim_left_spaces()
		
	_endif

	_if obj.is_kind_of?(sheath)
	_then
                spec_sheath << obj.get_spec_record()
		
		desc <<  spec_sheath.fiber_quantity.write_string + " F.O."
		
		_if obj.spec_id.matches?("FOSUB")
		_then
		     des1 << "CABLE SUBTERRANEO " 
		_elif obj.spec_id.matches?("FOAER")
		_then 
			desc1 << "CABLE AEREO "
		_elif obj.spec_id.matches?("PRECON")
		_then 
			desc1 << "CABLE PRECON CON/SCUPC"
		_else
			desc1 << obj.spec_id.write_string
		_endif
		
		desc_uc  <<    desc1 + desc
		desc_mat <<   spec_sheath.user!_clase.write_string
		
	_else
		desc_uc  <<    obj.spec_id.write_string
		desc_mat <<   ""
		
	_endif
	
	_return desc_uc, desc_mat
	
_endmethod
$

