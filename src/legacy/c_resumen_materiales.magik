 		        {:nNumRenZonaSubUrbana,      21}, # numero de renglones que tiene zona SUBURBANA
			{:collCantZonaSubUrbana, _unset}, # almacena las cantidades que van en suburbana
			{:nNumRenTramo,              11}, # numero de renglones que tiene Tramo
			{:collCantTramo,         _unset}, # almacena las cantidades que van en Tramo
 		        {:nNumRenDerivaciones,        8}, # numero de renglones que tiene Derivaciones
			{:collCantDerivaciones,  _unset}, # almacena las cantidades que van en derivaciones
		        {:nNumRenPermisos,           15}, # numero de renglones que tiene Derivaciones
			{:collCantPermisos,      _unset}, # almacena las cantidades que van en permisos
