			{:nAlto_Descrip,              3}, # Alto del renglon que almacena descripcion
			{:nAlto_ren,                  2}, # Alto de los renglones de detalle
			{:sSembrado,         "SEMBRADO"}
			            
			
		     },
		      :layout_element 
)
