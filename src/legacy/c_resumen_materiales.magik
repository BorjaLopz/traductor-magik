#--------------------------------------------------------------------------
# * * * Resumen de materiales resumen del DERIVACIONES
#--------------------------------------------------------------------------
#  Objetivo: Crea y configura lso objetos necesarios para la
#            tabla resumen derivaciones
#  Parámetros de entrada:
#   RoCoord. Coordenada donde iniciara a dibujarse la tabla
#  Parámetros de salida:   NA
#  Regresa: NA
#  Fecha de última modificación: 16/11/2004
#  Autor de la modificación : dsanchez
#  Descripción de la modificación: Se creo
_pragma(classify_level=restricted, usage={redefinable})
_private _method c_resumen_materiales.prvCreaCfgTblDerivaciones(RoCoord)
	## 
	## 
	_local LoTblTitulo
	_local LoTblCuerpo
	
	LoTblTitulo << _self.oTablas.crea_tabla(1,1,:tbl_TitDerivaciones)

	#lineas internas de la tabla no se dibujaran
	LoTblTitulo.bDibuja_Columnas_Internas?  << _false
	LoTblTitulo.bDibuja_Renglones_Internos? << _false
	
	#Coordenada donde iniciara la tabla
	LoTblTitulo.oCoordenada_Origen << RoCoord

	#longitudes de los renglones de la tabla, esta dada en mm 
	LoTblTitulo.oRenglones.elemento(1).nLongitud << _self.nAlto_Tit / 2.0 

	#longitud de las columnas, esta dada en mm 
	LoTblTitulo.oColumnas.elemento(1).nLongitud  << _self.nAncho_descrip + _self.nAncho_cant

	#-----------------------------------------------------------
	#Tabla cuerpo
	#-----------------------------------------------------------
	_local LnLong

	#_self.nNumRen... + 1 el uno es para incluir el
	# renglon del encabezado descripcion y cantidad	
	LoTblCuerpo << _self.oTablas.crea_tabla(_self.nNumRenDerivaciones + 1 ,2,:tbl_Derivaciones)

	#coordenada donde iniciara la tabla que representa el cuerpo
	LnLong << _self.oTablas.Elemento(:tbl_titDerivaciones).oRenglones.Longitud_total()
	LoCoordCuerpo << coordinate.new(RoCoord.x, RoCoord.y - LnLong)
	
	LoTblCuerpo.oCoordenada_Origen << LoCoordCuerpo
	
	#------------------------------------------------------
	#longitudes de los renglones de la tabla, esta dada en mm
	#------------------------------------------------------
	#Renglon del titulo descripcion y cantidad
        LoTblCuerpo.oRenglones.elemento(1).nLongitud << _Self.nAlto_descrip

	#inicia en 2 ya que ignora el renglon de los titulos
	_for LnNumRen  _over  range(2,_self.nNumRenDerivaciones + 1)
	_loop
	     LoTblCuerpo.oRenglones.elemento(LnNumRen).nLongitud << _self.nAlto_ren
	_endloop

	#longitud de las columnas, esta dada en mm 
	LoTblCuerpo.oColumnas.elemento(1).nLongitud  << _self.nAncho_descrip
	LoTblCuerpo.oColumnas.elemento(2).nLongitud  << _self.nAncho_cant

	LnAltura << _self.oTablas.Longitud_total_renglones({:tbl_titDerivaciones, :tbl_Derivaciones})
	_return LnAltura 
_endmethod
$

#  Objetivo: Asigna el objeto que le corresponde a cada una de
#            las celdas
#  Parámetros de entrada: NA
#  Parámetros de salida:   NA
#  Regresa: NA
#  Fecha de última modificación: 16/11/2004
#  Autor de la modificación : dsanchez
#  Descripción de la modificación: Se creo
_pragma(classify_level=restricted, usage={redefinable})
_method c_Resumen_Materiales.prvLlenaTblDerivaciones()
	## 
	## 

	#se crean los objetos que almacenara la tabla
	LoTit1  << c_texto_grafico.new("RESUMEN DERIVACIONES")

	LoTit1.nTamanio << 26

	#asigna los objetos creados a su correspondiente celda
	_self.oTablas.elemento(:tbl_TitDerivaciones).oCeldas.Celda(1,1).oElemento << LoTit1

	#-----------------------------------------------------------
	#Tabla cuerpo
	#-----------------------------------------------------------
	_Local LnNumColDescripcion << 1

	LoDescrip  << c_texto_grafico.new("DESCRIPCION")
	LoDescrip.nTamanio << 24
	
	LoCantidad << c_texto_grafico.new_from(LoDescrip, "CANTIDAD")

	#asigna los objetos creados a su correspondiente celda
	_self.oTablas.elemento(:tbl_Derivaciones).oCeldas.Celda(1,1).oElemento << LoDescrip
	_self.oTablas.elemento(:tbl_Derivaciones).oCeldas.Celda(1,2).oElemento << LoCantidad

	LcollDescripciones << _self.prvInicializa_Descrip_Derivaciones()
	
	#Se crea el objeto que se tomara como base para el resto de los objetos
	LoBase  << c_texto_grafico.new("Base")
	LoBase.nTamanio << 20
	LoBase.sAlineacion << :centre_left
	_self.prvLlena_Columna(:tbl_Derivaciones, _self.nNumRenDerivaciones,
			       LoBase, LcollDescripciones, LnNumColDescripcion)

	#- - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
	# Llena la columna de cantidad
	#- - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
	
	LnNumColCantidad << 2 # numero de la columna
        LcollCantidades  << _self.prvInicializa_Cantidad_Derivaciones()
	LoBase  << c_captura_texto.new("Base")
	LoBase.sEstilo << "bold"
	LoBase.nTamanio << 2
	LoBase.sAlineacion  << :centre_left
	LoBase.bRecorte? << _true
        LoBase.nMargen_izq << 1	
	LoBase.nMargen_inf << 0.2
	_self.prvLlena_Columna(:tbl_Derivaciones, _self.nNumRenDerivaciones,
			       LoBase, LcollCantidades,LnNumColCantidad)
	
_endmethod
$

