_pragma(classify_level=restricted, usage={redefinable})
_method c_resumen_materiales.defined_attributes
	## 
	##

	attribs << rope.new_from (_super.defined_attributes)

	attribs.add ( layout_attribute_definition.new (	:sTipo, :string,
                   	      	 			:description, "Tipo de resumen a desplegarn",
							:allowed_on_properties_page?,_false ,
							:default_value, "SEMBRADO"
						  )
		     ) 

	
	>> attribs
_endmethod
$

_pragma(classify_level=restricted, usage={redefinable})
c_resumen_materiales.define_attributes()

_pragma(classify_level=restricted, usage={redefinable})
_method c_resumen_materiales.draw_content_on(window)
	## 
	## 

	_self.oWindow << window

	_if _self.bTablas_Creadas = _false  
	_then
           _self.inicializa(coordinate.new(0,0))	
	_endif

	 _self.oTablas.Despliega(window)
	 
_endmethod
$
#  Objetivo: Manda llamar todos los metodos que crean e
#            inicializan las tablas
#  Parámetros de entrada: 
#    coordinate - RoCoord -
#                 Coordenada donde iniciara el resumen de
#                 materiales dentro del layout
#  Parámetros de salida:   NA
#  Regresa: NA
# Fecha de última modificación: 16/11/2004
# Autor de la modificación : dsanchez
# Descripción de la modificación: Se creo
_pragma(classify_level=restricted, usage={redefinable})
_method c_resumen_materiales.inicializa(_optional RoCoord)
	## 
	## 

	# Configuracion del sello transparente
	_self.set_fill_colour(_unset )
	
	_if RoCoord _is _unset 
	_then
		RoCoord << coordinate.new(0,0)
	_endif

	_self.oCoordOrigen << RoCoord
	
	# sepasa como parametro el layout
	# Crea el objeto que contiene todas las tablas del sello estandar
	_self.oTablas << c_tablas.new(_self)

	#Crea y configura cada una de las tablas 
	_self.prvCreaCfgTablas()

	#Se conoce el area de la tabla dibujada
	LoArea << _self.oTablas.area_total()

	#Se ajustan los limites del layout de acuerdo  a las tablas definidas
	_self.bounds << LoArea

	#Crea a los objetos que tendra c/u de las tablas
	_self.prvLlenaCeldas()


	#Indica que los objetos tabla ya fueron creados 
	_self.bTablas_creadas << _true

_endmethod
$


#  Objetivo: Manda llamar los metodos que crean y configuran 
#            las tablas 
#  Parámetros de entrada: 
#    coordinate - RoCoord -
#                 Coordenada donde iniciara el resumen de
#                 materiales dentro del layout
#  Parámetros de salida:   NA
#  Regresa: NA
# Fecha de última modificación: 16/11/2004
# Autor de la modificación : dsanchez
# Descripción de la modificación: Se creo
_pragma(classify_level=restricted, usage={redefinable})
_private _method c_resumen_materiales.prvCreaCfgTablas()
	## 
	## 
	_local LnAltura << 1
	LnAltura << _self.prvCreaCfgTblZonaUrbana(_self.oCoordOrigen)

	#se calcula la coordenada donde se dibujara la siguiente tabla,
	# pero incluyendo el desplazamianto en y "LnAltura" de la tabla anterior
	LoCoord  << coordinate.new(_self.oCoordOrigen.x, _self.oCoordOrigen.y - LnAltura)
	LnAltura << _self.PrvCreaCfgTblZonaSubUrbana(LoCoord)
	
	LoCoord << coordinate.new(_self.oCoordOrigen.x, LoCoord.y - LnAltura)
        LnAltura << _self.PrvCreaCfgTblTramo(LoCoord)
        write("verificando que tipo de sello voy a imprimir", _self.sTipo)
	_if _self.sTipo <> _self.sSembrado
	_then
	   LoCoord << coordinate.new(_self.oCoordOrigen.x, LoCoord.y - LnAltura)
           LnAltura << _self.PrvCreaCfgTblDerivaciones(LoCoord)

	   LoCoord << coordinate.new(_self.oCoordOrigen.x, LoCoord.y - LnAltura)
           LnAltura << _self.PrvCreaCfgTblPermisos(LoCoord)		
	_endif
	

_endmethod
$

#  Objetivo: Manda llamar los metodos que llenan las celdas de 
#            las tablas 
#  Parámetros de entrada: NA
#  Parámetros de salida:   NA
#  Regresa: NA
#  Fecha de última modificación: 16/11/2004
#  Autor de la modificación : dsanchez
#  Descripción de la modificación: Se creo
_pragma(classify_level=restricted, usage={redefinable})
_private _method c_Resumen_Materiales.prvLlenaCeldas()
	## 
	##
	_self.prvLlenaTblZonaUrbana()
        _self.prvLlenaTblZonaSubUrbana()
	_self.prvLlenaTblTramo()
	_if _self.sTipo <> _self.sSembrado 
	_then
	   _self.prvLlenaTblDerivaciones()
 	   _self.prvLlenaTblPermisos()				
	_endif

_endmethod
$


_pragma(classify_level=restricted, usage={redefinable})
_private _method c_Resumen_Materiales.prvLlena_Columna(RsTabla, RnTotRen, RoBase,
						       RcollLista, RnColumna)
##  Objetivo: Asigna los valores de una lista a una columnad e una tabla
##  Parámetros de entrada:
##    RsTabla. Llave o identificador de la tabla en la uqe se
##             quiere actualizar la columna
##    RnNumRe. Numero de renglones que tiene la tabla en la
##             parte del cuerpo
##    RoBase.  Caracteristicas del objeto base "c_texto_grafico"
##             del cual se tomara como base para crear el resto
##    RcollLista. Lista de cadenas que se metera en la columna
##    RnColumna. Numero de la columna donde se insertaran los
##             valores "RcollLista"
##  Parámetros de salida:   NA
##  Regresa: NA
##  Fecha de última modificación: 16/11/2004
##  Autor de la modificación : dsanchez
##  Descripción de la modificación: Se creo
	
	#asigna los objetos creados a su correspondiente celda
	#primera celda despues de descripcion
	#	_self.oTablas.elemento(RsTabla).oCeldas.Celda(2,RnColumna).oElemento << RoBase

	_for LnNumRen  _over range(1, RnTotRen)
	_loop
#           _if _self.oTablas.elemento(RsTabla).oCeldas.Celda(LnNumRen + 1,RnColumna).oElemento = _unset 
#	   _then
	      _if RoBase.is_kind_of?(c_texto_grafico) 
	      _then
   	         LoTexto << c_texto_grafico.new_from(RoBase, RcollLista[LnNumRen])
  	      _else
		 _local LsTxt << RcollLista[LnNumRen]     
	         LoTexto << c_captura_texto.new_from(RoBase, LsTxt.default("vacio") )
	      _endif
   
#	   _endif

  	   _self.oTablas.elemento(RsTabla).oCeldas.Celda(LnNumRen + 1,RnColumna).oElemento << LoTexto
	_endloop
_endmethod
$
#--------------------------------------------------------------------------
# * * * Resumen de materiales Zona URBANA
#--------------------------------------------------------------------------


_pragma(classify_level=restricted, usage={redefinable})
_private _method c_resumen_materiales.PrvCreaCfgTblZonaUrbana(RoCoord)

##  Objetivo: Crea y configura los objetos necesarios para la
##            tabla ZonaUrbana
##  Parámetros de entrada:
##   RoCoord. Coordenada donde iniciara a dibujarse la tabla 
##  Parámetros de salida:   NA
##  Regresa: NA
##  Fecha de última modificación: 16/11/2004
##  Autor de la modificación : dsanchez
##  Descripción de la modificación: Se creo	
	
	_local LoTblTitulo
	_local LoTblCuerpo
	
	LoTblTitulo << _self.oTablas.crea_tabla(2,1,:tbl_TitZonaUrbana)

	#lineas internas de la tabla no se dibujaran
	LoTblTitulo.bDibuja_Columnas_Internas?  << _false
	LoTblTitulo.bDibuja_Renglones_Internos? << _false
	
	#Coordenada donde iniciara la tabla
	LoTblTitulo.oCoordenada_Origen << RoCoord

	#longitudes de los renglones de la tabla, esta dada en mm 
	LoTblTitulo.oRenglones.elemento(1).nLongitud << _self.nAlto_Tit / 2.0  
	LoTblTitulo.oRenglones.elemento(2).nLongitud << _self.nAlto_Tit / 2.0  

	#longitud de las columnas, esta dada en mm 
	LoTblTitulo.oColumnas.elemento(1).nLongitud  << _self.nAncho_descrip + _self.nAncho_cant

	#-----------------------------------------------------------
	#Tabla cuerpo
	#-----------------------------------------------------------
	#_self.nNumRenZonaUrbana + 1 el uno es para incluir el
	# renglon del encabezado descripcion y cantidad
	LoTblCuerpo << _self.oTablas.crea_tabla(_self.nNumRenZonaUrbana + 1, 2, :tbl_ZonaUrbana)

	#coordenada donde iniciara la tabla que representa el cuerpo
	LnLong << _self.oTablas.Elemento(:tbl_titZonaUrbana).oRenglones.Longitud_total()
	LoCoordCuerpo << coordinate.new(RoCoord.x, RoCoord.y - LnLong)
	
	LoTblCuerpo.oCoordenada_Origen << LoCoordCuerpo

	#longitudes de los renglones de la tabla, esta dada en mm
	#renglon del encabezado 
        LoTblCuerpo.oRenglones.elemento(1).nLongitud << _Self.nAlto_descrip

	#renglones donde se representan las descripciones y cantidades
	_for LnNumRen  _over  range(2,_self.nNumRenZonaUrbana + 1 )
	_loop
	     LoTblCuerpo.oRenglones.elemento(LnNumRen).nLongitud << _self.nAlto_ren #2.5
	_endloop

	#longitud de las columnas, esta dada en mm 
	LoTblCuerpo.oColumnas.elemento(1).nLongitud  << _self.nAncho_descrip
	LoTblCuerpo.oColumnas.elemento(2).nLongitud  << _self.nAncho_cant

	LnAltura << _self.oTablas.Longitud_total_renglones({:tbl_titZonaUrbana, :tbl_ZonaUrbana})
	_return LnAltura
_endmethod
$

#  Objetivo: Asigna el objeto que contendra cada celda de la tabla
#  Parámetros de entrada: NA
#  Parámetros de salida:   NA
#  Regresa: NA
#  Fecha de última modificación: 16/11/2004
#  Autor de la modificación : dsanchez
#  Descripción de la modificación: Se creo
_pragma(classify_level=restricted, usage={redefinable})
_method c_Resumen_Materiales.prvLlenaTblZonaUrbana()
	## 
	## 

	#se crean los objetos que almacenara la tabla
	LoTit1  << c_texto_grafico.new("RESUMEN DE MATERIALES")
	LoTit2  << c_texto_grafico.new("EN LA ZONA URBANA")

	LoTit1.nTamanio << 26
	LoTit2.nTamanio << 26

	#asigna los objetos creados a su correspondiente celda
	_self.oTablas.elemento(:tbl_TitZonaUrbana).oCeldas.Celda(1,1).oElemento << LoTit1
	_self.oTablas.elemento(:tbl_TitZonaUrbana).oCeldas.Celda(2,1).oElemento << LoTit2

	#-----------------------------------------------------------
	#Tabla cuerpo
	#-----------------------------------------------------------
	_Local LnNumColDescripcion

	LnNumColDescripcion << 1
	
	LoDescrip  << c_texto_grafico.new("DESCRIPCION")
	LoDescrip.nTamanio << 24
	
	LoCantidad << c_texto_grafico.new_from(LoDescrip, "CANTIDAD")

	#asigna los objetos creados a su correspondiente celda 
	_self.oTablas.elemento(:tbl_ZonaUrbana).oCeldas.Celda(1,1).oElemento << LoDescrip
	_self.oTablas.elemento(:tbl_ZonaUrbana).oCeldas.Celda(1,2).oElemento << LoCantidad

	#Inicializa las descripciones 
	LcollDescripciones << _self.prvInicializa_Descrip_ZonaUrbana()

	#Se crea el objeto que se tomara como base para el resto de los objetos
	LoBase  << c_texto_grafico.new("Base")
	LoBase.nTamanio << 18
	LoBase.sAlineacion << :centre_left

	_self.prvLlena_Columna(:tbl_ZonaUrbana,_self.nNumRenZonaUrbana,
			       LoBase,LcollDescripciones, LnNumColDescripcion)
	#- - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
	# Llena la columna de cantidad
	#- - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
	
	LnNumColCantidad << 2 # numero de la columna
        LcollCantidades  << _self.prvInicializa_Cantidad_ZonaUrbana()
	LoBase  << c_captura_texto.new("Base")
	LoBase.sEstilo << "bold"
	LoBase.nTamanio << 2
	LoBase.sAlineacion  << :centre_left
	LoBase.bRecorte? << _true
        LoBase.nMargen_izq << 1	
	LoBase.nMargen_inf << 0.2


#	_self.prvLlena_Columna(:tbl_ZonaUrbana,_self.nNumRenZonaUrbana,
#			       LoBase,LcollDescripciones,LnNumColDescripcion)

	
	_self.prvLlena_Columna(:tbl_ZonaUrbana, _self.nNumRenZonaUrbana,
			       LoBase, LcollCAntidades,	LnNumColCantidad)	
#	_self.prvLlena_Columna(:tbl_ZonaUrbana, _self.nNumRenZonaUrbana,
#			       LoBase, LcollCantidades,LnNumColCantidad)
#			       LoBase,LcollDescripciones,2)	

#        _self.Cantidades_ZonaUrbana(_self.prvInicializa_Cantidad_ZonaUrbana())	
_endmethod
$

#  Objetivo: Asigna las cantidades a la columna de cantidades 
#  Parámetros de entrada: NA
#  Parámetros de salida:   NA
#  Regresa: NA
#  Fecha de última modificación: 16/11/2004
#  Autor de la modificación : dsanchez
#  Descripción de la modificación: Se creo
_pragma(classify_level=restricted, usage={redefinable})
_method c_Resumen_Materiales.Cantidades_ZonaUrbana(RcollCantidades)
	## 
	## 
	_local LnCol << 2

	_self.collCantZonaUrbana << RcollCantidades
	
	#Se crea el objeto que se tomara como base para el resto de los objetos
		LoBase  << c_texto_grafico.new("Objeto base")
	#	LoBase << c_Captura_Texto.new("Base")
	write("Cantidades Zona Urbana")
	LoBase.nTamanio << 18
	LoBase.sAlineacion << :centre_right
	_self.prvLlena_Columna(:tbl_ZonaUrbana, _self.nNumRenZonaUrbana,
			       LoBase, RcollCantidades,LnCol)
_endmethod
$

#  Objetivo: Llena la lista de las descripciones de la tabla
#            zona Urbana
#  Parámetros de entrada: NA
#  Parámetros de salida:   NA
#  Regresa: NA
#  Fecha de última modificación: 16/11/2004
#  Autor de la modificación : dsanchez
#  Descripción de la modificación: Se creo
_pragma(classify_level=restricted, usage={redefinable})
_private _method c_Resumen_Materiales.prvInicializa_Descrip_ZonaUrbana()
	## 
	## 
        _local LcollLista

	LcollLista << hash_table.new()

	lcollLista[01] << "B.D.F.O."
	lcollLista[02] << "DISTRIB. OPTICO"
	lcollLista[03] << "ECALERILLA P/F. O."
	lcollLista[04] << "DUCT. SDV. 35 .5 MM"
	lcollLista[05] << "TAPA PARA S. D. V."
	lcollLista[06] << "SOPORTES P/CAB.FO"
	lcollLista[07] << "CABLE FO. TM-"
	lcollLista[08] << "CAB. FO. TM- DER."
	lcollLista[09] << "PLACAS DE IDENTIF."
	lcollLista[10] << "CIERR. RECT. P/ FO."
	lcollLista[11] << "CIERR. DERIV. P/ FO"
	lcollLista[12] << "GAZAS A ELABORAR"
	lcollLista[13] << "EMP. FVS. MOD 6 FO."

	>> LcollLista
_endmethod
$

#  Objetivo: Llena la lista de las cantidades de la tabla
#            zona Urbana
#  Parámetros de entrada: NA
#  Parámetros de salida:   NA
#  Regresa: NA
#  Fecha de última modificación: 16/11/2004
#  Autor de la modificación : dsanchez
#  Descripción de la modificación: Se creo
_pragma(classify_level=restricted, usage={redefinable})
_private _method c_Resumen_Materiales.prvInicializa_Cantidad_ZonaUrbana()
	## 
	## 
        _local LcollLista

	LcollLista << hash_table.new()

	_for LnNumRen  _over range(1, _self.nNUmRenZonaUrbana)
	_loop
	   lcollLista[LnNumRen] << " " # LnNumRen.write_string		
	_endloop

	>> LcollLista
_endmethod
$
#--------------------------------------------------------------------------
# * * * Resumen de materiales Zona SUBURBANA
#--------------------------------------------------------------------------

#  Objetivo: Crea y configura lso objetos necesarios para la
#            tabla ZonaSuburbana
#  Parámetros de entrada:
#   RoCoord. Coordenada donde iniciara a dibujarse la tabla
#  Parámetros de salida:   NA
#  Regresa: NA
#  Fecha de última modificación: 16/11/2004
#  Autor de la modificación : dsanchez
#  Descripción de la modificación: Se creo
_pragma(classify_level=restricted, usage={redefinable})
_private _method c_resumen_materiales.prvCreaCfgTblZonaSubUrbana(RoCoord)
	## 
	## 
	_local LoTblTitulo
	_local LoTblCuerpo
	
	LoTblTitulo << _self.oTablas.crea_tabla(2,1,:tbl_TitZonaSubUrbana)

	#lineas internas de la tabla no se dibujaran
	LoTblTitulo.bDibuja_Columnas_Internas?  << _false
	LoTblTitulo.bDibuja_Renglones_Internos? << _false
	
	#Coordenada donde iniciara la tabla
	LoTblTitulo.oCoordenada_Origen << RoCoord

	#longitudes de los renglones de la tabla, esta dada en mm 
	LoTblTitulo.oRenglones.elemento(1).nLongitud << _self.nAlto_Tit / 2.0 
	LoTblTitulo.oRenglones.elemento(2).nLongitud << _self.nAlto_Tit / 2.0 

	#longitud de las columnas, esta dada en mm 
	LoTblTitulo.oColumnas.elemento(1).nLongitud  << _self.nAncho_descrip + _self.nAncho_cant

	#-----------------------------------------------------------
	#Tabla cuerpo
	#-----------------------------------------------------------
	_local LnLong

	#_self.nNumRen... + 1 el uno es para incluir el
	# renglon del encabezado descripcion y cantidad
	LoTblCuerpo << _self.oTablas.crea_tabla(_self.nNumRenZonaSubUrbana + 1 ,2,:tbl_ZonaSubUrbana)

	#coordenada donde iniciara la tabla que representa el cuerpo
	LnLong << _self.oTablas.Elemento(:tbl_titZonaSubUrbana).oRenglones.Longitud_total()
	LoCoordCuerpo << coordinate.new(RoCoord.x, RoCoord.y - LnLong)
	
	LoTblCuerpo.oCoordenada_Origen << LoCoordCuerpo
	
	#------------------------------------------------------
	#longitudes de los renglones de la tabla, esta dada en mm
	#------------------------------------------------------
	#Renglon del titulo descripcion y cantidad
        LoTblCuerpo.oRenglones.elemento(1).nLongitud << _Self.nAlto_descrip

	#inicia en 2 ya que ignora el renglon de los titulos
	_for LnNumRen  _over  range(2,_self.nNumRenZonaSubUrbana + 1)
	_loop
	     LoTblCuerpo.oRenglones.elemento(LnNumRen).nLongitud << _self.nAlto_ren
	_endloop

	#longitud de las columnas, esta dada en mm 
	LoTblCuerpo.oColumnas.elemento(1).nLongitud  << _self.nAncho_descrip
	LoTblCuerpo.oColumnas.elemento(2).nLongitud  << _self.nAncho_cant

	LnAltura << _self.oTablas.Longitud_total_renglones({:tbl_titZonaSubUrbana,
							    :tbl_ZonaSubUrbana})

	_return LnAltura 
_endmethod
$

#  Objetivo: Asigna el objeto que le corresponde a cada una de
#            las celdas
#  Parámetros de entrada: NA
#  Parámetros de salida:   NA
#  Regresa: NA
#  Fecha de última modificación: 16/11/2004
#  Autor de la modificación : dsanchez
#  Descripción de la modificación: Se creo
_pragma(classify_level=restricted, usage={redefinable})
_method c_Resumen_Materiales.prvLlenaTblZonaSubUrbana()
	## 
	## 

	#se crean los objetos que almacenara la tabla
	LoTit1  << c_texto_grafico.new("RESUMEN DE MATERIALES")
	LoTit2  << c_texto_grafico.new("EN LA ZONA SUBURBANA")

	LoTit1.nTamanio << 26
	LoTit2.nTamanio << 26

	#asigna los objetos creados a su correspondiente celda
	_self.oTablas.elemento(:tbl_TitZonaSubUrbana).oCeldas.Celda(1,1).oElemento << LoTit1
	_self.oTablas.elemento(:tbl_TitZonaSubUrbana).oCeldas.Celda(2,1).oElemento << LoTit2

	#-----------------------------------------------------------
	#Tabla cuerpo
	#-----------------------------------------------------------
	_Local LnNumColDescripcion << 1

	LoDescrip  << c_texto_grafico.new("DESCRIPCION")
	LoDescrip.nTamanio << 24
	
	LoCantidad << c_texto_grafico.new_from(LoDescrip, "CANTIDAD")

	#asigna los objetos creados a su correspondiente celda
	_self.oTablas.elemento(:tbl_ZonaSubUrbana).oCeldas.Celda(1,1).oElemento << LoDescrip
	_self.oTablas.elemento(:tbl_ZonaSubUrbana).oCeldas.Celda(1,2).oElemento << LoCantidad

	LcollDescripciones << _self.prvInicializa_Descrip_SubUrbanas()

	#Se crea el objeto que se tomara como base para el resto de los objetos
	LoBase  << c_texto_grafico.new("Base")
	LoBase.nTamanio << 20
	LoBase.sAlineacion << :centre_left
	_self.prvLlena_Columna(:tbl_ZonaSubUrbana, _self.nNumRenZonaSubUrbana,
			       LoBase, LcollDescripciones, LnNumColDescripcion)


	#- - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
	# Llena la columna de cantidad
	#- - - - - - - - - - - - - - - - - - - - - - - - - - - - - -	
	
	LnNumColCantidad << 2 # numero de la columna
	LcollCantidades << _self.prvInicializa_Cantidad_ZonaSubUrbana()
	LoBase  << c_captura_texto.new("Base")
	LoBase.sEstilo << "bold"
	LoBase.nTamanio << 2
	LoBase.sAlineacion  << :centre_left
	LoBase.bRecorte? << _true
        LoBase.nMargen_izq << 1	
	LoBase.nMargen_inf << 0.2
	_self.prvLlena_Columna(:tbl_ZonaSubUrbana, _self.nNumRenZonaSubUrbana,
			       LoBase, LcollCantidades,LnNumColCantidad)

	
_endmethod
$

#  Objetivo: Asigna las cantidades a la columna de cantidades 
#  Parámetros de entrada: NA
#  Parámetros de salida:   NA
#  Regresa: NA
#  Fecha de última modificación: 16/11/2004
