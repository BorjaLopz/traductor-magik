	_local LnCol << 2

	_self.collCantZonaSubUrbana << RcollCantidades
	
	#Se crea el objeto que se tomara como base para el resto de los objetos
	LoBase  << c_texto_grafico.new("Objeto base")
	LoBase.nTamanio << 18
	LoBase.sAlineacion << :centre_right
	_self.prvLlena_Columna(:tbl_ZonaSubUrbana, _self.nNumRenZonaSubUrbana,
			       LoBase, RcollCantidades, LnCol)
_endmethod
$

