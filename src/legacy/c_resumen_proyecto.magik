_pragma(classify_level=restricted, usage={redefinable})
_method c_resumen_proyecto.prvLlenaSimb_Col1()

## Objetivo: Se colocan todos los simbolos en el sello y sus etiquetas. Columna1
## Parámetros de entrada:  NA
## Parámetros de salida:   NA
## Regresa: NA
## Fecha de última modificación: 3/Marzo/2005
## Autor de la modificación : FADD
## Descripción de la modificación: Se documentó	

	_local LoSimbolo  #Objeto que contendra el dibujo a poner en el sello
        _local LoTexto    #Objeto que contendra el texto a poner a lado del simbolo
	_local LsCadena   #Permite armar las etiquetas de texto con codigos de nueva linea
	
	# Simbolo y Texto EMPALME TERMINAL PROYECTADO
	LoSimbolo << c_simbolo_grafico.new("empalme_terminal_p")
	LoSimbolo.nMargen_izq << 1
	LoSimbolo.nMargen_der << 1
	LoSimbolo.nMargen_sup << 1
	LoSimbolo.nMargen_inf << 1


	            #123456789012345678901234
        LsCadena << "EMPALME TERMINAL" +  character.newline +
		    "PROYECTADO" 
	
	LoTexto  << c_texto_grafico.new(LsCadena)
	
	LoTexto.nTamanio << 18
	LoTexto.sEstilo << "fixed"
	LoTexto.sAlineacion << :centre_centre
	
	_self.oTablas.elemento(:tbl_Simbologia_Col1).oCeldas.Celda(1,1).oElementos.Agregar_elemento(LoSimbolo,:t_sc1)
	_self.oTablas.elemento(:tbl_Simbologia_Col1).oCeldas.Celda(1,2).oElemento << LoTexto

	# Simbolo y Texto EMPALME RECTO PROYECTADO
	LoSimbolo << c_simbolo_grafico.new_from(LoSimbolo,"empalme_recto_p")

	            #123456789012345678901234
        LsCadena << "EMPALME RECTO PROYECTADO"
	
	LoTexto  << c_texto_grafico.new_from(LoTexto,LsCadena)
	
	_self.oTablas.elemento(:tbl_Simbologia_Col1).oCeldas.Celda(2,1).oElementos.Agregar_elemento(LoSimbolo,:t_sc1)
	_self.oTablas.elemento(:tbl_Simbologia_Col1).oCeldas.Celda(2,2).oElemento << LoTexto

	# Simbolo y Texto EMPALME DERIVACION PROYECTADO
	LoSimbolo << c_simbolo_grafico.new_from(LoSimbolo,"empalme_derivacion_p")

	            #123456789012345678901234
        LsCadena << "EMPALME DERIVACION" +  character.newline +
		    "PROYECTADO" 
	
	LoTexto  << c_texto_grafico.new_from(LoTexto,LsCadena)
	
	_self.oTablas.elemento(:tbl_Simbologia_Col1).oCeldas.Celda(3,1).oElementos.Agregar_elemento(LoSimbolo,:t_sc1)
	_self.oTablas.elemento(:tbl_Simbologia_Col1).oCeldas.Celda(3,2).oElemento << LoTexto

	# Simbolo y Texto CANALIZACION Y POZO EXISTENTE
	LoSimbolo << c_simbolo_grafico.new_from(LoSimbolo,"canalizacion_pe")
	
 	            #123456789012345678901234
        LsCadena << "CANALIZACION Y POZO" +  character.newline +
		    "EXISTENTE" 

	LoTexto  << c_texto_grafico.new_from(LoTexto,LsCadena)
	
	_self.oTablas.elemento(:tbl_Simbologia_Col1).oCeldas.Celda(4,1).oElementos.Agregar_elemento(LoSimbolo,:t_sc1)
	_self.oTablas.elemento(:tbl_Simbologia_Col1).oCeldas.Celda(4,2).oElemento << LoTexto

	# Simbolo y Texto CANALIZACION Y POZO PROYECTADO
	LoSimbolo << c_simbolo_grafico.new_from(LoSimbolo,"canalizacion_ppp")

 	            #123456789012345678901234
        LsCadena << "CANALIZACION Y POZO" +  character.newline +
		    "PROYECTADO EN PVC" 

	LoTexto  << c_texto_grafico.new_from(LoTexto,LsCadena)
	
	_self.oTablas.elemento(:tbl_Simbologia_Col1).oCeldas.Celda(5,1).oElementos.Agregar_elemento(LoSimbolo,:t_sc1)
	_self.oTablas.elemento(:tbl_Simbologia_Col1).oCeldas.Celda(5,2).oElemento << LoTexto


	# Simbolo y Texto FO EXISTENTE (ENTERRADA)
	LoSimbolo << c_simbolo_grafico.new_from(LoSimbolo,"fibra optica existente e")

	            #123456789012345678901234
        LsCadena << "F.O. EXISTENTE " +  character.newline +
		    "(ENTERRADA)" +  character.newline 
	
	LoTexto  << c_texto_grafico.new_from(LoTexto,LsCadena)
	
	_self.oTablas.elemento(:tbl_Simbologia_Col1).oCeldas.Celda(6,1).oElementos.Agregar_elemento(LoSimbolo,:t_sc1)
	_self.oTablas.elemento(:tbl_Simbologia_Col1).oCeldas.Celda(6,2).oElemento << LoTexto

	# Simbolo y Texto FO PROYECTADA (ENTERRADA)
	LoSimbolo << c_simbolo_grafico.new_from(LoSimbolo,"fibra optica proyectada e")

	            #123456789012345678901234
        LsCadena << "F.O. PROYECTADA " +  character.newline +
		    "(ENTERRADA)" +  character.newline 
	
	LoTexto  << c_texto_grafico.new_from(LoTexto,LsCadena)
	
	_self.oTablas.elemento(:tbl_Simbologia_Col1).oCeldas.Celda(7,1).oElementos.Agregar_elemento(LoSimbolo,:t_sc1)
	_self.oTablas.elemento(:tbl_Simbologia_Col1).oCeldas.Celda(7,2).oElemento << LoTexto
		
	
_endmethod	


