_package user
$
def_slotted_exemplar(:c_sello_capacidad_cable,
{
}, :c_base_sello_fibra)
$
_pragma(classify_level=advanced, topic={plotting}, usage={subclassable})
_method c_sello_capacidad_cable.configura_tabla()


_local LoTblContenido
_local LoTbl

       # Titulo1
       LoTblTitulo<<property_list.new_with_properties(:ren,{6,6},
						      :col,{44})
       LoTbl<<.o_tablas.crea_tabla(2,1,:tbl_titulo)
       LoTbl.ocoordenada_origen << .o_coord_inicio
       _self.asigna_medidas_tabla(LoTbl, LoTblTitulo)
       
       # Ocultar bordes
       LcollBordes<<property_list.new()
       LcollBordes[:borde_sup]<<rope.new_with({1,1})
       _self.oculta_bordes_celdas(LoTbl,LcollBordes)

       LcollBordes.empty()
       LcollBordes[:borde_der_izq]<<rope.new_with({1,1})
       _self.oculta_bordes_celdas(LoTbl,LcollBordes)

       # ------------------
       # Contenido
       LoTblContenido << property_list.new_with_properties(:ren,{6,6,6,6,6,6,6,6,6,6,6,6,6,6,6,6,6,6},
							   :col,{7,37})
      
       LoTbl <<.o_tablas.crea_tabla(18,2, :tbl_contenido)
       LfDesplazaY << .o_tablas.longitud_total_renglones({:tbl_titulo})
       LoTbl.ocoordenada_origen << coordinate.new( .o_coord_inicio.x,
						    .o_coord_inicio.y - LfDesplazaY)
       _self.asigna_medidas_tabla(LoTbl, LoTblContenido)
	
_endmethod
$
_pragma(classify_level=advanced, topic={plotting}, usage={subclassable})
