_pragma(classify_level=advanced, topic={plotting}, usage={subclassable})
_method c_sello_competencia_telmex.configura_tabla()


_local LoTblContenido
_local LoTbl


       # Contenido
       LoTblContenido << property_list.new_with_properties(:ren,{6,6,6,6,6,6,6,6,6,6},
							   :col,{10,27,7})
      
       LoTbl <<.o_tablas.crea_tabla(10,3, :tbl_contenido)
       LoTbl.ocoordenada_origen << .o_coord_inicio
       _self.asigna_medidas_tabla(LoTbl, LoTblContenido)

       LcollBordes<<property_list.new() # ren, col
       LcollBordes[:borde_der_izq]<<rope.new_with({1,2},{2,2},{3,2},{4,2},{5,2},{6,2},{7,2},{8,2},{9,2},{10,2})
       _self.oculta_bordes_celdas(LoTbl,LcollBordes)
       
       LcollBordes.empty()
       LcollBordes[:borde_der]<<rope.new_with({1,1},{2,1},{3,1},{4,1},{5,1},{6,1},{7,1},{8,1},{9,1},{10,1})
       _self.oculta_bordes_celdas(LoTbl,LcollBordes)
       
       LcollBordes.empty()
       LcollBordes[:borde_inf]<<rope.new_with({1,1},{2,1},{3,1},{4,1},{5,1},{6,1},{7,1},{8,1},{9,1},
					      {1,2},{2,2},{3,2},{4,2},{5,2},{6,2},{7,2},{8,2},{9,2},
					      {1,3},{2,3},{3,3},{4,3},{5,3},{6,3},{7,3},{8,3},{9,3})
       _self.oculta_bordes_celdas(LoTbl,LcollBordes)

      
       
	
_endmethod
$
_pragma(classify_level=advanced, topic={plotting}, usage={subclassable})
_method c_sello_competencia_telmex.etiqueta_celdas()
	
	_self.asigna_simbolo_celda(:tbl_contenido,1,1,"p_predio_deshabitado",1)
	_self.asigna_simbolo_celda(:tbl_contenido,2,1,"p_tv_satelital",1)
	_self.asigna_simbolo_celda(:tbl_contenido,3,1,"p_tv_por_cable",1)
	_self.asigna_simbolo_celda(:tbl_contenido,4,1,"p_operteles",1)
	_self.asigna_simbolo_celda(:tbl_contenido,5,1,"p_operteles_inalambrica",1)
	_self.asigna_simbolo_celda(:tbl_contenido,6,1,"p_telmex_inalambrica",1)
	_self.asigna_simbolo_celda(:tbl_contenido,7,1,"p_telpub_compet",1)
	_self.asigna_simbolo_celda(:tbl_contenido,8,1,"p_caseta_ladafon",1)
	_self.asigna_simbolo_celda(:tbl_contenido,9,1,"p_caseta_ladatel",1)
	_self.asigna_simbolo_celda(:tbl_contenido,10,1,"p_solicitud",1)

	_self.asigna_texto_celda(:tbl_contenido,1,2,"PREDIO DESHABITADO",20,:centre_centre,0,{0,0,0})
	_self.asigna_texto_celda(:tbl_contenido,2,2,"TELEVISION SATELITAL",20,:centre_centre,0,{0,0,0})
	_self.asigna_texto_celda(:tbl_contenido,3,2,"TELEVISION/CABLE",20,:centre_centre,0,{0,0,0})
	_self.asigna_texto_celda(:tbl_contenido,4,2,"OPERTELES",20,:centre_centre,0,{0.05981,0.05981,0.4090})
	_self.asigna_texto_celda(:tbl_contenido,5,2,"INALAMBRICA OPERTELES",20,:centre_centre,0,{0.05981,0.05981,0.4090})
	_self.asigna_texto_celda(:tbl_contenido,6,2,"INALAMBRICA TELMEX",20,:centre_centre,0,{0,0,0})
	_self.asigna_texto_celda(:tbl_contenido,7,2,"TEL/PUB COMPET.",20,:centre_centre,0,{0,0,1})
	_self.asigna_texto_celda(:tbl_contenido,8,2,"CASETA LADAFON",20,:centre_centre,0,{0,0,0})
	_self.asigna_texto_celda(:tbl_contenido,9,2,"CASETA LADATEL",20,:centre_centre,0,{0,0.2953,0})
	_self.asigna_texto_celda(:tbl_contenido,10,2,"SOLICITUD",20,:centre_centre,0,{0,0,0})


	# contar la competencia.
	_self.asigna_texto_celda(:tbl_contenido,1,3,_self.pred_deshabitado,20,:centre_centre,0,{0,0,0})
	_self.asigna_texto_celda(:tbl_contenido,2,3,_self.tv_satelital,20,:centre_centre,0,{0,0,0})
	_self.asigna_texto_celda(:tbl_contenido,3,3,_self.tv_cable,20,:centre_centre,0,{0,0,0})
	_self.asigna_texto_celda(:tbl_contenido,4,3,_self.operteles,20,:centre_centre,0,{0,0,0})
	_self.asigna_texto_celda(:tbl_contenido,5,3,_self.operteles_inalam,20,:centre_centre,0,{0,0,0})
	_self.asigna_texto_celda(:tbl_contenido,6,3,_self.telmex_inalam,20,:centre_centre,0,{0,0,0})
	_self.asigna_texto_celda(:tbl_contenido,7,3,_self.tel_pub_compet,20,:centre_centre,0,{0,0,0})
	_self.asigna_texto_celda(:tbl_contenido,8,3,_self.caseta_ladafon,20,:centre_centre,0,{0,0,0})
	_self.asigna_texto_celda(:tbl_contenido,9,3,_self.caseta_ladatel,20,:centre_centre,0,{0,0,0})
	_self.asigna_texto_celda(:tbl_contenido,10,3,_self.solicitud,20,:centre_centre,0,{0,0,0})	
_endmethod
