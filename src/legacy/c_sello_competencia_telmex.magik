_pragma(classify_level=advanced, topic={plotting}, usage={subclassable})
_method c_sello_competencia_telmex.llena_datos_celdas()
	## 
	##
	#_local lpl_datos << _self.obten_registros()
	LcollTabUserBuilding<<gis_program_manager.cached_dataset(:gis).collections[:user!_building]
       _if _self.idEdificio _isnt _unset
       _then
	       LoUserBuilding<<LcollTabUserBuilding.at(_self.idEdificio)
	       _if LoUserBuilding _isnt _unset
	       _then
		       #LcollInventDet<<LoUserBuilding.user!_lote.obtener_inventario_detallado()
		       LcollInventDet<<LoUserBuilding.obtener_inventario_detallado()
		       
		       #_self.pred_deshabitado<<LcollInventDet[:user!_deshabitado][2].write_string
		       #_self.tv_satelital<<LcollInventDet[:user!_tv_satelite][2].write_string
		       #_self.tv_cable<<LcollInventDet[:user!_tv_cable][2].write_string
		       _self.operteles<<LcollInventDet[:user!_linea_comp_cu].write_string
		       _self.operteles_inalam<<LcollInventDet[:user!_linea_comp_inal].write_string
		       _self.telmex_inalam<<LcollInventDet[:user!_linea_inal].write_string
		       _self.tel_pub_compet<<LcollInventDet[:user!_tel_pub_comp].write_string
		       _self.caseta_ladafon<<LcollInventDet[:user!_linea_lf].write_string
		       _self.caseta_ladatel<<LcollInventDet[:user!_linea_pslt].write_string
		       #_self.solicitud<<LcollInventDet[:user!_solicitudes][2].write_string
	       _endif
       _endif
       
	_self.asigna_texto_celda(:tbl_contenido,1,3,_self.pred_deshabitado,20,:centre_centre,0,{0,0,0})
	_self.asigna_texto_celda(:tbl_contenido,2,3,_self.tv_satelital,20,:centre_centre,0,{0,0,0})
	_self.asigna_texto_celda(:tbl_contenido,3,3,_self.tv_cable,20,:centre_centre,0,{0,0,0})
	_self.asigna_texto_celda(:tbl_contenido,4,3,_self.operteles,20,:centre_centre,0,{0,0,0})
	_self.asigna_texto_celda(:tbl_contenido,5,3,_self.operteles_inalam,20,:centre_centre,0,{0,0,0})
	_self.asigna_texto_celda(:tbl_contenido,6,3,_self.telmex_inalam,20,:centre_centre,0,{0,0,0})
	_self.asigna_texto_celda(:tbl_contenido,7,3,_self.tel_pub_compet,20,:centre_centre,0,{0,0,0})
	_self.asigna_texto_celda(:tbl_contenido,8,3,_self.caseta_ladafon,20,:centre_centre,0,{0,0,0})
	_self.asigna_texto_celda(:tbl_contenido,9,3,_self.caseta_ladatel,20,:centre_centre,0,{0,0,0})
	_self.asigna_texto_celda(:tbl_contenido,10,3,_self.solicitud,20,:centre_centre,0,{0,0,0})
_endmethod
