_pragma(classify_level=restricted, usage={redefinable})
_method c_sello_competencia_telmex.defined_attributes
	## 
	## 
_local LcollAtributos

	LcollAtributos << rope.new_from(_super.defined_attributes)

	# Resumen Telefonia-------------------------------------------------------
	
	LcollAtributos.add(layout_attribute_definition.new(:pred_deshabitado, :string,
							   :description, "Predio Deshabitado",
							   :default_value, "",
							   :allowed_on_properties_page?, _false,
							   :editor, _unset))
	LcollAtributos.add(layout_attribute_definition.new(:tv_satelital, :string,
							   :description, "Television Satelital",
							   :default_value, "",
							   :allowed_on_properties_page?, _false,
							   :editor, _unset))
	LcollAtributos.add(layout_attribute_definition.new(:tv_cable, :string,
							   :description, "Television por Cable",
							   :default_value, "",
							   :allowed_on_properties_page?, _false,
							   :editor, _unset))
	LcollAtributos.add(layout_attribute_definition.new(:operteles, :string,
							   :description, "Operteles",
							   :default_value, "",
							   :allowed_on_properties_page?, _false,
							   :editor, _unset))
	LcollAtributos.add(layout_attribute_definition.new(:operteles_inalam, :string,
							   :description, "Operteles inalambrico",
							   :default_value, "",
							   :allowed_on_properties_page?, _false,
							   :editor, _unset))
	LcollAtributos.add(layout_attribute_definition.new(:telmex_inalam, :string,
							   :description, "Telmex Inalambrico",
							   :default_value, "",
							   :allowed_on_properties_page?, _false,
							   :editor, _unset))
	LcollAtributos.add(layout_attribute_definition.new(:tel_pub_compet, :string,
							   :description, "Telefonia Publica Competencia",
							   :default_value, "",
							   :allowed_on_properties_page?, _false,
							   :editor, _unset))
	LcollAtributos.add(layout_attribute_definition.new(:caseta_ladafon, :string,
							   :description, "Caseta Ladafon",
							   :default_value, "",
							   :allowed_on_properties_page?, _false,
							   :editor, _unset))
	LcollAtributos.add(layout_attribute_definition.new(:caseta_ladatel, :string,
							   :description, "Caseta LadaTel",
							   :default_value, "",
							   :allowed_on_properties_page?, _false,
							   :editor, _unset))
	LcollAtributos.add(layout_attribute_definition.new(:solicitud, :string,
							   :description, "Solicitud.",
							   :default_value, "",
							   :allowed_on_properties_page?, _false,
							   :editor, _unset))

	LcollAtributos.add(layout_attribute_definition.new(:idEdificio, :integer,
							   :description, "id del edificio",
							   :default_value, _unset,
							   :allowed_on_properties_page?, _false,
							   :editor, _unset))
	
	_return LcollAtributos
_endmethod
