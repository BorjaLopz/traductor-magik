_pragma(classify_level=restricted, topic={default_class})
_method c_sello_cuadro_de_notas.prvCrea_Tablas(RoCoord)


	#----------------------------------------------------------
	# Tabla Referencia
	#-----------------------------------------------------------
	lo_tabla << _self.oTablas.crea_tabla(1,1,:tbl_referencia)
	lo_tabla.ocoordenada_origen << RoCoord
	lo_tabla.orenglones.elemento(1).nlongitud << 1
	lo_tabla.ocolumnas.elemento(1).nlongitud << 1
	lo_celda << lo_tabla.oceldas.celda(1,1).oelementos.obten_elemento(:bordes_celda)
	lo_celda.bBorde_Der? << _false 
	lo_celda.bBorde_Izq? << _false 
	lo_celda.bBorde_Sup? << _false 
	lo_celda.bBorde_Inf? << _false 
	
	_if .info_tablas _isnt _unset 
	_then
		#----------------------------------------------------------
		# Tabla Contenedora
		#-----------------------------------------------------------
		lo_tablaCont << _self.oTablas.crea_tabla(1,1,:tbl_contenedora)
		lo_tablaCont.ocoordenada_origen << RoCoord
		lo_tablaCont.orenglones.elemento(1).nlongitud << .info_tablas[:alto].as_integer()
		lo_tablaCont.ocolumnas.elemento(1).nlongitud << .info_tablas[:ancho].as_integer()
		lo_celda << lo_tablaCont.oceldas.celda(1,1).oelementos.obten_elemento(:bordes_celda)
		lo_celda.bBorde_Der? << _false 
		lo_celda.bBorde_Izq? << _false 
		lo_celda.bBorde_Sup? << _false 
		lo_celda.bBorde_Inf? << _false 
		_if .info_tablas[:titulo] _isnt _unset _andif
		    .info_tablas[:titulo] = _true 
		_then
			#----------------------------------------------------------
			# Tabla de titulo
			#-----------------------------------------------------------
			lo_tablaTit << _self.oTablas.crea_tabla(1,1,:tbl_titulo)
			lo_tablaTit.ocoordenada_origen << RoCoord
			alto_titulo << .info_tablas[:alto].as_integer()_div 10
			lo_tablaTit.orenglones.elemento(1).nlongitud << alto_titulo
			lo_tablaTit.ocolumnas.elemento(1).nlongitud << .info_tablas[:ancho].as_integer()
			lo_celda << lo_tablaTit.oceldas.celda(1,1).oelementos.obten_elemento(:bordes_celda)
			lo_celda.bBorde_Der? << _false 
			lo_celda.bBorde_Izq? << _false 
			lo_celda.bBorde_Sup? << _false 
			lo_celda.bBorde_Inf? << _false 
			#----------------------------------------------------------
			# Tablas dinamicas
			#-----------------------------------------------------------
			ln_desp_y << 0
			LongTotal << _self.oTablas.longitud_total_renglones({:tbl_titulo})
			TotRenglones << 1
			TotColumnas << 0
			tamanio_renglones << 0
			tamanio_columnas << 0
			_for nomTabla,valores _over .info_tablas[:tablas].fast_keys_and_elements()
			_loop
				lo_tabla << _self.oTablas.crea_tabla(valores[:renglones],
								     valores[:columnas],
								     nomTabla)
				TotRenglones+<<valores[:renglones]
				_if valores[:columnas] > TotColumnas
				_then
					TotColumnas<<valores[:columnas]
				_endif
				_for renglon _over range(1,valores[:renglones])
				_loop
					lo_tabla.orenglones.elemento(renglon).nlongitud << valores[:t_reng]
					LongTotal+<<lo_tabla.orenglones.elemento(renglon).nlongitud
				_endloop
				_for columna _over range(1,valores[:columnas])
				_loop
					lo_tabla.ocolumnas.elemento(columna).nlongitud << valores[:t_col]
				_endloop
				RoCoord << lo_tabla.ocoordenada_origen							
				ln_desp_y << (LongTotal-_self.oTablas.longitud_total_renglones({nomTabla}))
				lo_tabla.ocoordenada_origen << coordinate.new(RoCoord.x,
									      RoCoord.y-ln_desp_y)
				tamanio_renglones +<< valores[:t_reng] * valores[:renglones]
				tamanio_columnas +<< valores[:t_col] * valores[:columnas]
				####
				_for celda,val _over valores[:celdas].fast_keys_and_elements() 
				_loop
					rc << celda.write_string.split_by(",")
					re << rc[1].as_integer()
					co << rc[2].as_integer()
					lo_celda << lo_tabla.oceldas.celda(re,co).oelementos.obten_elemento(:bordes_celda)
					_if val[:borde_der] = _true 
					_then
						lo_celda.bBorde_Der? << _true
					_else
						lo_celda.bBorde_Der? << _false 
					_endif
					_if val[:borde_izq] = _true 
					_then
						lo_celda.bBorde_Izq? << _true
					_else
						lo_celda.bBorde_Izq? << _false 
					_endif
					_if val[:borde_sup] = _true 
					_then
						lo_celda.bBorde_Sup? << _true
					_else
						lo_celda.bBorde_Sup? << _false 
					_endif
					_if val[:borde_inf] = _true 
					_then
						lo_celda.bBorde_Inf? << _true
					_else
						lo_celda.bBorde_Inf? << _false 
					_endif
					
				_endloop
				#	lo_color_tabla << (1,10,2)#valores[:color]
				#	c_tabla.color_linea << lo_color_tabla
			
				####
				
			_endloop
			long_tit << lo_tablaTit.orenglones.elemento(1).nlongitud
			lo_tablaCont.orenglones.elemento(1).nlongitud  << alto_titulo + tamanio_renglones
			lo_tablaCont.ocolumnas.elemento(1).nlongitud  << tamanio_columnas
			lo_tablaTit.ocolumnas.elemento(1).nlongitud  << tamanio_columnas
		_endif
	_endif
	
	
	
_endmethod
$
_pragma(classify_level=restricted, topic={default_class})
_method c_sello_cuadro_de_notas.prvLlena_Celdas()
		## 
	_if .info_tablas _isnt _unset 
	_then
		#---------------------------------------------------------------
		# Texto tabla contenedora
		#---------------------------------------------------------------
		_if _self.oTablas.elemento(:tbl_contenedora) _isnt _unset 
		_then
			_self.oTablas.elemento(:tbl_contenedora).oCeldas.Celda(1,1).oElemento << texto1
		_endif
		
		#---------------------------------------------------------------
		# Texto tabla de titulo
		#---------------------------------------------------------------
		_if _self.oTablas.elemento(:tbl_titulo) _isnt _unset 
		_then
			texto1 << c_texto_grafico.new("TITULO")
			texto1.sColor << colour.new_rgb(1.0,0.0,0.0) 
			texto1.nTamanio << 100
			texto1.sOrientacion << :left_right
			texto1.sAlineacion << :centre_centre
			texto1.sEstilo << "Arial"
			texto1.bSubrayado? << _true
			_self.oTablas.elemento(:tbl_titulo).oCeldas.Celda(1,1).oElemento << texto1
		_endif
		
		#---------------------------------------------------------------
		# Texto tablas dinamicas
		#---------------------------------------------------------------
		_for tabla,valores _over .info_tablas[:tablas].fast_keys_and_elements()
		_loop
			_for celda,val _over valores[:celdas].fast_keys_and_elements()
			_loop
				cadena << val[:texto].write_string
				texto1 << c_texto_grafico.new(cadena)
				## Define los grados a los que se rotara el texto
				texto1.nGrados << val[:grados].as_integer()
				## Define el color del texto
				color << val[:color] 
				RR << color.scaled_rgb_vector()[1]
				GG << color.scaled_rgb_vector()[2]
				BB << color.scaled_rgb_vector()[3]
				cad_color << rr.write_string + "," + gg.write_string + "," + bb.write_string 
				texto1.sColor <<  colour.new_from_dec(cad_color)
				## Define el tamanio
				texto1.nTamanio << val[:tamanio].as_integer()
				## Define la orientacion
				texto1.sOrientacion << val[:orientacion]
				## Define la alineacion
				texto1.sAlineacion << val[:alineacion]
				## Define el estilo
				texto1.sEstilo << _self.verifica_estilo_fuente(val[:estilo])
				## Define el subrayado
				_if val[:subrayado] = :true 
				_then
					texto1.bSubrayado? << _true
				_else
					textl1.bSubrayado? << _false 
				_endif
				## Asigna el texto en la celda seleccionada
				rc << celda.write_string.split_by(",")
				reng << rc[1].as_integer()
				col << rc[2].as_integer()
				_self.oTablas.elemento(tabla.as_symbol()).oCeldas.Celda(reng,col).oElemento << texto1	
			_endloop
		_endloop
	_else
		#---------------------------------------------------------------
		# Texto tabla de referencia
		#---------------------------------------------------------------
		texto1 << c_texto_grafico.new("")
		_self.oTablas.elemento(:tbl_referencia).oCeldas.Celda(1,1).oElemento << texto1
		
	_endif
	
	
	
_endmethod
$
_pragma(classify_level=restricted, topic={default_class})
_method c_sello_cuadro_de_notas.prvAsignaTexto()
	## 
	## 
	_if .info_tablas _isnt _unset 
	_then
		#---------------------------------------------------------------
		# Texto tabla contenedora
		#---------------------------------------------------------------
		_if _self.oTablas.elemento(:tbl_contenedora) _isnt _unset 
		_then
			_self.oTablas.elemento(:tbl_contenedora).oCeldas.Celda(1,1).oElemento << texto1
		_endif
		#---------------------------------------------------------------
		# Texto tabla de titulo
		#---------------------------------------------------------------
		_if _self.oTablas.elemento(:tbl_titulo) _isnt _unset 
		_then
			texto1 << c_texto_grafico.new(_self.titulo)
			texto1.sColor << colour.new_rgb(1.0,0.0,0.0) 
			texto1.nTamanio << 100
