_pragma(classify_level=restricted, topic={default_class})
_method c_sello_cuadro_de_notas.verifica_estilo_fuente(font_seleccionada)
	## 
	##
	
	_if font_seleccionada = 1
	_then
		tipo_de_fuente << "Arial"
	_elif font_seleccionada = 2
	_then
		tipo_de_fuente << "Hershey-Italic"
	_elif font_seleccionada = 3
	_then
		tipo_de_fuente << "Hershey-Italic-Narrow"
	_elif font_seleccionada = 4
	_then
		tipo_de_fuente << "Hershey-Italic-Wide"
	_elif font_seleccionada = 5
	_then
		tipo_de_fuente << "Hershey-Roman" 
	_elif font_seleccionada = 6
	_then
		tipo_de_fuente << "Hershey-Roman-Narrow" 
	_elif font_seleccionada = 7
	_then
		tipo_de_fuente << "Hershey-Roman-Wide"
	_elif font_seleccionada = 8
	_then
		tipo_de_fuente << "Hershey-Romand"
	_elif font_seleccionada = 9
	_then
		tipo_de_fuente << "Hershey-Romanp" 
	_elif font_seleccionada = 10
	_then
		tipo_de_fuente << "Hershey-Romanp-German"
	_elif font_seleccionada = 11
	_then
		tipo_de_fuente << "Hershey-Romanp-hebrew"
	_elif font_seleccionada = 12
	_then
		tipo_de_fuente << "Hershey-Script" 
	_elif font_seleccionada = 13
	_then
		tipo_de_fuente << "Hershey-Script-Narrow" 
	_elif font_seleccionada = 14
	_then
		tipo_de_fuente << "SIGC1"
	_elif font_seleccionada = 15
	_then
		tipo_de_fuente << "SIGC2" 
	_elif font_seleccionada = 16
	_then
		tipo_de_fuente << "SIGC3" 
	_elif font_seleccionada = 17
	_then
		tipo_de_fuente << "Steve"
	_elif font_seleccionada = 18
	_then
		tipo_de_fuente << "Times_New_Roman"
	_elif font_seleccionada = 19
	_then
		tipo_de_fuente << "TwCenMT" 	
	_elif font_seleccionada = 20
	_then
		tipo_de_fuente << "Xfixed"
	_elif font_seleccionada = 21
	_then 
		tipo_de_fuente << "bibi"
	_elif font_seleccionada = 22
	_then 
		tipo_de_fuente << "bold" 
	_elif font_seleccionada = 23
	_then
		tipo_de_fuente << "fancy" 
	_elif font_seleccionada = 24
	_then
		tipo_de_fuente << "fixed" 
	_elif font_seleccionada = 25
	_then
		tipo_de_fuente << "plain" 
	_endif
	

	_return tipo_de_fuente
	
_endmethod
