			texto1.sAlineacion << :centre_centre
			texto1.sEstilo << "Arial"
			texto1.bSubrayado? << _true
			_self.oTablas.elemento(:tbl_titulo).oCeldas.Celda(1,1).oElemento << texto1
		_endif
		
		#---------------------------------------------------------------
		# Texto tablas dinamicas
		#---------------------------------------------------------------
		_for tabla,valores _over .info_tablas[:tablas].fast_keys_and_elements()
		_loop
			_for celda,val _over valores[:celdas].fast_keys_and_elements()
			_loop
				cadena << val[:texto].write_string
				texto1 << c_texto_grafico.new(cadena)
				## Define los grados a los que se rotara el texto
				texto1.nGrados << val[:grados].as_integer()
				## Define el color del texto
				color << val[:color] 
				RR << color.scaled_rgb_vector()[1]
				GG << color.scaled_rgb_vector()[2]
				BB << color.scaled_rgb_vector()[3]
				cad_color << rr.write_string + "," + gg.write_string + "," + bb.write_string 
				texto1.sColor <<  colour.new_from_dec(cad_color)
				## Define el tamanio
				texto1.nTamanio << val[:tamanio].as_integer()
				## Define la orientacion
				texto1.sOrientacion << val[:orientacion]
				## Define la alineacion
				texto1.sAlineacion << val[:alineacion]
				## Define el estilo
				texto1.sEstilo << _self.verifica_estilo_fuente(val[:estilo])
				## Define el subrayado
				_if val[:subrayado] = :true 
				_then
					texto1.bSubrayado? << _true
				_else
					textl1.bSubrayado? << _false 
				_endif
				## Asigna el texto en la celda seleccionada
				rc << celda.write_string.split_by(",")
				reng << rc[1].as_integer()
				col << rc[2].as_integer()
				_self.oTablas.elemento(tabla.as_symbol()).oCeldas.Celda(reng,col).oElemento << texto1	
			_endloop
		_endloop
	_else
		#---------------------------------------------------------------
		# Texto tabla de referencia
		#---------------------------------------------------------------
		texto1 << c_texto_grafico.new("")
		_self.oTablas.elemento(:tbl_referencia).oCeldas.Celda(1,1).oElemento << ""
		
	_endif
	
_endmethod
