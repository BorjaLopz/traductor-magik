_pragma(classify_level=advanced, topic={plotting}, usage={subclassable})
_method c_sello_cuadro_firmas_compromiso_comercial.asigna_datos_calculados_a_celdas()
	#---------------------------------------------------
	## <Req. #> : Orquesta la solicitud de los calculos, Los
	## transforma paara que se puedan asignar a las celdas de la
	## tbla de resumen
	##
	#
	# Customization for Project : 
	#
	#---------------- Revision History -----------------
	# (22/09/05 des_david) : Created
	#-------------- End Revision History ---------------

	selloNom << "c_sello_cuadro_firmas_compromiso_comercial"
	plInf << property_list.new()
	plInf[:dtoOpt] << _self.dto
	plInfDto << c_distribuidor_datos_sellos.obten_datos_para_sello(selloNom, plInf)
	plInfSello << property_list.new()
	plInfSello[:clientesExis] << plInfDto[:clientesExis]
	plInfSello[:solPend] << plInfDto[:solPend]
	plInfSello[:ganancia] << plInfDto[:ganancia]
	_self.asigna_datos_a_celdas_tbl_resumen(plInfSello)
_endmethod
$

_pragma(classify_level=advanced, topic={plotting}, usage={subclassable})
_method c_sello_cuadro_firmas_compromiso_comercial.set_distrito_optico(pDtoOpt)
	#---------------------------------------------------
	## <Req. #> : <Description>
	##
	#
	# Customization for Project : 
