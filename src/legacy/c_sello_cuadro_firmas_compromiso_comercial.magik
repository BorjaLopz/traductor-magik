_endmethod
$
_pragma(classify_level=advanced, topic={plotting}, usage={subclassable})
_method c_sello_cuadro_firmas_compromiso_comercial.asigna_datos_a_celdas_tbl_resumen(pPlDatos)
	#---------------------------------------------------
	## <Req. #> : Asigna los valores que se reciben pPlDatos a
	## las celdas de la tabla resumen.
	##
	#
	# Customization for Project : 
	#
	#---------------- Revision History -----------------
	# (22/07/25 des_david) : Created
	#-------------- End Revision History ---------------
	
	val << pPlDatos[:clientesExis]
	ren<< 2; col << 5; tamFuente << 25;  alineacion << :centre_centre
	_self.asigna_texto_celda(:tbl_resumen_det, ren, col, val, tamFuente, alineacion)
	ren<< 3; col << 5;
	val << pPlDatos[:solPend]	
	_self.asigna_texto_celda(:tbl_resumen_det, ren, col, val, tamFuente, alineacion)
	ren<< 4; col << 5;
	val << pPlDatos[:ganancia]		
	_self.asigna_texto_celda(:tbl_resumen_det, ren, col, val, tamFuente, alineacion)

_endmethod
$

_pragma(classify_level=advanced, topic={plotting}, usage={subclassable})
_method c_sello_cuadro_firmas_compromiso_comercial.llena_datos_celdas()
	#---------------------------------------------------
	## <Req. #> : Al invocarse este metodo externamente. Se lanzan
	## los calculos para generar los valores calculados y se
	## asignan a su celdas respectivas. Tambien se envia los datos
	## que capturó el usuaro para los valores editables. 
	##
	#
	# Customization for Project : 
	#
	#---------------- Revision History -----------------
	# (22/08/10 des_david) : Created
	#-------------- End Revision History ---------------
	
	_self.asigna_atribs_a_celdas_editables()
	_self.asigna_datos_calculados_a_celdas()
_endmethod
$



##
# Tbl responsable
##

 
_pragma(classify_level=advanced, topic={plotting}, usage={subclassable})
_method c_sello_cuadro_firmas_compromiso_comercial.crea_y_cfg_tbl_responsable(pCoordInicio)
	#---------------------------------------------------
	## <Req. #> : principal_tbl_responsable
	##
	#
	# Customization for Project : 
	#
	#---------------- Revision History -----------------
	# (22/07/22 des_david) : Created
	#-------------- End Revision History ---------------

	#----------------------------------------------------------
	# Tabla Título de responsable
	#-----------------------------------------------------------
	_local despTblResumen 
	despTblResumen << 0
	adicional << 0
	ren << 3
	col << 5
	plLongRensCols << property_list.new()
	plLongRensCols[:ren] << {1, 4, 1}
	plLongRensCols[:col] << {2, 2,  64, 2, 2}
        tbl << .o_tablas.crea_tabla(ren, col, :tbl_responsable_tit)
	tbl.oCoordenada_Origen << pCoordInicio
	_self.asigna_medidas_tabla(tbl, plLongRensCols)
	_self.cfg_tbl_titulo(tbl)

	#----------------------------------------------------------
	# Tabla Detalle de responsable
	#-----------------------------------------------------------
	LfDesplazaY << .o_tablas.longitud_total_renglones({:tbl_responsable_tit})
	ren << 5
	col << 8
	plLongRensCols << property_list.new()
	plLongRensCols[:ren] << {4,  4,  4,  4,  2}
	plLongRensCols[:col] << {2,  2,  2, 35, 25,  2, 2, 2}

        loTbl << .o_tablas.crea_tabla(ren, col, :tbl_responsable_det)
	loTbl.oCoordenada_Origen << coordinate.new( pCoordInicio.x, pCoordInicio.y - (LfDesplazaY))
	_self.asigna_medidas_tabla(loTbl, plLongRensCols)
	_self.cfg_tbl_detalle(loTbl)

	LfDesplazaY << .o_tablas.longitud_total_renglones({:tbl_responsable_tit, :tbl_responsable_det})
	_return LfDesplazaY
_endmethod
$

_pragma(classify_level=advanced, topic={plotting}, usage={subclassable})
_method c_sello_cuadro_firmas_compromiso_comercial.asigna_etiquetas_a_celdas_tbl_responsable()
	#---------------------------------------------------
	## <Req. #> : Asigna las etiquetas constantes a las celdas de la tbl
	## responsable 
	## etiqueta_celda_tbl_responsable()
	##
	#
	# Customization for Project : 
	#
	#---------------- Revision History -----------------
	# (22/07/25 des_david) : Created
	#-------------- End Revision History ---------------
	
	_local ren, col, tamFuente, alineacion

	ren << 2; col << 3; tamFuente << 25; alineacion << :centre_centre
	_self.asigna_texto_celda(:tbl_responsable_tit, ren, col, "RESPONSABLES", tamFuente, alineacion)

	ren << 1; col << 5; tamFuente << 25; alineacion << :centre_left
	_self.asigna_texto_celda(:tbl_responsable_det, ren, col, "NOMBRE/FIRMA", tamFuente, alineacion)
	ren << 2; col << 4; tamFuente << 25; alineacion << :centre_left
	_self.asigna_texto_celda(:tbl_responsable_det, ren, col, "INGENIERIA", tamFuente, alineacion)
	ren << 3; col << 4; 
	_self.asigna_texto_celda(:tbl_responsable_det, ren, col, "RESPONSABLE COMERCIAL", tamFuente, alineacion)
	ren << 4; col << 4;
	_self.asigna_texto_celda(:tbl_responsable_det, ren, col, "RESPONSABLE PROYECTO", tamFuente, alineacion)
_endmethod
$
_pragma(classify_level=advanced, topic={plotting}, usage={subclassable})
_method c_sello_cuadro_firmas_compromiso_comercial.defined_attributes_tbl_responsable(pAttribs)
	#---------------------------------------------------
	## <Req. #> : define los atributos que permiten la captura de
	## los datos al usuario en la tabla de responsable
	##
	#
	# Customization for Project : 
	#
	#---------------- Revision History -----------------
	# (22/07/25 des_david) : Created
	#-------------- End Revision History ---------------

	pAttribs.add(layout_attribute_definition.new(:ingenieria, :string, :description, "asignar valores",:default_value, "Ingenieria"))
	pAttribs.add(layout_attribute_definition.new(:respcomercial, :string, :description, "asignar valores",:default_value, "Responsable Comercial"))
	pAttribs.add(layout_attribute_definition.new(:respproyecto, :string, :description, "asignar valores",:default_value, "Responsable proyecto"))	

#	_return pAttribs
_endmethod
$
_pragma(classify_level=advanced, topic={plotting}, usage={subclassable})
_method c_sello_cuadro_firmas_compromiso_comercial.asigna_atribs_a_celdas_editables_tbl_responsable()
	#---------------------------------------------------
	## <Req. #> : Asigna los valores de los atributos a las celdas
	## editables de la tbl responsable.
	## asigna_val_a_celda_responsable()
	## asigna_atribs_a_celdas_editables_tbl_responsable
	#
	# Customization for Project : 
	#
	#---------------- Revision History -----------------
	# (22/07/25 des_david) : Created
	#-------------- End Revision History ---------------
	
	val << _self.attributes[:ingenieria].value
	ren<< 2; col << 5; tamFuente << 25;  alineacion << :centre_centre
	_self.asigna_texto_celda(:tbl_responsable_det, ren, col, val, tamFuente, alineacion)
	ren<< 3; col << 5;
	val << _self.attributes[:respcomercial].value
	_self.asigna_texto_celda(:tbl_responsable_det, ren, col, val, tamFuente, alineacion)
	ren<< 4; col << 5;	
	val << _self.attributes[:respproyecto].value
	_self.asigna_texto_celda(:tbl_responsable_det, ren, col, val, tamFuente, alineacion)
_endmethod
$


##
# Tbl_resumen
##

$
_pragma(classify_level=advanced, topic={plotting}, usage={subclassable})
_method c_sello_cuadro_firmas_compromiso_comercial.crea_y_cfg_tbl_resumen(pCoordInicio)
	#---------------------------------------------------
	## <Req. #> : <Description>
	##
	#
	# Customization for Project : 
	#
	#---------------- Revision History -----------------
	# (22/07/22 des_david) : Created
	#-------------- End Revision History ---------------

	_local plLongRensCols
	_local ren, col
	_local loTbl
	#----------------------------------------------------------
	# Tabla Título de resumen
	#-----------------------------------------------------------
	ren << 3
	col << 5
	plLongRensCols << property_list.new()
	plLongRensCols[:ren] << {1, 4, 1}
	plLongRensCols[:col] << {2, 2,  64, 2, 2}
        tbl << .o_tablas.crea_tabla(ren, col, :tbl_resumen_tit)
	tbl.oCoordenada_Origen << pCoordInicio
	_self.asigna_medidas_tabla(tbl, plLongRensCols)
	_self.cfg_tbl_titulo(tbl)

	#----------------------------------------------------------
	# Tabla Detalle de resumen
	#-----------------------------------------------------------
	LfDesplazaY << .o_tablas.longitud_total_renglones({:tbl_resumen_tit})
	ren << 5
	col << 8
	plLongRensCols << property_list.new()
	plLongRensCols[:ren] << {2,  4,  4,  4, 2}
	plLongRensCols[:col] << {2,  2,  2, 35, 25,  2 ,2, 2}

        loTbl << .o_tablas.crea_tabla(ren, col, :tbl_resumen_det)
	loTbl.oCoordenada_Origen << coordinate.new(pCoordInicio.x, pCoordInicio.y - LfDesplazaY)
	_self.asigna_medidas_tabla(loTbl, plLongRensCols)
	_self.cfg_tbl_detalle(loTbl)

	LfDesplazaY << .o_tablas.longitud_total_renglones({:tbl_resumen_tit, :tbl_resumen_det})
	_return LfDesplazaY
_endmethod
$

_pragma(classify_level=advanced, topic={plotting}, usage={subclassable})
_method c_sello_cuadro_firmas_compromiso_comercial.asigna_etiquetas_a_celdas_tbl_resumen()
	#---------------------------------------------------
	## <Req. #> : Asigna a las celtas de la tabla de resumen las
	## etiquetas constantes o fijas
