_pragma(classify_level=advanced, topic={plotting}, usage={subclassable})
_method c_sello_cuadro_firmas_compromiso_comercial.defined_attributes
	#---------------------------------------------------
	## <Req. #> : <Description>
	##
	#
	# Customization for Project : 
	#
	#---------------- Revision History -----------------
	# (22/07/21 des_david) : Created
	#-------------- End Revision History ---------------
	
	attribs << rope.new_from (_super.defined_attributes)
