_pragma(classify_level=restricted, usage={redefinable})
_method c_sello_diagrama_empalmes_general.prvLlenaElementos()
	## 
	##
	_local LoSimbolo

	LoSimbolo << c_simbolo_grafico.new("diagrama de empalmes")
	LoSimbolo.nmargen_inf << -15
	_self.oTablas.elemento(:tbl_Diag_Emp).oCeldas.Celda(3,1).oElemento << LoSimbolo

	
_endmethod

$
_pragma(classify_level=restricted, usage={redefinable})
_private _method c_sello_diagrama_empalmes_general.AsignaCelda2(RoTabla, RnRenglon, RnColumna ,RoValor, RnTamanio, RsColor, _optional RsAlineacion)
	## 
	##

	_if RnTamanio _is unset
	_then
		RnTamanio << 25
	_endif

	_if RsColor _is unset
	_then
		RsColor << "Black"
	_endif

	_if RsAlineacion _is _unset 
	_then
	     RsAlineacion << :centre_centre
	_endif

	
_if _self.oTablas.elemento(RoTabla.as_symbol()).oCeldas.Celda(RnRenglon,RnColumna).oElemento _is unset
_then
	_local LoDato;
	
	##Por el momento se considera que el objeto RoValor contiene
	## una cadena
	LoDato  << c_texto_grafico.new(RoValor.write_string)
	
	LoDato.nTamanio << RnTamanio
	LoDato.sColor << RsColor
	LoDato.sAlineacion << RsAlineacion
	
	_self.oTablas.elemento(RoTabla.as_symbol()).oCeldas.Celda(RnRenglon,RnColumna).oElemento << LoDato
_else
	_self.oTablas.elemento(RoTabla.as_symbol()).oCeldas.Celda(RnRenglon,RnColumna).oElemento.sTexto << RoValor.write_string
	_self.oTablas.elemento(RoTabla.as_symbol()).oCeldas.Celda(RnRenglon,RnColumna).oElemento.sColor << RsColor.write_string
	_self.oTablas.elemento(RoTabla.as_symbol()).oCeldas.Celda(RnRenglon,RnColumna).oElemento.nTamanio << RnTamanio
_endif	  

_endmethod
$

_pragma(classify_level=restricted, usage={redefinable})
_method c_sello_diagrama_empalmes_general.asigna_num_tramo(PsCve_Ruta, PsCve_tramo)
   
   
	## 
	##

	_self.sCve_Tramo << PsCve_Tramo
	_self.sCve_Ruta <<  PsCve_Ruta
		
_if _self.oTramo_fo = _unset 
_then
       _self.oTramo_fo << c_Tramo_fo_e.new()	
       _self.oTramo_fo.asigna_num_tramo(PsCve_Ruta, PsCve_tramo)
_endif

	_if _self.oTramo_fo.obten_elementos_tramo.size > 1 _and _self.oTramo_fo _isnt _unset 
	_then
		write("si hay informacion")
	
		_self.prvAsigna_textos()

		_self.prvAsigna_tramo_a_celda()
	_else
		write("mensajes NA")
		LoElemento << _self.oTablas.elemento(:tbl_Diag_Emp_Datos).oCeldas.Celda(1,2).oElemento
	        LoElemento.sTexto << "NA"
	 
	        LoCelda << _self.oTablas.elemento(:tbl_Sistema_Tierras).oCeldas.Celda(1,1).oElementos.obten_elemento(:Nodo_1)
	        LoCelda.sTexto << "NA"
	 
	        LoElemento << _self.oTablas.elemento(:tbl_Diag_Emp_Datos).oCeldas.Celda(1,5).oElemento
	        LoElemento.sTexto << "NA"
	 
	        LoCelda << _self.oTablas.elemento(:tbl_Sistema_Tierras).oCeldas.Celda(1,1).oElementos.obten_elemento(:Nodo_2)
	        LoCelda.sTexto << "NA"
	 
	        LoElemento << _self.oTablas.elemento(:tbl_Diag_Emp_Notas).oCeldas.Celda(1,2).oElemento
	        LoElemento.sTexto << "NA"
	 
	        LoElemento << _self.oTablas.elemento(:tbl_Diag_Emp_Notas).oCeldas.Celda(1,4).oElemento
	        LoElemento.sTexto << "NA"

		LoTexto  << c_texto_grafico.new("NA")
		LoTexto.nTamanio << 10
		_self.oTablas.elemento(:tbl_Titulo1).oCeldas.Celda(1,2).oElemento << LoTexto
		
	_endif

	
_endmethod
$

_pragma(classify_level=restricted, usage={redefinable})
_private _method c_sello_diagrama_empalmes_general.prvAsigna_tramo_a_celda()
	## 
	##

	# Se agrega el tramo
	_if _self.oTramo_fo.obten_elementos_tramo.size > 1
	_then	
		LoTramo  << c_tramo_fo_grafico.new(_self.sCve_Ruta, _self.sCve_Tramo,"EG")
		_self.oTablas.elemento(:tbl_Titulo1).oCeldas.Celda(1,2).oElemento << LoTramo
	_else
		# So colocan textos de no hay informacion
		
		LoTexto  << c_texto_grafico.new("No hay informacion")
		LoTexto.nTamanio << 10
		_self.oTablas.elemento(:tbl_Titulo1).oCeldas.Celda(1,2).oElemento << LoTexto
		
	_endif	
	
	
_endmethod
$

_pragma(classify_level=restricted, usage={redefinable})
_private _method c_sello_diagrama_empalmes_general.prvAsigna_textos()
	## 
	## 
	
        _Local LsTxt # texto que debe tener la cadena
	_local LoElemento
	_local LoNodo
	_local LoPrimer_Empalme
	_local LoUltimo_Empalme

	 # REPETIDOR IZQ
	 LoNodo << _self.oTramo_fo.nodo_origen
         LsTxt <<  LoNodo.user!_nom_nodo.write_string
         LoElemento << _self.oTablas.elemento(:tbl_Diag_Emp_Datos).oCeldas.Celda(1,2).oElemento
	 LoElemento.sTexto << LsTxt

	 LoCelda << _self.oTablas.elemento(:tbl_Sistema_Tierras).oCeldas.Celda(1,1).oElementos.obten_elemento(:Nodo_1)
	 LoCelda.sTexto << "REP. " + LsTxt


	 # REPETIDOR DER
	 LoNodo << _self.oTramo_fo.nodo_destino
         LsTxt <<  LoNodo.user!_nom_nodo.write_string
         LoElemento << _self.oTablas.elemento(:tbl_Diag_Emp_Datos).oCeldas.Celda(1,5).oElemento
	 LoElemento.sTexto << LsTxt

	 LoCelda << _self.oTablas.elemento(:tbl_Sistema_Tierras).oCeldas.Celda(1,1).oElementos.obten_elemento(:Nodo_2)
	 LoCelda.sTexto << "CTL. " + LsTxt	 

	 # Se obtienen los nombres del primer y ultimo empalme
	 _local LnCont
	 LnCont << 0
	 
	 _for LoElem _over _self.oTramo_fo.obten_elementos_tramo.fast_elements()
	 _loop
		 LnCont << LnCont + 1
		 
		 _if LnCont = 3
		 _then
			 LoPrimer_Empalme << LoElem
		 _endif

 		 _if LnCont = _self.oTramo_fo.obten_elementos_tramo.size - 2
		 _then
			 LoUltimo_Empalme << LoElem
		 _endif
	 _endloop
	 
 	 # NOMBRE TERMINAL 1
	 LsTxt << LoPrimer_Empalme.user!_num_empalme.write_string
	 LsTxt << "EMP. TERMINAL " +LsTxt
         LoElemento << _self.oTablas.elemento(:tbl_Diag_Emp_Notas).oCeldas.Celda(1,2).oElemento
	 LoElemento.sTexto << LsTxt

 	 # NOMBRE TERMINAL 2
	 LsTxt << LoUltimo_Empalme.user!_num_empalme.write_string
 	 LsTxt << "EMP. TERMINAL " +LsTxt
         LoElemento << _self.oTablas.elemento(:tbl_Diag_Emp_Notas).oCeldas.Celda(1,4).oElemento
	 LoElemento.sTexto << LsTxt


	
_endmethod

