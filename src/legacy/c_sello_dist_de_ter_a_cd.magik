_pragma(classify_level=advanced, topic={plotting}, usage={subclassable})
_method c_sello_dist_de_ter_a_cd.FiltrarTerminalesConDist(PcollCajaORegDist)
	## 
	##
_local LcollTerConDist<<hash_table.new()
_local LyId             # Id de la terminal.
_local LfDistanciaACd   # Distancia a la CD

       _for LoRecTab _over PcollCajaORegDist.fast_elements(PcollCajaORegDist)
       _loop
	       LcollRelatedObjs<<related_objects_provider.get_related_items_for(LoRecTab)
	       _for LoRec _over LcollRelatedObjs.fast_elements()
	       _loop
		       _if LoRec.is_kind_of?(copper_terminal)
		       _then
			      LyId<< LoRec.user!_cuenta.default("no_dato").as_symbol().canonical
			      LfDistanciaACd<<LoRec.user!_distancia_cd #* 10.0 # para convertir a metros.
			      _if LyId <> :no_dato
			      _then
				      LcollTerConDist[LyId]<<LfDistanciaACd.as_fixed_string(10,3).trim_spaces()
			      _endif
		       _endif
	       _endloop
       _endloop

       _return LcollTerConDist
_endmethod
$
_pragma(classify_level=advanced, topic={plotting}, usage={subclassable})
_method c_sello_dist_de_ter_a_cd.llena_datos_celdas()
	## 
	##

_local LcollTabUserBuilding

 
       LcollTabUserBuilding<<gis_program_manager.cached_dataset(:gis).collections[:user!_building]
       _if _self.idEdificio _isnt _unset
       _then
	       LoUserBuilding<<LcollTabUserBuilding.at(_self.idEdificio)
	       _if LoUserBuilding _isnt _unset
	       _then
		       
		       LoSpatialContext<<LoUserBuilding.get_spatial_context(:internal)
		       LcollInternalGeoms<<LoSpatialContext.elements[1].world.geometry_set()
		       LcollRegistros<<LcollInternalGeoms.select(:collection,
								 {:user!_registro_tablero}).rwo_set() 
		       LcollTerminales<<_self.FiltrarTerminalesConDist(LcollRegistros)

		       

		       _for LyKey,LiDist _over LcollTerminales.keys_and_elements()
		       _loop
			       LoCoord<<_self.UbicaCoord[LyKey]
			       LoRenglon<<LoCoord.y.integral_and_fraction()
			       LoColumna<<LoCoord.x.integral_and_fraction()
			       LsDato<<LiDist
			       _self.asigna_texto_celda(:tbl_contenido,
							LoRenglon,LoColumna,LsDato,
							15,:centre_centre,0,{1,0,0})
		       _endloop
	       _else
	       # (11/07/19 rhernan) : buscamos via el limite de distrito
		       LcollLimDtoOptico <<gis_program_manager.cached_dataset(:landbase).
					   collections[:user!_distrito_optico]
		       LoReg << LcollLimDtoOptico.at(_self.idEdificio)
		       
		       pred << predicate.inside(:boundary, LoReg.user!_limite)
		       LcollTabUserBuilding.select(pred)
		     _if LcollTabUserBuilding.select(pred).size > 0
		     _then
			     LoArreTerminales << rope.new()
			_for LoRegUserBuilding _over LcollTabUserBuilding.select(pred).fast_elements()
			_loop
			    LoSpatialContext<<LoRegUserBuilding.get_spatial_context(:internal)
			    LcollInternalGeoms<<LoSpatialContext.elements[1].world.geometry_set()
			    LcollRegistros<<LcollInternalGeoms.select(:collection,
						   {:user!_registro_tablero}).rwo_set()
			    LcollTerminales<<_self.FiltrarTerminalesConDist(LcollRegistros)
			    _if LcollTerminales.size > 0
			    _then
				    LoArreTerminales.add(LcollTerminales)			    
			    _endif			    
			_endloop
			
			##llenando el sello
			_if LoArreTerminales.size > 0
			_then
			   _for LoArreTerminal _over LoArreTerminales.fast_elements()
			   _loop	
				   _for LyKey,LiDist _over LoArreTerminal.keys_and_elements()
				   _loop
					   LoCoord<<_self.UbicaCoord[LyKey]
					   LoRenglon<<LoCoord.y.integral_and_fraction()
					   LoColumna<<LoCoord.x.integral_and_fraction()
					   LsDato<<LiDist
					   _self.asigna_texto_celda(:tbl_contenido,
								    LoRenglon,LoColumna,LsDato,
								    15,:centre_centre,0,{1,0,0})
				   _endloop
			   _endloop
			_endif
		     _endif
	       _endif       	    
       _endif
       
_endmethod
$
