def_slotted_exemplar(:c_sello_estandar_base_fo,
{
	{:oTipoEmpresaRazonS,      _unset }, # catalogo para empresa
	{:valorEmpresaRazonS,      _unset }, # Valor para empresa
	{:o_distrito,              _unset }, # Valor para empresa
	{:o_proyecto,              _unset }, # Valor para empresa
	{:oTipoNombre,             _unset }, # Valor para nombre
	{:pl_datos,                _unset } # Valor para empresa
	
}, :c_base_sello_fibra)
