_pragma(classify_level=advanced, topic={plotting}, usage={subclassable})
 _method c_sello_estandar_base_fo.etiqueta_celdas()

	_self.asigna_texto_celda(:tbl_compania,1,1,"RED NACIONAL",32)  
	_self.asigna_texto_celda(:tbl_compania,2,1,"ÚLTIMA",32)
	_self.asigna_texto_celda(:tbl_compania,3,1,"MILLA",32)
		 
	_self.asigna_texto_celda(:tbl_FecDibRev,1,1,"FECHA",32)
	_self.asigna_texto_celda(:tbl_FecDibRev,2,1,"DIBUJO",32)
	_self.asigna_texto_celda(:tbl_FecDibRev,3,1,"REVISO",32)
	_self.asigna_texto_celda(:tbl_escala,1,1,"ESCALA",32)

	_self.asigna_texto_celda(:tbl_del_mpo,1,1," ESTADO:",32,:top_left)
	_self.asigna_texto_celda(:tbl_del_mpo,2,1," CODIGO POSTAL:",32,:top_left)
	_self.asigna_texto_celda(:tbl_del_mpo,3,1," COLONIA:",32,:top_left)
	_self.asigna_texto_celda(:tbl_del_mpo,4,1," DELEGACION O MPO.:",32,:top_left)

	
_endmethod
