_pragma(classify_level=restricted, usage={redefinable})
_method c_sello_estandar_base_fo.enum_tipo_razon_social
	## 
	## 
	.oTipoEmpresaRazonS    << hash_table.new()
	.oTipoEmpresaRazonS[3] <<  "TELEFONOS|DE MEXICO|S.A.B de C.V."
	.oTipoEmpresaRazonS[1] <<   "RED|NACIONAL|ULTIMA MILLA" 
	.oTipoEmpresaRazonS[2] <<   "RED|ULTIMA MILLA|DEL NOROESTE"
	_return .oTipoEmpresaRazonS

	
_endmethod
$
_pragma(classify_level=restricted, usage={redefinable})
_method c_sello_estandar_base_fo.enum_tipo_nombre
	## 
	## 
	.oTipoNombre    << hash_table.new()
	.oTipoNombre[1] << "RUTA DE CABLES"
	.oTipoNombre[2] <<  "ESQUEMATICO DE PRINCIPALES" 
	.oTipoNombre[3] <<  "PLANO DE DETALLES"
	_return .oTipoNombre
	
_endmethod
