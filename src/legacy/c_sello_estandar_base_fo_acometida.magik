_pragma(classify_level=advanced, topic={plotting}, usage={subclassable})
_method c_sello_estandar_base_fo_acometida.configura_tabla()

	_local ln_desp_x
	_local ln_desp_y
	
	# ----------------------------------------------------------
	# Tabla que contiene la Ubicacion
	# ----------------------------------------------------------
	lo_tabla << .o_tablas.crea_tabla(1,1,:tbl_ubicacion)
	lo_tabla.oCoordenada_Origen << .o_coord_inicio
	lo_tabla.orenglones.elemento(1).nlongitud << 274
	lo_tabla.ocolumnas.elemento(1).nlongitud  << 15
	lo_tabla.bDibuja_bordes? << _false
	# ----------------------------------------------------------
	# Tabla que contiene la compania
	# ----------------------------------------------------------
	lo_tabla << .o_tablas.crea_tabla(3,1,:tbl_compania)
	ln_desp_x << .o_tablas.Longitud_total_Columnas({:tbl_ubicacion})
	ln_desp_y << .o_tablas.Longitud_total_Renglones({:tbl_ubicacion})
	lo_tabla.oCoordenada_Origen << coordinate.new(.o_coord_inicio.x + ln_desp_x,
						      .o_coord_inicio.y - (ln_desp_y - 150))
	lo_tabla.bDibuja_Renglones_Internos? << _false
	lo_tabla.orenglones.elemento(1).nlongitud << 5
	lo_tabla.orenglones.elemento(2).nlongitud << 5
	lo_tabla.orenglones.elemento(3).nlongitud << 5	
	lo_tabla.ocolumnas.elemento(1).nlongitud  << 25
	# ----------------------------------------------------------
	# Tabla que contiene Fecha, Dibujo y Reviso
	# ----------------------------------------------------------	
	lo_tabla << .o_tablas.crea_tabla(3,2,:tbl_FecDibRev)
	ln_desp_x << .o_tablas.Longitud_total_Columnas({:tbl_ubicacion,:tbl_compania})
	lo_tabla.oCoordenada_Origen << coordinate.new(.o_coord_inicio.x + ln_desp_x,
						      .o_coord_inicio.y - (ln_desp_y - 150))
	lo_tabla.orenglones.elemento(1).nlongitud << 5
	lo_tabla.orenglones.elemento(2).nlongitud << 5
	lo_tabla.orenglones.elemento(3).nlongitud << 5
	lo_tabla.ocolumnas.elemento(1).nlongitud  << 15
	lo_tabla.ocolumnas.elemento(2).nlongitud  << 20
	# ----------------------------------------------------------
	# Tabla que contiene la escala
	# ----------------------------------------------------------	
	lo_tabla << .o_tablas.crea_tabla(2,1,:tbl_escala)
	ln_desp_x << .o_tablas.Longitud_total_Columnas({:tbl_ubicacion,:tbl_compania,:tbl_FecDibRev})
	lo_tabla.oCoordenada_Origen << coordinate.new(.o_coord_inicio.x + ln_desp_x,
						      .o_coord_inicio.y - (ln_desp_y - 150))
	lo_tabla.orenglones.elemento(1).nlongitud << 5
	lo_tabla.orenglones.elemento(2).nlongitud << 10
	lo_tabla.ocolumnas.elemento(1).nlongitud  << 22
	# ----------------------------------------------------------	
	# Tabla que contiene el proyecto y la central
	# ----------------------------------------------------------	
	lo_tabla << .o_tablas.crea_tabla(2,1,:tbl_proy_ctl)
	ln_desp_x << .o_tablas.Longitud_total_Columnas({:tbl_ubicacion, :tbl_compania, :tbl_FecDibRev,
							:tbl_Escala})
	ln_desp_y << .o_tablas.Longitud_total_Renglones({:tbl_ubicacion})
	lo_tabla.oCoordenada_Origen << coordinate.new(.o_coord_inicio.x + ln_desp_x,
						      .o_coord_inicio.y - (ln_desp_y -150))
	lo_tabla.bDibuja_Renglones_Internos? << _false
	lo_tabla.orenglones.elemento(1).nlongitud << 7.5
	lo_tabla.orenglones.elemento(2).nlongitud << 7.5
	lo_tabla.ocolumnas.elemento(1).nlongitud  << 100
	# ----------------------------------------------------------
	# Tabla que contiene las siglas
	# ----------------------------------------------------------
	lo_tabla << .o_tablas.crea_tabla(1,1,:tbl_siglas)
	ln_desp_x << .o_tablas.Longitud_total_Columnas({:tbl_ubicacion, :tbl_compania, :tbl_FecDibRev,
							:tbl_Escala,:tbl_proy_ctl})
	
	ln_desp_y << .o_tablas.Longitud_total_Renglones({:tbl_ubicacion}) 
	
	lo_tabla.oCoordenada_Origen << coordinate.new(.o_coord_inicio.x + ln_desp_x,
						      .o_coord_inicio.y - (ln_desp_y -150))  
	lo_tabla.bDibuja_Renglones_Internos? << _false
	lo_tabla.orenglones.elemento(1).nlongitud << 15
	lo_tabla.ocolumnas.elemento(1).nlongitud  << 60
	# ----------------------------------------------------------	
	# Tabla que contiene la delegacion y municipio
	# ----------------------------------------------------------
	lo_tabla << .o_tablas.crea_tabla(4,2,:tbl_del_mpo)
	
	ln_desp_x << .o_tablas.Longitud_total_Columnas({:tbl_ubicacion, :tbl_compania, :tbl_FecDibRev,
							:tbl_Escala, :tbl_proy_ctl, :tbl_siglas})

	
	LoDesplazamiento << 100
	ln_desp_x +<< LoDesplazamiento
	
	lo_tabla.oCoordenada_Origen << coordinate.new(.o_coord_inicio.x + ln_desp_x,
						      .o_coord_inicio.y - (ln_desp_y - 300)) #150
	lo_tabla.bDibuja_Columnas_Internas? << _false
	lo_tabla.bDibuja_Renglones_Internos? << _false
	lo_tabla.orenglones.elemento(1).nlongitud << 5  ##   7.5
	lo_tabla.orenglones.elemento(2).nlongitud << 5  ##   7.5
	
	lo_tabla.ocolumnas.elemento(1).nlongitud  << 45
	lo_tabla.ocolumnas.elemento(2).nlongitud  << 45

	lo_tabla.orenglones.elemento(3).nlongitud << 5  ##  7.5
	lo_tabla.orenglones.elemento(4).nlongitud << 5  ##  7.5

	# (10/07/07 lgranados) : Se ocultan las lineas de la tabla a
	# petición del usuario para que el contenido no salga de los limites.
	lo_celda << lo_tabla.oceldas.celda(1,1).oelementos.obten_elemento(:bordes_celda)
	
	lo_celda.bBorde_Der? << _false 
	lo_celda.bBorde_Izq? <<  _false 
	lo_celda.bBorde_Inf? << _false 
	lo_celda.bBorde_Sup? << _false 
	
	lo_celda << lo_tabla.oceldas.celda(1,2).oelementos.obten_elemento(:bordes_celda)
	lo_celda.bBorde_Der? << _false
	lo_celda.bBorde_Izq? << _false
	lo_celda.bBorde_Inf? << _false
	lo_celda.bBorde_Sup? << _false

	lo_celda << lo_tabla.oceldas.celda(2,1).oelementos.obten_elemento(:bordes_celda)
	lo_celda.bBorde_Der? << _false
	lo_celda.bBorde_Izq? << _false
	lo_celda.bBorde_Inf? << _false
	lo_celda.bBorde_Sup? << _false

	lo_celda << lo_tabla.oceldas.celda(2,2).oelementos.obten_elemento(:bordes_celda)
	lo_celda.bBorde_Der? << _false
	lo_celda.bBorde_Izq? << _false
	lo_celda.bBorde_Inf? << _false
	lo_celda.bBorde_Sup? << _false

	# (22/10/14 des_aaron) :
	lo_celda << lo_tabla.oceldas.celda(3,1).oelementos.obten_elemento(:bordes_celda)
	lo_celda.bBorde_Der? << _false
	lo_celda.bBorde_Izq? << _false
	lo_celda.bBorde_Inf? << _false
	lo_celda.bBorde_Sup? << _false

	
	lo_celda << lo_tabla.oceldas.celda(3,2).oelementos.obten_elemento(:bordes_celda)
	lo_celda.bBorde_Der? << _false
	lo_celda.bBorde_Izq? << _false
	lo_celda.bBorde_Inf? << _false
	lo_celda.bBorde_Sup? << _false

	lo_celda << lo_tabla.oceldas.celda(4,1).oelementos.obten_elemento(:bordes_celda)
	lo_celda.bBorde_Der? << _false
	lo_celda.bBorde_Izq? << _false
	lo_celda.bBorde_Inf? << _false
	lo_celda.bBorde_Sup? << _false

	
	lo_celda << lo_tabla.oceldas.celda(4,2).oelementos.obten_elemento(:bordes_celda)
	lo_celda.bBorde_Der? << _false
	lo_celda.bBorde_Izq? << _false
	lo_celda.bBorde_Inf? << _false
	lo_celda.bBorde_Sup? << _false

	
_endmethod
