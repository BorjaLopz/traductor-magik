_pragma(classify_level=restricted, usage={redefinable})
_method c_sello_estandar_base_fo_acometida.defined_attributes

	attribs << rope.new_from (_super.defined_attributes)

	attribs.add(layout_attribute_definition.new(:razon_social,:string,
						    :description, "RAZON SOCIAL",
						    :enum_method, :enum_tipo_razon_social))

	attribs.add(layout_attribute_definition.new(:nombre, :string,
						    :description, "",	    
                                                    :enum_method, :enum_tipo_nombre))	

	attribs.add(layout_attribute_definition.new(:fecha, :string,
						    :description, "",
						    :default_value, _unset ))    


	attribs.add(layout_attribute_definition.new(:proyecta_empresa, :string,
						    :description, "",
						    :default_value, _unset ))
	
	attribs.add(layout_attribute_definition.new(:revisa_empresa, :string,
						    :description, "",
						    :default_value, _unset ))


	attribs.add(layout_attribute_definition.new(:escala, :string,
						    :description, "escala",
						    :default_value, _unset ))    


	attribs.add(layout_attribute_definition.new(:estado, :string,
						    :description, "Municipio",
						    :default_value, _unset ))
	
	attribs.add(layout_attribute_definition.new(:municipio, :string,
						    :description, "",
						    :default_value, _unset ))


	attribs.add(layout_attribute_definition.new(:colonia, :string,
						    :description, "Colonia",
	                                            :default_value, _unset ))    
	

	attribs.add(layout_attribute_definition.new(:codigo_postal, :string,
						    :description, "Codigo Postal",
						    :default_value, _unset ))
	
	attribs.add(layout_attribute_definition.new(:lonombrenco, :string,
						    :description, "",
						    :default_value, _unset ))	

	attribs.add(layout_attribute_definition.new(:loncosiglas, :string,
						    :description, "",
						    :default_value, _unset ))	

	attribs.add(layout_attribute_definition.new(:nombre_ctl, :string,
						    :description, "",
						    :default_value, _unset ))	

	attribs.add(layout_attribute_definition.new(:nombre_ctl, :string,
						    :description, "",
						    :default_value, _unset ))	

	attribs.add(layout_attribute_definition.new(:siglas_ctl, :string,
						    :description, "",
						    :default_value, _unset ))	

	attribs.add(layout_attribute_definition.new(:datos_cliente, :string,
						    :description, "",
						    :default_value, _unset ))	

	
	attribs.add(layout_attribute_definition.new(:ubicacion_plano, :string,
						    :description, "Ubicación del plano",
						    :default_value, _unset ))

	
	>> attribs

_endmethod
