_method c_sello_estandar_construccion.codigo_postal
	## 
	## 
	_return ""
_endmethod
$
_pragma(classify_level=advanced, topic={plotting}, usage={subclassable})
_method c_sello_estandar_construccion.colonia
	
	_return ""
	
_endmethod
