_package user
$
#remex(:c_sello_estandar_construccion)
$
def_slotted_exemplar(:c_sello_estandar_construccion,
{
	{:oTipoEmpresaRazonS,      _unset }, # catalogo para empresa
	{:valorEmpresaRazonS ,     _unset } # Valor para empresa
}, :c_sello_estandar_base)
$
c_sello_estandar_construccion.define_shared_constant(:allowed_on_menu?, _false   , :public)
$
_method c_sello_estandar_construccion.defined_attributes
	## 
	## 
	attribs << rope.new_from (_super.defined_attributes)

	attribs.add(layout_attribute_definition.new(:blanco_negro,  :string,
		                                    :description,   "blanco_negro",
						    :enum_method,   :enum_bool,
						    :default_value, "NO"))

	attribs.add(layout_attribute_definition.new(:emprerazon, :string,
						    :description, "RAZON SOCIAL",	    
                                                    :enum_method, :enum_tipo_razon_social))


	attribs.add(layout_attribute_definition.new(:fecha, :string,
						    :description, "fecha",
						    :default_value, _unset ))    
	
	attribs.add(layout_attribute_definition.new(:colonia, :string,
						    :description, "Colonia",
						    :default_value, _unset ))    
	
	attribs.add(layout_attribute_definition.new(:municipio, :string,
						    :description, "Delegación o Municipio",
						    :default_value, _unset ))
	
	attribs.add(layout_attribute_definition.new(:codigo_postal, :string,
						    :description, "Codigo Postal",
						    :default_value, _unset ))

	attribs.add(layout_attribute_definition.new(:ruta, :string,
						    :description, "Ruta",
						    :default_value, _unset ))
	
	>> attribs
	
_endmethod
$
c_sello_estandar_construccion.define_attributes()
$
_pragma(classify_level=restricted, usage={redefinable})
_method c_sello_estandar_construccion.enum_tipo_razon_social
	## 
	## 
	.oTipoEmpresaRazonS    << hash_table.new()
	.oTipoEmpresaRazonS[3] <<  "TELEFONOS|DE MEXICO|S.A.B de C.V."
	.oTipoEmpresaRazonS[1] <<  "RED NACIONAL|ÚLTIMA MILLA|S.A.P.I. DE C.V"     
	.oTipoEmpresaRazonS[2] <<  "RED ÚLTIMA|MILLA DEL NOROESTE|S.A.P.I. DE C.V"  
	_return .oTipoEmpresaRazonS
	
_endmethod
$
