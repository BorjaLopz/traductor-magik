_pragma(classify_level=restricted, usage={redefinable})
_method c_sello_estandar_ctl.lee_datos_BdeD()

#  Objetivo: Leer los datos de la base de datos
#  Parámetros de entrada: NA
#  Parámetros de salida:  NA
#  Regresa: NA
# Fecha de última modificación: 28/10/2004
# Autor de la modificación : dsanchez
# Descripción de la modificación: Se documento


	_super.lee_datos_BdeD()

        _if _self.oProyecto.existe?
	_then
	   _self.localidad      << _self.oProyecto.localidad
           _self.nombre_central << _self.oProyecto.central
	   _self.siglas_central << _self.oProyecto.cve_central
	   
	_endif

	
_endmethod 
