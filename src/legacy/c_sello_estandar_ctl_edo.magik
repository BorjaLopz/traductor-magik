_package user
$
def_slotted_exemplar(:c_sello_estandar_ctl_edo,
{
	{:oTipoEmpresaRazonS,      _unset }, # catalogo para empresa
	{:valorEmpresaRazonS ,     _unset } # Valor para empresa	
}, :c_sello_estandar_base)
