_method c_sello_estandar_ctl_edo.codigo_postal
	## 
	##
	
	_return "" 
	
_endmethod
$
_pragma(classify_level=restricted)
_method c_sello_estandar_ctl_edo.colonia
	## 
	##
	
	_return _self.obtiene_colonia().default("")
	
_endmethod
