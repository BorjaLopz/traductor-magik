_pragma(classify_level=advanced, topic={plotting}, usage={subclassable})
_method c_sello_estandar_ctl_edo.configura_tabla()

	_super.configura_tabla()
	
	_local ln_desp_x
	_local ln_desp_y

	_local pl_pob_ctl << property_list.new()
	_local pl_central << property_list.new()
	_local pl_plano_comen << property_list.new()
	_local pl_del_mpo << property_list.new()

	pl_pob_ctl[:ren] << {7.5,7.5}
	pl_pob_ctl[:col] << {70}
	pl_central[:ren] << {15}
	pl_central[:col] << {45}
	pl_plano_comen[:ren] << {15}
	pl_plano_comen[:col] << {115,90}
	pl_del_mpo[:ren] << {5}
	pl_del_mpo[:col] << {49,45}

	lo_tabla << .o_tablas.crea_tabla(2,1,:tbl_pob_ctl)
	ln_desp_x << .o_tablas.Longitud_total_Columnas({:tbl_ubicacion, :tbl_compania, :tbl_FecDibRev,
						       :tbl_Escala})
	ln_desp_y << .o_tablas.Longitud_total_Renglones({:tbl_ubicacion})
	lo_tabla.oCoordenada_Origen << coordinate.new(.o_coord_inicio.x + ln_desp_x,
						      .o_coord_inicio.y - (ln_desp_y -150))
	_self.asigna_medidas_tabla(lo_tabla, pl_pob_ctl)
	lo_tabla.bDibuja_Renglones_Internos? << _false

	lo_tabla << .o_tablas.crea_tabla(1,1,:tbl_central)
	ln_desp_x << .o_tablas.Longitud_total_Columnas({:tbl_ubicacion, :tbl_compania, :tbl_FecDibRev,
						       :tbl_Escala,:tbl_pob_ctl})
	lo_tabla.oCoordenada_Origen << coordinate.new(.o_coord_inicio.x + ln_desp_x,
						      .o_coord_inicio.y - (ln_desp_y -150))
	_self.asigna_medidas_tabla(lo_tabla, pl_central)
	
	lo_tabla << .o_tablas.crea_tabla(1,2,:tbl_plano_comen)
	ln_desp_x << .o_tablas.Longitud_total_Columnas({:tbl_ubicacion, :tbl_compania, :tbl_FecDibRev,
						       :tbl_Escala})
	lo_tabla.oCoordenada_Origen << coordinate.new(.o_coord_inicio.x + ln_desp_x,
						      .o_coord_inicio.y - (ln_desp_y - 300))
	_self.asigna_medidas_tabla(lo_tabla, pl_plano_comen)
	lo_tabla.bDibuja_bordes? << _false
	lo_tabla.bDibuja_Columnas_Internas? << _false

	lo_tabla << .o_tablas.crea_tabla(1,2,:tbl_del_mpo)
	ln_desp_x << .o_tablas.Longitud_total_Columnas({:tbl_ubicacion, :tbl_compania, :tbl_FecDibRev,
						       :tbl_Escala, :tbl_pob_ctl, :tbl_central})
	lo_tabla.oCoordenada_Origen << coordinate.new(.o_coord_inicio.x + ln_desp_x,
						      .o_coord_inicio.y - (ln_desp_y - 150))
	_self.asigna_medidas_tabla(lo_tabla, pl_del_mpo)
	lo_tabla.bDibuja_bordes? << _false
	lo_tabla.bDibuja_Columnas_Internas? << _false
	
_endmethod
$

_pragma(classify_level=advanced, topic={plotting}, usage={subclassable})
_method c_sello_estandar_ctl_edo.delegacion_municipio()

	_return .o_proyecto.delegacion_municipio
	
_endmethod
$
_pragma(classify_level=advanced, topic={plotting}, usage={subclassable})
_method c_sello_estandar_ctl_edo.etiqueta_celdas()
	## 
	## Se agrega la colonia cuando el plano sea de fosa de cables
	## autor: lgranados

	_super.etiqueta_celdas()
	LoDoc << _self.get_doc()
	_if LoDoc.user!_tipo_plano = :fosa_cables_fo
	_then
		# (12/08/20 adcuesta) : se corrige palabra municipio.
		etiqueta <<   "DELEGACION O MUNICIPIO:" +%newline
		etiqueta +<<  "COLONIA:"
		_self.asigna_texto_celda(:tbl_del_mpo,1,1,etiqueta,35,:top_left,1)
	_else
		_self.asigna_texto_celda(:tbl_del_mpo,1,1,"DELEGACION O MUNICIPIO:",35,:top_left,1)	
	_endif 
	
_endmethod
$
_pragma(classify_level=advanced, topic={plotting}, usage={subclassable})
_method c_sello_estandar_ctl_edo.get_doc()
   ## 
   ## Obtiene el Doc del layout
   ## Autor: lgranados.
	
    _if  _self.layout_document _isnt _unset 
    _then 
	    _return _self.layout_document
    _else 
	    LoLayoutPlugin    << smallworld_product.pni_application().plugin(:layout_plugin)
	    LoLayoutPlugin.start_layout_designer()
	    LoLayoutDesigner << LoLayoutPlugin.dialogs[:layout_designer]
	    LoLayoutManager   << LoLayoutDesigner.plugin(:layout_manager)
	    LoViewMapperPlugin<<LoLayoutDesigner.plugin(:viewport_mapper)
	    LoDoc  << LoLayoutManager.current_document
	    _return LoDoc	   
    _endif 	
	
_endmethod
$
_pragma(classify_level=advanced, topic={plotting}, usage={subclassable})
_method c_sello_estandar_ctl_edo.llena_datos_celdas()
	##
	## Se agrega la colonia y el titulo cuando el plano generado es
	## de Fosa de cables
	## Autor: lgranados

	_super.llena_datos_celdas()	
	LoDoc << _self.get_doc()
	
	LsColoniaNombre << ""
	
	LoUserCentral << swg_dsn_admin_engine.active_design.project.user!_central
	
	LoBuilding << LoUserCentral.building
	LoColonia << _unset
	LsColoniaNombre << _unset
	LsCP << _unset 
	LoTabColonia << LoUserCentral.source_view.collections[:user!_colonia]
	LoV << mit_manager.modelit_dataset 
	LoProyecto << swg_dsn_admin_engine.active_scheme.project
	
	# (2011-04-01 Aarón Hernández Ramírez, SIGMATAO) :  se cambio
	# criterio del if.
	_if  swg_dsn_admin_engine.active_design.tipo_diseno = :secundaria
	_then
		#aalarcon 01/06/2011
                #En caso de que diseño sea de red secuandaria y si en el nombre
		#del proyecto contiene Falc, se obtendra la colonia 
		#tomando como base un cedo que se encuentre dentro del distrito
		#optico.
		_if LoProyecto.name.matches?("*FALC*")
		_then
			
			LoDistritoOptico <<  swg_dsn_admin_engine.active_design.distrito_optico
			LoCedo << LoDistritoOptico.cedos_fo.an_element()

			_if LoDistritoOptico _isnt _unset _andif LoCedo _isnt _unset 
			_then
				LoEstructura <<LoCedo.get_structure()
				#08/Agosto/2011
				#Obtnener el area del edificio cuando el cedo se encuentre en
				#un registro tablero dentro del edificio
				_if LoEstructura _isnt _unset _andif 
				    LoEstructura.source_collection.name _is :user!_registro_tablero
				_then
					LoAreaEd<<LoEstructura.inside_location.world.owner.user!_building.boundary
					LoPred << predicate.interacts(:user!_limite,{LoAreaEd})
				_else
					LoPred<<predicate.interacts(:user!_limite,{LoEstructura.location})
				_endif
				
				LoColonia<<LoTabColonia.select(LoPred).an_element()				
				_if LoColonia _isnt _unset 
				_then
				 	.pl_datos[:colonia] << LsColoniaNombre<<LoColonia.user!_nombre.default("") 
					.pl_datos[:cp] << LsCP << LoColonia.user!_cp.default("")
				_endif			
			_endif			
			
		_else 			
			# (11/03/30 lgranados) : Si el plano se genera a nivel de
			# red secundaria  entonces buscara la colonia donde se
			# encuentra la CD.

			LoDistrito <<  swg_dsn_admin_engine.active_design.user!_distrito
			LoCD << LoDistrito.mit_terminal_enclosures.an_element()
		
			_if LoDistrito _isnt _unset _andif LoCD _isnt _unset 
			_then
				LoPred<<predicate.interacts(:user!_limite,{LoCD.location})
				LoColonia<<LoTabColonia.select(LoPred).an_element()
				_if LoColonia _isnt _unset 
				_then
					.pl_datos[:colonia]<<LsColoniaNombre<<LoColonia.user!_nombre.default("") 
					.pl_datos[:cp]<<LsCP << LoColonia.user!_cp.default("")
				_endif			
			_endif
		_endif 	
	_else  # plano de principales en RDA, ROF, FTTB, BA
		# (11/03/30 lgranados) : Si el plano se genera a nivel de
		# principales entonces buscara la colonia donde se encuentra la Central
		_if LoUserCentral _isnt _unset _andif LoBuilding _isnt _unset 
		_then	
			LoPred<<predicate.interacts(:user!_limite,{LoBuilding.location})
			LoColonia<<LoTabColonia.select(LoPred).an_element()
			
			_if LoColonia _isnt _unset
			_then
				.pl_datos[:colonia]<<LsColoniaNombre<<LoColonia.user!_nombre.default("") 
				.pl_datos[:cP]<<LsCP << LoColonia.user!_cp.default("")				
			_endif
		_endif
		
	_endif


#
# END CHANGE

	
        _self.asigna_texto_celda(:tbl_del_mpo,   1,1,"      DELEGACION O MUNICIPIO:",30,:top_left,1)
	_self.asigna_texto_celda(:tbl_colonia_cp,1,1,"      COLONIA:",30,:top_left,1)
	_self.asigna_texto_celda(:tbl_colonia_cp,2,1,"        CP:" ,30,:top_left)
	
	ls_nombre_ctl << .pl_datos[:tipo_ctl] + " - " + .pl_datos[:nombre_ctl]
         # (12/08/24 adcuesta) :NCO TLL	
	_self.asigna_texto_celda(:tbl_central,1,1,.pl_datos[:central],50)
	# (12/08/24 adcuesta) : METEPEC , MEXICO
	_self.asigna_texto_celda(:tbl_del_mpo,1,2,.pl_datos[:del_mpo],35,:top_left,3)
	# (12/08/24 adcuesta) : CTL - TOLLOCAN
	_self.asigna_texto_celda(:tbl_pob_ctl,2,1,ls_nombre_ctl  ,50)
	# (12/08/24 adcuesta) : AREA:TOLUCA
	_self.asigna_texto_celda(:tbl_pob_ctl,1,1, "AREA:" + .pl_datos[:area]  ,50)

	
	_if ( _self.attributes[:colonia] _isnt _unset _andif
	      _self.attributes[:colonia].value) _isnt  _unset _andif
	    _self.attributes[:colonia].value.size > 0
	_then
		nombre_col <<  _self.attributes[:colonia].value.write_string.uppercase
	_else
		nombre_col <<  .pl_datos[:colonia].default("")
		Locoloniauser? <<  _true 
	_endif
	
	_if LoDoc.user!_tipo_plano = :fosa_cables_fo
	_then
		LoTituloPlano << "FOSA DE CABLES" + %newline
		LoTituloPlano +<< "   Y DG"
		del_mpio_col << .pl_datos[:del_mpo] + %newline			
		del_mpio_col +<< nombre_col
		_self.asigna_texto_celda(:tbl_del_mpo,1,2,del_mpio_col,35,:top_left,3)
		_self.asigna_texto_celda(:tbl_central,1,1,LoTituloPlano,35)
        _endif  

		#Se agrega validacion a los planos de tipo FALC
	_if  swg_dsn_admin_engine.active_design.tipo_diseno = :secundaria _andif
	      swg_dsn_admin_engine.active_scheme.project.name.matches?("*FALC*")
	_then
		Diseno << swg_dsn_admin_engine.active_design
		LoDistritoOpt << Diseno.distrito_optico.user!_distrito
               		
		_self.asigna_texto_celda(:tbl_central,1,1,LoDistritoOpt,50)
		_self.asigna_texto_celda(:tbl_pob_ctl,1,1,""  ,50)
		
	_endif
	
	_if LoDoc.user!_tipo_plano <> :esquema_tba _andif
	    LoDoc.user!_tipo_plano <> :esquema_secundario
	_then
		_self.asigna_texto_celda(:tbl_pob_ctl,2,1,.pl_datos[:poblacion],50)
		
	_endif


	# START CHANGE
	# (12/08/20 ahernanram) : se actualiza la colonia tomando
	# encuenta la propiedad.
	#  
	#
	_if  ( _self.attributes[:colonia] _isnt _unset _andif
	       _self.attributes[:colonia].value) _isnt _unset _andif
	     _self.attributes[:colonia].value.write_string.size > 0
	_then
		LoColoniauser? <<     _true
		.pl_datos[:colonia]  << _self.attributes[:colonia].value.write_string.uppercase
		LsColoniaNombre << .pl_datos[:colonia]
		_self.asigna_texto_celda(:tbl_colonia_cp,1,2,.pl_datos[:colonia],35,:top_left)
	_else
		
		LoColoniauser? <<    _false
		_if .pl_datos[:colonia] = "" 
		_then
			# INICIO DEL CAMBIO
			# (2011-03-25 Aarón Hernández Ramírez, SIGMATAO) : 
			#
			_if LsColoniaNombre _isnt _unset 
			_then
				_self.asigna_texto_celda(:tbl_colonia_cp,1,2,LsColoniaNombre,35,:top_left)
			_endif
			
			#
			# FIN DEL CAMBIO			
		_else
			_self.asigna_texto_celda(:tbl_colonia_cp,1,2,.pl_datos[:colonia],35,:top_left)
		_endif
		
		
	_endif
	
	#
	# END CHANGE
	
	# START CHANGE
	# (12/08/20 ahernanram) : se actualiza la cp tomando
	# encuenta la propiedad.
	#  
	#
	_if  ( _self.attributes[:codigo_postal] _isnt _unset _andif
	       _self.attributes[:codigo_postal].value) _isnt _unset _andif
	     _self.attributes[:codigo_postal].value.write_string.size > 0
	_then
		Locpuser? <<     _true
		.pl_datos[:cp]  << _self.attributes[:codigo_postal].value.write_string.uppercase
		LsCP << .pl_datos[:cp]
		_self.asigna_texto_celda(:tbl_colonia_cp,2,2,.pl_datos[:cp],35,:top_left)
	_else
		
	         # (12/08/20 ahernanram) : asi estaba.	
		_if .pl_datos[:cp] = ""
		_then
			_if LsCP _isnt _unset 
			_then
				_self.asigna_texto_celda(:tbl_colonia_cp,2,2,LsCP,35,:top_left)		 
			_endif
			
		_else
			_self.asigna_texto_celda(:tbl_colonia_cp,2,2,.pl_datos[:cp],35,:top_left)	
		_endif
			
	_endif
	
	#
	# END CHANGE


	# (2020-05-07 AHERNAN, Hitss) : 
	#
	
	_if ( _self.attributes[:emprerazon] _isnt _unset _andif
	      _self.attributes[:emprerazon].value) _isnt  _unset _andif
	      _self.attributes[:emprerazon].value.size > 0
	_then		
		.valorEmpresaRazonS <<   _self.attributes[:emprerazon].value.write_string.uppercase

		_if .valorEmpresaRazonS.uppercase.matches?("*TELEFONOS*")
		_then
				
			         txts << .valorEmpresaRazonS.split_by("|")
				 
				_self.asigna_texto_celda(:tbl_compania,1,1, txts[1],35)
				_self.asigna_texto_celda(:tbl_compania,2,1, txts[2],35)
				_self.asigna_texto_celda(:tbl_compania,3,1, txts[3],35)
				
				_self.asigna_texto_celda(:tbl_FecDibRev,3,2,"TELMEX",30)

		_elif .valorEmpresaRazonS.uppercase.matches?("*NACIONAL*")
		_then
							
			         txts << .valorEmpresaRazonS.split_by("|")
				 
				_self.asigna_texto_celda(:tbl_compania,1,1, txts[1],23)
				_self.asigna_texto_celda(:tbl_compania,2,1, txts[2],23)
				_self.asigna_texto_celda(:tbl_compania,3,1, txts[3],23)
				
				_self.asigna_texto_celda(:tbl_FecDibRev,3,2,"RNUM",30)

				
		_elif .valorEmpresaRazonS.uppercase.matches?("*NOROESTE*")
		_then 
			txts << .valorEmpresaRazonS.split_by("|")
				 
			_self.asigna_texto_celda(:tbl_compania,1,1, txts[1],23)
			_self.asigna_texto_celda(:tbl_compania,2,1, txts[2],23)
			_self.asigna_texto_celda(:tbl_compania,3,1, txts[3],23)

			_self.asigna_texto_celda(:tbl_FecDibRev,3,2,"RUMN",30)
				
		_endif

	_else
		
		_self.asigna_texto_celda(:tbl_compania,1,1,"TELEFONOS",35)
		_self.asigna_texto_celda(:tbl_compania,2,1,"DE MEXICO",35)
		_self.asigna_texto_celda(:tbl_compania,3,1,"S.A.B de C.V.",35)
		
	_endif

	#
	# END CHANGE

_endmethod
$
_pragma(classify_level=advanced, topic={plotting}, usage={subclassable})
_method c_sello_estandar_ctl_edo.llena_datos_dinamicos()

	_local ls_comentario
	_local ls_tipo_plano
	
	_super.llena_datos_dinamicos()
	
	ls_comentario << _self.attributes[:comentario].value.write_string
	ls_tipo_plano << c_traductor.tipo_plano(.s_tipo_plano)

	LoDoc << _self.get_doc()
	_if LoDoc.user!_tipo_plano = :fosa_cables_fo
	_then
		_self.asigna_texto_celda(:tbl_plano_comen,1,1,"",100)
		_self.asigna_texto_celda(:tbl_plano_comen,1,2,"",60)
	_else
		_self.asigna_texto_celda(:tbl_plano_comen,1,1,ls_tipo_plano,100)
		_self.asigna_texto_celda(:tbl_plano_comen,1,2,ls_comentario,60)
	_endif
	
_endmethod
$
_pragma(classify_level=restricted)
_method c_sello_estandar_ctl_edo.municipio
	## 
	##   
    
	_if  .o_proyecto.delegacion_municipio _isnt _unset 
	_then
		_return .o_proyecto.delegacion_municipio
	_else
		_return "" 
	_endif
	
_endmethod
$
_pragma(classify_level=advanced, topic={plotting}, usage={subclassable})
_method c_sello_estandar_ctl_edo.obten_registros()

	 _super.obten_registros()

        LoProyecto << swg_dsn_admin_engine.active_design.project  
	LoCentral  << LoProyecto.user!_central
	LoNCO      << LoProyecto.user!_central.building

	gpm << gis_program_manager
	l_tbl_mpo << LoCentral.source_view.collections[:user!_municipio]
	l_predicate << predicate.contains(:user!_limite,LoNCO.location)
	l_sel_mpo << l_tbl_mpo.select(l_predicate).an_element().user!_nombre_telmex

	.pl_datos[:nombre_ctl] <<  LoCentral.user!_nombre
	.pl_datos[:tipo_ctl]   << "CTL"	
	.pl_datos[:clave_nco]   << LoNCO.user!_siglas.write_string
	.pl_datos[:tipo_nco]   <<  LoNCO.user!_tipo_servicio.write_string
	.pl_datos[:area]       <<  LoNCO.user!_area.write_string
	.pl_datos[:poblacion]  <<  l_sel_mpo
	.pl_datos[:del_mpo]    <<  l_sel_mpo
	.pl_datos[:clave_ctl]  <<  LoNCO.user!_siglas.write_string
	.pl_datos[:central]    <<  .pl_datos[:tipo_nco] + " "  +  .pl_datos[:clave_nco]  	

	# START CHANGE
	# (12/08/20 ahernanram) : CALCULO DE MUNICIPIO
	#
	_if ( _self.attributes[:municipio] _isnt _unset _andif
	      _self.attributes[:municipio].value  _isnt  _unset _andif
	      _self.attributes[:municipio].value.write_string.size > 0)
	_then
		.pl_datos[:del_mpo] <<  _self.attributes[:municipio].value.write_string.uppercase 			
		LoMunicipiouser? <<     _true 
	_else
		LoMunicipiouser? <<     _false
		.pl_datos[:del_mpo]    << _self.delegacion_municipio()
	_endif
		
_endmethod
$
_pragma(classify_level=advanced, topic={plotting}, usage={subclassable})
_method c_sello_estandar_ctl_edo.obtiene_colonia()
	## 
	## Obtiene la colonia
	## Autor: lgranados
	
	Logpm << gis_program_manager
	Lolbv << Logpm.cached_dataset(:landbase) 
	LoCentral << swg_dsn_admin_engine.active_scheme.project.user!_central.building
	tbl_colonia << Lolbv.collections[:user!_colonia]
	LoPred << predicate.interacts(:user!_limite,{LoCentral.location})
	Locolonia << tbl_colonia.select(LoPred).an_element()
	_if Locolonia _isnt _unset 
	_then
		nombre_col << Locolonia.user!_nombre
	_else
		nombre_col << ""
		
	_endif
	
	_return nombre_col
	
_endmethod
$
_pragma(classify_level=advanced, topic={plotting}, usage={subclassable})
_method c_sello_estandar_ctl_edo.valor_casilla_central()

	_return  .pl_datos[:tipo_ctl] + " - " + .pl_datos[:clave_ctl]
	
_endmethod
$
# (18/02/15 bernardoa) : Eliminacion de metodos no requeridos
# para alinear los cambios a produccion
_block
	c_sello_estandar_ctl_edo.remove_method(:municipio|<<|)
	c_sello_estandar_ctl_edo.remove_method(:colonia|<<|)
	c_sello_estandar_ctl_edo.remove_method(:codigo_postal|<<|)
	c_sello_estandar_ctl_edo.remove_method(:codigo_postal)
_endblock
$
