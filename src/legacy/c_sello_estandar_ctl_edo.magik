_pragma(classify_level=advanced, topic={plotting}, usage={subclassable})
_method c_sello_estandar_ctl_edo.defined_attributes

	attribs << rope.new_from (_super.defined_attributes)


		attribs.add(layout_attribute_definition.new(:emprerazon, :string,
						    :description, "RAZON SOCIAL",	    
                                                    :enum_method, :enum_tipo_razon_social))

	
	attribs.add(layout_attribute_definition.new(:comentario,  :string,
		                                    :description, "comentario"))

	
	attribs.add(layout_attribute_definition.new(:colonia, :string,
						    :description, "Colonia",
	                                            :default_value, _unset ))    

	attribs.add(layout_attribute_definition.new(:municipio, :string,
						    :description, "Delegación o Municipio",
						    :default_value, _unset ))

	attribs.add(layout_attribute_definition.new(:codigo_postal, :string,
						    :description, "Codigo Postal",
						    :default_value, _unset ))
	
	>> attribs
	
_endmethod
$

c_sello_estandar_ctl_edo.define_attributes()
$
_pragma(classify_level=restricted, usage={redefinable})
_method c_sello_estandar_ctl_edo .enum_tipo_razon_social
	## 
	## 
	.oTipoEmpresaRazonS    << hash_table.new()
	.oTipoEmpresaRazonS[1] << "TELEFONOS|DE MEXICO|S.A.B de C.V."
	.oTipoEmpresaRazonS[2] <<  "RED NACIONAL|ÚLTIMA MILLA|S.A.P.I. DE C.V"      # "RED|NACIONAL|ULTIMA MILLA"
	.oTipoEmpresaRazonS[3] <<  "RED ÚLTIMA|MILLA DEL NOROESTE|S.A.P.I. DE C.V"  # "RED|ULTIMA MILLA|DEL NOROESTE"	
	_return .oTipoEmpresaRazonS
	
_endmethod
$
