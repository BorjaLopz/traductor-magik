_pragma(classify_level=restricted, usage={redefinable})
_method c_sello_estudio_transmision.new_with(bb1, ruta)
	## 
	## 
	_self.sys!slot(:oengine) << ruta
	>> _super.new_with(:bounds, bb1)
_endmethod
