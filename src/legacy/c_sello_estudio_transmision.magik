def_slotted_exemplar(:c_sello_estudio_transmision,{

		     { :oEngine, _unset, :writable, :private},
		     {:pl_datos,            _unset,  :writable,  :private},
		     {:oTipoEmpresaR,      _unset                        }, # catalogo para empresa que revisa
		     {:valor_empreviso,    _unset                        } # Valor para empresa que revisa
		     },:c_base_sello_fibra)
$
c_sello_estudio_transmision.define_pseudo_slot(:grafico,_unset,:writable,:public)
