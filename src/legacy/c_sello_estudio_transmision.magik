_method c_sello_estudio_transmision.obtener_datos()
	## Objetivo: Obtener datos para el sello
	## Parametros de Entrada: Ninguno.
	## Parametros de Salida:  Ninguno.
	## Regresa: LoValores << property_list
	## Fecha de la ultima modificacion: 26/09/08
	## Autor de la modificacion: rraragon
	## Descripcion de la modificacion: Metodo Nuevo.
	
	_local LoFormat << float_format.new(:float_precision, 3)
	
	_local LoValores << property_list.new()
	_local LoEnlace << ""
	
	_if swg_dsn_admin_engine.active_scheme _isnt _unset 
	_then
		LoEnlace << swg_dsn_admin_engine.active_scheme.project.name
	_endif
	
	LoDistancia  << _self.getdistanciaruta()
	LoDistancia  << LoFormat.format(LoDistancia).write_string.default("")   
	
	LoValores[:enlace] << LoEnlace
	LoValores[:cable] << _self.getcablessalida()
	# (25/10/02 des_aaron) : se actualiza etiqueta de Mts a km
	LoValores[:longitud] << LoDistancia + " km"


	LoValores[:vobo1] << ""
	LoValores[:nombre1] << ""
	LoValores[:firma1] << ""
	LoValores[:fecha1] << ""

	LoValores[:vobo2] << ""
	LoValores[:nombre2] << ""
	LoValores[:firma2] << ""
	LoValores[:fecha2] << ""

	LoValores[:observaciones] << ""
	LoValores[:notas] << "OBSERVACIONES: SE CONSIDERAN DOS CONECTORES POR CENTRAL"
	
	_return LoValores
	
_endmethod
$

_pragma(classify_level=restricted, usage={redefinable})
_method c_sello_estudio_transmision.obtener_elementos_bd_gis()
	## 
	##
	l_dataset << mit_manager.modelit_dataset
	_if _self.elementos_bd_gis _isnt _unset _andif _self.elementos_bd_gis.size > 0
	_then
		.oEngine << rope.new()
		_for an_obj _over _self.elementos_bd_gis.elements()
		_loop
			l_obj_diagrama << property_list.new()
			_for a_key,ele _over an_obj.keys_and_elements()
			_loop
				_if a_key _isnt :direccion 
				_then
					_if (l_dato << l_dataset.collection(a_key).at(ele)) _isnt _unset 
					_then
						l_obj_diagrama[:objeto] << l_dato
					_endif
				_else
					l_obj_diagrama[:direccion] << ele
				_endif				
			_endloop
			.oEngine.add_last(l_obj_diagrama)
		_endloop		
	_endif
	
_endmethod
$
