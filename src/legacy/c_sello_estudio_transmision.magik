_pragma(classify_level=restricted, usage={redefinable})
_method c_sello_estudio_transmision.tamanio_tbl_notas()
	## Calcular el largo de la tabla tbl_tercera_parte
	## correspondiente a las observaciones y notas del sello
	## estudio de transmision
	## (19/11/14 bautistaja)
	## Metodo nuevo
        ## (19/01/15 bautistaja):Se calcula el tamaño de la tabla en
	## base al numero de saltos de linea en el texto
	tamanio << _self.notas.occurrences_of(%newline)
	_if _self.notas.occurrences_of(%newline) = 0
	_then
		obs << %newline + %newline + _self.notas
		_self.notas << obs
		tamanio +<< 15
	_elif _self.notas.occurrences_of(%newline) > 0
	_then
		_if _self.notas[1] <> %newline
		_then
			obs << %newline + %newline + _self.notas
			_self.notas << obs
		_endif
		tamanio +<< 5
		tamanio +<< _self.notas.occurrences_of(%newline)
		tamanio << tamanio*2
	_endif
	_self.o_tablas.elemento(:tbl_tercera_parte).orenglones.elemento(2).nlongitud << tamanio
_endmethod
$
_pragma(classify_level=restricted, usage={redefinable})
_method c_sello_estudio_transmision.tamanio_tbl_observaciones()
	## Calcular el largo de la tabla tbl_tercera_parte
	## correspondiente a las observaciones y notas del sello
	## estudio de transmision
	## (19/11/14 bautistaja)
	## Metodo nuevo
	## (19/01/15 bautistaja):Se calcula el tamaño de la tabla en
	## base al numero de saltos de linea en el texto
	tamanio << _self.observaciones.occurrences_of(%newline)
	_if _self.observaciones.occurrences_of(%newline) = 0
	_then
		obs << %newline + %newline + _self.observaciones
		_self.observaciones << obs
		tamanio +<< 15
	_elif _self.observaciones.occurrences_of(%newline) > 0
	_then
		_if _self.observaciones[1] <> %newline
		_then
			obs << %newline + %newline + _self.observaciones
			_self.observaciones << obs
		_endif
		tamanio +<< 5
		tamanio +<< _self.observaciones.occurrences_of(%newline)
		tamanio << tamanio*2
	_endif
	_self.o_tablas.elemento(:tbl_tercera_parte).orenglones.elemento(2).nlongitud << tamanio
	
_endmethod
$
_pragma(classify_level=restricted, usage={redefinable})
_method c_sello_estudio_transmision.total_empalmes()
	## 
	## 
	nempalmes << 0
	_if ( ruta << _self.sys!slot(:oengine)) _isnt _unset 
	_then
		_for el _over ruta.elements()
		_loop
			_if el[:objeto].is_kind_of?(splice_closure)
			_then
				nempalmes +<< 1
			_endif
		_endloop
	_endif
	
	_return nempalmes 
_endmethod
$

_pragma(classify_level=advanced, topic={plotting}, usage={subclassable})
_method c_sello_estudio_transmision.valor_propiedad(Propiedad, dato_actual)

	LoPropiedad << ""

	_if dato_actual _is _unset 
	_then
		dato_actual << ""	
	_endif

	_if _self.attributes[Propiedad]  _isnt _unset  _andif
	    _self.attributes[Propiedad].value _isnt _unset _andif
	    _self.attributes[Propiedad].value.size > 0
	_then
	
		LoPropiedad << _self.attributes[Propiedad].value.write_string
	_else
		LoPropiedad << dato_actual
	_endif

	_return LoPropiedad
		
_endmethod

$

_pragma(classify_level=restricted, usage={redefinable})
_method c_sello_estudio_transmision.info_sello_propiedades(lo_valores)

	lo_valores[:vobo1]     <<  _self.valor_propiedad(:vobo1,             Lo_valores[:vobo1])
	lo_valores[:nombre1]   <<  _self.valor_propiedad(:nombre1,           Lo_valores[:nombre1])
	lo_valores[:firma1]    <<  _self.valor_propiedad(:firma1,            Lo_valores[:firma1])
	lo_valores[:fecha1]    <<  _self.valor_propiedad(:fecha1,            Lo_valores[:fecha1])	
	lo_valores[:vobo2]     <<  _self.valor_propiedad(:vobo2,             Lo_valores[:vobo2])
	lo_valores[:nombre2]   <<  _self.valor_propiedad(:nombre2,           Lo_valores[:nombre2])
	lo_valores[:firma2]    <<  _self.valor_propiedad(:firma2,            Lo_valores[:firma2])
	lo_valores[:fecha2]    <<  _self.valor_propiedad(:fecha2,            Lo_valores[:fecha2])
	lo_valores[:observaciones]    <<  _self.valor_propiedad(:observaciones,     Lo_valores[:observaciones])
	lo_valores[:notas]    <<  _self.valor_propiedad(:notas,     Lo_valores[:notas])			
	
	_return lo_valores
	
_endmethod
$
