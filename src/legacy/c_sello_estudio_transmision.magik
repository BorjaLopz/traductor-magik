_pragma(classify_level=restricted, usage={redefinable})
_method c_sello_estudio_transmision.getcablesalida()
## Objetivo: Obtener el cable de salida de la ruta que contiene
## el sello
## Autor: rraragon
## Fecha: 24/11/2009	

    _for ele _over .oEngine.elements()
    _loop
	    _if (LoObj << ele[:objeto]).is_kind_of?(sheath)
	    _then
		    l_cab << LoObj
		    _leave 
	    _endif
    _endloop

    _return l_cab
    
_endmethod
$
_pragma(classify_level=restricted, usage={redefinable})
_method c_sello_estudio_transmision.getcablessalida()
## Objetivo: Obtener el cable de salida de la ruta que contiene
## el sello
## Autor: rbsaldan
## Fecha: 14/04/2015	

_local txtCables
_local nLines
_local nCharsXLine
_local cSeparator
       txtCables<<_unset
       nLines<<1
       nCharsXLine<<120
       _for ele _over .oEngine.elements()
       _loop
	       _if (LoObj << ele[:objeto]).is_kind_of?(sheath)
	       _then
		       _if txtCables _is _unset
		       _then
			       txtCables<<LoObj.spec_id.write_string
		       _else
			       _if txtCables.index_of_seq(LoObj.spec_id.write_string) _isnt _unset
			       _then
				       _continue
			       _else
				       _if txtCables.size>nCharsXLine*nLines
				       _then
					       cSeparator<<%newline
					       nLines<<nLines+1
				       _else
					       cSeparator<<" | "
				       _endif
				       txtCables<<txtCables+cSeparator+LoObj.spec_id.write_string	
			       _endif
			       
		       _endif
	       _endif
       _endloop
 
    _return txtCables
_endmethod
$

_pragma(classify_level=restricted, usage={redefinable})
_method c_sello_estudio_transmision.getdistanciaruta()
	## Objetivo: Obtener la distancia de la ruta que contiene el
	## sello, se obtiene sumando las longitudes de todos los cables	
	## Autor: rraragon
	## Fecha: 24/11/2009
	
	LoDistancia << 0.00
	
	_for ele _over .oEngine.elements()
	_loop
		_if (LoObj << ele[:objeto]).is_kind_of?(sheath)
		_then
			# (25/10/02 des_aaron) : se determina el campo 
			_if (LoKm << LoObj.user!_km_real_medido) _isnt _unset 
			_then
				LoDistancia + << LoKm.value
			_endif
		_endif
	_endloop
	
	
	_return LoDistancia
	
_endmethod
$


_pragma(classify_level=restricted, usage={redefinable})
_method c_sello_estudio_transmision.getEngine
## 
##
	_return .oEngine
	
_endmethod
$
_pragma(classify_level=restricted, usage={redefinable})
_method c_sello_estudio_transmision.guardar_elementos_bd_gis()
	## 
	## 
_local 	l_elementos_bd << rope.new()
	_for obj _over .oEngine.elements()
	_loop
		l_collection << obj[:objeto].source_collection.name
		l_id << obj[:objeto].id
		l_direccion << obj[:direccion]
		l_ele << property_list.new()
		l_ele[l_collection] << l_id
		l_ele[:direccion] << l_direccion
		l_elementos_bd.add_last(l_ele)
	_endloop
	
	_self.elementos_bd_gis << l_elementos_bd
	
_endmethod
$

_pragma(classify_level=restricted, usage={redefinable})
_method c_sello_estudio_transmision.llena_datos_celdas()
	## -----------------------------------------------------------------------
	#  Llena celdas con datos del sistema
	## -----------------------------------------------------------------------
	_try  _with LoError

	      _if ( _self.attributes[:empreviso] _isnt _unset _andif
		    _self.attributes[:empreviso].value) _isnt  _unset _andif
		  _self.attributes[:empreviso].value.size > 0
	      _then		
		      .valor_empreviso << "logo_" +  _self.attributes[:empreviso].value.write_string.uppercase
		      
		      _if .valor_empreviso.uppercase.matches?("*TELMEX*")
		      _then
			      .valor_empreviso << 	.valor_empreviso + "_EP"
		      _endif
		      
		      _self.asigna_simbolo_celda(:tbl_primera_parte,1,1, .valor_empreviso,5)
		      
	      _else
		      _self.asigna_simbolo_celda(:tbl_primera_parte,1,1,"logo_ultima_milla",5)		      
	      _endif

	LoValores << _self.obtener_datos()
	LoValores << _self.info_sello_propiedades(LoValores)


	_self.asigna_texto_celda(:tbl_segunda_parte, 1,1, LoValores[:enlace],  25)
	_self.asigna_texto_celda(:tbl_segunda_parte, 2,1, LoValores[:cable],    25)
	_self.asigna_texto_celda(:tbl_segunda_parte, 3,1, LoValores[:longitud],30)

	_self.asigna_texto_celda(:tbl_tercera_parte, 2,2, LoValores[:vobo1], 35, :centre_left, 1)
	_self.asigna_texto_celda(:tbl_tercera_parte, 3,2, LoValores[:nombre1], 35, :centre_left, 1)
	_self.asigna_texto_celda(:tbl_tercera_parte, 4,2, LoValores[:firma1], 35, :centre_left, 1)
	_self.asigna_texto_celda(:tbl_tercera_parte, 5,2, LoValores[:fecha1], 35, :centre_left, 1)

	_self.asigna_texto_celda(:tbl_tercera_parte, 2,4, LoValores[:vobo2], 35, :centre_left, 1)
	_self.asigna_texto_celda(:tbl_tercera_parte, 3,4, LoValores[:nombre2], 35, :centre_left, 1)
	_self.asigna_texto_celda(:tbl_tercera_parte, 4,4, LoValores[:firma2], 35, :centre_left, 1)
	_self.asigna_texto_celda(:tbl_tercera_parte, 5,4, LoValores[:fecha2], 35, :centre_left, 1)

	#####################################################################################################
	_self.asigna_texto_celda(:tbl_tercera_parte, 3,6, LoValores[:observaciones], 35, :centre_left, 1)
	_self.asigna_texto_celda(:tbl_tercera_parte, 1,1, LoValores[:notas], 35, :centre_left, 1)	

	# Asigna el gráfico
	.grafico << c_estudio_transmision_grafico.new(_self.getEngine)
	.o_tablas.elemento(:tbl_segunda_parte).oCeldas.celda(4,1).oElemento << .grafico
	      
	_when error 
	      write(LoError.write_string)
	_endtry
			
_endmethod
$

