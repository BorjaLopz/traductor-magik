_pragma(classify_level=restricted, usage={redefinable})
_method c_sello_estudio_transmision.defined_attributes
	## ---------------------------------------------------------------------
	#  Define atributos que seran proporcionados por el usuario
	## ---------------------------------------------------------------------

	
	_local attribs << rope.new_from(_super.defined_attributes)

	# START CHANGE
	# (2020-04-17 AHERNAN, Hitss) : 
	#
	attribs.add(layout_attribute_definition.new(:empreviso, :string,
						    :description, "Empresa que revisa",	    
                                                    :enum_method, :enum_tipo_empresar))
	# END CHANGE
	
	attribs.add(layout_attribute_definition.new(:estudio_num,  :string,
						    :description,  "Estudio Num"))
	attribs.add(layout_attribute_definition.new(:notas,        :string,
						    :description,  "Notas Adicionales",
						    :editor, in_place_multi_line_editor,
						    :default_value,"OBSERVACIONES: SE CONSIDERAN DOS CONECTORES POR CENTRAL"))

	attribs.add(layout_attribute_definition.new(:vobo1, :string,:description, "VO BO 1",:default_value, _unset ))
	attribs.add(layout_attribute_definition.new(:nombre1, :string,:description, "Nombre 1",:default_value, _unset ))
	attribs.add(layout_attribute_definition.new(:firma1, :string,:description, "Firma 1",:default_value, _unset ))
	attribs.add(layout_attribute_definition.new(:Fecha1, :string,:description, "Fecha 1",:default_value, _unset ))

	attribs.add(layout_attribute_definition.new(:vobo2, :string,:description, "VO BO 2",:default_value, _unset ))
	attribs.add(layout_attribute_definition.new(:nombre2, :string,:description, "Nombre 2",:default_value, _unset ))
	attribs.add(layout_attribute_definition.new(:firma2, :string,:description, "Firma 2",:default_value, _unset ))
	attribs.add(layout_attribute_definition.new(:Fecha2, :string,:description, "Fecha 2",:default_value, _unset ))

		
	attribs.add(layout_attribute_definition.new(:observaciones,:string,
						    :description,  "Observaciones",
						    :editor, in_place_multi_line_editor))

	
	>> attribs
	
_endmethod
$
c_sello_estudio_transmision.define_attributes()
