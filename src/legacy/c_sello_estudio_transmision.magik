_pragma(classify_level=restricted, usage={redefinable})
_method c_sello_estudio_transmision.configura_tabla()

	.col_tablas << property_list.new()
	
	_local largo  << (_self.bounds.xmax - _self.bounds.xmin) / 10
	
	# (25/10/02 des_aaron) : considerar agregar  nodos intermedios
	# para una mejor distribucion,
	
	_if (empalmes << _self.total_empalmes()  ) > 0 _andif
	    empalmes > 10
	_then
		largo  << (_self.bounds.xmax - _self.bounds.xmin)
		largo << (largo * (empalmes / 100))
		largo << largo + empalmes + 30
	_else
		largo << largo + empalmes + 30
	_endif
	
	_local alto << ((_self.bounds.ymax - _self.bounds.ymin) / 10   ) 
	
	## ---------------------------------------------------------------
	#  Tabla general 
	## ---------------------------------------------------------------
	

	_local pl_cfg_general << property_list.new()
	
	pl_cfg_general[:ren] << {alto}
	pl_cfg_general[:col] << {largo}
	
	lo_tabla << .o_tablas.crea_tabla(1,1,:tbl_general)
	lo_tabla.oCoordenada_Origen << .o_coord_inicio
	
	_self.asigna_medidas_tabla(lo_tabla, pl_cfg_general)
	
	## ----------------------------------------------------------------
	#  Tabla primera parte
	## ----------------------------------------------------------------
	
	_local pl_cfg_primera_parte << property_list.new()
	
	pl_cfg_primera_parte[:ren] << {alto*0.2}
	pl_cfg_primera_parte[:col] << {largo*0.3, largo*0.5, largo*0.2}
	lo_tabla << .o_tablas.crea_tabla(1,3, :tbl_primera_parte)
	lo_tabla.oCoordenada_origen << coordinate.new(.o_coord_inicio.x,
						      .o_coord_inicio.y)
	
	_self.asigna_medidas_tabla(lo_tabla, pl_cfg_primera_parte)
	
	## ----------------------------------------------------------------
	#  Tabla numero de estudio
	## ----------------------------------------------------------------
	
	lo_coord << coordinate.new(.o_coord_inicio.x + largo*8,
			           .o_coord_inicio.y - alto*2/2.3)
	
	lo_tabla << c_tbl_Linea_Horizontal.new(_self, lo_coord, 1 ,5, largo*0.2)
	lo_tabla.columna(1).nlongitud << largo*0.1
	lo_tabla.columna(2).nLongitud << largo*0.1
	lo_tabla.celda(1,1).nTamanio  << 30
	lo_tabla.celda(1,2).ntamanio  << 45
	lo_tabla.celda(1,2).salineacion  << :centre_centre
	lo_tabla.b_dibuja_bordes?     << _false
	lo_tabla.dibuja_columnas_internas? << _false
	.col_tablas[:tbl_estudio_num] << lo_tabla

	## ----------------------------------------------------------------
	#  Tabla segunda parte (nombre del tramo, numero de fibras,
	# longitud enlace
	## ----------------------------------------------------------------
	
	_local pl_cfg_segunda_parte << property_list.new()
	
	pl_cfg_segunda_parte[:ren]  << {alto*0.03, alto*0.03*2.5, alto*0.03, alto*0.3}
	pl_cfg_segunda_parte[:col]  << {largo}
	pl_cfg_segunda_parte[:borde_inf] << rope.new_with({1,1},{2,1},{3,1},{4,1})
	
	pl_cfg_segunda_parte[:borde_sup] << rope.new_with({1,1},{2,1},{3,1},{4,1})
	
	lo_tabla << .o_tablas.crea_tabla(4,1, :tbl_segunda_parte)
	lo_tabla.oCoordenada_origen << coordinate.new(.o_coord_inicio.x,
						      .o_coord_inicio.y - alto*2)
	
	_self.asigna_medidas_tabla(lo_tabla, pl_cfg_segunda_parte)
	_self.oculta_bordes_celdas(lo_tabla, pl_cfg_segunda_parte)
	
	## ----------------------------------------------------------------
	#  Tabla Tercera parte (Observaciones y notas)
	## ----------------------------------------------------------------
	
	_local pl_cfg_tercera_parte << property_list.new()
	
	##pl_cfg_tercera_parte[:ren]  << {alto*0.03, alto*0.07, 4,4,4}
	##pl_cfg_tercera_parte[:col]  <<  {largo*0.5, largo*0.5,   }     
	
	# (25/10/02 des_aaron) : se actualiza ancho de celdas (3-->4)
	pl_cfg_tercera_parte[:ren]  << {4,4,4,4,4}
	
	# (25/10/02 des_aaron) : se definen porcentajes de ancho
	anchot         << largo * 0.1
	anchov         << largo * 0.15
	
	anchoespacio   << largo * 0.01
	anchoobs       << largo * 0.49
	
	pl_cfg_tercera_parte[:col]  << {anchot ,anchov,anchot,anchov,anchoespacio, anchoobs }     

	pl_cfg_tercera_parte[:borde_sup_inf] << rope.new_with({1,1},{1,2},{1,3},{1,4} , {2,1},{2,3} ,{3,1},{3,3},{4,1},{4,3},{1,5},{2,5},{3,5},{4,5},{1,6})
	
	pl_cfg_tercera_parte[:borde_der_izq] << rope.new_with({1,1},{1,2},{1,3},{1,4},{1,5},{2,5},{3,5},{4,5},{5,5} ,{2,2},{2,3},{2,4},{3,2},{3,3},{3,4} ,{4,2},{4,3},{4,4} ,{5,2},{5,3},{5,4})
	
	pl_cfg_tercera_parte[:borde_der] << rope.new_with({2,1},{3,1},{4,1},{5,1})
	
	
	lo_tabla << .o_tablas.crea_tabla(5,6, :tbl_tercera_parte)
	
	# (25/10/02 des_aaron) : calcular acho de sello pral(1450 )
	lo_tabla.oCoordenada_origen << coordinate.new(.o_coord_inicio.x,.o_coord_inicio.y - 1450)
	
	_self.asigna_medidas_tabla(lo_tabla, pl_cfg_tercera_parte)
	_self.oculta_bordes_celdas(lo_tabla, pl_cfg_tercera_parte)
	
_endmethod
$
_pragma(classify_level=restricted, usage={redefinable})
_method c_sello_estudio_transmision.etiqueta_celdas()
	## --------------------------------------------------------------------------------
	#  Etiqueta celdas 
	## --------------------------------------------------------------------------------

	_self.asigna_simbolo_celda(:tbl_primera_parte, 1,1, "logo_ultima_milla",5)
	
	_self.asigna_texto_celda(:tbl_primera_parte,   1,2, "ESTUDIO DE TRANSMISION F.O", 80, :centre_centre)
		
	.col_tablas[:tbl_estudio_num].asigna_etiquetas({" EST. NO."})

	_self.asigna_texto_celda(:tbl_segunda_parte, 1,1, "Nombre del tramo", 35)
	_self.asigna_texto_celda(:tbl_segunda_parte, 2,1, "Numero de fibras y tipo", 35)
	_self.asigna_texto_celda(:tbl_segunda_parte, 3,1, "LONGITUD TOTAL DEL ENLACE: ",35)

	# (25/10/02 des_aaron) : se agregan celdas faltantes
	
	_self.asigna_texto_celda(:tbl_tercera_parte, 1,1,  "OBSERVACIONES: SE CONSIDERAN DOS CONECTORES POR CENTRAL", 35, :centre_left, 1)
	_self.asigna_texto_celda(:tbl_tercera_parte, 2,1,  "Vo. Bo.:", 35, :centre_left, 1)
	_self.asigna_texto_celda(:tbl_tercera_parte, 3,1,  "NOMBRE:", 35, :centre_left, 1)
	_self.asigna_texto_celda(:tbl_tercera_parte, 4,1,  "FIRMA:", 35, :centre_left, 1)
	_self.asigna_texto_celda(:tbl_tercera_parte, 5,1,  "FECHA", 35, :centre_left, 1)

	_self.asigna_texto_celda(:tbl_tercera_parte, 2,3,  "Vo. Bo.:", 35, :centre_left, 1)
	_self.asigna_texto_celda(:tbl_tercera_parte, 3,3,  "NOMBRE:", 35, :centre_left, 1)
	_self.asigna_texto_celda(:tbl_tercera_parte, 4,3,  "FIRMA:", 35, :centre_left, 1)
	_self.asigna_texto_celda(:tbl_tercera_parte, 5,3,  "FECHA", 35, :centre_left, 1)
	
	_self.asigna_texto_celda(:tbl_tercera_parte, 2,6,  "OBSERVACIONES", 35, :centre_left, 1)
	
_endmethod
