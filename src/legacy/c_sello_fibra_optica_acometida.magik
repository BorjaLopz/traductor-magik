_pragma(classify_level=restricted, usage={redefinable})
_method c_sello_fibra_optica_acometida.fecha_elaboracion

	_local ld_fecha_hoy << date_now()
	_return c_traductor.mes(ld_fecha_hoy.month_number, _true) +"-"+ ld_fecha_hoy.year.write_string
	
_endmethod
$
_pragma(classify_level=restricted, usage={redefinable})
_method c_sello_fibra_optica_acometida.inicializa( properties )

	
	# - Se agrega el parámetro: properties como resultado de las
	#   modificaciones para almacenar los valores del sello
	#   en archivo .xml

	_try 
	_super.inicializa( properties )
	
	_if .o_proyecto _is _unset _andif
	    swg_dsn_admin_engine.active_scheme _isnt _unset 
	_then
		.o_proyecto << swg_dsn_admin_engine.active_scheme.project
	_endif
				
	_when error
	      
	_endtry

_endmethod
$

_pragma(classify_level=advanced, topic={plotting}, usage={subclassable})
_method c_sello_fibra_optica_acometida.llena_datos_dinamicos()

	_local ls_escala << _self.escala()
	_local ls_num_hoja << "HOJA : " + _self.layout_page.page_number().write_string
	_local ls_total_hojas << "/" + _self.layout_page.number_of_pages().write_string

##	_self.asigna_texto_linea_celda(:tbl_EscalaRuta,1,2,ls_escala,40)
###	_self.asigna_texto_linea_celda(:tbl_PlanoNum,1,3,ls_num_hoja+ls_total_hojas,40)

_endmethod
$

_pragma(classify_level=restricted)
_method c_sello_fibra_optica_acometida.serial_slots()

	(keys,values) << _super.serial_slots()

	keys.add_all_last( rope.new_with(:col_tablas))
	values.add_all_last( rope.new_with(.col_tablas))

	>> keys, values
	
_endmethod
$
_pragma(classify_level=restricted, usage={redefinable})
_method c_sello_fibra_optica_acometida.tramos_en_ruta()
	_try
		_return .o_tramo.ruta.get_tramos().size.write_string
	_when does_not_understand
		_return ""
	_endtry
_endmethod
$


_pragma(classify_level=restricted, usage={redefinable})
_method c_sello_fibra_optica_acometida.escala()

	mv << smallworld_product.pni_application().plugin(:map_plugin).current_map_view
	_return "1:" + mv.view_scale.rounded.write_string
_endmethod
$
_pragma(classify_level=restricted, usage={redefinable})
_method c_sello_fibra_optica_acometida.tipo_de_plano

	_local tipo_plano
	_local oLayoutPlugin

	opaf << smallworld_product.pni_application()
	_if opaf _isnt _unset 
	_then
		oLayoutPlugin   << opaf.plugin(:layout_plugin)
		oLayoutDesigner << oLayoutPlugin.dialogs[:layout_designer]
		oLayoutManager  << oLayoutDesigner.plugin(:layout_manager)    
		LoDoc << oLayoutManager.current_document
		_if LoDoc _isnt _unset _andif
		    LoDoc.user!_tipo_plano _isnt _unset
		_then
			tipo_plano << LoDoc.user!_tipo_plano	
		_endif
	_else
		tipo_plano << :acometida
	_endif

	_return tipo_plano
	
_endmethod
$
_pragma(classify_level=restricted, usage={redefinable})
_method c_sello_fibra_optica_acometida.valor_propiedad(Propiedad, dato_actual)
	## 
	##

	LoPropiedad << ""
	
	_if _self.attributes[Propiedad]  _isnt _unset  _andif
	    _self.attributes[Propiedad].value _isnt _unset _andif
	    _self.attributes[Propiedad].value.write_string.size > 0
	_then
	
		LoPropiedad << _self.attributes[Propiedad].value.write_string
	_else
		LoPropiedad << dato_actual
	_endif

	_return LoPropiedad
	
_endmethod
$
_pragma(classify_level=advanced, topic={plotting}, usage={subclassable})
_method c_sello_fibra_optica_acometida.obten_registros()

	.s_tipo_plano <<  _self.tipo_de_plano
	
	_local pl_datos << property_list.new()

	pl_datos[:division]       << .o_proyecto.user!_central.user!_division
      
	_if .o_area _isnt _unset 
	_then
		pl_datos[:direccion_sot]  << .o_area.direccion
		pl_datos[:telefono]       << .o_area.telefono
		pl_datos[:responsable]    << .o_area.responsable	
	_endif
	
	pl_datos[:sot]            << .o_proyecto.user!_central.area_tmx.user!_nombre
	pl_datos[:central]        << .o_proyecto.nombre_central + " - " + .o_proyecto.user!_central.user!_central
	pl_datos[:municipio]      << .o_proyecto.user!_central.busca_municipio_central()
	
	
	pl_datos[:reviso]         << .o_proyecto.user!_empresa_revisora
        pl_datos[:proyecto]       << .o_proyecto.user!_empresa_proyecto
	
	
	_return pl_datos
	
_endmethod
$
_pragma(classify_level=restricted, usage={redefinable})
_method c_sello_fibra_optica_acometida.info_sello_propiedades(lo_valores)

	#tabla division
	lo_valores[:sot]                 <<  _self.valor_propiedad(:sot,Lo_valores[:sot])
	lo_valores[:direccion_sot]       <<  _self.valor_propiedad(:direccion_sot,Lo_valores[:direccion_sot])
	lo_valores[:telefono]            <<  _self.valor_propiedad(:telefono,Lo_valores[:telefono])
	lo_valores[:responsable_area]    <<  _self.valor_propiedad(:responsable_area,Lo_valores[:responsable_area])
	#tabla enlace
	lo_valores[:enlace]              <<  _self.valor_propiedad(:enlace,Lo_valores[:enlace])	
	lo_valores[:anillo]              <<  _self.valor_propiedad(:anillo,Lo_valores[:anillo])	
	lo_valores[:pess]                <<  _self.valor_propiedad(:pess,Lo_valores[:pess])
	
	#tabla poblacion
	lo_valores[:usuario]             <<  _self.valor_propiedad(:usuario,Lo_valores[:usuario])
	lo_valores[:direccion_user]      <<  _self.valor_propiedad(:direccion_user,Lo_valores[:direccion_user])
	lo_valores[:colonia_cp]          <<  _self.valor_propiedad(:colonia_cp,Lo_valores[:colonia_cp])
	lo_valores[:municipio]           <<  _self.valor_propiedad(:municipio,Lo_valores[:municipio])
	lo_valores[:central]             <<  _self.valor_propiedad(:central,Lo_valores[:central])
	
	#tabla operacion
	lo_valores[:pep]                 <<  _self.valor_propiedad(:pep,Lo_valores[:pep])
	lo_valores[:opb]                 <<  _self.valor_propiedad(:opb,Lo_valores[:opb])
	lo_valores[:oei]                 <<  _self.valor_propiedad(:oei,Lo_valores[:oei])
	lo_valores[:oe_pep]               <<  _self.valor_propiedad(:oe_pep,Lo_valores[:oe_pep])
        lo_valores[:oe_ref]              <<  _self.valor_propiedad(:oe_ref,Lo_valores[:oe_ref])
	lo_valores[:ref_sisa]            <<  _self.valor_propiedad(:ref_sisa,Lo_valores[:ref_sisa])
	#tabla 
	lo_valores[:empreviso]           <<  _self.valor_propiedad(:empreviso,Lo_valores[:empreviso])
	lo_valores[:empreproy]           <<  _self.valor_propiedad(:empreproy,Lo_valores[:empreproy])

        #escala / plano
	lo_valores[:escala]              <<  _self.valor_propiedad(:escala,Lo_valores[:escala])
	lo_valores[:plano]               <<  _self.valor_propiedad(:plano,Lo_valores[:plano])

	
	_return lo_valores
	
_endmethod
$
_pragma(classify_level=advanced, topic={plotting}, usage={subclassable})
_method c_sello_fibra_optica_acometida.llena_datos_celdas()

	_local pl_datos << _self.obten_registros()

	
	meses         << {:ene, :feb, :mar, :abr, :may, :jun,:jul, :ago, :sep, :oct,:nov, :dic}	
	mes           << meses[date_now().month_number]
	anio          << date_now().year
        fecha         << mes.write_string + %/ + anio.write_string
	fecha         << fecha.uppercase
	
	
	_if ( _self.attributes[:empreviso] _isnt _unset _andif
	      _self.attributes[:empreviso].value) _isnt  _unset _andif
	    _self.attributes[:empreviso].value.size > 0
	_then
		
		.valor_empreviso << "logo_" +  _self.attributes[:empreviso].value.write_string.lowercase
		
		_if .valor_empreviso.uppercase.matches?("*TELMEX*")
		_then
			.valor_empreviso << 	.valor_empreviso + "_EP"
			txttitulo << "TELEFONOS DE MEXICO S.A DE C.V."
			_self.asigna_texto_celda(:tbl_Empresa,1,2, txttitulo ,80)	
		_elif .valor_empreviso.uppercase.matches?("*ULTIMA_MILLA")
			_then 
				txttitulo << "RED NACIONAL ULTIMA MILLA"
				_self.asigna_texto_celda(:tbl_Empresa,1,2, txttitulo ,60)
				
			_elif .valor_empreviso.uppercase.matches?("*ULTIMA_MILLA_N")
			_then
				txttitulo << "RED ULTIMA MILLA DEL NOROESTE"				
                         	_self.asigna_texto_celda(:tbl_Empresa,1,2, txttitulo ,60)
			_endif
		
			_self.asigna_simbolo_celda(:tbl_Empresa,1,1, .valor_empreviso.uppercase)
                      			
		_else
			txttitulo << "TELEFONOS DE MEXICO S.A DE C.V."
			_self.asigna_texto_celda(:tbl_Empresa,1,2, txttitulo ,80)
		_endif


	pl_datos[:division]       << .o_proyecto.user!_central.user!_division
	pl_datos[:sot]            << .o_proyecto.user!_central.user!_area

	_if .o_area _isnt _unset 
	_then
		pl_datos[:direccion_sot]  << .o_area.direccion
		pl_datos[:telefono]       << .o_area.telefono
		pl_datos[:responsable_area]    << .o_area.responsable	
	_endif


	
	pl_datos[:central]        << .o_proyecto.nombre_central + " - " + .o_proyecto.user!_central.user!_central
	pl_datos[:municipio]      << .o_proyecto.user!_central.busca_municipio_central()


	_self.info_sello_propiedades(pl_datos)
	
	_self.asigna_texto_linea_celda(:tbl_poblacion,1,2,pl_datos[:usuario],40)
	_self.asigna_texto_linea_celda(:tbl_poblacion,2,2,pl_datos[:direccion_user],40)
	_self.asigna_texto_linea_celda(:tbl_poblacion,3,2,pl_datos[:colonia_cp],40)
	_self.asigna_texto_linea_celda(:tbl_poblacion,4,2,pl_datos[:municipio],40)
	_self.asigna_texto_linea_celda(:tbl_poblacion,5,2,pl_datos[:central],40)
	    
	    	
	_self.asigna_texto_linea_celda(:tbl_division,1,2,pl_datos[:sot],40)
	_self.asigna_texto_linea_celda(:tbl_division,2,2,pl_datos[:direccion_sot],40)
	_self.asigna_texto_linea_celda(:tbl_division,3,2,pl_datos[:telefono],40)
	_self.asigna_texto_linea_celda(:tbl_division,4,2,pl_datos[:responsable_area],40)
	
	_self.asigna_texto_linea_celda(:tbl_enlace,1,2,pl_datos[:enlace],40)  #  enlace 
	_self.asigna_texto_linea_celda(:tbl_enlace,1,4,pl_datos[:anillo],40)  #  anillo
	
	_self.asigna_texto_linea_celda(:tbl_enlace,1,6,pl_datos[:pess],40)    #   pess
	
	_self.asigna_texto_linea_celda(:tbl_Aprobo,1,2,pl_datos[:proyecto],40)
	_self.asigna_texto_linea_celda(:tbl_Aprobo,2,2,pl_datos[:reviso],40)
	_self.asigna_texto_linea_celda(:tbl_Aprobo,2,4,fecha,40)
	
	_self.asigna_texto_linea_celda(:tbl_PlanoNum,  1,2,pl_datos[:plano],40)	     
	_self.asigna_texto_linea_celda(:tbl_EscalaRuta,1,2,pl_datos[:escala],40)

	_self.asigna_texto_linea_celda(:tbl_Operacion,1,2,pl_datos[:pep],40)
	_self.asigna_texto_linea_celda(:tbl_Operacion,2,2,pl_datos[:opb],40)
	_self.asigna_texto_linea_celda(:tbl_Operacion,3,2,pl_datos[:oe_pep],40)
	_self.asigna_texto_linea_celda(:tbl_Operacion,1,4,pl_datos[:ref_sisa],40)
	_self.asigna_texto_linea_celda(:tbl_Operacion,2,4,pl_datos[:oei],40)
	_self.asigna_texto_linea_celda(:tbl_Operacion,3,4,pl_datos[:oe_ref],40)
	
	.o_tablas.elemento(:tbl_Operacion).oCeldas.Celda(1,2).oElemento.sEstilo << "Bold"
	.o_tablas.elemento(:tbl_Operacion).oCeldas.Celda(1,4).oElemento.sEstilo << "Bold"	
	.o_tablas.elemento(:tbl_Operacion).oCeldas.Celda(2,2).oElemento.sEstilo << "Bold"
	.o_tablas.elemento(:tbl_Operacion).oCeldas.Celda(2,4).oElemento.sEstilo << "Bold"
	.o_tablas.elemento(:tbl_Operacion).oCeldas.Celda(3,2).oElemento.sEstilo << "Bold"
	.o_tablas.elemento(:tbl_Operacion).oCeldas.Celda(3,4).oElemento.sEstilo << "Bold"
	
	.o_tablas.elemento(:tbl_enlace).oCeldas.Celda(1,2).oElemento.sEstilo << "Bold"
	.o_tablas.elemento(:tbl_enlace).oCeldas.Celda(1,4).oElemento.sEstilo << "Bold"	
	.o_tablas.elemento(:tbl_enlace).oCeldas.Celda(1,6).oElemento.sEstilo << "Bold"	


_endmethod
$

