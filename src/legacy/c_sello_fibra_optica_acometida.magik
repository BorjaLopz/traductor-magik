def_slotted_exemplar(:c_sello_fibra_optica_acometida,
{
	{:o_tramo,       _unset,  :writable},
	{:o_proyecto,    _unset, :writable},
	{:o_area,        _unset,  :writable},
	{:s_tipo_plano,   _unset,  :writable},
	{:otipoempresar,      _unset, :writable}, # catalogo para empresa que revisa
	{:otipoempresap,      _unset, :writable}, # catalogo para empresa que proyecta
	{:valor_empreviso,    _unset, :writable} # Valor para empresa que revisa

}, {:c_base_sello_fibra} )
$
c_sello_fibra_optica_acometida.define_shared_constant(:allowed_on_menu?, _false  , :public)
$
_method c_sello_fibra_optica_acometida.defined_attributes

	attribs << rope.new_from (_super.defined_attributes)

	attribs.add(layout_attribute_definition.new(:blanco_negro,  :string,
		                                    :description,   "blanco_negro",
						    :enum_method,   :enum_bool,
						    :default_value, "NO"))

	attribs.add(layout_attribute_definition.new(:sot, :string,
						    :description, "sot",
	                                            :default_value, _unset ))    

	attribs.add(layout_attribute_definition.new(:direccion_sot, :string,
						    :description, "direccion_sot",
	                                            :default_value, _unset ))    
	
	attribs.add(layout_attribute_definition.new(:telefono, :string,
						    :description, "TELEFONO",
						    :default_value, _unset ))

	attribs.add(layout_attribute_definition.new(:responsable_area, :string,
						    :description, "RESPONSABLE AREA",
						    :default_value, _unset ))

	attribs.add(layout_attribute_definition.new(:enlace, :string,
						    :description, "enlace",
						    :default_value, _unset ))

	attribs.add(layout_attribute_definition.new(:anillo, :string,
						    :description, "anillo",
						    :default_value, _unset ))
	
	attribs.add(layout_attribute_definition.new(:pess, :string,
						    :description, "pess",
						    :default_value, _unset ))

	attribs.add(layout_attribute_definition.new(:usuario, :string,
						    :description, "usuario",
						    :default_value, _unset ))

	attribs.add(layout_attribute_definition.new(:direccion_user, :string,
						    :description, "direccion_user",
						    :default_value, _unset ))

	attribs.add(layout_attribute_definition.new(:colonia_cp, :string,
						    :description, "Colonia_cp",
	                                            :default_value, _unset ))    

	attribs.add(layout_attribute_definition.new(:municipio, :string,
						    :description, "Delegación o Municipio",
						    :default_value, _unset ))

	attribs.add(layout_attribute_definition.new(:central, :string,
						    :description, "central",
						    :default_value, _unset ))


	attribs.add(layout_attribute_definition.new(:pep, :string,
						    :description, "PEP",
						    :default_value, _unset ))

	attribs.add(layout_attribute_definition.new(:opb,:string,
		                                    :description,     "opb",
						     :default_value, _unset ))


	attribs.add(layout_attribute_definition.new(:oei,:string,
		                                    :description,     "OEI",
						     :default_value, _unset ))

	attribs.add(layout_attribute_definition.new(:oe_pep,     :string,
		                                    :description,     "OE pep",
						     :default_value, _unset ))

	attribs.add(layout_attribute_definition.new(:oe_ref,     :string,
		                                    :description,     "OE ref",
						     :default_value, _unset ))

	attribs.add(layout_attribute_definition.new(:ref_sisa,     :string,
		                                    :description,     "ref sisa",
						    :default_value, _unset ))
	

	attribs.add(layout_attribute_definition.new(:empreviso, :string,
						    :description, "Empresa que revisa",	    
                                                    :enum_method, :enum_tipo_empresar))
	


	attribs.add(layout_attribute_definition.new(:empreproy, :string,
						    :description, "Empresa que proyecta",	    
                                                    :enum_method, :enum_tipo_empresap))

	
	# (22/10/19 des_aaron) : 	

	attribs.add(layout_attribute_definition.new(:poblacion, :string,
						    :description, "Poblacion",
	                                            :default_value, _unset ))    

	attribs.add(layout_attribute_definition.new(:codigo_postal, :string,
						    :description, "Codigo Postal",
						    :default_value, _unset ))

	
	attribs.add(layout_attribute_definition.new(:escala,     :string,
		                                    :description,     "escala",
						     :default_value, _unset ))

	attribs.add(layout_attribute_definition.new(:plano,     :string,
		                                    :description,     "plano",
						     :default_value, _unset ))

	

	>> attribs
	
_endmethod
$

c_sello_fibra_optica_acometida.define_attributes()
