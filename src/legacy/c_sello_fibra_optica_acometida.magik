_pragma(classify_level=advanced, topic={plotting}, usage={subclassable})
_method c_sello_fibra_optica_acometida.configura_tabla()

	.o_color_linea <<  {1.0, 0.0, 0.0}
	
	.col_tablas << property_list.new()
	
	_local lo_tabla         
	_local ln_desp_y

	_local pl_marco        << property_list.new()
	_local pl_empresa      << property_list.new()
	_local pl_division     << property_list.new()
	_local pl_proyecto     << property_list.new()
	_local pl_enlace       << property_list.new()
	_local pl_poblacion    << property_list.new()
	_local pl_plano        << property_list.new()
	_local pl_escala       << property_list.new()
	_local pl_proyectista  << property_list.new()
	_local pl_referencia   << property_list.new()
	_local pl_aprobo       << property_list.new()
	_local pl_operacion    << property_list.new()
	
	pl_marco[:ren] << {200}  
	pl_marco[:col] << {210}   

	pl_empresa[:ren] << {30}
	pl_empresa[:col] << {25,150}

	pl_division[:ren] << {7,7,7,7}
	pl_division[:col] << {40,80}
	
	pl_proyecto[:ren] << {10}
	pl_proyecto[:col] << {175}

	pl_enlace[:ren] << {7}
	pl_enlace[:col] << {15,50,15,50,15,30}
	
	pl_poblacion[:ren] << {7,7,7,7,7}
	pl_poblacion[:col] << {40,80}
	
	pl_plano[:ren] << {10}
	pl_plano[:col] << {30,33.5,33.5}

	pl_escala[:ren] << {10}
	pl_escala[:col] << {20,35,20,20}

	pl_proyectista[:col] << {30,67}

	pl_referencia[:col] << {30,65}
	
	pl_aprobo[:ren] << {10,10}
	pl_aprobo[:col] << {50,50,50,50}

	pl_operacion[:ren] << {10,10,10}
	pl_operacion[:col] << {15,40,25,40}
	
	# - Marco del sello - #
	lo_tabla << .o_tablas.crea_tabla(1,1,:tbl_MarcoSello)
	lo_tabla.oCoordenada_Origen << .o_coord_inicio
	_self.asigna_medidas_tabla(lo_tabla, pl_marco)

	# - Tabla Empresa - #
	lo_tabla << .o_tablas.crea_tabla(1,2,:tbl_Empresa)
	lo_tabla.oCoordenada_Origen << coordinate.new(.o_coord_inicio.x + 17.5 * 10,.o_coord_inicio.y - 3.5 * 10)
	_self.asigna_medidas_tabla(lo_tabla, pl_empresa)
	lo_tabla.bDibuja_columnas_internas? << _false
	
	# - Tabla División - #
	lo_tabla << .o_tablas.crea_tabla(4,2,:tbl_division)
	lo_tabla.oCoordenada_Origen << coordinate.new(.o_coord_inicio.x + 45 * 10,.o_coord_inicio.y - 38.5 * 10)
	lo_tabla.bDibuja_columnas_internas? << _false
	_self.asigna_medidas_tabla(lo_tabla, pl_division)
        .col_tablas[:tbl_division] << lo_tabla

	# - Tabla Proyecto - #
	lo_tabla << .o_tablas.crea_tabla(1,1,:tbl_Proyecto)
	lo_tabla.oCoordenada_Origen << coordinate.new(.o_coord_inicio.x + 17.5 * 10,.o_coord_inicio.y - 68.5 * 10)
	_self.asigna_medidas_tabla(lo_tabla, pl_proyecto)

	# - Tabla Enlace- #
	lo_tabla << .o_tablas.crea_tabla(1,6,:tbl_enlace)
	lo_tabla.bDibuja_columnas_internas? << _false
	lo_tabla.oCoordenada_Origen << coordinate.new(.o_coord_inicio.x + 17.5 * 10,.o_coord_inicio.y - 81.5 * 10)
	_self.asigna_medidas_tabla(lo_tabla, pl_enlace)


	# - Tabla Poblacion - #
	lo_tabla << .o_tablas.crea_tabla(5,2,:tbl_poblacion)	
	lo_tabla.bDibuja_columnas_internas? << _false
	#lo_tabla.bDibuja_Renglones_Internos?  << _false
	lo_tabla.oCoordenada_Origen << coordinate.new(.o_coord_inicio.x + 45 * 10,.o_coord_inicio.y  - 90.5 * 10) 
	_self.asigna_medidas_tabla(lo_tabla, pl_poblacion)
	.col_tablas[:tbl_poblacion] << lo_tabla
	
#	# - Tabla Operación - #
	lo_tabla << .o_tablas.crea_tabla(3,4,:tbl_Operacion)	
	lo_tabla.oCoordenada_Origen << coordinate.new(.o_coord_inicio.x + 45 * 10,.o_coord_inicio.y  - 127 * 10) 
	_self.asigna_medidas_tabla(lo_tabla, pl_operacion)
	lo_tabla.bDibuja_columnas_internas? << _false
	.col_tablas[:tbl_operacion] << lo_tabla
	
	# - Tabla Plano - #
	lo_tabla << .o_tablas.crea_tabla(1,3,:tbl_PlanoNum)
	lo_tabla.oCoordenada_Origen << coordinate.new(.o_coord_inicio.x + 6 * 10, .o_coord_inicio.y - 160 * 10)  
	_self.asigna_medidas_tabla(lo_tabla, pl_plano)
	lo_tabla.bDibuja_columnas_internas? << _false
	.col_tablas[:tbl_PlanoNum] << lo_tabla
	
	# - Tabla Escala - #
	lo_tabla << .o_tablas.crea_tabla(1,4,:tbl_EscalaRuta)
	lo_tabla.oCoordenada_Origen << coordinate.new(.o_coord_inicio.x + 109 * 10,.o_coord_inicio.y - 160 * 10) 
	_self.asigna_medidas_tabla(lo_tabla, pl_escala)
	lo_tabla.bDibuja_columnas_internas? << _false
	.col_tablas[:tbl_EscalaRuta] << lo_tabla
	
	# - Tabla Aprobó - #
	lo_tabla << .o_tablas.crea_tabla(2,4,:tbl_Aprobo)
	lo_tabla.oCoordenada_Origen << coordinate.new(.o_coord_inicio.x + 6 * 10,.o_coord_inicio.y - 175.5 * 10)
	_self.asigna_medidas_tabla(lo_tabla, pl_aprobo)
	lo_tabla.bDibuja_columnas_internas? << _false
	.col_tablas[:tbl_aprobo] << lo_tabla

	_self.asigna_celdas_a_colorear()
_endmethod
$

_pragma(classify_level=restricted, usage={redefinable})
_method c_sello_fibra_optica_acometida.draw_content_on(window)

	_super.draw_content_on(window)
	
	_for tabla _over .col_tablas.fast_elements()
	_loop
		tabla.Despliega(window)
	_endloop
	
_endmethod
$
_pragma(classify_level=advanced, topic={plotting}, usage={subclassable})
_method c_sello_fibra_optica_acometida.etiqueta_celdas()

	_local a_sch

	a_sch <<  swg_dsn_admin_engine.active_scheme


	_if a_sch _isnt _unset _andif
	    (a_project << a_sch.project) _isnt _unset _andif
	    (a_ctl << a_project.user!_central) _isnt _unset 
	_then
		_if a_ctl.user!_area = "MEXICALI" _orif
		    a_ctl.user!_area = "TIJUANA-ENSENADA"
		_then
			_self.asigna_simbolo_celda(:tbl_Empresa,1,1,"logo_ultima_milla_n")
			_self.asigna_texto_celda(:tbl_Empresa,1,2,"RED ULTIMA MILLA DEL NOROESTE S.A. DE C.V.",65)
		_else
			_self.asigna_simbolo_celda(:tbl_Empresa,1,1,"logo_ultima_milla")
			_self.asigna_texto_celda(:tbl_Empresa,1,2,"RED NACIONAL ULTIMA MILLA S.A. DE C.V.",70)
		_endif

	_else
		_self.asigna_simbolo_celda(:tbl_Empresa,1,1,"logo_telmex_ep")
		_self.asigna_texto_celda(:tbl_Empresa,1,2,"TELEFONOS DE MEXICO S.A. DE C.V.",80)	
	_endif
		

	_self.asigna_texto_celda(:tbl_Proyecto,1,1,"PROYECTO DE FIBRA OPTICA",80)	
	_self.asigna_texto_celda(:tbl_PlanoNum,1,1,"PLANO No.",40)
	_self.asigna_texto_celda(:tbl_PlanoNum,1,2,"DE",40)
	_self.asigna_texto_celda(:tbl_EscalaRuta,1,1,"ESCALA",40)		
	_self.asigna_texto_linea_celda(:tbl_PlanoNum,1,2," ",40)
	
	
	_self.asigna_texto_celda(:tbl_division,1,1,"SOT",40,:centre_left)
	_self.asigna_texto_celda(:tbl_division,2,1,"DIRECCION",40,:centre_left)
	_self.asigna_texto_celda(:tbl_division,3,1,"TELEFONO",40,:centre_left)
	_self.asigna_texto_celda(:tbl_division,4,1,"RESPONSABLE",40,:centre_left)

	_self.asigna_texto_celda(:tbl_poblacion,1,1,"USUARIO",40,:centre_left)
	_self.asigna_texto_celda(:tbl_poblacion,2,1,"DIRECCION",40,:centre_left)
	_self.asigna_texto_celda(:tbl_poblacion,3,1,"COLONIA Y C.P..",40,:centre_left)
	_self.asigna_texto_celda(:tbl_poblacion,4,1,"DEL. O MPIO.",40,:centre_left)
	_self.asigna_texto_celda(:tbl_poblacion,5,1,"CENTRAL",40,:centre_left)

	_self.asigna_texto_celda(:tbl_enlace,1,1,"ENLACE",40,:centre_left)
	_self.asigna_texto_celda(:tbl_enlace,1,3,"ANILLO",40,:centre_left)
	_self.asigna_texto_celda(:tbl_enlace,1,5,"PESS",40,:centre_left)
	
	_self.asigna_texto_linea_celda(:tbl_enlace,1,2,"        ",40)
	_self.asigna_texto_linea_celda(:tbl_enlace,1,4,"        ",40)
	_self.asigna_texto_linea_celda(:tbl_enlace,1,6,"        ",40)

	_self.asigna_texto_celda(:tbl_operacion,1,1,"PEP",40,:centre_left)
	_self.asigna_texto_celda(:tbl_operacion,2,1,"OPB",40,:centre_left)
	_self.asigna_texto_celda(:tbl_operacion,3,1,"OE",40,:centre_left)

	_self.asigna_texto_celda(:tbl_operacion,1,3,"REF. SISA",40,:centre_left)
	_self.asigna_texto_celda(:tbl_operacion,2,3,"OEI",40,:centre_left)
	_self.asigna_texto_celda(:tbl_operacion,3,3,"OE",40,:centre_left)
	
	_self.asigna_texto_celda(:tbl_Aprobo,1,1,"PROYECTO",40)
	_self.asigna_texto_celda(:tbl_Aprobo,2,1,"SUPERVISO",40)
	_self.asigna_texto_celda(:tbl_Aprobo,2,3,"FECHA",40)
	_self.asigna_texto_linea_celda(:tbl_Aprobo,1,2,"    ",40)
	_self.asigna_texto_linea_celda(:tbl_Aprobo,2,2,"    ",40)
	_self.asigna_texto_linea_celda(:tbl_Aprobo,2,4,"    ",40)
	
_endmethod
