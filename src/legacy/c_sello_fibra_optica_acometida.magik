_pragma(classify_level=restricted, usage={redefinable})
_method c_sello_fibra_optica_acometida.enum_tipo_empresar

	.oTipoEmpresaR    << hash_table.new()
	.oTipoEmpresaR[1] << "TELMEX"
	.oTipoEmpresaR[2] << "ULTIMA_MILLA"
	.oTipoEmpresaR[3] << "ULTIMA_MILLA_N"	
	_return .oTipoEmpresaR
	
_endmethod
$
_pragma(classify_level=restricted, usage={redefinable})
_method c_sello_fibra_optica_acometida.enum_tipo_empresap

	.oTipoEmpresaP    << hash_table.new()
	.oTipoEmpresaP[1] << "IMTSA"
	.oTipoEmpresaP[2] << "BKTEL"
	.oTipoEmpresaP[3] << "GSP"	
	_return .oTipoEmpresaP
	
_endmethod
$
_pragma(classify_level=restricted, usage={redefinable})
_method c_sello_fibra_optica_acometida.asigna_celdas_a_colorear()

	_local lst_celdas_color << rope.new()

	lst_celdas_color.add({:tbl_Operacion,1,2,.o_color_linea})
	lst_celdas_color.add({:tbl_Operacion,1,4,.o_color_linea})
	
	lst_celdas_color.add({:tbl_Operacion,2,2,.o_color_linea})
	lst_celdas_color.add({:tbl_Operacion,2,4,.o_color_linea})
	
	lst_celdas_color.add({:tbl_Operacion,3,2,.o_color_linea})
	lst_celdas_color.add({:tbl_Operacion,3,4,.o_color_linea})
	
	_return lst_celdas_color
	
_endmethod
$
_pragma(classify_level=advanced, topic={plotting}, usage={subclassable})
_method c_sello_fibra_optica_acometida.asigna_longitud_columnas(po_tabla, pcol_longitud)

	_for n_col, n_long _over pcol_longitud[:col].fast_keys_and_elements()
	_loop
		po_tabla.Columna(n_col).nLongitud << n_long
	_endloop

_endmethod
$
_pragma(classify_level=advanced, topic={plotting}, usage={subclassable})
_method c_sello_fibra_optica_acometida.asigna_tamanios_celda(po_tabla, pn_num_ren, pn_num_col,
							          pcol_tamanio)
	_for n_col _over range(1,pn_num_col)
	_loop
		_for n_ren _over range(1,pn_num_ren)
		_loop
			po_tabla.celda(n_ren,n_col).nTamanio << pcol_tamanio[n_col]
		_endloop
	_endloop
	
_endmethod
$
_pragma(classify_level=advanced, topic={plotting}, usage={subclassable})
_method c_sello_fibra_optica_acometida.asigna_texto_linea_celda(ps_nom_tabla, pn_num_ren,
							       pn_num_col, ps_texto, pn_tamanio)

	o_texto << c_texto_linea_grafico.new(ps_texto)
	o_texto.nTamanio << pn_tamanio

	lo_tabla << .o_tablas.elemento(ps_nom_tabla)
	lo_celda << lo_tabla.oceldas.celda(pn_num_ren,pn_num_col)
	
	lo_celda.oelemento << o_texto
	
_endmethod
$
_pragma(classify_level=restricted, usage={redefinable})
_method c_sello_fibra_optica_acometida.col_tablas

	>> .col_tablas
	
_endmethod
$
_pragma(classify_level=restricted, usage={redefinable})
_method c_sello_fibra_optica_acometida.col_tablas << p_tablas

	.col_tablas << p_tablas
	
_endmethod
