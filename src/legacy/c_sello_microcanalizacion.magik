						    :default_value, _unset ))	

	attribs.add(layout_attribute_definition.new(:suministro_const_radial,     :string,
		                                    :description,     "pvc019mm",
						    :default_value, _unset ))	

	attribs.add(layout_attribute_definition.new(:suministro_const_radial_cepa,     :string,
		                                    :description,     "pvc019mm",
						    :default_value, _unset ))	
	
	>> attribs
	
_endmethod
