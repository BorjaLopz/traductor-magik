		                                    :description,     "Ruta",
						     :default_value, _unset ))

	attribs.add(layout_attribute_definition.new(:opb,     :string,
		                                    :description,     "opb",
						     :default_value, _unset ))

	attribs.add(layout_attribute_definition.new(:oei,     :string,
		                                    :description,     "OEI",
						     :default_value, _unset ))

	attribs.add(layout_attribute_definition.new(:oe,     :string,
		                                    :description,     "OE",
						     :default_value, _unset ))

	attribs.add(layout_attribute_definition.new(:domicilio,     :string,
		                                    :description,     "Dirección",
						    :default_value, _unset ))

	attribs.add(layout_attribute_definition.new(:fecha,     :string,
		                                    :description,     "fecha",
						     :default_value, _unset ))

	attribs.add(layout_attribute_definition.new(:programa,     :string,
		                                    :description,     "programa",
						    :default_value, _unset ))

	# (22/12/27 des_aaron) : totales
	attribs.add(layout_attribute_definition.new(:totales_en_canal_ml,     :string,
		                                    :description,     "canal",
						    :default_value, _unset ))

	attribs.add(layout_attribute_definition.new(:totales_en_canal_dv,     :string,
		                                    :description,     "canal",
						    :default_value, _unset ))



	
	attribs.add(layout_attribute_definition.new(:totales_en_tramo_ml,     :string,
		                                    :description,     "tramo",
						    :default_value, _unset ))

	attribs.add(layout_attribute_definition.new(:totales_en_tramo_dv,     :string,
		                                    :description,     "tramo",
						    :default_value, _unset ))

	
	attribs.add(layout_attribute_definition.new(:totales_en_ruta_ml,     :string,
