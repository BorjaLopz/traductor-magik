c_sello_microcanalizacion.define_shared_constant(:allowed_on_menu?, _false    , :public)
$
_method c_sello_microcanalizacion.defined_attributes

	attribs << rope.new_from (_super.defined_attributes)

	attribs.add(layout_attribute_definition.new(:empreviso, :string,
						    :description, "Empresa que revisa",	    
                                                    :enum_method, :enum_tipo_empresar))

	attribs.add(layout_attribute_definition.new(:telefono, :string,
						    :description, "TELEFONO",
						    :default_value, _unset ))

	attribs.add(layout_attribute_definition.new(:dir_area, :string,
						    :description, "DIRECCION AREA",
						    :default_value, _unset ))
	
	attribs.add(layout_attribute_definition.new(:responsable_area, :string,
						    :description, "RESPONSABLE AREA",
						    :default_value, _unset ))

	attribs.add(layout_attribute_definition.new(:poblacion, :string,
						    :description, "Poblacion",
	                                            :default_value, _unset ))    

	attribs.add(layout_attribute_definition.new(:municipio, :string,
						    :description, "Delegación o Municipio",
						    :default_value, _unset ))
	
	attribs.add(layout_attribute_definition.new(:colonia, :string,
						    :description, "Colonia",
	                                            :default_value, _unset ))    

	attribs.add(layout_attribute_definition.new(:codigo_postal, :string,
						    :description, "Codigo Postal",
						    :default_value, _unset ))

	attribs.add(layout_attribute_definition.new(:calles, :string,
						    :description, "Calles",
						    :default_value, _unset ))

	attribs.add(layout_attribute_definition.new(:dtos_afectados, :string,
						    :description, "Distritros",
						    :default_value, _unset ))

	attribs.add(layout_attribute_definition.new(:pep, :string,
