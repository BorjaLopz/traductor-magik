_package user
$

def_slotted_exemplar(:c_sello_microcanalizacion,
{
#	{:col_tablas,    _unset,  :writable},
	{:o_tramo,       _unset,  :writable},
	{:o_proyecto,    _unset, :writable},
	{:o_area,        _unset,  :writable},
	{:s_tipo_plano,   _unset,  :writable},
	{:otipoempresar,      _unset, :writable}, # catalogo para empresa que revisa
	{:valor_empreviso,    _unset, :writable} # Valor para empresa que revisa

}, {:c_base_sello_fibra} )
