# Ult Mod.
#   12/04/05 DSB se modifico el metodo
#                draw_content_on(RoWindow)
#   11/03/05 18:45 DSB Se modificaron los atributos para que
#                  por defecto unset.
#                  Ya pone imagenes bmp
#   02/03/05 18:45 DSB 
# Reviso.
#    DSB
# Notas:
# El sello se descompone en secciones
#  Seccion     Tablas que lo componen
#     1        Titulo
#              Encabezado
#     2        Tipo_Inventario
#              Resultados
#     3        Totales
#              Aumentos
# -------------- end revision history ---------------

_package user
#remex(:c_sello_observaciones)
$
def_slotted_exemplar(:c_sello_observaciones,
                     {
			    {:oTablas,         _unset}, # almacena las tablas que compoenen el sello
			    {:oCoordOrigen ,   _unset}, # Coord donde inicia el sello
	    		    {:oWindow,         _unset}, # Ventana o canvas en el que se desplegara el sello
	     		    {:bTablas_Creadas, _false}, # Indica si las tablas ya fueron creadas
			    {:nAncho_Sello,     180 },  # ancho en mm del sello
			    {:sTipo_Sello,      "A" }  # Sello que se debe desplegar

		     },
		      :layout_element 
)
$
c_sello_observaciones.define_shared_constant(:allowed_on_menu?, _false, :public)
$
c_sello_observaciones.define_slot_access(:oCoordOrigen,    :writable, :public)
c_sello_observaciones.define_slot_access(:oTablas,         :writable, :public)
c_sello_observaciones.define_slot_access(:bTablas_creadas, :writable, :public)
c_sello_observaciones.define_slot_access(:oWindow,         :writable, :public)
c_sello_observaciones.define_slot_access(:nAncho_Sello,    :writable, :private)
c_sello_observaciones.define_slot_access(:sTipo_Sello,    :writable, :private)
$

_pragma(classify_level=restricted, usage={redefinable})
_method c_sello_observaciones.defined_attributes

## Objetivo: Define los atributos del sello
## Parámetros de entrada: NA
## Parámetros de salida:  NA
## Regresa: NA
## Fecha de última modificación: 24/02/2005
## Autor de la modificación : dsanchez
## Descripción de la modificación: Se documentó		

	attribs << rope.new_from (_super.defined_attributes)

	attribs.add ( layout_attribute_definition.new (	:Num_Ductos, :string,
                   	      	 			:description, "Numero de ductos",
							:allowed_on_properties_page?, _true,
							:default_value, _unset 
						  )
		)

	attribs.add ( layout_attribute_definition.new (	:Colores, :string,
                   	      	 			:description, "Colores",
							:allowed_on_properties_page?, _true,
							:default_value, _unset 
						  )
		)

	attribs.add ( layout_attribute_definition.new (	:Fec_inicio, :string,
                   	      	 			:description, "fecha de inicio",
							:allowed_on_properties_page?, _true,
							:default_value, _unset 
						  )
		)

	attribs.add ( layout_attribute_definition.new (	:Fec_final, :string,
                   	      	 			:description, "fecha final",
							:allowed_on_properties_page?, _true,
							:default_value, _unset 
						  )
		)

	attribs.add ( layout_attribute_definition.new (	:Anio, :string,
                   	      	 			:description, "Anio",
							:allowed_on_properties_page?, _true,
							:default_value, _unset 
						  )
		)

	attribs.add ( layout_attribute_definition.new (	:Ruta, :string,
                   	      	 			:description, "Ruta donde se encuentra el arc bmp",
							:allowed_on_properties_page?, _false,
							:default_value, path << system.getenv("SMALLWORLD_GIS") + "\..\Logos_y_perfiles"
						  )
		)

	attribs.add ( layout_attribute_definition.new (	:sCve_Ruta, :string,
                   	      	 			:description, "Clave de la ruta",
							:allowed_on_properties_page?, _false,
							:default_value, _unset 
						  )
		)

	attribs.add ( layout_attribute_definition.new (	:sCve_tramo, :string,
                   	      	 			:description, "Clave del tramo",
							:allowed_on_properties_page?, _false,
							:default_value, _unset 
						  )
		)


	>> attribs
	
_endmethod
$

_pragma(classify_level=restricted, usage={redefinable})
c_sello_observaciones.define_attributes()

_pragma(classify_level=restricted, usage={redefinable})
_method c_sello_observaciones.draw_content_on(RoWindow)
	
## Objetivo: Manda llamar todos los metodos necesarios para
## dibujar el sello
## Parámetros de entrada:
##   RoWindow - Canvas sobre el cual se dibujara el sello
## Parámetros de salida:  NA
## Regresa: NA
## Fecha de última modificación: 24/02/2005
## Autor de la modificación : dsanchez
## Descripción de la modificación: Se documentó
##  12/04/05 DSB Se valido que no se mande llamar el
##               asigna_enlace cuando el sello sea A	

	_self.oWindow << RoWindow


        # Se crea un objeto de tipo c_proyecto_red para
        # obtener la informacion que se mostrara
        _local LoProy_Red
	_local LoTramo
	
	LoProy_Red << c_proyecto_red.new()
	LoProy_Red.identificador_proyecto("1")
	
	_self.prvAsigna_Direccion_divisional <<  LoProy_Red.Direccion_divisional
	_self.prvAsigna_Domicilio << LoProy_Red.Direccion
	_self.prvAsigna_Responsable << LoProy_Red.Responsable
	_self.prvAsigna_Telefono << LoProy_Red.Tel_Responsable
	_self.prvAsigna_SubDireccion_Divisional << LoProy_Red.SubDireccion
	_self.prvAsigna_Gerencia << LoProy_Red.Gerencia
	_self.prvAsigna_Proyecto << LoProy_Red.empresa_proyecto		
	_self.prvAsigna_Reviso << LoProy_Red.empresa_constructora
	_self.prvAsigna_Superviso << LoProy_Red.supervisor
	_self.prvAsigna_Aprobo << LoProy_Red.aprobo	

	LoTramo << LoProy_Red.obten_tramo(_self.sCve_tramo, _self.sCve_ruta)
	
	_self.prvAsigna_Ruta << LoTramo.sNum_Ruta
	_if _self.sTipo_Sello <> "A"
        _then
	   _self.prvAsigna_Enlace << LoTramo.nombre_ruta
	_endif    
	_self.prvAsigna_Tramo<< LoTramo.nombre

	
	
        _self.prvAsigna_txt_Ren2()
	_self.prvAsigna_txt_Ren8()
	
#	_self.prvAsigna_Direccion_Divisional 	<< "D_D"
#	_self.prvAsigna_SubDireccion_Divisional << "S_D"
#	_self.prvAsigna_Gerencia 		<< "GE"
#	_self.prvAsigna_Responsable 		<< "RES"
#	_self.prvAsigna_Domicilio 		<< "DO"
#	_self.prvAsigna_Telefono 		<< "TE"
#	
#	_self.prvAsigna_Ruta 			<< "RU"
#	_self.prvAsigna_Tramo 			<< "TR"
#	_self.prvAsigna_Enlace 			<< "EN"
#	
#	_self.prvAsigna_Proyecto 		<< "PR"
#	_self.prvAsigna_Reviso 			<< "REV"
#	_self.prvAsigna_Superviso 		<< "SUP"
#	_self.prvAsigna_Aprobo 			<< "AP"

	

	 _self.oTablas.Despliega(RoWindow)
	 
_endmethod
$

_pragma(classify_level=advanced, topic={plotting}, usage={subclassable})
_method c_sello_observaciones.post_initialisation ()

## Objetivo: Acciones que se realizan despues de crear la
## instancia 
## Parámetros de entrada: NA
## Parámetros de salida:  NA
## Regresa: NA
## Fecha de última modificación: 04/02/05
## Autor de la modificación : dsanchez
## Descripción de la modificación: Se creo


        _self.inicializa(coordinate.new(0,0))


_endmethod
$

_pragma(classify_level=restricted, usage={redefinable})
_method c_sello_observaciones.inicializa(_optional RoCoord)

## Objetivo: Manda llamar todos los metodos necesarios para
## crear el sello 
## Parámetros de entrada:
##   RoCoord - Coordenada donde debe iniciar a dibujar la tabla	
## Parámetros de salida:  NA
## Regresa: NA
## Fecha de última modificación: 24/02/2005
## Autor de la modificación : dsanchez
## Descripción de la modificación: Se documentó	
	
	# Configuracion del sello transparente
	_self.set_fill_colour(_unset )
	
	#-----------------------------------------------------------
	#Se Inicializa la coordenada de origen
	#-----------------------------------------------------------
	_if RoCoord _is _unset 
	_then
		RoCoord << coordinate.new(0,0)
	_endif

	_self.oCoordOrigen << RoCoord
	
	# se pasa como parametro el layout
	# Crea el objeto que contiene todas las tablas del sello estandar
	_self.oTablas << c_tablas.new(_self)

	#Crea y configura cada una de las tablas 
	_self.prvCreaCfgTablas(RoCoord)

	#Se conoce el area de la tabla dibujada
        LoArea << _self.oTablas.area_total()

	#Se ajustan los limites del layout de acuerdo  a las tablas definidas
	_self.bounds << LoArea

	#Crea a los objetos que tendra c/u de las tablas
	_self.prvCrea_Asigna_Obj_A_Celdas()

	#Indica que los objetos tabla ya fueron creados 
	_self.bTablas_creadas << _true
	
_endmethod
$

_pragma(classify_level=restricted, usage={redefinable})
_private _method c_sello_observaciones.prvCreaCfgTablas(RoCoord)

## Objetivo: Manda llamar lso metodos que crean y configuran
## las tablas que compoenen el sello
## Parámetros de entrada:
##   RoCoord - Coordenada donde debe iniciar a dibujar la tabla	
## Parámetros de salida:  NA
## Regresa: NA
## Fecha de última modificación: 24/02/2005
## Autor de la modificación : dsanchez
## Descripción de la modificación: Se documentó		

	_local LnDesY # Desplazamiento en y de cada una de las secciones
	
	LnDesY << _self.prvCreaCfgTbl_Seccion1(RoCoord)

        LoCoord << coordinate.new(RoCoord.x , RoCoord.y - LnDesY)
	LnDesY << LnDesY + _self.prvCreaCfgTbl_Seccion2(LoCoord)

        LoCoord << coordinate.new(RoCoord.x , RoCoord.y - LnDesY)
	LnDesY << _self.prvCreaCfgTbl_Seccion3(LoCoord)

        LoCoord << coordinate.new(LoCoord.x , LoCoord.y - LnDesY)
	_self.prvCreaCfgTbl_Seccion4(LoCoord)

_endmethod
$

_pragma(classify_level=restricted, usage={redefinable})
_private _method c_sello_observaciones.PrvCreaCfgTbl_Seccion1(RoCoord)

## Objetivo: Crea y configura las tablas que componen la
## seccion 1
## Parámetros de entrada:
##   RoCoord - Coordenada donde debe iniciar a dibujar la tabla	
## Parámetros de salida:  NA
## Regresa: NA
## Fecha de última modificación: 24/02/2005
## Autor de la modificación : dsanchez
## Descripción de la modificación: Se documentó	
	
	_local LoTabla     # Almacena la tabla con la que se esta trabajado
	_local LnRenglones # Numero de renglones que contendra la tabla 
	_local LnColumnas  # Numero de columnas que contendra la tabla
	_local LnDesX      # Desplazamineto en X de la tabla 
	_local LnDesY      # desplazamiento en Y de la tabla

	
	#-----------------------------------------------------------
	#Tabla Observaciones
	#-----------------------------------------------------------
	LnRenglones << 2
	lnColumnas  << 1
	LoTabla << _self.oTablas.crea_tabla(LnRenglones,LnColumnas,:tbl_Observaciones)

	#Coordenada donde iniciara la tabla
	LoTabla.oCoordenada_Origen << RoCoord

	LoTabla.bDibuja_bordes? << _true
	LoTabla.bDibuja_Columnas_Internas?  << _true
	LoTabla.bDibuja_Renglones_Internos? << _true

	
	#longitudes de los renglones de la tabla, esta dada en mm 
	LoTabla.oRenglones.elemento(1).nLongitud <<  11
	LoTabla.oRenglones.elemento(2).nLongitud <<   5 	
	LoTabla.oColumnas.elemento(1).nLongitud  << _self.nAncho_sello


	LoCelda << LoTabla.oCeldas.Celda(2,1).oElementos.obten_elemento(:bordes_celda)
	LoCelda.bBorde_inf? << _false

	#-----------------------------------------------------------
	#Tabla Ren 1
	#-----------------------------------------------------------
	LnRenglones << 1
	lnColumnas  << 2
	LoTabla << _self.oTablas.crea_tabla(LnRenglones,LnColumnas,:tbl_Ren1)


        LnDesY << _self.oTablas.Longitud_total_Renglones({:tbl_Observaciones})
	
	#Coordenada donde iniciara la tabla
	LoTabla.oCoordenada_Origen << coordinate.new(RoCoord.x , RoCoord.y - LnDesY)

	LoTabla.bDibuja_bordes? << _false
	LoTabla.bDibuja_Columnas_Internas?  << _false
	LoTabla.bDibuja_Renglones_Internos? << _false

	
	#longitudes de los renglones de la tabla, esta dada en mm 
	LoTabla.oRenglones.elemento(1).nLongitud <<   3
	LoTabla.oColumnas.elemento(1).nLongitud  <<   9
	LoTabla.oColumnas.elemento(2).nLongitud  << _self.nAncho_Sello - 9


	LoCelda << LoTabla.oCeldas.Celda(1,1).oElementos.obten_elemento(:bordes_celda)
	LoCelda.bBorde_izq? << _true

	LoCelda << LoTabla.oCeldas.Celda(1,2).oElementos.obten_elemento(:bordes_celda)
	LoCelda.bBorde_der? << _true

	#-----------------------------------------------------------
	#Tabla Ren 2
	#-----------------------------------------------------------
	LnRenglones << 2
	LnColumnas  << 2
	LoTabla << _self.oTablas.crea_tabla(LnRenglones,LnColumnas,:tbl_Ren2)


        LnDesY << LnDesY + _self.oTablas.Longitud_total_Renglones({:tbl_ren1})
	
	#Coordenada donde iniciara la tabla
	LoTabla.oCoordenada_Origen << coordinate.new(RoCoord.x , RoCoord.y - LnDesY)

	LoTabla.bDibuja_bordes? << _false
	LoTabla.bDibuja_Columnas_Internas?  << _false
	LoTabla.bDibuja_Renglones_Internos? << _false

	_self.prvCfgRenglon(LoTabla, LnRenglones)
	
	#-----------------------------------------------------------
	#Tabla Ren 3
	#-----------------------------------------------------------
	LnRenglones << 4
	LnColumnas  << 2
	LoTabla << _self.oTablas.crea_tabla(LnRenglones,LnColumnas,:tbl_Ren3)


        LnDesY << LnDesY + _self.oTablas.Longitud_total_Renglones({:tbl_ren2})
	
	#Coordenada donde iniciara la tabla
	LoTabla.oCoordenada_Origen << coordinate.new(RoCoord.x , RoCoord.y - LnDesY)

	LoTabla.bDibuja_bordes? << _false
	LoTabla.bDibuja_Columnas_Internas?  << _false
	LoTabla.bDibuja_Renglones_Internos? << _false

	_self.prvCfgRenglon(LoTabla, LnRenglones)

	#-----------------------------------------------------------
	#Tabla Ren 4
	#-----------------------------------------------------------
	LnRenglones << 2
	LnColumnas  << 2
	LoTabla << _self.oTablas.crea_tabla(LnRenglones,LnColumnas,:tbl_Ren4)


        LnDesY << LnDesY + _self.oTablas.Longitud_total_Renglones({:tbl_ren3})
	
	#Coordenada donde iniciara la tabla
	LoTabla.oCoordenada_Origen << coordinate.new(RoCoord.x , RoCoord.y - LnDesY)

	LoTabla.bDibuja_bordes? << _false
	LoTabla.bDibuja_Columnas_Internas?  << _false
	LoTabla.bDibuja_Renglones_Internos? << _false

	_self.prvCfgRenglon(LoTabla, LnRenglones)

	#-----------------------------------------------------------
	#Tabla Ren 5
	#-----------------------------------------------------------
	LnRenglones << 2
	LnColumnas  << 2
	LoTabla << _self.oTablas.crea_tabla(LnRenglones,LnColumnas,:tbl_Ren5)


        LnDesY << LnDesY + _self.oTablas.Longitud_total_Renglones({:tbl_ren4})
	
	#Coordenada donde iniciara la tabla
	LoTabla.oCoordenada_Origen << coordinate.new(RoCoord.x , RoCoord.y - LnDesY)

	LoTabla.bDibuja_bordes? << _false
	LoTabla.bDibuja_Columnas_Internas?  << _false
	LoTabla.bDibuja_Renglones_Internos? << _false

	_self.prvCfgRenglon(LoTabla, LnRenglones)

	#-----------------------------------------------------------
	#Tabla Ren 6
	#-----------------------------------------------------------
	LnRenglones << 2
	LnColumnas  << 2
	LoTabla << _self.oTablas.crea_tabla(LnRenglones,LnColumnas,:tbl_Ren6)


        LnDesY << LnDesY + _self.oTablas.Longitud_total_Renglones({:tbl_ren5})
	
	#Coordenada donde iniciara la tabla
	LoTabla.oCoordenada_Origen << coordinate.new(RoCoord.x , RoCoord.y - LnDesY)

	LoTabla.bDibuja_bordes? << _false
	LoTabla.bDibuja_Columnas_Internas?  << _false
	LoTabla.bDibuja_Renglones_Internos? << _false

	_self.prvCfgRenglon(LoTabla, LnRenglones)

	
	#-----------------------------------------------------------
	#Tabla Ren 7
	#-----------------------------------------------------------
	LnRenglones << 2
	LnColumnas  << 2
	LoTabla << _self.oTablas.crea_tabla(LnRenglones,LnColumnas,:tbl_Ren7)


        LnDesY << LnDesY + _self.oTablas.Longitud_total_Renglones({:tbl_ren6})
	
	#Coordenada donde iniciara la tabla
	LoTabla.oCoordenada_Origen << coordinate.new(RoCoord.x , RoCoord.y - LnDesY)

	_self.prvCfgRenglon(LoTabla, LnRenglones)


	#-----------------------------------------------------------
	#Tabla Ren 8
	#-----------------------------------------------------------
	LnRenglones << 2
	LnColumnas  << 2
	LoTabla << _self.oTablas.crea_tabla(LnRenglones,LnColumnas,:tbl_Ren8)


        LnDesY << LnDesY + _self.oTablas.Longitud_total_Renglones({:tbl_ren7})
	
	#Coordenada donde iniciara la tabla
	LoTabla.oCoordenada_Origen << coordinate.new(RoCoord.x , RoCoord.y - LnDesY)

	_self.prvCfgRenglon(LoTabla, LnRenglones)

        LnDesY << LnDesY + _self.oTablas.Longitud_total_Renglones({:tbl_ren8})

	_return  LnDesY
_endmethod
$

_pragma(classify_level=restricted, usage={redefinable})
_private _method c_sello_observaciones.PrvCreaCfgTbl_Seccion2(RoCoord)

## Objetivo: Crea y configura las tablas que componen la
## seccion 2
## Parámetros de entrada:
##   RoCoord - Coordenada donde debe iniciar a dibujar la tabla	
## Parámetros de salida:  NA
## Regresa: NA
## Fecha de última modificación: 24/02/2005
## Autor de la modificación : dsanchez
## Descripción de la modificación: Se documentó	
	
	_local LoTabla     # Almacena la tabla con la que se esta trabajado
	_local LnRenglones # Numero de renglones que contendra la tabla 
	_local LnColumnas  # Numero de columnas que contendra la tabla
	_local LnDesX      # Desplazamineto en X de la tabla 
	_local LnDesY      # desplazamiento en Y de la tabla

	#-----------------------------------------------------------
	#Tabla Informacion confidencial
	#-----------------------------------------------------------
	LnRenglones << 3
	lnColumnas  << 1
	LoTabla << _self.oTablas.crea_tabla(LnRenglones,LnColumnas,:tbl_infor_confidencial)

	#Coordenada donde iniciara la tabla
	LoTabla.oCoordenada_Origen << RoCoord

	LoTabla.bDibuja_bordes? << _false   
	LoTabla.bDibuja_Columnas_Internas?  << _false
	LoTabla.bDibuja_Renglones_Internos? << _false

	
	#longitudes de los renglones de la tabla, esta dada en mm 
	LoTabla.oRenglones.elemento(1).nLongitud <<  27 #25
	LoTabla.oRenglones.elemento(2).nLongitud <<  12 #10
	LoTabla.oRenglones.elemento(3).nLongitud <<  25 #24		
	LoTabla.oColumnas.elemento(1).nLongitud  << _self.nAncho_sello


	LoCelda << LoTabla.oCeldas.Celda(1,1).oElementos.obten_elemento(:bordes_celda)
	LoCelda.bBorde_izq? << _true
	LoCelda.bBorde_der? << _true

	LoCelda << LoTabla.oCeldas.Celda(2,1).oElementos.obten_elemento(:bordes_celda)
	LoCelda.bBorde_izq? << _true
	LoCelda.bBorde_der? << _true
	
	LoCelda << LoTabla.oCeldas.Celda(3,1).oElementos.obten_elemento(:bordes_celda)
	LoCelda.bBorde_izq? << _true
	LoCelda.bBorde_der? << _true

	#-----------------------------------------------------------
	#Tabla Ruta
	#-----------------------------------------------------------

        LnDesY << _self.oTablas.Longitud_total_Renglones({:tbl_infor_confidencial})
        LoCoord << coordinate.new(RoCoord.x , RoCoord.y - LnDesY)

	_if _self.sTipo_sello = "A"
	_then
 	   _self.prvCreaCfgTabla_RutaA(LoCoord)
	   
           LnDesY << LnDesY +  _self.oTablas.Longitud_total_Renglones({:tbl_ruta})
           LoCoord << coordinate.new(RoCoord.x , RoCoord.y - LnDesY)
	   
	   _self.prvCreaCfgTabla_DireccionA(LoCoord)
	_else
	   _self.prvCreaCfgTabla_RutaB(LoCoord)

           LnDesY << LnDesY +  _self.oTablas.Longitud_total_Renglones({:tbl_ruta})
           LoCoord << coordinate.new(RoCoord.x , RoCoord.y - LnDesY)
	   
	   _self.prvCreaCfgTabla_DireccionB(LoCoord)	   
	_endif

        LnDesY << LnDesY + _self.oTablas.Longitud_total_Renglones({:tbl_Direccion})

	_return  LnDesY
	
_endmethod 
$


_pragma(classify_level=restricted, usage={redefinable})
_private _method c_sello_observaciones.PrvCreaCfgTbl_Seccion3(RoCoord)

## Objetivo: Crea y configura las tablas que componen la
## seccion 3
## Parámetros de entrada:
##   RoCoord - Coordenada donde debe iniciar a dibujar la tabla	
## Parámetros de salida:  NA
## Regresa: NA
## Fecha de última modificación: 24/02/2005
## Autor de la modificación : dsanchez
## Descripción de la modificación: Se documentó	
	
	_local LoTabla     # Almacena la tabla con la que se esta trabajado
	_local LnRenglones # Numero de renglones que contendra la tabla 
	_local LnColumnas  # Numero de columnas que contendra la tabla
	_local LnDesX      # Desplazamineto en X de la tabla 
	_local LnDesY      # desplazamiento en Y de la tabla

	#-----------------------------------------------------------
	#Tabla Autorizo
	#-----------------------------------------------------------
	LnRenglones << 2
	lnColumnas  << 4
	LoTabla << _self.oTablas.crea_tabla(LnRenglones,LnColumnas,:tbl_Autorizo)

	#Coordenada donde iniciara la tabla
	LoTabla.oCoordenada_Origen << RoCoord

	LoTabla.bDibuja_bordes? << _true 
	LoTabla.bDibuja_Columnas_Internas?  << _true 
	LoTabla.bDibuja_Renglones_Internos? << _true 

	
	#longitudes de los renglones de la tabla, esta dada en mm 
	LoTabla.oRenglones.elemento(1).nLongitud <<  18
	LoTabla.oRenglones.elemento(2).nLongitud <<   5

	LoTabla.oColumnas.elemento(1).nLongitud  <<  40
	LoTabla.oColumnas.elemento(2).nLongitud  << _self.nAncho_sello - (40 + 26 + 24)
	LoTabla.oColumnas.elemento(3).nLongitud  <<  26
	LoTabla.oColumnas.elemento(4).nLongitud  <<  24


	#-----------------------------------------------------------
	#Tabla Simbolo izq
	#-----------------------------------------------------------

        LnDesY << _self.oTablas.Longitud_total_Renglones({:tbl_autorizo})
        LoCoord << coordinate.new(RoCoord.x , RoCoord.y - LnDesY)

	LnRenglones << 1
	LnColumnas  << 1
	LoTabla << _self.oTablas.crea_tabla(LnRenglones,LnColumnas,:tbl_Simbolo_Izq)

	#Coordenada donde iniciara la tabla
	LoTabla.oCoordenada_Origen << LoCoord

	LoTabla.bDibuja_bordes? << _true 
	LoTabla.bDibuja_Columnas_Internas?  << _true 
	LoTabla.bDibuja_Renglones_Internos? << _true 

	
	#longitudes de los renglones de la tabla, esta dada en mm 
	LoTabla.oRenglones.elemento(1).nLongitud <<  41
	LoTabla.oColumnas.elemento(1).nLongitud  <<  40

	#-----------------------------------------------------------
	#Tabla Tramo
	#-----------------------------------------------------------

        LnDesX << _self.oTablas.Longitud_total_Columnas({:tbl_Simbolo_izq})
        LoCoord << coordinate.new(RoCoord.x + LnDesX, RoCoord.y - LnDesY)
	
	LnRenglones << 2
	LnColumnas  << 2
	LoTabla << _self.oTablas.crea_tabla(LnRenglones,LnColumnas,:tbl_Tramo)	

	#Coordenada donde iniciara la tabla
	LoTabla.oCoordenada_Origen << LoCoord

	LoTabla.bDibuja_bordes? << _true 
	LoTabla.bDibuja_Columnas_Internas?  << _false   
	LoTabla.bDibuja_Renglones_Internos? << _true 

	
	#longitudes de los renglones de la tabla, esta dada en mm 
	LoTabla.oRenglones.elemento(1).nLongitud <<  11
	LoTabla.oRenglones.elemento(2).nLongitud <<  11
	
	LoTabla.oColumnas.elemento(1).nLongitud  <<  15
	# los dos 40 son por las figuras (izq, der)
	LoTabla.oColumnas.elemento(2).nLongitud  <<  _self.nAncho_sello - (15 + 40 + 50)
	

	#-----------------------------------------------------------
	#Tabla Kilometros
	#-----------------------------------------------------------

	# el desplazamineto en X debe serel mismo que la tabla anterior
	
	LnDesY << LnDesY + _self.oTablas.Longitud_total_Renglones({:tbl_Tramo})
        LoCoord << coordinate.new(RoCoord.x + LnDesX, RoCoord.y - LnDesY)
	
	LnRenglones << 3
	LnColumnas  << 4
	LoTabla << _self.oTablas.crea_tabla(LnRenglones,LnColumnas,:tbl_Kilometros)	

	#Coordenada donde iniciara la tabla
	LoTabla.oCoordenada_Origen << LoCoord

	LoTabla.bDibuja_bordes? << _true 
	LoTabla.bDibuja_Columnas_Internas?  << _false   
	LoTabla.bDibuja_Renglones_Internos? << _false  

	
	#longitudes de los renglones de la tabla, esta dada en mm 
	LoTabla.oRenglones.elemento(1).nLongitud <<  4
	LoTabla.oRenglones.elemento(2).nLongitud <<  4
	LoTabla.oRenglones.elemento(3).nLongitud <<  4	
	
	LoTabla.oColumnas.elemento(1).nLongitud  << 20
	LoTabla.oColumnas.elemento(2).nLongitud  << 30
	LoTabla.oColumnas.elemento(3).nLongitud  <<  5
	LoTabla.oColumnas.elemento(4).nLongitud  << _self.nAncho_sello - (40 + 20 + 30 + 5 + 50)

	LoCelda << LoTabla.oCeldas.Celda(1,2).oElementos.obten_elemento(:bordes_celda)
	LoCelda.bBorde_inf? << _true
	LoCelda << LoTabla.oCeldas.Celda(2,2).oElementos.obten_elemento(:bordes_celda)
	LoCelda.bBorde_inf? << _true

	LoCelda << LoTabla.oCeldas.Celda(1,4).oElementos.obten_elemento(:bordes_celda)
	LoCelda.bBorde_inf? << _true
	LoCelda << LoTabla.oCeldas.Celda(2,4).oElementos.obten_elemento(:bordes_celda)
	LoCelda.bBorde_inf? << _true
	
	#-----------------------------------------------------------
	#Tabla DEF_PEP
	#-----------------------------------------------------------

	# el desplazamineto en X debe serel mismo que la tabla anterior
	
	LnDesY << LnDesY + _self.oTablas.Longitud_total_Renglones({:tbl_Kilometros})
        LoCoord << coordinate.new(RoCoord.x + LnDesX, RoCoord.y - LnDesY)
	
	LnRenglones << 1
	LnColumnas  << 2
	LoTabla << _self.oTablas.crea_tabla(LnRenglones,LnColumnas,:tbl_DEF_PEP)	

	#Coordenada donde iniciara la tabla
	LoTabla.oCoordenada_Origen << LoCoord

	LoTabla.bDibuja_bordes? << _true 
	LoTabla.bDibuja_Columnas_Internas?  << _false  
	LoTabla.bDibuja_Renglones_Internos? << _false  

	
	#longitudes de los renglones de la tabla, esta dada en mm 
	LoTabla.oRenglones.elemento(1).nLongitud << 7
	
	LoTabla.oColumnas.elemento(1).nLongitud  << 15
	LoTabla.oColumnas.elemento(2).nLongitud  << _self.nAncho_sello - (40 + 15 + 50)
	
	#-----------------------------------------------------------
	#Tabla Simbolo der
	#-----------------------------------------------------------

        LnDesX << LnDesX + _self.oTablas.Longitud_total_Columnas({:tbl_Tramo})
        LnDesY << _self.oTablas.Longitud_total_Renglones({:tbl_autorizo})

	write("tramo")
	write(LnDesY)
	
        LoCoord << coordinate.new(RoCoord.x + LnDesX , RoCoord.y - LnDesY)

	LnRenglones << 1
	LnColumnas  << 1
	LoTabla << _self.oTablas.crea_tabla(LnRenglones,LnColumnas,:tbl_Simbolo_Der)

	#Coordenada donde iniciara la tabla
	LoTabla.oCoordenada_Origen << LoCoord

	LoTabla.bDibuja_bordes? << _true 
	LoTabla.bDibuja_Columnas_Internas?  << _true 
	LoTabla.bDibuja_Renglones_Internos? << _true 

	
	#longitudes de los renglones de la tabla, esta dada en mm 
	LoTabla.oRenglones.elemento(1).nLongitud <<  41
	LoTabla.oColumnas.elemento(1).nLongitud  <<  50

	
        LnDesY << LnDesY + _self.oTablas.Longitud_total_Renglones({:tbl_Simbolo_Der})
	write("Sim der")
	write(LnDesY)
	
	_return  LnDesY
	
_endmethod 
$

_pragma(classify_level=restricted, usage={redefinable})
_private _method c_sello_observaciones.PrvCreaCfgTbl_Seccion4(RoCoord)

## Objetivo: Crea y configura las tablas que componen la
## seccion 3
## Parámetros de entrada:
##   RoCoord - Coordenada donde debe iniciar a dibujar la tabla	
## Parámetros de salida:  NA
## Regresa: NA
## Fecha de última modificación: 03/03/2005
## Autor de la modificación : dsanchez
## Descripción de la modificación: Se documentó	
	
	_local LoTabla     # Almacena la tabla con la que se esta trabajado
	_local LnRenglones # Numero de renglones que contendra la tabla 
	_local LnColumnas  # Numero de columnas que contendra la tabla
	_local LnDesX      # Desplazamineto en X de la tabla 
	_local LnDesY      # desplazamiento en Y de la tabla

	#-----------------------------------------------------------
	#Tabla Proyecto
	#-----------------------------------------------------------
	LnRenglones << 4
	lnColumnas  << 2
	LoTabla << _self.oTablas.crea_tabla(LnRenglones,LnColumnas,:tbl_proyecto)

	#Coordenada donde iniciara la tabla
	LoTabla.oCoordenada_Origen << RoCoord

	LoTabla.bDibuja_bordes? << _true 
	LoTabla.bDibuja_Columnas_Internas?  << _true 
	LoTabla.bDibuja_Renglones_Internos? << _true 

	
	#longitudes de los renglones de la tabla, esta dada en mm 
	LoTabla.oRenglones.elemento(1).nLongitud <<   4
	LoTabla.oRenglones.elemento(2).nLongitud <<   5
	LoTabla.oRenglones.elemento(3).nLongitud <<   5
	LoTabla.oRenglones.elemento(4).nLongitud <<   7	

	LoTabla.oColumnas.elemento(1).nLongitud  <<  20
	LoTabla.oColumnas.elemento(2).nLongitud  <<  20

	#-----------------------------------------------------------
	#Tabla fecha
	#-----------------------------------------------------------
	LnRenglones << 2
	lnColumnas  << 1
	LoTabla << _self.oTablas.crea_tabla(LnRenglones,LnColumnas,:tbl_fecha)

	#Coordenada donde iniciara la tabla
        LnDesX << _self.oTablas.Longitud_total_Columnas({:tbl_proyecto})
#        LnDesY << _self.oTablas.Longitud_total_Renglones({:tbl_autorizo})
	LoTabla.oCoordenada_Origen << coordinate.new(RoCoord.x + LnDesX, RoCoord.y)

	LoTabla.bDibuja_bordes? << _true 
	LoTabla.bDibuja_Columnas_Internas?  << _true 
	LoTabla.bDibuja_Renglones_Internos? << _true 

	
	#longitudes de los renglones de la tabla, esta dada en mm 
	LoTabla.oRenglones.elemento(1).nLongitud <<   4
	LoTabla.oRenglones.elemento(2).nLongitud <<   5


	LoTabla.oColumnas.elemento(1).nLongitud  <<  40

	#-----------------------------------------------------------
	#Tabla Escala
	#-----------------------------------------------------------
	LnRenglones << 2
	lnColumnas  << 2
	LoTabla << _self.oTablas.crea_tabla(LnRenglones,LnColumnas,:tbl_Escala)

	#Coordenada donde iniciara la tabla
        LnDesX << _self.oTablas.Longitud_total_Columnas({:tbl_proyecto})
        LnDesY << _self.oTablas.Longitud_total_Renglones({:tbl_fecha})

	LoTabla.oCoordenada_Origen << coordinate.new(RoCoord.x + LnDesX, RoCoord.y - LnDesY)

	LoTabla.bDibuja_bordes? << _true 
	LoTabla.bDibuja_Columnas_Internas?  << _true 
	LoTabla.bDibuja_Renglones_Internos? << _true 

	
	#longitudes de los renglones de la tabla, esta dada en mm 
	LoTabla.oRenglones.elemento(1).nLongitud <<   5
	LoTabla.oRenglones.elemento(2).nLongitud <<   7


	LoTabla.oColumnas.elemento(1).nLongitud  <<  20
	LoTabla.oColumnas.elemento(2).nLongitud  <<  20


	#-----------------------------------------------------------
	#Tabla Revision
	#-----------------------------------------------------------
	LnRenglones << 2
	lnColumnas  << 2
	LoTabla << _self.oTablas.crea_tabla(LnRenglones,LnColumnas,:tbl_Revision)

	#Coordenada donde iniciara la tabla
        LnDesX << LnDesX + _self.oTablas.Longitud_total_Columnas({:tbl_fecha})
#        LnDesY << _self.oTablas.Longitud_total_Renglones({:tbl_fecha})

	LoTabla.oCoordenada_Origen << coordinate.new(RoCoord.x + LnDesX, RoCoord.y )

	LoTabla.bDibuja_bordes? << _true 
	LoTabla.bDibuja_Columnas_Internas?  << _true 
	LoTabla.bDibuja_Renglones_Internos? << _true 

	
	#longitudes de los renglones de la tabla, esta dada en mm 
	LoTabla.oRenglones.elemento(1).nLongitud <<   4
	LoTabla.oRenglones.elemento(2).nLongitud <<   5


	LoTabla.oColumnas.elemento(1).nLongitud <<  25
	LoTabla.oColumnas.elemento(2).nLongitud << _self.nAncho_sello - (40 + 40 + 25 + 50)


	#-----------------------------------------------------------
	#Tabla Plano
	#-----------------------------------------------------------
	LnRenglones << 2
	lnColumnas  << 3
	LoTabla << _self.oTablas.crea_tabla(LnRenglones,LnColumnas,:tbl_Plano)

	#Coordenada donde iniciara la tabla
	#        LnDesX << LnDesX + _self.oTablas.Longitud_total_Columnas({:tbl_fecha})
        LnDesY << _self.oTablas.Longitud_total_Renglones({:tbl_fecha})

	LoTabla.oCoordenada_Origen << coordinate.new(RoCoord.x + LnDesX, RoCoord.y - LnDesY)

	LoTabla.bDibuja_bordes? << _true 
	LoTabla.bDibuja_Columnas_Internas?  << _false  
	LoTabla.bDibuja_Renglones_Internos? << _true 

	
	#longitudes de los renglones de la tabla, esta dada en mm 
	LoTabla.oRenglones.elemento(1).nLongitud <<   5
	LoTabla.oRenglones.elemento(2).nLongitud <<   7


	LoTabla.oColumnas.elemento(1).nLongitud  <<  20
	LoTabla.oColumnas.elemento(2).nLongitud  <<  _self.nAncho_sello - (40 + 40 + 20 + 20 + 50)
#	LoTabla.oColumnas.elemento(2).nLongitud  <<  15
#	LoTabla.oColumnas.elemento(3).nLongitud  <<  _self.nAncho_sello - (40 + 40 + 20 + 15 + 50)
	LoTabla.oColumnas.elemento(3).nLongitud  <<  20

	#-----------------------------------------------------------
	#Tabla Aprobacion
	#-----------------------------------------------------------
	LnRenglones << 3
	lnColumnas  << 3
	LoTabla << _self.oTablas.crea_tabla(LnRenglones,LnColumnas,:tbl_Aprobacion)

	#Coordenada donde iniciara la tabla
	LnDesX << LnDesX + _self.oTablas.Longitud_total_Columnas({:tbl_revision})
        #LnDesY << _self.oTablas.Longitud_total_Renglones({:tbl_fecha})

	LoTabla.oCoordenada_Origen << coordinate.new(RoCoord.x + LnDesX, RoCoord.y )

	LoTabla.bDibuja_bordes? << _true 
	LoTabla.bDibuja_Columnas_Internas?  << _true 
	LoTabla.bDibuja_Renglones_Internos? << _true 

	
	#longitudes de los renglones de la tabla, esta dada en mm 
	LoTabla.oRenglones.elemento(1).nLongitud <<   4
	LoTabla.oRenglones.elemento(2).nLongitud <<   5
	LoTabla.oRenglones.elemento(3).nLongitud <<  12 	


	LoTabla.oColumnas.elemento(1).nLongitud  <<  17
	LoTabla.oColumnas.elemento(2).nLongitud  <<  17
	LoTabla.oColumnas.elemento(3).nLongitud  <<  16

	LoCelda << LoTabla.oCeldas.Celda(1,1).oElementos.obten_elemento(:bordes_celda)
	LoCelda.bBorde_der? << _false
	LoCelda << LoTabla.oCeldas.Celda(1,2).oElementos.obten_elemento(:bordes_celda)
	LoCelda.bBorde_izq? << _false
	LoCelda.bBorde_der? << _false		
	LoCelda << LoTabla.oCeldas.Celda(1,3).oElementos.obten_elemento(:bordes_celda)	
	LoCelda.bBorde_izq? << _false	

	
_endmethod 

_pragma(classify_level=restricted, usage={redefinable})
_private _method c_sello_observaciones.prvCreaCfgTabla_RutaA(PoCoord)

## Objetivo: Crea y configura las tabla ruta para cuando el
## tipo de sello es A
## seccion 1
## Parámetros de entrada:
##   RoCoord - Coordenada donde debe iniciar a dibujar la tabla	
## Parámetros de salida:  NA
## Regresa: NA
## Fecha de última modificación: 24/02/2005
## Autor de la modificación : dsanchez
## Descripción de la modificación: Se documentó	
	
	LnRenglones << 2
	LnColumnas  << 2
	LoTabla << _self.oTablas.crea_tabla(LnRenglones,LnColumnas,:tbl_Ruta)


	#Coordenada donde iniciara la tabla
	LoTabla.oCoordenada_Origen << PoCoord

	LoTabla.bDibuja_bordes? << _false 
	LoTabla.bDibuja_Columnas_Internas?  << _false 
	LoTabla.bDibuja_Renglones_Internos? << _false 

	
	#longitudes de los renglones de la tabla, esta dada en mm 
	LoTabla.oRenglones.elemento(1).nLongitud <<   7
	LoTabla.oRenglones.elemento(2).nLongitud <<   8
	LoTabla.oColumnas.elemento(1).nLongitud  <<  40
	LoTabla.oColumnas.elemento(2).nLongitud  << _self.nAncho_Sello - 40


	# activa los bordes exteriores de la celda para formar el marco
	# del sello
	LoCelda << LoTabla.oCeldas.Celda(1,1).oElementos.obten_elemento(:bordes_celda)
	LoCelda.bBorde_izq? << _true
	LoCelda << LoTabla.oCeldas.Celda(2,1).oElementos.obten_elemento(:bordes_celda)
	LoCelda.bBorde_Izq? << _true
	
	LoCelda << LoTabla.oCeldas.Celda(1,LnColumnas).oElementos.obten_elemento(:bordes_celda)
	LoCelda.bBorde_Der? << _true
	LoCelda << LoTabla.oCeldas.Celda(2,LnColumnas).oElementos.obten_elemento(:bordes_celda)
	LoCelda.bBorde_Der? << _true	
	
_endmethod
$

_pragma(classify_level=restricted, usage={redefinable})
_private _method c_sello_observaciones.prvCreaCfgTabla_DireccionA(RoCoord)

## Objetivo: Crea y configura las tabla ruta para cuando el
## tipo de sello es A
## seccion 1
## Parámetros de entrada:
##   RoCoord - Coordenada donde debe iniciar a dibujar la tabla	
## Parámetros de salida:  NA
## Regresa: NA
## Fecha de última modificación: 24/02/2005
## Autor de la modificación : dsanchez
## Descripción de la modificación: Se documentó	
	
	LnRenglones << 6
	LnColumnas  << 2
	LoTabla << _self.oTablas.crea_tabla(LnRenglones,LnColumnas,:tbl_Direccion)


	#Coordenada donde iniciara la tabla
	LoTabla.oCoordenada_Origen << RoCoord

	LoTabla.bDibuja_bordes? << _true
	LoTabla.bDibuja_Columnas_Internas?  << _false 
	LoTabla.bDibuja_Renglones_Internos? << _false 

	
	#longitudes de los renglones de la tabla, esta dada en mm
	_for LnNumRen  _over  range(1,LnRenglones)
	_loop
	   LoTabla.oRenglones.elemento(LnNumRen).nLongitud <<  5
	_endloop


	LoTabla.oColumnas.elemento(1).nLongitud  <<  40
	LoTabla.oColumnas.elemento(2).nLongitud  << _self.nAncho_Sello - 40


	# activa los bordes exteriores de la celda para formar el marco
	# del sello
	_for LnNumRen  _over  range(1,LnRenglones)
	_loop
	   LoCelda << LoTabla.oCeldas.Celda(LnNumRen,1).oElementos.obten_elemento(:bordes_celda)
	   LoCelda.bBorde_izq? << _true

   	   LoCelda << LoTabla.oCeldas.Celda(LnNumRen,LnColumnas).oElementos.obten_elemento(:bordes_celda)
	   LoCelda.bBorde_Der? << _true
	   LoCelda.bBorde_Inf? << _true	   

	_endloop
	
_endmethod
$

_pragma(classify_level=restricted, usage={redefinable})
_private _method c_sello_observaciones.prvCreaCfgTabla_RutaB(PoCoord)

## Objetivo: Crea y configura las tabla ruta para cuando el
## tipo de sello es B
## seccion 1
## Parámetros de entrada:
##   RoCoord - Coordenada donde debe iniciar a dibujar la tabla	
