_pragma(classify_level=restricted, usage={redefinable})
_private _method c_sello_observaciones.prvObten_txt_Ren4()

## Objetivo: determinar que mensaje va en el renglon 4 de
## acuerdo al sello que se solicite
## Parámetros de entrada: NA
## Parámetros de salida:  NA
## Regresa: NA
## Fecha de última modificación: 02/03/2005
## Autor de la modificación : dsanchez
## Descripción de la modificación: Se documentó	

	
	_local LcollCadenas # Coleccione de cadenas que tendra el ren 4

	LcollCadenas << hash_table.new()

	_if _self.sTipo_Sello = "A"
	_then
	   LsCad1 <<          "ES RESPONSABILIDAD DEL CONSTRUCTOR VERIFICAR Y DETECTAR LA UBICACION "
	   LsCad1 << LsCad1 + "DE LA FIBRA OPTICA EXISTENTE, "

	   LsCad2 <<          "A LO LARGO DE LA TRAYECTORIA DEL PROYECTO ANTES DE INICIAR LA CONSTRUCCION"
	_else
	   LsCad1 <<          "INSTALAR CANALETA EN TODOS LOS POZOS DE LA RUTA, CONFORME NORMATIVIDAD"
	   LsCad1 << LsCad1 + "VIGENTE COMO PROTECCION "

	   LsCad2 <<         "AL CABLE DE FIBRA OPTICA"
		
	_endif

	LcollCadenas[1] << LsCad1
	LcollCadenas[2] << LsCad2
	
	_return LcollCadenas
	
_endmethod
$

_pragma(classify_level=restricted, usage={redefinable})
_private _method c_sello_observaciones.prvObten_txt_Ren6()

## Objetivo: determinar que mensaje va en el renglon 6 de
## acuerdo al sello que se solicite
## Parámetros de entrada: NA
## Parámetros de salida:  NA
## Regresa: NA
## Fecha de última modificación: 02/03/2005
## Autor de la modificación : dsanchez
## Descripción de la modificación: Se documentó	

	
	_local LcollCadenas # Coleccione de cadenas que tendra el ren 6

	LcollCadenas << hash_table.new()

	_if _self.sTipo_Sello = "A"
	_then
	   LsCad1 <<          "INSTALAR TIERRAS FISICAS EN LOS POZOS DE EMPALME QUE SE INDICA COLOCANDO "
	   LsCad1 << LsCad1 + "EL DISPOSITIVO NORSCAN "

	   LsCad2 <<          "2701 O 2730 EL QUE SE REQUIERA EN CADA CASO"
	_else
	   LsCad1 <<          "INSTALAR TIERRAS FISICAS EN LOS POZOS DE EMPALME QUE SE INDICA"

	   LsCad2 <<         " "
		
	_endif

	LcollCadenas[1] << LsCad1
	LcollCadenas[2] << LsCad2
	
	_return LcollCadenas
	
_endmethod
$

_pragma(classify_level=restricted, usage={redefinable})
_private _method c_sello_observaciones.prvAsigna_txt_Ren2()

## Objetivo: Asignar el texto que debe llevar el renglon 2
## Parámetros de entrada: NA
## Parámetros de salida:  NA
## Regresa: NA
## Fecha de última modificación: 02/03/2005
## Autor de la modificación : dsanchez
## Descripción de la modificación: Se documentó	

	
     _Local LsTxt # texto que debe tener la cadena

     LsTxt << "EN TODO EL TRAMO DIRECTAMENTE ENTERRADO SE INSTALARAN " + _self.num_ductos.default("___")
     LsTxt << LsTxt + " DUCTOS DE POLIETILENO DE ALTA DENSIDAD "
      _self.oTablas.elemento(:tbl_Ren2).oCeldas.Celda(1,2).oElemento.sTexto << LsTxt

     LsTxt << "DE 48.3 mm DE DIAMETRO ( " + _self.Colores.default("__") + " ) Y DOS CINTAS DE ADVERTENCIA"
      _self.oTablas.elemento(:tbl_Ren2).oCeldas.Celda(2,2).oElemento.sTexto << LsTxt

	
_endmethod
$


_pragma(classify_level=restricted, usage={redefinable})
_private _method c_sello_observaciones.prvAsigna_txt_Ren8()

## Objetivo: Asignar el texto que debe llevar el renglon 8
## Parámetros de entrada: NA
## Parámetros de salida:  NA
## Regresa: NA
## Fecha de última modificación: 02/03/2005
## Autor de la modificación : dsanchez
## Descripción de la modificación: Se documentó	

	
     _Local LsTxt # texto que debe tener la cadena

     LsTxt << "PERIODO DE LEVANTAMIENTO EN CAMPO. "
      _self.oTablas.elemento(:tbl_Ren8).oCeldas.Celda(1,2).oElemento.sTexto << LsTxt

     LsTxt << "DEL " +  _self.fec_inicio.default("____") + " AL " +
              _self.fec_final.default("___") + " DEL " +  _self.Anio.default("____")
      _self.oTablas.elemento(:tbl_Ren8).oCeldas.Celda(2,2).oElemento.sTexto << LsTxt

	
_endmethod
$

_pragma(classify_level=restricted, usage={redefinable})
_method c_sello_observaciones.prvCfgRenglon(RoTabla, RnRenglones)


	RoTabla.bDibuja_bordes? << _false
	RoTabla.bDibuja_Columnas_Internas?  << _false
	RoTabla.bDibuja_Renglones_Internos? << _false
	
	#Asigna la longitud c cada uno de los renglones que componen a REN2
	_for LnNumRen  _over range(1,RnRenglones)
	_loop
	   RoTabla.oRenglones.elemento(LnNumRen).nLongitud <<   3		
	_endloop

	RoTabla.oColumnas.elemento(1).nLongitud  <<   9 
	RoTabla.oColumnas.elemento(2).nLongitud  <<  _self.nAncho_Sello - 9


	_for LnNumRen  _over range(1,RnRenglones)
	_loop
	   LoCelda << RoTabla.oCeldas.Celda(LnNumRen,1).oElementos.obten_elemento(:bordes_celda)
 	   LoCelda.bBorde_izq? << _true

	   LoCelda << RoTabla.oCeldas.Celda(LnNumRen,2).oElementos.obten_elemento(:bordes_celda)
	   LoCelda.bBorde_der? << _true	
	_endloop

	
_endmethod
$


