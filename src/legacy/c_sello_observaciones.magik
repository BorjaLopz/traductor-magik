	_self.prvAsigna_txt_Ren8()
	
	
_endmethod
$

_pragma(classify_level=restricted, usage={redefinable})
_method c_sello_observaciones.prvCrea_Asigna_Obj_A_Celdas_Seccion2()

## Objetivo: Crea y asigna los objetos a las celdas de las
## tablas de la seccion 1
## Parámetros de entrada: NA
## Parámetros de salida:  NA
## Regresa: NA
## Fecha de última modificación: 24/02/2005
## Autor de la modificación : dsanchez
## Descripción de la modificación: Se documentó	

	_local LoNum # Numero de renglon
	_local LoTxt # texto del renglon
	_local LoTxt2 # texto del renglon
	_local LoTxt3 # texto del renglon		
	_local LsCad # almacena el texto que desplegara el renglon
	_local LcollCadenas # Almacena las cadenas que debera desplegar el ren 4 y ren 8
	

	#-----------------------------------------------------------
	#Tabla Informacion confidencial
	#-----------------------------------------------------------

	#se crean los objetos que almacenara la tabla

	LsCad <<  "INFORMACION CONFIDENCIAL PROPIEDAD DE TELMEX" + character.newline +
	          "PROHIBIDA SU REPRODUCCION PARCIAL O TOTAL"
	
	LoTxt  << c_texto_grafico.new(LsCad)
	LoTxt.nTamanio << 35
	LoTxt.sAlineacion << :top_centre
	LoTxt.sEstilo << "fixed"

	#asigna los objetos creados a su correspondiente celda
	_self.oTablas.elemento(:tbl_Infor_confidencial).oCeldas.Celda(2,1).oElemento << LoTxt

	#-----------------------------------------------------------
	#Tabla Ruta
	#-----------------------------------------------------------

	_if _self.sTipo_sello = "A"
	_then
		_self.prvCrea_Asigna_Obj_A_Celdas_RutaA()
		_self.prvCrea_Asigna_Obj_A_Celdas_DireccionA()		
	_else
		_self.prvCrea_Asigna_Obj_A_Celdas_RutaB()
		_self.prvCrea_Asigna_Obj_A_Celdas_DireccionB()				
	_endif


_endmethod 
$


_pragma(classify_level=restricted, usage={redefinable})
_method c_sello_observaciones.prvCrea_Asigna_Obj_A_Celdas_Seccion3()

## Objetivo: Crea y asigna los objetos a las celdas de las
## tablas de la seccion 1
## Parámetros de entrada: NA
## Parámetros de salida:  NA
## Regresa: NA
## Fecha de última modificación: 24/02/2005
## Autor de la modificación : dsanchez
## Descripción de la modificación: Se documentó	

	_local LoNum # Numero de renglon
	_local LoTxt # texto del renglon
	_local LoTxt2 # texto del renglon
	_local LoTxt3 # texto del renglon		
	_local LsCad # almacena el texto que desplegara el renglon
	_local LcollCadenas # Almacena las cadenas que debera desplegar el ren 4 y ren 8
	

	#-----------------------------------------------------------
	#Tabla Autorizo
	#-----------------------------------------------------------

	_local LoLblAutorizo     # Almacena la etiqueta de Autorizo
	_local LoLblModificacion # Almacena la etiqueta de Modificacion
	_local LoLblFecha        # Almacena la etiqueta de Fecha
	_local LoLblPor          # Almacena la etiqueta de por

	_local LoTxtAutorizo     # Almacena el texto de Autorizo
	_local LoTxtModificacion # Almacena el texto de Modificacion
	_local LoTxtFecha        # Almacena el texto de Fecha
	_local LoTxtPor          # Almacena el texto de por
	
	#se crean los objetos que almacenara la tabla
	LoLblAutorizo  << c_texto_grafico.new("AUTORIZO")
	LoLblAutorizo.nTamanio << 25
	LoLblAutorizo.sAlineacion << :centre_centre
	LoLblAutorizo.sEstilo << "fixed"

	#se crean los objetos que almacenara la tabla
	LoLblModificacion << c_texto_grafico.new_from(LoLblAutorizo, "MODIFICACION")
	LoLblFecha        << c_texto_grafico.new_from(LoLblAutorizo, "FECHA")
	LoLblPor          << c_texto_grafico.new_from(LoLblAutorizo, "POR")


	#se crean los objetos que almacenara la tabla
	LoTxtAutorizo  << c_texto_grafico.new_from(LoLblAutorizo," ")

	#se crean los objetos que almacenara la tabla
	LoTxtModificacion << c_texto_grafico.new_from(LoTxtAutorizo, " ")
	LoTxtFecha        << c_texto_grafico.new_from(LoTxtAutorizo, " ")
	LoTxtPor          << c_texto_grafico.new_from(LoTxtAutorizo, " ")	
	

	
	#asigna los objetos creados a su correspondiente celda

	_self.oTablas.elemento(:tbl_autorizo).oCeldas.Celda(1,1).oElemento << LoTxtAutorizo
	_self.oTablas.elemento(:tbl_autorizo).oCeldas.Celda(1,2).oElemento << LoTxtModificacion
	_self.oTablas.elemento(:tbl_autorizo).oCeldas.Celda(1,3).oElemento << LoTxtFecha
	_self.oTablas.elemento(:tbl_autorizo).oCeldas.Celda(1,4).oElemento << LoTxtPor
	
	_self.oTablas.elemento(:tbl_autorizo).oCeldas.Celda(2,1).oElemento << LoLblAutorizo
	_self.oTablas.elemento(:tbl_autorizo).oCeldas.Celda(2,2).oElemento << LoLblModificacion
	_self.oTablas.elemento(:tbl_autorizo).oCeldas.Celda(2,3).oElemento << LoLblFecha
	_self.oTablas.elemento(:tbl_autorizo).oCeldas.Celda(2,4).oElemento << LoLblPor


	
	#-----------------------------------------------------------
	#Tabla Simbolo izq
	#-----------------------------------------------------------
	
	#se crean los objetos que almacenara la tabla
	#	LoSim << c_simbolo_grafico.new("Granja")
	#	LoSim << c_imagen_bmp.new("C:\Imagen_bmp\Logo_IMTSA.bmp")
        #	LoSim << c_imagen_bmp.new(_self.ruta + "\Logo_IMTSA.bmp")
        
        _Local LsNombre_Imagen_BMP
        
       	LsNombre_Imagen_BMP << _self.ruta + "\Logo_" + _self.prvObten_Proyecto + ".bmp"

	_if system.file_exists?(LsNombre_Imagen_BMP) = _false
	_then

		LsNombre_Imagen_BMP << _self.ruta + "\Logo_Sin_imagen.bmp"		

	_endif

	LoSim << c_imagen_bmp.new(LsNombre_Imagen_BMP.write_string)
	
	LoSim.nMargen_izq << 1
	LoSim.nMargen_der << 1
	LoSim.nMargen_sup << 1
	LoSim.nMargen_inf << 1	
		
	#asigna los objetos creados a su correspondiente celda
	_self.oTablas.elemento(:tbl_Simbolo_izq).oCeldas.Celda(1,1).oElemento << LoSim
	

	#-----------------------------------------------------------
	#Tabla Tramo
	#-----------------------------------------------------------
	
	#se crean los objetos que almacenara la tabla
	LoLbl << c_texto_grafico.new("TRAMO")
	LoLbl.nTamanio << 25
	LoLbl.sAlineacion << :centre_centre
	LoLbl.sEstilo << "fixed"

	#se crean los objetos que almacenara la tabla
	LoLblTit << c_texto_grafico.new_from(LoLbl, "TITULO")	



	#asigna los objetos creados a su correspondiente celda
	_self.oTablas.elemento(:tbl_Tramo).oCeldas.Celda(1,1).oElemento << LoLbl
	_self.oTablas.elemento(:tbl_Tramo).oCeldas.Celda(2,1).oElemento << LoLblTit	


	#-----------------------------------------------------------
	#Tabla Kilometros
	#-----------------------------------------------------------
	
	#se crean los objetos que almacenara la tabla
	LoLbl << c_texto_grafico.new("KM.F.O.=")
	LoLbl.nTamanio << 25
	LoLbl.sAlineacion << :centre_centre
	LoLbl.sEstilo << "fixed"

	#se crean los objetos que almacenara la tabla
	LoLbl2 << c_texto_grafico.new_from(LoLbl, "KM.REAL=")
	LoLbl3 << c_texto_grafico.new_from(LoLbl, "KM.SCT=")
	LoLbl4 << c_texto_grafico.new_from(LoLbl, "AL")
	LoLbl5 << c_texto_grafico.new_from(LoLbl, "AL")
	LoLbl6 << c_texto_grafico.new_from(LoLbl, "AL")				



	#asigna los objetos creados a su correspondiente celda
	_self.oTablas.elemento(:tbl_Kilometros).oCeldas.Celda(1,1).oElemento << LoLbl
	_self.oTablas.elemento(:tbl_Kilometros).oCeldas.Celda(2,1).oElemento << LoLbl2
	_self.oTablas.elemento(:tbl_Kilometros).oCeldas.Celda(3,1).oElemento << LoLbl3		

	_self.oTablas.elemento(:tbl_Kilometros).oCeldas.Celda(1,3).oElemento << LoLbl4
	_self.oTablas.elemento(:tbl_Kilometros).oCeldas.Celda(2,3).oElemento << LoLbl5
	_self.oTablas.elemento(:tbl_Kilometros).oCeldas.Celda(3,3).oElemento << LoLbl6		
	
	#-----------------------------------------------------------
	#Tabla Simbolo der
	#-----------------------------------------------------------
	
	#se crean los objetos que almacenara la tabla
	#	LoSim << c_simbolo_grafico.new("Granja")
	#	LoSim << c_imagen_bmp.new("C:\Imagen_bmp\Logo_Telmex.bmp")

       	LsNombre_Imagen_BMP << _self.ruta + "\Logo_" + _self.prvObten_Reviso + ".bmp"	
	
#	LoSim << c_imagen_bmp.new(_self.ruta + "\Logo_Telmex.bmp")	

	_if system.file_exists?(LsNombre_Imagen_BMP) = _false
	_then

		LsNombre_Imagen_BMP << _self.ruta + "\Logo_Sin_imagen.bmp"		

	_endif

	LoSim << c_imagen_bmp.new(LsNombre_Imagen_BMP)	

	LoSim.nMargen_izq << 1
	LoSim.nMargen_der << 1
	LoSim.nMargen_sup << 1
	LoSim.nMargen_inf << 1	

	#asigna los objetos creados a su correspondiente celda
	_self.oTablas.elemento(:tbl_Simbolo_der).oCeldas.Celda(1,1).oElemento << LoSim		

	
	
_endmethod 


_pragma(classify_level=restricted, usage={redefinable})
_method c_sello_observaciones.prvCrea_Asigna_Obj_A_Celdas_Seccion4()

## Objetivo: Crea y asigna los objetos a las celdas de las
## tablas de la seccion 1
## Parámetros de entrada: NA
## Parámetros de salida:  NA
## Regresa: NA
## Fecha de última modificación: 24/02/2005
## Autor de la modificación : dsanchez
## Descripción de la modificación: Se documentó	

	_local LoNum # Numero de renglon
	_local LoTxt # texto del renglon
	_local LoLbl  # Almacena la etiqueta de Autorizo	
	_local LoTxt2 # texto del renglon
	_local LoTxt3 # texto del renglon		
	_local LsCad # almacena el texto que desplegara el renglon
	_local LcollCadenas # Almacena las cadenas que debera desplegar el ren 4 y ren 8
	

	#-----------------------------------------------------------
	#Tabla Proyecto
	#-----------------------------------------------------------

	_local LoLblRev     # Almacena la etiqueta de Modificacion
	_local LoLblSup     # Almacena la etiqueta de Fecha
	_local LoLblAprobo  # Almacena la etiqueta de por

	_local LoTxtRev     # Almacena el texto de Modificacion
	_local LoTxtSup     # Almacena el texto de Fecha
	_local LoTxtAprobo  # Almacena el texto de por
	
	#se crean los objetos que almacenara la tabla
	LoLbl  << c_texto_grafico.new("PROYECTO")
	LoLbl.nTamanio << 25
	LoLbl.sAlineacion << :centre_centre
	LoLbl.sEstilo << "fixed"

	#se crean los objetos que almacenara la tabla
	LoLblRev     << c_texto_grafico.new_from(LoLbl, "REVISO")
	LoLblSup     << c_texto_grafico.new_from(LoLbl, "SUPERVISO")
	LoLblAprobo  << c_texto_grafico.new_from(LoLbl, "APROBO")


	#se crean los objetos que almacenara la tabla
	LoTxt  << c_texto_grafico.new_from(LoLbl," ")

	#se crean los objetos que almacenara la tabla
	LoTxtRev    << c_texto_grafico.new_from(LoTxt, " ")
	LoTxtSup    << c_texto_grafico.new_from(LoTxt, " ")
	LoTxtAprobo << c_texto_grafico.new_from(LoTxt, " ")	
	
	
	#asigna los objetos creados a su correspondiente celda

	_self.oTablas.elemento(:tbl_proyecto).oCeldas.Celda(1,1).oElemento << LoLbl
	_self.oTablas.elemento(:tbl_proyecto).oCeldas.Celda(1,2).oElemento << LoLblRev
	_self.oTablas.elemento(:tbl_proyecto).oCeldas.Celda(3,1).oElemento << LoLblSup
	_self.oTablas.elemento(:tbl_proyecto).oCeldas.Celda(3,2).oElemento << LoLblAprobo
	
	_self.oTablas.elemento(:tbl_proyecto).oCeldas.Celda(2,1).oElemento << LoTxt
	_self.oTablas.elemento(:tbl_proyecto).oCeldas.Celda(2,2).oElemento << LoTxtRev
	_self.oTablas.elemento(:tbl_proyecto).oCeldas.Celda(4,1).oElemento << LoTxtSup
	_self.oTablas.elemento(:tbl_proyecto).oCeldas.Celda(4,2).oElemento << LoTxtAprobo

	#-----------------------------------------------------------
	#Tabla Fecha
	#-----------------------------------------------------------
	
	#se crean los objetos que almacenara la tabla
	LoLbl  << c_texto_grafico.new("FECHA")
	LoLbl.nTamanio << 25
	LoLbl.sAlineacion << :centre_centre
	LoLbl.sEstilo << "fixed"

	#se crean los objetos que almacenara la tabla
	LoTxt  << c_texto_grafico.new_from(LoLbl," ")

	#asigna los objetos creados a su correspondiente celda

	_self.oTablas.elemento(:tbl_fecha).oCeldas.Celda(1,1).oElemento << LoLbl
	_self.oTablas.elemento(:tbl_fecha).oCeldas.Celda(2,1).oElemento << LoTxt


	#-----------------------------------------------------------
	#Tabla Escala
	#-----------------------------------------------------------
	
	#se crean los objetos que almacenara la tabla
	LoLbl  << c_texto_grafico.new("ESCALA")
	LoLbl.nTamanio << 25
	LoLbl.sAlineacion << :centre_centre
	LoLbl.sEstilo << "fixed"

	LoLblAcot << c_texto_grafico.new_from(LoLbl, "ACOT")
	
	#se crean los objetos que almacenara la tabla
	LoTxt  << c_texto_grafico.new_from(LoLbl,"F/E")

	LoTxtAcot  << c_texto_grafico.new_from(LoTxt,"MTS")

	#asigna los objetos creados a su correspondiente celda

	_self.oTablas.elemento(:tbl_Escala).oCeldas.Celda(1,1).oElemento << LoLbl
	_self.oTablas.elemento(:tbl_Escala).oCeldas.Celda(1,2).oElemento << LoLblAcot
	
	_self.oTablas.elemento(:tbl_Escala).oCeldas.Celda(2,1).oElemento << LoTxt
	_self.oTablas.elemento(:tbl_Escala).oCeldas.Celda(2,2).oElemento << LoTxtAcot

	#-----------------------------------------------------------
	#Tabla REVISION
	#-----------------------------------------------------------
	
	#se crean los objetos que almacenara la tabla
	LoLbl  << c_texto_grafico.new("REVISION")
	LoLbl.nTamanio << 25
	LoLbl.sAlineacion << :centre_centre
	LoLbl.sEstilo << "fixed"

	LoLblEdicion << c_texto_grafico.new_from(LoLbl, "EDICION")
	
	#se crean los objetos que almacenara la tabla
	LoTxt  << c_texto_grafico.new_from(LoLbl," ")

	LoTxtEdicion  << c_texto_grafico.new_from(LoTxt," ")

	#asigna los objetos creados a su correspondiente celda

	_self.oTablas.elemento(:tbl_Revision).oCeldas.Celda(1,1).oElemento << LoLbl
	_self.oTablas.elemento(:tbl_Revision).oCeldas.Celda(1,2).oElemento << LoLblEdicion
	
	_self.oTablas.elemento(:tbl_Revision).oCeldas.Celda(2,1).oElemento << LoTxt
	_self.oTablas.elemento(:tbl_Revision).oCeldas.Celda(2,2).oElemento << LoTxtEdicion

	#-----------------------------------------------------------
	#Tabla Plano
	#-----------------------------------------------------------
	
	#se crean los objetos que almacenara la tabla
	LoLbl  << c_texto_grafico.new("PLANO NO.")
	LoLbl.nTamanio << 25
	LoLbl.sAlineacion << :centre_centre
	LoLbl.sEstilo << "fixed"

	LoLblDe << c_texto_grafico.new_from(LoLbl, "DE")
	
	#se crean los objetos que almacenara la tabla
	LoTxt  << c_texto_grafico.new_from(LoLbl," ")

	LoTxt2  << c_texto_grafico.new_from(LoTxt," ")

	#asigna los objetos creados a su correspondiente celda

	_self.oTablas.elemento(:tbl_Plano).oCeldas.Celda(1,2).oElemento << LoLbl
	_self.oTablas.elemento(:tbl_Plano).oCeldas.Celda(2,2).oElemento << LoLblDe
	
	_self.oTablas.elemento(:tbl_Plano).oCeldas.Celda(2,1).oElemento << LoTxt
	_self.oTablas.elemento(:tbl_Plano).oCeldas.Celda(2,3).oElemento << LoTxt2


	#-----------------------------------------------------------
	#Tabla Aprobacion
	#-----------------------------------------------------------
	
	#se crean los objetos que almacenara la tabla
	LoLbl  << c_texto_grafico.new("APROBACION")
	LoLbl.nTamanio << 25
	LoLbl.sAlineacion << :centre_centre
	LoLbl.sEstilo << "fixed"

	LoLblNombre << c_texto_grafico.new_from(LoLbl, "NOMBRE")
	LoLblFirma  << c_texto_grafico.new_from(LoLbl, "FIRMA")
	LoLblFecha  << c_texto_grafico.new_from(LoLbl, "FECHA")	
	
	#se crean los objetos que almacenara la tabla
	LoTxt  << c_texto_grafico.new_from(LoLbl," ")

	LoTxt2  << c_texto_grafico.new_from(LoTxt," ")
	LoTxt3  << c_texto_grafico.new_from(LoTxt," ")

	#asigna los objetos creados a su correspondiente celda

	_self.oTablas.elemento(:tbl_Aprobacion).oCeldas.Celda(1,2).oElemento << LoLbl
	_self.oTablas.elemento(:tbl_Aprobacion).oCeldas.Celda(2,1).oElemento << LoLblNombre
	_self.oTablas.elemento(:tbl_Aprobacion).oCeldas.Celda(2,2).oElemento << LoLblFirma
	_self.oTablas.elemento(:tbl_Aprobacion).oCeldas.Celda(2,3).oElemento << LoLblFecha	
	
	_self.oTablas.elemento(:tbl_Aprobacion).oCeldas.Celda(3,1).oElemento << LoTxt
	_self.oTablas.elemento(:tbl_Aprobacion).oCeldas.Celda(3,2).oElemento << LoTxt2
	_self.oTablas.elemento(:tbl_Aprobacion).oCeldas.Celda(3,2).oElemento << LoTxt3	

_endmethod 

