_private _method c_sello_observaciones.prvObten_Proyecto 


	_local LoProy_Red
	
	LoProy_Red << c_proyecto_red.new()
	LoProy_Red.identificador_proyecto("1")
	
      _return LoProy_Red.empresa_proyecto		
      
_endmethod
