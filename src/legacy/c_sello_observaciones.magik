## Regresa: NA
## Fecha de última modificación: 24/02/2005
## Autor de la modificación : dsanchez
## Descripción de la modificación: Se documentó	

	_self.prvCrea_Asigna_Obj_A_Celdas_Seccion1()
	_self.prvCrea_Asigna_Obj_A_Celdas_Seccion2()
	_self.prvCrea_Asigna_Obj_A_Celdas_Seccion3()		
	_self.prvCrea_Asigna_Obj_A_Celdas_Seccion4()

_endmethod
$

_pragma(classify_level=restricted, usage={redefinable})
_method c_sello_observaciones.prvCrea_Asigna_Obj_A_Celdas_Seccion1()

## Objetivo: Crea y asigna los objetos a las celdas de las
## tablas de la seccion 1
## Parámetros de entrada: NA
## Parámetros de salida:  NA
## Regresa: NA
## Fecha de última modificación: 24/02/2005
## Autor de la modificación : dsanchez
## Descripción de la modificación: Se documentó	

	_local LoNum # Numero de renglon
	_local LoTxt # texto del renglon
	_local LoTxt2 # texto del renglon
	_local LoTxt3 # texto del renglon		
	_local LsCad # almacena el texto que desplegara el renglon
	_local LcollCadenas # Almacena las cadenas que debera desplegar el ren 4 y ren 8
	

	#-----------------------------------------------------------
	#Tabla Observaciones
	#-----------------------------------------------------------

	_local LoObservaciones # Almacena la etiqueta de observaciones 
	_local LoNotas         # Almacena la etiqueta de notas 
	
	#se crean los objetos que almacenara la tabla
	LoObservaciones  << c_texto_grafico.new("OBSERVACIONES")
	LoObservaciones.nTamanio << 35
	LoObservaciones.sAlineacion << :centre_left
	LoObservaciones.sEstilo << "fixed"

	#se crean los objetos que almacenara la tabla
	LoNotas  << c_texto_grafico.new_from(LoObservaciones, "NOTAS.-")
	LoNotas.nTamanio << 25
	
	#asigna los objetos creados a su correspondiente celda
	_self.oTablas.elemento(:tbl_Observaciones).oCeldas.Celda(1,1).oElemento << LoObservaciones
	_self.oTablas.elemento(:tbl_Observaciones).oCeldas.Celda(2,1).oElemento << LoNotas


	#-----------------------------------------------------------
	#Tabla Ren 1
	#-----------------------------------------------------------
	
	#se crean los objetos que almacenara la tabla
	LoNum  << c_texto_grafico.new("1.-")
	LoNum.nTamanio << 25
	LoNum.sAlineacion << :centre_right
        LoNum.sEstilo << "fixed"	

	#se crean los objetos que almacenara la tabla
	LoTxt  << c_texto_grafico.new_from(LoNum,"TODAS LAS ACOTACIONES ESTAN DADAS EN METROS.")
	LoTxt.sAlineacion << :centre_left
	
	#asigna los objetos creados a su correspondiente celda
	_self.oTablas.elemento(:tbl_Ren1).oCeldas.Celda(1,1).oElemento << LoNum
	_self.oTablas.elemento(:tbl_Ren1).oCeldas.Celda(1,2).oElemento << LoTxt

	#-----------------------------------------------------------
	#Tabla Ren 2
	#-----------------------------------------------------------

	#se crean los objetos que almacenara la tabla
	LoNum  << c_texto_grafico.new("2.-")
	LoNum.nTamanio << 25
	LoNum.sAlineacion << :centre_right
        LoNum.sEstilo << "fixed"	
	
	# se crean los objetos que almacenara la tabla. La cadena queda
	# vacia ya que esta se asigna en el metodo asigna txt a R2
	LoTxt  << c_texto_grafico.new(" ")
	LoTxt.nTamanio << 25
	LoTxt.sAlineacion << :centre_left
        LoTxt.sEstilo << "fixed"	

	LoTxt2  << c_texto_grafico.new_from(LoTxt, " ")
	

	#asigna los objetos creados a su correspondiente celda
	_self.oTablas.elemento(:tbl_Ren2).oCeldas.Celda(1,1).oElemento << LoNum
	_self.oTablas.elemento(:tbl_Ren2).oCeldas.Celda(1,2).oElemento << LoTxt
	_self.oTablas.elemento(:tbl_Ren2).oCeldas.Celda(2,2).oElemento << LoTxt2
	
	_self.prvAsigna_txt_Ren2()
	
	#-----------------------------------------------------------
	#Tabla Ren 3
	#-----------------------------------------------------------

	#se crean los objetos que almacenara la tabla
	LoNum  << c_texto_grafico.new("3.-")
	LoNum.nTamanio << 25
	LoNum.sAlineacion << :centre_right
        LoNum.sEstilo << "fixed"
	
	# se crean los objetos que almacenara la tabla.

	LsCad <<         "EL CONTRATISTA ANTES DE INICIAR LA CONSTRUCCION DEBERA REALIZAR UNA "
	LsCad << LsCad + "PLANIFICACION PARA VERIFICAR  "
	
	LoTxt  << c_texto_grafico.new_from(LoNUm, LsCad)
	LoTxt.sAlineacion << :centre_left

	LsCad <<         "EN EL SITIO DE LA OBRA CHECANDO A DETALLE LOS OBSTACULOS QUE INTERFIERAN "
	LsCad << LsCad + " EN LA EJECUCION DEL PROYECTO,  "
	LoTxt2  << c_texto_grafico.new_from(LoTxt, LsCad)

	LsCad <<         "PARA LO CUAL DEBERAN DE REALIZAR CHECANDO A DETALLE LOS OBSTACULOS QUE  "
	LsCad << LsCad + "INTERFIERAN EN LA EJECUCION "
	
	LoTxt3  << c_texto_grafico.new_from(LoTxt, LsCad)

	LsCad <<         "DEL PROYECTO, PARA LO CUAL DEBERAN DE REALIZAR LAS ACTIVIDADES "
	LsCad << LsCad + "ADMINISTRATIVAS Y TECNICAS QUE SE REQUIERAN "
	
	LoTxt4  << c_texto_grafico.new_from(LoTxt, LsCad)	

	#asigna los objetos creados a su correspondiente celda
	_self.oTablas.elemento(:tbl_Ren3).oCeldas.Celda(1,1).oElemento << LoNum
	_self.oTablas.elemento(:tbl_Ren3).oCeldas.Celda(1,2).oElemento << LoTxt
	_self.oTablas.elemento(:tbl_Ren3).oCeldas.Celda(2,2).oElemento << LoTxt2
	_self.oTablas.elemento(:tbl_Ren3).oCeldas.Celda(3,2).oElemento << LoTxt3
	_self.oTablas.elemento(:tbl_Ren3).oCeldas.Celda(4,2).oElemento << LoTxt4		


	#-----------------------------------------------------------
	#Tabla Ren 4
	#-----------------------------------------------------------

	#se crean los objetos que almacenara la tabla
	LoNum  << c_texto_grafico.new("4.-")
	LoNum.nTamanio << 25
	LoNum.sAlineacion << :centre_right
        LoNum.sEstilo << "fixed"
	
	# se crean los objetos que almacenara la tabla.

	LcollCadenas << _self.prvObten_txt_Ren4()
	
	LoTxt  << c_texto_grafico.new_from(LoNum, LcollCadenas[1])
	LoTxt.sAlineacion << :centre_left

	LoTxt2  << c_texto_grafico.new_from(LoTxt, LcollCadenas[2])

	#asigna los objetos creados a su correspondiente celda
	_self.oTablas.elemento(:tbl_Ren4).oCeldas.Celda(1,1).oElemento << LoNum
	_self.oTablas.elemento(:tbl_Ren4).oCeldas.Celda(1,2).oElemento << LoTxt
	_self.oTablas.elemento(:tbl_Ren4).oCeldas.Celda(2,2).oElemento << LoTxt2

	#-----------------------------------------------------------
	#Tabla Ren 5
	#-----------------------------------------------------------

	#se crean los objetos que almacenara la tabla
	LoNum  << c_texto_grafico.new("5.-")
	LoNum.nTamanio << 25
	LoNum.sAlineacion << :centre_right
        LoNum.sEstilo << "fixed"
	
	# se crean los objetos que almacenara la tabla.

	LsCad <<         "SUPERVISION DE CONSTRUCCION RECTIFICARA O RATIFICARA QUE EL JALADO DEL "
	LsCad << LsCad + "CABLE SE EFECTUE POR LA VIA   "
	
	LoTxt  << c_texto_grafico.new_from(LoNUm, LsCad)
	LoTxt.sAlineacion << :centre_left

	LsCad <<         "ASIGNADA, Y EL SEMBRADO DEL DUCTO DE POLIETILENO ESTE A LA DISTENCIA QUE "
	LsCad << LsCad + "INDICA EL PROYECTO  "
	LoTxt2  << c_texto_grafico.new_from(LoTxt, LsCad)

	#asigna los objetos creados a su correspondiente celda
	_self.oTablas.elemento(:tbl_Ren5).oCeldas.Celda(1,1).oElemento << LoNum
	_self.oTablas.elemento(:tbl_Ren5).oCeldas.Celda(1,2).oElemento << LoTxt
	_self.oTablas.elemento(:tbl_Ren5).oCeldas.Celda(2,2).oElemento << LoTxt2

	#-----------------------------------------------------------
	#Tabla Ren 6
	#-----------------------------------------------------------

	#se crean los objetos que almacenara la tabla
	LoNum  << c_texto_grafico.new("6.-")
	LoNum.nTamanio << 25
	LoNum.sAlineacion << :centre_right
        LoNum.sEstilo << "fixed"
	
	# se crean los objetos que almacenara la tabla.

	LcollCadenas << _self.prvObten_txt_Ren6()
	
	LoTxt  << c_texto_grafico.new_from(LoNum, LcollCadenas[1])
	LoTxt.sAlineacion << :centre_left

	LoTxt2  << c_texto_grafico.new_from(LoTxt, LcollCadenas[2])

	#asigna los objetos creados a su correspondiente celda
	_self.oTablas.elemento(:tbl_Ren6).oCeldas.Celda(1,1).oElemento << LoNum
	_self.oTablas.elemento(:tbl_Ren6).oCeldas.Celda(1,2).oElemento << LoTxt
	_self.oTablas.elemento(:tbl_Ren6).oCeldas.Celda(2,2).oElemento << LoTxt2
	

	#-----------------------------------------------------------
	#Tabla Ren 7
	#-----------------------------------------------------------

	#se crean los objetos que almacenara la tabla
	LoNum  << c_texto_grafico.new("7.-")
	LoNum.nTamanio << 25
	LoNum.sAlineacion << :centre_right
        LoNum.sEstilo << "fixed"
	
	# se crean los objetos que almacenara la tabla.

	LsCad <<         "EN CASO DE ALGUNA MODIFICACION A ESTE PROYECTO FAVOR DE AVISAR AL "
	LsCad << LsCad + "RESPONSABLE DEL PROYECTO "
	
	LoTxt  << c_texto_grafico.new_from(LoNUm, LsCad)
	LoTxt.sAlineacion << :centre_left

	LsCad <<         "INDICADO EN ESTA CARATULA. "
	LoTxt2  << c_texto_grafico.new_from(LoTxt, LsCad)

	#asigna los objetos creados a su correspondiente celda
	_self.oTablas.elemento(:tbl_Ren7).oCeldas.Celda(1,1).oElemento << LoNum
	_self.oTablas.elemento(:tbl_Ren7).oCeldas.Celda(1,2).oElemento << LoTxt
	_self.oTablas.elemento(:tbl_Ren7).oCeldas.Celda(2,2).oElemento << LoTxt2


	#-----------------------------------------------------------
	#Tabla Ren 8
	#-----------------------------------------------------------

	#se crean los objetos que almacenara la tabla
	LoNum  << c_texto_grafico.new("8.-")
	LoNum.nTamanio << 25
	LoNum.sAlineacion << :centre_right
        LoNum.sEstilo << "fixed"	
	
	# se crean los objetos que almacenara la tabla. La cadena queda
	# vacia ya que esta se asigna en el metodo asigna txt a R2
	LoTxt  << c_texto_grafico.new(" ")
	LoTxt.nTamanio << 25
	LoTxt.sAlineacion << :centre_left
        LoTxt.sEstilo << "fixed"	

	LoTxt2  << c_texto_grafico.new_from(LoTxt, " ")
	

	#asigna los objetos creados a su correspondiente celda
	_self.oTablas.elemento(:tbl_Ren8).oCeldas.Celda(1,1).oElemento << LoNum
	_self.oTablas.elemento(:tbl_Ren8).oCeldas.Celda(1,2).oElemento << LoTxt
