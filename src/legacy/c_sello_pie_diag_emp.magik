_pragma(classify_level=advanced, topic={plotting}, usage={subclassable})
_method c_sello_pie_diag_emp.obten_registros()

	_super.obten_registros()

	.o_distrito.asigna_distrito(.o_proyecto.distrito, _false)
	
	.pl_datos[:colonia] << .o_distrito.nombre_colonia
	.pl_datos[:cp] << .o_distrito.codigo_postal
	
_endmethod
$
_pragma(classify_level=advanced, topic={plotting}, usage={subclassable})
_method c_sello_pie_diag_emp.valor_casilla_central()

	_return  .pl_datos[:clave_ctl] + " - " + .o_proyecto.numero_distrito
	
_endmethod
