_pragma(classify_level=advanced, topic={plotting}, usage={subclassable})
_method c_sello_red_secundaria.asigna_celdas_a_colorear()
## Asigna las celdas que van en color diferente
## vbluna(17-nov-2006)

	_local lst_celdas_color << rope.new()

	lst_celdas_color.add({:tbl_Ocupacion,4,4,.o_color_linea})
	lst_celdas_color.add({:tbl_inf_adm_1,2,1,.o_color_linea})
	lst_celdas_color.add({:tbl_inf_adm_1,2,2,.o_color_linea})
	lst_celdas_color.add({:tbl_inf_adm_1,2,3,.o_color_linea})
	lst_celdas_color.add({:tbl_inf_adm_2,2,2,.o_color_linea})
	lst_celdas_color.add({:tbl_inf_adm_2,3,2,.o_color_linea})
	lst_celdas_color.add({:tbl_inf_adm_2,4,2,.o_color_linea})
	lst_celdas_color.add({:tbl_inf_adm_2,2,3,.o_color_linea})
	lst_celdas_color.add({:tbl_inf_adm_2,3,3,.o_color_linea})
	lst_celdas_color.add({:tbl_inf_adm_2,4,3,.o_color_linea})
	lst_celdas_color.add({:tbl_inf_adm_2,6,3,.o_color_linea})
	lst_celdas_color.add({:tbl_inf_adm_2,7,3,.o_color_linea})
	lst_celdas_color.add({:tbl_Ocupacion,3,4,.o_color_linea})
	lst_celdas_color.add({:tbl_Red_Datos,2,3,.o_color_linea})
	lst_celdas_color.add({:tbl_Red_Datos,2,4,.o_color_linea})
	lst_celdas_color.add({:tbl_Red_Datos,3,3,.o_color_linea})
	lst_celdas_color.add({:tbl_Red_Datos,3,4,.o_color_linea})
	lst_celdas_color.add({:tbl_Red_Datos,4,3,.o_color_linea})
	lst_celdas_color.add({:tbl_Red_Datos,4,4,.o_color_linea})
	lst_celdas_color.add({:tbl_Ocupacion,3,5,.o_color_linea})
	lst_celdas_color.add({:tbl_Ocupacion,4,5,.o_color_linea})
	lst_celdas_color.add({:tbl_Ocupacion,4,2,.o_color_linea})
	lst_celdas_color.add({:tbl_inf_adm_2,8,3,.o_color_linea})

	_return lst_celdas_color
	
_endmethod
