_pragma(classify_level=restricted, usage={redefinable})
_method c_sello_red_secundaria.defined_attributes

	
	attribs << rope.new_from (_super.defined_attributes)

		attribs.add(layout_attribute_definition.new(:opb,    :string,
		                                    :description,     "Opbs",
			                            :default_value,"" ))

	       attribs.add(layout_attribute_definition.new(:oeis,     :string,
		                                    :description,     "Oeis",
						    :default_value,"" ))
		
		attribs.add(layout_attribute_definition.new(:oe_cons,    :string,
		                                    :description,     "OE construccion",
						    :default_value,"" ))

		attribs.add(layout_attribute_definition.new(:oe_desm,    :string,
		                                    :description,     "OE Desmontaje",
						    :default_value,"" ))

		attribs.add(layout_attribute_definition.new(:oe_reco,    :string,
		                                    :description,     "OE reconcentracion",
						    :default_value,"" ))
		
		attribs.add(layout_attribute_definition.new(:pep_cons_sec,    :string,
		                                    :description,     "Pep canal",
						    :default_value,"" ))
		
		attribs.add(layout_attribute_definition.new(:pep_desm_sec,    :string,
	 	                                    :description,     "Pep desm"))

		attribs.add(layout_attribute_definition.new(:pep_reco_sec,    :string,
		                                    :description,     "Pep rec",
						    :default_value,"" ))


		
		attribs.add(layout_attribute_definition.new(:canalizacion,    :string,
							    :description,     "canalizacion",
							    :default_value,   ""))
		
		attribs.add(layout_attribute_definition.new(:principal,       :string,
							    :description,     "principal",
							    :default_value,   ""))

		
		attribs.add(layout_attribute_definition.new(:pisa,            :string,
							    :description,     "pisa",
							    :default_value,"" ))
		
		attribs.add(layout_attribute_definition.new(:tipo_empalme,    :string,
							    :description,     "tipo_empalmes",
							    :default_value,"" ))
		
		attribs.add(layout_attribute_definition.new(:tipo_terminal,   :string,
							    :description,     "tipo_terminales",
							    :default_value,"" ))
		
		attribs.add(layout_attribute_definition.new(:tipo_cable,      :string,
							    :description,     "tipo_cable",
							    :default_value,"" ))
		
		attribs.add(layout_attribute_definition.new(:observaciones,   :string,
							    :description,     "observaciones",
							    :default_value,"" ))
		
		attribs.add(layout_attribute_definition.new(:hoja,            :string,
							    :description,     "hoja",
							    :default_value,   1))
		
		attribs.add(layout_attribute_definition.new(:total_hojas,     :string,
							    :description,     "total_hojas",
							    :default_value,   2))
		
		attribs.add(layout_attribute_definition.new(:direccion_cd,    :string,
							    :description,     "direccion_cd",
							    :default_value,"" ))
		
		attribs.add(layout_attribute_definition.new(:numero_manzanas, :string,
							    :description,     "numero_manzanas",
							    :default_value,"" ))
		>> attribs
		
_endmethod
$
c_sello_red_secundaria.define_attributes()
$
_pragma(classify_level=advanced, topic={plotting}, usage={subclassable})
_method c_sello_red_secundaria.escala()

	_local lo_viewports
	_local lo_viewport
	
        _try
		lo_viewports << _self.layout_page.all_elements_of(c_viewport_layout_sigc)
		
		_for view _over lo_viewports.fast_elements()
		_loop
			# se obtiene el viewport que tiene asignado algún valor en
			# .sTipoPlano, asegurando que no se tome la escala del croquis
			_if view.sTipoPlano _isnt _unset
			_then
				lo_viewport << view
			_endif
		_endloop
		
		lo_escala << lo_viewport.view_scale.rounded
		ls_escala << "1:" + lo_escala.write_string
		
		_return ls_escala
		
	_when does_not_understand
		_return "F/E"
	_endtry
	
_endmethod
$
_pragma(classify_level=advanced, topic={plotting}, usage={subclassable})
_method c_sello_red_secundaria.etiqueta_celdas()

	_local lrope_textos

