_method c_sello_red_secundaria.llena_faltas_danios(p_pl_datos)


	_local lcol_faltas << p_pl_datos[:faltas_danios]
	_local ln_reng_ini << 5

	_for key, value _over lcol_faltas.fast_keys_and_elements()
	_loop
		_self.asigna_texto_celda(:tbl_Notas,ln_reng_ini,1,key.write_string,25,:centre_left)
		_self.asigna_texto_celda(:tbl_Notas,ln_reng_ini,2,value[1].default("").write_string,25,:centre_left)
		_self.asigna_texto_celda(:tbl_Notas,ln_reng_ini,3,value[2].default("").write_string,25,:centre_left)
		ln_reng_ini +<< 1
	_endloop
	
_endmethod
