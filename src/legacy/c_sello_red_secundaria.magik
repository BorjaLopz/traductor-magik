_method c_sello_red_secundaria.llena_factor_pen(p_pl_datos)

	_local col_factor_pen << p_pl_datos[:factor_pen]
	_local ln_reng_ini << 2

	col_factor_pen.default_value << 0.0

	_for nse _over .pl_nse.elements()
	_loop
		ls_value << col_factor_pen[nse].default("").write_string
		_self.asigna_texto_celda(:tbl_Inventario_Datos,ln_reng_ini,9,ls_value,25)
		ln_reng_ini +<< 1
	_endloop

_endmethod
