_package user
$
def_slotted_exemplar(:c_sello_red_secundaria,
{
	{:pl_terminal_1,       _unset,  :writable},
	{:pl_terminal_2,       _unset,  :writable},
	{:pl_terminal_esp,     _unset,  :writable},
	{:pl_num_terminal,     _unset,  :writable},
