	_self.asigna_texto_celda(:tbl_Red_Datos,1,3,"AUMENTO",30)
	_self.asigna_texto_celda(:tbl_Red_Datos,1,4,"TOTAL",30)
	_self.asigna_texto_celda(:tbl_Red_Datos,2,1,"PARES CONECTADOS",20,:centre_left,1)
