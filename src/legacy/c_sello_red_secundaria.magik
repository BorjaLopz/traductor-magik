_pragma(classify_level=advanced, topic={plotting}, usage={subclassable})
_method c_sello_red_secundaria.llena_viv_lin(p_pl_datos)

	_local lp_datos_viv_lin << p_pl_datos[:viv_lin]
	_local lp_datos_lin_satura << p_pl_datos[:lin_satura]
	_local lp_datos_tot_viv_lin << p_pl_datos[:tot_viv_lin]
	_local tot_lin_distrito << p_pl_datos[:tot_lin_dto].default("")
	_local ln_reng_ini << 2

	_for nse _over .pl_nse.fast_elements()
	_loop
		ls_value_viv << lp_datos_viv_lin[nse][:viviendas].default("").write_string
		ls_value_lin << lp_datos_viv_lin[nse][:abonados].default("").write_string
		ls_value_lin_multi << lp_datos_viv_lin[nse][:lineas_multiplicador].default("").write_string
		ls_value_lin_compe << lp_datos_viv_lin[nse][:lineas_competencia].default("").write_string
		ls_value_lin_inal << lp_datos_viv_lin[nse][:lineas_inalambricas].default("").write_string
		ls_value_solicitud << lp_datos_viv_lin[nse][:solicitudes].default("").write_string
		ls_viv_sin_serv << lp_datos_viv_lin[nse][:viv_sin_servicio].default("").write_string
		ls_lin_satura << lp_datos_lin_satura[nse].default("").write_string

		_self.asigna_texto_celda(:tbl_Inventario_Datos,ln_reng_ini,2,ls_value_viv,25)
		_self.asigna_texto_celda(:tbl_Inventario_Datos,ln_reng_ini,3,ls_value_lin,25)
		_self.asigna_texto_celda(:tbl_Inventario_Datos,ln_reng_ini,4,ls_value_lin_multi,25)
		_self.asigna_texto_celda(:tbl_Inventario_Datos,ln_reng_ini,5,ls_value_lin_compe,25)
		_self.asigna_texto_celda(:tbl_Inventario_Datos,ln_reng_ini,6,ls_value_lin_inal,25)
		_self.asigna_texto_celda(:tbl_Inventario_Datos,ln_reng_ini,7,ls_value_solicitud,25)
		_self.asigna_texto_celda(:tbl_Inventario_Datos,ln_reng_ini,8,ls_viv_sin_serv,25)
		_self.asigna_texto_celda(:tbl_Inventario_Datos,ln_reng_ini,10,ls_lin_satura,25)

		ln_reng_ini +<< 1
	_endloop

	#Asigna los totales del inventario
	_self.asigna_texto_celda(:tbl_Inventario_Datos,13,2,
				 lp_datos_tot_viv_lin[:viviendas].default("").write_string,25)
	_self.asigna_texto_celda(:tbl_Inventario_Datos,13,3,
				 lp_datos_tot_viv_lin[:abonados].default("").write_string,25)
	_self.asigna_texto_celda(:tbl_Inventario_Datos,13,4,
				 lp_datos_tot_viv_lin[:lineas_multiplicador].default("").write_string,25)
	_self.asigna_texto_celda(:tbl_Inventario_Datos,13,5,
				 lp_datos_tot_viv_lin[:lineas_competencia].default("").write_string,25)
	_self.asigna_texto_celda(:tbl_Inventario_Datos,13,6,
				 lp_datos_tot_viv_lin[:lineas_inalambricas].default("").write_string,25)
	_self.asigna_texto_celda(:tbl_Inventario_Datos,13,7,
				 lp_datos_tot_viv_lin[:solicitudes].default("").write_string,25)
	_self.asigna_texto_celda(:tbl_Inventario_Datos,13,8,
				 lp_datos_tot_viv_lin[:viv_sin_servicio].default("").write_string,25)
	_self.asigna_texto_celda(:tbl_Inventario_Datos,13,10,lp_datos_lin_satura[:|Total|].default("").write_string,25)
	_self.asigna_texto_celda(:tbl_PSLT,5,4,tot_lin_distrito.write_string,25)
	_self.asigna_texto_celda(:tbl_Ocupacion,4,4,tot_lin_distrito.write_string,25)

	.o_tablas.elemento(:tbl_Ocupacion).oCeldas.Celda(4,4).oElemento.sEstilo << "Bold"

_endmethod
$
_pragma(classify_level=restricted, usage={redefinable})
_method c_sello_red_secundaria.obten_registros()


	pl_datos << property_list.new()

	.o_distrito.col_lin_sat      << hash_table.new()
	.o_distrito.o_format_float   << float_format.new(:float_decimal_places, 2)
	.o_distrito.inventario       << hash_table.new()
	.o_distrito.col_viv_lin      << hash_table.new()
	.o_distrito.col_tel_publicos << hash_table.new()
	.o_distrito.col_lotes        << rope.new()
	.o_distrito.col_lin_sat      << hash_table.new()
	.o_distrito.dto_nse_pred     << ""
	.o_distrito.asigna_distrito( .o_proyecto.distrito)

	pl_datos[:opb]             <<  _self.valor_propiedad(:opb,     .o_distrito.opb  )
	pl_datos[:oeis]           <<   _self.valor_propiedad(:oeis,    .o_distrito.oei  )
	pl_datos[:oe_cons]        <<   _self.valor_propiedad(:oe_cons, .o_distrito.oe(:construccion))
	pl_datos[:oe_desm]        <<   _self.valor_propiedad(:oe_desm, .o_distrito.oe(:desmontaje))
	pl_datos[:oe_reco]        <<   _self.valor_propiedad(:oe_reco, .o_distrito.oe(:reconcentracion))
	pl_datos[:pep_cons_sec]   <<   _self.valor_propiedad(:pep_cons_sec, .o_proyecto.pep_cons_sec )
	pl_datos[:pep_desm_sec]   <<   _self.valor_propiedad(:pep_desm_sec, .o_proyecto.pep_desm_sec )
	pl_datos[:pep_reco_sec]   <<   _self.valor_propiedad(:pep_reco_sec, .o_proyecto.pep_reco_sec )
	pl_datos[:numero_manzanas] <<  _self.valor_propiedad(:numero_manzanas, .o_distrito.cantidad_manzanas.write_string)
	
	_if .o_distrito.cajas_existentes.size > 1 _andif
	    _self.attributes[:observaciones].value.write_string.size = 0
	_then
		_self.attributes[:observaciones].value << "El Distrito tiene más de una CD Existente, "+
			"por lo tanto los datos de Tipo y Distancia a O.C. se toman de la primera CD"
	_endif

         lcol_attrib << {:canalizacion,:principal}
 
         # se obtienen las PEPs de referencias
	_for att _over lcol_attrib.fast_elements()
	_loop
		pl_datos[att] << " "
		ls_pep << _self.attributes[att].value.write_string
		l_cad << ls_pep.split_by("--")
		_if l_cad.size > 0
		_then
			pl_datos[att] << " " + l_cad[1]
		_endif		
	_endloop

	pl_datos[:corte_caja_princ] << .o_distrito.corte_caja_red_princ
	pl_datos[:corte_caja_sec]   << .o_distrito.corte_caja_red_sec
	pl_datos[:ctl_dto]          << .o_distrito.nombre_cd
	pl_datos[:tipo_dto]         << .o_distrito.tipo_caja
	pl_datos[:distancia_oc]     << .o_distrito.distancia_cd_oc
	pl_datos[:viv_lin]          << .o_distrito.viviendas_lineas
	pl_datos[:lin_satura]       << .o_distrito.lineas_saturacion
	pl_datos[:tot_viv_lin]      << .o_distrito.total_viv_lin
	pl_datos[:tot_lin_dto]      << .o_distrito.total_lineas_distrito
	pl_datos[:factor_pen]       << .o_distrito.factor_pen_nse
	pl_datos[:num_escuelas]     << .o_distrito.numero_escuelas
	pl_datos[:num_iglesias]     << .o_distrito.numero_iglesias
	pl_datos[:num_baldios]      << .o_distrito.numero_baldios
	pl_datos[:tipo_operacion]   << .o_proyecto.tipo_operacion	
	pl_datos[:realizo_inv]      << .o_proyecto.realizo_inventario
	pl_datos[:proyectista]      << .o_proyecto.proyectista_disenio
	pl_datos[:supervisor]       << .o_proyecto.supervisor_disenio
	pl_datos[:supervisor_tmx]   << .o_proyecto.supervisor_telmex_disenio
	pl_datos[:tel_publicos]     << .o_distrito.telefonos_publicos
	pl_datos[:lineas_tmx]       << .o_distrito.total_lineas_telmex
	pl_datos[:superficie_km]    << .o_distrito.superficie_km
	pl_datos[:lote_promedio]    << .o_distrito.o_format_float.format(.o_distrito.tam_lote_promedio_m)
	pl_datos[:cantidad_lotes]   << .o_distrito.cantidad_lotes
	pl_datos[:resumen_pares]    << .o_distrito.resumen_pares
	pl_datos[:ocupacion]        << .o_distrito.ocupacion
	pl_datos[:faltas_danios]    << .o_distrito.faltas_y_danios
	pl_datos[:km_cable]         << .o_distrito.resumen_km_cable()
	pl_datos[:fecha]            << c_traductor.mes(date_now().month_number) + " / " +
				       date_now().year.write_string
	_return pl_datos
	
_endmethod
$
_pragma(classify_level=restricted, usage={redefinable})
_method c_sello_red_secundaria.valor_propiedad(Propiedad, dato_actual)
	## 
	##

	LoPropiedad << ""
	
	_if _self.attributes[Propiedad]  _isnt _unset  _andif
	    _self.attributes[Propiedad].value _isnt _unset _andif
	    _self.attributes[Propiedad].value.size > 0
	_then
	
		LoPropiedad << _self.attributes[Propiedad].value.write_string
	_else
		LoPropiedad << dato_actual
	_endif

	_return LoPropiedad
	
	
_endmethod
$
