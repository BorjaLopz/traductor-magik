	_self.asigna_texto_celda(:tbl_Red_Datos,2,3,lcol_resumen_pares[:|Con|,:|Aum|].default("").write_string,25)
	_self.asigna_texto_celda(:tbl_Red_Datos,2,4,lcol_resumen_pares[:|Con|,:|Tot|].default("").write_string,25)
	_self.asigna_texto_celda(:tbl_Red_Datos,3,2,lcol_resumen_pares[:|Res|,:|Act|].default("").write_string,25)
	_self.asigna_texto_celda(:tbl_Red_Datos,3,3,lcol_resumen_pares[:|Res|,:|Aum|].default("").write_string,25)
	_self.asigna_texto_celda(:tbl_Red_Datos,3,4,lcol_resumen_pares[:|Res|,:|Tot|].default("").write_string,25)
	_self.asigna_texto_celda(:tbl_Red_Datos,4,2,lcol_resumen_pares[:|Tot|,:|Act|].default("").write_string,25)
	_self.asigna_texto_celda(:tbl_Red_Datos,4,3,lcol_resumen_pares[:|Tot|,:|Aum|].default("").write_string,25)
	_self.asigna_texto_celda(:tbl_Red_Datos,4,4,lcol_resumen_pares[:|Tot|,:|Tot|].default("").write_string,25)

	_self.asigna_texto_celda(:tbl_Ocupacion,2,5,lcol_ocupacion[:|Inicial|].default("").write_string,25)
	_self.asigna_texto_celda(:tbl_Ocupacion,3,5,lcol_ocupacion[:|Final|].default("").write_string,25)
	_self.asigna_texto_celda(:tbl_Ocupacion,4,5,lcol_ocupacion[:|Saturacion|].default("").write_string,25)

	.o_tablas.elemento(:tbl_Red_Datos).oCeldas.Celda(2,3).oElemento.sEstilo << "Bold"
	.o_tablas.elemento(:tbl_Red_Datos).oCeldas.Celda(2,4).oElemento.sEstilo << "Bold"
	.o_tablas.elemento(:tbl_Red_Datos).oCeldas.Celda(3,3).oElemento.sEstilo << "Bold"
	.o_tablas.elemento(:tbl_Red_Datos).oCeldas.Celda(3,4).oElemento.sEstilo << "Bold"
	.o_tablas.elemento(:tbl_Red_Datos).oCeldas.Celda(4,3).oElemento.sEstilo << "Bold"
	.o_tablas.elemento(:tbl_Red_Datos).oCeldas.Celda(4,4).oElemento.sEstilo << "Bold"
	.o_tablas.elemento(:tbl_Ocupacion).oCeldas.Celda(3,5).oElemento.sEstilo << "Bold"
	.o_tablas.elemento(:tbl_Ocupacion).oCeldas.Celda(4,5).oElemento.sEstilo << "Bold"

_endmethod
