_pragma(classify_level=restricted, usage={redefinable})
_method c_sello_red_secundaria.inicializa( properties )

	# vbluna(23-feb-07)
	# - Se agrega el parámetro: properties como resultado de las
	#   modificaciones para almacenar los valores del sello
	#   en archivo .xml

	.pl_terminal_1 << {:|A|,:|B|,:|C|,:|D|,:|E|,:|F|,:|G|,:|H|,:|J|,:|K|}
	.pl_terminal_2 << {:|L|,:|M|,:|O|,:|P|,:|R|,:|S|}
	.pl_terminal_esp << {:|T|,:|U|,:|V|,:|X|,:|Y|,:|Z|}
	.pl_num_terminal << {:|1|,:|2|,:|3|,:|4|,:|5|,:|SUMA|}
	.pl_nse << {:|A|,:|B|,:|C|,:|D|,:|E|,:|C1|,:|C2|,:|C3|,:|IP|,:|IM|,:|IL|}

	.nota_tipo_empalme <<  character.newline + "TODOS LOS EMPALMES PROYECTADOS SON "
	.nota_tipo_terminal << "TODAS LAS TERMINALES PROYECTADAS SON TIPO "
	.nota_tipo_cable << "TODO EL CABLE PROYECTADO SERA "
	.notas_fijas << "CALIBRE (0.4) EXCEPTO EL MARCADO." + character.newline +
			 character.newline +
			 "EN TODOS LOS FINALES DE CORRIDA MULTISERVICIO SE" + character.newline +
			 "CORTARAN LOS PARES MUERTOS SOBRANTES AL RAS DEL CABLE" + character.newline +
			 character.newline +
			 "TODOS LOS BAJANTES EN MAL ESTADO, CON UNIONES O" + character.newline +
			 "APOYADOS EN CABLES Y/O POSTES AJENOS, O QUE SALEN DE SU" + character.newline +
			 "AREA DE INFLUENCIA, SE DEBEN CAMBIAR Y/O RECONCENTRAR." + character.newline +
			 character.newline +
			 "TODO POSTE EXISTENTE Y PROYECTADO ES DE 25'', EXCEPTO " + character.newline +
			 "LOS MARCADOS." + character.newline +
			 character.newline +
			 "EL CONTRATISTA RECTIFICARA O RATIFICARA LAS DISTANCIAS" + character.newline +
			 "INTERPOSTALES Y LONGITUDES DE CENTRO A CENTRO DE POZO" + character.newline +
			 "LAS SECCIONES TRANSVERSALES Y SU OCUPACION"

	_super.inicializa( properties )
	
_endmethod
$
_pragma(classify_level=advanced, topic={plotting}, usage={subclassable})
_method c_sello_red_secundaria.llena_corte_caja_princ(p_pl_datos)

	_local ln_reng_ini << 4
	_local s_strip
	_local s_valor

	_for n_strip, n_valor _over p_pl_datos[:corte_caja_princ].fast_keys_and_elements()
	_loop
		s_strip << n_strip.default("").write_string
		s_valor << n_valor.default("").write_string
		
		_if n_strip = :|Total|
		_then
			_self.asigna_texto_celda(:tbl_Corte_Caja_2,11,9,s_valor,25)
		_else 
			_if ln_reng_ini <= 11
			_then
				_self.asigna_texto_celda(:tbl_Corte_Caja_1,ln_reng_ini,8,s_strip,25)
				_self.asigna_texto_celda(:tbl_Corte_Caja_1,ln_reng_ini,9,s_valor,25)
			_else	
				_self.asigna_texto_celda(:tbl_Corte_Caja_2,ln_reng_ini-8,8,s_strip,25)
				_self.asigna_texto_celda(:tbl_Corte_Caja_2,ln_reng_ini-8,9,s_valor,25)
			_endif
			ln_reng_ini +<< 1
		_endif
	_endloop
_endmethod
$
_pragma(classify_level=advanced, topic={plotting}, usage={subclassable})
_method c_sello_red_secundaria.llena_corte_caja_sec(p_pl_datos)

     _local pl_datos << p_pl_datos[:corte_caja_sec]

     _if pl_datos.size <> 0
     _then
	_local ln_reng_ini
	_local ln_num_col
	_local ls_valor
	_local etiq_term_esp << equality_set.new()

	_self.asigna_texto_celda(:tbl_Corte_Caja_2,11,7,pl_datos[:|Total|,:|Total|].default("").write_string,25)

	_for n_t _over .pl_num_terminal.fast_elements()
	_loop
		n_term << n_t.as_symbol()
		ln_reng_ini << 3

		_if n_term = :|SUMA|
		_then
			ln_num_col << 7
		_else
			ln_num_col << n_term.default(0).as_number() + 1
		_endif

		_for t _over .pl_terminal_1.fast_elements()
		_loop
			term << t.as_symbol()
			ls_valor << pl_datos[term,n_term]
			_self.asigna_texto_celda(:tbl_Corte_Caja_1,ln_reng_ini,ln_num_col,ls_valor.default("").write_string,25)
			ln_reng_ini +<< 1
		_endloop

		ln_reng_ini << 3
		
		_for t _over .pl_terminal_2.fast_elements()
		_loop
			term << t.as_symbol()
			ls_valor << pl_datos[term,n_term]
			_self.asigna_texto_celda(:tbl_Corte_Caja_2,ln_reng_ini,ln_num_col,ls_valor.default("").write_string,25)
			ln_reng_ini +<< 1
		_endloop

		#Llena la parte de las terminales especiales
		
		ln_reng_ini << 9
		_for t _over .pl_terminal_esp.fast_elements()
		_loop
			term << t.as_symbol()
			_if ln_reng_ini < 11
			_then
				_if pl_datos.includes_key?({term,n_term})
				_then
					etiq_term_esp.add(term.default("").write_string)
					ls_valor << pl_datos[term,n_term]
					_self.asigna_texto_celda(:tbl_Corte_Caja_2,ln_reng_ini,
								 ln_num_col,ls_valor.default("").write_string,25)
					ln_reng_ini +<< 1
				_endif
			_endif
		_endloop
	_endloop

	ln_reng_ini << 9
	
	#Asigna las etiquetas correspondientes a las terminales especiales
	_for te _over etiq_term_esp.fast_elements()
	_loop
		term_esp << te.as_symbol()
		_self.asigna_texto_celda(:tbl_Corte_Caja_2,ln_reng_ini,1,term_esp,33)
		ln_reng_ini +<< 1
	_endloop
    _endif

_endmethod
$
_pragma(classify_level=advanced, topic={plotting}, usage={subclassable})
_method c_sello_red_secundaria.llena_datos_celdas()

	_local pl_datos << _self.obten_registros()

	_self.asigna_texto_celda(:tbl_corte_caja_2,11,4,pl_datos[:fecha],25)
	_self.asigna_texto_celda(:tbl_Red_Datos,5,4,pl_datos[:fecha],25)

	_self.llena_corte_caja_princ(pl_datos)
	_self.llena_corte_caja_sec(pl_datos)
	_self.llena_informacion_dto(pl_datos)
	_self.llena_viv_lin(pl_datos)
	_self.llena_factor_pen(pl_datos)
	_self.llena_tipo_lote(pl_datos)
	_self.llena_datos_proyecto(pl_datos)
	_self.llena_tel_publicos(pl_datos)
	_self.llena_datos_superficie(pl_datos)
	_self.llena_ocupacion_red(pl_datos)
	_self.llena_faltas_danios(pl_datos)
	_self.llena_km_cable(pl_datos)
	
_endmethod
$
_pragma(classify_level=advanced, topic={plotting}, usage={subclassable})
_method c_sello_red_secundaria.llena_datos_dinamicos()
	
	_local ls_fecha << c_traductor.mes(date_now().month_number) + " / " + date_now().year.write_string
	_local ls_num_hoja << "PLANO: " + _self.attributes[:hoja].value.default("").write_string
	_local ls_num_tot_hojas << "DE: " + _self.attributes[:total_hojas].value.default("").write_string
	_local ls_observaciones << _self.attributes[:observaciones].value.default("").write_string
	_local ls_pisa << _self.attributes[:pisa].value.default("").write_string
	_local ls_tipo_empalme << _self.attributes[:tipo_empalme].value.default("").write_string
	_local ls_tipo_terminal << _self.attributes[:tipo_terminal].value.default("").write_string
	_local ls_tipo_cable << _self.attributes[:tipo_cable].value.default("").write_string
	_local ls_direccion <<  _self.attributes[:direccion_cd].value.default("").write_string
	_local ls_manzanas <<  _self.attributes[:numero_manzanas].value.default("").write_string
	_local ls_oeis << _self.attributes[:oeis].value.default("").write_string

	_local ls_notas

	_if ls_observaciones.size > 65
	_then
		ls_obs1 << ls_observaciones.slice(1,65)
		ls_obs2 << ls_observaciones.slice(66,ls_observaciones.size)
	_else
		ls_obs1 << ls_observaciones
	_endif

	_self.asigna_texto_celda(:tbl_Red_Datos,5,6,ls_manzanas,25)
	_self.asigna_texto_celda(:tbl_Corte_Caja_2,1,4,ls_direccion,30,:centre_left)
	_self.asigna_texto_celda(:tbl_corte_caja_2,11,4,ls_fecha,25)
	_self.asigna_texto_celda(:tbl_Red_Datos,5,4,ls_fecha,25)
	_self.asigna_texto_celda(:tbl_Red_Datos,8,5,ls_num_hoja,25)
	_self.asigna_texto_celda(:tbl_Red_Datos,8,6,ls_num_tot_hojas,25)
	_self.asigna_texto_celda(:tbl_Red_Datos,6,2,ls_obs1,30,:centre_left)
	_self.asigna_texto_celda(:tbl_Red_Datos,7,1,ls_obs2,30,:centre_left,1)
	
	_self.asigna_texto_celda(:tbl_inf_adm_2,8,3,ls_pisa,25, _unset , _unset , {1,0,0}  )
	
	.o_tablas.elemento(:tbl_inf_adm_2).oCeldas.Celda(8,3).oElemento.sEstilo << "Bold"

	lo_texto << c_texto_grafico.new(ls_tipo_empalme)
	lo_texto.nTamanio    << 20
	lo_texto.sEstilo     << "Bold"
	_if _self.attributes[:blanco_negro].value = "SI"
	_then
	   lo_texto.sColor << colour.new_rgb(0.0,0.0,0.0)
	_else
	   lo_texto.sColor << colour.new_rgb(.o_color_linea[1],.o_color_linea[2],.o_color_linea[3])
	_endif
	lo_texto.sAlineacion << :top_left
	lo_texto.nmargen_izq  << 34
	lo_texto.nmargen_sup  << 2
	.o_tablas.elemento(:tbl_Notas).oCeldas.Celda(2,2).oElementos.Agregar_elemento(lo_texto,:tipo_emp) 

	lo_texto << c_texto_grafico.new_from(lo_texto,ls_tipo_terminal)
	lo_texto.nmargen_izq  << 40
	lo_texto.nmargen_sup  << 6.5
	.o_tablas.elemento(:tbl_Notas).oCeldas.Celda(2,2).oElementos.Agregar_elemento(lo_texto,:tipo_term) 

	lo_texto << c_texto_grafico.new_from(lo_texto,ls_tipo_cable)
	lo_texto.nmargen_izq  << 27
	lo_texto.nmargen_sup  << 10.9
	.o_tablas.elemento(:tbl_Notas).oCeldas.Celda(2,2).oElementos.Agregar_elemento(lo_texto,:tipo_cab) 

	txt_oies << c_texto_grafico.new_from(lo_texto, ls_oeis)
	txt_oies.sAlineacion << :centre_centre
	txt_oies.nTamanio    << 25
	
	.o_tablas.elemento(:tbl_inf_adm_1).oCeldas.Celda(2,3).oElementos.Agregar_elemento(txt_oies,:oeis)


	# START CHANGE
	# (12/11/23 fhramire) : 
	#
	
	_local ls_opb             <<   _self.valor_propiedad(:opb,    ""  )
	_local ls_oe_cons         <<   _self.valor_propiedad(:oe_cons, "")
	_local ls_oe_desm         <<   _self.valor_propiedad(:oe_desm, "")
	_local ls_oe_reco         <<   _self.valor_propiedad(:oe_reco, "" )
	_local ls_pep_cons_sec    <<   _self.valor_propiedad(:pep_cons_sec, "" )
	_local ls_pep_desm_sec    <<   _self.valor_propiedad(:pep_desm_sec, "" )
	_local ls_pep_reco_sec    <<   _self.valor_propiedad(:pep_reco_sec, "" )
	_local ls_numero_manzanas <<   _self.valor_propiedad(:numero_manzanas, "")
	_local ls_canalizacion    <<   _self.valor_propiedad(:canalizacion, "")
	_local ls_principal       <<   _self.valor_propiedad(:principal, "")

	_self.asigna_texto_celda(:tbl_inf_adm_1,2,2, ls_opb ,25, _unset , _unset , {1,0,0}  )
	_self.asigna_texto_celda(:tbl_inf_adm_2,2,2, ls_oe_cons ,25      , _unset , _unset , {1,0,0}  )	
	_self.asigna_texto_celda(:tbl_inf_adm_2,3,2, ls_oe_desm ,25      , _unset , _unset , {1,0,0} )
	_self.asigna_texto_celda(:tbl_inf_adm_2,4,2, ls_oe_desm, 25      , _unset , _unset , {1,0,0} )
	_self.asigna_texto_celda(:tbl_inf_adm_2,2,3, ls_pep_cons_sec,25  , _unset , _unset , {1,0,0})
	_self.asigna_texto_celda(:tbl_inf_adm_2,3,3, ls_pep_desm_sec,25  , _unset , _unset , {1,0,0})
	_self.asigna_texto_celda(:tbl_inf_adm_2,4,3, ls_pep_reco_sec,25  , _unset , _unset , {1,0,0})
	_self.asigna_texto_celda(:tbl_inf_adm_2,6,3,ls_canalizacion, 25  , _unset , _unset , {1,0,0})
	_self.asigna_texto_celda(:tbl_inf_adm_2,7,3, ls_principal , 25   , _unset , _unset , {1,0,0})


	.o_tablas.elemento(:tbl_inf_adm_1).oCeldas.Celda(2,2).oElemento.sEstilo << "Bold"
	.o_tablas.elemento(:tbl_inf_adm_2).oCeldas.Celda(2,2).oElemento.sEstilo << "Bold"
	.o_tablas.elemento(:tbl_inf_adm_2).oCeldas.Celda(3,2).oElemento.sEstilo << "Bold"
	.o_tablas.elemento(:tbl_inf_adm_2).oCeldas.Celda(4,2).oElemento.sEstilo << "Bold"
	.o_tablas.elemento(:tbl_inf_adm_2).oCeldas.Celda(2,3).oElemento.sEstilo << "Bold"
	.o_tablas.elemento(:tbl_inf_adm_2).oCeldas.Celda(3,3).oElemento.sEstilo << "Bold"
	.o_tablas.elemento(:tbl_inf_adm_2).oCeldas.Celda(4,3).oElemento.sEstilo << "Bold"
	.o_tablas.elemento(:tbl_inf_adm_2).oCeldas.Celda(6,3).oElemento.sEstilo << "Bold"
	.o_tablas.elemento(:tbl_inf_adm_2).oCeldas.Celda(7,3).oElemento.sEstilo << "Bold"
	
	#
	# END CHANGE
	
_endmethod
