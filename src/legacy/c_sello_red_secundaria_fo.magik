_pragma(classify_level=restricted, usage={redefinable})
_method c_sello_red_secundaria_fo.obten_registros()


	pl_datos << property_list.new()

	.o_distrito.col_lin_sat      << hash_table.new()
	.o_distrito.o_format_float   << float_format.new(:float_decimal_places, 2)
	.o_distrito.inventario       << hash_table.new()
	.o_distrito.col_viv_lin      << hash_table.new()
	.o_distrito.col_tel_publicos << hash_table.new()
	.o_distrito.col_lotes        << rope.new()
	.o_distrito.col_lin_sat      << hash_table.new()
	.o_distrito.dto_nse_pred     << ""
	
	.o_distrito.asigna_distrito( .o_proyecto.distrito)

	#datos red
	pl_datos[:distancia_oc]            << .o_distrito.distancia_cedo_oc
	pl_datos[:distancia_nco]           << .o_distrito.distancia_cedo_nco
	pl_datos[:distancia_promedio]      << .o_distrito.distancia_promedio_bajante
	pl_datos[:porcentaje_penetracion]  << .o_distrito.porcentaje_de_penetracion
	
	pl_datos[:viv_lin]          << .o_distrito.viviendas_lineas
	pl_datos[:lin_satura]       << .o_distrito.lineas_saturacion
	pl_datos[:tot_viv_lin]      << .o_distrito.total_viv_lin
	pl_datos[:tot_lin_dto]      << .o_distrito.total_lineas_distrito
	pl_datos[:factor_pen]       << .o_distrito.factor_pen_nse
	pl_datos[:num_escuelas]     << .o_distrito.numero_escuelas
	pl_datos[:num_iglesias]     << .o_distrito.numero_iglesias
	pl_datos[:num_baldios]      << .o_distrito.numero_baldios
	pl_datos[:numero_manzanas] <<  .o_distrito.cantidad_manzanas
	pl_datos[:tipo_operacion]   << .o_proyecto.tipo_operacion	
	pl_datos[:realizo_inv]      << .o_proyecto.realizo_inventario
	##responsables
	pl_datos[:proyectista]      << .o_proyecto.proyectista_disenio.substitute_character(%space, %newline)
	pl_datos[:supervisor]       << .o_proyecto.supervisor_disenio.substitute_character(%space, %newline)
	pl_datos[:supervisor_tmx]   << .o_proyecto.supervisor_telmex_disenio.substitute_character(%space, %newline)

	pl_datos[:tel_publicos]     << .o_distrito.telefonos_publicos
	pl_datos[:lineas_tmx]       << .o_distrito.total_lineas_telmex
	pl_datos[:superficie_km]    << .o_distrito.superficie_km
	pl_datos[:lote_promedio]    << .o_distrito.tam_lote_promedio_m
	pl_datos[:cantidad_lotes]   << .o_distrito.cantidad_lotes
	pl_datos[:resumen_pares]    << .o_distrito.resumen_pares
	pl_datos[:ocupacion]        << .o_distrito.ocupacion
	pl_datos[:faltas_danios]    << .o_distrito.faltas_y_danios
	pl_datos[:km_cable]         << .o_distrito.resumen_km_cable()
	pl_datos[:fecha_recorrido]  << .o_distrito.fecha_recorrido
	pl_datos[:fecha_inventario] << .o_distrito.fecha_inventario
	#info administrativa
	#
	pl_datos[:opb]             <<    .o_distrito.opb
	pl_datos[:oeis]            <<    .o_distrito.oei
	pl_datos[:oe_cons]         <<    .o_distrito.oe(:construccion)
	pl_datos[:oe_desm]         <<    .o_distrito.oe(:desmontaje)
	pl_datos[:oe_canal]        <<    .o_distrito.oe(:canalizacion)
	pl_datos[:oe_reco]         <<    .o_distrito.oe(:reconcentracion)
	(info,pl_datos[:pep_cons_sec])    <<    .o_distrito.pep_referencias("CONSTRUCCION",    :secundaria )	
	(info,pl_datos[:pep_desm_sec])    <<    .o_distrito.pep_referencias("DESMONTAJE",      :secundaria )
	(info,pl_datos[:pep_reco_sec])    <<    .o_distrito.pep_referencias("RECONCENTRACION", :secundaria )
	(info,pl_datos[:pep_canal_sec])   <<    .o_distrito.pep_referencias(_unset  ,    :canalizacion)
	(info,pl_datos[:ls_canalizacion]) <<    .o_distrito.pep_referencias(_unset  ,    :canalizacion)
	(info,pl_datos[:ls_principal])    <<    .o_distrito.pep_referencias(_unset  ,    :principales)

	pl_datos << _self.info_sello_propiedades(pl_datos) 
	
	_return pl_datos
	
_endmethod
$
_pragma(classify_level=restricted, usage={redefinable})
_method c_sello_red_secundaria_fo.info_sello_propiedades(pl_datos)

	pl_datos[:opb]               <<   _self.valor_propiedad(:opb,            .o_distrito.opb  )
	pl_datos[:oeis]              <<   _self.valor_propiedad(:oeis,           .o_distrito.oei  )
	pl_datos[:oe_cons]           <<   _self.valor_propiedad(:oe_cons,       pl_datos[:oe_cons]  )
	pl_datos[:oe_desm]           <<   _self.valor_propiedad(:oe_desm,       pl_datos[:oe_desm]  )
	pl_datos[:oe_canal]          <<   _self.valor_propiedad(:oe_canal,      pl_datos[:oe_canal] )
	pl_datos[:oe_reco]           <<   _self.valor_propiedad(:oe_reco,       pl_datos[:oe_reco]  )
	pl_datos[:pep_cons_sec]      <<   _self.valor_propiedad(:pep_cons_sec,  pl_datos[:pep_cons_sec]  )
	pl_datos[:pep_desm_sec]      <<   _self.valor_propiedad(:pep_desm_sec,  pl_datos[:pep_desm_sec]  )
	pl_datos[:pep_reco_sec]      <<   _self.valor_propiedad(:pep_reco_sec,  pl_datos[:pep_reco_sec]  )
	pl_datos[:pep_canal_sec]      <<   _self.valor_propiedad(:pep_canal_sec,pl_datos[:pep_canal_sec] )
	pl_datos[:ls_canalizacion]   <<   _self.valor_propiedad(:canalizacion,  pl_datos[:ls_canalizacion]  )
	pl_datos[:ls_principal]      <<   _self.valor_propiedad(:principal,     pl_datos[:ls_principal] )
	pl_datos[:programa_proyecto] <<   _self.valor_propiedad(:programa_proyecto,   "")
	pl_datos[:tipored_proyecto]  <<   _self.valor_propiedad(:tipored_proyecto,    "")

	pl_datos[:distancia_oc]            <<  _self.valor_propiedad(:distancia_oc,   "")
	pl_datos[:distancia_nco]           <<  _self.valor_propiedad(:distancia_nco,   "")
	pl_datos[:distancia_promedio]      <<  _self.valor_propiedad(:distancia_promedio,   "")
	pl_datos[:porcentaje_penetracion]  <<  _self.valor_propiedad(:porcentaje_penetracion,   "")

	pl_datos[:numero_manzanas]         <<  _self.valor_propiedad(:numero_manzanas, pl_datos[:numero_manzanas])
	pl_datos[:fecha_recorrido]         <<  _self.valor_propiedad(:fecha_recorrido,.o_distrito.fecha_recorrido )
	pl_datos[:fecha_inventario]        <<  _self.valor_propiedad(:fecha_inventario,.o_distrito.fecha_inventario)
	
	_return pl_datos
	
_endmethod
$
_pragma(classify_level=restricted, usage={redefinable})
_method c_sello_red_secundaria_fo.valor_propiedad(Propiedad, dato_actual)
	## 
	##
	_if _self.attributes[Propiedad]  _isnt _unset  _andif
	    _self.attributes[Propiedad].value _isnt _unset _andif
	    _self.attributes[Propiedad].value.write_string.size > 0
	_then
		LoPropiedad << _self.attributes[Propiedad].value.write_string.uppercase
	_else
		LoPropiedad << dato_actual
	_endif

	_return LoPropiedad
	
	
_endmethod
$
