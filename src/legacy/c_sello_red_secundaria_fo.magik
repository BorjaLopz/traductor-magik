_pragma(classify_level=advanced, topic={plotting}, usage={subclassable})
_method c_sello_red_secundaria_fo.etiqueta_celdas()

	_local lrope_textos

	_self.asigna_texto_celda(:tbl_etiq_red_sec,1,1,"RED SECUNDARIA FTTH",60)	
	_self.asigna_texto_celda(:tbl_inf_adm_1,1,1,"O.P.B",40)
	_self.asigna_texto_celda(:tbl_inf_adm_1,1,2,"O.E.I",40)

	
	_self.asigna_texto_celda(:tbl_inf_adm_2,1,1,"O.E.'S",40,:centre_right)
	_self.asigna_texto_celda(:tbl_inf_adm_2,1,3,"P.E.P.'S",40)
	_self.asigna_texto_celda(:tbl_inf_adm_2,2,1,"CONSTRUCCION",20,:centre_left,1)
	_self.asigna_texto_celda(:tbl_inf_adm_2,3,1,"DESMONTAJE",20,:centre_left,1)
	_self.asigna_texto_celda(:tbl_inf_adm_2,4,1,"RECONCENTRACION",20,:centre_left,1)
	_self.asigna_texto_celda(:tbl_inf_adm_2,5,1,"CANALIZACION",20,:centre_left,1)
	
	_self.asigna_texto_celda(:tbl_inf_adm_2,6,1,"REFERENCIAS",40,:centre_centre,14)
	_self.asigna_texto_celda(:tbl_inf_adm_2,7,1,"CANALIZACION",20,:centre_left,1)
	_self.asigna_texto_celda(:tbl_inf_adm_2,8,1,"PRINCIPALES",20,:centre_left,1)
	
