	.o_tablas.elemento(:tbl_Red_Datos).oCeldas.Celda(5,4).oElemento.sEstilo << "Bold"
	
	.o_tablas.elemento(:tbl_Red_Datos).oCeldas.Celda(7,2).oElemento.sEstilo << "Bold"
	.o_tablas.elemento(:tbl_Red_Datos).oCeldas.Celda(7,5).oElemento.sEstilo << "Bold"
