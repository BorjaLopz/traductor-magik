_pragma(classify_level=advanced, topic={plotting}, usage={subclassable})
_method c_sello_red_secundaria_fo.llena_corte_caja_princ(p_pl_datos)

	_local ln_reng_ini << 4
	_local s_strip
	_local s_valor

	_for n_strip, n_valor _over p_pl_datos[:corte_caja_princ].fast_keys_and_elements()
	_loop
		s_strip << n_strip.default("").write_string
		s_valor << n_valor.default("").write_string
		
		_if n_strip = :|Total|
		_then
			_self.asigna_texto_celda(:tbl_Corte_Caja_2,11,9,s_valor,25)
		_else 
			_if ln_reng_ini <= 11
			_then
				_self.asigna_texto_celda(:tbl_Corte_Caja_1,ln_reng_ini,8,s_strip,25)
				_self.asigna_texto_celda(:tbl_Corte_Caja_1,ln_reng_ini,9,s_valor,25)
			_else	
				_self.asigna_texto_celda(:tbl_Corte_Caja_2,ln_reng_ini-8,8,s_strip,25)
				_self.asigna_texto_celda(:tbl_Corte_Caja_2,ln_reng_ini-8,9,s_valor,25)
			_endif
			ln_reng_ini +<< 1
		_endif
	_endloop
_endmethod
$
_pragma(classify_level=advanced, topic={plotting}, usage={subclassable})
_method c_sello_red_secundaria_fo.llena_corte_caja_sec(p_pl_datos)

     _local pl_datos << p_pl_datos[:corte_caja_sec]

     _if pl_datos.size <> 0
     _then
	_local ln_reng_ini
	_local ln_num_col
	_local ls_valor
	_local etiq_term_esp << equality_set.new()

	_self.asigna_texto_celda(:tbl_Corte_Caja_2,11,7,pl_datos[:|Total|,:|Total|].default("").write_string,25)

	_for n_t _over .pl_num_terminal.fast_elements()
	_loop
		n_term << n_t.as_symbol()
		ln_reng_ini << 3

		_if n_term = :|SUMA|
		_then
			ln_num_col << 7
		_else
			ln_num_col << n_term.default(0).as_number() + 1
		_endif

		_for t _over .pl_terminal_1.fast_elements()
		_loop
			term << t.as_symbol()
			ls_valor << pl_datos[term,n_term]
			_self.asigna_texto_celda(:tbl_Corte_Caja_1,ln_reng_ini,ln_num_col,ls_valor.default("").write_string,25)
			ln_reng_ini +<< 1
		_endloop

		ln_reng_ini << 3
		
		_for t _over .pl_terminal_2.fast_elements()
		_loop
			term << t.as_symbol()
			ls_valor << pl_datos[term,n_term]
			_self.asigna_texto_celda(:tbl_Corte_Caja_2,ln_reng_ini,ln_num_col,ls_valor.default("").write_string,25)
			ln_reng_ini +<< 1
		_endloop

		#Llena la parte de las terminales especiales
		
		ln_reng_ini << 9
		_for t _over .pl_terminal_esp.fast_elements()
		_loop
			term << t.as_symbol()
			_if ln_reng_ini < 11
			_then
				_if pl_datos.includes_key?({term,n_term})
				_then
					etiq_term_esp.add(term.default("").write_string)
					ls_valor << pl_datos[term,n_term]
					_self.asigna_texto_celda(:tbl_Corte_Caja_2,ln_reng_ini,
								 ln_num_col,ls_valor.default("").write_string,25)
					ln_reng_ini +<< 1
				_endif
			_endif
		_endloop
	_endloop

	ln_reng_ini << 9
	
	#Asigna las etiquetas correspondientes a las terminales especiales
	_for te _over etiq_term_esp.fast_elements()
	_loop
		term_esp << te.as_symbol()
		_self.asigna_texto_celda(:tbl_Corte_Caja_2,ln_reng_ini,1,term_esp,33)
		ln_reng_ini +<< 1
	_endloop
    _endif

_endmethod
$
