	_self.asigna_texto_celda(:tbl_red_datos,2,2,  p_pl_datos[:distancia_oc].default("").write_string,25)
	_self.asigna_texto_celda(:tbl_Red_Datos,3,2,  p_pl_datos[:distancia_promedio].default("").write_string,25)
	_self.asigna_texto_celda(:tbl_Red_Datos,4,2,  p_pl_datos[:porcentaje_penetracion].default("").write_string,25)


