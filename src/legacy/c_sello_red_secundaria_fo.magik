_pragma(classify_level=advanced, topic={plotting}, usage={subclassable})
_method c_sello_red_secundaria_fo.escala()

	_local lo_viewports
	_local lo_viewport
	
        _try
		lo_viewports << _self.layout_page.all_elements_of(c_viewport_layout_sigc)
		
		_for view _over lo_viewports.fast_elements()
		_loop
			# se obtiene el viewport que tiene asignado algún valor en
			# .sTipoPlano, asegurando que no se tome la escala del croquis
			_if view.sTipoPlano _isnt _unset
			_then
				lo_viewport << view
			_endif
		_endloop
		
		lo_escala << lo_viewport.view_scale.rounded
		ls_escala << "1:" + lo_escala.write_string
		
		_return ls_escala
		
	_when does_not_understand
		_return "F/E"
	_endtry
	
_endmethod
$

_pragma(classify_level=restricted, usage={redefinable})
_method c_sello_red_secundaria_fo.inicializa( properties )

	# vbluna(23-feb-07)
	# - Se agrega el parámetro: properties como resultado de las
	#   modificaciones para almacenar los valores del sello
	#   en archivo .xml

	.pl_terminal_1 << {:|A|,:|B|,:|C|,:|D|,:|E|,:|F|,:|G|,:|H|,:|J|,:|K|}
	.pl_terminal_2 << {:|L|,:|M|,:|O|,:|P|,:|R|,:|S|}
	.pl_terminal_esp << {:|T|,:|U|,:|V|,:|X|,:|Y|,:|Z|}
	.pl_num_terminal << {:|1|,:|2|,:|3|,:|4|,:|5|,:|SUMA|}

	.pl_nse << {:|A|,:|B|,:|C|,:|D|,:|E|,:|C1|,:|C2|,:|C3|,:|IP|,:|IM|,:|IL|}

	.nota_tipo_empalme <<  character.newline + "TODOS LOS EMPALMES PROYECTADOS SON "
	.nota_tipo_terminal << "TODAS LAS TERMINALES PROYECTADAS SON TIPO "
	.nota_tipo_cable << "TODO EL CABLE PROYECTADO SERA "
	

	.notas_fijas <<   character.newline +
		         "TODO POSTE EXISTENTE Y PROYECTADO ES DE 25'', EXCEPTO " + character.newline +
			 "LOS MARCADOS." + character.newline +  character.newline +
			 "EL CONTRATISTA RECTIFICARA O RATIFICARA LAS DISTANCIAS" + character.newline +
			 "INTERPOSTALES Y LONGITUDES DE CENTRO A CENTRO DE POZO," + character.newline +
			 "LAS SECCIONES TRANSVERSALES Y SU OCUPACION" + character.newline   + character.newline +
                         "LAS TERMINALES OPTICAS POR INSTALAR DEBEN SER LO MAS CERCANO" + character.newline +
			 "A LOS CLIENTES POR ATENDER, CON LA FINALIDAD DE OPTIMIZAR LA " + character.newline +
			 "DISTANCIA DE CORDONES DE ACOMETIDA OPTICOS."  + character.newline +  character.newline +
			 "FIBRAS PARA CLIENTES A FUTURO SE PUEDEN UBICAR EN LOS "  + character.newline +
			 "PUNTOS ESTRATEGICOS DONDE SE ENCUENTRAN:"
			 
		
	_super.inicializa( properties )
	
_endmethod
