_pragma(classify_level=advanced, topic={plotting}, usage={subclassable})
_method c_sello_red_secundaria_fo.configura_tabla()

	.o_color_linea << {1.0, 0.0, 0.0}
	
	_local lo_tabla
	_local ln_desp_x
	_local ln_desp_y
	_local pl_tab_en_x << property_list.new()
	_local pl_tab_en_y << property_list.new()
	_local pl_cfg_et_red_sec << property_list.new()
	_local pl_cfg_inf_adm_1 << property_list.new()
	_local pl_cfg_responsables << property_list.new()
	_local pl_cfg_inf_adm_2 << property_list.new()
	
	_local pl_cfg_ocupacion << property_list.new()
	
	_local pl_cfg_notas << property_list.new()
	_local pl_cfg_inventario << property_list.new()
	_local pl_cfg_inv_tipo << property_list.new()
	_local pl_cfg_inv_datos << property_list.new()
	_local pl_cfg_publicos << property_list.new()
	_local pl_cfg_pslt << property_list.new()
	_local pl_cfg_distancia << property_list.new()
	_local pl_cfg_et_red << property_list.new()
	_local pl_cfg_red_datos << property_list.new()

		
	pl_cfg_et_red_sec[:ren] << {8}
	pl_cfg_et_red_sec[:col] << {159}

	pl_cfg_inf_adm_1[:ren] << {6,6}
	pl_cfg_inf_adm_1[:col] << {39 ,38}

	pl_cfg_inf_adm_2[:ren] << {6,4,4,4,5,4,4,4}
	pl_cfg_inf_adm_2[:col] << {26,15,41}
	pl_cfg_inf_adm_2[:borde_der] << rope.new_with({1,1},{6,1},{7,1},{8,1}) 

        ##responsables
	
	pl_cfg_responsables[:ren] << {9,17} 
	pl_cfg_responsables[:col] << {24,22,31}
	pl_cfg_distancia[:borde_der_izq] << rope.new_with({3,1}, {3,2})
	
	##ocupacion
	pl_cfg_ocupacion[:ren] << {4} 
	pl_cfg_ocupacion[:col] << {10,14,22,14,17}
	pl_cfg_ocupacion[:borde_der_izq] << rope.new_with({1,2},{1,3},{1,4})
	pl_cfg_ocupacion[:borde_der] << rope.new_with({1,1})
	##ocupacion
	
	pl_cfg_notas[:ren] << {5,46.9992,5,4,4,4,4,4,4,4,4,4,4,4,4,4,4}
	pl_cfg_notas[:col] << {16,50,16}
	pl_cfg_notas[:borde_der] << rope.new_with({1,1},{2,1},{3,1},{1,2},{2,2},{3,2})

	pl_cfg_inventario[:ren] << {11} #5
	pl_cfg_inventario[:col] << {77}
	
	pl_cfg_inv_tipo[:ren] << {27,12,12,4}
	pl_cfg_inv_tipo[:col] << {4}
	pl_cfg_inv_tipo[:borde_der] << rope.new_with({4,1})

	pl_cfg_inv_datos[:ren] << {7,4,4,4,4,4,4,4,4,4,4,4,4}
	#pl_cfg_inv_datos[:col] << {5,8,7,8,7,8,7,8,7,8}
	pl_cfg_inv_datos[:col] << {5,23,22,23}
	pl_cfg_inv_datos[:borde_izq] << rope.new_with({13,1})
	
	pl_cfg_publicos[:ren] << {4}
	pl_cfg_publicos[:col] << {24,53}

	pl_cfg_pslt[:ren] << {4,4,4,4,4,4,4,4,4}
	pl_cfg_pslt[:col] << {17,7,45,8}

	##distancia a OC
	pl_cfg_distancia[:ren] << {4}
	pl_cfg_distancia[:col] << {50,27}
	pl_cfg_distancia[:borde_der_izq] << rope.new_with({1,2})
	pl_cfg_distancia[:borde_der] << rope.new_with({1,1})
	pl_cfg_distancia[:borde_izq] << rope.new_with({1,2})
	
	pl_cfg_et_red[:ren] << {5}
	pl_cfg_et_red[:col] << {93,66}

	#-----------------------------------------------------------
	#Tabla datos red configuracion **
	#-----------------------------------------------------------
	pl_cfg_red_datos[:ren] << {5,4,4,4,4,4,4}
	pl_cfg_red_datos[:col] << {40,15,23,15,30,36}
	pl_cfg_red_datos[:borde_der_izq] << rope.new_with({1,3},{2,3},{5,4},{3,3},{6,2},{6,3},{6,5},{7,2},{7,3},{7,5})
	pl_cfg_red_datos[:borde_der]     << rope.new_with({1,2},{1,5},{2,2},{3,2},{4,2},{4,3},{2,5},{3,5},{4,5},{5,5},{5,1},{5,3},{6,1},{7,1})
	pl_cfg_red_datos[:borde_izq]     << rope.new_with({1,6},{2,6},{3,6},{4,6},{5,2},{5,5},{6,6},{7,6})
	
	#-----------------------------------------------------------
	#Tabla Etiqueta Red Secundaria
	#-----------------------------------------------------------
	lo_tabla << .o_tablas.crea_tabla(1,1,:tbl_etiq_red_sec)
	lo_tabla.oCoordenada_Origen << coordinate.new(.o_coord_inicio.x, .o_coord_inicio.y )
	_self.asigna_medidas_tabla(lo_tabla, pl_cfg_et_red_sec)

	#-----------------------------------------------------------
	#Tabla Información Administrativa 1
	#-----------------------------------------------------------
	lo_tabla << .o_tablas.crea_tabla(2,2,:tbl_inf_adm_1)
	ln_desp_y << .o_tablas.Longitud_total_Renglones({:tbl_etiq_red_sec}) + 20
	lo_tabla.oCoordenada_Origen << coordinate.new(.o_coord_inicio.x, .o_coord_inicio.y - ln_desp_y)	
	_self.asigna_medidas_tabla(lo_tabla, pl_cfg_inf_adm_1)

	#-----------------------------------------------------------
	#Tabla Responsables
	#-----------------------------------------------------------
	lo_tabla << .o_tablas.crea_tabla(2,3,:tbl_responsables) 
	ln_desp_y << .o_tablas.Longitud_total_Renglones({:tbl_etiq_red_sec,:tbl_inf_adm_1}) +20
	lo_tabla.oCoordenada_Origen << coordinate.new(.o_coord_inicio.x,.o_coord_inicio.y - ln_desp_y)	
	_self.asigna_medidas_tabla(lo_tabla, pl_cfg_responsables)

	#-----------------------------------------------------------
	#Tabla Información Administrativa 2
	#-----------------------------------------------------------
	lo_tabla << .o_tablas.crea_tabla(8,3,:tbl_inf_adm_2)
	ln_desp_y << .o_tablas.Longitud_total_Renglones({:tbl_etiq_red_sec}) +20
	ln_desp_x << .o_tablas.Longitud_total_Columnas({:tbl_responsables})
	lo_tabla.oCoordenada_Origen << coordinate.new(.o_coord_inicio.x + ln_desp_x,.o_coord_inicio.y - ln_desp_y)
	_self.asigna_medidas_tabla(lo_tabla, pl_cfg_inf_adm_2)
	_self.oculta_bordes_celdas(lo_tabla, pl_cfg_inf_adm_2)

	#-----------------------------------------------------------
	#Tabla Ocupacion
	#-----------------------------------------------------------
##	lo_tabla << .o_tablas.crea_tabla(1,5,:tbl_Ocupacion) 
##	ln_desp_y << .o_tablas.Longitud_total_Renglones({:tbl_etiq_red_sec,:tbl_inf_adm_1,:tbl_responsables}) +20
##	lo_tabla.oCoordenada_Origen << coordinate.new(.o_coord_inicio.x, .o_coord_inicio.y - ln_desp_y)
##	_self.asigna_medidas_tabla(lo_tabla, pl_cfg_ocupacion)
##	_self.oculta_bordes_celdas(lo_tabla, pl_cfg_ocupacion)
	#-----------------------------------------------------------
	#Tabla Notas
	#-----------------------------------------------------------

	lo_tabla  << .o_tablas.crea_tabla(17,3,:tbl_Notas)
	ln_desp_y << .o_tablas.Longitud_total_Renglones({:tbl_etiq_red_sec,:tbl_inf_adm_2}) +20
#	ln_desp_x << .o_tablas.Longitud_total_Columnas({:tbl_Ocupacion})
	lo_tabla.oCoordenada_Origen << coordinate.new(.o_coord_inicio.x + ln_desp_x,.o_coord_inicio.y - ln_desp_y)
	_self.asigna_medidas_tabla(lo_tabla, pl_cfg_notas)
	_self.oculta_bordes_celdas(lo_tabla, pl_cfg_notas)

	#-----------------------------------------------------------
	#Tabla Etiqueta Inventario
	#-----------------------------------------------------------
	lo_tabla << .o_tablas.crea_tabla(1,1,:tbl_etiq_Inventario)
	ln_desp_y << .o_tablas.Longitud_total_Renglones({:tbl_etiq_red_sec,:tbl_inf_adm_1,:tbl_responsables}) +20
	lo_tabla.oCoordenada_Origen << coordinate.new(.o_coord_inicio.x,.o_coord_inicio.y - ln_desp_y)
	_self.asigna_medidas_tabla(lo_tabla, pl_cfg_inventario)

	#-----------------------------------------------------------
	#Tabla Inventario_Tipo
	#-----------------------------------------------------------
	lo_tabla << .o_tablas.crea_tabla(4,1,:tbl_Inventario_Tipo)
	ln_desp_y << .o_tablas.Longitud_total_Renglones({:tbl_etiq_red_sec,:tbl_inf_adm_1,:tbl_responsables,:tbl_etiq_Inventario}) +20
	lo_tabla.oCoordenada_Origen << coordinate.new(.o_coord_inicio.x, .o_coord_inicio.y - ln_desp_y)
	_self.asigna_medidas_tabla(lo_tabla, pl_cfg_inv_tipo)
	_self.oculta_bordes_celdas(lo_tabla, pl_cfg_inv_tipo)

	#-----------------------------------------------------------
	#Tabla Inventario_Datos
	#-----------------------------------------------------------
	lo_tabla << .o_tablas.crea_tabla(13,4,:tbl_Inventario_Datos) 
	ln_desp_y << .o_tablas.Longitud_total_Renglones({:tbl_etiq_red_sec,:tbl_inf_adm_1,:tbl_responsables,:tbl_etiq_Inventario}) +20
	ln_desp_x << .o_tablas.Longitud_total_Columnas({:tbl_Inventario_Tipo})
	lo_tabla.oCoordenada_Origen << coordinate.new(.o_coord_inicio.x + ln_desp_x,
						      .o_coord_inicio.y - ln_desp_y)
	_self.asigna_medidas_tabla(lo_tabla, pl_cfg_inv_datos)
	_self.oculta_bordes_celdas(lo_tabla, pl_cfg_inv_datos)
	
	#-----------------------------------------------------------
	#Tabla Publicos
	#-----------------------------------------------------------
	lo_tabla << .o_tablas.crea_tabla(1,2,:tbl_Publicos)
	ln_desp_y << .o_tablas.Longitud_total_Renglones({:tbl_etiq_red_sec,:tbl_inf_adm_1,:tbl_responsables,:tbl_etiq_Inventario,
							 :tbl_Inventario_Tipo}) + 20
	lo_tabla.oCoordenada_Origen << coordinate.new(.o_coord_inicio.x, .o_coord_inicio.y - ln_desp_y)
	_self.asigna_medidas_tabla(lo_tabla, pl_cfg_publicos)

	#-----------------------------------------------------------
	#Tabla PSLT
	#-----------------------------------------------------------
	lo_tabla  << .o_tablas.crea_tabla(9,4,:tbl_PSLT)
	ln_desp_y << .o_tablas.Longitud_total_Renglones({:tbl_etiq_red_sec,:tbl_inf_adm_1,:tbl_responsables,:tbl_etiq_Inventario,
							 :tbl_Inventario_Tipo,:tbl_Publicos}) + 20 
	lo_tabla.oCoordenada_Origen << coordinate.new(.o_coord_inicio.x, .o_coord_inicio.y - ln_desp_y)
	_self.asigna_medidas_tabla(lo_tabla, pl_cfg_pslt)

	#-----------------------------------------------------------
	#Tabla Distancia
	#-----------------------------------------------------------
	lo_tabla << .o_tablas.crea_tabla(1,2,:tbl_Distancia)
	ln_desp_y << .o_tablas.Longitud_total_Renglones({:tbl_etiq_red_sec,
							 :tbl_inf_adm_1,:tbl_responsables,
							 :tbl_etiq_Inventario,
							 :tbl_Inventario_Tipo,
							 :tbl_Publicos,:tbl_PSLT}) + 20
	lo_tabla.oCoordenada_Origen << coordinate.new(.o_coord_inicio.x, .o_coord_inicio.y - ln_desp_y)
	_self.asigna_medidas_tabla(lo_tabla, pl_cfg_distancia)
	_self.oculta_bordes_celdas(lo_tabla, pl_cfg_distancia)

	#-----------------------------------------------------------
	#Tabla Red_Titulo
	#-----------------------------------------------------------
	lo_tabla << .o_tablas.crea_tabla(1,2,:tbl_Red_Titulo)
	ln_desp_y << .o_tablas.Longitud_total_Renglones({:tbl_etiq_red_sec,
							 :tbl_inf_adm_1,:tbl_responsables,
							 :tbl_etiq_Inventario,
							 :tbl_Inventario_Tipo,
							 :tbl_Publicos,:tbl_PSLT,:tbl_Distancia}) +20
	lo_tabla.oCoordenada_Origen << coordinate.new(.o_coord_inicio.x, .o_coord_inicio.y - ln_desp_y)
	_self.asigna_medidas_tabla(lo_tabla, pl_cfg_et_red)

	#-----------------------------------------------------------
	#Tabla Red_Datos
	#-----------------------------------------------------------
	lo_tabla << .o_tablas.crea_tabla(7,6,:tbl_Red_Datos)
	ln_desp_y << .o_tablas.Longitud_total_Renglones({:tbl_etiq_red_sec,
							 :tbl_inf_adm_1,:tbl_responsables,
							 :tbl_etiq_Inventario,
							 :tbl_Inventario_Tipo,
							 :tbl_Publicos,:tbl_PSLT,
							 :tbl_Distancia,:Tbl_Red_Titulo}) + 20
	lo_tabla.oCoordenada_Origen << coordinate.new(.o_coord_inicio.x, .o_coord_inicio.y - ln_desp_y)
	_self.asigna_medidas_tabla(lo_tabla, pl_cfg_red_datos)
	_self.oculta_bordes_celdas(lo_tabla, pl_cfg_red_datos)
	
#------------------------------------------------------------
##@    TACHADO 
#------------------------------------------------------------
	_local lo_tacha << c_tachado_grafico.new()

	_local lo_tabla_celdas << property_list.new()

	#(4,4) (5,4) datos
	
	lo_tabla_celdas[:tbl_Publicos] << rope.new_with({1,2})
	lo_tabla_celdas[:tbl_PSLT] << rope.new_with( {1,3},{2,3},{3,3},{4,3},{5,3},{6,3},{7,3},{8,3},{9,3},
					             {1,4}, {2,4},{3,4},{4,4},{5,4},{6,4},{7,4},{8,4},{9,4})
	
	_for tabla, celdas _over lo_tabla_celdas.fast_keys_and_elements()
	_loop
		_for celda _over celdas.fast_elements()
		_loop
			lo_celda << .o_tablas.elemento(tabla).oCeldas.Celda(celda[1],celda[2]).oElementos
			lo_celda.Agregar_elemento(lo_tacha,:t_X)
		_endloop
	_endloop

_endmethod
