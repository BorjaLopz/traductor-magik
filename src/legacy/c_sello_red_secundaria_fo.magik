_pragma(classify_level=advanced, topic={plotting}, usage={subclassable})
_method c_sello_red_secundaria_fo.llena_viv_lin(p_pl_datos)

	_local lp_datos_viv_lin     << p_pl_datos[:viv_lin]
	_local lp_datos_lin_satura  << p_pl_datos[:lin_satura]
	_local lp_datos_tot_viv_lin << p_pl_datos[:tot_viv_lin]
	_local tot_lin_distrito     << p_pl_datos[:tot_lin_dto].default("")
	_local ln_reng_ini          << 2

	_for nse _over .pl_nse.fast_elements()
	_loop
		ls_value_viv       << lp_datos_viv_lin[nse][:viviendas].default("").write_string
		ls_value_lin       << lp_datos_viv_lin[nse][:abonados].default("").write_string
		ls_value_lin_multi << lp_datos_viv_lin[nse][:lineas_multiplicador].default("").write_string
		ls_value_lin_compe << lp_datos_viv_lin[nse][:lineas_competencia].default("").write_string
		ls_value_lin_inal  << lp_datos_viv_lin[nse][:lineas_inalambricas].default("").write_string
		ls_value_solicitud << lp_datos_viv_lin[nse][:solicitudes].default("").write_string
		ls_viv_sin_serv    << lp_datos_viv_lin[nse][:viv_sin_servicio].default("").write_string
		ls_lin_satura      << lp_datos_lin_satura[nse].default("").write_string

		_self.asigna_texto_celda(:tbl_Inventario_Datos,ln_reng_ini,2,ls_value_viv,25)
		_self.asigna_texto_celda(:tbl_Inventario_Datos,ln_reng_ini,3,ls_value_lin,25)
		_self.asigna_texto_celda(:tbl_Inventario_Datos,ln_reng_ini,4,ls_value_lin_multi,25)
	
		ln_reng_ini +<< 1
	_endloop

	#Asigna los totales del inventario
	_self.asigna_texto_celda(:tbl_Inventario_Datos,13,2,lp_datos_tot_viv_lin[:viviendas].default("").write_string,25)
	_self.asigna_texto_celda(:tbl_Inventario_Datos,13,3,lp_datos_tot_viv_lin[:abonados].default("").write_string,25)
	_self.asigna_texto_celda(:tbl_Inventario_Datos,13,4,lp_datos_tot_viv_lin[:lineas_multiplicador].default("").write_string,25)

	
	##_self.asigna_texto_celda(:tbl_PSLT,5,4,tot_lin_distrito.write_string,25)
	
_endmethod
