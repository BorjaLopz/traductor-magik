_method c_sello_red_secundaria_fo.asigna_celdas_a_colorear()
## Asigna las celdas que van en color diferente
## vbluna(17-nov-2006)

	_local lst_celdas_color << rope.new()

	lst_celdas_color.add({:tbl_inf_adm_1,2,1,.o_color_linea})
