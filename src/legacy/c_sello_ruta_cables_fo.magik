_method c_sello_ruta_cables_fo.llena_datos_dinamicos()
	#(02/12/14 bautistaja):
	_self.asigna_texto_celda(:tbl_2,1,1,_self.attributes[:nombre_enlace].value,50, _unset)
	_self.asigna_texto_celda(:tbl_7,1,3,_self.attributes[:numero_de_hoja].value,30,_unset)
