_pragma(classify_level=restricted, usage={redefinable})
_method c_sello_ruta_cables_fo.enum_tipo_empresar

	.oTipoEmpresaR    << hash_table.new()
	.oTipoEmpresaR[1] << "TELMEX"
	.oTipoEmpresaR[2] << "ULTIMA_MILLA"
	.oTipoEmpresaR[3] << "ULTIMA_MILLA_N"	
	_return .oTipoEmpresaR
	
_endmethod
$
_pragma(classify_level=restricted, usage={redefinable})
_method c_sello_ruta_cables_fo.enum_tipo_empresap

	.oTipoEmpresaP    << hash_table.new()
	.oTipoEmpresaP[1] << "IMTSA"
	.oTipoEmpresaP[2] << "GSP"
	.oTipoEmpresaP[3] << "KBTEL"
	.oTipoEmpresaP[4] << "TELNOR"

	
	_return .oTipoEmpresaP
	
_endmethod
