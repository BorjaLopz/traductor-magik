_pragma(classify_level=advanced, topic={plotting}, usage={subclassable})
_method c_sello_ruta_cables_fo.llena_datos_celdas()

	#datos del proyecto
	LoColor      <<  rope.new_with(1,0,0)
	diseno       <<  swg_dsn_admin_engine.active_design
	proy         <<  diseno.project	
	nombre       <<  proy.name
	programa     <<  proy.user!_programa_tipo
	direc_div    <<  proy.division
	area         <<  proy.area
	departamento <<  proy.user!_empresa_revisora
	proyectista  <<  proy.user!_proyectista_proyecto
	superviso    <<  proy.user!_supervisor 
	fecha_entrega << proy.user!_fecha_entrega 
	anio          << proy.user!_programa_anyo
	construccion  << proy.planning_start
	vp            << proy.user!_vb
	l_cables_txt  << proy.user!_central.user!_central.write_string + " "
	ctl           << proy.user!_central.user!_central + " - " +
			 proy.user!_central.user!_nom_nodo      
	LoEmpresa     << proy.user!_empresa_proyecto

       _if LoEmpresa _isnt  _unset 
       _then       
   	       LogoEmpresa   << "logo_" + LoEmpresa.lowercase	       
       _endif

	new_proj      << c_proyecto.new()
	
	#Datos del area
	oarea         << c_area_telmex.new(new_proj.area_telmex)
	responsable   << oarea.responsable
	direccion     << oarea.direccion
	telefono      << oarea.telefono
	LoTipoPlano << _self.get_tipo_plano()

        #datos del PEP 
	_self.llena_datos_pep()
	
	_if LoTipoPlano = "PLANO MONTAJE DE TBA"
	_then
		(LoTBA) << _self.obten_tba()
		_if  LoTBA _isnt _unset _then	nombre << LoTBA.user!_identificador _endif
	_else
		
		_if ( _self.attributes[:nombre_enlace] _isnt _unset _andif
		      _self.attributes[:nombre_enlace].value) _isnt  _unset _andif
		      _self.attributes[:nombre_enlace].value.size > 0
		_then

			nombre <<  _self.attributes[:nombre_enlace].value.write_string.uppercase
		_else

			_if proy.user!_enlaces _isnt _unset 
			_then
			        nombre  << proy.user!_enlaces.txt_nom_enlace
			_else
				nombre << ""
			_endif
			
		_endif
	
	_endif

	_if LoTipoPlano.matches?("*lar*")
	_then
		_self.datos_para_larguillos()
	_endif
	
	# (12/08/31 ahernanram) : asigna numero de hoja.               
	_if ( _self.attributes[:numero_de_hoja] _isnt _unset _andif
	      _self.attributes[:numero_de_hoja].value) _isnt  _unset _andif
	    _self.attributes[:numero_de_hoja].value.size > 0
	_then
		ls_num_hoja <<  _self.attributes[:numero_de_hoja].value.write_string.uppercase
	_else
		ls_num_hoja << _self.layout_page.page_number().write_string.default("1")
	_endif
	
	_if ( _self.attributes[:total_hojas] _isnt _unset _andif
	      _self.attributes[:total_hojas].value) _isnt  _unset _andif
	    _self.attributes[:total_hojas].value.size > 0
	_then	
		ls_total_hojas <<  _self.attributes[:total_hojas].value.write_string.uppercase
	_else
		ls_total_hojas << _self.layout_page.number_of_pages().write_string.default("1")
	_endif
	
	_if ( _self.attributes[:titulo] _isnt _unset _andif
	      _self.attributes[:titulo].value) _isnt  _unset _andif
	    _self.attributes[:titulo].value.size > 0
	_then
		tipo_plano <<  _self.attributes[:titulo].value.write_string.uppercase	
	_else
		tipo_plano << _self.get_tipo_plano()
	
	_endif
	
	_if ( _self.attributes[:cable] _isnt _unset _andif
	      _self.attributes[:cable].value) _isnt  _unset _andif
	    _self.attributes[:cable].value.size > 0
	_then
		
		l_cables_txt <<  _self.attributes[:cable].value.write_string.uppercase
	_endif


	_self.asigna_texto_celda(:tbl_7,1,3,ls_num_hoja           ,30,_unset)
	_self.asigna_texto_celda(:tbl_7,1,5,ls_total_hojas        ,30,_unset)			
	_self.asigna_texto_celda(:tbl_2,1,1,nombre.write_string   ,50, _unset)
	_self.asigna_texto_celda(:tbl_5,2,1,l_cables_txt          ,30,_unset)
	_self.asigna_texto_celda(:tbl_1,1,1,tipo_plano            ,70,_unset)
	_self.asigna_texto_celda(:tbl_3,1,2,programa.write_string ,28, _unset)
	_self.asigna_texto_celda(:tbl_3,2,2,direc_div.write_string,30, _unset)
	_self.asigna_texto_celda(:tbl_3,3,2,area.write_string     ,30, _unset)
	_self.asigna_texto_celda(:tbl_3,4,2,ctl.write_string      ,30, _unset)
	_self.asigna_texto_celda(:tbl_3,5,2,departamento.write_string,30, _unset)
	_self.asigna_texto_celda(:tbl_3,6,2,responsable.write_string ,30, _unset)
	_self.asigna_texto_celda(:tbl_3,7,2,direccion.write_string   ,30, _unset)
	_self.asigna_texto_celda(:tbl_3,8,2,telefono.write_string    ,30, _unset)
	_self.asigna_texto_celda(:tbl_4,2,1,proyectista.write_string ,30, _unset)
	_self.asigna_texto_celda(:tbl_4,4,1,superviso.write_string   ,30, _unset)
	_self.asigna_texto_celda(:tbl_4,6,1,fecha_entrega.write_string,30, _unset)
	_self.asigna_texto_celda(:tbl_4,7,1,"AÑO: " +anio.write_string,30, _unset)
	_self.asigna_texto_celda(:tbl_4,8,1,"CONSTRUCCION: " + construccion.write_string,30, _unset)
	_self.asigna_texto_celda(:tbl_6,2,1,vp.write_string,30,_unset)


	_if ( _self.attributes[:responsable_area] _isnt _unset _andif
	      _self.attributes[:responsable_area].value) _isnt  _unset _andif
	     _self.attributes[:responsable_area].value.size > 0
	_then
		
		responsable_area<<  _self.attributes[:responsable_area].value.write_string.uppercase
		
		_self.asigna_texto_celda(:tbl_3,6,2,responsable_area.write_string   ,30, _unset)
	_endif
	
	_if ( _self.attributes[:dir_area] _isnt _unset _andif
	      _self.attributes[:dir_area].value) _isnt  _unset _andif
	     _self.attributes[:dir_area].value.size > 0
	_then
		
		dir_area <<  _self.attributes[:dir_area].value.write_string.uppercase
		_self.asigna_texto_celda(:tbl_3,7,2,dir_area.write_string   ,30, _unset)
	_endif

	
	_if ( _self.attributes[:telefono] _isnt _unset _andif
	      _self.attributes[:telefono].value) _isnt  _unset _andif
	    _self.attributes[:telefono].value.size > 0
	_then
		
		telefono <<  _self.attributes[:telefono].value.write_string.uppercase		
		_self.asigna_texto_celda(:tbl_3,8,2,telefono.write_string    ,30, _unset)

	_endif


	# START CHANGE
	# (2020-04-17 AHERNAN, Hitss) : 
	#
	_if ( _self.attributes[:empreviso] _isnt _unset _andif
	      _self.attributes[:empreviso].value) _isnt  _unset _andif
	      _self.attributes[:empreviso].value.size > 0
	_then		
		.valor_empreviso << "logo_" +  _self.attributes[:empreviso].value.write_string.uppercase

		_if .valor_empreviso.uppercase.matches?("*TELMEX*")
		_then
				.valor_empreviso << 	.valor_empreviso + "_EP"
		_endif

		#write(:logo_por_propiedad)
		#w(:llena_datos_celdas, "-------->",  .valor_empreviso.uppercase)
		_self.asigna_simbolo_celda(:tbl_logo_telmex,1,1, .valor_empreviso)
	_else
		#write(:logo_por_default)
		_self.asigna_simbolo_celda(:tbl_logo_telmex,1,1,"logo_telmex_ep")
		
	_endif
	#
	# END CHANGE
	
		
	# START CHANGE
	# (2020-04-17 AHERNAN, Hitss) : 
	#
	_if ( _self.attributes[:empproyecto] _isnt _unset _andif
	      _self.attributes[:empproyecto].value) _isnt  _unset _andif
	      _self.attributes[:empproyecto].value.size > 0
	_then		
		.valor_empproyecto << "logo_" +  _self.attributes[:empproyecto].value.write_string.uppercase

		#write(:logo_por_propiedad)
		#w(:llena_datos_celdas_empp, "-------->",  .valor_empproyecto.uppercase)
		
		_self.asigna_simbolo_celda(:tbl_logo_imtsa,1,1, .valor_empproyecto)
	_else
		#write(:logo_por_default)
		_if LogoEmpresa _isnt _unset 
		_then	
			_self.asigna_simbolo_celda(:tbl_logo_imtsa,1,1,LogoEmpresa)			
		_endif
	_endif
	#
	# END CHANGE
	
#	_if LogoEmpresa _isnt _unset 
#	_then
#		# (2020-04-17 AHERNAN, Hitss) : ver	
#		# _self.asigna_simbolo_celda(:tbl_logo_imtsa,1,1,LogoEmpresa)
#	 
#	_endif

	 # (2020-04-17 AHERNAN, Hitss) : ver
	
#	_self.asigna_simbolo_celda(:tbl_logo_telmex,1,1,"logo_telmex_ep")
			
_endmethod
$
