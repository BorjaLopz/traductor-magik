_pragma(classify_level=advanced, topic={plotting}, usage={subclassable})
_method c_sello_ruta_cables_fo.ajusta_marco_y_bounds(p_tot_ren)
	## Se ajusta el marco y la ubicacion  del sello para cuando aumenta el numero
	## de renglones por las oes.p_tot_ren es el total de renglones
	## a considerar para la tabla de peps.
	## 
	LongInicio << 250
	.o_tablas.tablas[:tbl_general].orenglones.elemento(1).nlongitud << LongInicio +
									   ((p_tot_ren -10)*8)

	LoBounds << bounding_box.new(_self.bounds.xmin,_self.bounds.ymin,
				     _self.bounds.xmax,_self.bounds.ymax + ((p_tot_ren -10)*80))
	_self.bounds << LoBounds
_endmethod
