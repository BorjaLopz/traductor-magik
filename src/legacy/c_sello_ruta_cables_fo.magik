$
_pragma(classify_level=advanced, topic={plotting}, usage={subclassable})
_method c_sello_ruta_cables_fo.llena_datos_pep()
	## 
	##
	LoPeps << c_proyecto.obten_peps_por_tipo()
	_self.verifica_datos_tabla(LoPeps)
	LoColor << rope.new_with(1,0,0)
	LoContRenglon << 1
		
	_for rubro,tipos _over LoPeps.fast_keys_and_elements()
	_loop
		_if rubro _is :desmontaje
		_then
			LoContRenglon+<<1
		_endif
		_for tipo,valores _over tipos.fast_keys_and_elements()
		_loop
			LoContRenglon+<<1
			_for valor _over valores.fast_elements()
			_loop
				LoContRenglon+<<1
				_self.asigna_texto_celda(:tbl_8,LoContRenglon,1,
							 valor[:pep].write_string,30, _unset,_unset,LoColor)
				_self.asigna_texto_celda(:tbl_8,LoContRenglon,3,
							 valor[:opb].write_string,30, _unset,_unset,LoColor)
				_self.asigna_texto_celda(:tbl_8,LoContRenglon,4,
							 valor[:oei].write_string,30, _unset,_unset,LoColor)
				_self.asigna_texto_celda(:tbl_8,LoContRenglon,5,
							 valor[:oe].write_string,30, _unset,_unset,LoColor)
			_endloop
			
		_endloop
	_endloop
	
_endmethod
$
_pragma(classify_level=advanced, topic={plotting}, usage={subclassable})
_method c_sello_ruta_cables_fo.llena_op_oei_oe()
	##
	LoColor << rope.new_with(1,0,0)
	TXT_OE << ""
	TXT_OEI << ""
	TXT_OP << ""
	LoDiseno << swg_dsn_admin_engine.active_design
	id_oe << LoDiseno.user!_oe_local_id

	# (10/07/13 fmejia) : si el if se cumple, tomamos las oes del
	# diseno activo y apartir de ellas sus oeis y opbs. de lo
	# contrario tomamos las opbs del proyecto.

	_if LoDiseno.user!_oe_locals.size > 0
	_then
		_for oe _over LoDiseno.user!_oe_locals.fast_elements()
		_loop
			_if TXT_OE.size > 0
			_then
				TXT_OE +<< ","+oe.user!_num_oe.write_string
			_else
				TXT_OE +<< oe.user!_num_oe.write_string
			_endif
			TXT_OP << oe.user!_oei_local.user!_op_local.user!_num_op
			TXT_OEI << oe.user!_oei_local.user!_num_oei
		_endloop
	_else
		_for op _over LoDiseno.project.user!_op_locals.elements()
		_loop
			_if TXT_OP.size > 0
			_then
				TXT_OP +<< "," + op.user!_num_op
			_else
				TXT_OP +<< op.user!_num_op
			_endif

			_for oei _over op.user!_oei_locals.elements()
			_loop
				_if TXT_OEI.size > 0
				_then
					TXT_OEI +<< "," + oei.user!_num_oei
				_else
					TXT_OEI +<< oei.user!_num_oei
				_endif

				_for oe _over oei.user!_oe_locals.elements()
				_loop
					_if TXT_OE.size > 0
					_then
						TXT_OE +<< "," + oe.user!_num_oe
					_else
						TXT_OE +<< oe.user!_num_oe
					_endif
				_endloop
			_endloop
		_endloop
	_endif
	# (2011-03-23 Aarón Hernández Ramírez, SIGMATAO) : Posiciones.
	# para PEP de construccion FIBRA.
	_self.asigna_texto_celda(:tbl_8,3,5,TXT_OE.write_string,30, _unset,_unset,LoColor)
	_self.asigna_texto_celda(:tbl_8,3,3,TXT_OP.write_string,30, _unset,_unset,LoColor)
	_self.asigna_texto_celda(:tbl_8,3,4,TXT_OEI.write_string,30, _unset,_unset,LoColor)

	
_endmethod
$
