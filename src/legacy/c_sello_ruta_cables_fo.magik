_pragma(classify_level=advanced, topic={plotting}, usage={subclassable})
_method c_sello_ruta_cables_fo.verifica_datos_tabla(p_datos)
	## 
	##
	LoTotValores << 0
	_for k,v _over p_datos.fast_keys_and_elements()
	_loop
		LoTotValores +<<  v[:fibra].size
		LoTotValores +<<  v[:cobre].size
		LoTotValores +<<  v[:canal].size	
	_endloop

	LoTotFilas <<  .o_tablas.tablas[:tbl_8].orenglones.ntotal_filas
	_if (LoTotFilas-8) <> LoTotValores
	_then
		LoBounds << bounding_box.new(_self.bounds.xmin,_self.bounds.ymin,
					     _self.bounds.xmax,_self.bounds.ymax - ((LoTotFilas -10)*80))
		_self.bounds << LoBounds
		_self.crea_tabla_peps()
	_endif
	
_endmethod
$
