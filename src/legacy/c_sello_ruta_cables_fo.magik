_pragma(classify_level=advanced, topic={plotting}, usage={subclassable})
_method c_sello_ruta_cables_fo.etiqueta_celdas_de_peps(p_tot_cons,p_totales)
	## Se agrega metodo al sello para agregar los titulos de la
	## tabla de peps de acuerdo al renglon que le corresponda en
	## base al total de oes a distribuir en el sello.
	## p_tot_cons es el total de oes de construccion. p_totales es
	## el total de oes dividido por fibra, cobre y canal.
	

	_self.asigna_texto_celda(:tbl_8 ,1,3, "INSTALACIONES",40,:centre_left,2)
	_self.asigna_texto_celda(:tbl_8 ,2,1, "PEP",35,:centre_left,2)
	_self.asigna_texto_celda(:tbl_8 ,2,2, "TIPO DE TRABAJO",32,:centre_left,2)
	_self.asigna_texto_celda(:tbl_8 ,2,3, "OPERACIONES",35,:centre_left,2)
	_self.asigna_texto_celda(:tbl_8 ,2,4, "OEI",35,:centre_left,2)
	_self.asigna_texto_celda(:tbl_8 ,2,5, "OE",35,:centre_left,2)
	_self.asigna_texto_celda(:tbl_8 ,3,2, "FIBRA",35,:centre_left,2)
	_self.asigna_texto_celda(:tbl_8 ,p_totales[1]+3,2, "COBRE",35,:centre_left,2)
	_self.asigna_texto_celda(:tbl_8 ,p_totales[1] + p_totales[2]+4,2, "CANALIZACIÓN",
				 35,:centre_left,2)
	_self.asigna_texto_celda(:tbl_8 ,p_tot_cons+1,3, "DESMONTAJES",40,:centre_left,2)
	_self.asigna_texto_celda(:tbl_8 ,p_tot_cons+2,1, "PEP",35,:centre_left,2)
	_self.asigna_texto_celda(:tbl_8 ,p_tot_cons+2,2, "TIPO DE TRABAJO",32,:centre_left,2)
	_self.asigna_texto_celda(:tbl_8 ,p_tot_cons+2,3, "OPERACIONES",35,:centre_left,2)
	_self.asigna_texto_celda(:tbl_8 ,p_tot_cons+2,4, "OEI",35,:centre_left,2)
	_self.asigna_texto_celda(:tbl_8 ,p_tot_cons+2,5, "OE",35,:centre_left,2)
	_self.asigna_texto_celda(:tbl_8 ,p_tot_cons+3,2, "FIBRA",35,:centre_left,2)
	_self.asigna_texto_celda(:tbl_8 ,p_tot_cons+p_totales[4]+4,2, "COBRE",35,:centre_left,2)
	_self.asigna_texto_celda(:tbl_8 ,p_tot_cons+p_totales[4]+p_totales[5]+4,2, "CANALIZACIÓN",
				 35,:centre_left,2)
_endmethod
