_pragma(classify_level=advanced, topic={plotting}, usage={subclassable})
_method c_sello_ruta_cables_fo.filtrar_campos_x_proyecto()
#---------------------------------------------------
##  Objetivo  : Filtrar los campos validos de PEP por tipo de proyecto
##
LoCamposPEP << rope.new()
	
LoProject    <<  swg_dsn_admin_engine.active_design.project
campos << LoProject.physical_fields
TipoProyecto <<  LoProject.job_type
FTTB?  <<  LoProject.name.matches?("FTTB_*")
BA?     << LoProject.name.matches?("BA_*")

# (2011-04-08 Aarón Hernández Ramírez, SIGMATAO) : tipo de PEP

_if BA? 
_then
	ListaNombrecampos << 	c_sello_ruta_cables_fo.tipos_peps_ba
_elif FTTB?
_then
	ListaNombrecampos <<     c_sello_ruta_cables_fo.tipos_peps_fttb
_else
	ListaNombrecampos <<     c_sello_ruta_cables_fo.tipos_peps_fibra	
_endif

#write("campos...")
#print(ListaNombrecampos)

_for k _over campos.elements()
_loop
	_if  ListaNombrecampos.index_of_eq(k.name) _isnt _unset 
	_then
	       	LoCamposPEP.add(k)
	_endif
		
_endloop

#write("CAMPOS PEP VALIDOS")
#print(LoCamposPEP)

_return LoCamposPEP
	
_endmethod
