_pragma(classify_level=advanced, topic={plotting}, usage={subclassable})
_method c_sello_ruta_cables_fo.get_tipo_plano()
	## 
	## 
	LoPage << _self.get_page()
	LoTipoPlano << ""
	_for el _over lopage.elements.fast_elements()
	_loop
		_if el.class_name _is :c_titulo_de_plano
		_then
			LoTipoPlano << el.text.as_lines.an_element()
			_leave
		_endif
	_endloop
	_return LoTipoPlano
_endmethod
