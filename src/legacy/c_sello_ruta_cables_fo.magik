_pragma(classify_level=restricted, usage={redefinable})
_method c_sello_ruta_cables_fo.defined_attributes

	attribs << rope.new_from (_super.defined_attributes)
	
	# Atributo que indica si el sello debe presentarse en color
	# negro o en color rojo

	
	# START CHANGE
	# (2020-04-17 AHERNAN, Hitss) : 
	#
	attribs.add(layout_attribute_definition.new(:empreviso, :string,
						    :description, "Empresa que revisa",	    
                                                    :enum_method, :enum_tipo_empresar))

	attribs.add(layout_attribute_definition.new(:empproyecto, :string,
						    :description, "Empresa que proyecta",
                                                    :enum_method, :enum_tipo_empresap))	
	#
	# END CHANGE
	
	
	attribs.add(layout_attribute_definition.new(:blanco_negro,  :string,
		                                    :description,   "Blanco / Negro",
						    :enum_method,   :enum_bool,
						    :default_value, "NO"))

	attribs.add(layout_attribute_definition.new(:nombre_enlace, :string,
						    :description, "Nombre del enlace",
						    :default_value, _unset ))

	attribs.add(layout_attribute_definition.new(:cable, :string,
						    :description, "Cable",
						    :default_value, _unset ))

	attribs.add(layout_attribute_definition.new(:titulo, :string,
						    :description, "Titulo plano",
						    :default_value, _unset ))
	
	attribs.add(layout_attribute_definition.new(:numero_de_hoja, :string,
						    :description, "Número de Hoja",
						    :default_value, _unset ))

	attribs.add(layout_attribute_definition.new(:total_hojas, :string,
						    :description, "Total de hojas",
						    :default_value, _unset ))

	
	attribs.add(layout_attribute_definition.new(:telefono, :string,
						    :description, "TELEFONO",
						    :default_value, _unset ))

	attribs.add(layout_attribute_definition.new(:dir_area, :string,
						    :description, "DIRECCION AREA",
						    :default_value, _unset ))
	
	attribs.add(layout_attribute_definition.new(:responsable_area, :string,
						    :description, "RESPONSABLE AREA",
						    :default_value, _unset ))

	
	>> attribs
	
_endmethod
