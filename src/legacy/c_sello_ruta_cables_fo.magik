_pragma(classify_level=advanced, topic={plotting}, usage={subclassable})
_method c_sello_ruta_cables_fo.configura_tabla()

	#--------------------------------------------------------------
	#	  Tabla General
	#--------------------------------------------------------------
	lo_tabla << .o_tablas.crea_tabla(1,1,:tbl_general)
	lo_tabla.oCoordenada_origen << .o_coord_inicio
	lo_tabla.orenglones.elemento(1).nlongitud << 250
	lo_tabla.ocolumnas.elemento(1).nlongitud  << 185
	#--------
	# tabla 1
	#--------
	lo_tabla << .o_tablas.crea_tabla(1,1, :tbl_1)
	lo_tabla.oCoordenada_Origen << coordinate.new(.o_coord_inicio.x + 150, .o_coord_inicio.y - 0)
	lo_tabla.orenglones.elemento(1).nlongitud << 11
	lo_tabla.ocolumnas.elemento(1).nlongitud  << 155
	lo_celda << lo_tabla.oceldas.celda(1,1).oelementos.obten_elemento(:bordes_celda)
	lo_celda.bBorde_Der? << _false
	lo_celda.bBorde_Izq? << _false
	lo_celda.bBorde_Sup? << _false
	lo_celda.bBorde_Inf? << _false
	#--------
	# tabla 2
	#--------
	lo_tabla << .o_tablas.crea_tabla(1,1, :tbl_2)
	ln_desp_y << .o_tablas.Longitud_total_Renglones({:tbl_1})
	lo_tabla.oCoordenada_Origen << coordinate.new(.o_coord_inicio.x + ln_desp_y, .o_coord_inicio.y - ln_desp_y)
	lo_tabla.orenglones.elemento(1).nlongitud << 11
	lo_tabla.ocolumnas.elemento(1).nlongitud  << 155
      	#--------
	# tabla 3
	#--------
	lo_tabla << .o_tablas.crea_tabla(8,2, :tbl_3)
	lo_tabla.oCoordenada_Origen << coordinate.new(.o_coord_inicio.x+ 380, .o_coord_inicio.y - 220)
	_for n_reng _over range(1,8)
	_loop
		lo_tabla.orenglones.elemento(n_reng).nlongitud << 8
	_endloop
	lo_tabla.ocolumnas.elemento(1).nlongitud  << 51
	lo_tabla.ocolumnas.elemento(2).nlongitud  << 53
	ocultaBIzq << rope.new_with({1,1},{1,2},{2,1},{2,2},{3,1},{3,2},{4,1},{4,2},{5,1},{5,2},{6,1},{6,2},
				    {7,1},{7,2},{8,1},{8,2})
	_for elem _over ocultaBIzq.fast_elements()
	_loop
		lo_celda << lo_tabla.oceldas.celda(elem[1].as_number(),elem[2].as_number()).oelementos.obten_elemento(:bordes_celda)
		lo_celda.bBorde_Izq? << _false
		lo_celda.bBorde_Der? << _false		
	_endloop
	ocultaBInfSup << rope.new_with({1,1},{1,2},{2,1},{3,1},{4,1},{5,1},{6,1},{7,1},{8,1})
	_for elem _over ocultaBInfSup.fast_elements()
	_loop
		lo_celda << lo_tabla.oceldas.celda(elem[1].as_number(),elem[2].as_number()).oelementos.obten_elemento(:bordes_celda)
		lo_celda.bBorde_Inf? << _false
		lo_celda.bBorde_Sup? << _false
	_endloop
	#--------
	# tabla logo imtsa
	#--------
	lo_tabla << .o_tablas.crea_tabla(1,1, :tbl_logo_imtsa)
	lo_tabla.orenglones.elemento(1).nlongitud << 48
	lo_tabla.ocolumnas.elemento(1).nlongitud  << 51
	lo_tabla.oCoordenada_Origen << coordinate.new(.o_coord_inicio.x+ ln_desp_y, .o_coord_inicio.y - 940)
        #--------
	# tabla 4
	#--------
	lo_tabla << .o_tablas.crea_tabla(8,1, :tbl_4)
	lo_tabla.oCoordenada_Origen << coordinate.new(.o_coord_inicio.x+ ln_desp_y+ 510 , .o_coord_inicio.y - 940)
	_for n_ren _over range(1,8)
	_loop
		lo_tabla.orenglones.elemento(n_ren).nlongitud << 8
	_endloop
	lo_tabla.ocolumnas.elemento(1).nlongitud << 53
	
        ocultaBInf << rope.new_with({1,1},{3,1},{5,1})
	_for elem _over ocultaBInf.fast_elements()
	_loop
		lo_celda << lo_tabla.oceldas.celda(elem[1].as_number(),elem[2].as_number()).oelementos.obten_elemento(:bordes_celda)
		lo_celda.bBorde_Inf? << _false
	_endloop
	#--------
	# tabla logo telmex
	#--------
	lo_tabla << .o_tablas.crea_tabla(2,1, :tbl_logo_telmex)
	lo_tabla.orenglones.elemento(1).nlongitud << 48
	lo_tabla.ocolumnas.elemento(1).nlongitud  << 51
	lo_tabla.oCoordenada_Origen << coordinate.new(.o_coord_inicio.x + ln_desp_y + 1040, .o_coord_inicio.y - 940)
	lo_celda << lo_tabla.oceldas.celda(1,1).oelementos.obten_elemento(:bordes_celda)
	lo_celda.bBorde_Inf? << _false
	#--------
	# tabla 5
	#--------
	lo_tabla << .o_tablas.crea_tabla(2,1, :tbl_5)
	lo_tabla.orenglones.elemento(1).nlongitud << 8
	lo_tabla.orenglones.elemento(2).nlongitud << 8
	lo_tabla.ocolumnas.elemento(1).nlongitud  << 51
	lo_tabla.oCoordenada_Origen << coordinate.new(.o_coord_inicio.x+ ln_desp_y, .o_coord_inicio.y - 1420)
	#--------
	# tabla 6
	#--------
	lo_tabla << .o_tablas.crea_tabla(2,1, :tbl_6)
	lo_tabla.orenglones.elemento(1).nlongitud << 8
	lo_tabla.orenglones.elemento(2).nlongitud << 8
	lo_tabla.ocolumnas.elemento(1).nlongitud  << 51
	lo_tabla.oCoordenada_Origen << coordinate.new(.o_coord_inicio.x + ln_desp_y + 1040, .o_coord_inicio.y - 1420)
	lo_celda << lo_tabla.oceldas.celda(1,1).oelementos.obten_elemento(:bordes_celda)
	lo_celda.bBorde_Sup? << _false
	#--------
	# tabla 7
	#--------
	lo_tabla << .o_tablas.crea_tabla(1,5, :tbl_7)
	lo_tabla.orenglones.elemento(1).nlongitud << 8
	lo_tabla.ocolumnas.elemento(1).nlongitud  << 95
	_for n_col _over range(2,5)
	_loop
		lo_tabla.ocolumnas.elemento(n_col).nlongitud  << 15
	_endloop
	lo_tabla.oCoordenada_Origen << coordinate.new(.o_coord_inicio.x+ ln_desp_y, .o_coord_inicio.y - 1580)
	lo_celda << lo_tabla.oceldas.celda(1,1).oelementos.obten_elemento(:bordes_celda)
	lo_celda.bBorde_Der? << _false
	lo_celda.bBorde_Izq? << _false
	#--------+
	# tabla 8 TABLA DE PEPS Y UNIDADES CONTABLES
	#--------
	_self.crea_tabla_peps()

_endmethod
$
_pragma(classify_level=advanced, topic={plotting}, usage={subclassable})
_method c_sello_ruta_cables_fo.crea_tabla_peps()
	## Se crea la tabla de peps en base a la informacion agrupada
	## de las OES por trabajo (Construccion o desmontaje) y por
	## tipo de red (Cobre, Fibra, Canal)
	## 
	LoPeps<<c_proyecto.obten_peps_por_tipo()
	LoTotRen << 0 #inicializamos el total de renglones en 10
	LoTotFibConst << 0
	LoTotCobConst << 0
	LoTotCanConst << 0
	LoTotFibDesm << 0
	LoTotCobDesm << 0
	LoTotCanDesm << 0

	_for k,v _over LoPeps.fast_keys_and_elements()
	_loop
		_if k _is :construccion
		_then
			LoTotFibConst +<<  v[:fibra].size
			LoTotCobConst +<<  v[:cobre].size
			LoTotCanConst +<<  v[:canal].size	
		_elif k _is :desmontaje
		_then 
			LoTotFibDesm +<<  v[:fibra].size
			LoTotCobDesm +<<  v[:cobre].size
			LoTotCanDesm +<<  v[:canal].size
		_endif
		
	_endloop

	LoTotRenConst << 4 + LoTotFibConst + LoTotCobConst + LoTotCanConst
	LoTotRenDesmo << 4 + LoTotFibDesm + LoTotCobDesm + LoTotCanDesm
	LoTotRen << LoTotRenConst + LoTotRenDesmo
	ln_desp_y << .o_tablas.Longitud_total_Renglones({:tbl_1})
	lo_tabla << .o_tablas.crea_tabla(LoTotRen,5, :tbl_8)
	lo_tabla.oCoordenada_Origen << coordinate.new(.o_coord_inicio.x+ ln_desp_y, .o_coord_inicio.y - 1660)
	_for n_reng _over range(1,LoTotRen)
	_loop
		lo_tabla.orenglones.elemento(n_reng).nlongitud << 8
	_endloop
	_for n_col _over range(1,5)
	_loop
		lo_tabla.ocolumnas.elemento(n_col).nlongitud << 31
	_endloop
	ocultaBIzq << rope.new_with({1,2},{1,3},{1,4},{1,5},{LoTotRenConst + 1,2},{LoTotRenConst + 1,3},{LoTotRenConst + 1,4},{LoTotRenConst + 1,5})
	_for elem _over ocultaBIzq.fast_elements()
	_loop
		lo_celda << lo_tabla.oceldas.celda(elem[1].as_number(),elem[2].as_number()).oelementos.obten_elemento(:bordes_celda)
		lo_celda.bBorde_Izq? << _false
	_endloop
	ocultaBDer << rope.new_with({1,1},{1,2},{1,3},{1,4},{LoTotRenConst +1,1},{LoTotRenConst +1,2},{LoTotRenConst +1,3},{LoTotRenConst +1,4})
	_for elem _over ocultaBDer.fast_elements()
	_loop
		lo_celda << lo_tabla.oceldas.celda(elem[1].as_number(),elem[2].as_number()).oelementos.obten_elemento(:bordes_celda)
		lo_celda.bBorde_Der? << _false	
	_endloop
	LoTotales << rope.new_with(LoTotFibConst,
				   LoTotCobConst,
				   LoTotCanConst,
				   LoTotFibDesm,
				   LoTotCobDesm,
				   LoTotCanDesm)
	_self.ajusta_marco_y_bounds(LoTotRen)
	_self.etiqueta_celdas_de_peps(LoTotRenConst,LoTotales)


_endmethod
$
_pragma(classify_level=advanced, topic={plotting}, usage={subclassable})
_method c_sello_ruta_cables_fo.datos_para_larguillos()
	## 
	##
	LoPaf << smallworld_product.pni_application()
	LayoutPlugin << LoPaf.plugin(:layout_plugin)
	LayoutManager << LayoutPlugin.layout_designer.plugin(:layout_manager)
	LoDocument << LayoutManager.current_document
	LoUserTipoPlano << LoDocument.user!_tipo_plano
	### Llena el campo tipo de plano
	_if LoUserTipoPlano = :ruta_cables_fo_lar 
	_then
		LoTipoPlano << "Plano de Detalles de Ruta"
	_elif LoUserTipoPlano = :ruta_cables_fo_lar_gral
	_then
		LoTipoPlano << "Plano de generico de Ruta"
	_endif
	### Llena los campos numero de pagina y total de paginas
	LoTotalHojas << LoDocument.all_elements_of(c_sello_ruta_cables_fo).size
	LoNumHoja << 0
	_for ele _over LoDocument.all_elements_of(c_sello_ruta_cables_fo).fast_elements()
	_loop
		LoNumHoja +<<1
		ele.asigna_texto_celda(:tbl_1, 1,1, LoTipoPlano, 70,_unset)
		ele.asigna_texto_celda(:tbl_7, 1,3, LoNumHoja, 30,_unset)
		ele.asigna_texto_celda(:tbl_7,1,5, LoTotalHojas,30,_unset)
	_endloop

_endmethod
