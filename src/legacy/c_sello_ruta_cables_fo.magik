_pragma(classify_level=restricted, usage={redefinable})
_method c_sello_ruta_cables_fo.obten_ace()
	## 
	##
	Lo_ace << ""
	_if _self.layout_page _isnt  _unset
	_then
		Lo_elementos << _self.layout_page.elements

		_for el _over Lo_elementos.fast_elements()
		_loop
			_if el.responds_to?(:ace_name)
			_then
				Lo_ace << el.ace_name
				_leave
			_endif
		_endloop
	_endif
	_return Lo_ace
_endmethod
$
_pragma(classify_level=advanced, topic={plotting}, usage={subclassable})
_method c_sello_ruta_cables_fo.obten_cable()
# (09/08/20 fmejia) : Este metodo devuelve los cables asociados
# a un esquematico de RDA,Troncal, ROF o TBA a partir del
# sheath_geoms, de no ser ninguno de los anteriores devuelve
# los cables activados en el plugin de gen_planos.
	
	LoPaf << smallworld_product.pni_application()
	Locables << rope.new()
	LoGpm << gis_program_manager
	LoTabCables << LoGpm.cached_dataset(:gis).collection(:sheath_geoms)
	LoGui << Lopaf.plugin(:esquema_tab_plugin).sys!slot(:esq_gui)
	LoEsquema << LoGui.engine.admesquemas.esquema.current_esq

	LoEsquemas << rope.new_with(:|Esquema ROF|,
				    :|Esquema RDA|,
				    :|Esquema Troncal|,
				    :|Esquema TBA|) 
	
	_if LoEsquemas.includes?(_self.obten_ace().as_symbol())
	_then
		_for cab _over LoTabCables.fast_elements()
		_loop
			_if LoEsquema _isnt _unset _andif
			    cab.esquema _isnt _unset _andif
			    cab.esquema.string_buffer.index_of_seq(LoEsquema.id.write_string) _isnt _unset
			_then
				Locables.add(cab.sheath)
			_endif
		_endloop
	_else
		a_cables << LoPaf.plugin(:gen_planos).cables_activados_fo
		_if a_cables.is_kind_of?(mit_cable_mixin)
		_then
			Locables.add(a_cables)
		_elif a_cables _isnt _unset _andif
		      a_cables.responds_to?(:size)
                  _then 
			Locables.add_all_last(a_cables)
		_endif
		
	_endif

	_return Locables	
_endmethod
$
_pragma(classify_level=advanced, topic={plotting}, usage={subclassable})
_method c_sello_ruta_cables_fo.obten_pep_para_fttb()
	## 
	##
	# INICIO DEL CAMBIO
	# (2010-07-29 Aarón Hernández Ramírez, SIGMATAO) : se redefine
	# el metodo para poder obtener las oEs de los diseños que son
	# de principales.Anteriormente calculaba las OEs para
	# secundarios (Montaje de tBA)
	#
	# FIN DEL CAMBIO

	LoDiseno << swg_dsn_admin_engine.active_design
	  proy << LoDiseno.project

          _if LoDiseno.tipo_diseno _is :principales #_or 
	     # LoDiseno.tipo_diseno _is :enlace
	  _then
		  # (2010-07-29 Aarón Hernández Ramírez, SIGMATAO) :Conntruccion de fibra
		  Pl << _self.obtiene_informacion_admin_principales(proy, "user!_pep_ba_rp_fo_peba",3 )
		  # (2010-07-29 Aarón Hernández Ramírez, SIGMATAO) : construccion de cobre
		  Pl << _self.obtiene_informacion_admin_principales(proy, "user!_pep_cons_ppal"    ,4 )
		  # (2010-07-29 Aarón Hernández Ramírez, SIGMATAO) : construccion canalizacion
		  Pl << _self.obtiene_informacion_admin_principales(proy, "user!_pep_cons_cana"    ,5 )
		  # (2010-07-29 Aarón Hernández Ramírez, SIGMATAO) : desmontaje de fibra		  
		  Pl << _self.obtiene_informacion_admin_principales(proy, "user!_pep_desm_rp_fo"   ,8 )
		  # (2010-07-29 Aarón Hernández Ramírez, SIGMATAO) : desm cobre
		  Pl << _self.obtiene_informacion_admin_principales(proy, "user!_pep_desm_ppal"   ,9 )
		  # (2010-07-29 Aarón Hernández Ramírez, SIGMATAO) : desm canalizacion
		  Pl << _self.obtiene_informacion_admin_principales(proy, "user!_pep_desm_cana"   ,10 )
		   
	  _elif LoDiseno.tipo_diseno _is :trabajo _or
		LoDiseno.tipo_diseno _is :enlace
	  _then
		  ElementosPEP <<  _self.obtener_peps_y_su_tipo()

                 _for k  _over ElementosPEP.elements()
	       _loop
		        posicion <<  _self.obtiene_indice(k[1].write_string , k[3])

			Pl << _self.obtiene_informacion_admin_principales(proy,k[1].write_string,posicion )
	       _endloop
		                 
	  _else
		  Pl << _self.obtiene_informacion_admin_secundario(proy )	  

	  _endif
	  
	_return pl
_endmethod
$
_pragma(classify_level=advanced, topic={plotting}, usage={subclassable})
_method c_sello_ruta_cables_fo.obten_pep_para_fttb_OLD()
	## 
	##
	pl << property_list.new()
	pl[:valor] << ""
	proy << swg_dsn_admin_engine.active_design.project
	_if _self.get_tipo_plano()= "PLANO MONTAJE DE TBA"
	_then
		pl[:nombre_campo] << "user!_pep_ba_ter_peba"
		pl[:valor] << proy.user!_pep_ba_ter_peba
	_endif
	
	LoColor << rope.new_with(1,0,0)
	TXT_OE << ""
	TXT_OEI << ""
	TXT_OP << ""
	LoDiseno << swg_dsn_admin_engine.active_design
	id_oe << LoDiseno.user!_oe_local_id

	# (10/07/13 fmejia) : si el if se cumple, tomamos las oes del
	# diseno activo y apartir de ellas sus oeis y opbs. de lo
	# contrario tomamos las opbs del proyecto.
	_if LoDiseno.user!_oe_locals.size > 0
	_then
		_for oe _over LoDiseno.user!_oe_locals.fast_elements()
		_loop
			_if oe.user!_catalogo_pep = pl[:nombre_campo].uppercase
			_then
				TXT_OE << oe.user!_num_oe
				TXT_OP << oe.user!_oei_local.user!_op_local.user!_num_op
				TXT_OEI << oe.user!_oei_local.user!_num_oei
				_leave
			_endif
		_endloop
	_endif
	_self.asigna_texto_celda(:tbl_8,3,5,TXT_OE.write_string,30, _unset,_unset,LoColor)
	_self.asigna_texto_celda(:tbl_8,3,3,TXT_OP.write_string,30, _unset,_unset,LoColor)
	_self.asigna_texto_celda(:tbl_8,3,4,TXT_OEI.write_string,30, _unset,_unset,LoColor)
	_return pl
_endmethod
$
_pragma(classify_level=advanced, topic={plotting}, usage={subclassable})
_method c_sello_ruta_cables_fo.obten_tba()
	## 
	##
	LoPaf << smallworld_product.pni_application()
	LoLayPlug << LoPaf.plugin(:layout_plugin)
	LoAppl << LoLayPlug.sys!slot(:applications).an_element().application
	LoPlugMan << LoAppl.plugin(:layout_manager)
	LoDoc << LoPlugMan.current_document
	LoSelloRed << _unset
	LoTBA << _unset
	_for el _over LoDoc.current_page.elements.fast_elements()
	_loop
		_if el.responds_to?(:class_name) _andif
		    el.class_name _is :c_datos_de_red 
		_then
			LoSelloRed << el
			LoTBA << LoSelloRed.obtener_elementos_bd_gis().an_element()
			_leave
		_endif
	_endloop

	_return (LoTBA)
_endmethod
$
_pragma(classify_level=advanced, topic={plotting}, usage={subclassable})
_method c_sello_ruta_cables_fo.obtener_peps_y_su_tipo()
	#---------------------------------------------------
	##  Objetivo  : obtener las PEP y su tipo dependiendo de su valor.
	##  regresa : arreglo con el nombre del campo Pep, valor del
	## campo pep y tipo de PEP.
	# (2011-03-23 Aarón Hernández Ramírez, SIGMATAO) : metodo nuevo
	
             LoPEPsTipo  << property_list.new_with("D-", "construccion" ,
                                                   "J-", "desmontaje",
                                                   "X-", "rehabilitacion",
                                                   "Y-", "reconcentracion")
		     
	LoProject << swg_dsn_admin_engine.active_design.project
	campos << LoProject.physical_fields

	LoCamposvalidos  << _self.filtrar_campos_x_proyecto() 
  
	LoCamposPEP << rope.new()
	_for k _over LoCamposvalidos.elements()
	_loop
		#filtra los campos validos con valor.
		_if k.name.matches?("*user!_pep*") _andif 		   
		    (valor << LoProject.perform(k.name)) _isnt _unset 
		_then
			#valor << LoProject.perform(k.name)
			
                      _for m,n _over LoPEPsTipo.keys_and_elements()
		      _loop			     
			      _if valor.subseq(1,2) = m
			      _then
				      LoCamposPEP.add( {k.name , valor, n} )
			      _endif
			      
		      _endloop
		      
		_endif
	_endloop

	_return LoCamposPEP
_endmethod
$
_pragma(classify_level=advanced, topic={plotting}, usage={subclassable})
_method c_sello_ruta_cables_fo.obtiene_indice(PoCampoPep, PoTipo)
#---------------------------------------------------
##  Objetivo  : Obtiene la posiccion en la tabla dada el tipo
## de PEP y el nombre de campo. 
##	
LoIndice << 3

_if pocampoPep.lowercase.matches?("*cana*") _andif Potipo = "construccion"
_then
	LoIndice << 5
_endif  

_if (pocampoPep.lowercase.matches?("*fib*") _or
     pocampoPep.lowercase.matches?("*const_ppal*") _or
     pocampoPep.lowercase.matches?("*fo_peba*"))  _andif Potipo = "construccion"
_then
	LoIndice << 3
_endif	
_if (pocampoPep.lowercase.matches?("*fib*") _or
     pocampoPep.lowercase.matches?("*desm_ppal*") _or
     pocampoPep.lowercase.matches?("*desm_rp_fo*") )  _andif Potipo = "desmontaje"
_then		
	LoIndice << 8
_endif  

_if pocampoPep.lowercase.matches?("*cana*") _andif Potipo = "desmontaje"
	_then
		LoIndice << 10
_endif  

_return LoIndice

_endmethod
$
_pragma(classify_level=advanced, topic={plotting}, usage={subclassable})
_method c_sello_ruta_cables_fo.obtiene_informacion_admin_principales(PoProyecto, PoPEP, LoPosicion)
	#---------------------------------------------------
	##  Objetivo  : Obtener los elementos OE,OEI y OPB de un diseño
	## de red principal.
	##
	#Parametros de entrada:Objeto PoProyecto Proyecto del diseño activo
	#                      Cadena PoPEP Elemento PEP que corresponde al tipo de diseño y proyecto activo.
	#Parametros de salida: Ninguno
	#
	#Regresa:Property_list  Pl lista que contiene el nombre del PEP y su valor
	#Fecha de última modificación: 2010-07-28
	#Autor de la modificación:Aarón Hernández Ramírez, SIGMATAO
	##
	#Descripción de la modificación:
	#
	#Inicio Control de cambios
	# (2010-07-28 Aarón Hernández Ramírez, SIGMATAO) : Creado
	#Fin de control de cambios

	LoColor << rope.new_with(1,0,0)
	TXT_OE << ""
	TXT_OEI << ""
	TXT_OP << ""
	pl << property_list.new()
	pl[:valor] << _unset 
	
        LoPEP <<  PoProyecto.perform(PoPEP.as_symbol())
	
	_if LoPEP _isnt _unset 
	_then		
		pl[:nombre_campo] << PoPEP
		pl[:valor] << _unset 

		TXT_PEP << LoPEP
                   		
		_for opb _over PoProyecto.user!_op_locals.elements()
		_loop						
			_for oei _over opb.user!_oei_locals.elements()
			_loop					
				_for oe _over oei.user!_oe_locals.elements()
				_loop					
					_if oe.user!_catalogo_pep.uppercase = pl[:nombre_campo].uppercase
					_then
						
						_if  TXT_OE.index_of_seq( oe.user!_num_oe ) _is _unset 
						_then
							TXT_OE << TXT_OE + " " + oe.user!_num_oe	
						_endif
												
                                                LoOPB << oe.user!_oei_local.user!_op_local.user!_num_op

						_if TXT_OP.index_of_seq( LoOPB ) _is _unset 
						_then
							TXT_OP << TXT_OP + " " +  LoOPB
						_endif

                                                LoOEI << oe.user!_oei_local.user!_num_oei
						
						_if TXT_OEI.index_of_seq( LoOEI ) _is _unset 
						_then
							TXT_OEI << TXT_OEI + " " + LoOEI
						_endif																													
					_endif					    					    
				_endloop			    
			_endloop		    
			
		_endloop


		_if TXT_OP.size > 0 
		_then
			_self.asigna_texto_celda(:tbl_8,LoPosicion ,3  ,TXT_OP.write_string,30,  _unset,_unset,LoColor)	
		_endif
		
		_if TXT_OEI.size > 0 
		_then
			_self.asigna_texto_celda(:tbl_8,LoPosicion ,4  ,TXT_OEI.write_string,30, _unset,_unset,LoColor)	
		_endif
		
		_if TXT_OE.size > 0 
		_then
			_self.asigna_texto_celda(:tbl_8,LoPosicion ,5 ,TXT_OE.write_string,30,  _unset,_unset,LoColor)	
		_endif
		
		_if TXT_PEP.size > 0 
		_then
			# (2010-07-29 Aarón Hernández Ramírez, SIGMATAO) : posicion del pep
			_self.asigna_texto_celda(:tbl_8,LoPosicion ,1,TXT_PEP.write_string,30, :centre_left,5,LoColor)
			
		_endif
		
	_endif
	
	_return pl	
	
_endmethod
$
_pragma(classify_level=advanced, topic={plotting}, usage={subclassable})
_method c_sello_ruta_cables_fo.obtiene_informacion_admin_secundario(PoProyecto)
	#---------------------------------------------------
	##  Objetivo  : <Description>
	##
	#Parametros de entrada:Objeto  PoProyecto  Proyecto del diseño activo
	#Parametros de salida: Ninguno 
	#
	#Regresa:property_list  pl  Nombre del campo PEP y su valor.
	#
	#Fecha de última modificación: 2010-07-28
	#Autor de la modificación:Aarón Hernández Ramírez, SIGMATAO
	##
	#Descripción de la modificación:
	#
	#Inicio Control de cambios
	# (2010-07-28 Aarón Hernández Ramírez, SIGMATAO) : Creado
	#Fin de control de cambios
	
        proy <<  PoProyecto
	pl << property_list.new()
	pl[:valor] << ""
		
	_if _self.get_tipo_plano()= "PLANO MONTAJE DE TBA"
	_then
		pl[:nombre_campo] << "user!_pep_ba_ter_peba"
		pl[:valor] << proy.user!_pep_ba_ter_peba
	_endif
	
	LoColor << rope.new_with(1,0,0)
	TXT_OE << ""
	TXT_OEI << ""
	TXT_OP << ""
	TXT_PEP << ""
	
	LoDiseno << swg_dsn_admin_engine.active_design
	id_oe << LoDiseno.user!_oe_local_id
	
	# (10/07/13 fmejia) : si el if se cumple, tomamos las oes del
	# diseno activo y apartir de ellas sus oeis y opbs. de lo
	# contrario tomamos las opbs del proyecto.
	_if LoDiseno.user!_oe_locals.size > 0
	_then
		_for oe _over LoDiseno.user!_oe_locals.fast_elements()
		_loop
			#_if oe.user!_catalogo_pep = pl[:nombre_campo].uppercase
			#_then
				TXT_OE << oe.user!_num_oe
				TXT_OP << oe.user!_oei_local.user!_op_local.user!_num_op
				TXT_OEI << oe.user!_oei_local.user!_num_oei

				_if oe.user!_tipo_valor.matches?("*DESMONTAJE DE CANALIZACION*")
				_then
					indice << 10					
				_elif oe.user!_tipo_valor.matches?("*DESMONTAJE DE RED*")
				_then 
					indice << 8
				_elif oe.user!_tipo_valor.matches?("*DESMONTAJE DE TBA*") 
				_then
					indice << 8
				_else 
					indice << 3
				_endif
				
				_if  TXT_OE.index_of_seq( oe.user!_num_oe ) _is _unset 
				_then
					TXT_OE << TXT_OE + " " + oe.user!_num_oe	
				_endif
				
				LoOPB << oe.user!_oei_local.user!_op_local.user!_num_op
				
				_if TXT_OP.index_of_seq( LoOPB ) _is _unset 
				_then
					TXT_OP << TXT_OP + " " +  LoOPB
				_endif
				
				LoOEI << oe.user!_oei_local.user!_num_oei
				
				_if TXT_OEI.index_of_seq( LoOEI ) _is _unset 
				_then
					TXT_OEI << TXT_OEI + " " + LoOEI
				_endif													
				LoPEP << proy.perform(  oe.user!_catalogo_pep.lowercase.as_symbol() )
								
				_if TXT_PEP.index_of_seq( LoPEP ) _is _unset 
				_then
					TXT_PEP << TXT_PEP + " " + LoPEP
				_endif
				
				#_endif
		_endloop

		_if TXT_PEP.size > 0 
		_then
			_self.asigna_texto_celda(:tbl_8,indice,1,TXT_PEP.write_string,30, _unset,_unset,LoColor)	
		_endif
		
		_if TXT_OP.size > 0  
		_then
			_self.asigna_texto_celda(:tbl_8,indice,3,TXT_OP.write_string,30, _unset,_unset,LoColor)
		_endif
		
		_if TXT_OEI.size > 0 
		_then
			_self.asigna_texto_celda(:tbl_8,indice,4,TXT_OEI.write_string,30, _unset,_unset,LoColor)	
		_endif
		
		_if TXT_OE.size > 0 
		_then
			_self.asigna_texto_celda(:tbl_8,indice,5,TXT_OE.write_string,30, _unset,_unset,LoColor)	
		_endif
		
		
	_endif
	
	_return pl
	
_endmethod
