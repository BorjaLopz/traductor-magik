_pragma(classify_level=advanced, topic={plotting}, usage={subclassable})
_method c_sello_ruta_cables_fo.etiqueta_celdas()
	## 
	##
	#write(:etiqueta_simbolos)
	
	diseno << swg_dsn_admin_engine.active_design
	proy << diseno.project
	tipo_plano << _self.get_tipo_plano()
	
	l_nco_central << "CENTRAL"	
#	_if proy.name.matches?("FTTB*") _or
#	    proy.name.matches?("FALC*") # para proyecto FTTB o FALC cambia la etiqueta
#	_then
#		l_nco_central << "NCO"
#	_endif	

	_self.asigna_texto_celda(:tbl_1, 1,1, tipo_plano, 70,_unset)
	
        _self.asigna_texto_celda(:tbl_3 ,1,1, "PROGRAMA:", 35, _unset)
        _self.asigna_texto_celda(:tbl_3 ,2,1, "DIRECCIÓN DIVISIONAL:",35, :centre_left,2)
        _self.asigna_texto_celda(:tbl_3 ,3,1, "ÁREA:",35, :centre_left,2)
        _self.asigna_texto_celda(:tbl_3 ,4,1, l_nco_central,35, :centre_left,2)
        _self.asigna_texto_celda(:tbl_3 ,5,1, "DEPARTAMENTO:",35, :centre_left,2)
        _self.asigna_texto_celda(:tbl_3 ,6,1, "RESPONSABLE:",35, :centre_left,2)
        _self.asigna_texto_celda(:tbl_3 ,7,1, "DOMICILIO:",35, :centre_left,2)
        _self.asigna_texto_celda(:tbl_3 ,8,1, "TELEFONO:",35, :centre_left,2)
	
	_self.asigna_texto_celda(:tbl_4 ,1,1, "PROYECTO:",35,:centre_left,2)
	_self.asigna_texto_celda(:tbl_4 ,3,1, "SUPERVISO:",35,:centre_left,2)
	_self.asigna_texto_celda(:tbl_4 ,5,1, "FECHA DE ENTREGA:",35,:centre_left,2)

	_self.asigna_texto_celda(:tbl_4 ,7,1, "AÑO:",35,:centre_left,2)
	_self.asigna_texto_celda(:tbl_4 ,8,1, "CONSTRUCCIÓN:",35,:centre_left,2)

	_if swg_dsn_admin_engine.active_scheme.project.user!_empresa_proyecto = "GSP"
	_then
		_self.asigna_simbolo_celda(:tbl_logo_imtsa,1,1,"logo_gsp")
	_elif  swg_dsn_admin_engine.active_scheme.project.user!_empresa_proyecto = "IMTSA"
	_then	
		_self.asigna_simbolo_celda(:tbl_logo_imtsa,1,1,"logo_imtsa")
	_elif swg_dsn_admin_engine.active_scheme.project.user!_empresa_proyecto = "KBTEL"
	_then
		_self.asigna_simbolo_celda(:tbl_logo_imtsa,1,1,"logo_kbtel")
	_elif swg_dsn_admin_engine.active_scheme.project.user!_empresa_proyecto = "TELNOR"
	_then
		_self.asigna_simbolo_celda(:tbl_logo_imtsa,1,1,"logo_telnor")
	_endif

	_self.asigna_simbolo_celda(:tbl_logo_telmex,1,1,"logo_telmex_ep")

	_self.asigna_texto_celda(:tbl_5,1,1,"CABLES",35,:centre_left,2)
	_self.asigna_texto_celda(:tbl_6,1,1,"Vo.Bo.",35,:centre_left,2)
	
	_self.asigna_texto_celda(:tbl_7,1,2,"HOJA:",35,:centre_left,2)
	_self.asigna_texto_celda(:tbl_7,1,4,"DE:",35,:centre_left,2)

	
_endmethod
