_pragma(classify_level=advanced, topic={plotting}, usage={subclassable})
_method c_sello_ruta_cables_fo_sigp.obten_registros()

	pl_datos << property_list.new()

        pl_datos << _self.Calcula_informacion(pl_datos)
	
		
	pl_datos << _self.info_sello_propiedades(pl_datos) 
	
	_return pl_datos
	
_endmethod
$
_pragma(classify_level=advanced, topic={plotting}, usage={subclassable})
_method c_sello_ruta_cables_fo_sigp.busca_objeto(name)
	# (23/03/22 des_aaron) : recibe como parametro  el objeto como
	# simbolo p/e :mit_bay
	
	paf << smallworld_product.pni_application()
	mv << paf.plugin(:map_plugin).current_map_view
	objs << mv.get_visible_geometry_set()
	regs << equality_set.new()
	
	_if mv.ace_name _is :gs!schematic 
	_then	
		_for itergeom  _over objs.fast_elements()
		_loop		
			_if  (reg <<  itergeom.rwo.source_rwo_records().an_element()) _isnt _unset  _andif
			     reg.source_collection.name _is name 
			_then
				regs.add(reg)
			_endif
		_endloop	
	_endif
	
	>> regs
	
_endmethod
$




_pragma(classify_level=advanced, topic={plotting}, usage={subclassable})
_method c_sello_ruta_cables_fo_sigp.Calcula_informacion(pl_datos)
	#---------------------------------------------------
	## <Req. #> : <Description>
	##
	#
	# Customization for Project : 
	#
	#---------------- Revision History -----------------
	# (23/02/07 des_daniel) : Created
	#-------------- End Revision History ---------------
	diseno       <<  swg_dsn_admin_engine.active_design
	proy         <<  diseno.project	
	nombre       <<  proy.name
	programa     <<  proy.user!_programa_tipo
	direc_div    <<  proy.division
	area         <<  proy.area
	departamento <<  proy.user!_empresa_revisora
	proyectista  <<  diseno.user!_proyecto
	superviso    <<  diseno.user!_superviso
	fecha_entrega << proy.user!_fecha_entrega 
	anio          << proy.user!_programa_anyo
	construccion  << proy.planning_start
	vb             << diseno.user!_vobo
	LoEmpresa     << proy.user!_empresa_proyecto
	ctl           <<   diseno.project.user!_central
	siglasctl     << ctl.user!_central
	nombrectl     << ctl.user!_nombre
	nodo          << ctl.building
	# (22/09/26 des_aaron) : cables 
	jaladocables  << ""
	distritos     << ""
	numcable      << ""
	
	peps          << ""
	opb           << ""
	oei           << ""
	oe_str        << ""
	
	opbd           << ""
	oeid           << ""
	oed_str        << ""
	
	#####################################
        proyecto      << c_proyecto.new() 
	#####################################
	programa      << proyecto.programa
	oe            << proyecto.oe_reg_scheme(:construccion)
	oed           << proyecto.oe_reg_scheme(:desmontaje)
	
	_if oe _isnt _unset  
	_then
		(pep, tipo) << proyecto.obten_pep_de_oe(oe)
		
		peps          << pep      ##    "D-8404117-B017" + %newline + "D-8404117-B017"
		opb           << oe.user!_oei_local.user!_op_local.user!_num_op.write_string
		oei           << oe.user!_oei_local.user!_num_oei.write_string
		oe_str        << oe.user!_num_oe.write_string
	_endif
	
	
	
	
	_if oed _isnt _unset 
	_then
		(pep,tipo) << proyecto.obten_pep_de_oe(oed)
		
		peps          << peps + %newline +  pep ##    "D-8404117-B017" + %newline + "D-8404117-B017"
		opbd           << oed.user!_oei_local.user!_op_local.user!_num_op.write_string
		oeid           << oed.user!_oei_local.user!_num_oei.write_string
		oed_str      << oed.user!_num_oe.write_string
	_endif
	
	meses         << {:ene, :feb, :mar, :abr, :may, :jun,:jul, :ago, :sep, :oct,:nov, :dic}	
	mes           << meses[date_now().month_number]
	anio          << date_now().year
	
        fecha         << mes.write_string + %/ + anio.write_string
	fecha         << fecha.uppercase
	
	_if nodo _isnt _unset 
	_then
		(nconombre, ncosiglas) <<  nodo.datos_nco
	_else
		nconombre   << ""
		ncosiglas   << ""
	_endif
	
	str_ctl << "CENTRAL - " + nombrectl + %space + %( + siglasctl + %)
	str_nco << "NCO - " + nconombre +  %space + %( + ncosiglas + %) + %space  +  " CTL- " + nombrectl + %space + %( + siglasctl + %)
	
	pl_datos[:programa] << programa
	pl_datos[:pep] << peps
	pl_datos[:vobo] << vb
	pl_datos[:proyecto] << proyectista
	pl_datos[:supervisor] << superviso
	pl_datos[:const_opb] << opb
	pl_datos[:const_oei] << oei
	pl_datos[:const_oe] << oe_str
	pl_datos[:desm_opb] << opbd
	pl_datos[:desm_oei] << oeid
	pl_datos[:desm_oe] << oed_str
	pl_datos[:fecha] << fecha
	
	pl_datos[:siglas] << "NCO_" + ncosiglas

	##jalado de cable
        txts <<  proyecto.jalado_de_cables
	txt << ""
	
	_for itertxt    _over txts.fast_elements()
		_loop
			txt << txt + itertxt + %newline
		_endloop
	
	pl_datos[:jaladocable] << txt.uppercase
	
	##cable principal
	cable_principal << proyecto.cable_principal().an_element()

	_if cable_principal _isnt _unset 
	_then
		pl_datos[:numcable] << cable_principal.name
	_else
		pl_datos[:numcable] << ""
	_endif


	##distritos afectados
	
	pl_datos[:distritos] << proyecto.distritos_afectados()

	
	_return pl_datos
_endmethod
$

_pragma(classify_level=advanced, topic={plotting}, usage={subclassable})
_method c_sello_ruta_cables_fo_sigp.info_sello_propiedades(pl_datos)

	pl_datos[:programa]         <<   _self.valor_propiedad(:programa,    pl_datos[:programa])
	pl_datos[:jaladocable]      <<   _self.valor_propiedad(:jaladocable, pl_datos[:jaladocable])
	pl_datos[:numcable]         <<   _self.valor_propiedad(:numcable,    pl_datos[:numcable])
	pl_datos[:distritos]        <<   _self.valor_propiedad(:distritos,   pl_datos[:distritos])
	pl_datos[:hoja]             <<   _self.valor_propiedad(:hoja,        pl_datos[:hoja])
	pl_datos[:desm_opb]         <<   _self.valor_propiedad(:desm_opb,    pl_datos[:desm_opb] )
	pl_datos[:desm_oei]         <<   _self.valor_propiedad(:desm_oei,    pl_datos[:desm_oei] )
	pl_datos[:desm_oe]          <<   _self.valor_propiedad(:desm_oe,     pl_datos[:desm_oe]  )
	pl_datos[:pep]              <<   _self.valor_propiedad(:pep,         pl_datos[:pep] )
	pl_datos[:vobo]             <<   _self.valor_propiedad(:vobo,        pl_datos[:vobo] )
	pl_datos[:proyecto]         <<   _self.valor_propiedad(:proyecto,    pl_datos[:proyecto] )
	pl_datos[:supervisor]       <<   _self.valor_propiedad(:supervisor,  pl_datos[:supervisor] )
	pl_datos[:siglas]           <<   _self.valor_propiedad(:siglas,      pl_datos[:siglas] )
	pl_datos[:fecha]            <<   _self.valor_propiedad(:fecha,       pl_datos[:fecha] )
						    
	pl_datos[:const_opb]        <<   _self.valor_propiedad(:const_opb,   pl_datos[:const_opb] )
	pl_datos[:const_oei]        <<   _self.valor_propiedad(:const_oei,   pl_datos[:const_oei] )
	pl_datos[:const_oe]         <<   _self.valor_propiedad(:const_oe,    pl_datos[:const_oe]  )

	_return pl_datos
	
_endmethod
$


_pragma(classify_level=advanced, topic={plotting}, usage={subclassable})
_method c_sello_ruta_cables_fo_sigp.valor_propiedad(Propiedad, dato_actual)
	## 
	##
	_if _self.attributes[Propiedad]  _isnt _unset  _andif
	    _self.attributes[Propiedad].value _isnt _unset _andif
	    _self.attributes[Propiedad].value.write_string.size > 0
	_then
		LoPropiedad << _self.attributes[Propiedad].value.write_string.uppercase
	_else
		LoPropiedad << dato_actual
	_endif

	_return LoPropiedad
	
_endmethod
$
