_package user
$
def_slotted_exemplar(:c_simbolo_grafico,
		     {
			     {:sNombre_Grafico, _unset}, # Nombre del grafico
			     {:bVoltear_H,      _false}, # Bandera para voltear la figura Horizontalmente
			     {:bVoltear_V,      _false}, # Bandera para voltear la figura Verticalmente
			     {:nGrados,              0}, # Angulo de rotacion. (default 0 Grados)
			     {:o_sty_view,      _unset}
		     },
		     :c_elemento_grafico
)
$
c_simbolo_grafico.define_slot_access(:bVoltear_H,         :writable, :private)
$
c_simbolo_grafico.define_slot_access(:bVoltear_V,         :writable, :private)
$
c_simbolo_grafico.define_slot_access(:nGrados,            :writable, :private)
$
c_simbolo_grafico.define_slot_access(:sNombre_grafico,    :writable, :private)
$
_pragma(classify_level=restricted, usage={redefinable})
_method c_simbolo_grafico.bVoltear_H? 
## Objetivo: Consultar si la figura debe ser volteada
## Horizontalmente, tomando el valor del slot bVoltear_H
## Parámetros de entrada:  NA
## Parámetros de salida:   NA
## Regresa: 
##   Booleano - bVoltear - Indica si se debe voltear o no el simbolo
## Fecha de última modificación: 3/11/2004
## Autor de la modificación : fdiaz
## Descripción de la modificación: Se documentó

	_return .bVoltear_H 
	
_endmethod
$
_pragma(classify_level=restricted, usage={redefinable})
_method c_simbolo_grafico.bVoltear_H? << RbValor
## Objetivo: Indicar si la figura debe ser volteada
## Horizontalmente asignado el valor al slot bVoltear_h
## Parámetros de entrada:  
##    Booleano - RbVoltear - Verdadero si la figura debe ser volteada horizontalmente
##                           False si la figura no debe ser volteada horizontalmente
## Parámetros de salida:   NA
## Regresa: NA
## Fecha de última modificación: 3/11/2004
## Autor de la modificación : fdiaz
## Descripción de la modificación: Se documentó

	.bVoltear_H << RbValor
	
_endmethod
$
_pragma(classify_level=restricted, usage={redefinable})
_method c_simbolo_grafico.bVoltear_V? 
## Objetivo: Consultar si la figura debe ser volteada
## Verticalmente y regresar el valor del slot bVoltear_V
## Parámetros de entrada:  NA
## Parámetros de salida:   NA
## Regresa:
##   Booleano - bVoltear - Se indica si el simbolo se debe de voltear
## Fecha de última modificación: 3/11/2004
## Autor de la modificación : fdiaz
## Descripción de la modificación: Se documentó

	_return .bVoltear_V
	
_endmethod
$
_pragma(classify_level=restricted, usage={redefinable})
_method c_simbolo_grafico.bVoltear_V? << RbValor
## Objetivo: Indicar si la figura debe ser volteada
## Verticalmente y asignarle el valor al slot bVoltear_V
## Parámetros de entrada:  
##    Booleano - RbVoltear - Verdadero si la figura debe ser volteada verticalmente
##                           False si la figura no debe ser volteada verticalmente
## Parámetros de salida:   NA
## Regresa: NA
## Fecha de última modificación: 3/11/2004
## Autor de la modificación : fdiaz
## Descripción de la modificación: Se documento

	.bVoltear_V << RbValor
	
_endmethod
$
_pragma(classify_level=restricted, usage={redefinable})
_method c_simbolo_grafico.Despliega()
## Objetivo: Realizar el dibujo del simbolo
## Parámetros de entrada: NA
## Parámetros de salida:  NA 
## Regresa: NA
## Fecha de última modificación: 28/10/2004
## Autor de la modificación : fdiaz
## Descripción de la modificación: Se documento

_local LoSym         # Almacena el simbolo que se dibujara
_local LoAreaSimbolo # Area en la que se dibujara el simbolo
	
	#Se actualiza el area del elemento en base a los margenes establecidos
	#_self.Actualiza_Area_Elemento()
	
	LoAreaSimbolo << _self.oArea

	gpm << gis_program_manager
	sty_view << gpm.databases[:sigc_style_view]

	_if (sty_view) _is _unset _orif _self.grupo_estilos = :default
	_then
		syb_table << gpm.style_view.collections[:sw_gis!gis_point_style]
	_else
		syb_table << sty_view.collections[:sw_gis!gis_point_style]
	_endif
	
	LoSym << syb_table.new_detached_record()
	
	LoSym.symbol_name << _self.sNombre_Grafico
	LoSym.realise ( _unset, _unset )

	LoSym.draw_sample ( _self.oVentana, LoAreaSimbolo,
				  :rotate,   _self.nGrados,
				  :flipped?, _self.bVoltear_H?, 
				  :mirror?,  _self.bVoltear_V?)
	
_endmethod
$
_pragma(classify_level=restricted, usage={redefinable})
_method c_simbolo_grafico.grupo_estilos

	_return .o_sty_view
	
_endmethod
$
_pragma(classify_level=restricted, usage={redefinable})
_method c_simbolo_grafico.grupo_estilos << sValor

	.o_sty_view << sValor
	
_endmethod
$
_pragma(classify_level=advanced, topic={plotting}, usage={subclassable})
_method c_simbolo_grafico.init_with( props )

	_super.init_with( props )

	_self.bvoltear_h? << props[:bVoltear_H]
	_self.bvoltear_v? << props[:bVoltear_V]

	>> _self
	
_endmethod
$
_pragma(classify_level=restricted, usage={redefinable})
_method c_simbolo_grafico.new(RsNombre)
##  Objetivo: Crear una instancia de la clase simbolo_grafico
##  Parámetros de entrada:  
##     String  - RsNombre - Nombre del simbolo
##  Parámetros de salida:   NA
##  Regresa: 
##    c_filas - regresa un objeto c_simbolo_grafico
## Fecha de última modificación: 3/11/2004
## Autor de la modificación : fdiaz
## Descripción de la modificación: Se documento

	_self.sNombre_Grafico << RsNombre
	
	_return _clone
	
_endmethod
$
_pragma(classify_level=restricted, usage={redefinable})
_method c_simbolo_grafico.new_from(RoObjeto, _optional RsNombre_Grafico)
## Objetivo: Constructor de copia
## Parámetros de entrada: 
##    c_simbolo_grafico - RoObjeto - Objeto del cual se copiaran los atributos
##    String - RsNombre - nombre del grafico que desea cargar 	
## Parámetros de salida:   NA
## Regresa:  
##    c_Simbolo_grafico - Instancia de Simbolo_grafico 
## Fecha de última modificación : 04/01/04
## Autor de la modificación fdiaz
## Descripción de la modificación : Se modifico el nombre de
##                                  los atributos
##    25/01/05 DSB  se dividio entre 10 los atributos	
##    23/12/04 DSB  se valido que el objeto sea de tipo c_simbolo_grafico


   _if RoObjeto.is_kind_of?(c_simbolo_grafico)
   _then
        _if RsNombre_Grafico = _unset 
	_then
		_self.sNombre_grafico << RoObjeto.sNombre_Grafico
	_else
	        _self.sNombre_grafico << RsNombre_Grafico
	_endif

	#valores por defecto de las celdas
	_self.bVoltear_H?  << RoObjeto.bVoltear_H?
	_self.bVoltear_V?  << RoObjeto.bVoltear_V?
	_self.nMargen_izq  << RoObjeto.nMargen_izq / 10
	_self.nMargen_der  << RoObjeto.nMargen_der / 10 
	_self.nMargen_sup  << RoObjeto.nMargen_sup / 10
	_self.nMargen_inf  << RoObjeto.nMargen_inf / 10		
	_self.nGrados      << RoObjeto.nGrados

	_return _clone
   _else
	condition.raise(:warning, :string, "El objeto que se proporcionó, no es de tipo c_símbolo_grafico")	
   _endif 	         
	
_endmethod
$
_pragma(classify_level=restricted, usage={redefinable})
_method c_simbolo_grafico.nGrados 
## Objetivo: Obtener el angulo de rotación que esta asignado al
##           slot nGrados	
## Parámetros de entrada:  NA
## Parámetros de salida:   NA
## Regresa: 
##   Entero - nGrados - Angulo a rotar el grafico
## Fecha de última modificación: 3/11/2004
## Autor de la modificación : fdiaz
## Descripción de la modificación: Se documento

	_return .nGrados
	
_endmethod
$
_pragma(classify_level=restricted, usage={redefinable})
_method c_simbolo_grafico.nGrados << RnValor
## Objetivo: Asignar el angulo de rotación al slot nGrados
## Parámetros de entrada:  
##    Entero - RnAngulo - Indicando el angulo a rotar
## Parámetros de salida:   NA
## Regresa: NA
## Fecha de última modificación: 3/11/2004
## Autor de la modificación : fdiaz
## Descripción de la modificación: Se documento

	.nGrados << RnValor
	
_endmethod
$
_pragma(classify_level=restricted)
_method c_simbolo_grafico.serial_slots()

	( keys, values ) << _super.serial_slots()

	keys.add_all_last( rope.new_with(:sNombre_grafico,:bVoltear_H,:bVoltear_V,:nGrados,:grupo_estilos))
	values.add_all_last( rope.new_with(.sNombre_grafico,.bVoltear_H,.bVoltear_V,.nGrados,
				  _self.grupo_estilos))

	_return keys, values
	
_endmethod
$
_pragma(classify_level=restricted, usage={redefinable})
_method c_simbolo_grafico. sNombre_Grafico 
## Objetivo: Retornar el nombre del grafico, asignado en el
##           slot sNombre_Grafico
## Parámetros de entrada:  NA
## Parámetros de salida:   NA
## Regresa: El nombre del grafico 
## Fecha de última modificación: 3/11/2004
## Autor de la modificación : fdiaz
## Descripción de la modificación: Se documento

        _return .sNombre_Grafico 
        
_endmethod
$
_pragma(classify_level=restricted, usage={redefinable})
_method c_simbolo_grafico. sNombre_Grafico << RsValor
## Objetivo: Asignar el nombre del grafico al slot sNombre_Grafico
## Parámetros de entrada:  
##    String - RsValor - Nombre del grafico
## Parámetros de salida:   NA
## Regresa: NA
## Fecha de última modificación: 3/11/2004
## Autor de la modificación : fdiaz
## Descripción de la modificación: Se documentó

        .sNombre_Grafico << RsValor	
        
_endmethod
$
