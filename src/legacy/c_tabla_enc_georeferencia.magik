_package user
$

remex(:c_tabla_enc_georeferencia)
$

def_slotted_exemplar(:c_tabla_enc_georeferencia,
                      {}, :c_base_sello_fibra)
$

_pragma(classify_level=advanced, topic={plotting}, usage={subclassable})
_method c_tabla_enc_georeferencia.configura_tabla()
	##
	##
	
	#----------------------------------------------------------
	# Tabla Status
	#-----------------------------------------------------------
	_local pl_cfg_tbl_status << property_list.new()
	pl_cfg_tbl_status[:ren] << {5,5,5}
	pl_cfg_tbl_status[:col] << {25,25}

        lo_tabla << .o_tablas.crea_tabla(3,2, :tbl_status)
	lo_tabla.oCoordenada_Origen << .o_coord_inicio
	_self.asigna_medidas_tabla(lo_tabla, pl_cfg_tbl_status)

	lo_celda << lo_tabla.oceldas.celda(1,1).oelementos.obten_elemento(:bordes_celda)
	lo_celda.bBorde_Der? << _false
	lo_tabla.color_linea << rope.new_with(0.2,0.6,0)
	#----------------------------------------------------------
	# Tabla Terminal
	#-----------------------------------------------------------
	_local pl_cfg_tbl_terminal << property_list.new()
	pl_cfg_tbl_terminal[:ren] << {8}
	pl_cfg_tbl_terminal[:col] << {8,6,11}

	_local ln_desp_y << .o_tablas.longitud_total_renglones({:tbl_status})
	
        lo_tabla << .o_tablas.crea_tabla(1,3, :tbl_terminal)
	lo_tabla.oCoordenada_Origen << coordinate.new( .o_coord_inicio.x,
						       .o_coord_inicio.y - ln_desp_y)
	_self.asigna_medidas_tabla(lo_tabla, pl_cfg_tbl_terminal)
	lo_tabla.color_linea << rope.new_with(0.2,0.6,0)	
	#----------------------------------------------------------
	# Tabla Georeferencia
	#-----------------------------------------------------------
	_local pl_cfg_tbl_georeferencia << property_list.new()
	pl_cfg_tbl_georeferencia[:ren] << {3,5}
	pl_cfg_tbl_georeferencia[:col] << {11,14}

	_local ln_desp_x << .o_tablas.longitud_total_columnas({:tbl_terminal})
	
        lo_tabla << .o_tablas.crea_tabla(2,2, :tbl_georeferencia)
	lo_tabla.oCoordenada_Origen << coordinate.new( .o_coord_inicio.x + ln_desp_x,
						       .o_coord_inicio.y - ln_desp_y)
	_self.asigna_medidas_tabla(lo_tabla, pl_cfg_tbl_georeferencia)

	lo_celda << lo_tabla.oceldas.celda(1,1).oelementos.obten_elemento(:bordes_celda)
	lo_celda.bBorde_Der? << _false
	lo_tabla.color_linea << rope.new_with(0.2,0.6,0)	

	_self.etiqueta_celdas()
_endmethod
$

_pragma(classify_level=advanced, topic={plotting}, usage={subclassable})
_method c_tabla_enc_georeferencia.etiqueta_celdas()
	## 
	##
	_local LoColor << {0.2,0.6,0}
	
	_self.asigna_texto_celda(:tbl_status, 1, 1, "STATUS TERMINAL", 20, :centre_centre, 25,LoColor)
	_self.asigna_texto_celda(:tbl_status, 2, 1, "C=CONECTADA", 20,_unset,_unset,LoColor)
	_self.asigna_texto_celda(:tbl_status, 2, 2, "A=AUMENTO", 20,_unset,_unset,LoColor)
	_self.asigna_texto_celda(:tbl_status, 3, 1, "S=SUSTITUIDA", 20,_unset,_unset,LoColor)
	_self.asigna_texto_celda(:tbl_status, 3, 2, "R=RESERVA", 20,_unset,_unset,LoColor)	
	
	_self.asigna_texto_celda(:tbl_terminal, 1, 1, "TERMINAL", 15,_unset,_unset,LoColor)
	_self.asigna_texto_celda(:tbl_terminal, 1, 2, "STATUS", 15,_unset,_unset,LoColor)
	_local lo_etiq_terminal_1_3 << "DIST. A CEDO" + %newline + "(Mts)"
	_self.asigna_texto_celda(:tbl_terminal, 1, 3, lo_etiq_terminal_1_3, 15,_unset,_unset,LoColor)

	_self.asigna_texto_celda(:tbl_georeferencia, 1, 1, "GEOREFERENCIA", 18 ,:centre_centre, 12,LoColor)
	_self.asigna_texto_celda(:tbl_georeferencia, 2, 1, "GEO", 18,_unset,_unset,LoColor)
	_self.asigna_texto_celda(:tbl_georeferencia, 2, 2, "UTM", 18,_unset,_unset,LoColor)
_endmethod
$
