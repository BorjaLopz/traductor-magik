_method c_tbl_linea_Horizontal.oLayout << valor

	.oLayout << valor
	
_endmethod
$
_pragma(classify_level=restricted, usage={redefinable})
_method c_tbl_linea_Horizontal.oTablas

	>> .oTablas
	
