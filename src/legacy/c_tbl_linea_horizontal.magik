_pragma(classify_level=restricted, usage={redefinable})
_method c_tbl_linea_Horizontal.prvAsigna_Etiquetas_Tabla()
##  Objetivo: Asigna los valores de la coleccion de etiquetas a
##            su correspoendeinte celda
##  Parámetros de entrada: NA
##  Parámetros de salida:  NA
##  Regresa: NA
##  Fecha de última modificación: 16/11/2004
##  Autor de la modificación : dsanchez
##  Descripción de la modificación: Se creo
	
_if .collEtiquetas _isnt _unset
_then
	_local LnRen << 1 # Número del renglon 
	_for LoCad  _over _self.collEtiquetas.fast_elements()
	_loop
	   _self.celda(LnRen,1).sTexto << LoCad
	   LnRen << LnRen + 1
	_endloop
_endif
	
_endmethod
$
_pragma(classify_level=restricted, usage={redefinable})
_method c_tbl_linea_Horizontal.prvAsigna_Obj_Tbl_Detalle()
## Objetivo: Asigna el objeto que contendra cada celda de la tabla
##           detalle
## Parámetros de entrada: NA
## Parámetros de salida:   NA
## Regresa: NA
## Fecha de última modificación: 16/11/2004
## Autor de la modificación : dsanchez
## Descripción de la modificación: Se creo

	_local LoTexto # Objeto que servira como base para crear lso demas objetos 
	_local LoTabla # Almacena la tabla detalle

	LoTexto << c_texto_linea_grafico.new("")
	LoTexto.sAlineacion << :centre_left
	
	LoTabla << _self.oTablas.elemento(:tbl_Detalle)
	
	_for LnCont  _over  range(1, _self.nNumRen)
	_loop
	   LoTabla.oCeldas.celda(LnCont, 1).oElemento << c_texto_grafico.new_from(LoTexto,"Vacio")
	   LoTabla.oCeldas.celda(LnCont, 2).oElemento << c_texto_Linea_grafico.new_from(LoTexto,
											" ")
	_endloop

_endmethod
$
_pragma(classify_level=restricted, usage={redefinable})
_method c_tbl_linea_Horizontal.prvAsigna_Valores_Tabla()
##  Objetivo: Asigna los valores de la coleccion de valores a
##            su correspoendeinte celda
##  Parámetros de entrada: NA
##  Parámetros de salida:  NA
##  Regresa: NA
##  Fecha de última modificación: 16/11/2004
##  Autor de la modificación : dsanchez
##  Descripción de la modificación: Se creo

_if .collValores _isnt _unset
_then
	_local LnRen << 1 # Número de renglon
	_for LoCad  _over _self.collValores.fast_elements()
	_loop
	   _self.celda(LnRen,2).sTexto << LoCad
	   LnRen << LnRen + 1
	_endloop
_endif
	
_endmethod
$
_pragma(classify_level=restricted, usage={redefinable})
_method c_tbl_linea_Horizontal.prvCrea_Tablas()
## Objetivo: manda llamar los metodos que crean las tablas que
##           componen esta tabla
## Parámetros de entrada: NA
## Parámetros de salida:   NA
## Regresa: NA
## Fecha de última modificación: 28/10/2004
## Autor de la modificación : dsanchez
## Descripción de la modificación: Se documento

	_local LnAltura # altura de la tabla de titulo
	_local LoCoord  # Coordenada donde se dibujara la tabla detalle

	LnAltura << 0
	_if _self.bConTitulo = _true 
	_then
  	   LnAltura << _self.prvCrea_Tbl_Titulo(_self.oCoordOrigen)
	_endif
	
	LoCoord << coordinate.new(_self.oCoordOrigen.x, _self.oCoordOrigen.y - LnAltura )
	_self.prvCrea_Tbl_Detalle(LoCoord)
	
_endmethod
$
_pragma(classify_level=restricted, usage={redefinable})
_method c_tbl_linea_Horizontal.prvCrea_Tbl_Detalle(RoCoord)
## Objetivo: Crea la tabla que define las caracteristicas del detalle
## Parámetros de entrada:
##   RoCoord - donde iniciara la tabal a dibujarse
## Parámetros de salida:   NA
## Regresa: NA
## Fecha de última modificación: 28/10/2004
## Autor de la modificación : dsanchez
## Descripción de la modificación: Se documento	

	_local LoTblDetalle # Objeto que representa a la tabla detalle
	_local LnLongRen    # Longitud de los renglones de la tabla detelle

	LoTblDetalle << _self.oTablas.crea_tabla(_self.nNumRen,2,:tbl_Detalle)

	# Coordenada donde iniciara la tabla
	LoTblDetalle.oCoordenada_Origen << RoCoord

	# longitudes de los renglones de la tabla, esta dada en mm
	LnLongRen << _self.nAlto / _self.nNumRen
	
	_for LnCont  _over  range(1, _self.nNumRen)
	_loop
	   LoTblDetalle.oRenglones.elemento(LnCont).nLongitud << LnLongRen
	_endloop
	
_endmethod
$
_pragma(classify_level=restricted, usage={redefinable})
_method c_tbl_linea_Horizontal.prvCrea_Tbl_Titulo(RoCoord)
## Objetivo: Crea la tabla que almacena el titulo de la tabla
## Parámetros de entrada:
##   RoCoord - Coordenada donde iniciara la tabla
## Parámetros de salida:   NA
## Regresa: NA
## Fecha de última modificación: 28/10/2004
## Autor de la modificación : dsanchez
## Descripción de la modificación: Se documento

	_local LoTblTit # Objeto de la tabla titulo
	_local LnAltura # Altura de la tabla titulo

	LoTblTit << _self.oTablas.crea_tabla(1,1,:tbl_tit)

	# Coordenada donde iniciara la tabla
	LoTblTit.oCoordenada_Origen << RoCoord

	# longitudes de los renglones de la tabla, esta dada en mm
        LoTblTit.oRenglones.elemento(1).nLongitud << 10

	LnAltura << _self.oTablas.Longitud_total_renglones({:tbl_tit})
        _return LnAltura
        
_endmethod
$
_pragma(classify_level=restricted, usage={redefinable})
_method c_tbl_linea_Horizontal.Renglon(RnRen)
##  Objetivo: retorna un elemento que representa a un renglon
##  Parámetros de entrada:
##     RnCol. Número de renglon  al que se desea acceder 
##  Parámetros de salida:   NA
##  Regresa:
##   c_fila: renglon que se desea acceder de la tabla detalle	
##  Fecha de última modificación: 16/11/2004
##  Autor de la modificación : dsanchez
##  Descripción de la modificación: Se creo


        _return _self.oTablas.elemento(:tbl_detalle).oRenglones.elemento(RnRen)

_endmethod
$
_pragma(classify_level=restricted, usage={redefinable})
_method c_tbl_linea_Horizontal.serial_slots()

	keys << rope.new_with( :oTablas , :bConTitulo, :nNumRen)
	values << rope.new_with( .oTablas, .bConTitulo, .nNumRen )

	>> keys, values
	
_endmethod
$
_pragma(classify_level=restricted, usage={redefinable})
_method c_tbl_linea_Horizontal.serial_structure

	>> :slotted
	
_endmethod
$
_pragma(classify_level=restricted, usage={redefinable})
_method c_tbl_linea_Horizontal.titulo_Renglon(RnRen)
## Objetivo: retorna el elemento que se encuentra en la tabla
##           que almacena el titulo de la tabla
## Parámetros de entrada:
##    RnRen. Numero del renglon al que se desea acceder
## Parámetros de salida:
##    c_fila:	Regresa el renglon de la tabla
## titulo 
## Regresa: NA
## Fecha de última modificación: 16/11/2004
## Autor de la modificación : dsanchez
## Descripción de la modificación: Se creo	

        _return _self.oTablas.elemento(:tbl_tit).oRenglones.elemento(RnRen)
        
_endmethod
$
