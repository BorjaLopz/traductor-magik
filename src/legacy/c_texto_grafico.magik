_package user
$
def_slotted_exemplar(:c_texto_grafico,
		     {
			{:sTexto,        _unset}, # Texto a desplegar
			{:sOrientacion,  _unset}, # Orientacion del Texto
			{:sAlineacion,   _unset}, # Alineacion del Texto
			{:nTamanio,      _unset}, # Tamaño de letra
			{:sEstilo,       _unset}, # Estilo
			{:sColor,        _unset}, # Color
			{:bSubrayado?,   _unset}, # Color
			{:nGrados,       _unset} # Color
			
		     },
		     :c_elemento_grafico
)

$
c_texto_grafico.define_slot_access(:bSubrayado?,       :writable, :private)
$
c_texto_grafico.define_slot_access(:nGrados,           :writable, :private)
