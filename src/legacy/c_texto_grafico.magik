_pragma(classify_level=restricted, usage={redefinable})
_method c_texto_grafico.nTamanio << RnValor
## Objetivo: Asignar un valor permitido al slot nTamanio
## Parámetros de entrada:
## 	Entero - RnValor : Tamanio de letra del texto
## Parámetros de salida:   NA
## Regresa: NA
## Fecha de última modificación: 4/11/2004
## Autor de la modificación : dsanchez
## Descripción de la modificación: Se documentó

	_if RnValor > 0 
	_then
 	   .nTamanio << RnValor
	_else
	   condition.raise(:warning, :string, "Debe ser un número positivo.")	
	_endif
	
_endmethod
$
_pragma(classify_level=restricted, usage={redefinable})
_method c_texto_grafico.sAlineacion
## Objetivo: retornar en valor del slot sAlineacion
## Parámetros de entrada:  NA
## Parámetros de salida:   NA
## Regresa: 
## 	Cadena - sAlineacion : Alineacion del texto
## Fecha de última modificación: 3/11/2004
## Autor de la modificación : dsanchez
## Descripción de la modificación: Se documentó
	
	_return .sAlineacion
	
_endmethod
$
_pragma(classify_level=restricted, usage={redefinable})
_method c_texto_grafico.sAlineacion << RsValor
## Objetivo: Asignar un valor permitido al slot sAlineacion
## Parámetros de entrada:
## 	simbolo - RsValor - Alineacion del texto
## Parámetros de salida:   NA
## Regresa: NA
## Fecha de última modificación: 3/11/2004
## Autor de la modificación : dsanchez
## Descripción de la modificación: Se documentó
	
	_if RsValor = :centre_right _or RsValor = :centre_centre _or RsValor = :centre_left _or
	    RsValor = :top_right    _or RsValor = :top_centre    _or RsValor = :top_left _or
    	    RsValor = :bottom_right _or RsValor = :bottom_centre _or RsValor = :bottom_left 
	_then
 	   .sAlineacion << RsValor
	_else
	   condition.raise(:warning, :string, "Error al asignar la alineación")	
	_endif
	
_endmethod
