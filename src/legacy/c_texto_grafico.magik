_pragma(classify_level=restricted)
_method c_texto_grafico.serial_slots()

	( keys, values ) << _super.serial_slots()
	
	keys.add_all_last( rope.new_with(
				  :sTexto,:sOrientacion,:sAlineacion,:nTamanio,
				  :sEstilo,:sColor,:bSubrayado,:nGrados))
	values.add_all_last( rope.new_with(
				  .sTexto,.sOrientacion,.sAlineacion,.nTamanio,
				  .sEstilo,.sColor,.bSubrayado?,.nGrados))

	_return keys, values
	
_endmethod
