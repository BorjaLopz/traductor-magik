_package user
$
def_slotted_exemplar(:c_tramo_can,
{
	{:objeto,               _unset, :writable},
	{:oCanalizacion,        _unset, :writable},
	{:oPozos,               _unset, :writable},
	{:oOE,                  _unset, :writable},
	{:oOEI,                 _unset, :writable},
	{:oOPB,                 _unset, :writable},
	{:oRuta,                _unset, :writable},
	{:ocol_long_obra_sup,   _unset, :writable},
	{:ocol_long_obra,       _unset, :writable},
	{:ocol_long_obra_cepa,  _unset, :writable},
	{:ocol_long_obra_tubos, _unset, :writable},
	{:ocol_long_obra_m_via, _unset, :writable}
})
$
_pragma(classify_level=restricted, usage={redefinable})
_method c_tramo_can.asigna_tramo << p_tramo

	## Objetivo:
	##     - Asigna a .objeto << p_tramo
	##     - Asigna a .oCanalizacion << canalizaciones en el tramo
	##     - Asigna a .oPozos << pozos y puntos de conexión en el tramo
   	## Parámetros de entrada:
	##     p_tramo - objeto user!_tramo_co
   	## Parámetros de salida:
	## vbluna

	_try
		.objeto << p_tramo
		( .oCanalizacion, .oPozos) << .objeto.obtener_canalizacion()
	_when does_not_understand
		write("Error al asignar el tramo")
	_endtry
	
_endmethod
$
_pragma(classify_level=restricted, usage={redefinable})
_method c_tramo_can.cajas_dist

   	## Parámetros de salida:
	##     lcol_cajas_dist - equality_set con las cajas de
	##        distribucion conectadas a la canalizacion asociada al tramo
	## vbluna

	_local lcol_cajas_dist << equality_set.new()
	
	_for oCan _over _self.canalizacion.elements()
	_loop
		_for oStruc _over oCan.connected_structures().elements()
		_loop
			_if oStruc.source_collection.name = :mit_terminal_enclosure
			_then
				lcol_cajas_dist.add(oStruc)
			_endif
		_endloop
	_endloop

	_return lcol_cajas_dist
	
_endmethod
$
_pragma(classify_level=restricted, usage={redefinable})
_method c_tramo_can.calcular_longitud_obra()

	## Objetivo:
	##     - Suma la longitud medida de las canalizaciones asociadas
	##       al tramo con tipos de obra proyectadas agrupada por tipo
	##       de obra siempre y cuando  el tipo de obra sea la obra principal del tramo
	##     - Esta longitud será igual a la suma de las longitudes
	##       de cada una de las superficies del tipo de obra
   	## Parámetros de salida:
	##     .ocol_long_obra - hash_table
	##       [:|Tipo de Obra|] << longitud mts
	## vbluna

	_local col_obras << hash_table.new()
	_local ls_tipo_obra
	_local ln_long_can
	_local ln_long_total
	_local ln_gran_total

	_for oCan _over _self.canalizacion.elements()
	_loop
		ln_long_can << oCan.measured_length.default(length_value(0.0, :m)).value
		
		_for cond_bund _over oCan.calcular_obras_normalizadas_asociadas[:proyectado].elements()
		_loop
			_if oCan.obra_principal = cond_bund
			_then
				ls_tipo_obra  << cond_bund.name.as_symbol()
				ln_long_total << col_obras[ls_tipo_obra].default(0.0)
				col_obras[ls_tipo_obra] << ln_long_total + ln_long_can
				ln_gran_total << col_obras[:|Total|].default(0.0)
				col_obras[:|Total|] << ln_gran_total + ln_long_can
			_endif
		_endloop
	_endloop

   _return .ocol_long_obra << col_obras
	
_endmethod
$
_pragma(classify_level=restricted, usage={redefinable})
_method c_tramo_can.calcular_longitud_obra_cepa_hecha()

	## Objetivo:
	##     - Suma la longitud medida de las canalizaciones asociadas
	##       al tramo con tipos de obra proyectadas agrupada
	##       por tipo de obra siempre y cuando
	##       el tipo de obra NO sea la obra principal del tramo
   	## Parámetros de salida:
	##     .ocol_long_obra_cepa - hash_table
	##       [:|Tipo de Obra|] << longitud mts
	## vbluna

	_local col_obras << hash_table.new()
	_local ln_long_can
	_local ln_long_total

	_for oCan _over _self.canalizacion.elements()
	_loop
		ln_long_can << oCan.measured_length.default(length_value(0.0, :m)).value
		
		_for cond_bund _over oCan.calcular_obras_normalizadas_asociadas[:proyectado].elements()
		_loop
			_if oCan.obra_principal <> cond_bund
			_then
				ln_long_total << col_obras[cond_bund.name.as_symbol()].default(0.0)
				col_obras[cond_bund.name.as_symbol()] << ln_long_total + ln_long_can
			_endif
		_endloop
	_endloop

   _return .ocol_long_obra_cepa << col_obras
	
_endmethod
$
_pragma(classify_level=restricted, usage={redefinable})
_method c_tramo_can.calcular_longitud_obra_mts_via()

	## Objetivo:
	##     - Suma la longitud de obra principal proyectada +
	##       longitud de obra proyectada en cepa ya hecha +
	##       longitud de tubos adicionales proyectados
	##       agrupada por tipo de obra asociadas al tramo
	##     - Para obtener la longitud de obra principal proyectada
	##       se deben considerar los tubos de la obra por separado
   	## Parámetros de salida:
	##     .ocol_long_obra_m_via - hash_table
	##       [:|Tipo de Obra|] << longitud mts
	## vbluna

	_local col_obra       << .ocol_long_obra
	_local col_obra_cepa  << .ocol_long_obra_cepa
	_local col_obra_tubos << .ocol_long_obra_tubos
	_local col_mts_via << hash_table.new()

	_local long_total
	_local long_gran_total	

	_for key_tipo_obra, num_tubos _over _self.tipos_obra_proyectadas.keys_and_elements()
	_loop
		_for key_obra,long_obra _over col_obra.keys_and_elements()
		_loop
			_if key_tipo_obra = key_obra
			_then
				long_total << col_mts_via[key_tipo_obra].default(0.0)
				col_mts_via[key_tipo_obra] << long_total + (long_obra * num_tubos)
				
				_leave
			_endif
		_endloop

		_for key_obra_cepa,long_obra_cepa _over col_obra_cepa.keys_and_elements()
		_loop
			_if key_tipo_obra = key_obra_cepa
			_then
				long_total << col_mts_via[key_tipo_obra].default(0.0)
				col_mts_via[key_tipo_obra] << long_total + (long_obra_cepa * num_tubos)
				
				_leave
			_endif
		_endloop

		_for key_obra_tubos,long_obra_tubos _over col_obra_tubos.keys_and_elements()
		_loop
			_if key_tipo_obra = key_obra_tubos
			_then
				long_total << col_mts_via[key_tipo_obra].default(0.0)
				col_mts_via[key_tipo_obra] << long_total + long_obra_tubos
				
				_leave
			_endif
		_endloop

		ln_gran_total << col_mts_via[:|Total|].default(0.0)
		col_mts_via[:|Total|] << ln_gran_total + col_mts_via[key_tipo_obra]
	_endloop

	_return .ocol_long_obra_m_via << col_mts_via

_endmethod
$
_pragma(classify_level=restricted, usage={redefinable})
_method c_tramo_can.calcular_longitud_obra_superficie()

	## Objetivo:
	##     - Suma la longitud medida de las canalizaciones asoiciadas
	##       al tramo con tipos de obra proyectadas agrupadas
	##       por tipo de obra y tipo de superficie siempre y cuando
	##       el tipo de obra sea la obra principal del tramo
   	## Parámetros de salida:
	##     .ocol_long_obra_sup - dual_key_a_table
	##       [:|Tipo de Obra|, :|Ubicacion_Superficie|] << longitud mts
	## vbluna

	_local Lcol_Long_Obra_Ubi_Sup << dual_key_a_table.new()
	_local LsTipo_Obra
	_local LsUbi_Sup
	_local LnLong_Can
	_local LnLong_Ubi_Sup

	_for oCan _over _self.canalizacion.elements()
	_loop
		#Asigna la Ubicacion y el Tipo de Superficie de la Canalizacion
		LsUbi_Sup << oCan.user!_ubicacion.write_string
		LsUbi_Sup << LsUbi_Sup + "_" +oCan.user!_tipo_superficie.write_string
		LsUbi_Sup << LsUbi_Sup.as_symbol()

		#Asigna la longitud medida de la Canalizacion
		LnLong_Can << oCan.measured_length.default(length_value(0.0, :m)).value

		#Recorre los tipos de obra "Proyectados" de la Canalizacion
		_for oCon_Bund _over oCan.calcular_obras_normalizadas_asociadas[:proyectado].elements()
		_loop
			_if oCan.obra_principal = oCon_Bund
			_then
				#Asigna el nombre del tipo de obra
				LsTipo_Obra << oCon_Bund.name.write_string.as_symbol()

				#-----------------------------------------------------
         			# LONGITUD POR TIPO DE OBRA, UBICACIÓN Y SUPERFICIE
				#-----------------------------------------------------

        			#Agrega a la colección el tipo de obra y Ubicacion + Superficie
	        		Lcol_Long_Obra_Ubi_Sup[LsTipo_Obra,LsUbi_Sup]

                                #Asigna la longitud actual que corresponde al tipo de obra y Ubi_Sup
        			LnLong_Ubi_Sup << Lcol_Long_Obra_Ubi_Sup[LsTipo_Obra,LsUbi_Sup]
	        		LnLong_Ubi_Sup << LnLong_Ubi_Sup.default(0.0)

        			#Suma la longitud medida de la Canalización + LnLong_Obra_Ubi_Sup
	        		Lcol_Long_Obra_Ubi_Sup[LsTipo_Obra,LsUbi_Sup] << LnLong_Ubi_Sup + LnLong_Can
			_endif
		_endloop
	_endloop

	_return .ocol_long_obra_sup << Lcol_Long_Obra_Ubi_Sup
	
_endmethod
$
_pragma(classify_level=restricted, usage={redefinable})
_method c_tramo_can.calcular_longitud_obra_tubos_adic()

	## Objetivo:
	##     - Suma la longitud medida de las canalizaciones
	##       asociadas al tramo con tubos adicionales proyectados
	##       siempre y cuando el tipo de obra al que se asocian los
	##       tubos (obra_principal) sea proyectada
	##     - La longitud de la canalizacion considera cada tubo por separado
   	## Parámetros de salida:
	##     .ocol_long_obra_tubos - hash_table
	##       [:|Tipo de Obra|] << longitud mts de todos los tubos
	## vbluna

	_local col_obras << hash_table.new()
	_local ln_long_can
	_local ln_long_total
	_local lo_obra_princ

	_for oCan _over _self.canalizacion.elements()
	_loop
		ln_long_can << oCan.measured_length.default(length_value(0.0, :m)).value
		lo_obra_princ << oCan.obra_principal
		
		_for oTubos _over oCan.obtener_flexos_contenidos()[:proyectado].elements()
		_loop
			_if _self.es_obra_proyectada?(lo_obra_princ) = _true
			_then
				ln_long_total << col_obras[lo_obra_princ.name.as_symbol()].default(0.0)
				col_obras[lo_obra_princ.name.as_symbol()] << ln_long_total + ln_long_can
			_endif
		_endloop
	_endloop

   _return .ocol_long_obra_tubos << col_obras
	
_endmethod
$
