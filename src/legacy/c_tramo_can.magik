_pragma(classify_level=restricted, usage={redefinable})
_method c_tramo_can.tipos_obra_proyectadas

	## Objetivo:
	##     - Obtener los nombres de los tipos de obra proyectadas y
	##       el número de conductos que contiene cada obra asociada al tramo
   	## Parámetros de salida:
	##     Lcol_Tipo_Obra - hash_table
	##        [:|Nombre Tipo Obra|] << cantidad de conductos
	## vbluna

	_local Lcol_Tipo_Obra << hash_table.new()
	_local ln_num_tubos << 0

	_for oCan _over _self.canalizacion.elements()
	_loop
		#Recorre los tipos de obra "Proyectados" de la Canalizacion
		_for oCon_Bund _over oCan.calcular_obras_normalizadas_asociadas[:proyectado].elements()
		_loop
			ln_num_tubos << oCon_Bund.mit_conduits.size

			#Agrega a la colección el tipo de obra
			Lcol_Tipo_Obra[oCon_Bund.name.write_string.as_symbol()] << ln_num_tubos
		_endloop
	_endloop

	_return Lcol_Tipo_Obra
	
_endmethod
$
_pragma(classify_level=restricted, usage={redefinable})
_method c_tramo_can.tipos_superficie_can_obra_proy

	## Objetivo:
	##     - Obtener la ubicacion y tipo de superficie asociados a la
	##       canalizacion del tramo que contiene tipos de obra proyectadas
   	## Parámetros de salida:
	##     Lcol_Tipos_Sup - dual_key_a_table
	##        [:|Ubicacion|, :|Tipo Superficie|] << ""
	## vbluna

	_local Lcol_Tipos_Sup << dual_key_a_table.new()
	_local LsUbicacion
	_local LsTipo_Sup
	
	_for oCan _over _self.canalizacion_con_obra_proyectada.elements()
	_loop
		#Asigna la Ubicacion y el Tipo de Superficie de la Canalizacion
		LsUbicacion << oCan.user!_ubicacion.write_string.as_symbol()
		LsTipo_Sup  << oCan.user!_tipo_superficie.write_string.as_symbol()

		Lcol_Tipos_Sup[LsUbicacion,LsTipo_Sup] << ""
	_endloop

	LsUbicacion << "OTROS".as_symbol()
	Lcol_Tipos_Sup[LsUbicacion,"Total".as_symbol()] << ""
	Lcol_Tipos_Sup[LsUbicacion,"Cepa_Hecha".as_symbol()] << ""
	Lcol_Tipos_Sup[LsUbicacion,"Tubos_Adic".as_symbol()] << ""
	Lcol_Tipos_Sup[LsUbicacion,"Mts_Via".as_symbol()] << ""	
	
	_return Lcol_Tipos_Sup
	
_endmethod
