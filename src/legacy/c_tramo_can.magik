_pragma(classify_level=restricted, usage={redefinable})
_method c_tramo_can.oe << RoOE

	## Objetivo:
	##     - Asigna a .oOE << RoOE
	##     - Asigna a .oOEI << user!_oei asociada a la oe
	##     - Asigna a .oOPB << user!_opb asociada a la oei
	##     - Asigna a .oRuta << user!_ruta_co asociada a la opb
   	## Parámetros de entrada:
	##     RoOE - objeto user!_oe asociada al tramo
   	## Parámetros de salida:
	## vbluna

	_try
		.oOE    << RoOE
		.oOEI   << .oOE.user!_oei
		.oOPB   << .oOEI.user!_opb
		.oRuta  << .oOPB.user!_rutas
	_when does_not_understand
		write("Error al asignar oe")
	_endtry

_endmethod
$
_pragma(classify_level=restricted, usage={redefinable})
_method c_tramo_can.oe_lo

   	## Parámetros de salida:
	##     - string con el valor de la oe asociada al tramo
	_try
		_return .oOE.user!_num_oe
	_when does_not_understand
		_return ""
	_endtry

_endmethod
