_pragma(classify_level=restricted, usage={redefinable})
_method c_tramo_can.es_obra_proyectada?(p_obra)

	## Objetivo:
	##     - Obtener si p_obra tiene estado de construccion proyectado
   	## Parámetros de entrada:
	##     .p_obra - objeto :mit_conduit_bundle (tipo de obra) a evaluar
   	## Parámetros de salida:
	##     _true - si p_obra es proyectada
	##     _false - si p_obra NO es proyectada
	## vbluna

	_for obra _over _self.obras_proyectadas.elements()
	_loop
		_if obra = p_obra
		_then
			_return _true 
		_endif
	_endloop

	_return _false
	
_endmethod
$
_pragma(classify_level=restricted, usage={redefinable})
_method c_tramo_can.genera_resumen_total_tipo_obra()

	## Objetivo:
	##     - Genera un resumen por tipo de obra con:
	##          - Longitud de obra agrupada por ubicación y superficie
	##          - Longitud de obra agrupada por obra en mts lineales
	##          - Longitud de obra en cepa ya hecha agrupada por obra
	##          - Longitud de obra por tubos adicionales
	##          - Longitud de obra total en metros ducto vía
   	## Parámetros de salida:
	##     col_resumen_obra - dual_key_a_table
	##        [:|Tipo obra|, :|Categoría|] << longitud
	## vbluna

	_self.calcular_longitud_obra_superficie()
	_self.calcular_longitud_obra()
	_self.calcular_longitud_obra_cepa_hecha()
	_self.calcular_longitud_obra_tubos_adic()
	_self.calcular_longitud_obra_mts_via()
	
	_local col_resumen_obra << dual_key_a_table.new()

	#Calcula la longitud por tipo de obra y superficie
	col_resumen_obra << .ocol_long_obra_sup

	#Agrega la longitud por tipo de obra
	_for key, long _over .ocol_long_obra.keys_and_elements()
	_loop
		col_resumen_obra[key,:|OTROS_Total|] << long
	_endloop

	#Agrega la longitud por tipo de obra con cepa ya hecha
	_for key, long _over .ocol_long_obra_cepa.keys_and_elements()
	_loop
		col_resumen_obra[key,:|OTROS_Cepa_Hecha|] << long
	_endloop

	#Agrega la longitud de tubos adicionales por tipo de obra
	_for key, long _over .ocol_long_obra_tubos.keys_and_elements()
	_loop
		col_resumen_obra[key,:|OTROS_Tubos_Adic|] << long
	_endloop

	#Agrega la longitud de metros via por tipo de obra
	_for key, long _over .ocol_long_obra_m_via.keys_and_elements()
	_loop
		col_resumen_obra[key,:|OTROS_Mts_Via|] << long
	_endloop
	
	_return col_resumen_obra
	
_endmethod
$
_pragma(classify_level=restricted, usage={redefinable})
_method c_tramo_can.init()

	.oCanalizacion        << rope.new()
	.oPozos               << rope.new()
	.ocol_long_obra_sup   << dual_key_a_table.new()
	.ocol_long_obra       << hash_table.new()
	.ocol_long_obra_cepa  << hash_table.new()
	.ocol_long_obra_tubos << hash_table.new()
	.ocol_long_obra_m_via << hash_table.new()
	
	_return _self
	
_endmethod
$
_pragma(classify_level=restricted, usage={redefinable})
_method c_tramo_can.new()

	_return _clone.init()
	
_endmethod
$
_pragma(classify_level=restricted, usage={redefinable})
_method c_tramo_can.num_cajas_dist_proy_por_tipo()

	## Objetivo:
	##     - Obtener la cantidad de cajas de distribucion proyectados 
	##       asociados al tramo agrupados por modelo de caja
   	## Parámetros de salida:
	##     Lcol_cajas_dist - hash_table
	##        [:|Modelo de caja|] << cantidad de cajas proyectadas
	## vbluna

	_local Lcol_cajas_dist << hash_table.new()
	_local LsModelo
	_local ln_num_cajas
	
	_for o_caja _over _self.cajas_dist.elements()
	_loop
		_if  o_caja.construction_status = "PROYECTADO"
		_then
			#Asigna el modelo de las cajas
			LsModelo << o_caja.spec_id.write_string.as_symbol()
			ln_num_cajas << Lcol_cajas_dist[LsModelo]
			Lcol_cajas_dist[LsModelo] << ln_num_cajas.default(0) + 1
		_endif
	_endloop

	_return Lcol_cajas_dist
	
_endmethod
$
_pragma(classify_level=restricted, usage={redefinable})
_method c_tramo_can.num_pozos_proy_por_tipo()

	## Objetivo:
	##     - Obtener la cantidad de pozos proyectados asociados
	##       al tramo agrupados por tipo de pozo
   	## Parámetros de salida:
	##     Lcol_Pozos - dual_key_a_table
	##        [:|Tipo de pozo|] << cantidad de pozos
	## vbluna

	_local Lcol_Pozos << dual_key_a_table.new()
	_local LsUbicacion
	_local LsTipo_pozo
	_local ln_num_pozos

	_for oPozo _over _self.pozos_proyectados.elements()
	_loop
		#Asigna la Ubicacion y el Tipo de Superficie de la Canalizacion
		LsUbicacion  << oPozo.user!_ubicacion.write_string.as_symbol()
		Ls_tipo_pozo << oPozo.spec_id.write_string.as_symbol()
			
		ln_num_pozos << Lcol_Pozos[LsUbicacion, Ls_tipo_pozo]
		Lcol_Pozos[LsUbicacion, Ls_tipo_pozo] << ln_num_pozos.default(0) + 1
	_endloop

	_return Lcol_Pozos
	
_endmethod
