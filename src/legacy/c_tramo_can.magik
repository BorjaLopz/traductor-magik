_pragma(classify_level=restricted, usage={redefinable})
_method c_tramo_can.pozos

   	## Parámetros de salida:
	##     .oPozos - rope con los pozos asociados al tramo
	## vbluna

	_local lcol_pozos << rope.new()

	_for key, oPoint _over .oPozos.keys_and_elements()
	_loop
		_if oPoint.source_collection.name = :uub
		_then
			lcol_pozos.add(oPoint)
		_endif
	_endloop

	.oPozos << lcol_pozos
	
	_return .oPozos
	
_endmethod
$
_pragma(classify_level=restricted, usage={redefinable})
_method c_tramo_can.pozos_proyectados

   	## Parámetros de salida:
	##     .oPozos - rope con los pozos proyectados asociados al tramo
	## vbluna

	_local lcol_pozos_proy << rope.new()
	
	_for oPozo _over _self.pozos.elements()
	_loop
		_if oPozo.construction_status = "PROYECTADO"
		_then
			lcol_pozos_proy.add(oPozo)
		_endif
	_endloop

	_return lcol_pozos_proy
	
_endmethod
