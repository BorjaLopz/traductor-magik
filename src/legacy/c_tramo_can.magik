	_return .oCanalizacion
	
_endmethod
$
_pragma(classify_level=restricted, usage={redefinable})
_method c_tramo_can.canalizacion_con_obra_proyectada

	## Objetivo:
	##     - Obtener la canalizacion que contenga tipos de obras proyectadas
	##       asociadas al tramo
   	## Parámetros de salida:
	##     col_can_obra_proy - equality_set con las canalizaciones
	## vbluna

	_local col_can_obra_proy << equality_set.new()

	_for oCan _over _self.canalizacion.elements()
	_loop
		#Recorre los tipos de obra "Proyectados" de la Canalizacion
		_for oCon_Bund _over oCan.calcular_obras_normalizadas_asociadas[:proyectado].elements()
		_loop
			col_can_obra_proy.add(oCan)
		_endloop
	_endloop

	_return col_can_obra_proy
	
_endmethod
