	## Objetivo:
	##     - Asigna a .oOE << RoOE
	##     - Asigna a .oOEI << user!_oei asociada a la oe
	##     - Asigna a .oOPB << user!_opb asociada a la oei
	##     - Asigna a .oRuta << user!_ruta_co asociada a la opb

	_try 		
		.oOE    << RoOE
		.oOEI   << .oOE.user!_oei_local
		.oOPB   << .oOEI.user!_op_local
#		.oRuta  << .oOPB.user!_rutas
	_when does_not_understand
		write("Error al asignar oe")
	_endtry

_endmethod
