_package user
#remex(:c_tramo_fo_e)

$
def_slotted_exemplar(:c_tramo_fo_e,
    {
	   {:collObjetos,     _unset }, # objetos que comprende el tramo
	   {:sNum_ruta,       _unset }, # numero de la ruta a la que pertenece el tramo
	   {:sNum_tramo,      _unset }, # numero que identifica al tramo	   
	   {:nNum_Empalmes,   _unset }, # Numero de emplames que contiene el tramo
	   {:nLong_tramo,     _unset }, # Longitud del tramo
	   {:oTramo,          _unset }, # Objeto tramo
	   {:collSecciones,   _unset }, # Secciones que componen al tramo
	   {:collEmpalmes,    _unset }, # Empalmes que compoenen al tramo
	   {:oNodo_origen,    _unset }, # Nodo donde inicia el tramo
	   {:oNodo_destino,   _unset }, # Nodo donde termina el tramo
	   {:sValor_Defecto,  "vacio"}  # valor que regresa cuando no hay proyecto
                                           # seleccionado	   	   

    }
)
$
c_tramo_fo_e.define_slot_access(:collObjetos,       :writable, :private)
c_tramo_fo_e.define_slot_access(:sNum_Ruta,         :writable, :private)
c_tramo_fo_e.define_slot_access(:sNum_Tramo,        :writable, :private)
c_tramo_fo_e.define_slot_access(:nNum_Empalmes,     :writable, :private)
c_tramo_fo_e.define_slot_access(:nLong_tramo,       :writable, :private)
c_tramo_fo_e.define_slot_access(:oTramo,            :writable, :public)
c_tramo_fo_e.define_slot_access(:collSecciones,     :writable, :private)
c_tramo_fo_e.define_slot_access(:collEmpalmes,      :writable, :private)
c_tramo_fo_e.define_slot_access(:oNodo_origen,      :writable, :private)
c_tramo_fo_e.define_slot_access(:oNodo_destino,     :writable, :private)
c_tramo_fo_e.define_slot_access(:sValor_defecto,    :writable, :private)
$

