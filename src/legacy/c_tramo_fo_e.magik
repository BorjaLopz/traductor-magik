_pragma(classify_level=restricted, usage={redefinable})
_private _method c_tramo_fo_e.prvObten_Seccion_Inicial()

## Objetivo: Obtener la seccion inicial del tramo que se esta pidiendo
## Parámetros de entrada: NA
## Parámetros de salida:  NA
## Regresa: 
## 	sheath - Seccion inicial del tramo
## Fecha de última modificación: 30/03/2005
## Autor de la modificación : dsanchez
## Descripción de la modificación: Se documento
##   12/04/05 DSB Se valido que el nodo origen exista

 _local LoOrigen     # Nodo origen
 _local LoSecInicial # Seccion inicial del tramo

   LoSecInicial << _unset 
   LoOrigen << _self.nodo_origen


   _if LoOrigen _isnt _unset 
   _then 
      # Predicado que se aplicará a la tabla sheath para saber la
      # seccion con la que inicia el tramo
      LoPred << predicate.interacts(:route, LoOrigen.location)                                       
      LoPred << LoPred.and(predicate.eq(:user!_num_ruta, _self.oTramo.user!_num_ruta))                   
      LoPred << LoPred.and(predicate.eq(:user!_num_tramo, _self.oTramo.user!_num_tramo))                 
                                                                                                      
                                                                                                      
      LoSecInicial << _self.collSecciones.select(LoPred)                                                 
                                                                                                      
      _if LoSecInicial.size <> 1                                                                         
      _then                                                                                              
	      write( "Hay problema con la sección inicial del tramo. (Tamaño <> 1)") 
         _return _unset                                                                                
      _else                                                                                              
         _return LoSecInicial.an_element()	                                                             
      _endif                                                                                             

   _else
      write("No hay nodo origen")
      _return _unset 
   _endif 
_endmethod
$

_pragma(classify_level=restricted, usage={redefinable})
_private _method c_tramo_fo_e.test()
	## 
	## 
	nodo<<paf.plugin(:map_plugin).current_map.current_selection.rwo_set().an_element()
	empalmes<<rope.new()

	sec<<_unset 
#	pins<<nodo.get_all_connected_bundle_pins()
#	_for opin _over pins.fast_elements()
#	_loop
#		write(opin)
#		_if opin.owner.user!_num_ruta="97"
#		_then
#			sec<<opin.owner
#			_leave 
#		_endif 
#	_endloop

	sec << _self.prvObten_Seccion_Inicial()
	_loop
		_if sec _isnt _unset 
		_then
			emp<<sec.getempalmes(2)
			_if emp.size>0
			_then
				empalmes.add(emp[1])
				secs<<emp[1].public_get_io_pins()
				_if secs.size=2 
				_then
					sec<<secs[2][1].sheath
					empalmes.add(sec)
				_else
					sec<<_unset
				_endif
			_else
				_leave
			_endif
			
		_else
			_leave 
		_endif
	_endloop
	>>empalmes
	
_endmethod
$


_pragma(classify_level=restricted, usage={redefinable})
_private _method c_tramo_fo_e.prvGenera_Lista_objetos()

## Objetivo: Genera la lista de los objetos que comprenden al
## tramo y la asigna a collObjetos
## Parámetros de entrada: NA
## Parámetros de salida:  NA
## Regresa: NA
## Fecha de última modificación: 30/03/2005
## Autor de la modificación : dsanchez
## Descripción de la modificación: Se documento
	

 _local LnPos_Empalme_Salida << 2
 _local LnPos_Seccion_Salida << 2
 _local LoSec  # seccion con que se trabajara
 _local LoEmp  # empalme que se esta trabajando
 _local LoLong_tramo # Longitud del tramo


   _self.collObjetos <<  rope.new()
   _self.nNum_empalmes << 0
   LnLong_tramo << 0

   LbHayLoNecesario << _self.prvVerifica_Existencia_Minima_Tramo()

   _if LbHayLoNecesario 
   _then 	
	
      # agrega el nodo con el cual inicia el tramo	
      _self.collObjetos.add(_self.nodo_origen)   	

      # Sección que sale del nodo inicial 
      LoSec << _self.prvObten_Seccion_Inicial()

      # agrega la sección inicial
      _self.collObjetos.add(LoSec)

      _loop
         _if LoSec _isnt _unset 
         _then
             # recupera el empalme de salida de la seccion     
             LoEmp << LoSec.getEmpalmes(LnPos_Empalme_Salida)
         
	          _if LoEmp.size > 0 
	          _then
	             _self.collObjetos.add(LoEmp[1])
	             _self.nNum_Empalmes << _self.nNum_Empalmes + 1

	             # Secciones que entran o salen del empalme
	             LoSecciones << LoEmp[1].public_get_io_pins()
	    
                _if LoSecciones.size = 2 
	             _then
	                # Seccion que sale del empalme	    
 	                LoSec << LoSecciones[ LnPos_Seccion_Salida][1].sheath

		             LnLong_Tramo << LnLong_Tramo + LoSec.calculated_fiber_length.as_float
	       
	                _self.collObjetos.add(LoSec)
	             _else
	                LoSec << _unset
	             _endif
	          _else
	             _leave
             _endif
         _else
            _leave 
         _endif
      _endloop
	
      # agrega el nodo con el cual inicia el tramo	
      _self.collObjetos.add(_self.nodo_destino)
      _self.nLong_Tramo << LnLong_Tramo
      
   _endif 

_endmethod
$

_pragma(classify_level=restricted, usage={redefinable})
_private _method c_tramo_fo_e.prvVerifica_Existencia_Minima_Tramo()

## Objetivo: verificar que el tramo con el cual se esta trabajando tenga los 
##           elementos (objetos) minimos necesarios
## Parámetros de entrada: NA
## Parámetros de salida:  NA
## Regresa: 
##     booleano - true : Cuenta al menos con:
##                         Nodo Origen
##                         Nodo Destino
##                         Una seccion
##              - falso: Falta algun elemento que se condsidera como escencial
##                       ver la parte verdad 
## Fecha de última modificación: 12/04/2005
## Autor de la modificación : dsanchez
## Descripción de la modificación: Se creo

   LoSecInicial <<  _self.prvObten_Seccion_Inicial()

   _if  _self.nodo_origen  _isnt _unset  _and  
        _self.nodo_destino _isnt _unset  _and 
        LoSecInicial _isnt _unset 
   _then 
      _return _true
   _else    
      _return _false 
   _endif         

_endmethod
$

_pragma(classify_level=restricted, usage={redefinable})
_method c_tramo_fo_e.obten_elementos_tramo

## Objetivo: Obtener la coleccion de objetos que comprende el tramo
## Parámetros de entrada: NA
## Parámetros de salida:  NA
## Regresa: 
## 	coleccion - collObjetos
## Fecha de última modificación: 30/03/2005
## Autor de la modificación : dsanchez
## Descripción de la modificación: Se documento


   LbTodoBien << _self.prvValida_Tramo()	

   _if LbTodoBien  
   _then
      _if _self.collObjetos _is _unset  
      _then
         _self.prvGenera_Lista_objetos()		   
      _endif
      _return _self.collObjetos
      
   _else
      _return _self.sValor_Defecto
      
   _endif

_endmethod
$


