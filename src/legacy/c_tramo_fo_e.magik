_pragma(classify_level=restricted, usage={redefinable})
_method c_tramo_fo_e.new()

## Objetivo: regresar la coleccion de los objetos que comprende
## el tramo
## Parámetros de entrada:
## 	Entero - RnRen : Numero de renglones que tendra celdas 
## 	Entero - RnCol : Numero de columna que tendra celdas
## Parámetros de salida:   NA
## Regresa: 
## 	c_celdas - Un objeto celdas
## Fecha de última modificación: 28/10/2004
## Autor de la modificación : dsanchez
## Descripción de la modificación: Se documento	
	
   # Crea la coleccion que almacenara los objetos que comprende el tramo 
   _self.collObjetos <<  _unset

   _self.nNum_Empalmes << _unset
   _self.oTramo        << _unset
   _self.oNodo_origen  << _unset
   _self.oNodo_destino << _unset
   _self.nLong_Tramo   << _unset 
   
   _return _clone 
_endmethod
$

_pragma(classify_level=restricted, usage={redefinable})
_method c_tramo_fo_e.asigna_num_tramo(PsCve_Ruta, PsCve_tramo)

## Objetivo: Asignar la informacion necesaria para identificar
## un tramo
## Parámetros de entrada:
##   Cadena - PsCve_Ruta :  Identificador de la ruta a la que
##              pertenece el tramo
##   Cadena - PsCve_Tramo : Identificador del tramo al cual
##              se desea acceder
## Parámetros de salida:   NA
## Regresa: NA
## Fecha de última modificación: 29/03/2005
## Autor de la modificación : dsanchez
## Descripción de la modificación: Se documento
## 11/04/05 DSB Se deshabilito la exceptcion y se puso un write
## que indica que la ruta y tramo no se localizo
	

 _local LoPAF
 _local LoPred

   _self.sNum_ruta  << PsCve_Ruta.write_string
   _self.sNum_tramo << PsCve_Tramo.write_string

   LoPAF << smallWorld_product.pni_application()

   #- - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - 
   # Prepara todo lo relacionado para obtener los datos de TRAMO
   #- - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -     
   
   # recupera los objetos Tramos
   LoTabBD_Tramo   << LoPAF.database.collection(:gis, :user!_tramo)        

   # Prepara el predicado para obtener el Tramo correspondiente
   LoPredi_tramo << predicate.eq(:user!_num_ruta, PsCve_Ruta.write_string)
   LoPredi_tramo << LoPredi_tramo.and(predicate.eq(:user!_num_tramo, PsCve_Tramo.write_string))

   # Aplica el predicado para obtener el objeto tramo
   _self.oTramo   << LoTabBD_Tramo.select(LoPredi_tramo).an_element()	

   _if _self.oTramo _isnt _unset 
   _then

      #- - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - 
      # Prepara todo lo relacionado para obtenr los datos de SECCIONES
      #- - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -        
   
      # recupera los objetos secciones
      LoTabBD_Seccion << LoPAF.database.collection(:gis, :sheath)
   
      # prepara el predicado para tomas las secciones que son del tramo
      LoPred << predicate.eq(:user!_num_tramo, _self.oTramo.user!_num_tramo)
   
      # Aplica el predicado para obtener las secciones 
      _self.collSecciones << LoTabBD_Seccion.select(LoPred)
      
      _self.prvObten_BD_Datos_Nodos(LoPAF)

      _self.prvGenera_Lista_objetos()
      
   _else
      write ("No se encontró el tramo (Ruta : " +
         PsCve_Ruta.write_string + " tramo: " + PsCve_Tramo.write_string + ").")	   
#      condition.raise(:warning, :string, "No se encontró el tramo (Ruta : " +
#         PsCve_Ruta.write_string + " tramo " + PsCve_Tramo.write_string + ").")
   _endif
    
_endmethod
$

_pragma(classify_level=restricted, usage={redefinable})
_private _method c_tramo_fo_e.prvObten_BD_Datos_Nodos(RoPAF)

## Objetivo: Obtener los datos del tramo de la Base de datos y
## asignarlo al oTramo
## Parámetros de entrada: NA
## Parámetros de salida:  NA
## Regresa: NA
## Fecha de última modificación: 29/03/2005
## Autor de la modificación : dsanchez
## Descripción de la modificación: Se documento	

 _local LoTabBD # almacena todos los objetos de la tabla a la que se desea acceder
 _local LoPredicado # predicado para filtrar los objetos que se desean seleccionar
	
   # recupera los objetos Nodos
   LoTabBD   << RoPAF.database.collection(:gis, :building)        

   #- - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - 
   # Prepara para obtener NODO ORIGEN
   #- - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -     

   LsValor <<  _self.oTramo.user!_clli_nodo_origen
   
   # Prepara el predicado para obtener el Nodo Origen
   LoPredicado << predicate.eq(:user!_clli_nodo,LsValor)

   # Aplica el predicado para obtener el objeto tramo
    _self.oNodo_Origen   << LoTabBD.select(LoPredicado).an_element()	
	
   #- - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - 
   # Prepara para obtener NODO DESTINO
   #- - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -     

   LsValor <<  _self.oTramo.user!_clli_nodo_destino
    
   # Prepara el predicado para obtener el Nodo Origen
   LoPredicado << predicate.eq(:user!_clli_nodo, LsValor)

   # Aplica el predicado para obtener el objeto tramo
    _self.oNodo_Destino   << LoTabBD.select(LoPredicado).an_element()
    
_endmethod
$

