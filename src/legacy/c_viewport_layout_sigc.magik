_pragma(classify_level=restricted)
_method c_viewport_layout_sigc.geometry_set_for_render
	## 
	## Returns the geometry set which is used in the rendering
	## code. Based the the visibility attribute the geometry set
	## needs to get its own TableControl from either the Ace, the
	## CurrentObjectControl or it has one already.
	##
	
	_dynamic !current_coordinate_system!
	!current_coordinate_system! << _self.coordinate_system
	
        _if _self.fijar_configuracion _isnt _unset  _andif
	    _self.fijar_configuracion = "Si"  _andif
	    .ogeomset _isnt _unset 
	_then
		_return .ogeomset
	_endif   

	_if _not _self.mapped?
	_then
		_return
	_endif
	
	_if ( my_world << _self.world ) _is _unset _orif
	    ( a_factory << _self.gs_factory ) _is _unset 
	_then
		_return
	_endif 
	
	
	display_style_name    << _self.display_style
	style_system_category << _self.style_system_category
	
	geom_sets << a_factory.get_geometry_set_for ( _self.ace_name,
						      my_world,
						      display_style_name,
						      :visible, 
						      style_system_category )
	
	# When there is a MapView for the World we are rendering
	_if ( my_layout << _self.layout ) _isnt _unset _andif
	    ( a_map_manager << my_layout.map_manager ) _isnt _unset 
	_then
		_if ( a_map << a_map_manager.get_map_for ( _self.ace_name, my_world ) ) _isnt _unset
		_then
			# Get the Trail (if there is any)
			_if _self.trail _is _true _andif
			    ( a_trail << a_map.trail ) _isnt _unset _andif
			    a_trail.empty? _is _false
			_then
				a_geom << a_trail.as_pseudo_geometry
				a_geom.world << my_world
				a_geom_set << geometry_set.new_with ( a_geom )
				geom_sets << geom_sets.append ( a_geom_set )
			_endif 

			# Get the current selection (if there is any)
			_if _self.selection _is _true _andif 
			    ( a_selection << a_map.current_selection ) _isnt _unset _andif
			    a_selection.size > 0
			_then
				# When there is no style system on it, create one.
				_if a_selection.style_system _is _unset 
				_then
					new_sts << transient_style_system.new_from ( geom_sets.style_system )
					new_sts.style_type << :highlight
					a_selection.style_system << new_sts
				_endif
				geom_sets << geom_sets.append ( a_selection )
			_endif
		_endif

		# And see if there are any other plugins, which supply some data
		_if _self.post_render _is _true _andif
		    ( some_sets << a_map_manager.request_post_render_geometry_sets(my_world) ) _isnt _unset
		_then
			_for geom_set _over some_sets.fast_elements ()
			_loop
				geom_sets << geom_sets.append ( geom_set )
			_endloop 
		_endif
	_endif

	# Now make sure that if geom_sets is a composite_geometry_set
	# that we remove the style_system from it.
	_if geom_sets.is_kind_of? ( composite_geometry_set )
	_then
		geom_sets.style_system << _unset 
	_endif
	
	result_set << geom_sets.select ( :bounds_interacting_with, _self.rotated_world_bounds.bounds )

	_if _self.sTipoPlano = "CONSTRUCCION"
	_then
		result_set << _self.plano_construccion(result_set)	

	_elif _self.sTipoPlano = "CONSTRUCCION_FO"
	_then
		result_set_res << result_set
		
		result_set << _self.plano_construccion_fo(result_set)
		
                _if  _self.ace_name = "001 - P Construccion FTTH reub"
		_then
			LoEst << result_set.sys!slot(:sets).an_element().style_system
			(estos,estos2)<<_self.agregar_elementos(result_set_res)
			estos.style_system << LoEst
			estos2.style_system<<LoEst
			result_set << composite_geometry_set.new_with (estos,estos2,result_set)	
		_endif

	_elif _self.sTipoPlano = "BAJANTES"
	_then
		result_set << _self.plano_de_bajantes(result_set)
	_elif _self.sTipoPlano = "DISTRITOS"
	_then
		result_set << _self.plano_distritos(result_set)

	_elif _self.sTipoPlano = "ASHURADO"
	_then
		result_set << _self.plano_distritos(result_set)
	_elif _self.sTipoPlano = "CANALIZACION"
	_then
		result_set << _self.plano_canalizacion(result_set)
	_elif _self.sTipoPlano = "ITINERARIO"
	_then
		result_set << _self.plano_itinerario(result_set)

	_elif _self.sTipoPlano = "PLANO_DE_RUTA"
	_then
		result_set << _self.plano_ruta_de_cables(result_set)

	_elif _self.sTipoPlano = "Plano_desmontaje_CD"
	_then
		result_set << _self.plano_desmontaje_CD(result_set)		
		
	_elif _self.ace_name = "CENTRALES"
	_then
		result_set << _self.plano_generico(result_set)
	_elif _self.ace_name = "ESTUDIO_CONJUNTO"
	_then
		# Modificacion Elena Sainero
		result_set << _self.plano_estudio_conjunto(result_set)
	_elif _self.ace_name = "Physical NI User"
	_then
		result_set << _self.plano_fosa_cables(result_set)
	_endif

	# creamos estructura de guardar visualizacion de los elementos del plano
	_if _self.elementos_modificados _is _unset 
	_then	   
	    LoGuarda << c_guarda_objetos_vp.new()
	    LoGuarda.oResulSet << result_set
	    elementos << LoGuarda.genera_lista_gsfr() 
	    
	    _for ky,ele _over elementos.keys_and_elements()
	    _loop
		_self.guardar_visualizacion(ele,  ky)		
	    _endloop
	_endif
	
	.ogeomset << result_set 
	
	>> result_set 
_endmethod
$
_pragma(classify_level=restricted)
_method c_viewport_layout_sigc.agregar_elementos(result_set_res)
	#---------------------------------------------------
	##  Objetivo  : <Description>
	##
	paf << smallworld_product.pni_application()
	mv << paf.plugin(:map_plugin).current_map_view
	v << mit_manager.modelit_dataset
	mstructs<< equality_set.new()
	mgeoms<< equality_geometry_set.new()
	LoInteraccion << equality_geometry_set.new()
	lista<< swg_dsn_admin_engine.active_design.dsm_created_objects(_unset )
        lista2<< swg_dsn_admin_engine.active_design.dsm_modified_objects(_unset )
	lista.add_all(lista2)

	_for geo _over lista.fast_elements()
	_loop
		_if geo.is_kind_of?(sheath)
		_then
			mst<< geo.structures

			_for st  _over mst.fast_elements()
			_loop
				geoms <<st.get_mit_geometry_set_for_world(v.world)
				mgeoms.add_all(geoms)
			_endloop				
		_endif
	_endloop

	_if mgeoms.size>0
	_then
		mbuffer<<mgeoms.buffer(2500)	
		LoInteraccion << result_set_res.select(:interacting_with, mbuffer)
	_endif


	_return mgeoms,LoInteraccion 
			
_endmethod
$
_pragma(classify_level=restricted)
_method c_viewport_layout_sigc.busca_perfiles_canalizacion(PoResultlineas, PoResultSet)
	## (06/11/08 jtlelo) 
	## Busca los perfiles de canalización a partir de la lineas que
	## interactuan con el area de trabajo, se verifica una por una
	## cada linea y si esta interactua con un perfil de
	## canalización lo se seleccionamos de LoResultSet y creamos
	## LoPerfilesSet.
	##
	LoResultlineas << PoResultlineas
	LoResultSet << PoResultSet
	LoPerfilesSet << _unset 
	_for linea _over LoResultlineas.rwo_set().fast_elements()
	_loop	
		LoPred << predicate.interacts(:boundary, {linea.line_4})
		PerfilSelecc << LoResultSet.select(:predicate,{:mit_presentation_object, LoPred})
		_if LoPerfilesSet _is _unset 
		_then
			LoPerfilesSet << composite_geometry_set.new_with(PerfilSelecc)
		_else
			LoPerfilesSet << composite_geometry_set.new_with(LoPerfilesSet, PerfilSelecc)
		_endif	
		
	_endloop

	>> LoPerfilesSet
	
_endmethod
$
_pragma(classify_level=restricted)
_method c_viewport_layout_sigc.perfiles_canalizacion(PoResultlineas, PoResultSet)
	## (06/11/08 jtlelo) 
	## Busca los perfiles de canalización a partir de la lineas que
	## interactuan con el area de trabajo, se verifica una por una
	## cada linea y si esta interactua con un perfil de
	## canalización lo se seleccionamos de LoResultSet y creamos
	## LoPerfilesSet.
	##
	LoResultlineas << PoResultlineas
	LoResultSet << PoResultSet
	LoPerfilesSet << equality_geometry_set.new()

	LoEst << PoResultset.sys!slot(:sets).an_element().style_system
	
	_for canal _over LoResultlineas.rwo_set().fast_elements()
	_loop
		_if (perfil <<  canal.mit_structure.mit_presentation_objects.an_element()) _isnt _unset 
		_then
			LoPerfilesSet.add(perfil.boundary)
			LoPerfilesSet.add(perfil.tierra)	
		_endif
		
		
	_endloop

	LoPerfilesSet.style_system<<LoEst
	
	>> LoPerfilesSet

	
_endmethod
$


_pragma(classify_level=restricted)
_method c_viewport_layout_sigc.crea_anotacion(LoLinea2,Lotexto,color)
	##metodo muevo rraragon 11/10/06 metodo que genera la anotacion
	## para las centrales adyacentes en el plano ashurado 
	##
	## fhramire, para el caso de Plano de Construccion de FO (Falc)
	## los distritos opticos colindantes, puede no tener nombre de
	## distrito, entonces se les pasa cadena vacia.
	_if Lotexto _is _unset 
	_then
	    Lotexto << ""
	_endif

	loban << _false
	lcuenta <<0
	xmin << LoLinea2.last_coord.x-500
	ymin << LoLinea2.last_coord.y-250
	xmax << LoLinea2.last_coord.x+500
	ymax << LoLinea2.last_coord.y+250
	nom << textbox_layout.new_with(:bounds, bounding_box.new(xmin,ymin,xmax,ymax),
			               :text,  Lotexto,
			               :font_size, 12,
				       :font_name, "Arial",
				       :colour,colour.called(color),
				       :outline_style, _unset ,
			               :set_fill_colour, _unset,
			               :fill_style,_unset,
				       :align_horizontal,:centre,
				       :align_vertical,:centre,
				       :orientation,:left_right)
	
	_for e _over _self.layout_page.elements.fast_elements()
	 _loop
		_if e.is_kind_of?(textbox_layout)
		_then
			_if e.text=Lotexto _andif e.colour = colour.called(color)
			_then
				lcuenta + << 1
				loban << _true 
			_elif e.text=Lotexto _andif e.colour <> colour.called(color)
			_then
				_self.layout_page.elements.remove(e)
				loban << _false 
			_endif  
		_endif
	 _endloop

	 _if _not loban _orif lcuenta=0
	 _then
		 _self.layout_page.add_element(nom)
		 _self.layout_page.render_element(.owindows, nom)
	 _endif
	
_endmethod
$
_pragma(classify_level=restricted)
_method c_viewport_layout_sigc.crea_circulo_ubicacion(Punto, windows)
	## 
	##

	_dynamic !current_coordinate_system!
	!current_coordinate_system! << _unset	

	est_line1 << line_style.new_with_properties(
			     :foreground_colour, colour.called(:blue), :width, 1)

	LCoord << Punto.transformed(_self.transform)

	LCo1 << coordinate.new(LCoord.x, LCoord.y)
	LoCirculo << circle.new(LCo1, 300)
	LoCirculo.draw_on(windows,est_line1)

	
_endmethod
