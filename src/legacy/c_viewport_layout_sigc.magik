_pragma(classify_level=advanced)
_method c_viewport_layout_sigc.filtra_rutas(rutas, coleccion, resultado, buffer, _optional siempre)
	## Este método regresa los registros de colección que están
	## indicadoss en rutas y tienen cables de cobre principales
	## proyectados; los guarda en resultado y regresa un buffer
	## 
	# (06/11/07 jtlelo) : Asignamos el tamaño de buffer
	LoBufferAncho << 4000
	
	_for i _over rutas.fast_elements()
	_loop
		seleccion << _unset
		_if i.rwo_type _isnt :underground_route _and i.rwo_type _isnt :aerial_route
		_then
			_continue
		_endif
		_for cable _over i.cables().fast_elements()
		_loop
			_if (cable.rwo_type _is :copper_cable _andif
			     cable.user!_tipo_red.write_string = "PRINCIPAL") _orif # _andif
			    # cable.construction_status = "PROYECTADO") _orif
			    siempre = _true# _andif
			    #cable.user!_ruta_co _isnt _unset _andif
			    #cable.user!_ruta_co.user!_numero = Glorutaopb.user!_numero
			_then
				# LoColeccion: puede valer :aerial_route ó :underground_route
				LoColeccion << i.source_collection.name
				seleccion << coleccion.select(:predicate, {LoColeccion,
									   predicate.eq(:id, i.id)})
				_leave
			_endif
		_endloop
		_if seleccion _isnt _unset 
		_then
			_if  resultado _is _unset
			_then
				buffer << i.route.buffer(LoBufferAncho)
				resultado << seleccion
			_else
				buffer << buffer.union(i.route.buffer(LoBufferAncho))
				resultado << resultado.append(seleccion)
			_endif
		_endif 		
	_endloop
	>> (resultado, buffer)
_endmethod
$

_pragma(classify_level=restricted, usage={redefinable})
_method c_viewport_layout_sigc.guardar_visualizacion(elementos, llave)
	## fhramire 
	## Funcionalidad para mover simbolos en el plano
	_if _self.elementos_modificados _is _unset 
	_then
	    ## elementos en este caso es ya un property_list
	    datos << property_list.new()
	    datos[llave] << elementos
	    _self.elementos_modificados << datos

	_else
	    ## elementos en este caso es un rope con los datos.
	    ## y solo lo agregamos, con la llave = "llave" 
	    _self.elementos_modificados[llave] << elementos
	_endif
	
	
_endmethod
$
_method c_viewport_layout_sigc.obten_pto_intersect(PoCoordP1,PoCoordP2,PoCoordP3)
## Objetivo: Obtener el punto que de interseccion de las rectas
## L1 y L2. La recta L1 pasa por los punto P1, P2 y la recta L2
## pasa por los puntos P3 y la interseccion con la recta L1.
## Parametros de Entrada:
##   PoCoordP1: Coordenada del pto P1.
##   PoCoordP2: Coordenada del pto P2.
##   PnCoordP3: Coordenada del pto P3.
## Parametros de Salida: Ninguno
## Regresa:
##   LoCoord:  Coordenada de interseccion de las rectas L1 y L2.
## Fecha de ultima modificacion: 16/Nov./2004.
## Autor de la modificacion: rbsaldan.
## Descripcion de la modificacion: Metodo nuevo.

LfM       ## Pendiente de la recta que pasa por los puntos P1, P2.
LfM_inv   ## LfM_inv=1/LfM.
LfX       ## Coordenada x de la recta que pasa por los puntos P3 y la interseccion.
LfY       ## Coordenada y de la recta que pasa por los puntos P3 y la interseccion.
LoCoord   ## Coordenada donde se intersectan L1 y L2.

        LfM<<(PoCoordP2.y-PoCoordP1.y)/(PoCoordP2.x-PoCoordP1.x)
	_if LfM<>0
	_then
		LfM_inv<<LfM.inverse
		
		LfX<<(LfM*(LfM*PoCoordP1.x+LfM_inv*PoCoordP3.x-PoCoordP1.y+PoCoordP3.y))/(LfM.to_power(2)+1)
		LfY<<LfM_inv*(PoCoordP3.x-LfX)+PoCoordP3.y
		
		LoCoord<<coordinate(LfX,LfY)
	_else
		LoCoord<<coordinate(PoCoordP3.x,PoCoordP1.y)
	_endif

	>>LoCoord
_endmethod
$
_pragma(classify_level=restricted)
_method c_viewport_layout_sigc.obten_pto_separado(PoCoordP1,PoCoordP2,PfMagnitud,PfAlpha)
## Objetivo: Obtiene un punto al redededor del punto PoCoordP2
##           a una distancia PfMagnitud a un angulo PfAlpha.
## Parametros de Entrada:
##   PoCoordP1:  Coordenada del pto P1 de la Recta L1.
##   PoCoordP2:  Coordenada del pto P2 de la recta L2.
##   PfMagnitud: Magnitud del vector con punto origen PoCoordP1
##               y magnitud PfMagnitud y angulo PfAlpha.
##   PfAlpha:   Angulo (sexagesimal )que se le agrega al angulo de la recta L1.
## Parametros de Salida: Ninguno.
## Regresa:
##   LoCoord:  Coordenada.
## Fecha de ultima modificacion: 16/Nov./2004.
## Autor de la modificacion: rbsaldan.
## Descripcion de la modificacion: Metodo nuevo.

_local LfTheta  ## Angulo de la recta que pasa por los puntos P1,P2.
_local LfX      ## Coordenada X.
_local LfY      ## Coordenada Y.
      PfAlpha<<PfAlpha.degrees_to_radians
      _if PoCoordP2.x>=PoCoordP1.x
      _then
	      LfTheta<<atan((PoCoordP2.y-PoCoordP1.y)/(PoCoordP2.x-PoCoordP1.x))
      _else
	      LfTheta<<atan((PoCoordP2.y-PoCoordP1.y)/(PoCoordP2.x-PoCoordP1.x))+180.degrees_to_radians
      _endif
      
      LfX<<PoCoordP1.x+PfMagnitud*(LfTheta+PfAlpha).cos
      LfY<<PoCoordP1.y+PfMagnitud*(LfTheta+PfAlpha).sin

      >>coordinate(LfX,LfY)
_endmethod
$
_pragma(classify_level=restricted)
_method c_viewport_layout_sigc.plano_canalizacion(PoResultSet)
	## 
	##

	_local LoAppPNI                # Referencia a la Aplicacion PNI.
	_local LoEditorManager         # Referencia al plugin editor_manager.
	_local LyNombreTablaPrincipal  # Nombre interno de la tabla user!_central.
	_local LoObjetoEnEditor        # Objeto que se encuentra en el editor (debe ser una central).
	_local LoAreaGeometrica        # Area de la central seleccionada.
	_local LyCampoGeometrico       # Campo geometrico de la central seleccionada.
	_local LoResultSet            # Conjunto de geometrias que debeb ser dibujadas en Layout Designer.

	LoAppPNI << smallworld_product.pni_application()
	_if LoAppPNI _is _unset
	_then
		#
		# (06/10/27 jtlelo) : 
		# Para un usuario de la interfaz no gráfica
		# no habra una pni_application().
		# En este caso se utiliza la aplicación
		# de dicha interfaz no gráfica.
		#
		LoAppPNI << smallworld_product.application ( :c_admin_proyectos_sin_grafico )
	_endif 
	LoEditorManager << LoAppPNI.plugin(:editor_manager)	
	LyNombreTablaPrincipal << :user!_central
	LyCampoGeometrico << :user!_limite

	LoResultSet << PoResultSet
	LoObjetoEnEditor << _unset

	# Si hay un objeto en la tabla LyNombreTablaPrincipal y su
	# campo geometrico no es nulo, hacer un filtro de objetos.
	LoObjetoEnEditor << swg_dsn_admin_engine.active_scheme.project.user!_central
	_if LoObjetoEnEditor _isnt _unset _andif
	    (LoAreaGeometrica << LoObjetoEnEditor.perform(LyCampoGeometrico)) _isnt _unset
	_then
	        # Obtener Manzanas colindantes con la canalización
		_local 	TmpResultSet  # Se guardan el conjunto de geometrias.	
		TmpResultSet << LoResultSet

		# Se obtienen las canalizaciones que interactuan con el area de
		# limite de central
		LoPredExistente << predicate.eq(:construction_status, "EXISTENTE")
		LoPred1 << predicate.like(:user!_central, LoObjetoEnEditor.user!_central.slice(1, 3)+%%)
		LoPred6 << predicate.interacts(:route, {LoAreaGeometrica}) _and LoPredExistente

		LoResultSet << LoResultSet.select(:predicate, {:underground_route, LoPred6})
		################################################################################
		# Se esta modificando para hacer mas rapida la busqueda de las
		# manzanas colindantes
		# 
		#a << lbv.collections[:user!_manzana].descriptor.all_fields[:user!_limite]
		#geom_list << simple_vector.new_with(a)
		##scanner << lbv.scanner_for({:sw_gis!area})#,LoAppPNI.plugin(:map_plugin).current_map.world})
		#scanner << lbv.geometry_scanner(:area)
		#geom_list << simple_vector.new_with(a)
		#tc << lbv.table_control_for(geom_list)
		#_global a_geom_set
		#a_geom_set << equality_geometry_set.new()
		#
		#
		###############################################################################

		# Crear un buffer a 40mts. con las canalizaciones encontradas.
		LoBuffer<<_unset
		_for LoRec _over LoResultSet.rwo_set().fast_elements()
		_loop
			###############################################
			#bd << LoRec.bounds #.new(LoRec.bounds.xmin+10,LoRec.bounds.xmax+10,
			#scanner.start_scan(bd,tc)
			#_loop
			#	geom << scanner.get()
			#	_if geom _is _unset _then _leave _endif
			#	a_geom_set.add( geom)
			#_endloop
			#
			#################################################
			_if LoBuffer _is _unset
			_then
				LoBuffer << LoRec.route.buffer(4000)
			_else
				LoBuffer << LoBuffer.union(LoRec.route.buffer(4000))
			_endif
		_endloop
		_if LoBuffer _is _unset 
		_then
			LoBuffer << LoAreaGeometrica.buffer(10)
		_endif
		
		LoBuffer.world << LoAppPNI.plugin(:map_plugin).current_map.world



		LoResultSet << TmpResultSet
		# (06/10/12 jtlelo) : pozos
		LoPred8 << predicate.within(:location, {LoBuffer}) _and LoPredExistente
		# Selecciona todas las manzanas que estan dentro del buffer.
		LoPred3 <<(predicate.interacts(:user!_limite,  {LoBuffer}))
		# Selecciona todos los ejes de calle que estan dentro del area
		# del buffer.
		LoPred4 << predicate.overlays(:user!_posicion, {LoBuffer})
		# Selecciona el building (edificio de la central) dentro del
		# buffer.
		LoPred5 << predicate.interacts(:location, {LoBuffer})_and LoPredExistente


		# Selecionamos todos los posibles drafting que existan se
		# pueden utilizar como señalamientos del perfil de canalización
		LoPred9 << predicate.interacts(:line_4, {LoBuffer})

	        # (06/11/08 jtlelo) : seleccionamos los perfiles de
		# canalizacion que existen en el buffer, a partir de las lineas
		LoResultlineas << LoResultSet.select(:predicate, {:drafting_lines, LoPred9})

		# (06/11/08 jtlelo) : Creamos un geometry set para asegurarnos
		# que se una con las demas busquedas resultantes
		LoResultPerfiles << geometry_set.new() 
		_if LoResultlineas _isnt _unset _andif
		    LoResultlineas.size > 0
		_then
			LoResultPerfiles << _self.busca_perfiles_canalizacion(LoResultlineas, LoResultSet)
		_endif

		# (06/03/04 jtlelo) :  seleccionamos las manzanas utilizando
		# un tipo distinto de interaccion. El motivo es acelerar el
		# proceso, ya que en la valoracion de manzanas el proceso
		# se prolongaba mucho en el tiempo. 
		#Mset<<LoResultSet.select ( :collection, { :user!_manzana } )
		#Mset.select(LoPred3)
		#Mset << Mset.select_bounds_interacting_with(LoBuffer)
		#Mset<<Mset.select ( :interacts, LoBuffer ) #_and Mset.select(:within, LoAreaGeometrica)
		LoResultSet<<LoResultSet.select(:predicate, {:user!_manzana, LoPred3,
							    :user!_eje_calle, LoPred4,
							    :building, LoPred5,
							    :mit_terminal_enclosure, LoPred5,
						            :underground_route, LoPred6,
							    :uub, LoPred8,
							    :drafting_lines, LoPred9})

		# (06/11/08 jtlelo) : unimos las dos busquedas
		# LoResultPerfiles (Perfiles de canalización que interactuan
		#                   con el buffer)
		# LoResultSet (Elementos que interactuan con la central)
		LoResultSet << composite_geometry_set.new_with (  LoResultPerfiles, LoResultSet )
		
	_endif
	>>LoResultSet

	
_endmethod
$
_pragma(classify_level=restricted)
_method c_viewport_layout_sigc.plano_construccion(PoResultSet)
	# Objetivo: Seleccionar todos los objetos visibles que se encuntran dentro de un Distrito.
	# Parametros de Entrada:          PoResultSet: Seleccion de objetos en la vista.
	# Parametros de Salida:           Ninguno.
	# Regresa:                        LoResultSet: Seleccion de objetos de interes.
	
	_local LoAppPNI                # Referencia a la Aplicacion PNI.
	_local LoEditorManager         # Referencia al plugin editor_manager.
	_local LyNombreTablaPrincipal  # Nombre interno de la tabla user!_central.
	_local LoObjetoEnEditor        # Objeto que se encuentra en el editor (debe ser un distrito
	_local LoAreaGeometrica        # Area del distrito seleccionada.
	_local LoResultSet             # conjunto de geometrias que deben ser dibujadas.
	_local LoResultSetTemp
	
	LoAppPNI<<smallworld_product.pni_application()
	
	_if LoAppPNI _is _unset
	_then
		LoAppPNI << smallworld_product.application (:c_admin_proyectos_sin_grafico )
	_endif
	
	LoEditorManager << LoAppPNI.plugin(:editor_manager)
	LyNombreTablaPrincipal << :user!_distrito
	LyCampoGeometrico << :user!_limite	
	LoResultSet << PoResultSet
	LoObjetoEnEditor << _unset
	
	_if _self.elementos_bd_lb _isnt _unset _andif
	    _self.elementos_bd_lb.size > 0 _andif 
	    _self.obtener_elementos_bd_gis().size > 0
	_then
		LoObjetoEnEditor << _self.obtener_elementos_bd_landbase().an_element()
	_else
		LoObjetoEnEditor << swg_dsn_admin_engine.active_design.user!_distrito
	_endif
	
	
	# Si hay un objeto en la tabla LyNombreTablaPrincipal hacer un
	# filtro de objetos.
	_if LoObjetoEnEditor _isnt _unset _andif
	    (LoAreaGeometrica << LoObjetoEnEditor.perform(LyCampoGeometrico)) _isnt _unset
	_then
		
		# Seleccionar todos los objetos visibles
		# que se encuentren dentro del distrito.
		LoResultSetTemp << LoResultSet.select(:overlaying, LoAreaGeometrica)
		
	     # Se Elimina los elementos no requeridos para el plano de construcción
		LoResultSetTemp << LoResultSetTemp.exclude(:collection, {  :user!_bajantes,
									   :user!_bajante,
									   :curva_nivel,
									   :user!_municipio,    
									   :user!_central,        
									   :user!_estado,         
									   :user!_poblacion,      
									   :user!_colonia,        
									   :user!_localidad,      
									   :user!_ashurado,       
									   :swg_dsn_project_area })

	     # Filtracion de la canalización en estado existente
		LoPredExistente << predicate.eq(:construction_status, "EXISTENTE")
	     # Selecciona el area del distrito.
		LoPred1 << predicate.like(:user!_distrito, LoObjetoEnEditor.user!_distrito)
		# Selecciona las manzanas que estan dentro del distrito
		LoPred2 << predicate.within(:user!_limite, {LoAreaGeometrica})
             # Selecciona la canalización
		LoPred3 << predicate.overlays(:route, {LoAreaGeometrica}) _and LoPredExistente
           
     	     # Selecciona distritos adyacentes.
		LoPred11 << predicate.touches(:user!_limite, {LoAreaGeometrica})
		# Selecionamos el draftin unico de los pefiles de canalizacion line_4
		LoPred9 << predicate.interacts(:line_4, {LoAreaGeometrica})
		
		LoResultSet << LoResultSet.select(:predicate, {:user!_distrito,    LoPred1,
							       :user!_manzana,     LoPred2,
							       :underground_route, LoPred3,
							       :drafting_lines,    LoPred9})
		
		# (2006/04/20 jtlelo) : unimos el resultado de ambas busquedas
		LoResultSet << composite_geometry_set.new_with ( LoResultSet,
								 LoResultSetTemp)
		
		# (06/10/12 jtlelo) : verificamos que grupo de estilos trae,
		# para cambiar el color de los nombres de los distritos colindantes.
		_if _self.style_system_category = :|P Construccion FTTH|
		_then
			Color? << :green
		_else
			Color? << :black
		_endif
		
		# Colocar marcas de limites y nombres de los distritos adyacentes.
		LoDto << LoAppPNI.database.collection(:landbase, :user!_distrito)
		LoB   << LoAppPNI.database.collection(:gis, :building)
		LcollAdy << LoDto.select(LoPred11)
		_for LoRec _over LcollAdy.fast_elements()
		_loop
                        _try
				LopSel << predicate.within(:location, LoRec.user!_limite)
				LoEdificio << LoB.select(LopSel).an_element()
				
				(LcollSec1,LcollSec2)<<_self.Seccion_Interseccion(LoAreaGeometrica,LoRec.user!_limite,_self)
				LcollSec1.draw_on(.oWindows,line_style.new(colour.called(Color?),3))
				LcollSec2.draw_on(.oWindows,line_style.new(colour.called(Color?),3))
				
				LcollSec1<<LcollSec1.as_sector()
				LcollSec2<<LcollSec2.as_sector()
				_if LcollSec1.size>=2 _and LcollSec2.size>=2
				_then
					# Poner los nombres de las centrales colindantes o adyacentes.				
					# Crear una linea con los extremos donde se intersecta una central.
					LoLinea<<sector.new()
					LoLinea.add(LcollSec1.an_element())
					LoLinea.add(LcollSec2.an_element())
					# (06/10/26 jtlelo) : Verificamos si las dos cordenadas xy son
					# iguales, si son iguales mandamos solo uno, si son diferentes
					# mandamos el punto medio de las dos 
					_if (LcollSec1.an_element().x = LcollSec2.an_element().x) _andif
					    (LcollSec1.an_element().y = LcollSec2.an_element().y)
					_then
						LoPto<<LoLinea.an_element()					
					_else
						# Obtener el punto medio de la linea LoLinea
						LoPto<<LoLinea.as_sector_rope().mid_point
					_endif
					
					# Construir la nueva linea desde el punto medio a la central adyacente.
					LoLinea2<<sector.new()
					LoLinea2.add(LoPto)
					LoLinea2.add(LoRec.user!_limite.get_centroid().transformed(_self.transform))
					
					# Extender la linea hasta salir de los limites de la central.
					LnLongitud<<1
					_loop
						LoPto<<LoLinea2.coordinate_for_distance(LnLongitud)
						_if LoPto.within?(LoAreaGeometrica.transformed(_self.transform))
						_then
							LnLongitud<<LnLongitud+1
						_else
							# Extender la linea 300 ptos mas del limite de la central.
							LoPto<<_self.obten_pto_separado(LoLinea2.first_coord,LoPto,LnLongitud+300,0)
							_leave
						_endif
					_endloop
					
					LoLinea2.remove_last()
					LoLinea2.add(LoPto)
					_if LoRec.construction_status="PROYECTADO"
					_then
						LoTexto_creado << LoRec.user!_num_dto_ant.default("No Dato").write_string
						
					_elif LoRec.construction_status="EXISTENTE"
					_then
						LoTexto_creado << LoRec.user!_distrito.write_string
					_elif LoRec.construction_status="DESMONTAJE"
					_then
						
						LoTexto_creado << "["+LoRec.user!_distrito.write_string+"]"
					_endif
					
					_self.crea_anotacion(LoLinea2,Lotexto_creado,Color?)
				_endif	
								
			_when does_not_understand
				_continue
			_endtry
					
		_endloop
	_endif
	
	>>LoResultSet
	
_endmethod
$
_pragma(classify_level=restricted)
_method c_viewport_layout_sigc.plano_construccion_fo(PoResultSet)
	# Objetivo: Seleccionar todos los objetos visibles que se encuntran dentro de un Distrito.
	# Parametros de Entrada:          PoResultSet: Seleccion de objetos en la vista.
	# Parametros de Salida:           Ninguno.
	# Regresa:                        LoResultSet: Seleccion de objetos de interes.
	LoAppPNI<<smallworld_product.pni_application()			 
	LoEditorManager << LoAppPNI.plugin(:editor_manager)
	LyNombreTablaPrincipal << :user!_distrito_optico
	LyCampoGeometrico << :user!_limite

	
	LoResultSet << PoResultSet
	
	Dtooptico << swg_dsn_admin_engine.active_design.distrito_optico
	
	# Seleccionar todos los objetos visibles que se encuentren dentro del distrito.	
	LoResultSetTemp << LoResultSet.select(:overlaying, Dtooptico.user!_limite)
	
	LoResultSet << LoResultSetTemp	 
	# Se Elimina los elementos no requeridos para el plano de construcción
	LoResultSetTemp << LoResultSetTemp.exclude(:collection, {  :user!_bajante,
								   :curva_nivel,
								   :underground_route,
								   :access_point, 
								   :user!_municipio,    
								   :user!_central,
								   :user!_distrito,
								   :user!_manzana,
								   :user!_estado,         
								   :user!_poblacion,      
								   :user!_localidad,      
								    :swg_dsn_project_area})
	
	LoPred1     << predicate.like(:user!_distrito,     dtoOptico.user!_distrito)
	

	LoPred9     << predicate.interacts(:line_4,        {Dtooptico.user!_limite})	
	LoResultlineas << LoResultSet.select(:predicate, {:drafting_lines, LoPred9})
	 
	 LoResultPerfiles << geometry_set.new()
	 
	 _if LoResultlineas _isnt _unset _andif LoResultlineas.size > 0
	 _then
		 LoResultPerfiles << _self.busca_perfiles_canalizacion(LoResultlineas, LoResultSet)
	 _endif

	 #manzanas
	 LoPredM      << predicate.interacts(:user!_limite,  {Dtooptico.user!_limite})
	 LoResultSetM << PoResultSet.select(:predicate,      {:user!_manzana, LoPredM})

	 #canalizacion
	 LoPredcanal << predicate.inside(:route,     {Dtooptico.user!_limite})  #interacs
	 LoResultSetCanal << LoResultSet.select(:predicate, {:underground_route, LoPredCanal,:drafting_lines,LoPred9})

	 mis_perfiles << _self.perfiles_canalizacion(LoResultSetCanal, LoResultSet)

	# show(:perfiles2, mis_perfiles.size, LoResultSetCanal.size )
	 
	 LoPredDto    << predicate.interacts(:user!_limite,  {Dtooptico.user!_limite})	 

	 LoResultSetTemp << LoResultSetTemp.exclude(:predicate,{:user!_distrito_optico, LoPredDto})
	 
	LoResultSet << composite_geometry_set.new_with ( LoResultSetCanal,
							 mis_perfiles,
							 LoResultSetM,
							 LoResultSetTemp,
							 LoResultPerfiles  )
	
	
	_self.distritos_adyacentes
	
	
	>>LoResultSet
	
_endmethod
$
_pragma(classify_level=restricted)
_method c_viewport_layout_sigc.plano_de_bajantes(PoResultSet)
	##
	## Objetivo: Seleccionar los elementos a visibilizar dento del
	## plano de estudio de bajantes
	## Parametros de entrada: PoResultSet #lista de elementos
	##                                    #visibles en el layout 
	## Parametros de salida: LoResultSet #lista de elementos
	##                                   # filtrados 
	## Creado por: Jtlelo
	## Fecha:  (06/03/30 jtlelo) : creado.
	
	_local LoAppPNI                # Referencia a la Aplicacion PNI.
	_local LoEditorManager         # Referencia al plugin editor_manager.
	_local LyNombreTablaPrincipal  # Nombre interno de la tabla user!_central.
	_local LoObjetoEnEditor        # Objeto que se encuentra en el editor (debe ser un distrito).
	_local LoAreaGeometrica        # Area del distrito seleccionada.
	_local LoResultSet             # conjunto de geometrias que debeb ser dibujadas en Layout Designer.
	
	
	LoAppPNI<<smallworld_product.pni_application()
	_if LoAppPNI _is _unset
	_then
		#
		# (06/10/27 jtlelo) : 
	        # Para un usuario de la interfaz no gráfica
		# no habra una pni_application().
   	        # En este caso se utiliza la aplicación
	        # de dicha interfaz no gráfica.
	        #
		LoAppPNI << smallworld_product.application (:c_admin_proyectos_sin_grafico )
	_endif

	
	LoEditorManager<<LoAppPNI.plugin(:editor_manager)
	LyNombreTablaPrincipal<<:user!_distrito
	LyCampoGeometrico<<:user!_limite
	
	LoResultSet<<PoResultSet
	LoObjetoEnEditor<<_unset
	LoObjetoEnEditor<<swg_dsn_admin_engine.active_scheme.user!_distrito
	
	# Si hay un objeto en la tabla LyNombreTablaPrincipal hacer un
	# filtro de objetos.
	_if LoObjetoEnEditor _isnt _unset _andif
	    (LoAreaGeometrica<<LoObjetoEnEditor.perform(LyCampoGeometrico)) _isnt _unset
	_then
		
		# Seleccionar todos los objetos visibles
		# que se encuentren dentro del distrito.
		LoResultSetTemp << LoResultSet.select(:overlaying, LoAreaGeometrica )
		
		
	# Se elimina el detalle de la caja de distribución
		LoPred12 << predicate.overlays(:line_8,{LoAreaGeometrica})
	LoPred12_1 << predicate.overlays(:line_4,{LoAreaGeometrica})
	
	
	LoResultSetTemp << LoResultSetTemp.exclude(:predicate,{:drafting_lines, LoPred12_1,
							       :drafting_lines, LoPred12})
	
	LoResultSetTemp << LoResultSetTemp.exclude(:collection,{:underground_route,
								:curva_nivel,
								:user!_municipio, 
								:user!_central, 
								:user!_estado, 
								:user!_poblacion, 
								:user!_manzana, 
								:user!_colonia, 
								:swg_dsn_project_area, 
								:user!_localidad, 
								:user!_ashurado, 
								:mit_presentation_object})
	
	# Filtracion de la canalización en estado existente
	LoPredExistente << predicate.eq(:construction_status,"EXISTENTE")
	# Selecciona el area del distrito.
	LoPred1 << predicate.like(:user!_distrito, LoObjetoEnEditor.user!_distrito)
	# Selecciona las manzanas del distrito
	LoPred2 << predicate.within(:user!_limite,{LoAreaGeometrica})
	# Selecciona la canalización
	LoPred4 << predicate.overlays(:route,{LoAreaGeometrica}) _and LoPredExistente
	
	# Selecciona distritos adyacentes.
	LoPred11 << predicate.touches(:user!_limite,{LoAreaGeometrica})
	
	
	LoResultSet << LoResultSet.select(:predicate,{:user!_distrito,LoPred1,
						      :user!_manzana, LoPred2,
						      :underground_route, LoPred4})
	
	
	# (2006/04/20 jtlelo) : unimos el resultado de ambas busquedas	     
	LoResultSet << composite_geometry_set.new_with (LoResultSet, LoResultSetTemp )
	# (06/10/12 jtlelo) : verificamos que grupo de estilos trae,
	# para cambiar el color de los nombres de los distritos colindantes.
	_if _self.style_system_category = "plano_dtos"
	_then
		Color? << :green
	_else
		Color? << :black
	_endif
	
	# Colocar marcas de limites y nombres de los distritos adyacentes.
	LcollAdy << LoAppPNI.database.collection(:landbase,:user!_distrito).select(LoPred11)
	
	LoMbuilding << LoAppPNI.database.collection(:gis,:building)
	
	_for LoRec _over LcollAdy.fast_elements()
	_loop
		# INICIO DEL CAMBIO
		# (2010-11-23 Aarón Hernández Ramírez, SIGMATAO) : 
		#
		
		_try _with LoError
		     
		     LoEdificio<<LoMbuilding.select(predicate.within(:location,LoRec.user!_limite)).an_element()
		     
		     (LcollSec1,LcollSec2)<<_self.Seccion_Interseccion(LoAreaGeometrica,LoRec.user!_limite,_self)
		     LcollSec1.draw_on(.oWindows,line_style.new(colour.called(Color?),3))
		     LcollSec2.draw_on(.oWindows,line_style.new(colour.called(Color?),3))
		     
		     LcollSec1<<LcollSec1.as_sector()
		     LcollSec2<<LcollSec2.as_sector()
		     _if LcollSec1.size>=2 _and LcollSec2.size>=2
		     _then
				# Poner los nombres de las centrales colindantes o adyacentes.
			     
			     # Crear una linea con los extremos donde se intersecta una central.
			     LoLinea<<sector.new()
			     LoLinea.add(LcollSec1.an_element())
				LoLinea.add(LcollSec2.an_element())
				
				# Obtener el punto medio de la linea LoLinea
				LoPto<<LoLinea.as_sector_rope().mid_point
				
				# Construir la nueva linea desde el punto medio a la central adyacente.
				LoLinea2<<sector.new()
				LoLinea2.add(LoPto)
				LoLinea2.add(LoRec.user!_limite.get_centroid().transformed(_self.transform))
				
				# Extender la linea hasta salir de los limites de la central.
				LnLongitud<<1
				_loop
					LoPto<<LoLinea2.coordinate_for_distance(LnLongitud)
					_if LoPto.within?(LoAreaGeometrica.transformed(_self.transform))
					_then
						LnLongitud<<LnLongitud+1
					_else
						# Extender la linea 300 ptos mas del limite de la central.
						LoPto<<_self.obten_pto_separado(LoLinea2.first_coord,LoPto,LnLongitud+300,0)
						_leave
					_endif
				_endloop
				LoLinea2.remove_last()
				LoLinea2.add(LoPto)
				_if LoRec.construction_status="PROYECTADO"
				_then
					LoTexto_creado << LoRec.user!_num_dto_ant.default("No Dato").write_string
					
				_elif LoRec.construction_status="EXISTENTE"
				_then
					LoTexto_creado << LoRec.user!_distrito.write_string
				_elif LoRec.construction_status="DESMONTAJE"
				_then
					
					LoTexto_creado << "["+LoRec.user!_distrito.write_string+"]"
				_endif
				
				_self.crea_anotacion(LoLinea2,Lotexto_creado,Color?)
			_endif
		     
		     
		_when error
		      write(LoError.write_string + "Error en dto:"  +   LoRec.user!_distrito.write_string )
		      _continue
		_endtry
		
		
		#
		# FIN DEL CAMBIO
		
	_endloop
	_endif

	>>LoResultSet
	
	
_endmethod
$
