#						_self.escribe_dato(LoLinea2.last_coord.x-400,
#								   LoLinea2.last_coord.y-150,
#								   "[",
#								   colour.called(:red),12)
#						_self.escribe_dato(LoLinea2.last_coord.x,
#								   LoLinea2.last_coord.y-150,
#								   "CTL - "+LoRec.user!_central.write_string,
