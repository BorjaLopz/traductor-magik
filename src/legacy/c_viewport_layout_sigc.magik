_pragma(classify_level=restricted)
_method c_viewport_layout_sigc.zoom_to()
# Objetivo: Hacer un zoom a un area o punto de un viewport ya mapeado.
# Parametros de Entrada: Ninguno.
# Parametros de Salida: Ninguno.
# Regresa: Ninguno.
# Fecha de ultima modificacion: 24/Nov./2004
# Autor de la modificacion: rbsaldan.
# Descripcion de la modificacion: Metodo nuevo

# Fecha de ultima modificacion: 21/Ene./2005
# Autor de la modficacion: rbsaldan.
# Descripcion de la modificacion: Documentar codigo.
	
_local LoLayoutDesigner   # Referencia a la aplicacion de layout designer.
_local LoApp              # Referencia a la aplicacion de pni.

        # Obtener la aplicacion pni.
	LoApp << smallworld_product.pni_application()
	
	LoMapPlugin << LoApp.plugin(:map_plugin)

	
	# Obtener la aplicacion layout designer.
	LoLayoutDesigner << LoApp.plugin(:layout_plugin).start_layout_designer()
	
	# Obtener
	LoViewMapperPlugin<<LoLayoutDesigner.plugin(:viewport_mapper)
	# Obtener el layout manager
	LoLayoutManager<<LoLayoutDesigner.plugin(:layout_manager)

	_if LoLayoutDesigner _isnt _unset _and LoLayoutManager _isnt _unset
	_then
		# Obtener los sectores de un trail dibujado en el layout designer.
		LcollSector << LoLayoutManager.current_layout_view.trail.current_sector
		_if LcollSector _isnt _unset
		_then
			# Obtener la transformacion del viewport (self).
			LoTransGisPag<<_self.transform
			# Obtener la transformacion inversa del viewport (self).
			LoTransPagGis<<LoTransGisPag.inverse()
			_if LcollSector.size=1  # El trail es un punto.
			_then
				LoCoord<<LcollSector.first_coord
				LoCoord<<LoCoord.transformed(LoTransPagGis)
			
				# Crear un buffer de 20 metros.
				LoBuffer<<LoCoord.buffer(20*1000)
				LoBuffer << LoBuffer.transformed(transform.new().scalexy(0.01,0.01))
				LoBuffer.world << LoMapPlugin.current_map.world
				# Hacer un acercamiento del buffer en el mapa en la vista principal.
				LoMapPlugin.goto(LoBuffer)
			_else   # El trail es una linea o area.
				# Obtener el bound de trail, crear una pseudo area con ese
				# trail, dibujar la psudo area en el mapa de la vista principal
				# y tener la referencia a dicho trail.
				LoBound<<LcollSector.bounds.transformed(LoTransPagGis)
				Lopsa<<pseudo_area.new_with_sectors(LoBound.sectors)
				LoMapPlugin.current_map.set_trail_from_geometry(Lopsa)
				LoTrail<<smallworld_product.pni_application().plugin(:map_trail).current_trail

				# Hacer un acercamiento del trail al mapa de la vista principal.
				LoBounds<<LoTrail.bounds
				LoBounds<<Lobounds.transformed(transform.new().scalexy(0.01,0.01)).bounds

				LoMapPlugin.current_map_view.goto_bounds(LoBounds)
				LoMapPlugin.current_map_view.view_scale<<LoMapPlugin.current_map_view.view_scale*10
			_endif

			# Crear un viewport y mapearlo a la vista actual del mapa y
			# agregarlo a la pagina actual en el layout designer.
			LoVpArea<<bounding_box.new(0,0,500,500)
			LoViewport<<viewport_layout.new_with(:bounds,LoVpArea)
			LoViewport.set_fill_colour(_unset)
			LoViewport.trail<<_false
			Loviewport.selection<<_false
			_self.layout_page.add_element(LoViewport)
			
			LoMapView<<LoMapPlugin.current_map_view
			LoViewMapperPlugin.map_viewport_on_map_view(LoViewport,
								    LoMapView,
								    LoMapView.current_view_bounds,
								    _true)
			LoViewport.ace_name<<_self.ace_name.default("CENTRALES")
		_else
			LoLayoutDesigner.show_message("haga un trazo (punto o linea) sobre el Viewport seleccionado.")
		_endif
	_endif
_endmethod
$
