_pragma(classify_level=restricted)
_method c_viewport_layout_sigc.plano_generico(PoResultSet)
# Objetivo: Seleccionar elementos para el plano generico.
# Parametros de Entrada:PoResultSet: Seleccion de objetos en la vista.
# Parametros de Salida: Ninguno.
# Regresa: LoResultSet:   Seleccion de objetos de interes.
# Fecha de ultima modificacion: 2/Mayo/2005
# Autor de la modificacion: rbsaldan
# Descripcion de la modificacion: Metodo nuevo.
_local LoResultSet

        LoResultSet<<PoResultSet
	_for LdsrRec _over LoResultSet.rwo_set().fast_elements()
	_loop
		_if LdsrRec.is_kind_of?(user!_poblacion)
		_then
			write(LdsrRec)
		_endif
	_endloop
	_return LoResultSet
_endmethod
$
_pragma(classify_level=restricted)
_method c_viewport_layout_sigc.plano_itinerario(PoResultSet)58
# Objetivo: Seleccionar los distritos, manzanas, ejes de calle
#           y el edificio de la central que estan dentro del area de
#           central.
# Parametros de Entrada:PoResultSet:  Seleccion de objetos en la vista.
# Parametros de Salida: Ninguno.
# Regresa: LoResultSet:               Seleccion de objetos de interes.
# Fecha de ultima modificacion: 23/Dic./2004
# Autor de la modificacion: rbsaldan
# Descripcion de la modificacion: Metodo nuevo.
	
# Fecha de ultima modificacion: 21/Ene./2005
# Autor de la modificacion: rbsaldan
# Descripcion de la modificacion: Documentar codigo.

	_local LoAppPNI                # Referencia a la Aplicacion PNI.
	_local LoEditorManager         # Referencia al plugin editor_manager.
	_local LyNombreTablaPrincipal  # Nombre interno de la tabla user!_central.
	_local LoObjetoEnEditor        # Objeto que se encuentra en el editor (debe ser una central).
	_local LoAreaGeometrica        # Area de la central seleccionada.
	_local LyCampoGeometrico       # Campo geometrico de la central seleccionada.
	_local LoResultSet             # conjunto de geometrias que debeb ser dibujadas en Layout Designer.
#_local LoEditor               # Referencia a un editor.
	_local LoPredProyectado               # Consulta para elementos proyectados
     
     LoAppPNI << smallworld_product.pni_application()
     _if LoAppPNI _is _unset
     _then
	     #
	     # (06/10/27 jtlelo) : 
	     # Para un usuario de la interfaz no gráfica
	     # no habra una pni_application().
	     # En este caso se utiliza la aplicación
	     # de dicha interfaz no gráfica.
	     #
		LoAppPNI << smallworld_product.application (:c_admin_proyectos_sin_grafico )
     _endif 
     LoEditorManager << LoAppPNI.plugin(:editor_manager)
     LyNombreTablaPrincipal << :user!_central
     LyCampoGeometrico << :user!_limite

     LoResultSet << PoResultSet
     LoObjetoEnEditor << _unset
     # De todos los editores embebidos, tomar el editor que
     # corresponda a la tabla LyNombreTablaPrincipal y tomar la
     # referencia al objeto corriente en el editor.
     _for LoEditor _over LoEditorManager.sys!slot(:embedded_editors).fast_elements()
     _loop
	     _if LoEditor.collection _isnt _unset _andif
		 LoEditor.collection.name _is LyNombreTablaPrincipal _andif 
		 (LoObjetoEnEditor << LoEditor.current_object) _isnt _unset
	     _then
		     # Esto es, en el editor embebido hay un objeto de la tabla
		     # LyNombreTablaPrincipal.
		     _leave
	     _endif
     _endloop
     
     # Si hay un objeto en la tabla LyNombreTablaPrincipal y su
     # campo geometrico no es nulo, hacer un filtro de objetos.
     LoObjetoEnEditor << swg_dsn_admin_engine.active_scheme.project.user!_central
     _if LoObjetoEnEditor _isnt _unset _andif
	 (LoAreaGeometrica << LoObjetoEnEditor.perform(LyCampoGeometrico)) _isnt _unset
     _then   LoResultSet.select(:collection, :indicador)
	     #LoPredProyectado<<predicate.eq(:construction_status,"PROYECTADO")
	     #LoPredExistente<<predicate.eq(:construction_status,"EXISTENTE")
	     # Selecciona el area de la centra.
	     LoPred1 << predicate.like(:user!_central, LoObjetoEnEditor.user!_central.slice(1, 3) + %%)

	     # Selecciona centrales adyacentes.
	     LoPred11 << predicate.touches(:user!_limite, {LoAreaGeometrica})
	     
	     # Seleccionan todos los distritos con prefico igual a la central.
	     LoPred2 << predicate.like(:user!_distrito, LoObjetoEnEditor.user!_central.slice(1, 3) + %%) 
	     # Selecciona todas las manzanas que estan dentro del area de la central.
	     #LoPred3<<predicate.within(:user!_limite,{LoAreaGeometrica})

	     # Selecciona todos los ejes de calle que estan dentro del area
	     # de la central.
	     LoPred4 << predicate.within(:user!_posicion, {LoAreaGeometrica})
	     # Selecciona el building (edificio de la central) dentro del
	     # area de la central.
	     # Selecciona la caja terminal dentro del distrito.
	     LoPred5 << predicate.within(:location, {LoAreaGeometrica})

	     tmprs << LoResultSet.select(:collection, :indicador)
	     # Selecciona la canalizacion dentro del area de la central.
	     LoPred6 << predicate.within(:route, {LoAreaGeometrica} ) #_and LoPredProyectado
	     # Selecciona los pozos dentro del area de la central.

	     #pred. para obtener los draftings
	     LoPredDrftLn<<predicate.within(:line_1, {LoAreaGeometrica} ) _or
			   predicate.within(:line_2, {LoAreaGeometrica} ) _or
			   predicate.within(:line_3, {LoAreaGeometrica} ) _or
			   predicate.within(:line_4, {LoAreaGeometrica} ) _or
			   predicate.within(:line_5, {LoAreaGeometrica} ) _or
			   predicate.within(:line_6, {LoAreaGeometrica} ) _or
			   predicate.within(:line_7, {LoAreaGeometrica} ) _or
			   predicate.within(:line_8, {LoAreaGeometrica} ) _or
			   predicate.within(:line_9, {LoAreaGeometrica} ) _or
			   predicate.within(:line_10, {LoAreaGeometrica} ) _or
			   predicate.within(:line_11, {LoAreaGeometrica} ) _or
			   predicate.within(:line_12, {LoAreaGeometrica} ) _or
			   predicate.within(:line_13, {LoAreaGeometrica} ) _or
			   predicate.within(:line_14, {LoAreaGeometrica} ) _or
			   predicate.within(:line_15, {LoAreaGeometrica} )
	     
	     LoPredDrftTx<<predicate.within(:text_1, {LoAreaGeometrica} ) _or
			   predicate.within(:text_2, {LoAreaGeometrica} ) _or
			   predicate.within(:text_3, {LoAreaGeometrica} ) _or
			   predicate.within(:text_4, {LoAreaGeometrica} ) _or
			   predicate.within(:text_5, {LoAreaGeometrica} ) _or
			   predicate.within(:text_6, {LoAreaGeometrica} ) _or
			   predicate.within(:text_7, {LoAreaGeometrica} ) _or
			   predicate.within(:text_8, {LoAreaGeometrica} ) _or
			   predicate.within(:text_9, {LoAreaGeometrica} ) _or
			   predicate.within(:text_10, {LoAreaGeometrica} ) _or
			   predicate.within(:text_11, {LoAreaGeometrica} ) _or
			   predicate.within(:text_12, {LoAreaGeometrica} ) _or
			   predicate.within(:text_13, {LoAreaGeometrica} ) _or
			   predicate.within(:text_14, {LoAreaGeometrica} ) _or
			   predicate.within(:text_15, {LoAreaGeometrica} )

	     LoPredDimension<<predicate.within(:dimension, {LoAreaGeometrica} )
	     

	     # (06/03/04 jtlelo) :  seleccionamos las manzanas utilizando
	     # un tipo distinto de interaccion. El motivo es acelerar el
	     # proceso, ya que en la valoracion de manzanas el proceso
	     # se prolongaba mucho en el tiempo. 
	     Mset << LoResultSet.select ( :collection, { :user!_manzana } )
	     Mset << Mset.select ( :bb_centre_within, LoAreaGeometrica )

	     
	     # (06/10/06 jtlelo) : se deshabilito para la canalizacion y los
	     # pozos la opción de proyectado y existente
	     LoResultSet << LoResultSet.select(:predicate,{:user!_central, LoPred1,
							   :user!_distrito, LoPred2,
							   #:user!_manzana,LoPred3,
							   :user!_eje_calle, LoPred4,
							   :building, LoPred5,
							   :mit_terminal_enclosure, LoPred5,
							   :uub, LoPred5, # _and (LoPredProyectado _or LoPredExistente),
							   :underground_route, LoPred6,
							   :drafting_lines,LoPredDrftLn,
							   :drafting_lines,LoPredDrftTx,
							   :dimensioning,LoPredDimension})# _and (LoPredProyectado _or LoPredExistente)})
	     
	     LoResultSet << LoResultSet.append(tmprs)

	     #  (06/03/04 jtlelo) : unimos el resultado de ambas busquedas
	     LoResultSet << composite_geometry_set.new_with ( Mset, LoResultSet )
	         # (06/10/12 jtlelo) : verificamos que grupo de estilos trae,
		# para cambiar el color de los nombres de las centrales colindantes.
		_if _self.style_system_category = "plano"
		_then
			Color? << :magenta
		_else
			Color? << :black
		_endif
		

		# Colococar marcas de limites y nombres de las centrales adyacentes.
		LcollAdy << LoAppPNI.database.collection(:landbase, :user!_central).select(LoPred11)
		_for LoRec _over LcollAdy.fast_elements()
		_loop
			LoEdificio << LoAppPNI.database.collection(:gis, :building).
				    select(predicate.within(:location, LoRec.user!_limite)).an_element()
		
			(LcollSec1, LcollSec2) << _self.Seccion_Interseccion(LoAreaGeometrica, LoRec.user!_limite, _self)
			LcollSec1.draw_on(.oWindows, line_style.new(colour.called(Color?), 3))
			LcollSec2.draw_on(.oWindows, line_style.new(colour.called(Color?), 3))

			LcollSec1 << LcollSec1.as_sector()
			LcollSec2 << LcollSec2.as_sector()
			_if LcollSec1.size >= 2 _and LcollSec2.size >= 2
			_then
				# Poner los nombres de las centrales colindantes o adyacentes.

				# Crear una linea con los extremos donde se intersecta una central.
				LoLinea << sector.new()
				LoLinea.add(LcollSec1.an_element())
				LoLinea.add(LcollSec2.an_element())

	  		        # (06/10/26 jtlelo) : Verificamos si las dos cordenadas xy son
				# iguales, si son iguales mandamos solo uno, si son diferentes
				# mandamos el punto medio de las dos 
				_if (LcollSec1.an_element().x = LcollSec2.an_element().x) _andif
				    (LcollSec1.an_element().y = LcollSec2.an_element().y)
				_then
					LoPto << LoLinea.an_element()					
				_else
					# Obtener el punto medio de la linea LoLinea
					LoPto << LoLinea.as_sector_rope().mid_point
				_endif
				
				
				# Construir la nueva linea desde el punto medio a la central adyacente.
				LoLinea2 << sector.new()
				LoLinea2.add(LoPto)
				LoLinea2.add(LoRec.user!_limite.get_centroid().transformed(_self.transform))
				
				# Extender la linea hasta salir de los limites de la central.
				LnLongitud << 1
				_loop
					LoPto << LoLinea2.coordinate_for_distance(LnLongitud)
					_if LoPto.within?(LoAreaGeometrica.transformed(_self.transform))
					_then
						LnLongitud << LnLongitud + 1
					_else
						# Extender la linea 300 ptos mas del limite de la central.
						LoPto << _self.obten_pto_separado(LoLinea2.first_coord, LoPto, LnLongitud + 300, 0)
						_leave
					_endif
				_endloop
				LoLinea2.remove_last()
				LoLinea2.add(LoPto)

				_if LoEdificio _isnt _unset 
				_then
					_if LoEdificio.construction_status = "PROYECTADO"
					_then

						LoTexto_creado << "[CTL - " + LoRec.user!_central.write_string + "]"
						_self.crea_anotacion(LoLinea2, Lotexto_creado, Color?)
					_else
						LoTexto_creado << "CTL - " + LoRec.user!_central.write_string
						_self.crea_anotacion(LoLinea2, Lotexto_creado, Color?)
					_endif
				_else
					LoTexto_creado << "CTL - " + LoRec.user!_central.write_string
					_self.crea_anotacion(LoLinea2, Lotexto_creado, Color?)
					# se comentan las siguientes lineas por el llamado al nuevo metodo
				_endif
				# fin de la modificación
			_endif
		_endloop
     _endif
     >>LoResultSet
_endmethod
$
_method c_viewport_layout_sigc.plano_ruta_de_cables(PoResultSet)
# Objetivo:              Seleccionar los distritos, manzanas, ejes de calle y el edificio de la
#                        central que estan dentro del area de central.
# Parametros de Entrada: PoResultSet: Seleccion de objetos en la vista.
# Parametros de Salida:  Ninguno

	_local LoAppPNI                # Referencia a la Aplicacion PNI.
	_local LoEditorManager         # Referencia al plugin editor_manager.
	_local LyNombreTablaPrincipal  # Nombre interno de la tabla user!_central.
	_local LoObjetoEnEditor        # Objeto que se encuentra en el editor (debe ser una central).
	_local LoAreaGeometrica        # Area de la central seleccionada.
	_local LyCampoGeometrico       # Campo geometrico de la central seleccionada.
	_local LoResultSet             # Conjunto de geometrias que debeb ser dibujadas en Layout Designer.

	LoResultSet << _unset
	LoBuffer << _unset

	(LoResultSet, LoBuffer) << _self.filtra_rutas(Glorutaopb.get_canalizacion(),
						      poresultset,
						      LoResultSet,
						      LoBuffer)
	(LoResultSet, LoBuffer) << _self.filtra_rutas(Glorutaopb.get_ruta_aerea(),
						      poresultset,
						      LoResultSet,
						      LoBuffer)
	LoAppPNI << smallworld_product.pni_application()
	_if LoAppPNI _is _unset
	_then
		# (06/10/27 jtlelo) : 
		# Para un usuario de la interfaz no gráfica no habrá una pni_application().
		# En este caso se utiliza la aplicación de dicha interfaz no gráfica.
		LoAppPNI << smallworld_product.application ( :c_admin_proyectos_sin_grafico )
                LoSelectCanaliza << _unset 
	_else
		LMapaPlugin <<  LoAppPNI.plugin(:map_plugin).current_map
		LoSelectCanaliza << LMapaPlugin.current_selection
	_endif
	_if LoSelectCanaliza _isnt _unset
	_then
		(LoResultSet, LoBuffer) << _self.filtra_rutas(LoSelectCanaliza.rwo_set(),
							      poresultset,
							      LoResultSet,
							      LoBuffer,
							      _true)
	_endif
	LoEditorManager << LoAppPNI.plugin(:editor_manager)	
	LyNombreTablaPrincipal << :user!_central
	LyCampoGeometrico << :user!_limite
	LoObjetoEnEditor << _unset
	# Si hay un objeto en la tabla LyNombreTablaPrincipal y su
	# campo geometrico no es nulo, hacer un filtro de objetos.
	LoObjetoEnEditor << swg_dsn_admin_engine.active_scheme.project.user!_central
	_if LoObjetoEnEditor _isnt _unset _andif
	    (LoAreaGeometrica << LoObjetoEnEditor.perform(LyCampoGeometrico)) _isnt _unset
	_then
	        # Obtener Manzanas colindantes con la canalización
		_if LoBuffer _isnt _unset 
		_then
			LoBuffer.world << LoAppPNI.plugin(:map_plugin).current_map.world
		_else
			condition.raise(:user_error, :string,
                                        "No hay canalización y/o ruta aérea, imposible general el plano.")
		_endif
		# (06/11/08 jtlelo) : Seleccionamos todos los elementos que estén dentro del
		# buffer, (pozos, terminales, empalmes, etc)
		LoResultSetWithin << PoResultSet.select(:interacting_with, LoBuffer)
		# Se Elimina los elementos no requeridos para el plano de ruta de cables.
		LoResultSetWithin << LoResultSetWithin.exclude(:collection, {:user!_lote,
									     :underground_route,
									     :aerial_route})
		# (07/01/26 jtlelo) : Selecciona las llaves del cable proyectado.
		LoResultSetOverlay << PoResultSet.select(:overlaying, LoBuffer)
		Lostructure_annotation << LoResultSetOverlay.select(:collection, {:structure_annotation})
		

		LoResultlineas << LoResultSetWithin.select(:collection, :drafting_lines)
		# (06/11/08 jtlelo) : Creamos un geometry set para asegurarnos que se una con las
		# demas busquedas resultantes
		LoResultPerfiles << geometry_set.new() 
		_if LoResultlineas _isnt _unset _andif LoResultlineas.size > 0
		_then
			LoResultPerfiles << _self.busca_perfiles_canalizacion(LoResultlineas, PoResultSet)
		_endif

		
		LoResultSetWithin << LoResultSetWithin.select(:collection, {:user!_manzana,
									    :user!_eje_calle,
									    :building,
									    :user!_reserva,
							                    :mit_terminal_enclosure,
							                    :uub,
							                    :pole,
							                    :copper_splice})
		# (06/11/07 jtlelo) : unimos las tres consultas:
		# LoResultSetWithin (elementos que estan dentro del buffer)
		# LoResultPerfiles (Perfiles de canalización que interactuan con el buffer)
		# LoResultSet (Ruta aérea y canalización)
		LoResultSet << LoResultSet.append(LoResultSetWithin)
		LoResultSet << LoResultSet.append(LoResultPerfiles)
		loResultSet << LoResultSet.append(Lostructure_annotation)
	_endif

#	LoGuarda << c_guarda_objetos_vp.new()
#	LoGuarda.oResulSet << LoResultSet
#	elementos << LoGuarda.genera_lista_gsfr()
#	# (10/05/26 jtlelo) : recibimos una hash_table
#	
#	_for ky _over elementos.keys.fast_elements()
#	_loop
#		_self.guardar_visualizacion(elementos[ky],  ky)
#	_endloop

	>>LoResultSet
_endmethod
