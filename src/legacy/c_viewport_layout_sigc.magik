_pragma(classify_level=restricted, usage={redefinable})
_method c_viewport_layout_sigc.defined_attributes
	## 
	## 
	attribs << rope.new_from(_super.defined_attributes)
	## Propiedad que indica si el viewport se ajusta al marco.
	attribs.add ( layout_attribute_definition.new(:ajusta_al_marco,             :string,
						      :description,                 "Ajustar al Marco",
						      :default_value,               "Si",
						      :allowed_on_properties_page?, _true,
						      :enum_method,                 :val_falso_verdadero,
						      :editor,                      _unset))

	attribs.add ( layout_attribute_definition.new(:fijar_configuracion,         :string,
						      :description,                 "fijar configuración",
						      :default_value,               "No",
						      :allowed_on_properties_page?, _true,
						      :enum_method,                 :val_falso_verdadero,
						      :editor,                      _unset))


	
	attribs.add ( layout_attribute_definition.new(:sTipoPlano,                  :string,
						      :description,                 "Tipo de Plano",
						      :default_value,               "",
						      :allowed_on_properties_page?, _true,
						      :editor,                      _unset))
	
	>> attribs
_endmethod
$
c_viewport_layout_sigc.define_attributes()
