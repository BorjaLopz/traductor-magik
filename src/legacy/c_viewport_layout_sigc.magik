_pragma(classify_level=restricted)
_method c_viewport_layout_sigc.Seccion_Interseccion(PoGeom1,PoGeom2, _optional LoVp)
	## 
	##
_local LcollInterseccion
_local Lbfuera?
_local LoApp
_local LoCurrentView
_local LcollInterseccionFinal1<<sector_rope.new()
_local LcollInterseccionFinal2<<sector_rope.new()

        LoApp<<smallworld_product.pni_application()
	_if LoVp _is _unset _then
		LoVp << _self
	_endif
	
        LcollInterseccion1<<sector.new()
	LcollInterseccion2<<sector.new()
	Lbfuera?<<_false
	LbPuntoActualFuera?<<_false
	LbPuntoAnteriorFuera?<<_unset
	LoCoordAnt<<_false
	
	_for LoCoord _over PoGeom2.sectors.coords().fast_elements()
	_loop
		_if LoCoord.touches?(PoGeom1)
		_then
			LbPuntoActualFuera?<<_false
		_else
			LbPuntoActualFuera?<<_true
		_endif

		_if LbPuntoAnteriorFuera? _is _unset
		_then
			LbPuntoAnteriorFuera?<<LbPuntoActualFuera?
			LoCoordAnt<<LoCoord
			_continue
		_endif
		_if LbPuntoAnteriorFuera? _is _false  _and LbPuntoActualFuera? _is _true
		_then
			LcollInterseccion1.add(LoCoordAnt.transformed(LoVp.transform))
			LcollInterseccion1.add(LoCoord.transformed(LoVp.transform))
		_elif LbPuntoAnteriorFuera? _is _true _and LbPuntoActualFuera? _is _false
		_then
			LcollInterseccion2.add(LoCoord.transformed(LoVp.transform))
			LcollInterseccion2.add(LoCoordAnt.transformed(LoVp.transform))
		_endif
		
		LbPuntoAnteriorFuera?<<LbPuntoActualFuera?
		LoCoordAnt<<LoCoord
	_endloop

#	_if LcollInterseccion1.size>=2
#	_then
#		LoCoordenada<<LcollInterseccion1.coordinate_for_distance(1) #LoCurrentView.view_scale)
#		LcollInterseccion1.remove_last()
#		LcollInterseccion1.add(LoCoordenada)
#	_endif
#	_if LcollInterseccion2.size>=2
#	_then
#		LoCoordenada<<LcollInterseccion2.coordinate_for_distance(1) #LoCurrentView.view_scale)
#		LcollInterseccion2.remove_last()
#		LcollInterseccion2.add(LoCoordenada)
#	_endif
	_if  LcollInterseccion1.size>0 _andif  (LcollInterseccion1.size _mod 2)=0
	_then
		LoFlag<<_false
		_for LiIdx _over 1.upto(LcollInterseccion1.size)
		_loop
			_if LoFlag _is _true 
			_then
				LcollInterseccion1_tmp<<sector.new()
				LcollInterseccion1_tmp.add(LcollInterseccion1[LiIdx-1])
				LcollInterseccion1_tmp.add(LcollInterseccion1[LiIdx])
				
				LoCoordenada<<LcollInterseccion1_tmp.coordinate_for_distance(0.01)
				LoCoordenada<<_self.obten_pto_separado(LcollInterseccion1[LiIdx-1],LoCoordenada,100,0)
				LcollInterseccion1_tmp[LcollInterseccion1_tmp.size]<<LoCoordenada

				LcollInterseccionFinal1.add(LcollInterseccion1_tmp)
				LoFlag<<_false
			_else

				LoFlag<<_true
			_endif
		_endloop
	_endif


	_if  LcollInterseccion2.size>0 _andif  (LcollInterseccion2.size _mod 2)=0
	_then
		LoFlag<<_false
		_for LiIdx _over 1.upto(LcollInterseccion2.size)
		_loop
			_if LoFlag _is _true 
			_then
				LcollInterseccion2_tmp<<sector.new()
				LcollInterseccion2_tmp.add(LcollInterseccion2[LiIdx-1])
				LcollInterseccion2_tmp.add(LcollInterseccion2[LiIdx])

				LoCoordenada<<LcollInterseccion2_tmp.coordinate_for_distance(0.01)
				LoCoordenada<<_self.obten_pto_separado(LcollInterseccion2[LiIdx-1],LoCoordenada,100,0)
				LcollInterseccion2_tmp[LcollInterseccion2_tmp.size]<<LoCoordenada

				LcollInterseccionFinal2.add(LcollInterseccion2_tmp)
				LoFlag<<_false
			_else

				LoFlag<<_true
			_endif
		_endloop
	_endif
	
	#_endif
	_return LcollInterseccionFinal1,LcollInterseccionFinal2
_endmethod
