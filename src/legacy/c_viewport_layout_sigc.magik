_pragma(classify_level=restricted)
_method c_viewport_layout_sigc.dibuja_limite_de_central(limite_distrito)

	##(vbluna-29/ago/2012)
	## Obtiene un conjunto de coordenadas a partir del limite de
	## una central que coindicen con un limite_distrito
	## En base a las coordenadas obtenidas, se dibuja una linea en
	## el layout
	
	ldbv << gis_program_manager.cached_dataset(:landbase)
	coll_central << ldbv.collections[:user!_central]
	pred_ctls << predicate.interacts(:user!_limite, limite_distrito)
	result_predicate << coll_central.select(pred_ctls)
	a_ctl << result_predicate.an_element()
	
	_if a_ctl _is _unset
	_then
		_return 
	_endif

	a_sector_rope << sector_rope.new()
	a_sector << _unset
	ultima_coord_coincidente << 0
	cont << 0
	
	_for a_coord _over limite_distrito.sectors.coords().fast_elements()
	_loop
		cont+<< 1

		_if a_coord.touches?(a_ctl.user!_limite)
		_then
			_if ultima_coord_coincidente = 0
			_then
				a_sector << sector.new()
			_elif ultima_coord_coincidente <> (cont-1)
			_then 
				a_sector_rope.add(a_sector)
				a_sector << sector.new()
			_endif

			a_sector.add(a_coord.transformed(_self.transform))
			ultima_coord_coincidente << cont
		_endif
	_endloop

	_if a_sector _isnt _unset
	_then
		a_sector_rope.add(a_sector)
	_endif

	ls << line_style.new_with_properties(
                  :foreground_colour, colour.called("magenta"), 
                  :width, 6, 
                  :dash_pattern, dash_pattern.new_with(20, 5, 5, 5))
	
	a_sector_rope.draw_on(.oWindows,ls)
	
_endmethod
$
_pragma(classify_level=restricted)
_method c_viewport_layout_sigc.distritos_adyacentes
	#---------------------------------------------------
	##  Objetivo  : # Colocar marcas de limites y nombres de los distritos adyacentes.
	##
	
        distritooptico << swg_dsn_admin_engine.active_scheme.distrito_optico
	LoAreaGeometrica<<distritooptico.user!_limite
	LoDto << distritooptico.source_collection 
	LoB   << mit_manager.modelit_dataset.collection(:building)
	LoPred11 << predicate.touches(:user!_limite, {distritooptico.user!_limite})
	LcollAdy << LoDto.select(LoPred11)
	adyacentes<<distritooptico.ubica_seccion_compartida()

	_for k,v _over adyacentes.keys_and_elements()
	_loop           	     
		lineat << sector.new()
		
                _for Loline _over v[3].fast_elements()
		_loop
                      _for LoCord _over Loline.fast_elements()
		      _loop
			         LoCoordt<<LoCord.transformed(_self.transform)
				 lineat.add(LoCoordt)
		      _endloop		      
		_endloop

		_self.crea_anotacion(lineat,v[4].write_string,:green)
		
	_endloop
	
_endmethod
$
_pragma(classify_level=restricted)
_method c_viewport_layout_sigc.escribe_dato(PoCoordX,PoCoordY,PsTexto,PoColor,PiTamano)
