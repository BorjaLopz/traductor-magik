$
_pragma(classify_level=restricted)
_method c_vp_cobre.DibujarMarcas(PoWindow,PnAncho, _optional PoPage,PbMarcoCompleto?)

	_local LcollEsquinas<<sector_rope.new()
_local LcollEsquina
_local LoBounds

        LoBounds<<PoPage.default(_self).bounds
	
        LoBounds<<bounding_box.new(LoBounds.xmin+_self.SANGRIA_HOR,
				   LoBounds.ymin+_self.SANGRIA_VER,
				   LoBounds.xmax-_self.SANGRIA_HOR,
				   LoBounds.ymax-_self.SANGRIA_VER)

        # Esquina inferior izquierda.
	LcollEsquina<<sector.new()
	LcollEsquina.add(coordinate(LoBounds.xmin,LoBounds.ymin)+coordinate(0,PnAncho))
	LcollEsquina.add(LcollEsquina.last_coord-coordinate(0,PnAncho))
	LcollEsquina.add(LcollEsquina.last_coord+coordinate(PnAncho,0))
	_if PbMarcoCompleto? _isnt _unset _andif PbMarcoCompleto? _is _true 
	_then
		LcollEsquina.add(coordinate(LoBounds.xmax,LoBounds.ymin)-coordinate(PnAncho,0))
	_endif
	LcollEsquinas.add(LcollEsquina)

	# Esquina inferior derecha.
	LcollEsquina<<sector.new()
	LcollEsquina.add(coordinate(LoBounds.xmax,LoBounds.ymin)-coordinate(PnAncho,0))
	LcollEsquina.add(LcollEsquina.last_coord+coordinate(PnAncho,0))
	LcollEsquina.add(LcollEsquina.last_coord+coordinate(0,PnAncho))
	_if PbMarcoCompleto? _isnt _unset _andif PbMarcoCompleto? _is _true 
	_then
		LcollEsquina.add(coordinate(LoBounds.xmax,LoBounds.ymax)-coordinate(0,PnAncho))
	_endif
	LcollEsquinas.add(LcollEsquina)

	# Esquina superior derecha.
	LcollEsquina<<sector.new()
	LcollEsquina.add(coordinate(LoBounds.xmax,LoBounds.ymax)-coordinate(0,PnAncho))
	LcollEsquina.add(LcollEsquina.last_coord+coordinate(0,PnAncho))
	LcollEsquina.add(LcollEsquina.last_coord-coordinate(PnAncho,0))
	_if PbMarcoCompleto? _isnt _unset _andif PbMarcoCompleto? _is _true 
	_then
		LcollEsquina.add(coordinate(LoBounds.xmin,LoBounds.ymax)+coordinate(PnAncho,0))
	_endif
	LcollEsquinas.add(LcollEsquina)

	# Esquina superior izquierda.
	LcollEsquina<<sector.new()
	LcollEsquina.add(coordinate(LoBounds.xmin,LoBounds.ymax)+coordinate(PnAncho,0))
	LcollEsquina.add(LcollEsquina.last_coord-coordinate(PnAncho,0))
	LcollEsquina.add(LcollEsquina.last_coord-coordinate(0,PnAncho))
	_if PbMarcoCompleto? _isnt _unset _andif PbMarcoCompleto? _is _true 
	_then
		LcollEsquina.add(coordinate(LoBounds.xmin,LoBounds.ymin)+coordinate(0,PnAncho))
	_endif
	LcollEsquinas.add(LcollEsquina)
	
	LcollEsquinas.draw_on(.oWindows,colour.called(:black))	

_endmethod
$
