_package user
$
def_slotted_exemplar(:c_vp_localizacion_tba,
		     {
			     {:oEstructura,     _unset, :writable, :public}
		     },
                      :viewport_layout)
$
c_vp_localizacion_tba.define_shared_constant(:allowed_on_menu?,_false,:public)
$
c_vp_localizacion_tba.define_shared_constant(:LoGeom,
					      property_list.new_with(			      
					      :user!_building,:boundary,
                                              :building,:location,
					      :mit_terminal_enclosure,:location,
                                              :user!_eje_calle,:user!_anotacion,
					      :underground_route,:route,
	                                      :user!_manzana,:user!_limite), _false)
$
c_vp_localizacion_tba.define_shared_constant(:LoGeomTxt,
					      property_list.new_with(
					      :mit_terminal_enclosure,:annotation_2,
					      :user!_building,:annotation_1),_false)
$
c_vp_localizacion_tba.define_shared_constant(:titulo,
					     "Croquis de Localización de la Terminal de Banda Ancha",
					     :public)
$
_pragma(classify_level=restricted)
_method c_vp_localizacion_tba.agregar_estructuras()
## Objetivo: Agregar la estructura que contiene al tba, para su
## localizacion en el viewport
## Parametros de salida: Ninguno
## Regresa: loest << geometry_set
## Fecha de Ultima modificacion:18/08/2008
## Autor de la modificacion: rraragon
## Descripcion de la modificacion: Metodo nuevo 

	loest << geometry_set.new()
	_if .oEstructura _is _unset _andif 
	    _self.elementos_bd_gis _isnt _unset _andif
	     _self.elementos_bd_gis.size > 0
	_then
		.oEstructura << _self.obtener_elementos_bd_gis().an_element()
	_endif
	
	LoStr << .oEstructura
	_if  (LoGeo << LoStr.structure_geometry()) _isnt _unset 
       _then
		       loest.add(LoGeo)
		       _if LoGeo.responds_to?(:coord) 
		       _then
			       locircle << circle.new(LoGeo.coord,6000)
			       loest.add(locircle)
		       _endif
	_endif

       # Agregar anotacion
	LoNombreGeo << _self.LoGeomTxt[LoStr.source_collection.name]
	_if LoNombreGeo _isnt _unset _andif
	    (LoGeo << LoStr.perform(LoNombreGeo)) _isnt _unset 
	_then
		loest.add(LoGeo)
	_endif

       # Agregar geometrias extras
	LoNombreGeo << _self.LoGeom[LoStr.source_collection.name]
	_if LoNombreGeo _isnt _unset _andif
	    (LoGeo << LoStr.perform(LoNombreGeo)) _isnt _unset 
	_then
		loest.add(LoGeo)
	_endif	
	
	_return loest
	
_endmethod
$
_pragma(classify_level=restricted)
_method c_vp_localizacion_tba.agregar_titulo(PoPage)
## Objetivo: Agregar el titulo del viewport
## Parametros de salida: Ninguno
## Regresa: Ninguno.
## Fecha de Ultima modificacion:20/08/2008
## Autor de la modificacion: rraragon
## Descripcion de la modificacion: Metodo nuevo 

    _local LoBounds << bounding_box.new(_self.bounds.xmin,
				  _self.bounds.ymin - 100,
				  _self.bounds.xmax,
				  _self.bounds.ymin )
				  
    LoTitulo << _self.titulo
    LoTitulo << c_titulo_de_plano.new_with(:bounds,           LoBounds,
					   :font_name,        "bold",
					   :font_size,        _self.tamanio,
					   :fill_style,       _unset,
					   :outline_style,    _unset,
					   :text,             LoTitulo,
					   :wrap,             _false,
					   :align_horizontal, :centre,
					   :align_vertical,   :centre,
					   :orientation,      :left_right)
    PoPage.add_element(LoTitulo)
	
_endmethod
$
_pragma(classify_level=restricted, usage={redefinable})
_method c_vp_localizacion_tba.defined_attributes()
##
_local LcollAtributos
	LcollAtributos << rope.new_from(_super.defined_attributes)	
	>> LcollAtributos
_endmethod
$
_pragma(classify_level=restricted)
_method c_vp_localizacion_tba.draw_content_on(windows)
## Objetivo: Ejecutar la super
## Parametros de salida: Ninguno
## Regresa: Ninguno.
## Fecha de Ultima modificacion:20/08/2008
## Autor de la modificacion: rraragon
## Descripcion de la modificacion: Metodo nuevo 

	_super.draw_content_on(windows)
	
_endmethod
$
_pragma(classify_level=restricted)
_method c_vp_localizacion_tba.geometry_set_for_render
	## Objetivo: Obtener la geometrias de la localizacion del TBA
	## Parametros de salida: Ninguno
	## Regresa: .oResulSet << composite_geometry_set
	## Fecha de Ultima modificacion:18/08/2008
	## Autor de la modificacion: rraragon
	## Descripcion de la modificacion: Metodo nuevo 
	
	_local LcollGeometrias  # Geometrias que deben dibujarse en el viewport.
	
        # Obtener los objetos correspondientes al plano.
        _dynamic !current_coordinate_system!
	!current_coordinate_system! << _unset
	
	LcollGeometrias << _super.geometry_set_for_render
	LoStyle << LcollGeometrias.sys!slot(:sets).an_element().style_system	
	loestructuras << _self.agregar_estructuras()
	loestructuras.style_system << LoStyle
	
	LoResultSet << LcollGeometrias.select(:collection,{:user!_eje_calle,
							   :user!_building,:boundary,
							   :building,:location,
							   :mit_terminal_enclosure,:location,
							   :user!_eje_calle,:user!_anotacion,
							   :user!_tba_anotacion,:user!_anotacion,
					                   :user!_manzana, :user!_limite})
	
	LoResultSet << composite_geometry_set.new_with( LoResultSet,loestructuras)
	
	_return  LoResultSet

_endmethod
$
_pragma(classify_level=restricted, usage={redefinable})
_method c_vp_localizacion_tba.init_with(properties)
## 
##
	_super.init_with(properties)

	>> _self 

_endmethod
$
_pragma(classify_level=restricted, usage={redefinable})
_method c_vp_localizacion_tba.initialise_for_page(a_layout_page)
## Objetivo: Agregar el ACE y grupo de estilos a self
## Parametros de entrada: a_layout_page << layout_page.
## Parametros de salida: Ninguno
## Regresa: Ninguno.
## Fecha de Ultima modificacion:18/08/2008
## Autor de la modificacion: rraragon
## Descripcion de la modificacion: Metodo nuevo 
	
	_self.ace_name << "CENT_PLANOS"
	_self.style_system_category << :plano
	_self.view_scale << 2500
	_self.display_style <<  "5 000 - 10 000"
	_self.agregar_titulo(a_layout_page)

_endmethod
$
_pragma(classify_level=restricted, usage={redefinable})
_method c_vp_localizacion_tba.new_with(PoEstructura, _gather args )
## Objetivo: Crear un viewport para lo localizacion del TBA
## Parametros de Entrada: args << argumentos para la super	
## Regresa: Ninguno.
## Fecha de Ultima modificacion:20/08/2008
## Autor de la modificacion: rraragon
## Descripcion de la modificacion: Metodo nuevo 

    .oEstructura << PoEstructura
    # ejecutar la super
    >> _super.new_with(property_list.new_from_gathered ( args ))
    
_endmethod
$
