def_slotted_exemplar(:c_vp_plano_construccion_interno,
		     {
			     {:ofloors, _unset,:writable,:public},
			     {:collLimTerminales,_unset,:writable,:public},
			     {:collLimDistritos,_unset,:writable,:public},
			     {:oRegTabs,_unset,:writable,:public}
			     
		     },:c_vp_cobre)
$

c_vp_plano_construccion_interno.define_shared_constant(:allowed_on_menu?,_false,:public)
$
c_vp_plano_construccion_interno.define_shared_variable(:lista_distritos,rope.new(),:public)
$
_pragma(classify_level=restricted, usage={redefinable})
_method c_vp_plano_construccion_interno.defined_attributes
	## Objetivo: Definir los atributos de la clase self.
	## Parametros de Entrada: Ninguno.
	## Parametros de Salida:  Ninguno.
	## Regresa: LcollAtributos.
	## Fechad de la ultima modificacion: 02/Mayo/2007
	## Autor de la modificacion: rbsaldan
	## Descripcion de la modificacion: Metodo Nuevo.
	
_local LcollAtributos
       LcollAtributos << rope.new_from(_super.defined_attributes)
       
       LcollAtributos.add(layout_attribute_definition.new(:nombre_edificio, :string,
							  :description, "Nombre del Edificio",
							  :default_value, "",
							  :allowed_on_properties_page?, _true,
							  :editor, _unset))
       
       LcollAtributos.add(layout_attribute_definition.new(:show_info_add, :string,
							  :description, "Muestra nombre del plano y nombre del distrito (en la esquina inferior derecha). ",
							  :default_value, "Si",
							  :allowed_on_properties_page?, _true,
							  :enum_method, :val_falso_verdadero,
							  :editor, _unset))
       
       LcollAtributos.add(layout_attribute_definition.new(:texto_adicional, :string,
							  :description, "Texto Adicional al nombre y tipo del edificio.",
							  :default_value, "",
							  :allowed_on_properties_page?, _true,
							  :editor, _unset))

#       LcollAtributos.add(layout_attribute_definition.new(:nombre_dto, :string,
#							  :description, "Nombre del Distrito",
#							  :default_value, "",
#							  :allowed_on_properties_page?, _false,
#							  :editor, _unset))
       
       LcollAtributos.add(layout_attribute_definition.new(:nombre_dto, :string,
							  :description, "Lista de Dtos Internos",
							  :default_value, "",
							  :allowed_on_properties_page?, _true,
							  :enum_method, :lista_dtos,
							  #:get_method,:get_dto,
							  :editor, _unset))
       
       LcollAtributos.add(layout_attribute_definition.new(:edo_const_dto, :string,
							  :description, "Edo. Construccion.",
							  :default_value, "",
							  :allowed_on_properties_page?, _false,
							  :editor, _unset))
       
       >> LcollAtributos
_endmethod
$
c_vp_plano_construccion_interno.define_attributes()
$
_pragma(classify_level=restricted, usage={redefinable})
_method c_vp_plano_construccion_interno.val_falso_verdadero
## Objetivo: Regresar un arreglo con los  valores "Si", "No"
## Parametros de Salida: Ninguno
## Regresa: LasSiNo
## Fecha de ultima modificacion: 18/Jun./2009
## Autor de la modificacion: rbsaldan
## Descripcion de la modificacion: Metodo nuevo.

_local LasSiNo    ##Arreglo con los valores "Si", "No"
	LasSiNo<<rope.new()

	## Agrega los valores "Si", "No"
	LasSiNo.add("Si")
	LasSiNo.add("No")

	>> LasSiNo
_endmethod
$
_pragma(classify_level=restricted, usage={redefinable})
_method c_vp_plano_construccion_interno.lista_dtos
## Objetivo: Regresar un arreglo con los  valores De los distritos.
## Parametros de Salida: Ninguno
## Regresa: LcollDtos
## Fecha de ultima modificacion: 18/Jun./2009
## Autor de la modificacion: rbsaldan
## Descripcion de la modificacion: Metodo nuevo.

_local LcollDtos    ##Arreglo con los nombres de los distritos.
	LcollDtos<<rope.new()

	_for LsNombreDto _over _self.lista_distritos.fast_elements()
	_loop
		LcollDtos.add(LsNombreDto)
	_endloop

	>> LcollDtos
	
_endmethod
$
_pragma(classify_level=restricted, usage={redefinable})
_method c_vp_plano_construccion_interno.get_dto
	## 
	## 
	write("c_vp_plano_construccion_interno.get_dto : ",_self.nombre_dto)
_local LcollTabDtos
_local LcollRes

       LcollTabDtos<<gis_program_manager.cached_dataset(:landbase).collections[:user!_distrito]
       LcollRes<<LcollTabDtos.select(predicate.eq(:user!_distrito,_self.nombre_dto))
       LoDto<<LcollRes.an_element()
  
       _return LoDto
_endmethod
$
_pragma(classify_level=restricted, usage={redefinable})
_method c_vp_plano_construccion_interno.attribute_changed(attribute_name,old_value,new_value )
	## 
	## 
#	write("c_vp_plano_construccion_interno.attribute_changed")
#	write("attribute_name = ",attribute_name)
#	write("old_value      = ",old_value)
#	write("new_value      = ",new_value)
_local LoDto

	_if attribute_name=:nombre_dto
	_then
		LoDto<<_self.get_dto
		_if LoDto _isnt _unset 
		_then
			LoApp<<smallworld_product.pni_application()
			LoAppManager<<LoApp.plugin(:application_manager)
			LoMapManager<<LoAppManager.map_manager
				
			_self.edo_const_dto<<LoDto.construction_status.write_string
			_if LoDto.user!_limite _isnt _unset
			_then
				# Fuera Del Edificio
				_self.centre<< _self.geometry_set_for_render.geom_bounds.centre
			_elif LoDto.user!_limite_edificio
			_then
				# Dentro del edificio.
				_self.centre<<LoDto.user!_limite_edificio.bounds.centre
			_endif
			
		_else
			_self.edo_const_dto<<""
		_endif
	_endif
_endmethod
$
