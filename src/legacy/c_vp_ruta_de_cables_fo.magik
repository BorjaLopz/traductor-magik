_method c_vp_ruta_de_cables_fo.val_falso_verdadero
	## Objetivo: Regresar un arreglo con los  valores "Si", "No"
	## Parametros de Salida: Ninguno
	_local LasSiNo    
	LasSiNo << rope.new()
	LasSiNo.add("Si")
	LasSiNo.add("No")
	
