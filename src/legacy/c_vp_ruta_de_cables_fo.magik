_pragma(classify_level=restricted)
_method c_vp_ruta_de_cables_fo.geometry_set_for_render
	## Objetivo: Obtener la geometrias de los elementos de al ruta
	## Parametros de salida: Ninguno
        # Obtener los objetos correspondientes al plano.
	
        _dynamic !current_coordinate_system!
	!current_coordinate_system! << _unset
	
	_local LcollGeometrias  << _unset 

	_if .oResulSet _is _unset 
	_then
		.oBuffer << .oBuffer.buffer(_self.tamanio_buffer)
	_endif 
	
	_if _self.fijar_configuracion _isnt _unset  _andif
	    _self.fijar_configuracion = "Si"  _andif
	    .oResulSet _isnt _unset 
	_then
		.oResulSet.remove_invalid_elements()
		_return .oResulSet
	_endif   

	LcollGeometrias <<_super.geometry_set_for_render
	
	_if LcollGeometrias  _isnt _unset _andif
	    LcollGeometrias.size > 0 
	_then
		new_viewportGeo <<  _self.rotated_world_bounds
		NuevoBuffer     << .oBuffer.intersection( new_viewportGeo )
		LcollResulSet   <<  LcollGeometrias.select(:interacting_with, NuevoBuffer)

		.oResulSet << _self.geometry_set_for_bufferGeo(LcollResulSet,NuevoBuffer)

		_if _self.layout_page.layout_document.short_filename _is _unset 
		_then
			LoGuarda << c_guarda_objetos_vp.new()
			LoGuarda.oResulSet << .oResulSet
			elementos << LoGuarda.genera_lista_gsfr()
			_for ky,ele _over elementos.keys_and_elements()
			_loop
				_self.guardar_visualizacion(ele,  ky)		
			_endloop
		_endif
	_endif

	## se fija solo para plano de ruta
	_self.fijar_configuracion << "Si"
	
	>> .oResulSet

_endmethod
$
_method c_vp_ruta_de_cables_fo.geometry_set_for_bufferGeo(LcollGeometrias,PoBuffer)
	## Objetivo: Obtener la geometrias de los elementos de la ruta
	## dentro del buffer

        _local LcollResulSet<<LcollGeometrias
	
	_if LcollResulSet.bounds _isnt _unset 
	_then
		LoResulSet << _self.filtra_objetos(LcollResulSet)
	_else
		condition.raise(:user_error, :string, "No se encuentra en la vista principal...")
	_endif
	
	>> LoResulSet 
	
_endmethod
$
_pragma(classify_level=restricted)
_method c_vp_ruta_de_cables_fo.filtra_objetos(LcollResulSet)
	## Objetivo: Metodo para filtrar los objetos necesarios para la
	## ruta de cables de un enlace o tba
	_local paf                << smallworld_product.pni_application()
	_local gen_planos         << paf.plugin(:gen_planos)
	_local cables_fo          << gen_planos.o_ruta_sigp[:sheath]
	_local Lostructure_annotation << equality_geometry_set.new()
	_local LoLayoutPlugin     << paf.plugin(:layout_plugin)
	_local LoLayoutDesigner   << LoLayoutPlugin.dialogs[:layout_designer]
	_local LoLayoutManager    << LoLayoutDesigner.plugin(:layout_manager)
	_local LcollGeometriasall <<_super.geometry_set_for_render
	_local LoEst              << LcollResulSet. sys!slot(:sets).an_element().style_system
	_local LnIndex            << 10
	_local top_frame          << LoLayoutManager.top_frame
	
	_local lotitulo << "Obteniendo información del plano"
	_local lolabel << "Agregando elementos del plano"
	_local loinfo  << "Agregando información al  Plano de Ruta"

	LoLayoutManager.busy?  << _true
			
	.barra << progress_indicator_dialog.new(lotitulo,
						:info_string, lolabel,
						:bar_label, loinfo,
						:image, {:merge_post,:admin_proyectos} )

	.barra.max_count << 100
	.barra.interrupt_message <<  "Interrumpir"

	.barra.activate_relative_to(_unset , top_frame,
				    (top_frame.width /3).rounded ,
				    (top_frame.height/3).rounded )

	
	LoResultSet << LcollResulSet.select(:collection, { :user!_manzana,
							   :ferrocarril,
							   :puente,
							   :sheath_annotation,
							   :vias_comunicacion,
							   :cuerpos_agua,
							   :rio,
							   :infraestructura,
							   :user!_radio_base,
							   :building,
							   :user!_building,
							   :user!_eje_calle})

	.barra.progress_changed(20, _true )
	.barra.redraw_bar()

	#llaves del cable
	# (26/02/26 des_bibiano) :  
	_if cables_fo _isnt _unset _andif
	    cables_fo.size > 0 
	_then
		_for iterc _over cables_fo.fast_elements()
		_loop
			_if iterc.structure_annotations.size > 0 
			_then
				_for itera _over iterc.structure_annotations.fast_elements()
				_loop
					_if itera.user!_linea _isnt _unset 
					_then
						Lostructure_annotation.add(itera.user!_linea)	 
					_endif
					_if itera.user!_anotacion _isnt _unset 
					_then
						Lostructure_annotation.add(itera.user!_anotacion)
					_endif
				_endloop
				
			_endif
		_endloop
	
		
	_endif
	
	loCanalizacion << _self.agregar_canalizacion()
	
	.barra.progress_changed(40, _true )
	.barra.redraw_bar()
	
	loEstructuras  << _self.agregar_estructuras()
	
	.barra.progress_changed(60, _true )
	.barra.redraw_bar()
	
	loElementos      << _self.agregar_elementos()		
	canalizaciones   << loCanalizacion.rwo_set()
	LoResulPerfiles  << _self.agregar_perfiles(canalizaciones)
	
	.barra.progress_changed(80, _true )
	.barra.redraw_bar()

	LoResultSet << composite_geometry_set.new_with(LoResulPerfiles,loCanalizacion, LoResultSet,
						       loEstructuras,loElementos,Lostructure_annotation )
	
	LoResultSet.style_system <<  LoEst
	
	.barra.progress_changed(100, _true )
	.barra.redraw_bar()
	.barra.quit()
	
	LoLayoutManager.busy?  << _false 

	>> LoResultSet
	
_endmethod
$
_pragma(classify_level=restricted)
_method c_vp_ruta_de_cables_fo.geometry_set_for_buffer(LcollGeometrias)
	## Objetivo: Obtener la geometrias de los elementos de la ruta
	## dentro del buffer
	
	_local LcollResulSet
	
        LcollResulSet << LcollGeometrias

	# Si esta definida el area de la ruta o enlace entonces ingnorar los
	# elementos que estan fuera del area.
	
	_if .oBuffer _isnt _unset 
	_then
		NuevoBuffer << .oBuffer
		
		_if _self.tamanio_buffer _isnt _unset 
		_then
			# planos guardados o generados con valor en atributo tamanio_buffer
			_if _self.tamanio_buffer > _self.longitud_default
			_then
				LcollResulSet << LcollResulSet.select(:within, NuevoBuffer)
			_else			
				LcollResulSet << LcollResulSet.select(:overlaying, NuevoBuffer)
			_endif
		_else
			# planos guardados sin valor en atributo tamanio_buffer
			LcollResulSet << LcollResulSet.select(:overlaying, NuevoBuffer)
		_endif		
		
	_else
		LcollResulSet << LcollGeometrias
	_endif
	
	_if LcollResulSet.bounds _isnt _unset 
	_then
		# Filtrar elementos que pertenecen a la ruta o enlace
		
		LoResulSet << _self.filtra_objetos(LcollResulSet) #,LcollGeometrias)
	_else
		condition.raise(:user_error, :string, "No se encuentra en la vista principal...")
	_endif

	>> LoResulSet 
	
_endmethod
$

_pragma(classify_level=restricted, usage={redefinable})
_method c_vp_ruta_de_cables_fo.guardar_elementos_bd_gis(p_elementos)
	## 
	##
	_local 	l_elementos_bd << property_list.new()
	_for k,els _over p_elementos.keys_and_elements()
	_loop
		l_elementos_bd[k] << rope.new()
		_for obj _over els.fast_elements()
		_loop
			_if obj _isnt _unset 
			_then
				l_collection << obj.source_collection.name
				l_id << obj.id
				l_ele << property_list.new()
				l_ele[l_collection] << l_id
				l_elementos_bd[k].add(l_ele)				
			_endif
			
		_endloop
	_endloop

	# agregar los sectors del buffer
	l_elementos_bd[:sectors_buffer] << .obuffer.sectors
	
	_self.elementos_bd_gis << l_elementos_bd
	
_endmethod
$
_pragma(classify_level=restricted, usage={redefinable})
_method c_vp_ruta_de_cables_fo.guardar_visualizacion(elementos, llave)
	## fhramire 
	## Funcionalidad para mover simbolos en el plano
	_if _self.elementos_modificados _is _unset 
	_then
	    ## elementos en este caso es ya un property_list
	    datos << property_list.new()
	    datos[llave] << elementos
	    _self.elementos_modificados << datos

	_else
	    ## elementos en este caso es un rope con los datos.
	    ## y solo lo agregamos, con la llave = "llave" 
	    _self.elementos_modificados[llave] << elementos
	_endif
	
	
_endmethod
$
_pragma(classify_level=restricted, usage={redefinable})
_method c_vp_ruta_de_cables_fo.new_with(PoBuffer,PoEstructuras, PoCanalizacion,PoElementos, _gather args )
	## Objetivo: Crear un viewport para los planos de ruta	
	## Parametros de Entrada: PoBuffer << buffer de la ruta
	##                       PoEstructuras << estructuras de la ruta
	##                       PoCanalizacion << canalizacion de la ruta
	##                       PoElementos << elementos de red de la ruta
	##                       args << argumentos para la super	
	## Regresa: Ninguno.
	## Fecha de Ultima modificacion:18/08/2008
	## Autor de la modificacion: rraragon
	## Descripcion de la modificacion: Metodo nuevo 
	
	# Asignar los valores al viewport
	.oBuffer       << PoBuffer
	.oEstructuras  << poEstructuras
	.oCanalizacion << PoCanalizacion
	.oElementos    << PoElementos
	
	# ejecutar la super
	>> _super.new_with(property_list.new_from_gathered ( args ))
	
_endmethod
$
_pragma(classify_level=restricted, usage={redefinable})
_method c_vp_ruta_de_cables_fo.obtener_elementos_bd_gis()
	## 
	##
	_local l_dataset << mit_manager.modelit_dataset
	_local l_elementos_bd << property_list.new()
	
	_if _self.elementos_bd_gis _isnt _unset _andif _self.elementos_bd_gis.size > 0
	_then
		_for k,els _over _self.elementos_bd_gis.keys_and_elements()
		_loop
			_if k _isnt  :sectors_buffer 
			_then
				# elementos de la BD
				l_elementos_bd[k] << rope.new()
				_for an_obj _over els.elements()
				_loop
					_for a_key,ele _over an_obj.keys_and_elements()
					_loop
						_if (l_dato << l_dataset.collection(a_key).at(ele)) _isnt _unset 
						_then
							l_elementos_bd[k].add_last(l_dato)
						_endif
					_endloop
				_endloop
			_endif
		_endloop		
	_endif
	
	_return l_elementos_bd
	
_endmethod
$
_pragma(classify_level=restricted)
_method c_vp_ruta_de_cables_fo.pinta_circulos_estructuras(windows)
	## 
	##	
	
	_dynamic !current_coordinate_system!
	!current_coordinate_system! << _unset
	_if .oCanalizacion _isnt _unset _andif _self.transform _isnt _unset 
	_then	
		_for poz _over .oCanalizacion.elements()
		_loop		
			_if poz.annotation_1 _isnt _unset 
			_then			    
				mi_coord<<coordinate.new_from(poz.annotation_1.coord)		 
		    LCoord << mi_coord.transformed(_self.transform)		 
		    
		    est_line1 << line_style.new_with_properties(
					 :foreground_colour, colour.called(:black), :width, 6)
		    
		    LCo1 << coordinate.new(LCoord.x, LCoord.y)
		    LoCirculo << circle.new(LCo1, 300)
		    LoCirculo.draw_on(windows,est_line1)
			_endif
		_endloop
	_endif
	
_endmethod
$

_pragma(classify_level=restricted)
_method c_vp_ruta_de_cables_fo.ubica_elemento(Punto)
	## 
	##
	windows << .oWindows
	_self.draw_content_on(windows, Punto)
	
	
_endmethod
