_pragma(classify_level=restricted, usage={redefinable})
_method c_vp_ruta_de_cables_fo.initialise_for_page(a_layout_page)
	## Objetivo: Agregar el ACE y grupo de estilos a self
	## Parametros de entrada: a_layout_page << layout_page.
	## Parametros de salida: Ninguno
	## Regresa: Ninguno.
	## Fecha de Ultima modificacion:18/08/2008
	## Autor de la modificacion: rraragon
	## Descripcion de la modificacion: Metodo nuevo 
	
	# (2012-07-19 AHERNAN, HILDEBRANDO) :  se actualiza la
	# inicializacion al ace de planos.
	
	_self.ace_name << "002 - P Ruta FTTH"
	_self.style_system_category << :|P Ruta FTTH|
	_self.display_style << "2 250 - 3 000"
	elementos << property_list.new()
	elementos[:oEstructuras] << .oEstructuras
	elementos[:oCanalizacion] << .oCanalizacion
	elementos[:oElementos] << .oElementos
	_self.guardar_elementos_bd_gis(elementos)
	
_endmethod
$
_pragma(classify_level=restricted, usage={redefinable})
_method c_vp_ruta_de_cables_fo.post_initialisation()
## Objetivo: Ejecutar la super, obtener los sectores para
## volver a generar el buffer del viewport
##
	_super.post_initialisation()
	
	_if .obuffer _is _unset 
	_then
		_if  _self.elementos_bd_gis _isnt _unset 
		_then
			l_sectors << _self.elementos_bd_gis[:sectors_buffer]			
		_endif
		
		_if l_sectors _isnt _unset 
		_then
			# viene de xml inicializar .oBuffer
			.obuffer << pseudo_area.new_with_sectors(l_sectors)			
		_elif _self.data_vp_copy _isnt _unset
		_then
			# viene de un copiado, inicializar self con data_vp_copy
			datos << _self.data_vp_copy
			_self.elementos_bd_gis << datos[:elementos_bd_gis]
			_self.elementos_bd_lb << datos[:elementos_bd_lb]
			_self.elementos_modificados << datos[:elementos_modificados]
			_self.geoms_symbols_size << _self.geoms_symbols_init()
			l_sectors << _self.elementos_bd_gis[:sectors_buffer]
			
			.oCanalizacion << _self.obtener_elementos_bd_gis()[:oCanalizacion]
			.oEstructuras  << _self.obtener_elementos_bd_gis()[:oEstructuras]
			.oElementos    << _self.obtener_elementos_bd_gis()[:oElementos]
			.obuffer       << pseudo_area.new_with_sectors(l_sectors)
		_endif
	_endif
	
_endmethod
