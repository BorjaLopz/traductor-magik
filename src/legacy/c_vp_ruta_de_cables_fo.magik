_pragma(classify_level=basic, topic={plotting}, usage={subclassable})
_method c_vp_ruta_de_cables_fo.defined_attributes
	## 
	## 

	attribs << rope.new_from ( _super.defined_attributes )

	attribs.add ( layout_attribute_definition.new ( :tamanio_buffer, :integer,
							:description, "Tamanio buffer",
							:default_value, 10000,
							:allowed_on_properties_page?, _false ) )	


	attribs.add ( layout_attribute_definition.new(:fijar_configuracion,         :string,
						      :description,                 "fijar configuraci�n",
						      :default_value,               "No",
						      :allowed_on_properties_page?, _true,
						      :enum_method,                 :val_falso_verdadero,
						      :editor,                      _unset))

	attribs.add ( layout_attribute_definition.new(:redibujar,                   :string,
						      :description,                 "redibujar",
						      :default_value,               "Si",
						      :allowed_on_properties_page?, _true,
						      :enum_method,                 :val_falso_verdadero,
						      :editor,                      _unset))
	
		
	>> attribs
	
_endmethod
