_pragma(classify_level=restricted)
_method c_vp_ruta_de_cables_fo.acomodar_elementos(pElementos)
## Obejtivo: Acomodar los elementos de acuerdo a su eje Y, si
## es un empalme se acomoda hacia arriba, si es una gasa se
## acomoda hacia abajo.	
## Autor: rraragon
## Fecha: 05/08/2010
	
_local 	l_id << pElementos[1]
_local 	l_objs << pElementos[2]
_local 	l_rango_empalme << 1950 # empalmes se acomodan en el eje Y posotivo
_local 	l_rango_gasa << -1600   # gasas se acomodan en el eje Y negativo
_local 	l_y_gasa << l_y_empalme << 0

    _for an_obj _over l_objs.elements()
    _loop
	    _if an_obj.source_collection.name _is :splice_closure
	    _then
		    _if l_y_empalme = 0
		    _then
			    l_y_empalme << 1.0
		    _else
			    l_y_empalme +<< l_rango_empalme
		    _endif
		    _self.asignar_valores_mov(:splice_closure_sim,an_obj.id,1.0,1.0,l_y_empalme)
	    _endif
	    _if an_obj.source_collection.name _is :figure_eight
	    _then
		    _if l_y_gasa = 0
		    _then
			    l_y_gasa << 1.0
		    _else
			    l_y_gasa +<< l_rango_gasa
		    _endif			
		    _self.asignar_valores_mov(:figure_eight_sim,an_obj.id,1.0,1.0,l_y_gasa)
	    _endif
    _endloop
    
_endmethod
$
_pragma(classify_level=restricted)
_method c_vp_ruta_de_cables_fo.agregar_canalizacion()
	## Objetivo: Crear un geometry_set con los objetos canalizacion
	## de una ruta o enlace
	## Parametros de entrada: Ninguno.
	## Parametros de salida: Ninguno
	## Regresa: loCanalizacion << geometry_set
	## Fecha de Ultima modificacion:18/08/2008
	## Autor de la modificacion: rraragon
	## Descripcion de la modificacion: Metodo nuevo 
	
	loCanalizacion << geometry_set.new()
	
	_if _self.elementos_bd_gis _isnt _unset _andif
	    _self.elementos_bd_gis.size > 0
	_then
		.oCanalizacion << _self.obtener_elementos_bd_gis()[:oCanalizacion]
	_endif
	
	_for ugr _over .oCanalizacion.fast_elements()
	_loop
		# Agregar route
		_if (LoGeo << ugr.structure_geometry()) _isnt _unset 
		_then	
			loCanalizacion.add(LoGeo)
			## Fhramire
			## Se agrega la geometria de apuntador
			## para cuando exista perfil de canalizacion
			## Pruebas Sitio las Armas
			_if ugr.leader _isnt _unset 
			_then
			    loCanalizacion.add(ugr.leader)	
			_endif

			# (12/09/19 ahernanram) : 
			#_for k _over ugr.mit_structure.mit_presentation_objects.fast_elements()
			#_loop
			#	loCanalizacion.add(k.boundary)				
			#_endloop
						
		_endif
		
		LoNombresGeo << _self.LoGeomTxt[ugr.source_collection.name]  
		
		_if LoNombresGeo _isnt _unset 
		_then
			_for k  _over LoNombresGeo.elements()
			_loop
                                LoGeo << ugr.perform(k.as_symbol() )						     
				_if LoGeo  _isnt _unset 
				_then
					loCanalizacion.add(LoGeo)
				_endif
				
			_endloop
			
		_endif		
		#
		# FIN DEL CAMBIO			
	_endloop
	
	_return loCanalizacion	
	
_endmethod
$
_pragma(classify_level=restricted)
_method c_vp_ruta_de_cables_fo.agregar_elementos()
	## Objetivo: Crear un geometry_set con los objetos de los
	## elementos de una ruta o enlace
	## Parametros de entrada: Ninguno.
	## Parametros de salida: Ninguno
	## Regresa: loCanalizacion << geometry_set
	## Fecha de Ultima modificacion:18/08/2008
	## Autor de la modificacion: rraragon
	## Descripcion de la modificacion: Metodo nuevo 
	
	loElementos << geometry_set.new()
	_if _self.elementos_bd_gis _isnt _unset _andif
	    _self.elementos_bd_gis.size > 0
	_then
		.oElementos << _self.obtener_elementos_bd_gis()[:oElementos]
	_endif
	_for el _over .oElementos.fast_elements()
	_loop
	       LoNomsGeo << _self.LoGeom[el.source_collection.name]

	       _if LoNomsGeo _isnt _unset
	       _then		       
		       _for k  _over LoNomsGeo.elements() 
		       _loop
			       
			       geo << el.perform(k)
			       
			       _if  geo _isnt _unset 
			       _then
				       loElementos.add(geo)
			       _endif			       
		       _endloop
		       
	       _endif
	       
	       # (2012-05-23 AHERNAN, HILDEBRANDO) : ahora regresara un rope
	       # de varias anotaciones.
	       
	       LoNomsGeoTxt << _self.LoGeomTxt[el.source_collection.name]

	       # (2012-05-23 AHERNAN, HILDEBRANDO) : se recorre el rope para
	       # recuperar los nombres de las anotaciones.
	       _if LoNomsGeoTxt _isnt _unset
	       _then		       
		       _for k  _over LoNomsGeoTxt.elements() 
		       _loop
			       geo << el.perform(k)
			       
			       _if  geo _isnt _unset 
			       _then
				       loElementos.add(geo)
			       _endif			       
		       _endloop
		       
	       _endif
		
	    #
	    # FIN DEL CAMBIO
	       
	_endloop

	_return loElementos
	
_endmethod
$

_pragma(classify_level=restricted)
_method c_vp_ruta_de_cables_fo.agregar_estructuras()
	## Objetivo: Crear un geometry_set con los objetos de las
	## estructuras de una ruta o enlace
	## Parametros de entrada: Ninguno.
	## Parametros de salida: Ninguno
	## Regresa: loCanalizacion << geometry_set
	## Fecha de Ultima modificacion:18/08/2008
	## Autor de la modificacion: rraragon
	## Descripcion de la modificacion: Metodo nuevo 
	
	loEstructuras << geometry_set.new()
	_if _self.elementos_bd_gis _isnt _unset _andif
	    _self.elementos_bd_gis.size > 0
	_then
		.oEstructuras << _self.obtener_elementos_bd_gis()[:oEstructuras]
	_endif
	
	_for estru _over .oEstructuras.fast_elements()
       _loop
	       _if _not estru.is_kind_of?(access_point)
	       _then
		       # (10/07/19 jtlelo) :  agregamos los campos geometricos del crucero
		       # (11/03/16 bflores) : se valida la existencia de las geometrias.
		       _if estru.is_kind_of?(user!_crucero) _orif
			   estru.is_kind_of?(anchor)
		       _then
			       geoms << _self.geometrias_visibles_obj(estru,:chain)
			       geoms.add_all_last(_self.geometrias_visibles_obj(estru,:text))
			       _for a_geom _over geoms.elements()
			       _loop
				       loEstructuras.add(a_geom)
			       _endloop
		       _else 
			       loEstructuras.add(estru.structure_geometry())
		       _endif
		       
		       #LoNomGeo << _self.LoGeomTxt[estru.source_collection.name]
                        LoNomsGeo << _self.LoGeomTxt[estru.source_collection.name]

			_if LoNomsGeo _isnt _unset 
			_then

                              _for k  _over LoNomsGeo.elements()
			      _loop
				      _if (geo << estru.perform(k)) _isnt _unset 
				      _then
					      loEstructuras.add(geo)
				      _endif 			       				      
			      _endloop
			      				
			_endif
		       

	       _endif 
       _endloop
       
       _return loEstructuras
	
_endmethod
$
_pragma(classify_level=restricted)
_method c_vp_ruta_de_cables_fo.agregar_perfiles(PoCanalizaciones)
		## 
	## 
	loPerfilesCanal << geometry_set.new()
	
	_for loCanal _over PoCanalizaciones.elements()
	_loop		
		_if locanal.rwo_type _is :underground_route _andif
		    loCanal.mit_structure_route _isnt _unset _andif
		    loCanal.mit_structure_route.mit_presentation_objects.size > 0
		_then			
			_for loMitPresentationObject _over loCanal.mit_structure_route.mit_presentation_objects.elements()
			_loop
				
			     _if loMitPresentationObject.tierra _isnt _unset 
			     _then
				 loPerfilesCanal.add(loMitPresentationObject.tierra)
			     _endif
			     _if loMitPresentationObject.boundary _isnt _unset 
			     _then
				   loPerfilesCanal.add(loMitPresentationObject.boundary)
			     _endif
			     _if loMitPresentationObject.source_boundary _isnt _unset 
			     _then
				   loPerfilesCanal.add(loMitPresentationObject.source_boundary)
			     _endif
			     _if loMitPresentationObject.source_boundary_mapeo _isnt _unset 
			     _then
				     loPerfilesCanal.add(loMitPresentationObject.source_boundary_mapeo) 
			     _endif

			     # START CHANGE
			     # (25/03/26 des_aaron) : se agregan las anotaciones y apuntadores de los
			     # ductos X
			     #
			     loPerfilesCanal.add_all( loMitPresentationObject.obtiene_sheath_annotations)
			     #
			     # END CHANGE			     
			_endloop			
		_endif
	_endloop
	
	_return loPerfilesCanal 
	
_endmethod
$

_pragma(classify_level=restricted)
_method c_vp_ruta_de_cables_fo.asignar_valores_mov(pTipo,pId,pRot,pX,pY)
## Objetivo: Asignar valores al property_list
## elementos_modificados, dependiendo de pTipo y pId
## Autor: rraragon
## Fecha: 05/08/2010
	
    _for a_key,an_ele _over _self.elementos_modificados.keys_and_elements()
    _loop
	    _if a_key _is pTipo
	    _then
		    _for el _over an_ele.elements()
		    _loop
			    _if el[2] = pId
			    _then
				    el[3] << pRot
				    el[4] << pX					
				    el[5] << pY
			    _endif
		    _endloop
	    _endif
    _endloop
	
_endmethod
$
_pragma(classify_level=restricted)
_method c_vp_ruta_de_cables_fo.gasas_empalmes()
	## Objetivo: Agrupar todos los empalmes y gasas de acuerdo a su
	## estructura que los contiene.
	## Regresa: rope
	## Autor: rraragon
	
	_local l_dataset << mit_manager.modelit_dataset
	_local l_elementos << rope.new()
	_local l_structuras << rope.new()
	
	l_elementos.add_all_last(_self.elementos_modificados[:figure_eight_sim].default(rope.new()))
	l_elementos.add_all_last(_self.elementos_modificados[:splice_closure_sim].default(rope.new()))
	
	_for an_ele _over l_elementos.fast_elements()
	_loop	    
		l_coll << l_dataset.collection(an_ele[1]) # obtener la colleccion que contiene al objeto
       _if (obj << l_coll.at(an_ele[2])) _isnt _unset # obtener el objeto
       _then
	       _if obj.responds_to?(:get_structure|()|) _andif (l_str << obj.get_structure()) _isnt _unset 
	       _then
		       # encontrar la estrucura si existe dentro de la lista de estructuras
		       l_struct << _unset  # indica si se encontro la estructura
		       l_id_str << l_str.id # estructura a buscar
		       _for a_structure _over l_structuras.elements()
		       _loop
			       _if a_structure[1].id = l_id_str
			       _then
				       l_struct << a_structure
				       _leave 
			       _endif					 
		     _endloop
		       
		       _if l_struct _is _unset 
		       _then
			       # no existe esta estructura en el rope se agrega
			       l_structuras.add_last(rope.new_with(l_str,rope.new_with(obj)))
		       _else
			       # ya existe la estructura solo agregamos el objeto
			       l_struct[2].add_last(obj)
		     _endif				    
	       _endif
       _endif
	_endloop
	
	_return l_structuras   
	
	
_endmethod
$

_pragma(classify_level=restricted)
_method c_vp_ruta_de_cables_fo.crea_circulo_ubicacion(Punto, windows)
	## 
	##

	_dynamic !current_coordinate_system!
	!current_coordinate_system! << _unset	

	est_line1 << line_style.new_with_properties(
			     :foreground_colour, colour.called(:blue), :width, 1)

	LCoord << Punto.transformed(_self.transform)

	LCo1 << coordinate.new(LCoord.x, LCoord.y)
	LoCirculo << circle.new(LCo1, 300)
	LoCirculo.draw_on(windows,est_line1)
	
	
_endmethod
$
_pragma(classify_level=restricted)
_method c_vp_ruta_de_cables_fo.geometrias_visibles_obj(a_obj,a_type)
	## 
	##
	geoms << rope.new()
	_if a_obj.responds_to?(:location) _andif (a_geom << a_obj.location) _isnt _unset 
	_then
		geoms.add(a_geom)
	_endif
	
	_for a_campo_geom _over a_obj.geometry_fields_of_type(a_type).elements()
	_loop
		_if (a_geom << a_obj.perform(a_campo_geom.name)) _isnt _unset 
		_then
			geoms.add(a_geom)
		_endif
	_endloop
	
	_return geoms 
	
_endmethod
$
_pragma(classify_level=restricted, usage={redefinable})
_method c_vp_ruta_de_cables_fo.escribe_titulo_de_viewport(Window)
	#---------------------------------------------------
	## <Req. #> : Escribir pie de viewport "Ruta de cables"
	##
	_local LoSize            << 210 
	_local fontSize          <<  10
	_local justificaciontxt  << :bottom_centre	
	_local LoFontBold        << font.new_with_properties(:type,:logical,:name,"Arial" ,:point_size,LoSize ,:orientation,:left_right)
	_local LoTextStyle       << text_style.new_with_properties(:colour,colour.called(:black),:font,LoFontBold,  :underline?, _true)
	
	_if _self.name _isnt _unset  _andif
	    _self.name.write_string <> "mapa"
	_then
		LoTitulo << _self.name.uppercase	
		LoTitulo << LoTitulo.split_by(%newline)
		
		Lodesplazamiento << 120

		LoCoordY <<   _self.bounds.ymin
		
		_for k  _over LoTitulo.elements()
		_loop
			LoCoordY << LoCoordY - Lodesplazamiento
			
			LoCoordX << _self.bounds.centre.x
			
			Window.draw_vtext_transform(LoTextStyle, LoCoordX,LoCoordY ,k, _unset, _unset, FontSize,0,justificaciontxt, _true  , _false   )
			
		_endloop
		
	_endif
		
_endmethod
$
