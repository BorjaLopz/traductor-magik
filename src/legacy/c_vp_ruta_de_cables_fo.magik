_pragma(classify_level=restricted)
_method c_vp_ruta_de_cables_fo.draw_content_on(windows, _optional Punto )


	_if _self.redibujar _isnt _unset  _andif
	    _self.redibujar = "No"  _andif
	    .oResulSet _isnt _unset 
	_then
		_return 
	_endif  
	
	.oWindows << windows

	_try
		
	_super.draw_content_on(windows)
	
	_when  error 
	      
	_endtry

	_if .barra _isnt _unset 
	_then
		.barra.close()	
	_endif
	
	_if Punto _isnt _unset 
	_then
	    _self.crea_circulo_ubicacion(Punto, .oWindows)	    
	_endif


	_self.escribe_titulo_de_viewport(windows)
	
_endmethod
