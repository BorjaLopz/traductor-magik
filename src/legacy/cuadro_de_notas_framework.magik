_pragma(classify_level=restricted, topic={default_class})
_method cuadro_de_notas_framework.insertar_cuadro_de_notas(_gather args)
	##
	##  Crea la instancia y le envia .info_tablas lleno que es
	## quien contiene las caracteristicas del sello

	LoPage << _self.obtiene_pagina()
	LoSello << c_sello_cuadro_de_notas.new_with(:bounds,bounding_box.new(600,5800,1100,4700 ))
	RoCoord << coordinate.new(0,0)
	LoSello.sys!slot(:info_tablas) << .info_tablas
	LoSello.prvCrea_Tablas(RoCoord )
	LoPage.add_element(LoSello)
 	
_endmethod
$
_pragma(classify_level=restricted, topic={default_class})
_method cuadro_de_notas_framework.obtiene_pagina()
	##
	## Obtiene la pagina actual

	LoLayoutPlugin    << smallworld_product.pni_application().plugin(:layout_plugin)
	LoLayoutDesigner  << LoLayoutPlugin.start_layout_designer()
	LoLayoutManager   << LoLayoutDesigner.plugin(:layout_manager)
	LoViewMapperPlugin<<LoLayoutDesigner.plugin(:viewport_mapper)
	LoDoc  << LoLayoutManager.current_document
	LoPage << LoLayoutManager.current_page
	
	_return Lopage
	
_endmethod
$
_pragma(classify_level=restricted, topic={default_class})
_method cuadro_de_notas_framework.lista_de_tablas
	## 
	## Llena la lista de tablas dependiendo de las tablas que se
	## han definido para el sello
	
	.items[:tabla].items << _unset
	.items[:tabla_x].items << _unset
	LoTablaTablas << .items[:numero_de_tablas].value.as_integer()
	LoListaTablas << rope.new_for(LoTablaTablas)
	.items[:tabla].add_item({_unset,""})
	.items[:tabla_x].add_item({_unset,""})
	_for tabla _over range(1,LoTablaTablas)
	_loop
		LoListaTablas << simple_vector.new_with(tabla,"Tabla: " + tabla.write_string)
		.items[:tabla].add_item(LoListaTablas)
		.items[:tabla_x].add_item(LoListaTablas)
	_endloop
	
_endmethod
$
_pragma(classify_level=restricted, topic={default_class})
_method cuadro_de_notas_framework.lista_de_celdas
	## 
	## Llena la lista de celdas dependiendo de la tabla seleccionada.
	
	.items[:celda].items << _unset
	_for n_tabla _over range(1,.items[:numero_de_tablas].value.as_integer())
	_loop
		nom_tabla << "tabla"+n_tabla.write_string
		_if n_tabla = .items[:tabla_x].value
		_then
			LoColumnas << .info_tablas[:tablas][nom_tabla.as_symbol()][:columnas].as_integer()
			LoRenglones << .info_tablas[:tablas][nom_tabla.as_symbol()][:renglones].as_integer()
			TotalCeldas << LoColumnas*LoRenglones
			LoCeldas << rope.new_for(TotalCeldas)
			.items[:celda].add_item({_unset,""})
			_for renglon _over range(1,LoRenglones)
			_loop
				_for columna _over range(1,LoColumnas)
				_loop
					celda << renglon.write_string+","+columna.write_string
					LoCeldas << simple_vector.new_with(celda,"Celda: "+renglon.write_string+","+columna.write_string)
					.items[:celda].add_item(LoCeldas)
				_endloop
				
			_endloop
		_endif
	_endloop
	

	
_endmethod
$
_pragma(classify_level=restricted, topic={default_class})
_method cuadro_de_notas_framework.estilo_font()
	##
	## Regresa la lista de fuentes que hay en el sistema

	i << 1
	c << font.known_scalable_fonts( !window_system!.font_device )
	LoListaEstilos << rope.new()
	_for fn _over c.fast_elements()
	_loop
		LoListaEstilos.add({i, fn } )
		i +<< 1
	_endloop

	_return LoListaEstilos
	
_endmethod
$
_pragma(classify_level=restricted, topic={default_class})
_method cuadro_de_notas_framework.guardar()
	## 
	## Almacena en .info_tablas toda la informacion necesaria para
	## la generacion de cada una de las tablas del sello, asi como
	## la configuracion de sus celdas.
	
	_if _self.getOpcionSeleccionada _is :configura_sello
	_then
		.info_tablas << property_list.new_with(:ancho,.items[:ancho].value.as_integer(),
						       :alto,.items[:alto].value.as_integer(),
						       :numero_de_tablas,.items[:numero_de_tablas].value.as_integer(),
						       :titulo,.items[:titulo].value,
						       :tablas,property_list.new())
		_for n_tabla _over range(1,.info_tablas[:numero_de_tablas])
		_loop
			nom_tabla << "tabla"+n_tabla.write_string
			.info_tablas[:tablas][nom_tabla.as_symbol()]<<property_list.new_with(:color,_unset ,
											     :renglones,1,
											     :t_reng,1,
											     :columnas,1,
											     :t_col,1,
											     :celdas, property_list.new())
		_endloop
		
	_elif .info_tablas _isnt _unset _andif
	      _self.getOpcionSeleccionada _is :configura_tabla _andif 
	      (NumTabla<<.items[:tabla].value) _isnt _unset 
	_then
		llave << "tabla"+NumTabla.write_string
		.info_tablas[:tablas][llave.as_symbol()][:color] << .items[:color_tabla].value
		.info_tablas[:tablas][llave.as_symbol()][:renglones] << .items[:renglones].value.as_integer()
		.info_tablas[:tablas][llave.as_symbol()][:t_reng] << .items[:tamanio_renglon].value.as_integer()
		.info_tablas[:tablas][llave.as_symbol()][:columnas] << .items[:columnas].value.as_integer()
		.info_tablas[:tablas][llave.as_symbol()][:t_col] << .items[:tamanio_columna].value.as_integer()
		_for renglon _over range(1,.info_tablas[:tablas][llave.as_symbol()][:renglones])
		_loop
			_for columna _over range(1,.info_tablas[:tablas][llave.as_symbol()][:columnas])
			_loop
				nom_celda<<renglon.write_string+","+columna.write_string
				cel << .info_tablas[:tablas][llave.as_symbol()][:celdas]
				cel[nom_celda.as_symbol()]<<property_list.new_with(:borde_der,"",
										   :borde_izq,"",
										   :borde_sup,"",
										   :borde_inf,"",
										   :texto,"",
										   :estilo,"",
										   :color,"",
										   :tamanio,"",
										   :orientacion,"",
										   :alineacion,"",
										   :subrayado,"",
										   :grados,1)
			_endloop
		_endloop
		
	_elif .info_tablas _isnt _unset _andif
	      (_self.getOpcionSeleccionada _is :configura_celda) _andif 
	      (NumCelda << .items[:celda].value) _isnt _unset
	_then
		nom_tabla << "tabla"+.items[:tabla_x].value.write_string
		nom_celda << NumCelda.write_string
		LoCelda << .info_tablas[:tablas][nom_tabla.as_symbol()][:celdas][nom_celda.as_symbol()]
		LoCelda[:borde_der] << .items[:borde_derecho].value
		LoCelda[:borde_izq] << .items[:borde_izquierdo].value
		LoCelda[:borde_sup] << .items[:borde_superior].value
		LoCelda[:borde_inf] << .items[:borde_inferior].value
		LoCelda[:texto] << .items[:texto].value
		LoCelda[:estilo] << .items[:estilo_fuente].value
		LoCelda[:color] << .items[:color_fuente].value
		LoCelda[:tamanio] << .items[:tamanio_fuente].value
		LoCelda[:orientacion] << .items[:orientacion_fuente].value
		LoCelda[:alineacion] << .items[:alineacion_fuente].value
		LoCelda[:subrayado] << .items[:subrayado_fuente].value
		_if .items[:grados_fuente].value _is _unset 
		_then
			LoCelda[:grados] << 1
		_else
			LoCelda[:grados] << .items[:grados_fuente].value
		_endif
	_endif
	
_endmethod
$
_pragma(classify_level=restricted, topic={default_class})
_method cuadro_de_notas_framework.maneja_acciones()
	## 
	## Maneja las acciones dependiendo de la seleccion.

	_if _self.getOpcionSeleccionada _is _unset 
	_then
		.items[:ancho].enabled? << _true 
		.items[:alto].enabled? << _true 	
		.items[:numero_de_tablas].enabled? << _true 	
		.items[:titulo].enabled? << _true 	
		.items[:tabla].enabled? << _false 
		.items[:color_tabla].enabled? << _false 	
		.items[:renglones].enabled? << _false
		.items[:tamanio_renglon].enabled? << _false 
		.items[:columnas].enabled? << _false 
		.items[:tamanio_columna].enabled? << _false 
		.items[:tabla_x].enabled? << _false 
		.items[:celda].enabled? << _false
		.items[:borde_derecho].enabled? << _false
		.items[:borde_izquierdo].enabled? << _false 
		.items[:borde_superior].enabled? << _false 
		.items[:borde_inferior].enabled? << _false 
		.items[:texto].enabled? << _false 
		.items[:estilo_fuente].enabled? << _false 
		.items[:color_fuente].enabled? << _false
		.items[:tamanio_fuente].enabled? << _false 
		.items[:orientacion_fuente].enabled? << _false 
		.items[:alineacion_fuente].enabled? << _false 	
		.items[:subrayado_fuente].enabled? << _false 
		.items[:grados_fuente].enabled? << _false 
	_elif _self.getOpcionSeleccionada _is :configura_sello
	_then
		.items[:ancho].enabled? << _true 
		.items[:alto].enabled? << _true 	
		.items[:numero_de_tablas].enabled? << _true 	
		.items[:titulo].enabled? << _true 	
		.items[:tabla].enabled? << _false 
		.items[:color_tabla].enabled? << _false 	
		.items[:renglones].enabled? << _false
		.items[:tamanio_renglon].enabled? << _false 
		.items[:columnas].enabled? << _false 
		.items[:tamanio_columna].enabled? << _false 
		.items[:tabla_x].enabled? << _false 
		.items[:celda].enabled? << _false
		.items[:borde_derecho].enabled? << _false
		.items[:borde_izquierdo].enabled? << _false 
		.items[:borde_superior].enabled? << _false 
		.items[:borde_inferior].enabled? << _false 
		.items[:texto].enabled? << _false 
		.items[:estilo_fuente].enabled? << _false 
		.items[:color_fuente].enabled? << _false
		.items[:tamanio_fuente].enabled? << _false 
