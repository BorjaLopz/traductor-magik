_pragma(classify_level=basic)
_method gen_planos_plugin.muestra_ventana_seleccion( ps_titulo_plano )

	## Este método genera el plano fosa de cables y distribuidor general
	_local LoDlgo
	_local LsName << :c_opbs

	_if ( LoDlg   << _self.get_dialog(LsName) ) _isnt _unset
	_then
		LoDlg.close()
		_self.dialogs.empty()
	_endif

	# Create and cache the dialog
	LoDlg << c_opbs.new_dialog( _self.top_frame )
	_self.cache_dialog( LsName, LoDlg )
	
	LoDlg.activate_relative_to(ps_titulo_plano, _self.top_frame, 350, 250)
	
_endmethod
