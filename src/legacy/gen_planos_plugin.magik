_method gen_planos_plugin.on_deactivation()
	##
	## Autor: Elena Sainero (Ten Sails Consulting)
	## Fecha de Creación: Mayo 2006
	## Caso de Uso: Administracion de Proyectos
	## Objetivo: Elimina la dependencia del proyecto activo 
	## Parametros de entrada: N/A
	## Parametros de Salida: N/A
	##

	# Remover dependiencia sobre el active_scheme para eliminar
	# problemas con la configuración de visibilidad cuando la
	# aplicación PNI se cierre.
	swg_dsn_admin_engine.remove_dependent(_self, :active_scheme)
