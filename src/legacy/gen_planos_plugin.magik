_pragma(classify_level=restricted, usage={redefinable})
_method gen_planos_plugin.validar_distrito()
	## 
	## 
	## Objetivo: Valida si se cumplen los requisitos minimos de
	## proyecto para la generacion del plano de construccion y de
	## bajantes, que se genera a partir de un distrito.
	## Parametros de Entrada: Ninguno
	## Parametros de Salida: Ninguno   
	## Autor: jtlelo
	## Fecha de Creacion: 06 Abril 2006
	##

	_if swg_dsn_admin_engine.active_scheme _is _unset
	_then
		condition.raise(:diseño_activo)
	_endif
	_if swg_dsn_admin_engine.active_scheme.project _is _unset
	_then
		condition.raise(:proyecto_activo)
	_else
		proyecto << swg_dsn_admin_engine.active_scheme.project
	_endif

	reg_distrito << swg_dsn_admin_engine.active_scheme.user!_distrito
	
	_if reg_distrito _is _unset 
	_then
		_self.message(:distrito)

	_endif
	
	>> reg_distrito
_endmethod
$
