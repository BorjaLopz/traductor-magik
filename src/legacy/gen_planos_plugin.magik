_pragma(classify_level=restricted, usage={redefinable})
_method gen_planos_plugin.plano_estudio_de_trans()
#  Objetivo: Escriba aquí el objetivo.
#  Parámetros de entrada:  Ninguno.
#                                  
#  Parámetros de salida:     Ninguno.
#                                   
#  Regresa:  Ninguno.
# Fecha de última modificación: 24 feb 2005
# Autor de la modificación bfpalaci
# Descripción de la modificación: Nuevo
	
	_local LoPaf << smallworld_product.pni_application()
	_if swg_dsn_admin_engine.active_scheme _is _unset
	_then
		LoPaf.show_message( _self.message(:diseño_activo))
		_return 
	_endif

#-----------------------------------------------------------------------	
# (05/04/08 ahernan) : Verifica que  exista enlace y cable seleccionado.
#----------------------------------------------------------------------	
	(LoNNumTramo,LoNNumRuta ) << _self.cable?()

	_if LoNNumRuta _is _unset _and  LoNNumTramo _is _unset 
	_then
		_return   # no se tiene cable seleccionado.
	_endif

	_local Lolyp        << Lopaf.plugin(:layout_plugin)
	_local Lolyd        << Lolyp.start_layout_designer()
	_local Lolym        << Lolyd.plugin(:layout_manager)
	_local LoPagina    << LoLym.current_document.current_page	

#------------------------------------------------------------------
# (05/02/25 ahernan) :  Verifica que no exista proyecto en edicion.
#------------------------------------------------------------------
	
	_local LbContinuar << Lolyp.verifica_status()
	
	_if LbContinuar 
	_then		
		_self.Elementos_comunes(LoNNumTramo, LoNNumRuta)
		
		#--------------------------------------------------------------------
		L          << c_detalles_layout.new_with(:bounds,  bounding_box.new(1,1,1,1))
		#--------------------------------------------------------------------
		L.set_colour(_unset)
		L.set_fill_colour(_unset )
		LoPagina.add_element(L)	
				
	_endif
	
	# (05/04/06 ahernan) : Se agregan elementos que dependen del enlace.
	
	# ESTUDIO DE TRANSMISION

        _Local LnInicio_X
        _local LnInicio_Y
	_Local LnAltura
	_local LnAncho
	
	#altura total de la tabla. 1mm =10 pixeles
	
	LnAltura           << 1850  # 185 mm
	LnAncho            << 3700  # 370 mm

	#------------------------------------
	#Coordenada donde iniciara el sello 1
        #------------------------------------
 
#	LnInicio_X << 300 # 30 mm del borde izquierdo de la pagina 
#	LnInicio_Y << 150 # 15 mm del borde inferior de la pagina

	LnInicio_X         <<  LoPagina.bounds.xmax -  7000 # 30 mm del borde izquierdo de la pagina 
	LnInicio_Y         <<  400   # 15 mm del borde inferior de la pagina

	LnFinal_X          << LnInicio_X + LnAncho
	LnFinal_Y          << LnInicio_Y + LnAltura	
	
	#La primera coordenada es la esquina inferior izquierda
	#La segunda coordenada superior derecha del sello 

	vpareaSello        << bounding_box.new(LnInicio_X, LnInicio_Y , LnFinal_X , LnFinal_Y )
	LoSello            << c_estudio_transmision.new_with(:bounds, vpareaSello)
	LoSello.asigna_num_tramo(LoNNumRuta.write_string ,  LoNNumTramo.write_string )
	LoPagina.add_element(LoSello)
	
	# DIAGRAMA EMPALMES GENERAL
	
	#altura total de la tabla. 1mm =10 pixeles
	LnAltura           << 2000  # 200 mm
	LnAncho            << 2900  # 290  mm

	#------------------------------------
	#Coordenada donde iniciara el sello 2
	#------------------------------------

#	LnInicio_X << 4000 # 400 mm del borde izquierdo de la pagina 
#	LnInicio_Y << 500  # 50  mm del borde inferior de la pagina

	LnInicio_X         << LoPagina.bounds.xmax -  3000 # 30 mm del borde izquierdo de la pagina 
	LnInicio_Y         << 500  # 50  mm del borde inferior de la pagina

	LnFinal_X          << LnInicio_X + LnAncho
	LnFinal_Y          << LnInicio_Y + LnAltura	
	
	#La primera coordenada es la esquina inferior izquierda
	#La segunda coordenada superior derecha del sello 	
	
	vpareaSello        << bounding_box.new(LnInicio_X, LnInicio_Y , LnFinal_X , LnFinal_Y )	
        LoSello            << c_sello_diagrama_empalmes_general.new_with(:bounds, vpareaSello)
	LoSello.Inicializa()	
	#----------------------------------------------------------------------
	LoSello.asigna_num_tramo(LoNNumRuta.write_string ,  LoNNumTramo.write_string )
	#----------------------------------------------------------------------	
	LoPagina.add_element(LoSello)
	LoSello.Agrega_LYM(Lolym)		
	
_endmethod
$
_pragma(classify_level=restricted, usage={redefinable})
_method gen_planos_plugin.plano_fcydg()
	.s_plano_solicitado << :fosa_cables
	_if (shc << swg_dsn_admin_engine.active_scheme) _isnt  _unset _andif
	    (shc.project.job_type = _self.message(:proyecto_existente))
	_then		
		# (2012-07-02 AHERNAN, HILDEBRANDO) : se envian parametros.
		_self.genera_plano_por_opb(_unset  , :fosa_cables )
	_else
		_self.muestra_ventana_seleccion("Fosa de Cables")		
	_endif

_endmethod
