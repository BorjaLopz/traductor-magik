_pragma(classify_level=restricted, usage={redefinable})
_method gen_planos_plugin.plano_de_bajantes()

	paf         << smallworld_product.pni_application()
	mpg         << paf.plugin(:map_plugin)
	LoProyecto  << swg_dsn_admin_engine.active_scheme.project
		
	_if swg_dsn_admin_engine.active_scheme _is _unset
	_then
		paf.show_message( _self.message(:diseño_activo))
		_return 
	_endif


	LoObjetoEnEditor << _self.validar_distrito()

	_if LoObjetoEnEditor _is _unset 
	_then
		paf.show_message( _self.message(:distrito))
		#paf.show_message("Seleccionar un Distrito.")
		_return 
	_endif

	_if LoObjetoEnEditor.source_collection.name=:user!_distrito
	_then
		mpg.goto(LoObjetoEnEditor)
	_else
		paf.show_message( _self.message(:construccion))
		#	paf.show_message("Para un plano de construcción debe seleccionar un distrito.")
		_return
	_endif

	lyd << paf.plugin(:layout_plugin).start_layout_designer()
	_if lyd _isnt _unset 
	_then
		lym                    << lyd.plugin(:layout_manager)
		LoDoc                  << lym.current_document
		LoDoc.user!_tipo_plano << :bajantes
		LoPage << LoDoc.current_page
		_if LoPage.elements.size>0
		_then
			LoPage.elements.empty()
		_endif
	_else
		_return
	_endif

	LoDibujaPlano                    << c_geom_set_layout.new_with(:bounds,bounding_box.new(10,10,100,100))
	LoDibujaPlano.outline_style      << _unset
	LoDibujaPlano.oAppLayoutDesigner << lyd
	LoDibujaPlano.oRegistro          << LoObjetoEnEditor
	LoDibujaPlano.nIdRegistro        << LoObjetoEnEditor.id
	LoDibujaPlano.nMargenVp          << 800
	LoDibujaPlano.sNombreAce         << "CENT_PLANOS"
	LoDibujaPlano.sTipoPlano         << "BAJANTES"
	LoDibujaPlano.sNombrePlano       << LoObjetoEnEditor.user!_distrito
	LoDibujaPlano.modulos_ancho      << 4
	LoDibujaPlano.modulos_alto       << 2

	lym.current_document.current_page.add_element(LoDibujaPlano)
	
_endmethod
$
