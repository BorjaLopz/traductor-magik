_pragma(classify_level=restricted, usage={redefinable})
_method gen_planos_plugin.plano_de_hoja_secuencia()
#  Objetivo: Escriba aquí el objetivo.
#  Parámetros de entrada:  Ninguno.
#                                  
#  Parámetros de salida:     Ninguno.
#                                   
#  Regresa:  Ninguno.
# Fecha de última modificación: 24 feb 2005
# Autor de la modificación bfpalaci
# Descripción de la modificación: Nuevo
	 
	_local LoPaf << smallworld_product.pni_application()
	_if swg_dsn_admin_engine.active_scheme _is _unset
	_then
		LoPaf.show_message( _self.message(:diseño_activo))
		_return 
	_endif

#-----------------------------------------------------------------------	
# (05/04/08 ahernan) : Verifica que  exista enlace y cable seleccionado.
#----------------------------------------------------------------------	
	(LoNNumTramo,LoNNumRuta )            << _self.cable?()

	_if LoNNumRuta _is _unset _and  LoNNumTramo _is _unset 
	_then
		_return   # no se tiene cable seleccionado.
	_endif

	_local Lolyp                             << Lopaf.plugin(:layout_plugin)
#------------------------------------------------------------------
# (05/02/25 ahernan) :  Verifica que no exista proyecto en edicion.
#------------------------------------------------------------------
	_local LbContinuar                      << Lolyp.verifica_status()
	
	_if LbContinuar 
	_then

		_local Lolyd                 << Lolyp.start_layout_designer()
		_local Lolym                 << Lolyd.plugin(:layout_manager)	
		_local LnAnchoSello          << 1800 
		_local LnAnchoCroquis        << 50  # (05/03/03 ahernan) : No lleva croqui
		_local LnEspacio             << 300
		_local LnEspacioArrAbaIzqder << 100		
		_local LoPagina              << LoLym.current_document.current_page		
		#-------------------------------------------------------
		#Agrega marco.	
		#--------------------------------------------------------
		LoMarco                      << marco_layout.new()	
		LoMarco.num_mod              << 7
		LoMarco.sello                << LnAnchoSello  +  LnAnchoCroquis + 200
		LoMarco.set_fill_colour(_unset )
		LoMarco.set_colour(_unset)
		LoPagina.add_element(LoMarco)		
		#----------------------------------------------------
		#Sello de Observaciones
		#---------------------------------------------------- 
		LnInicio_X                   << 300 # 25 mm del borde izquierdo de la pagina 
		LnInicio_Y                   << 100  # 7.5 mm del borde inferior de la pagina
		
		#altura total de la tabla. 1mm =10 pixeles
		LnAltura                     << 2600 # 91 mm
		LnAncho                      << 1800 # 88 mm		
		vparea                       << bounding_box.new(LnInicio_X, LnInicio_Y, LnInicio_X + LnAncho, LnInicio_Y + LnAltura )
		
		
		LoSello                      << c_sello_observaciones.new_with(:bounds, 	vparea)

		LoSello.asigna_num_tramo(LoNNumRuta.write_string ,  LoNNumTramo.write_string )
		LoSello.Inicializa()
		LoPagina.add_element(LoSello)
		LoSello.Agrega_LYM(Lolym)
		
		#----------------------------------------------------
		# (05/03/01 ahernan) : detalles Resumen de materiales.
		#----------------------------------------------------		
		LoDespx                         << LoPagina.bounds.xmin +  LnAnchoSello  +  LnEspacio +   LnEspacioArrAbaIzqder 
		LoDespy                         << LoPagina.bounds.ymin 
		LoP1                            << coordinate.new( LoDespx ,LoDespy)
		LoP2                            << coordinate.new( LoP1.x + 5000,        LoP1.y + 2700 )	
		LoVpTemp                        << bounding_box.new(LoP1.x, LoP1.y , LoP2.x, LoP2.y )	
		LoSello                         << c_resumen_proyecto.new_with(:bounds, LoVpTemp)
		LoSello.Inicializa()
		LoPagina.add_element(LoSello)

		#----------------------------------------------------
		# (05/03/01 ahernan) : Hoja de secuencia
		#----------------------------------------------------
	
		LoP1                            << coordinate.new( LoDespx + 2200 ,LoDespy + 500)
		LoP2                            << coordinate.new( LoP1.x + 1500, LoP1.y + 2000 )	
		LoVpTemp                        << bounding_box.new(LoP1.x, LoP1.y , LoP2.x, LoP2.y )	
		LoHsecuencia                    << textbox_layout.new_with(:bounds,LoVpTemp)
		LoHsecuencia.set_fill_colour(_unset )
		LoHsecuencia.font_size          << 2
		LoHsecuencia.text << "                         SECUENCIA DE TRABAJO       " +
				     NEWLINE_CHAR +  NEWLINE_CHAR +
				     "1.- VERIFICAR QUE LOS PERMISOS MUNICIPALES, FEDERALES, AUTOPISTAS," +
				     NEWLINE_CHAR +
				     " ESTATALES,ETC. .. Y SUS CRUZAMIENTOS CORRESPONDIENTES SE ENCUENTREN AUTORIZADOS," +
				     NEWLINE_CHAR +
				     "QUE LA CONSTRUCCIÓN DE LAS CANALIZACIONES SE ENCUENTREN TERMINADAS Y QUE LA COLOCACION" +
				     NEWLINE_CHAR +
                                     "EN LOS POSTES DE LOS SOPORTES PARA  CABLE DE FO SE ENCUENTREN INSTALADOS." +
				     NEWLINE_CHAR +  NEWLINE_CHAR + 
                                     "2.- INSTALAR   METROS DE 3 DUCTOS DE POLIENTILENO DE BAJA DENSIDAD DE 35 MM  " +
				     NEWLINE_CHAR +
                                     "PARA SUBDIVISION DE VIAS ENTRE LOS POZOS NUMERO:_________________________________   " +
				     NEWLINE_CHAR +  NEWLINE_CHAR +
                                     "3.- INSTALAR      MTS. DE  ESCALERILLA DE ______ CON TAPA PARA CABLE DE FO " +
				     NEWLINE_CHAR +
                                    "DESDE LA VENTANA DE LA FOSA DE CABLES CTL-       HASTA EL BDFO COMO INDICA EL PROYECTO." +
				     NEWLINE_CHAR + "4.-" + NEWLINE_CHAR + NEWLINE_CHAR + "5.- " +
				     NEWLINE_CHAR +  NEWLINE_CHAR
     
		LoPagina.add_element(LoHsecuencia)
						
		#-----------------------------------------
		# (05/03/01 ahernan) : Derechos reservados.
		#-----------------------------------------		
		L << c_detalles_layout.new_with(:bounds,  bounding_box.new(1,1,1,1))
		L.set_colour(_unset)
		L.set_fill_colour(_unset )
		LoPagina.add_element(L)	
		
	_endif
		
_endmethod
$
