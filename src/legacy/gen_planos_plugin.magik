_pragma(classify_level=basic)
_method gen_planos_plugin.genera_plano_por_opb(_optional oe, tipo_plano)

	_local LoExistente
	_if (shc << swg_dsn_admin_engine.active_scheme) _is _unset
	_then
		condition.raise(:diseo_activo)
        _else
		LoExistente << shc.project.job_type = _self.message(:proyecto_existente)
	_endif
	
	_if .o_opb _is _unset _andif _not LoExistente
	_then
		condition.raise(:user_error,
				 :string, _self.message(:opb_no_seleccionada))
	_endif
	_if .s_plano_solicitado = :fosa_cables
	_then
		_self.genera_plano_fosa_cables(oe, tipo_plano)
	_elif .s_plano_solicitado = :ruta_cables
	_then
		_self.genera_plano_ruta_cables()
	_endif
	
_endmethod
