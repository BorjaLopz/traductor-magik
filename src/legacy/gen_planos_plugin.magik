_pragma(classify_level=basic)
_method gen_planos_plugin.genera_plano_de_esquematico_de_principales()
	## ( 12/08/2008 fhramire ) : metodo para activar la interface de
	## arbol_cables_fo_central y permitir seleccionar al usuario el cable
	## para generar plano de ruta.
	## Permite Obtener los cables en proyectos RDA, ROF, TRONCAL 
	
	_self.gui_cables_fo << _unset 	
	paf << smallworld_product.pni_application()
	mv << paf.plugin(:map_plugin).current_map_view 
	ed << paf.plugin(:editor_manager).current_embedded_editor
	LoDisenoActual <<  swg_dsn_admin_engine.active_design

	loproject << swg_dsn_admin_engine.active_design.project
	LoCentral << loproject.user!_central

	tipo  << loproject.name.numbers_and_strings[3].replace_substring("_", "")
	tipo  << tipo.replace_substring("_", "")		
	
	_if   mv.ace_name _is :gs!schematic 
	_then
			tipo  << "c_plano_esquematico_de_principales_" + tipo
			
			Loplano<< _self.perform(tipo.lowercase.as_symbol())
			LoPlano.genera_plano()

	_else
		_self.show_message("Debe seleccionar el mapa esquemático y tenerlo activo")
	_endif
	
_endmethod
$
_pragma(classify_level=restricted, usage={redefinable})
_method gen_planos_plugin.genera_plano_detalles_cables_fo()
	#lanza el plano de detalles dado un pin del cable proyectado
	# desde la entana de trazo.
	
	paf << smallworld_product.pni_application()
	mapa << paf.plugin(:map_plugin)
	plug << paf.plugin(:trace_plugin)
	
	pines << plug.trace_dialog.start_nodes()

	_if pines.size = 1
	_then

	(LCollEstructuras,LCollEstructurasCanal,LCollElementos,LcollCables) << _self.obtener_estructuras(pines.an_element())

	_if LCollEstructuras.size > 0  
	_then
		_self.o_ruta_sigp  <<   hash_table.new()  
		_self.o_ruta_sigp[:oestructuras]  << LCollEstructuras
		_self.o_ruta_sigp[:oestructurascanal]  << LCollEstructurascanal
		_self.o_ruta_sigp[:ocables]       << LcollCables
		_self.o_ruta_sigp[:oelementos]    << LCollElementos		
		loproject << swg_dsn_admin_engine.active_design.project
		LoCentral << loproject.user!_central		
		# (2012-07-23 AHERNAN, HILDEBRANDO) : se agrega spatial context
		# por si el plano se genera desde un mundo interno.
		paf.manager.goto_primary_context(LoCentral)    		
		tipo  << loproject.name.numbers_and_strings[3].replace_substring("_", "")
		tipo  << tipo.replace_substring("_", "")
		tipo  << "c_plano_detalles_" + tipo		
		Loplano<< _self.perform(tipo.lowercase.as_symbol())
		mapa.current_map.trail.clear()
		LoPlano.genera_plano(LcollCables.an_element())
	_else
		_self.show_message("Debe ejecutar el trazo de la conectividad desde la ventana de trazo") 
	_endif
	
	
	_else
		_self.show_message("Debe seleccionar un punto de inicio (Pin-Puerto) del cable para generar el plano,desde la ventana de trazo") 
		
	_endif
	
	
_endmethod
$
_pragma(classify_level=restricted, usage={redefinable})
_method gen_planos_plugin.genera_plano_ruta_cables_fo()
	## ( 12/08/2008 fhramire ) : metodo para activar la interface de
	## arbol_cables_fo_central y permitir seleccionar al usuario el cable
	## para generar plano de ruta.
	## Permite Obtener los cables en proyectos RDA, ROF, TRONCAL 
	
	LoProyecto << swg_dsn_admin_engine.active_design.project
	locentral  << LoProyecto.user!_central.building	
	_self.gui_cables_fo << _unset
	
	paf << smallworld_product.pni_application()	
	mapa << paf.plugin(:map_plugin)
	plug << paf.plugin(:trace_plugin)	
	pines << plug.trace_dialog.start_nodes()
	mcables << rope.new()
	mcable <<  _unset 
	oestructuras << rope.new()
	oelementos   << rope.new()
	
	_if pines.size > 1
	_then	
		(LCollEstructuras,
		 LCollEstructurasCanal,
		 LCollElementos,LcollCables) << _self.obtener_estructuras(pines.an_element())

		
		_if LCollEstructuras.size > 0
		_then
			_self.o_ruta_sigp  <<   hash_table.new()  
			_self.o_ruta_sigp[:oestructuras]  << LCollEstructuras
			_self.o_ruta_sigp[:oestructurascanal]  << LCollEstructurascanal
			_self.o_ruta_sigp[:ocables]       << LcollCables
			_self.o_ruta_sigp[:oelementos]    << LCollElementos
			
			paf.manager.goto_primary_context(LoCentral)    		
			tipo  << loproyecto.name.numbers_and_strings[3].replace_substring("_", "")
			tipo  << tipo.replace_substring("_", "")
			tipo  << "c_plano_ruta_" + tipo
			
			Loplano<< _self.perform(tipo.lowercase.as_symbol())
			
			mapa.current_map.trail.clear()
			LoPlano.genera_plano(LcollCables.an_element())
		_else
			_self.show_message("Debe ejecutar el trazo de la conectividad desde la ventana de trazo") 
		_endif
	_else
		_self.show_message("Debe seleccionar al menos un punto de inicio para generar el plano,desde la ventana de trazo") 
		
	_endif
	
_endmethod
$
_pragma(classify_level=restricted, usage={redefinable})
_method gen_planos_plugin.c_plano_detalles_acometida
	
	paf << smallworld_product.pni_application()
       	
	mbay <<  _self.o_ruta_sigp[:obasfinal].an_element()

	LoEng << c_engine_ruta_cables.new()
	
	_if mbay.radio_base _isnt _unset 
	_then
		loplano << c_plano_detalles_acometida_rb.new(LoEng)
	_else
		loplano << c_plano_detalles_acometida.new(LoEng)
	_endif
	
	_return loplano
_endmethod
$

