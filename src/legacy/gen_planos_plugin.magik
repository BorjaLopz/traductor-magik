_pragma(classify_level=basic, topic={tree_item}, usage={subclassable})
_method gen_planos_plugin.obtener_estructuras(PoNodo)

	_local LCollResultados << _unset 
	_local LCollEstructuras << _unset
	_local LCollCanalizacion << _unset 
	_local LCollElementos << _unset
	
	paf << smallworld_product.pni_application()	
	plug << paf.plugin(:trace_plugin)
	tracedialog  << plug.sys!slot(:trace_dialog)
	rwoset<< tracedialog.current_manager.result_rwo_set()
	resultstrace<<  tracedialog.sys!slot(:managers)[:signal].results

	oCables << rope.new()	
	##oBasInicio << _self.bastidor_inicial(PoNodo)
	##oBasFinal << rope.new()	
	##oCanalizacion << rope.new()
	
	(LCollEstructuras, LoCollCanalizacion, LCollElementos, LcollCables) << _self.estructuras_por_link(resultstrace)

	_return LCollEstructuras,LoCollCanalizacion,LCollElementos, LcollCables
	
_endmethod
$
_pragma(classify_level=basic, topic={tree_item}, usage={subclassable})
_method gen_planos_plugin.estructuras_por_link(PoCollLinks)
## 
##
_local LCollSt      << rope.new()
_local LCollStCanal << rope.new()
_local LcollEl      << rope.new()
_local LcollCables  << rope.new()

_local oBasFinal   << rope.new()
_local oBasInicio   << _unset

	_for LoLink _over PoCollLinks.elements()
	_loop
		_self.estructuras_en_nodo(LoLink.in_node, LCollSt, LCollStCanal,LcollEl,LcollCables)
		_self.estructuras_en_nodo(LoLink.out_node,LCollSt, LCollStCanal,LcollEl,LcollCables)
		_self.device_en_link(LoLink,LCollSt,LcollEl, oBasInicio ,  oBasFinal )		
	_endloop
	
	_return LCollSt,LCollStCanal, LcollEl, LcollCables
	
_endmethod
$
_pragma(classify_level=basic, topic={tree_item}, usage={subclassable})
_method gen_planos_plugin.bastidor_inicial(PoPin)
## 
##
	LoSheathPin << PoPin.sheath_pin
	_if (LoConnec << LoSheathPin.strw_connect_point) _isnt _unset 
	_then
		_return LoConnec.owner
	_endif

	_return _unset 		 
	
_endmethod
$
_pragma(classify_level=basic, topic={tree_item}, usage={subclassable})
_method gen_planos_plugin.device_en_link(PoLink,PoCollSt,PoCollEl,oBasInicio, oBasFinal)
## Metodo que obtiene las estructuras de alto nivel (:building,
## :user!_building) y los elementos relacionados (gasas,empalmes)
##
_local LoTopStr << PoLink.get_top_level_device()
_local LoLowDev << PoLink.get_low_level_device_for_low_level()

    # validar el device_top_level que sea estructura, sino
    # agregarlo como elemento

    _if LoTopStr _isnt _unset _andif LoTopStr.is_structure? _andif
	_not PoCollSt.includes_by_equality?(LoTopStr)		       
    _then
	    PoCollSt.add(LoTopStr)
    _else
	    PoCollEl.add(LoTopStr)
    _endif

    # validar el device_low_level que sea mit_rme_port, y obtener
    # su estructura(building, user!_building)
    _if LoLowDev _isnt _unset _andif LoLowDev.is_kind_of?(mit_rme_port)
    _then
	    LoOwner << LoLowDev.gis_owner
	    _if LoOwner.responds_to?(:is_structure?) _andif
		LoOwner.is_structure? _andif
		_not PoCollSt.includes_by_equality?(LoOwner)		       
	    _then	   
		    PoCollSt.add(LoOwner)
	    _endif

	    Lobas << LoLowDev.rme_bay_owner()
	    
	    _if oBasInicio <> Lobas
	    _then
		    oBasFinal.add(Lobas)
	    _endif
    _endif

_endmethod
$
_pragma(classify_level=basic, topic={tree_item}, usage={subclassable})
_method gen_planos_plugin.estructuras_en_nodo(PoNodo,PoCollSt, PoCollStcanal,PoCollEl, PoCables)
## 
##
	_if PoNodo.is_kind_of?(mit_pseudo_fiber_pin ) _orif
	    PoNodo.is_kind_of?(mit_fiber_pin )
	_then
		# agregar estructuras del cable
		_for st _over PoNodo.owner.structures.elements()
		_loop
			_if _not PoCollSt.includes_by_equality?(st) _andif
			     ( st.is_kind_of?(underground_route) _orif st.is_kind_of?(aerial_route))
			_then
				PoCollStCanal.add(st)				
			_endif 
			
			_if _not PoCollSt.includes_by_equality?(st) _andif
			    _not st.is_kind_of?(underground_route)
			_then
				PoCollSt.add(st)				
			_endif 
		_endloop

		# agregar las llaves asociadas al cable
		_for st_anotacion _over PoNodo.owner.structure_annotations.elements()
		_loop
			_if _not PoCollEl.includes_by_equality?(st_anotacion)
			_then
				PoCollEl.add(st_anotacion)
			_endif
			
		_endloop

		# agregar el cable
		_if _not PoCables.includes_by_equality?(PoNodo.owner)
		_then
			PoCables.add(PoNodo.owner)
		_endif
	_endif	
	
_endmethod
$


