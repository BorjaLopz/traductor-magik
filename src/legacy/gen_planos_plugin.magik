_pragma(classify_level=restricted, usage={redefinable})
_method gen_planos_plugin.plano_principales()
	#  Objetivo: Genera  el plano de principales.
	#  Parámetros de entrada:  Ninguno.
	#                                  
	#  Parámetros de salida:     Ninguno.
	#                                   
	#  Regresa:  Ninguno.
	# Fecha de última modificación: 24 feb 2005
	# Autor de la modificación bfpalaci
	# Descripción de la modificación: adecuacion al estandar de magik
	#
	paf           << smallworld_product.pni_application()
	#_if swg_dsn_admin_engine.active_scheme _is _unset
	#_then
	#	paf.show_message("No hay un diseño activo.")
	#        _return 
	#_endif
	lyp           << paf.plugin(:layout_plugin)	
	lyd           << lyp.start_layout_designer()
	lym           << lyd.plugin(:layout_manager)
	vparea        << bounding_box.new(500, 500, 1000, 1000)
	marco         << marco_layout.new_with(:bounds,vparea)
	marco.num_mod << 5
	marco.altura  << 3
	# START CHANGE
	#*********************** Alejandro Enriquez Gijon *****************
	# (05/04/29) : 
	#
	LoArea        << bounding_box.new(100, 100, 10000, 8000)
	LoPPrin       << c_plano_Principales.new_with(:bounds, LoArea)		
	LoPPrin.genera_plano()

	#lym.current_document.current_page.add_element(marco)
	#lyp.start_layout_designer()
	#
	# END CHANGE
		
_endmethod
