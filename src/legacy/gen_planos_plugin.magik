_pragma(classify_level=basic)
_method gen_planos_plugin.GeneraTitulo(PnProyecto, PnObjetoEnEditor,  PsDibujaPlano)
	## 
	##

_local LoAnio           << date_now().year.write_string
_local LoMes            << date_now().month_number.write_string
_local LoEmp            << PnProyecto.user!_empresa_proyecto.write_string
_local LoProg           << PnProyecto.user!_programa.write_string
_local LoAlter          << PnProyecto.inf_schemes.write_string
_local LoTipoPlano      << PsDibujaPlano.sTipoPlano
_local LoObjetoEnEditor << PnObjetoEnEditor
_local LoNumHoja        << "01" #PsDibujaPlano.layout_page.page_number().write_string
_local LoCantHojas      << "01" #PsDibujaPlano.layout_page.number_of_pages().write_string


        _if LoMes.size = 1
	_then
		LoMes << %0+LoMes
	_endif

	LoAnio << LoAnio[3]+LoAnio[4]

	_if LoEmp.size > 0
	_then
		LoEmp << LoEmp[1]
	_endif

	_if LoProg.size > 0
	_then
		LoProg << LoProg[1]
	_endif

	_if LoNumHoja.size = 1 
	_then
		LoNumHoja << %0+LoNumHoja
	_endif

	_if LoCantHojas.size = 1
	_then
		LoCantHojas << %0+LoCantHojas
	_endif

	_if LoTipoPlano = "ASHURADO"
	_then
		_return %1 + LoObjetoEnEditor.user!_central +%_ + "ASHU" + %R +
			LoAnio + LoMes + LoAlter + LoNumHoja + LoCantHojas + LoProg + LoEmp
	_elif LoTipoPlano = "DISTRITOS"
	_then 
		_return %1 + LoObjetoEnEditor.user!_central + %_ + "DIVI" + %S +
			LoAnio + LoMes + LoAlter + LoNumHoja + LoCantHojas + LoProg + LoEmp
	_elif LoTipoPlano = "ITINERARIO"
	_then
		_return %1 + LoObjetoEnEditor.user!_central + %_ + "ITIN" + %E +
			LoAnio + LoMes + LoAlter + LoNumHoja + LoCantHojas + LoProg + LoEmp
	_elif LoTipoPlano = "CANALIZACION"
	_then 
		_return %1 + LoObjetoEnEditor.user!_central + %_ + "RC" + "99" + %V +
			LoAnio + LoMes + LoAlter + LoNumHoja + LoCantHojas + LoProg + LoEmp
	_elif LoTipoPlano = "CONSTRUCCION" 
	_then
		_return %1 + LoObjetoEnEditor.user!_central + %_ + LoObjetoEnEditor.user!_num_dto +
			%C + LoAnio + LoMes + LoAlter + LoNumHoja + LoCantHojas + LoProg + LoEmp
	_elif LoTipoPlano = "BAJANTES"
	_then
		_return %1 + LoObjetoEnEditor.user!_central + %_ + LoObjetoEnEditor.user!_num_dto +
			%B + LoAnio + LoMes + LoAlter + LoNumHoja + LoCantHojas + LoProg + LoEmp
	_endif
	
_endmethod
$
