_pragma(classify_level=basic)
_method gen_planos_plugin.obtener_registros_de(PoElementos)
	##  Objetivo  : Obtener información del enlace que componen el
	## enlace del plano que se genera.
	## donde PoElementos puede ser : :oestructuras, :obasinicio,
	## :ocanalizacion, :oelementos, :ocables ,:obasfinal
	
	LoRegistros << rope.new()
	
	_if  .o_ruta _isnt _unset  _andif
	     .o_ruta[PoElementos] _isnt _unset 
	_then
                  _if .o_ruta[PoElementos].is_kind_of?(mit_bay)
		  _then
			  
			  LoRegistros.add(.o_ruta[PoElementos])
		  _else
			 
			  LoRegistros  << .o_ruta[PoElementos]		  
		  _endif
		
               
	_endif

	_return LoRegistros
	
_endmethod
