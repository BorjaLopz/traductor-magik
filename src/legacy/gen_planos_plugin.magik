_pragma(classify_level=basic)
_method gen_planos_plugin.perfil_crea_planos?
	##  
	##
	_local LoAv << gis_program_manager.authorisation_view
	_local LoUser << LoAv.current_user

	_if LoUser.has_group?("system_admin")
	_then
		_return _true 
	_endif
	
	_for LoGrupo _over LoUser.groups.fast_elements()
	_loop
		_if LoGrupo.name = "JEFE AREA ING. TMX." _or
		    LoGrupo.name = "PROYECTISTA TELMEX" _or
		    LoGrupo.name = "JEFE DE OFICINA FILIAL" _or
		    LoGrupo.name = "JEFE DE GRUPO FILIAL" _orif
		    LoGrupo.name = "PROYECTISTA FILIAL" _or
		    LoGrupo.name = "CONSTRUCTOR" _orif
		    LoGrupo.name = "DIRECCION TECNICA" _orif
		    LoGrupo.name = "SOPORTE" _orif
		    LoGrupo.name = "GERENTE TELMEX" _orif
		    LoGrupo.name = "GERENTE FILIALES" _orif
		    LoGrupo.name = "CARTOGRAFICO" _orif
		    LoGrupo.name = "PERMISOS" _orif 
		    LoGrupo.name = "CONSTRUCCION" _orif
		    LoGrupo.name = "PROTECCION DE INVENTARIO" _orif 
		    LoGrupo.name = "IPR TELMEX" _orif
		    LoGrupo.name = "SUPERVISOR ICRA"

		_then
			_return  _true	
		_endif
	_endloop 

       >> _false 
       
_endmethod
$
_pragma(classify_level=restricted, usage={redefinable})
_method gen_planos_plugin.plano_ashurado()
#  Objetivo: genera el plano de Division de ashurado.
#  Parámetros de entrada:  Ninguno.
#                                  
#  Parámetros de salida:     Ninguno.
#                                   
#  Regresa:  Ninguno.
#  Fecha de última modificación: 04 Enero 2006
#  Creado por: jtlelo
#  

	paf              << smallworld_product.pni_application()
        
	LoObjetoEnEditor << _self.validar_generar_plano_distritos()
	LoProyecto       << swg_dsn_admin_engine.active_scheme.project

        lyd              << paf.plugin(:layout_plugin).start_layout_designer()
       _if lyd _isnt _unset 
       _then
	       lym                    << lyd.plugin(:layout_manager)
	       LoDoc                  << lym.current_document
	       LoDoc.user!_tipo_plano << :ashurado
	       LoPage                 << LoDoc.current_page
	       _if LoPage.elements.size>0
	       _then
		       LoPage.elements.empty()
	       _endif
       _else
	       _return
       _endif
 
       LoDibujaPlano                    << c_geom_set_layout.new_with(:bounds,bounding_box.new(10,10,100,100))
       LoDibujaPlano.outline_style      << _unset
       LoDibujaPlano.oAppLayoutDesigner << lyd
       LoDibujaPlano.oRegistro          << LoObjetoEnEditor
       LoDibujaPlano.nIdRegistro        << LoObjetoEnEditor.id
       LoDibujaPlano.nMargenVp          << 800
    
       LoDibujaPlano.sNombreAce         << "CENT_PLANOS"
       LoDibujaPlano.sTipoPlano         << "ASHURADO"
       # (06/05/05 jtlelo) : se creo un metodo para generar el nombre
       # del plano, conforme al caso de uso GENERAR PLANO
              #LoDibujaPlano.sNombrePlano<<"CTL - "+LoObjetoEnEditor.user!_central+
       #			   newline_char+"PLANO ASHURADO"

       LoMunicipio     << LoObjetoEnEditor.municipio.default("")
       LoEstado        << LoObjetoEnEditor.estado.default("") 
       LoCentral       << LoObjetoEnEditor.user!_central.default("")
       LoNombre        << LoObjetoEnEditor.user!_nombre.default("")
       LoPrograma_tipo << LoProyecto.user!_programa_tipo.default("")
       LoPrograma_anyo << LoProyecto.user!_programa_anyo.default("")

       
#       _if (LoMunicipio<<LoObjetoEnEditor.municipio) _is _unset 
#       _then
#	       LoMunicipio << ""
#       _endif
#       _if (LoEstado<<LoObjetoEnEditor.estado) _is _unset 
#       _then
#	       LoEstado << ""
#       _endif
#       _if (LoCentral<<LoObjetoEnEditor.user!_central) _is _unset 
#       _then
#	       LoCentral << ""
#       _endif
#       _if (LoNombre << LoObjetoEnEditor.user!_nombre) _is _unset 
#       _then
#	       LoNombre << ""
#       _endif
#       _if (LoPrograma_tipo<<LoProyecto.user!_programa_tipo) _is _unset 
#       _then
#	       LoPrograma_tipo << ""
#       _endif
#       _if (LoPrograma_anyo<<LoProyecto.user!_programa_anyo) _is _unset 
#       _then
#	       LoPrograma_anyo << ""
#       _endif
       _if LoMunicipio = "" _andif LoEstado = ""
       _then
	       LoMunEstado << ""
       _else
	       LoMunEstado << LoMunicipio + ", " + LoEstado + newline_char
       _endif
       
       LoDibujaPlano.sNombrePlano  << "PLANO ASHURADO" + newline_char +
				      "CTL - "         + LoCentral    + " (" + LoNombre + ")" + newline_char +
				      LoMunEstado      + "PROGRAMA "  +
				      LoPrograma_tipo  + " "          + LoPrograma_anyo

       LoDibujaPlano.modulos_ancho << 6
       LoDibujaPlano.modulos_alto  << 3
       
       lym.current_document.current_page.add_element(LoDibujaPlano)	
_endmethod
$
_pragma(classify_level=restricted, usage={redefinable})
_method gen_planos_plugin.plano_cambio_trayectoria()
#  Objetivo: Escriba aquí el objetivo.
#  Parámetros de entrada:  Ninguno.
#                                  
#  Parámetros de salida:     Ninguno.
#                                   
#  Regresa:  Ninguno.
# Fecha de última modificación: 24 feb 2005
# Autor de la modificación bfpalaci
# Descripción de la modificación: Nuevo

	_local LoPaf << smallworld_product.pni_application()
	_if swg_dsn_admin_engine.active_scheme _is _unset
	_then
		LoPaf.show_message( _self.message(:diseño_activo))
		_return 
	_endif

# (05/04/08 ahernan) : Verifica que  exista enlace y cable seleccionado.
	(LoNNumTramo,LoNNumRuta ) <<   _self.cable?()
	_if LoNNumRuta _is _unset _and  LoNNumTramo _is _unset 
	_then
		_return  # no se tiene cable seleccionado.
	_endif

	_local Lolyp << Lopaf.plugin(:layout_plugin)

#------------------------------------------------------------------
# (05/02/25 ahernan) :  Verifica que no exista proyecto en edicion.
#------------------------------------------------------------------
	
	_local LbContinuar << Lolyp.verifica_status()
	_if LbContinuar 
	_then		
		_local Lolyd                 << Lolyp.start_layout_designer()
		_local Lolym                 << Lolyd.plugin(:layout_manager)	
		_local LnAnchoSello          << 1800
		_local LnAnchoCroquis        << 0   # (05/03/03 ahernan) : No lleva croquis.
		_local LnEspacio             << 300
		_local LnEspacioArrAbaIzqder << 100
		_local LnEspacioDespuesSello << 50
		_local LoPagina              << LoLym.current_document.current_page		
		#-------------------------------------------------------
		#Agrega marco.	
		#--------------------------------------------------------
		LoMarco         << marco_layout.new()	
		LoMarco.num_mod <<   9
		LoMarco.sello   <<  LnAnchoSello + Lnespacio +  LnAnchoCroquis + LnEspacio
		LoMarco.set_fill_colour(_unset )
		LoMarco.set_colour(_unset)
		LoPagina.add_element(LoMarco)

		#---------------------------------------------------------------------
		# Agrega el sello
		#---------------------------------------------------------------------	
		LnInicio_X << 300 # 25 mm del borde izquierdo de la pagina 
		LnInicio_Y << 100  # 7.5 mm del borde inferior de la pagina
		
		#altura total de la tabla. 1mm =10 pixeles
		LnAltura << 2600 # 91 mm
		LnAncho  << 1800 # 88 mm	
		vparea   << bounding_box.new(LnInicio_X, LnInicio_Y, LnInicio_X + LnAncho, LnInicio_Y + LnAltura )		
		#---------------------------------------------------------------------
		# Agrega el sello
		#---------------------------------------------------------------------
		##----------------------------------------------------
		##Sello de Observaciones
		##---------------------------------------------------- 
		LoSello  << c_sello_observaciones.new_with(:bounds, vparea)
		LoSello.asigna_num_tramo(LoNNumRuta.write_string , LoNNumTramo.write_string )
		LoSello.Inicializa()
		LoPagina.add_element(LoSello)
		LoSello.Agrega_LYM(Lolym)
				
	_endif

_endmethod
