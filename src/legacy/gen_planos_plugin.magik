_pragma(classify_level=restricted, usage={redefinable})
_method gen_planos_plugin.init_actions()
	#PLANOS DE COBRE 
	_self.add_action(sw_action.new(:plano_ashurado,
				       :engine, _self,
				       :action_message, :plano_ashurado|()|))
	
	_self.add_action(sw_action.new(:plano_distritos,
				       :engine, _self,
				       :action_message, :plano_distritos|()| ))
	
	_self.add_action(sw_action.new(:plano_estudio_conjunto,
				       :engine, _self,
				       :action_message, :plano_estudio_conjunto|()| ))	
	
        _self.add_action(sw_action.new(:plano_fcydg,
				       :engine, _self,
				       :action_message, :plano_fcydg|()|))
	
	_self.add_action(sw_action.new(:plano_inventario_canalizacion,
				       :engine, _self,
				       :action_message, :plano_inventario_canalizacion|()| ))	
	
	_self.add_action(sw_action.new(:plano_itinerario,
				       :engine, _self,
				       :action_message, :plano_itinerario|()| ))
	
        _self.add_action(sw_action.new(:plano_permisos,
				       :engine, _self,
				       :action_message, :plano_permisos|()|))
	
        _self.add_action(sw_action.new(:plano_de_ruta,
				       :engine, _self,
				       :action_message, :plano_de_ruta|()|))
	
	_self.add_action(sw_action.new(:proyecto_canalizacion,
				       :engine, _self,
				       :action_message, :proyecto_canalizacion|()| ))
	
	_self.add_action(sw_action.new(:plano_microcanalizacion,
				       :engine, _self,
				       :action_message, :plano_microcanalizacion|()| ))

	#secundarios

	_self.add_action(sw_action.new(:plano_de_construccion,
				       :engine, _self,
				       :action_message, :plano_de_construccion|()| ))
	
	
	_self.add_action(sw_action.new(:plano_de_diagrama_de_empalmes,
				       :engine, _self,
				       :action_message, :genera_plano_de_diagrama_de_empalmes|()| ))
	
	
	_self.add_action(sw_action.new(:plano_de_bajantes,
				       :engine, _self,
				       :action_message, :plano_de_bajantes|()|))
	
        _self.add_action(sw_action.new(:plano_desmontaje_cd,
				       :engine, _self,
				       :action_message, :plano_desmontaje_cd|()|))
	
	_self.add_action(sw_action.new(:plano_obra_civil,
				       :engine, _self,
				       :action_message, :plano_obra_civil|()|))
	
	_self.add_action(sw_action.new(:plano_montaje_tba,
				       :engine, _self,
				       :action_message, :genera_plano_montaje_tba|()| ))
	
	
	_self.add_action(sw_action.new(:plano_reubicacion_terminales,
				       :engine, _self,
				       :enabled?, _true ,
				       :action_message, :genera_plano_reubicacion_terminales|()| ))
	
	
	_self.add_action(sw_action.new(:plano_de_construccion_interno,
				       :engine, _self,
				       :enabled?, _false,
				       :action_message, :genera_plano_de_construccion_interno|()| ))
	
	
	#planos de fibra local
	_self.add_action(sw_action.new(:plano_esquematico_de_principales,
				       :engine, _self,
				       :action_message,:genera_plano_de_esquematico_de_principales|()|))
	
	
	_self.add_action(sw_action.new(:plano_ruta_de_cables_fo,
				       :engine, _self,
				       :action_message, :genera_plano_ruta_cables_fo|()|))

	
	_self.add_action(sw_action.new(:plano_detalles_cable_fo,
				       :engine, _self,
				       :action_message, :genera_plano_detalles_cables_fo|()| ))
	
	
	#  planos de troncal de red suburbana.	
	_self.add_action(sw_action.new(:plano_ruta_de_cables_fo_lar,
				       :engine, _self,
				       :enabled?, _true ,
				       :action_message, :genera_plano_ruta_de_cables_fo_lar|()| ))
	
	_self.add_action(sw_action.new(:plano_detalles_cable_fo_lar,
				       :engine, _self,
				       :enabled?, _true ,
				       :action_message, :genera_plano_detalles_cable_fo_lar|()| ))
	
	_self.add_action(sw_action.new(:plano_detalles_central_fo_lar,
				       :engine, _self,
				       :enabled?, _true ,
				       :action_message, :genera_plano_detalles_central_fo_lar|()| ))
	
	###  ACCCION NO_PLANO ###	
	_self.add_action(sw_action.new(:no_plano,:caption, "Ninguno",:enabled?, _false ))
	
	
	_self.databus << _self.application.databus
	
	_self.framework.databus.add_producer(_self)
	_self.framework.databus.add_consumer(_self)
	
_endmethod
