#$$$**************************** Alejandro Enriquez G. ******************
	LoArea      << bounding_box.new(100, 100, 10000, 8000)
	LoPTopo    << c_plano_topologico.new_with(:bounds,LoArea)		
	LoPtopo.genera_plano()
#************************************** 
#lyp.start_layout_designer()	

