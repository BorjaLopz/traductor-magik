									:plano_inventario_canalizacion),

				       :existente_secundaria,equality_set.new_with(:plano_de_construccion,
									:plano_de_bajantes,	   
									:plano_fcydg),
		
				       :fibra_local_principales,equality_set.new_with(
									:plano_ruta_de_cables_fo,
									:plano_esquematico_de_principales,
									:plano_detalles_cable_fo),
				       
				       :fibra_local_secundaria,equality_set.new_with(:plano_de_construccion, 
										     :plano_de_diagrama_de_empalmes),
				       				       
				       #fibra suburbanos
				       :fibra_principales_sub,equality_set.new_with(
									 :plano_detalles_cable_fo,
									 :plano_ruta_de_cables_fo_lar,
									 :plano_detalles_cable_fo_lar, 
									 :plano_obra_civil									   
									      ),
				       :maest_canalizacion,equality_set.new_with(:proyecto_canalizacion,
										 :plano_microcanalizacion) )
