_pragma(classify_level=restricted, usage={redefinable})
_method gen_planos_plugin.AddNorte(PoPage)
	## 
	##
_local LoBounds
_local LoNorte
_local LoPage

        LoPage<<PoPage
	
	_if LoPage _isnt _unset _andif LoPage.is_kind_of?(layout_page)
	_then
		Lobounds<<bounding_box.new(LoPage.bounds.xmin,LoPage.bounds.ymax-1500,
					   LoPage.bounds.xmin+1000,LoPage.bounds.ymax)
		LoNorte << c_norte.new_with(:bounds,Lobounds)
		LoNorte.limites<<_unset
		LoPage.add_element(LoNorte)
	_endif
_endmethod
$
_pragma(classify_level=restricted, usage={redefinable})
_method gen_planos_plugin.AddViewport(PoPage,PyTipoDeVp,PoViewMapperPlugin,_optional LoDatos_viewport )
	## 
	##
	_local LoPage
	_local LoViewport
	
	LoPage<<PoPage
	
        _if LoPage _isnt _unset _andif LoPage.is_kind_of?(layout_page)
	_then
		_if PyTipoDeVp _is :c_vp_ruta_de_cables_fo
		_then
			LoViewport<<c_vp_ruta_de_cables_fo.new_with(:bounds, LoPage.bounds)
			LoViewport.oEstructuras << LoDatos_viewport[2]
			LoViewport.oElementos << LoDatos_viewport[3][1]
			LoViewport.oLimite << LoDatos_viewport[1].sectors.as_sector()			
			LoMapView<<_self.GetMapView(LoViewport.oLimite) 
			PoViewMapperPlugin.map_viewport_on_map_view(LoViewport,LoMapView,
								    LoMapView.current_view_bounds.new_enlarging(1.5), _true)			
			LoPage.add_element(LoViewport)
			LoPage.layout_document.user!_tipo_plano << :ruta_cables_fo
			
			# agregamos el sig. viewport para el croquis de ubicación
                        LoDetalleViewport <<  c_vp_plano_croquis.new_with(:bounds,bounding_box.new(LoPage.bounds.xmax-1950,
												   LoPage.bounds.ymax-1500,
												   LoPage.bounds.xmax-300,
												   LoPage.bounds.ymax-300))
			
			#linea << composite_line_style.new(line_style.new_with_properties(:foreground_colour,
			#								 colour.called(:black),:with,1))
			#LoDetalleViewport.outline_style << linea
			
			PoViewMapperPlugin.map_viewport_on_map_view(LoDetalleViewport,LoMapView,
								    LoMapView.current_view_bounds, _true)
			LoPage.add_element(LoDetalleViewport)
			
			# agregamos el titulo del croquis
			#LoText << textbox_layout.new_with(:bounds,bounding_box.new(550,6850,1250,6950 ))
			#LoText.text << "Croquis de Localización"
			#LoText.outline_style << _unset
			#LoPage.add_element(LoText)
			LoMapView<<_self.GetMapView(LoViewport.oLimite) 
		_endif
	_endif
	
_endmethod
$
_pragma(classify_level=basic)
_method gen_planos_plugin.ajustar_escala_plano(mapa)
	## 
	## Objetivo: Ajusta la escala de la vista a una de las
	## contenidas en la constante limites_escala 
	## Parametros de Entrada: Ninguno
	## Parametros de Salida: Ninguno   
	## Autor: Elena Sainero (Ten Sails Consulting)
	## Fecha de Creacion: Diciembre 2005
	##
	
	escala << mapa.view_scale
	
	_for val _over _self.limites_escala.fast_elements()
	_loop
		_if escala < val _or escala = val _then
			_if val/escala < 1.1 _then
				# dado que el viewport es menor que el layout, si la escala de
				# la vista es muy proxima a la de la central puede que esta no
				# se represente completa en el plano. Por ello analizamos que
				# la escala actual de la vista (que ajusta a la central) y la
				# escala a la que vamos a representar tenga un margen del 10%
				mapa.view_scale << val*1.1
			_else
				mapa.view_scale << val
			_endif
			_leave 
		_endif
	_endloop
	
_endmethod
$
_pragma(classify_level=restricted, usage={redefinable})
_method gen_planos_plugin.busca_elemento(PoPagina,PsElemento)
	
	_local LbBandera << _false
	_local LoElemento << _unset 
	
	_for i  _over PoPagina.elements()
	_loop
		
		_if i.class_name = "marco_layout" _and i.class_name = PsElemento
		_then
			LbBandera  << _true
			LoElemento << i
			_leave 
		_elif  i.class_name = "viewport_layout"
		_then 
			
			_if i.name.slice(1,9).eq?("Larguillo") 
			_then
				LbBandera  << _true
				LoElemento << i
			_endif
		_endif
		
	_endloop
	
	_return LbBandera,LoElemento 
	
_endmethod
$
_method gen_planos_plugin.cable?()
	#----------------------------------------------------------
	#----------------Verifica que existe cable o
	# canalización seleccionado....
	
	_local Lopaf          << smallworld_product.pni_application()	
	_local LoMapa        << LoPaf.plugin(:map_plugin)
	_local LoMv          << LoMapa.current_map
	_local LoCan         << rope.new()                     
	_local LoSeleccion   <<  LoMv.current_selection 
	
	_local LoNNumTramo <<  _unset 
	_local LoNNumRuta  <<  _unset 
	
	
	_for LnI  _over LoSeleccion.elements()
	_loop
		_if LnI.rwo.rwo_type = "sheath"  _or LnI.rwo.rwo_type = "underground_route"
		_then
			LoCan.add(LnI)			
		_endif
	_endloop

	_if 	LoCan.size = 0 
	_then
		_self.show_message( _self.message(:cable))
		_return _unset,_unset 
	_endif


	_if LoCan.an_element().rwo.rwo_type = "sheath"
	_then
		LoNNumTramo << LoCan.an_element().rwo.user!_num_tramo
		LoNNumRuta  << LoCan.an_element().rwo.user!_num_ruta	
	_else
	
		LvCables << LoCan.an_element().rwo.cables()

		_for i  _over LvCables.elements() 
		_loop

			_if  i.source_table_name = "sheath"
			_then
				LoNNumTramo << i.user!_num_tramo
				LoNNumRuta  << i.user!_num_ruta
				_leave 
			_endif
	       
		_endloop
	
	
	_endif

	_return  LoNNumTramo, LoNNumRuta	
	
_endmethod
$
_method gen_planos_plugin.Elementos_comunes(PoNNumTramo,PoNNumRuta)
	## Elementos comunes para planos  de detalle
	##	
	_local LoPaf                   << smallworld_product.pni_application()
	_local lolyp                   <<  paf.plugin(:layout_plugin)
        lolyp.start_layout_designer()
	
	_local LnAnchoSello            << 1800 
	_local LnAnchoCroquis          << 50 # (05/03/03 ahernan) : No lleva croquis
	_local LnEspacio               << 300
	_local LnEspacioArrAbaIzqder   << 100
	_local LnEspacioIzquierdaSello << 50
	_local Lolyd                   << lolyp.dialogs[:layout_designer]	
	_local Lolym                   << Lolyd.plugin(:layout_manager)
	_local LoPagina                << LoLym.current_document.current_page		
	#-------------------------------------------------------
	#Agrega marco.	
	#--------------------------------------------------------
	LoMarco         << marco_layout.new()	
	LoMarco.num_mod <<   7
	LoMarco.sello   <<  LnAnchoSello  +  LnAnchoCroquis + 200
	LoMarco.set_fill_colour(_unset )
	LoMarco.set_colour(_unset)
	LoPagina.add_element(LoMarco)	
	#---------------------------------------------------------------------
	#Sello de Observaciones
	#---------------------------------------------------------------------	
	LnInicio_X << 300 # 25 mm del borde izquierdo de la pagina 
	LnInicio_Y << 100  # 7.5 mm del borde inferior de la pagina
	
	#altura total de la tabla. 1mm =10 pixeles
	LnAltura << 2600 # 91 mm
	LnAncho  << 1800 # 88 mm
	vparea   << bounding_box.new(LnInicio_X, LnInicio_Y, LnInicio_X + LnAncho, LnInicio_Y + LnAltura )
	LoSello  <<c_sello_observaciones.new_with(:bounds, 	vparea)
	
	#---------------------------------------------
	# (05/04/08 ahernan) : Pendiente confirmar.
	#---------------------------------------------
	LoSello.asigna_num_tramo(PoNNumRuta.write_string ,  PoNNumTramo.write_string )
	LoSello.Inicializa()
	LoPagina.add_element(LoSello)
	LoSello.Agrega_LYM(Lolym)
	
_endmethod
