_pragma(classify_level=restricted, usage={redefinable})
_method gen_planos_plugin.plano_inventario_canalizacion()
	## 
	## 
	#  Objetivo: genera el plano de Division de ashurado.
	#  Parámetros de entrada:  Ninguno.
	#                                  
	#  Parámetros de salida:     Ninguno.
	#                                   
	#  Regresa:  Ninguno.
	#  Fecha de última modificación: 17 Enero 2006
	#  Creado por: jtlelo
	#  
	paf << smallworld_product.pni_application()
        
	LoObjetoEnEditor << _self.validar_generar_plano_distritos()
	LoProyecto       << swg_dsn_admin_engine.active_scheme.project
        lyd              << paf.plugin(:layout_plugin).start_layout_designer()
	_if lyd _isnt _unset 
        _then
	        lym      << lyd.plugin(:layout_manager)
              	LoDoc    << lym.current_document
		LoDoc.user!_tipo_plano << :inventario_canalizacion
		LoPage   << LoDoc.current_page
		_if LoPage.elements.size>0
		_then
			LoPage.elements.empty()
		_endif
       _else
	       _return
       _endif
 
       LoDibujaPlano                    << c_geom_set_layout.new_with(:bounds,bounding_box.new(10,10,100,100))
       LoDibujaPlano.outline_style      << _unset
       LoDibujaPlano.oAppLayoutDesigner << lyd
       LoDibujaPlano.oRegistro          << LoObjetoEnEditor
       LoDibujaPlano.nIdRegistro        << LoObjetoEnEditor.id
       LoDibujaPlano.nMargenVp          << 800
       LoDibujaPlano.sNombreAce         << "CENT_PLANOS"
       LoDibujaPlano.sTipoPlano         << "CANALIZACION"
       # (06/05/05 jtlelo) : se creo un metodo para generar el nombre
       # del plano, conforme al caso de uso GENERAR PLANO

       LoMunicipio << LoObjetoEnEditor.municipio.default("")
       LoEstado    << LoObjetoEnEditor.estado.default("")
       LoCentral   << LoObjetoEnEditor.user!_central.default("")
       LoNombre    << LoObjetoEnEditor.user!_nombre.default("")

       
#	_if (LoMunicipio<<LoObjetoEnEditor.municipio) _is _unset 
#	_then
#		LoMunicipio << ""
#	_endif
#	_if (LoEstado<<LoObjetoEnEditor.estado) _is _unset 
#	_then
#		LoEstado << ""
#	_endif
#	_if (LoCentral<<LoObjetoEnEditor.user!_central) _is _unset 
#	_then
#		LoCentral << ""
#	_endif
#	_if (LoNombre << LoObjetoEnEditor.user!_nombre) _is _unset 
#	_then
#		LoNombre << ""
#	_endif
	_if LoMunicipio = "" _andif LoEstado = ""
	_then
		LoMunEstado << ""
	_else
		LoMunEstado << LoMunicipio+", "+LoEstado+newline_char
	_endif
	
       LoDibujaPlano.sNombrePlano       << "PLANO INVENTARIO DE CANALIZACION"+ newline_char+
					   "CTL - "+LoCentral+" "+LoNombre+newline_char+
					   LoMunEstado+
					   "ESC. 1:"

       LoDibujaPlano.modulos_ancho      << 6
       LoDibujaPlano.modulos_alto       << 3
       
       lym.current_document.current_page.add_element(LoDibujaPlano)
       
_endmethod
$
_pragma(classify_level=restricted, usage={redefinable})
_method gen_planos_plugin.plano_itinerario()
#  Objetivo: Escriba aquí el objetivo.
#  Parámetros de entrada:  Ninguno.
#                                  
#  Parámetros de salida:     Ninguno.
#                                   
#  Regresa:  Ninguno.
# Fecha de última modificación: 24 feb 2005
# Autor de la modificación bfpalaci
# Descripción de la modificación: Nuevo.	
	
	paf << smallworld_product.pni_application()

        LoObjetoEnEditor << _self.validar_generar_plano_distritos()

	lyd << paf.plugin(:layout_plugin).start_layout_designer()
	_if lyd _isnt _unset 
	_then
		lym    << lyd.plugin(:layout_manager)
		LoDoc  << lym.current_document
		LoDoc.user!_tipo_plano << :itinerario
		LoPage << LoDoc.current_page
		_if LoPage.elements.size > 0
		_then
			LoPage.elements.empty()
		_endif
	_else
		_return
	_endif

	LoDibujaPlano                    << c_geom_set_layout.new_with(:bounds,bounding_box.new(10,10,100,100))
	LoDibujaPlano.outline_style      << _unset
	LoDibujaPlano.oAppLayoutDesigner << lyd
	LoDibujaPlano.oRegistro          << LoObjetoEnEditor
	LoDibujaPlano.nIdRegistro        << LoObjetoEnEditor.id
	LoDibujaPlano.nMargenVp          << 800
	LoDibujaPlano.sNombreAce         << "CENT_PLANOS"
	LoDibujaPlano.sTipoPlano         << "ITINERARIO"
	# (06/05/05 jtlelo) : se creo un metodo para generar el nombre
        # del plano, conforme al caso de uso GENERAR PLANO

	_if (LoCentral<<LoObjetoEnEditor.user!_central) _is _unset 
	_then
		LoCentral << ""
	_endif

        LoDibujaPlano.sNombrePlano       << LoCentral + newline_char + "ITINERARIO DE CANALIZACION"
	LoDibujaPlano.modulos_ancho      << 6
	LoDibujaPlano.modulos_alto       << 3
	
	lym.current_document.current_page.add_element(LoDibujaPlano)
	
_endmethod
$
_pragma(classify_level=restricted, usage={redefinable})
_method gen_planos_plugin.plano_obra_civil()
#  Objetivo: genera el plano de Division de ashurado.
#  Parámetros de entrada:  Ninguno.
#                                  
#  Parámetros de salida:     Ninguno.
#                                   
#  Regresa:  Ninguno.
#  Fecha de última modificación: 2 Junio 2015
#  Creado por: rmrosale
	_dynamic !print_float_precision!	
	!print_float_precision! << 10 	
	_local distancia_total << 0.0
        _local lo_map
	_local trazo

	_if swg_dsn_admin_engine.active_scheme _isnt _unset #_andif
	_then
		lo_map << smallworld_product.pni_application().plugin(:map_plugin).trail_owner
		
		_if lo_map.trail.current_sector _isnt _unset _andif lo_map.trail.current_sector.closed? _andif 
		    lo_map.current_selection.size > 0
		_then
			trazo << pseudo_area.new(lo_map.trail.sectors)
			trazo.world << lo_map.world.source_world.worlds.an_element()
			_for reg _over lo_map.current_selection.elements()
			_loop
				_if reg.rwo.is_kind_of?(underground_route) _andif
				    reg.rwo.construction_status = "PROYECTADO"
				_then
					_if reg.rwo.measured_length.value = 0
					_then
						distancia_total +<< reg.rwo.calculated_length.value
					_else
						distancia_total +<< reg.rwo.measured_length.value
					_endif										
				_endif
				

			_endloop
			
			_if distancia_total > 500
			_then
				planoobracivil << c_plano_obra_civil.new(trazo,distancia_total)
				planoobracivil.genera_plano()
			_else
				smallworld_product.pni_application().show_message(_self.message(:trayectoria_quinientos))
			_endif
		_else
			smallworld_product.pni_application().show_message(_self.message(:falta_trazo))
		_endif
	_else
		smallworld_product.pni_application().show_message(_self.message(:proyecto_cobre_msg))
	_endif
	
	
_endmethod
$
