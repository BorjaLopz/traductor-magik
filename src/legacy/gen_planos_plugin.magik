_pragma(classify_level=restricted, usage={redefinable})
_method gen_planos_plugin.sw_databus_data_available(data_type_name,data)
	## 
	##

# (22/11/01 des_aaron) : 	w("gen_planos_plugin.sw_databus_data_available",data_type_name,data)
	
	_if data_type_name _is  :trace_results
	_then
		.trace_results << data
	_endif
	
	
	_if data_type_name _is :map_selection #_or data_type_name _is :record_selection)
	_then
		_if data[2].an_element() _isnt _unset 
		_then
			LoDato<<data[2].an_element().rwo
		_endif
		
		_self.action(:plano_de_construccion_interno).enabled?<<LoDato.is_kind_of?(user!_building) 
	_elif data_type_name _is :record_selection
	_then
		LoDato<<data[2].an_element()
		_self.action(:plano_de_construccion_interno).enabled?<<LoDato.is_kind_of?(user!_building) 
	_endif
	
	_if data_type_name _is :active_map_view
	_then
		_self.action(:plano_de_construccion_interno).enabled?<<
			_self.action(:plano_de_construccion_interno).enabled? _andif 
			data.world.universe_id=0
	_endif

	_if data_type_name _is :info_enlace _andif data _isnt _unset 
	_then
		_self.o_ruta  <<   hash_table.new()  
		_self.o_ruta[:engine] << data
		_self.o_ruta[:oenlace] <<  _self.get_enlace()
		
		_self.o_ruta[:oestructuras]  << data.sys!slot(:osheathtrace).sys!slot(:oestructuras)
		_self.o_ruta[:ocanalizacion] << data.sys!slot(:osheathtrace).sys!slot(:ocanalizacion)
		_self.o_ruta[:ocables]       << data.sys!slot(:osheathtrace).sys!slot(:ocables)
		_self.o_ruta[:oelementos]    << data.sys!slot(:osheathtrace).sys!slot(:oelementos)
		_self.o_ruta[:obasinicio]    << data.sys!slot(:osheathtrace).sys!slot(:obasinicio)
		_self.o_ruta[:obasfinal]    <<  data.sys!slot(:osheathtrace).sys!slot(:obasfinal)
		_self.o_ruta[:oBasFinalycable] <<  data.sys!slot(:osheathtrace).sys!slot(:oBasFinalycable)

	_elif data_type_name _is :info_acometida _andif data _isnt _unset  
	_then
		_self.o_ruta  <<   hash_table.new()  
		_self.o_ruta[:engine]        << _unset
		_self.o_ruta[:ocables]       <<  data[:ocables]
		_self.o_ruta[:oestructuras]  <<  data[:oestructuras]
		_self.o_ruta[:oelementos]    <<  data[:oelementos]
		_self.o_ruta[:obasfinal]    <<   data[:obasfinal]
			
	_endif

	_if  data_type_name _is :data_viewport_obra_publica
	_then
		_local datos << rope.new()
		_for d _over data.elements()
		_loop
			datos.add(d.rwo)
		_endloop
		_self.o_ruta << datos
	_endif
	
_endmethod
$
