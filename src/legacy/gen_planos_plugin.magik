_pragma(classify_level=restricted, usage={redefinable})
_method gen_planos_plugin.manage_actions()
	## Caso de Uso:       Administracion de Proyectos
	## Objetivo:          Establece las acciones que deben aparecer
	## en el desplegable de planos en funcion del tipo de proyecto activo  

	LoPaf <<  _self.application
	a_gui_item << _self.framework.get_gui_element_with_role( :planos_especificos )
	sch << swg_dsn_admin_engine.active_design

	_if sch _is _unset 
	_then
		a_gui_item.associate.label << _self.message(:planos_proyecto)		
		a_gui_item.empty()		   
		_return
	_else
		LoProyecto << sch.project
		(tipo, subtipo) << Loproyecto.tipo_y_subtipo()
		
		a_gui_item.associate.label << _self.message(:planos_proyecto)
		a_gui_item.empty()
				
		_if LoProyecto  _isnt _unset _andif
		      (LoProyecto.job_type = _self.message(:proyecto_existente))
		_then
			a_gui_item.associate.label << _self.message(:planos_existente)
			tipos_plano << _self.planos_por_tipo[:existente]

			_if sch.tipo_diseno.write_string = "captura_red_existente"
			_then
				tipos_plano << _self.planos_por_tipo[:existente_principales]
				
			_elif sch.tipo_diseno.write_string = "secundaria" 
			_then
				tipos_plano << _self.planos_por_tipo[:existente_secundaria]
			_endif

			
		_elif LoProyecto  _isnt _unset _andif (LoProyecto.job_type.lowercase = _self.message(:proyecto_fibra).lowercase) 
		_then
			a_gui_item.associate.label << _self.message(:planos_proyecto)

			_if sch.tipo_diseno.write_string = "principales"
			_then				
				tipos_plano << _self.planos_por_tipo[:fibra_local_principales]
			
			_elif sch.tipo_diseno.write_string = "secundaria" 
			_then
				tipos_plano << _self.planos_por_tipo[:fibra_local_secundaria]
			_elif  sch.tipo_diseno.write_string = "canalizacion"
			_then
				tipos_plano << _self.planos_por_tipo[:maest_canalizacion]
			_endif
		_elif LoProyecto  _isnt _unset _andif (LoProyecto.job_type.lowercase = _self.message(:proyecto_cobre).lowercase)  
		_then
			a_gui_item.associate.label << _self.message(:planos_proyecto)
			
			_if sch.tipo_diseno.write_string = "principales"
			_then				
				tipos_plano << _self.planos_por_tipo[:cobre]
				
			_elif sch.tipo_diseno.write_string = "secundaria" 
			_then
				tipos_plano << _self.planos_por_tipo[:cobre_secundaria]
			_elif  sch.tipo_diseno.write_string = "canalizacion"
			_then
				tipos_plano << _self.planos_por_tipo[:maest_canalizacion]
			_endif
						
		_endif
		
		_if tipos_plano _isnt _unset _andif  tipos_plano.size = 0
		_then
			tipos_plano.add(:no_plano)
			_return 
		_endif

		
		_if tipos_plano _isnt _unset 
		_then
			_for pl _over tipos_plano.fast_elements()
			_loop				                		
				an_action << _self.action(pl)
				an_action.place_control_on( a_gui_item, :menu )
			_endloop
			
		_endif
		
	_endif
	
		
_endmethod
$
_pragma(classify_level=basic)
_method gen_planos_plugin.plano_de_construccion()

	paf << smallworld_product.pni_application()
	mpg << paf.plugin(:map_plugin)
	sch<< swg_dsn_admin_engine.active_scheme
	LoProyecto<< sch.project
	
	_if swg_dsn_admin_engine.active_scheme _is _unset
	_then
		paf.show_message( _self.message(:diseño_activo))
		_return 
	_endif
        

       fibra? << (   LoProyecto  _isnt _unset _andif sch.tipo_diseno = :secundaria _andif 
		 swg_dsn_admin_engine.active_design.id_dto_optico   _isnt _unset) 
       
       _if fibra?
       _then
		_self.plano_de_construccion_fo()
		_return _true
	_endif

       # START CHANGE
       # (22/07/06 des_aaron) : sw526
       #
       lyp <<  paf.plugin(:layout_plugin)
       lyp.start_layout_designer()
       lyd << lyp.dialogs[:layout_designer]
       
       #
       # END CHANGE

	lym                    << lyd.plugin(:layout_manager)
	LoDoc                  << lym.current_document
	LoDoc.user!_tipo_plano << :construccion
	LoPage                 << LoDoc.current_page	
	
	LoSelloSimbolos    << c_simbologia_plano_construccion.new_with(:bounds,bounding_box.new(2100,600,2932,1753 ))
	LoSelloCapacidades << c_tabla_capacidades.new_with(:bounds,
							    bounding_box.new(2100,1870,2610,3000 ))
	LoPage.add_element(LoSelloCapacidades)
	LoPage.add_element(LoSelloSimbolos)

	LoTituloPlano << "PLANO DE CONSTRUCCIÓN" +%newline
	
        LoStrDit << sch.user!_distrito.user!_distrito.default("")
	LoStrProg<< sch.project.user!_programa_tipo.default("" )
	LoStrAnyo<< sch.project.user!_programa_anyo.default("" )
	LoTituloPlano +<< LoStrDit + % +%/ + % + LoStrProg + %- + LoStrAnyo
	
	LoDibujaPlano << c_geom_set_layout.new_with(:bounds,bounding_box.new(10,10,100,100))	
	LoDibujaPlano.outline_style      << _unset
	LoDibujaPlano.oAppLayoutDesigner << lyd
	LoDibujaPlano.oRegistro          << sch.user!_distrito
	LoDibujaPlano.nIdRegistro        << sch.user!_distrito.id
	LoDibujaPlano.nMargenVp          << 800
	LoDibujaPlano.sNombreAce         << "001 - P Construccion FTTH"
	LoDibujaPlano.sTipoPlano         << "CONSTRUCCION"
	LoDibujaPlano.sNombrePlano       << LoTituloPlano
	LoDibujaPlano.modulos_ancho      << 4
	LoDibujaPlano.modulos_alto       << 2		
	LoPage.add_element(LoDibujaPlano)
_endmethod
$
_pragma(classify_level=basic)
_method gen_planos_plugin.genera_plano_de_diagrama_de_empalmes()


	## ( 12/08/2008 fhramire ) : metodo para activar la interface de
	## arbol_cables_fo_central y permitir seleccionar al usuario el cable
	## para generar plano de ruta.
	## Permite Obtener los cables en proyectos RDA, ROF, TRONCAL 
	#LoDtoOptico << swg_dsn_admin_engine.active_scheme.distrito_optico
	#LoPlano     << c_plano_diagrama_de_empalmes.new()
	#LoPlano.genera_plano(LoDtoOptico)
	
	paf << smallworld_product.pni_application()
	mv << paf.plugin(:map_plugin).current_map_view 
	sch            << swg_dsn_admin_engine.active_design
	LoProyecto     << sch.project	  
	LoCentral      << Loproyecto.user!_central 
	
	_if mv.ace_name _is :gs!schematic 
	_then
		LoEng   << c_engine_ruta_cables.new()
		LoPlano << c_plano_diagrama_de_empalmes.new(LoEng)	
		LoPlano.genera_plano(swg_dsn_admin_engine.active_design.user!_distrito_optico)
	_else

		_self.show_message("Debe seleccionar el mapa esquemático y tenerlo activo")
	
	_endif
	
	
_endmethod
