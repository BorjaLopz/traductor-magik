_pragma(classify_level=restricted, usage={redefinable})
_method gen_planos_plugin.plano_desmontaje_cd()
## Objetivo:              Construir el plano de
##                        desmontaje de caja de distribución.
## Parámetros de entrada: Ninguno.
## Parámetros de salida:  Ninguno.
## Regresa:               Ninguno.
## Autor:                 vnguzman
## Fecha de creación:     Lunes 20 de Marzo de 2006
#	paf << smallworld_product.pni_application()
#	paf.show_message(_self.message(:desarrollo))
#
#	_if swg_dsn_admin_engine.active_scheme _is unset
#	_then
#		paf.show_message( _self.message(:diseño_activo))
#		_return
#	_endif
#
#        _local LoPlano << c_plano_desmontaje_cd.new()
#	LoPlano.genera_plano()
# Autor:                          vnguzman
# ID de requerimiento:            Plano de desmontaje de caja
#                                 de distribución
# Fecha de modificación:          Lunes 31 de Julio de 2006
# Descripción de la modificación: Modifico la manera de crear
#                                 el plano
##       	_self.show_message(_self.message(:desarrollo))
	_local lo_diseño << swg_dsn_admin_engine.active_design
	_if lo_diseño _is _unset
	_then
		_self.show_message( _self.message(:diseño_activo))
		_return
	_endif
        _local lo_plugin_mapa << smallworld_product.pni_application().plugin(:map_plugin)
        _local lo_mapa        << lo_plugin_mapa.current_map
	_if lo_mapa.ace_name <> "CENTRALES"
	_then
		_self.show_message(_self.message(:ace))
		_return
	_endif
        _local lo_vista_mapa << lo_plugin_mapa.current_map_view
        _if lo_vista_mapa.view_scale <> 200
        _then
                lo_vista_mapa.view_scale << 200
        _endif
        _local lo_area << pseudo_area.new_with(lo_vista_mapa.current_view_boundary)
        lo_area.world  << lo_mapa.world
        _local lo_plugin_layout   << smallworld_product.pni_application().plugin(:layout_plugin)
        _local lo_layout_designer << lo_plugin_layout.layout_designer
	_if lo_layout_designer _is _unset
	_then
		lo_layout_designer << lo_plugin_layout.start_layout_designer()
	_endif
	_local lo_layout_manager << _unset
	_local lo_pagina         << _unset
        _if lo_layout_designer _isnt _unset
	_then
		lo_layout_manager             << lo_layout_designer.plugin(:layout_manager)
		_local lo_documento           << lo_layout_manager.current_document
		lo_documento.name             << "Plano de desmontaje de caja de distribución"
		lo_documento.user!_tipo_plano << :desmontaje_cd
		lo_pagina                     << lo_documento.current_page
		_local lo_elementos_pagina    << lo_pagina.elements

		_if lo_elementos_pagina.size > 0
		_then
			lo_elementos_pagina.empty()
		_endif
	_else
		_return
	_endif
	_local lo_geom_set_layout             << c_geom_set_layout.new_with(:bounds, bounding_box.new(10, 10, 100, 100))
	lo_geom_set_layout.outline_style      << _unset
	lo_geom_set_layout.oAppLayoutDesigner << lo_layout_designer
	lo_geom_set_layout.oRegistro          << lo_area
	lo_geom_set_layout.nIdRegistro        << _unset
	lo_geom_set_layout.sIdRegistro        << _unset
	lo_geom_set_layout.nMargenVp          << 800
	_local lo_proyecto << lo_diseño.project
	_local lo_central  << lo_proyecto.user!_central
        _local ls_ruta     << lo_proyecto.job_type + "|" +
			      lo_central.user!_division + "|" +
			      lo_central.user!_area + "|" +
			      lo_central.user!_nombre + "|Proyecto : " +
			      lo_proyecto.user!_programa_anyo + "-" +
			      lo_proyecto.user!_programa_sec.write_string
	_local lo_diseño_padre << lo_diseño.inf_parent
        _if lo_diseño_padre <> " "
        _then
                ls_ruta << ls_ruta + "|" + lo_diseño_padre
        _endif
        ls_ruta << ls_ruta + "|" + lo_diseño.name
        lo_geom_set_layout.sNombrePlano  << ls_ruta
        lo_geom_set_layout.sNombreAce    << "Plano_desmontaje_CD"
        lo_geom_set_layout.sTipoPlano    << "Plano_desmontaje_CD"
        lo_geom_set_layout.modulos_ancho << 12
        lo_geom_set_layout.modulos_alto  << 1
        lo_pagina.add_element(lo_geom_set_layout)
# Fin de la modificación
_endmethod
$
_method gen_planos_plugin.plano_diagrama_de()
#  Objetivo: Escriba aquí el objetivo.
#  Parámetros de entrada:  Ninguno.
#                                  
#  Parámetros de salida:     Ninguno.
#                                   
#  Regresa:  Ninguno.
# Fecha de última modificación: 24 feb 2005
# Autor de la modificación bfpalaci
# Descripción de la modificación: Nuevo
 
	paf << smallworld_product.pni_application()
	_if swg_dsn_admin_engine.active_scheme _is _unset
	_then
		paf.show_message( _self.message(:diseño_activo))
		_return 
	_endif
	mpg << paf.plugin(:map_plugin)
	LoObjetoEnEditor << paf.plugin(:editor_manager).current_embedded_editor.current_object
	_if LoObjetoEnEditor _is _unset 
	_then
		paf.show_message( _self.message(:distribucion))
	#paf.show_message("Debe seleccionar una Caja de Distribución.")
		_return 
	_endif

	_if LoObjetoEnEditor.source_collection.name=:mit_terminal_enclosure
	_then
	#mpg.goto(LoObjetoEnEditor)
	_else
		paf.show_message( _self.message(:diagramae))
	#paf.show_message("Para un plano de diagrama de empalme, debe seleccionar una caja de distribución.")
		_return
	_endif

	lyd << paf.plugin(:layout_plugin).start_layout_designer()
	_if lyd _isnt _unset 
	_then
		lym     << lyd.plugin(:layout_manager)
		LoDoc  << lym.current_document
		LoPage << LoDoc.current_page
		_if LoPage.elements.size>0
		_then
			LoPage.elements.empty()
		_endif
	_else
		_return
	_endif

	LoDibujaPlano                    << c_geom_set_layout.new_with(:bounds,bounding_box.new(0,0,100,100))
	LoDibujaPlano.outline_style      << _unset
	LoDibujaPlano.oAppLayoutDesigner << lyd
	LoDibujaPlano.oRegistro          << LoObjetoEnEditor
	LoDibujaPlano.nIdRegistro        << LoObjetoEnEditor.id
	LoDibujaPlano.nMargenVp          << 500
	LoDibujaPlano.sNombrePlano       << "DiagramaEmpalmes"
	LoDibujaPlano.sNombreAce         << "Physical NI User"
	LoDibujaPlano.modulos_ancho      << 3
	LoDibujaPlano.modulos_alto       << 2

	lym.current_document.current_page.add_element(LoDibujaPlano)

_endmethod
