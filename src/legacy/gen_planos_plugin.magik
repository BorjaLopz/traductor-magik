_method gen_planos_plugin.post_activation()
	##
	## Autor: Elena Sainero (Ten Sails Consulting)
	## Fecha de Creación: Mayo 2006
	## Caso de Uso: Administracion de Proyectos
	## Objetivo: Creamos una dependencia con el proyecto activo
	## para calcular que planos deben poderse lanzar 
	## Parametros de entrada: N/A
	## Parametros de Salida: N/A
	##
	swg_dsn_admin_engine.add_dependent ( _self, :active_scheme )

	# manejamos las acciones correspondientes
	_self.manage_actions()

_endmethod
$
_pragma(classify_level=basic)
_method gen_planos_plugin.proyecto_can_ok()
	##  Proyecto de Canalizacion.
	##
	_local LoApp
	_local LoLayoutDesigner
	_local LoLayoutManager
	_local LoCurrentDocument
	_local LoSeccionamiento
	_local LoSecciones
	_local LoSector
	_local LiANCHO_MOD<<2100
	_local LiLARGO_MOD<<1800   #2700
	_local LiMAX_MODS<<10

	LoApp                      << smallworld_product.pni_application()
	LoMapPlugin                << LoApp.plugin(:map_plugin)
	LoLayoutDesigner           << LoApp.plugin(:layout_plugin).start_layout_designer()
	LoLayoutManager            << LoLayoutDesigner.plugin(:layout_manager)
	LoViewMapperPlugin         << LoLayoutDesigner.plugin(:viewport_mapper)
	LoCurrentDocument          << LoLayoutManager.current_document
	LoCurrentPage              << LoCurrentDocument.current_page
	LoCurrentDocument.user!_tipo_plano << :proyecto_canalizacion

	# START CHANGE
	# (09/08/13 ahernan) : 
	#
	LoDisenoActivo  <<  swg_dsn_admin_engine.active_scheme
	LoProyecto      << LoDisenoActivo.project
	LoProyectoFTTB? << LoProyecto.name.matches?("*FTTB*")
	
	Tipo_diseno <<  LoDisenoActivo.tipo_diseno
	Tipo_red    <<  LoDisenoActivo.name.subseq(1,5).lowercase
	
	#
	# END CHANGE
	
	
	_if swg_dsn_admin_engine.active_scheme.project.job_type = "Cobre" _orif
	    # (09/08/13 ahernan) : add. se agrego condicion.
	    (LoProyectoFTTB? _andif Tipo_red = "cobre")
	_then
		LoCurrentDocument.user!_oe << .oAdminProyFrmwrk.seleccion
		LoTramoCobre<<LoCurrentDocument.user!_oe.user!_tramo_cobre
		
	
	_elif swg_dsn_admin_engine.active_scheme.project.job_type = "Fibra_local"
	_then
		LoCurrentDocument.user!_oe_local << .oAdminProyFrmwrk.seleccion
		oe << .oAdminProyFrmwrk.seleccion
		LoTramoCobre<<oe.user!_tramo_cobre
	_endif

	# Obtener la canalizacion
	
#	LoTramoCobre<<LoCurrentDocument.user!_oe.user!_tramo_cobre

# START CHANGE
# (09/08/26 ahernan) : se alidan las geometrias del tramo de
# canalizacion pues puede ser que el user no salve cambios y
# la asignacion perdure pero los registros asignados no.
#
  _if LoTramoCobre.user!_det_t_can  _isnt  _unset _andif  
      LoTramoCobre.user!_det_t_can.user!_ruta_geo _isnt  _unset _andif
      LoTramoCobre.user!_det_t_can.user!_area_geo _isnt _unset 
  _then
	  LoSector<<LoTramoCobre.user!_det_t_can.user!_ruta_geo.sectors.as_sector()
  _else
	_self.show_message("problemas con el tramo de canalización. Verifique el tramo asignado")
	_return 
       _endif

#
# END CHANGE


	_if LoSector _isnt _unset _andif
	    LoSector.size>0
	_then
		
		LoMapView << LoMapPlugin.current_map_view
		LoMapView.goto_bounds(LoSector.bounds)
		
		# Generar seccionamiento.
		_if LoSector.size > 0
		_then
			LoSeccionamiento << c_seccionamiento.new(200,1,LiMAX_MODS,21,18)
			LoSeccionamiento.do_seccionamiento(LoSector)
			LoSecciones << LoSeccionamiento.get_vistas()
		_endif
	_else
		#Hacer nada
		_return 
	_endif

	#Crear Marco
	LoMarco       << c_marco.new_with(:bounds,bounding_box.new(0,0,1,1))
	LoMarco.Largo << LiMAX_MODS
	LoMarco.Alto  << 1
	LoMarco.set_fill_colour(_unset)

	#Crear Croquis
	LoCroquis << c_vp_croquis_proy_can.new_with(:bounds,bounding_box.new_with_size(LiANCHO_MOD+500,
										       LiLARGO_MOD/2.0+700,
										       8*100,
										       8*100))
	LoCroquis.oGeomCanalizacion << LoSector

	LoViewMapperPlugin.map_viewport_on_map_view(LoCroquis, LoMapView,
						    LoMapView.current_view_bounds.bounds.new_enlarging(1.6),
						    _true)

	#Crear Norte
	LoNorte << c_norte.new_with(:bounds,bounding_box.new_with_size(LiANCHO_MOD+500,LiLARGO_MOD/2.0,
								       400, 400))
	LoNorte.tamano << "B"
	LoNorte.limites << _unset

	# Seleccionar el detalle de tramo
	LoMapPlugin.current_map.clear_selection()
	LoMapPlugin.current_map.add_to_selection({LoTramoCobre.user!_det_t_can.user!_area_geo})
	# Entrar al mundo interno del detalle de tramo.
	LoApp.manager.enter_world()
	# Obtener la mapview del mundo interno
	LoMapView << LoMapPlugin.current_map_view

	# (2010-07-22 Aarón Hernández Ramírez, SIGMATAO) : obtiene  las
	# areas generadas por el seccionamiento generadas en
	# fire_post_insert action del detalle de tramo (user!_det_t_can)
	LcollAreas << rope.new()
	_for LoRec _over LoTramoCobre.user!_det_t_can.user!_det_t_can_areas.fast_elements()
	_loop
		#LcollAreas.add(LoRec.user!_area)
		LoBoundArea << bounding_box.new(LoRec.user!_area.bounds.xmin,
						LoRec.user!_area.bounds.ymin,
						LoRec.user!_area.bounds.xmax,
						LoRec.user!_area.bounds.ymax+LoRec.user!_area.bounds.height/2.0)
		LcollAreas.add(LoBoundArea)
	_endloop

	LiIdx << 1
	_loop
		# Agregar Marco
		LoCurrentPage.add_element(LoMarco)		
		# Agregar Sello
		# (09/11/17 lgranados) : Se desplaza el sello principal para que la ubicacion del plano sea visible.
		LoSello << c_sello_proyecto_canalizacion.new_with(:bounds,
								  bounding_box.new_with_size(LoMarco.bounds.xmin+0.5*400,
										             LoMarco.bounds.ymax-0.7*100,
											      26.5, 21))
		LoCurrentPage.add_element(LoSello)

		# (09/11/17 lgranados) : Se agrega la ubicacion del plano desplazando el sello principal.
		LoUbicacion << c_sello_ubicacion_fo.new_with(:bounds, bounding_box.new_with_size(LoMarco.bounds.xmin+0.5*100,
												 LoMarco.bounds.ymax-0.7*100,
												 26.5,
												 21))
		LoCurrentPage.add_element(LoUbicacion)
		# (09/11/17 lgranados) : fin de la modificacion.
		# Agregar Croquis
		LoCurrentPage.add_element(LoCroquis)
		# Agregar Norte
		LoCurrentPage.add_element(LoNorte)
		LoNorte.viewport_id<<LoCroquis.unique_id

		LiNumModules<<LoSecciones[LiIdx][4]
		LiXIni<<LoMarco.bounds.xmin+LiANCHO_MOD*2
		_loop
			
		     _if LiNumModules<=LiMAX_MODS
		     _then
		 	  LoMapView.goto_bounds(LcollAreas[LiIdx])
			  
			  LoPlanoN << c_vp_plano_proy_can.new_with(:bounds,
						  bounding_box.new_with_size(LiXIni,
					          LoMarco.bounds.ymin+50, LiANCHO_MOD*LoSecciones[LiIdx][4],
						  LiLARGO_MOD-100))
				
				LoPlanoN.xMin << LcollAreas[LiIdx].xmin
				LoPlanoN.yMin << LcollAreas[LiIdx].ymin
				LoPlanoN.xMax << LcollAreas[LiIdx].xmax
				LoPlanoN.yMax << LcollAreas[LiIdx].ymax
				
				LoBounding << LoMapView.current_view_bounds.bounds.new_enlarging(1.6)
				
				LoViewMapperPlugin.map_viewport_on_map_view(LoPlanoN,LoMapView,LoBounding,_true)
				
				LoPlanoN.view_scale << 2000
				LoPlanoN.ace_name<<"CANALIZACION"
				LoPlanoN.style_system_category<<"proyecto_canaliza"	
				LoCurrentPage.add_element(LoPlanoN)
				LiXIni << LiXIni+LiANCHO_MOD*LoSecciones[LiIdx][4]				
				LiIdx << LiIdx+1
			_else
				_leave
			_endif
			
			# (2010-07-22 Aarón Hernández Ramírez, SIGMATAO) : si existen
			# mas vistas se incrementa el numero de modulos para ver
			# cuantas van por hoja.
			_if LiIdx <= LoSecciones.size _andif
			    (LiMAX_MODS >=( LiNumModules + LoSecciones[LiIdx][4]))
			_then				
				LiNumModules << LiNumModules + LoSecciones[LiIdx][4]
			_else 
				_leave
			_endif
			
		_endloop 
		
		_if  LiNumModules >  LiMAX_MODS _andif
		LiIdx <= LoSecciones.size	 
		_then 
			LoCurrentDocument.add_page(layout_page.new(LoCurrentPage.paper_size))
			LoCurrentPage << LoCurrentDocument.page(LoCurrentDocument.number_of_pages())			
		_else 
			_leave
		_endif
		
	_endloop
	
_endmethod
$

_pragma(classify_level=basic)
_method gen_planos_plugin.plano_microcanalizacion()
	#---------------------------------------------------
	## <Req. #> : <Description>
	##
	#
	# Customization for Project : 
	#
	#---------------- Revision History -----------------
	# (22/09/07 des_leo) : Created
	#-------------- End Revision History ---------------
	w("aqui hay que implementar el plano de microcanalizacion")

	_dynamic !current_application!

	_if !current_application! _is _unset 
	_then
		!current_application! << _self.application
	_endif

	#w(!current_application!)

	mapa << !current_application!.plugin(:map_plugin).current_map
	#w(map)
	a_geom << mapa.current_selection.an_element()

	#w(a_geom)
	_if a_geom _is _unset _andif
	    mapa.trail.as_pseudo_geometry _is _unset 
	_then
		condition.raise(:user_error, :string, "Debe seleccionar una geometria en el mapa")
	_elif (a_psa << mapa.trail.as_pseudo_geometry) _isnt _unset
	_then
		_if  a_psa.geom_type _isnt :area _andif
		     a_psa.geom_type _isnt :simple_area
		_then
			condition.raise(:user_error, :string, "El trazo en el mapa debe ser de tipo area")
		_endif
	_endif

	_if a_psa _isnt _unset 
	_then
		a_geom << a_psa
	_endif
	
	_if a_geom.geom_type _isnt :area _andif
	    a_geom.geom_type _isnt :simple_area
	_then 
		condition.raise(:user_error, :string, "La geometria seleccionada debe ser de tipo area")	
	_endif

	LoPlanoMicrocan << c_plano_microcanalizacion.new()
	LoPlanoMicrocan.genera_plano(a_geom)
	
	_return 
	
_endmethod
$



_pragma(classify_level=restricted, usage={redefinable})
_method gen_planos_plugin.proyecto_canalizacion()
#  Objetivo: Genera el plano de Proyecto de canaizacion.
#  Parámetros de entrada:  Ninguno.
#                                  
#  Parámetros de salida:     Ninguno.
#                                   
#  Regresa:  Ninguno.
# Fecha de última modificación: 24 feb 2005
# Autor de la modificación bfpalaci
# Descripción de la modificació: adecuacion al estandar de magik

# (09/08/13 ahernan) : se valida para que el proyecto de
# canalizacion utilice las pbs de cobre o fibra segun
# corrsponda al tipo de diseno activo.
	
# (09/07/22 colivera) : si proyecto es  cobre
# (09/08/13 ahernan) :  o diseño de cobre de FTTB.
       # (14/03/31 rhernan) : par atencion de bug:5641. 
      _if swg_dsn_admin_engine.active_scheme _is _unset 
      _then
        _self.framework.show_message("No hay un diseño activo.")
       _return   
      _endif

      LoDisenoActivo  <<  swg_dsn_admin_engine.active_scheme
      LoProyecto      << LoDisenoActivo.project
      LoProyectoFTTB? << LoProyecto.name.matches?("*FTTB*")
      
      Tipo_diseno <<  LoDisenoActivo.tipo_diseno
      Tipo_red    <<  LoDisenoActivo.name.subseq(1,5).lowercase
      
      _if LoDisenoActivo.project.job_type = "Cobre" _orif
	  (LoProyectoFTTB? _andif Tipo_red = "cobre")
      _then
	      .oAdminProyFrmwrk << sw:info_contabilidad_framework.new (:info_contabilidad,
								       _self,
								       :config_definition_module_name,
								       "admin_proyectos",
								       :config_definition_file_name,
								       "info_contabilidad_config.xml",
								       :gui_definition_module_name,
								       "admin_proyectos",
								       :gui_definition_file_name,
								       "info_contabilidad_gui.xml",
								       :proyecto,
								       swg_dsn_admin_engine.active_scheme.project,
								       :engine,
								       _self,
								       :accion_ok,
								       :proyecto_can_ok|()|,
								       :validador_seleccion,
								       :oei_sin_construir?|()| )
	      
	      
	      # (09/07/22 colivera) : si es fibra
      _elif swg_dsn_admin_engine.active_scheme.project.job_type = "Fibra_local"
      _then 
	      .oAdminProyFrmwrk << sw:info_contabilidad_framework_proy_canalizacion.new (:info_contabilidad_local,
											 _self,
											 :config_definition_module_name,
											 "admin_proyectos",
											 :config_definition_file_name,
											 "info_contabilidad_config.xml",
											 :gui_definition_module_name,
											 "admin_proyectos",
											 :gui_definition_file_name,
											 "info_contabilidad_gui.xml",
											 :proyecto,
											 swg_dsn_admin_engine.active_scheme.project,
											 :engine,
											 _self,
											 :accion_ok,
											 :proyecto_can_ok|()|,
											 :validador_seleccion,
											 :oei_sin_construir?|()| )
	      
      _endif
      
      
      top_frame << _self.top_frame
      #
      # No nos hacemos padre del combinar_disenos_framework
      # ya que esto crearía problemas en cuanto al cursor
      # 'busy'.
      #  
      .oAdminProyFrmwrk.activate_relative_to(_unset, "Proyecto de Canalización", top_frame, 50, 50 )
      
_endmethod
$
