_pragma(classify_level=restricted, usage={redefinable})
_method gen_planos_plugin.plano_estudio_conjunto()
	## 
	## Objetivo:              Genera el plano de Estudio de Conjunto
	## Parametros de Entrada: NingunooApp.plugin(:c_planos_principales_plugin).current_opb
	## Parametros de Salida:  Ninguno
	## Autor:                 Elena Sainero (Ten Sails Consulting)
	## Fecha de Creacion:     Diciembre 2005
	##

	 _if swg_dsn_admin_engine.active_scheme _is _unset 
         _then 
            _self.framework.show_message("No hay un diseño activo.")
            _return   
         _endif 

	paf              << smallworld_product.pni_application()
	#_self.validar_generar_plano_estudio_conjunto()
	
	LoObjetoEnEditor << _self.obtener_elemento_cabecera_estudio_conjunto()
	LoProyecto       << swg_dsn_admin_engine.active_scheme.project

	lyd << paf.plugin(:layout_plugin).start_layout_designer()
	_if lyd _isnt _unset 
	_then
		lym                    << lyd.plugin(:layout_manager)
		LoDoc                  << lym.current_document
		LoDoc.user!_tipo_plano << :estudio_conjunto
		LoPage                 << LoDoc.current_page
		_if LoPage.elements.size > 0
		_then
			LoPage.elements.empty()
		_endif
	_else
		_return
	_endif
	
	LoDibujaPlano                    << c_geom_set_layout.new_with(:bounds,bounding_box.new(10,10,100,100))
	LoDibujaPlano.outline_style      << _unset
	LoDibujaPlano.oAppLayoutDesigner << lyd
	LoDibujaPlano.oRegistro          << LoObjetoEnEditor
	LoDibujaPlano.nIdRegistro        << LoObjetoEnEditor.id
	LoDibujaPlano.nMargenVp          << 500
	LoDibujaPlano.sNombreAce         << "ESTUDIO_CONJUNTO"
	#
	# Steve Hall (Ten Sails Consulting) 12/05/06
	# Establecer tipo de plano
	#
	LoDibujaPlano.sTipoPlano         << "ESTUDIO_CONJUNTO"
	LoDibujaPlano.modulos_ancho      << 6
	LoDibujaPlano.modulos_alto       << 3


	# (06/07/07 jtlelo) : creamos el pie de plano
	LoMunicipio     << LoObjetoEnEditor.municipio.default("")
	LoEstado        << LoObjetoEnEditor.estado.default("")
	LoCentral       << LoObjetoEnEditor.user!_central.default("")
	LoNombre        << LoObjetoEnEditor.user!_nombre.default("")
	LoPrograma_tipo << LoProyecto.user!_programa_tipo.default("")
	LoPrograma_anyo << LoProyecto.user!_programa_anyo.default("")


#	_if (LoMunicipio << LoObjetoEnEditor.municipio) _is _unset 
#	_then
#		LoMunicipio << ""
#	_endif
#	_if (LoEstado << LoObjetoEnEditor.estado) _is _unset 
#	_then
#		LoEstado << ""
#	_endif
#	_if (LoCentral << LoObjetoEnEditor.user!_central) _is _unset 
#	_then
#		LoCentral << ""
#	_endif
#	_if (LoNombre << LoObjetoEnEditor.user!_nombre) _is _unset 
#	_then
#		LoNombre << ""
#	_endif
#	_if (LoPrograma_tipo << LoProyecto.user!_programa_tipo) _is _unset 
#	_then
#		LoPrograma_tipo << ""
#	_endif
#	_if (LoPrograma_anyo << LoProyecto.user!_programa_anyo) _is _unset 
#	_then
#		LoPrograma_anyo << ""
#	_endif
	_if LoMunicipio = "" _andif LoEstado = ""
	_then
		LoMunEstado << ""
	_else
		LoMunEstado << LoMunicipio+", "+LoEstado+newline_char
	_endif

       LoDibujaPlano.sNombrePlano       << "ESTUDIO DE CONJUNTO"+ newline_char+
					   "CTL - "+LoCentral+" ("+LoNombre+")"+
					   newline_char+LoMunEstado+
					   "PROGRAMA "+LoPrograma_tipo+" "+LoPrograma_anyo+newline_char+
					   "ESC. 1:"

	lym.current_document.current_page.add_element(LoDibujaPlano)	
	 
_endmethod
