_method layout_document.user!_oei << oei
        #
        # Asignar oei
        # Steve Hall (Ten Sails Consulting) 13/03/06
        #

	_if oei _is _unset 
	_then
		_return
	_endif 
		
        _self.user!_proyecto << oei.user!_opb.swg_dsn_project
        #
        # Asignar ruta, opb, y oei.
        #
        opb << oei.user!_opb
        v << mit_manager.modelit_dataset 
        ruta_tab << v.collections[:user!_ruta_co]
        ruta << ruta_tab.at ( opb.id_ruta )
        mh << message_handler.new ( :layout_document )
        _self.set_attribute (
        	mh.human_string (:user!_ruta).as_symbol(),
        	ruta.user!_numero )
        _self.set_attribute (
        	mh.human_string (:user!_opb).as_symbol(),
        	opb.user!_valor_opb )
        _self.set_attribute (
        	mh.human_string (:user!_oei).as_symbol(),
        	oei.user!_valor_oei )


_endmethod
