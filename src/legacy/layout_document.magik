_pragma(classify_level=restricted, usage={redefinable})
_method layout_document.user!_id_plano_canalizacion(tipo_plano,diseno)

	## Generar el nombre de un plano de canalizacion
	
	# Primer Caracter. / Obtener tramo a partir de la OE (cobre) o OE_Local (FO)


	rutasCTRL << _unset 
	
	Proyecto << diseno.project
        LoTipoProy << Proyecto.job_type
	
#	LoProyectoFTTB? << LoProyecto.name.matches?("*FTTB*")
	_if LoTipoProy = "Cobre"
	_then
		id << "1"
		LoOE << _self.user!_oe 
	_else
		(tipo_enlace, enlace) << _self.tipo_enlace_fo(diseno)
		id << _self.codigo_1_enlaces[tipo_enlace][1].write_string
		LoOE << _self.oe_lo
	_endif
	 
	_if  LoOE  _isnt _unset
	_then
  	   LoTramo << LoOE.user!_tramo_cobre		 
	_endif 
	
	# Caracteres del 2 al 6 siglas de central
	_if id <> "9" 
	_then		
		Ctrl << Proyecto.user!_central
		
		SiglasCentral << Ctrl.user!_central
				
		id +<< _self.llena_siglas_central(SiglasCentral)
		
	_elif LoTramo _isnt _unset
	_then 
		ColDists << gis_program_manager.cached_dataset(:landbase).collection(:user!_distrito)
		Distrito << ColDists.select(predicate.eq(:user!_distrito,LoTramo.user!_det_t_can.distritos))
		_if Distrito.size = 1
		_then
			SiglasCentral << Distrito.an_element().user!_central
			ColCtrls << mit_manager.modelit_dataset.collection(:building)
			Ctrl << ColCtrls.select(predicate.eq(:user!_siglas,SiglasCentral)) 
			
			_if Ctrl.size = 1
			_then
				SiglasCentral << Ctrl.an_element().user!_siglas
								
				id +<< _self.llena_siglas_central(SiglasCentral)
			_else
				id +<< "XXXXX"
			_endif
		_else
			_if diseno.project.name.matches?("*FALC*")
			_then
				SiglasCentral << diseno.project.siglas_central
				ColCtrls << mit_manager.modelit_dataset.collection(:building)
				Ctrl << ColCtrls.select(predicate.eq(:user!_siglas,SiglasCentral))
				id +<< _self.llena_siglas_central(SiglasCentral)
				ColCtrls << mit_manager.modelit_dataset.collection(:building)
				
##				_if  Ctrl.an_element().responds_to?(:user!_ruta_cos)
##				_then
##				      rutasCTRL << Ctrl.an_element().user!_ruta_cos
##				_endif			
			_else
				id +<< "XXXXX"
			_endif			
		_endif
	_endif

	
	# Caracteres 7 y 8 Ruta de Canalización

	_if rutasCTRL _isnt _unset _andif
	    rutasCTRL.size <> 0
	_then
		geomTramo << LoTramo.user!_det_t_can.user!_ruta_geo
		Ruta << rutasCTRL.select(predicate.interacts(:user!_limite,geomTramo))
		_if Ruta.size = 1
		_then
			NumRuta << Ruta.an_element().user!_numero.default("").write_string
		        id +<< _self.valida_2cifras(NumRuta)
		_else
			id +<< "XX"
		_endif
	_else
		id +<< "XX"
	_endif

      _if LoTramo _isnt _unset 
      _then    
	# Caracteres 9 y 10 número de Tramo de Canalización
	NumTramo << LoTramo.user!_numero_tramo.default("").write_string
        id +<< _self.valida_2cifras(NumTramo)

	# Caracter 11
	_if tipo_plano _is :proyecto_canalizacion
       	_then
		id +<< "P"
	_elif tipo_plano _is :desmontaje_cd
        _then
		id +<<"D"
	_elif tipo_plano _is :inventario_canalizacion
	_then
		id +<< "V"
	_endif 	
      _endif         
	
      id +<< _self.llena_del_11_al_21(diseno)
      _return id	   
	
_endmethod
$
_pragma(classify_level=restricted, usage={redefinable})
_method layout_document.user!_id_plano_cobre( tipo_plano, diseno )
        # Generar el nombre de un plano de cobre.

	# Primer Caracter.
        id << "1"

	# Caracteres del 2 al 6 siglas de central
        proyecto << diseno.project
        siglas_central << proyecto.user!_central.user!_central
	id +<< _self.llena_siglas_central(siglas_central)

	# Caracteres del 5/6 en adelante hast el 10/11
	div_geo << _self.tipos_plano[tipo_plano][2]
	
        _if div_geo _is :central # Plano a nivel de central
        _then
        	_if tipo_plano _is :division_distritos
        	_then
        		id +<< "DIVIS"
        	_elif tipo_plano _is :ashurado
        	_then
        		id +<< "ASHUR"
        	_elif tipo_plano _is :itinerario
        	_then
        		id +<< "ITINE"
        	_elif tipo_plano _is :estudio_conjunto
        	_then
        		id +<< "CONJU"
		_elif tipo_plano _is :inventario_canalizacion
        	_then
        		id +<< "RC"
        	_endif
        _elif div_geo _is :distrito #Planos a nivel distrito
        _then
		#diseno << swg_dsn_admin_engine.active_scheme
		#_if diseno _isnt _unset
		#_then
			NumDist << diseno.name.write_string.slice(4,7)
		#_endif
		
        	_if tipo_plano _is :construccion
        	_then	
        		id +<< NumDist.write_string + "C"
		_elif tipo_plano _is :bajantes
        	_then
			id +<< NumDist.write_string + "B"
		_elif tipo_plano _is :diagrama_empalmes
        	_then
			id +<< NumDist.write_string + "E"
        	_endif
	_elif  div_geo _is :ruta #Obtener numero de ruta
	_then
		opb << smallworld_product.pni_application().plugin(:gen_planos).opb_seleccionada
		_if opb _isnt _unset 
		_then
			LoNumRuta << opb.ruta.user!_numero
			_if LoNumRuta < 10
			_then
				LoNumruta << "0" + LoNumRuta.write_string
			_endif
		_else
			LoNumruta << ""
		_endif
		
		#planos a nivel ruta (principales)
		_if tipo_plano _is :ruta_cables
        	_then
			id +<<"RP"+LoNumruta+"R"
			
        	_elif tipo_plano _is :fosa_cables
        	_then
			id+<<"RP"+LoNumruta+"F"
		_elif tipo_plano _is :principales
		_then
			id+<<"RP"+LoNumruta+"E"
		_endif
	_endif 

	id +<< _self.llena_del_11_al_21(diseno)
	# (12/03/22 jtlelo) : se verifica la version del plano con el
	# caracter 16

	id << _self.obten_caracter_16(id)
        _return id
	
_endmethod
$
_pragma(classify_level=restricted, usage={redefinable})
_method layout_document.user!_id_plano_compa( tipo_plano, diseno )
	# INICIO DEL CAMBIO
	# (17/07/19 bernardoa) : 
	# Este metodo pretende generar el nombre de archivo para el
	# plano de comparticion centralizado
	# FIN DEL CAMBIO
	
	_local LoModuloActivo? << _false
	_local LoApp << smallworld_product.pni_application()
	_local LoSolicitudActual << _unset
	_local LoId << ""
	_local LoIdDiseno
	_local LoBitacoraDisenos
	_local LoBitacoraDiseno
	_local LoIdConcesionario
	_local LoTipoSolicitud	
	
	# (17/07/11 bernardoa) : Validamos que el modulo de
	# comparticion este activado
	LoPlugin << LoApp.plugin(:admin_solicitud)
	
	# Identificamos la presencia del plugin admin_solicitud
	_if LoPlugin _isnt _unset
	_then
		# Identificamos si el modulo esta activo
		LoModuloActivo? << LoPlugin.dialogs[:admin_solicitud_gui] _isnt _unset
		# Si el modulo esta activo 
		_if LoModuloActivo?
		_then
			# Validamos la presencia del engine del plugin de comparticion
			LoEngine << LoPlugin.engine
			_if LoEngine _is _unset 
			_then
				condition.raise(:user_error, :string, LoPlugin.message(:ld_engine_compa_vacio))
			_endif

			# Validamos la funcionalidad de la base de datos
			LoBD << LoEngine.dbcomp_infra
			# Intentamos hacer un commit para validar la presencia de
			# conexion MySQL
			_try
				LoBD.user.acp.commit()	
			_when db_system_error
				LoPlugin.reconectar_base_de_datos
				LoApp.show_message("Se reanudara el proceso de centralizado, por favor, espera...")
			_endtry			
			
			# Obtengo la informacion de la solicitud actual
			LoSolicitudActual << LoPlugin.solicitud_actual
			_if LoSolicitudActual _isnt _unset			    
			_then
				# Obtenemos el id de diseno
				LoIdDiseno << LoSolicitudActual.scheme_id
				_if LoIdDiseno _isnt _unset 
				_then
					# Convertimos a numero el id de diseno
					LoIdDiseno        << LoIdDiseno.write_string.as_number()
					# Obtenemos el registro de bitacora del diseno
					LoBitacoraDisenos << gis_program_manager.cached_dataset(:design_admin).
							     collection(:bitacora_disenios)
					LoBitacoraDiseno  << LoBitacoraDisenos.at(LoIdDiseno)
					# Si aun existe el registro de bitacora
					_if LoBitacoraDiseno _isnt _unset 
					_then
						# Reformateamos el id de concesionario a 3 digitos con relleno
						# de 0's
						LoIdConcesionario << LoSolicitudActual.idconcesionario.write_string.
								     space_pad(3, _true)
						LoIdConcesionario << LoIdConcesionario.replace_all_instances_of(" ", "0")
						# Identificamos el tipo de NIS, con base en sus elementos
						LoStream          << LoBD.user.sql_select("select tipo_nis('" +
											  LoSolicitudActual.num_solicitud_nis +
											  "')")
						LoTipoSolicitud   << LoStream.get()
						LoTipoSolicitud   << LoTipoSolicitud.as_property_list.an_element()
						LoStream.close()
						# Construimos el nombre del archivo pdf
						LoId << LoBitacoraDiseno.siglas_central     + %- +
							LoSolicitudActual.num_solicitud_nis +
							LoSolicitudActual.fase[1]           +
							LoIdConcesionario                   +
							LoTipoSolicitud							
					_else
						condition.raise(:user_error, :string, LoPlugin.message(:ld_bitacora_diseno_inexistente))
					_endif
				_else
					condition.raise(:user_error, :string, LoPlugin.message(:ld_id_diseno_inexistente))
				_endif
			_else				
				condition.raise(:user_error, :string, LoPlugin.message(:ld_solicitud_actual_inexistente))
			_endif			
		_else
			condition.raise(:user_error, :string, LoPlugin.message(:ld_modulo_compa_inactivo))
		_endif
	_else
		condition.raise(:user_error, :string, LoPlugin.message(:ld_no_existe_plugin_compa))
	_endif
	_return LoId
	
_endmethod
$
_method layout_document.user!_id_plano_ep(tipo_plano,ep)
# Generar el nombre de un plano de estudio de población.
#
# En la cadena se concatena el nombre del plano, el usuario
# creador, la fecha y la versión del EP (Letra asignada al alternativo).

#	id << "plano_de_"
#	id +<< _self.tipos_plano[tipo_plano][3] + "_"
#	id +<< _self.tipos_plano[tipo_plano][2] + "_"
#        id +<< ep[2].user!_generado_por + "_"
#
#	fecha << date_time.now()
#        str << internal_text_output_stream.new()
#        fecha.format_to(str,"#d#m#y")
#
#	id +<< str.string + "_"	
#	id +<< ep[2].user!_secuencia.write_string
#
#	_return id.uppercase

	# Primer Caracter.
	id << "2"

	# Caracteres del 2 al 9 nombre de la población
        Poblacion << ep[1].user!_nombre_poblacion
     
        _if (long << Poblacion.size) < 8
        _then
        	Poblacion +<< char16_vector.new(8-long).fill_with(%_)
	_elif long > 8
	_then 
		Poblacion << Poblacion.slice(1,8)
        _endif
	
	id +<< Poblacion
	
	# Caracter 10 Tipo de plano de EP
	id +<< _self.tipos_plano[tipo_plano][4]

	# Caracteres del 11 al 21
        id +<< _self.llena_del_11_al_21(_unset ,ep)

        _return id
	
_endmethod 
$
_pragma(classify_level=restricted, usage={redefinable})
_method layout_document.formatea_cadena(longitud,caracter_inicial, valor_cadena )

	
	arreglo << simple_vector.new( longitud)
	valor << ""
	_for indice _over 1.upto(arreglo.size)
	_loop
		arreglo[indice] << caracter_inicial
	_endloop
	
	cont <<  0
	
	_for indice _over (valor_cadena.size).downto(1)
	_loop                                                  
		arreglo[ arreglo.size - cont ] << valor_cadena[indice]
		cont+<<1 
	_endloop

	_for  iterv  _over arreglo.fast_elements()
	_loop
		valor << valor + iterv
	_endloop
	
	_return valor
	
_endmethod
$
_pragma(classify_level=restricted, usage={redefinable})
_method layout_document.formatea_cadena_justifica(longitud,caracter_inicial, valor_cadena,justifica )

	
	arreglo << simple_vector.new( longitud)
	valor << ""
	_for indice _over 1.upto(arreglo.size)
	_loop
		arreglo[indice] << caracter_inicial
	_endloop
	
	cont <<  0

	_if justifica _is :der
	_then
		_for indice _over (valor_cadena.size).downto(1)
		_loop                                                  
			arreglo[ arreglo.size - cont ] << valor_cadena[indice]
			cont+<<1 
		_endloop
		
	_elif justifica _is :izq
	_then
		_for indice _over 1.upto( valor_cadena.size )
		_loop
			cont+<<1 
			arreglo[cont] << valor_cadena[indice]
			
		_endloop
	_endif
	
	
	
	
	_for  iterv  _over arreglo.fast_elements()
	_loop
		valor << valor + iterv
	_endloop
	
	_return valor
	
_endmethod
$


_method layout_document.user!_oe			    
        #
        # Obtener mi oe.
        #
        oei << _self.user!_oei
        mh << message_handler ( :layout_document )
        oe << _self.get_attribute (
        	mh.human_string (:user!_oe).as_symbol() )
        _if oe _is _unset
        _then
        	_return _unset
        _endif 
        pred << predicate.new ( :user!_valor_oe, :eq, oe )
        oe << oei.user!_oes.select(pred).an_element()
        _return oe
_endmethod
