				:diagrama_empalmes,       {:cobre,:distrito,_false,_false},				
				:construccion,            {:cobre,:distrito,_false,_false},	  	
				:bajantes,                {:cobre,:distrito,_false,_false},	  	
				:esquema_principal,       {:cobre,:central, _false,_false},
				:fosa_cables_fo,          {:fibra,:ruta,_false,_false},				
				:ruta_cables_fo,          {:fibra,:ruta,_false,_false},				
				:detalles_construccion,   {:fibra,:central,_false,_false},
				:esquema_principales,     {:fibra,:central,_false,_false},
				:esquema_tba,             {:fibra,:central,_false,_false},
				:esquema_rda,             {:fibra,:central,_false,_false},
				:esquema_rof,             {:fibra,:central,_false,_false},
				:esquema_troncal,         {:fibra,:central,_false,_false},
				:ruta_cables_fo_lar,      {:fibra,:central,_false,_false},
				:ruta_cables_fo_lar_gral, {:fibra,:central,_false,_false},
