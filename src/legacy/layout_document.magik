_endmethod
$
_method layout_document.user!_proyecto
        #
        # Obtener mi proyecto.
        #
        mh << message_handler ( :layout_document )
        central << _self.get_attribute (
        	mh.human_string (:user!_central).as_symbol() )
        lv << gis_program_manager.cached_dataset(:landbase)
        tab_lim_central << lv.collections[:user!_central]
        pred << predicate.new ( :user!_central, :eq, central )
        lim_central << tab_lim_central.select(pred).an_element()
	
        
        pred << predicate.new ( :name, :eq, proyecto )
	#VALIDA QUE EXISTA UN PROYECTO. (PHERNAN) 06/07/2006
	
	proyecto << _self.get_attribute (mh.human_string (:user!_proyecto).as_symbol() )

	_if proyecto.size > 0
	_then
		proyecto << lim_central.swg_dsn_projects.select(pred).an_element()
	_endif
       
        _return proyecto 
_endmethod
$
_method layout_document.user!_proyecto << proyecto
        #
        # Asignar atributos de central y proyecto.
        # Steve Hall (Ten Sails Consulting) 13/03/06
        #
        mh << message_handler.new ( :layout_document )
        central << proyecto.user!_central.user!_central
        _self.set_attribute (
        	mh.human_string (:user!_central).as_symbol(),
        	central )
        _self.set_attribute (
        	mh.human_string (:user!_proyecto).as_symbol(),
        	proyecto.name )
_endmethod 
$
_method layout_document.user!_tipo_plano
        #
        # Devolver tipo de plano.
        #
        mh << message_handler ( :layout_document )
        _return _self.get_attribute ( mh.human_string (:user!_tipo_plano).as_symbol() )
_endmethod
$
_method layout_document.user!_tipo_plano << tipo
        #
        # Asignar el tipo de plano al layout_document,
        # checando que el tipo diseño es apropriado.
        #
        diseno << swg_dsn_admin_engine.active_scheme
	datos_tipo << _self.tipos_plano[tipo.as_symbol()]
        EstPob << smallworld_product.pni_application().databus.request_data(:estudio_poblacion)
	
        _if datos_tipo _is _unset
        _then
        	condition.raise ( :user_error, :string,
		"Tipo de plano desconocido: " + tipo )
        _endif
	
	ok? << _false

	div_geo << datos_tipo[2]
	
        _if diseno _isnt _unset 
        _then
		
		tipo_diseno << diseno.tipo_diseno	
        
		_if div_geo _is :central
		_then
			ok? << tipo_diseno _is :canalizacion _orif
		       tipo_diseno _is :combinado _orif
		       tipo_diseno _is :principales _orif		       
		       tipo_diseno _is :captura_red_existente _orif
		       tipo_diseno _is :inventario_red_existente _orif 
		       tipo_diseno _is :enlace _orif 
		       tipo_diseno _is :trabajo _orif			      
			tipo_diseno _is :secundaria  
			
		_elif div_geo _is :ruta
		_then 
			ok? << tipo_diseno _is :principales _orif
        	       tipo_diseno _is :combinado _orif
        	       tipo_diseno _is :oei _orif
		       tipo_diseno _is :captura_red_existente _orif
		       tipo_diseno _is :inventario_red_existente _orif
		       tipo_diseno _is :canalizacion

		_elif div_geo _is :ruta_compa
		_then 
			ok? << tipo_diseno _is :principales _orif
			       tipo_diseno _is :combinado _orif
			       tipo_diseno _is :oei _orif
			       tipo_diseno _is :captura_red_existente _orif
			       tipo_diseno _is :inventario_red_existente _orif
			       tipo_diseno _is :canalizacion		

				
		_elif div_geo _is :distrito
		_then
			ok? << tipo_diseno _is :secundaria _orif
        	       tipo_diseno _is :combinado _orif
        	       tipo_diseno _is :oei 		
		_endif
		
        _elif (EstPob _isnt _unset) _andif
	      EstPob.an_element() _isnt _unset 
	_then
		ok? << _true 
	_else
		_if div_geo _is :ruta_compa
		_then
			ok? << _true
		_else
			condition.raise ( :user_error, :string,"Ningún diseño está activo" )			
		_endif
        _endif

        _if ok?
        _then 
        	mh << message_handler ( :layout_document )
        	_self.set_attribute ( mh.human_string (:user!_tipo_plano).as_symbol(), tipo )
        _else
        	condition.raise ( :user_error, :string, "Tipo de diseño incorrecto para tipo de plano" )
        _endif
	
_endmethod	
$
_method layout_document.valida_2cifras(LoNumero)			    
        # Ceros a la izquierda para números de tramos y rutas de 1 cifra
        # retornar el Número.

	_if LoNumero <> "" _orif LoNumero.size > 2
	_then
		_if  LoNumero.size < 2
		_then
			LoNumero << "0" + LoNumero
		_endif
	_else 
		LoNumero << "XX"
	_endif
	
        _return LoNumero
	
_endmethod
$
