_method layout_document.user!_directorio_planos(EstPob, directorio)

#	directorio << system.getenv ( "DIRECTORIO_PLANOS" )
#	_if directorio _is _unset
#	_then
#		condition.raise ( :user_error, :string,"Falta la variable de entorno DIRECTORIO_PLANOS")
#	_endif		

	directorio << system.pathname_from_components ("ESTUDIO DE POBLACION", directorio )

	# crea carpeta poblacion
	directorio << system.pathname_from_components (Estpob[1].user!_nombre_poblacion,
						       directorio )
	#crea carpeta año
	directorio << system.pathname_from_components (Estpob[1].user!_anyo,
						       directorio )

        # crea carpeta nombre del estudio
	directorio << system.pathname_from_components (Estpob[1].user!_nombre_estudio_pob,
						       directorio )

	system.user!_checa_directorio? (directorio,_true)
	
	_return directorio
_endmethod
