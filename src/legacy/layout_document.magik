_pragma(classify_level=advanced, topic={plotting}, usage={subclassable})
_method layout_document.identificador_de_plano(diseno, _optional tipo_plano)
	## 
	##

	_if  _self.tipos_plano[tipo_plano] _is _unset 
	_then
		_return "__"
	_endif

	
	_if tipo_plano _is _unset 
	_then
		mh << message_handler.new (:layout_document)
		tipo_plano << _self.get_attribute (mh.human_string (:user!_tipo_plano).as_symbol())	
	_endif

	tipo_plano << tipo_plano.default(:fibra).as_symbol()


	##show(_self, :params,diseno, tipo_plano )
	
       _if tipo_plano _is  :ruta_cables_fo
       _then
	       tipo_plano << :ruta_cables
       _endif
       
 
       _if _self.tipos_plano[tipo_plano][1] _is :cobre
       _then
	##       write(_self , :es_de_cobre)
	       
	       LoProyFTTByFALC? << _false
	       
	       _if diseno _isnt _unset 
	       _then
		       LoProyFTTByFALC? << (diseno.project.name.matches?("*FTTB*") _orif
					    diseno.project.name.matches?("*FALC*"))
	       _endif	

	       _if LoProyFTTByFALC?
	       _then
		       id_plano << _self.user!_id_plano_fibra(tipo_plano,diseno)
		       
	       _else
		       _if tipo_plano _is :ruta_cables_compa
		       _then				
			       id_plano << _self.user!_id_plano_compa(tipo_plano,diseno)
		       _else
			       id_plano << _self.user!_id_plano_cobre(tipo_plano,diseno)
		       _endif		
	       _endif
	       
       _elif _self.tipos_plano[tipo_plano][1] _is :canalizacion
       _then
	       id_plano << _self.user!_id_plano_canalizacion(tipo_plano,diseno)
	       
       _elif _self.tipos_plano[tipo_plano][1] _is :fibra
       _then
	  ##     write(_self , :es_fibra)
	       
	       _if diseno.tipo_proyecto.uppercase = "EXISTENTE"
	       _then
		       id_plano << _self.user!_id_plano_cobre(tipo_plano,diseno)		
	       _else
	##	       write(_self , :busca_id)
		       id_plano << _self.user!_id_plano_fibra(tipo_plano,diseno)
	       _endif
	       
       _elif _self.tipos_plano[tipo_plano][1] _is :ep
       _then
	       id_plano << _self.user!_id_plano_ep(tipo_plano,diseno)
	       
       _elif _self.tipos_plano[tipo_plano][1] _is :tba
       _then
	       id_plano << _self.user!_id_plano_ep(tipo_plano,diseno)
       _endif
       
       _return id_plano
       
_endmethod
$
_pragma(classify_level=restricted, usage={redefinable})
_method layout_document.user!_id_plano_fibra(tipo_plano,diseno)

	##show(:params,_self , tipo_plano ,diseno)
	
	#ROF, RDA, BANDA ANCHA y LARGA DISTANCIA
	#22 caracteres	
	#9CCCCCTTTTtAAMMVHHHHPE     (CCCCC-->CTL o NCO) TTTT ->tipo
	# plano  (DIVI,TOPO,ASHU,ITIN,CONJ,FOSA) t --> (S,L,R,E,U,C)
	#
	#El primer carácter debe ser el número 9, el cual significa que
	# es un plano de Red de F.O. Banda Ancha 

	#Los caracteres del 2 al 10 dependen del tipo de red
	# 21=H -->	# central 21=J -->NCO
	
	#Los caracteres del 12 al 15 son la fecha de elaboración del
	# plano,   siendo el 12 y 13 el año, y el 14 y 15 el mes
	#La letra de la posición número 16 significa las diferentes
	# versiones  del plano, y se pueden poner desde la A hasta la Z  (V)
	
	#Las posiciones 17 al 20 se refieren a la cantidad de hojas del
	# plano;  siendo la 17 y 18 el número de hoja correspondiente
	#y la 19 y 20 el total de hojas que forman el plano completo  (HHHH)

	#La letra de la posición número 21 significa el Programa de
	# Trabajo  al que pertenece el plano y,  obviamente, el proyecto

        # La letra de la posición número 22 representa a la Empresa que
        # elaboró el plano   (T- telmex,I-imtsa,K-kbtel,G-gsp, O-otros)

	paf << smallworld_product.pni_application()
	gen_planos<< paf.plugin(:gen_planos)	
	
        proyecto       << diseno.project
        siglas_central << proyecto.user!_central.user!_central
	#formatea nombre de central
	nombre_ctl << _self.formatea_cadena_justifica(5 ,"_" , siglas_central, :izq)
	anio           << date_now().year.write_string.slice(3,4)
	mes            << _self.formatea_cadena_justifica(2,"0" ,  date_now().month_number.write_string, :der)
	empresa        << gis_program_manager.authorisation_view.current_user.empresa
	_if empresa.size > 0 
	_then
		empresa        << gis_program_manager.authorisation_view.current_user.empresa.slice(1,1).default("")	
	_endif

	tipo_plano_letra  <<   _self.codigo_11[tipo_plano]  #11
	
	programa       << diseno.project.user!_programa_tipo.slice(1,1).default("")

	##show(nombre_ctl, anio, mes, empresa, tipo_plano_letra, programa)
	
        _if gen_planos.datos_ruta()  _isnt _unset _andif gen_planos.datos_ruta()[:oenlace] _isnt _unset 
	_then
		L_enlace << gen_planos.datos_ruta()[:oenlace]
		tipo_enlace      <<  L_enlace.user!_tipo_de_enlace.lowercase.as_symbol()   
		tipo_red         << _self.codigo_1[tipo_enlace].default(9).write_string            #1		
	_endif 

	_if diseno.tipo_diseno  _is :secundaria
	_then
		tipo_red         << _self.codigo_1[:otro].default(9).write_string                 #1
		tipo_plano_dto    <<  diseno.user!_distrito_optico.user!_num_dto_optico           #7-10
	_else
		tipo_red         << _self.codigo_1[:otro].default(9).write_string                 #1
		tipo_plano_dto   << _self.codigo_7_al_10[tipo_plano].default("____").write_string    #7-10		
	_endif

	nombre_plano << property_list.new() 
	nombre_plano[:tipo_red]         <<  tipo_red               #1 
	nombre_plano[:name_ctl_nco]     <<  nombre_ctl              #2-6
	nombre_plano[:tipo_plano_dto]   <<  tipo_plano_dto         #7-10
	nombre_plano[:tipo_plano_letra] <<  tipo_plano_letra       #11
	nombre_plano[:mes_anio]         <<  anio + mes             #12,15
	nombre_plano[:version]          <<  "A"                     #16 
	nombre_plano[:hoja_actual]      <<  "01"                    #17,18
	nombre_plano[:hoja_total]       <<  "01"                   #19,20
	nombre_plano[:programa]         <<  programa               #21  j-> Fibra a la casa H -> planta externa
        nombre_plano[:empresa]           << empresa                #22



	print(nombre_plano)
	
	id << ""

        id << id +
	      nombre_plano[:tipo_red] +
	      nombre_plano[:name_ctl_nco] + 	      
	      nombre_plano[:tipo_plano_dto] +
	      nombre_plano[:tipo_plano_letra] +
 	      nombre_plano[:mes_anio] +
	      nombre_plano[:version] +
	      nombre_plano[:hoja_actual] +
	      nombre_plano[:hoja_total] +
	      nombre_plano[:programa] +
	      nombre_plano[:empresa]	      

	_return id
_endmethod
$
_pragma(classify_level=restricted, usage={redefinable})
_method layout_document.user!_guardar_plano()
        #
        # Guardar un plano.
        #
	# Directorio raíz
	dir_planos << system.getenv ( "DIRECTORIO_PLANOS" )
        dir_local_planos << system.pathname_from_components ("planos_sigc11", "c:"+%\ )

        _if dir_planos _is _unset _andif dir_local_planos _is _unset
        _then
		condition.raise ( :user_error,
				  :string,
				  "Falta variable de entorno del directorio de almacenamiento de planos DIRECTORIO_PLANOS" )
	_endif
	
	# Verificar tipo de plano
        mh << message_handler.new (:layout_document)
        tipo_plano << _self.get_attribute (mh.human_string (:user!_tipo_plano).as_symbol())
	tipo_plano << tipo_plano.as_symbol()

	#write(:tipo, tipo_plano)
	
        _if _self.tipos_plano[tipo_plano] _isnt _unset
        _then
		# Guardar información sobre el plano en la tabla de planos.
		dav << swg_dsn_admin_engine.get_admin_view()
                plano_tab << dav.collections[:user!_plano]
		plano << plano_tab.new_detached_record()		
		# Verificar diseño activo
		_if (diseno << swg_dsn_admin_engine.active_scheme) _isnt _unset
		_then
			id_plano << _self.identificador_de_plano(diseno,tipo_plano)

			# phernan 14/07/2006 Se le agrega un parametro más al metodo
			# user!_directorio_planos para que guarde el layout document
			proyecto << diseno.project
			dir_planos << proyecto.user!_directorio_planos ( dir_planos, _true, _self )
                        dir_local_planos << proyecto.user!_directorio_planos ( dir_local_planos, _true, _self )

			plano.swg_dsn_project << diseno.project
			plano.swg_dsn_scheme  << diseno
			plano.user!_distrito << diseno.user!_distrito
			##oei                   << _self.user!_oei

			
		_else
		        condition.raise ( :user_error, :string, "No se puede guardar el plano si no se encuentra en un trabajo activo")
		_endif

      	        plano.id_plano        << id_plano
		plano.tipo_plano      << tipo_plano
		plano.directorio      << dir_planos
		plano.actualizado?  << _true

	_else
		condition.raise ( :user_error, :string, "Tipo de plano desconocido: " + tipo_plano )
	_endif

	# (06/11/15 ahernan) : validar que el registro aun no existe al efectuar la transaccion.
	swg_dsn_admin_engine.perform_short_transaction(_unset, :|do_insert_or_update()|, { plano })

	#Genera el XML en las ubicaciones 'dir_planos' y
	#'dir_local_planos' con el nombre generado en 'id_plano'
        arch_cache  << system.pathname_from_components(id_plano+".xml", dir_planos)
	arch_local  << system.pathname_from_components(id_plano+".xml", dir_local_planos)
	_self.save_as_xml(arch_cache)
	_self.save_as_xml(arch_local)

	#	lineacmd << cmd + " " + dir_planos + " " + dir_srvapl
	#	system.do_command(lineacmd)

	#rhernan 03/07/06 se agrego para enviar un mensaje al usuario y vea la
	# ruta en la cual su archivo fue guardado
	condition.raise ( :warning, :string, "La ubicación del archivo generado es: "+arch_cache)

_endmethod
$
_pragma(classify_level=restricted, usage={redefinable})
_method layout_document.llena_del_11_al_21(diseno _optional EP)
	## Generico del 12 al 22
	id << ""
        # Caracteres 12 al 15 (Año y mes)
        fecha << date_time.now()
        str << internal_text_output_stream.new()
        fecha.format_to ( str, "#y#m" )
        id +<< str.string
	
	_if diseno _isnt _unset 
	_then
		proyecto << diseno.project
		
		# Alternativa. Eliminar los '.'.
		(nom_diseno,alt_diseno) << diseno.nombre_y_alternativo()

		_if alt_diseno _isnt _unset
		_then
			# (16/05/30 bautistaja) : Modified. Obtenemos el ultimo numero
			# del alternativo para contemplar el caso de que sea de 2
			# digitos a la hora de asignar la letra para las diferentes  alternativas de cada diseño.
			alter << alt_diseno.split_by(".").last

			_loop
				ind << alt_diseno.index_of ( %.)
				_if ind _is _unset
				_then
					_leave
				_else
					alt_diseno <<
						alt_diseno.slice ( 1, ind-1 ) +
						alt_diseno.slice_to_end ( ind+1 )
				_endif
			_endloop 
		_else
			alt_diseno << ""
		_endif

		#Se le va a gregar una letra entre A  y Z para las diferentes
	        # alternativas de cada diseño.
		_if alt_diseno.write_string ~= ""
		_then
			_for indi, letra  _over _self.letra_alternativa.fast_keys_and_elements()
			_loop
				_if diseno.tipo_diseno _is:canalizacion
				_then
					alter << alt_diseno.write_string.first
					_if indi.write_string = alter.write_string
					_then
						
						alt_diseno << letra
						_leave
					_endif
				_else
					# (16/05/30 bautistaja) : Modified. Obtenemos alter antes de
					# quitar los puntos al alternativo 1.1.10, para obtener el
					# valor correcto (caso de que sean 2 digitos, solo se estaba
					# obteniendo uno)
					# alter << alt_diseno.write_string.last
					_if indi.write_string = alter.write_string
					_then
					
						alt_diseno << letra
						_leave
					_endif
				_endif
				
			_endloop
	       _endif

               _if alt_diseno.as_number() _isnt _unset 
	       _then
		       
		       _if _self.name = "Plano fosa de cables y distribuidor general"
		       _then
			       alt_diseno << "F"
		       _endif
	       _else
		       # (12/03/22 jtlelo) : se asigna por default la letra A
		       alt_diseno << "A"
	       _endif

               id +<< alt_diseno
	       
	       # Programa - se toma el primer caracter del atributo user!_programa.
	       programa << proyecto.user!_programa
	       _if programa _is _unset
	       _then
		      C21 <<  "_"		      
		       #condition.raise ( :user_error, :string, "No está informado el programa de trabajo del proyecto" )
               _else 
               
		       C21 << programa.slice(1,1)

               _endif
	       
               # Empresa que creó el plano se toma del usuario que creó el proyecto.
	       # (17/11/07 bernardoa) : El nombre del creador se toma del
	       # diseno en lugar del proyecto
	       #creador_proyecto << proyecto.erfasst_von
	       creador_proyecto << diseno.owner
	       # (17/11/07 bernardoa) : Se modifica la busqueda de la empresa
	       # para considerar a los usuarios que han sido dados de baja
               av           << gis_program_manager.authorisation_view
	       LoTablaUsers << av.collection(:auth!user)
	       utab         << av.collections[:user!_usuarios_baja]	       
	       pred         << predicate.new( :name, :eq, creador_proyecto )
	       datos_creador_proyecto << LoTablaUsers.select(pred).an_element()
	              
	       _if datos_creador_proyecto _isnt _unset
	       _then
		       empresa << datos_creador_proyecto.empresa
	       _else
		       # (17/11/07 bernardoa) : En el escenario que no se encuentre el
		       # usuario activo, buscamos la empresa a traves de la tabla de
		       # baja de usuarios
		       #empresa << ""
		       datos_creador_proyecto << utab.select(pred).an_element()
		       _if datos_creador_proyecto _isnt _unset
		       _then
			       empresa << datos_creador_proyecto.user!_empresa
		       _else
			       # Si aun asi no se encuentra la empresa, la definimos como vacia
			       empresa << ""
		       _endif
	       _endif
	_else 
		id +<< EP[2].user!_secuencia.write_string
		C21 << "_"
		empresa << EP[2].user!_empresa_q_genera.default("")
	_endif

        #Pagina Actual 
	current_page << _self.page_number()
  
       _if current_page < 10 
       _then
	       page_number << "0" + current_page.write_string
       _else
	       page_number << current_page.write_string
       _endif
  
       id +<<page_number

        # Número de páginas
        n_pag << _self.number_of_pages()
        _if n_pag < 10
        _then 
        	id +<< "0" + n_pag.write_string
        _else
        	id +<< n_pag.write_string
        _endif
 
        id +<< C21
 
        _if empresa = "TELMEX"
        _then
        	id +<< "T"
        _elif empresa = "IMTSA"
        _then
        	id +<< "I"
        _elif empresa = "KBTEL"
        _then
        	id +<< "K"
        _elif empresa = "GSP"
        _then
        	id +<< "G"
        _else
        	id +<< "O"
        _endif

	_return id
	
_endmethod
$
_pragma(classify_level=restricted, usage={redefinable})
_method layout_document.llena_siglas_central(siglas_central)
	## Llena de acuerdo ala norma los caracteres 2, 3, 4, 5 y 6 con las
	## siglas de la central
	## 

        # Rellenar con '_' a la derecha.
        l << siglas_central.size
        _if l < 5
        _then
        	siglas_central +<< char16_vector.new(5-l).fill_with(%_)
        _endif
	
	_return siglas_central
	
_endmethod
$
_pragma(classify_level=restricted, usage={redefinable})
_method layout_document.obten_caracter_16(id)

	dir_planos << system.getenv ( "DIRECTORIO_PLANOS" )
	
	_if (diseno << swg_dsn_admin_engine.active_scheme) _isnt _unset
	_then
		proyecto << diseno.project
		dir_planos << proyecto.user!_directorio_planos ( dir_planos, _true, _self )
		nomPlano << dir_planos+%\+id+".xml"
		_if system.file_exists?(nomPlano)
		_then
			
			cad1 << id.split_long_line(16-1)[1]
			cad2 << id.split_long_line(16)[2]
			ltr << id[16]
			_for lt _over _self.letra_alternativa.fast_elements()
			_loop

				_if ltr.write_string <> lt
				_then
					Nvoid << cad1+lt+cad2
					nomPlano << dir_planos+%\+Nvoid+".xml"
					_if _not system.file_exists?(nomPlano)
					_then
						_leave
					_else
						id << cad1+lt+cad2
					_endif
					
				_endif
			_endloop
		_else
			_return id
		_endif

		pregunta <<  "Actualmente existe un plano guardado con el nombre: "+id+".xml"+
                                     " ¿Desea cambiar el nombre ó consevar el actual?"
		resp << _self.map_manager.show_question("Cambiar", "Conservar",pregunta)
                _if resp _is _false  
	       _then
		       _return id
		_else
			_return Nvoid
	        _endif

	_endif 
	_return id
_endmethod
$
_pragma(classify_level=restricted, usage={redefinable})
_method layout_document.obtener_siglas_dto(LoDto)
	## Obtiene las siglas de la central a la cual esta asociado el
	## distrito
	## 

	_if LoDto.source_collection.name _is :user!_distrito_optico 
	_then
		SiglasCtl << LoDto.user!_siglas_central
		SiglasCtl +<< "__"
	_else
		SiglasCtl << LoDto.central_txm.user!_central
		SiglasCtl +<< "__"
	_endif

	_return SiglasCtl
	
_endmethod
$
_pragma(classify_level=restricted, usage={redefinable})
_method layout_document.tipo_enlace_fo(diseno)
	## 
	## 
         paf <<  smallworld_product.pni_application()           
         gen_planos<< paf.plugin(:gen_planos)
	 L_enlaces << gen_planos.datos_ruta()[:oenlace]

	 tipo_enlace << ""
	enlace << _unset
	
	_if l_enlaces  _isnt _unset 
	_then		
		_if l_enlaces _isnt _unset
		_then
			tipo_enlace << l_enlaces.user!_tipo_de_enlace.default("").lowercase.as_symbol()
		_endif

		_if tipo_enlace = "troncal suburbano"
		_then
			tipo_enlace << :troncal_suburbano
		_endif
	
	_elif diseno.project.name.matches?("FTTH*")
	_then 
		enlace << _unset 
		tipo_enlace << :falc
	_elif diseno.project.name.matches?("BA*")
	_then
		enlace << _unset 
		tipo_enlace << :ba	
	_endif
	
	_return tipo_enlace, enlace
	
_endmethod
