_pragma(classify_level=restricted)
_method layout_element.indicadores(PoAreaDibujo,PoRegistro,PyCampoGeom,RoViewport,
					 PbTomaEncuentaVP?,PbConLinea?,PbConPunta?,
					 PnAncho,PnAlto,PnDist_x_p,PnDist_y_p,
					 PbLineaAbajo?,PaDiseno)

## Objetivo: Dibujar Lineas indicadores de Pozos 
## Parametros de Entrada:
##   PoAreaDibujo:   Area de dibujo
##   PoRegistro:     Referencia a un registro de cualquier tabla.
##   PycamboGeom:    Campo geometrico del registro de PoRegistro.
##   RoViewport:     Referencia al viewport donde se hace el dibujo.
##   PbTomaEncuentaVP?: Toma en cuenta el viewport para hacer
##                      pliegues en la linea que apunta un objeto.
##   PbConLinea?:    Linea que relaciona un estilo y un objeto.
##   PbConPunta?:    Crea una punta de media fleca en un
##                   extremo de la linea.
##   PnAncho:        Ancho del objeto c_style_y_viewport_layout
##   PnAlto:         Alto del objeto c_style_y_viewport_layout
##   PnDist_x_p:     Indica la distribucion de los estilos en el eje X.
##   PnDist_y_p:     Indica la distribucion de los estilos en el eje Y.
##   PbLineaAbajo?:  Indica si la distribucion se hace hacia abajo.
##   PaDiseno:       Arreglo con datos del diseno del estilo.
## Parametros de Salida: Ninguno
## Regresa: Ninguno.
## Fecha de ultima modificacion: 5/Nov./2004
## Autor de la modificacion: rbsaldan
## Descripcion de la modificacion: Metodo nuevo

_local LoLs          ## Estilo de una linea.
_local LoAreaEstilo  ## Area definida para un objeto c_style_y_viewport_layout
_local LoDibujo      ## Estilo que representa un dibujo dise/ado para un objeto.
_local LoAreaViewport## Area del viewport
_local LoCoordPozoGis## Coordenada del pozo en el GIS.
_local LoCoordPozoVp ## Coordenada del pozo en el viewport
_local LoCoordCentro ## Indica la coordenada central de un area.
_local LoCoord_p2    ## Coordenada del estilo.

        ## Se obtiene la transformacion de coordenadas del GIS a
        ## coordenadas de pagina de Layout Designer.
	LoTransGisVp<<RoViewport.transform

	## Se obiene el area del viewport
	LoAreaViewport<<RoViewport.bounds

	## Se Obtiene la coordenada (GIS) del pozo.
	LoCoordPozoGIS<<PoRegistro.perform(PyCampoGeom).coord

	## Se transforma la coordenada del pozo a coordenadas de pagina
	## de Layout Designer.
	LoCoordPozoVp<<_self.TransformaCoordenada(PoAreaDibujo,LoCoordPozoGis,0.1,LoTransGisVp)

	## Definir si la linea se dibuja hacia arriba o hacia abajo del viewport
	_if PbConLinea?
	_then
		_if PbLineaAbajo?
		_then
			## Si la linea es hacia abajo.
			LoCoord_p2<<coordinate(LoAreaViewport.xmin+PnDist_x_p,LoAreaViewport.ymin-PnDist_y_p)
		_else
			## Si la linea es hacia arriba.
			LoCoord_p2<<coordinate(LoAreaViewport.xmin+PnDist_x_p,LoAreaViewport.ymax+PnDist_y_p)
		_endif
	_else
		## si no se dibuja  la linea se asigna la misma coordenada del pozo.
		LoCoord_p2<<LoCoordPozoVp
	_endif
	
	## Crear un area para un estilo dise/ando
	LoAreaEstilo<<bounding_box.new(0,0,PnAncho,PnAlto)
	## Modificar el centro del area. a la coordenada donde deber ser colocado el estilo
	LoAreaEstilo.centre<<LoCoord_p2
	## Crear una instacia de un estilo y agregarlo a una pagina de Layout Designer
	LoDibujo<<c_style_y_viewport_layout.new_with(:bounds,LoAreaEstilo)
	LoDibujo.outline_style<<_unset
	LoDibujo.fill_style<<_unset
	_if PbTomaEncuentaVP?
	_then
		LoDibujo.usa_viewport<<"Si"
	_else
		LoDibujo.usa_viewport<<"No"
	_endif
	_if PbConLinea?
	_then
		LoDibujo.con_linea<<"Si"
	_else
		LoDibujo.con_linea<<"No"
	_endif
	_if PbConPunta?
	_then
		LoDibujo.con_punta<<"Si"
	_else
		LoDibujo.con_punta<<"No"
	_endif
	_if LoCoord_p2.x>=LoCoordPozoVp.x
	_then
		LoDibujo.derecho<<"Si"
	_else
		LoDibujo.derecho<<"No"
	_endif
	LoDibujo.con_punta<<"No"
	LoDibujo.usa_viewport<<"Si"

	
#	LoDibujo.crea_figura(PaDiseno[1],
#			     PaDiseno[2].as_symbol(),
#			     PaDiseno[3],PaDiseno[4],PaDiseno[5],PaDiseno[6], PaDiseno[7],PaDiseno[8])
	_if PaDiseno.size=3
	_then
		LoDibujo.crea_figura(PaDiseno[1],
				     PaDiseno[2].as_symbol(),
				     PaDiseno[3])
	_elif PaDiseno.size=4
	_then
		LoDibujo.crea_figura(PaDiseno[1],
				     PaDiseno[2].as_symbol(),
				     PaDiseno[3],PaDiseno[4])
	_elif PaDiseno.size=5
	_then
		LoDibujo.crea_figura(PaDiseno[1],
				     PaDiseno[2].as_symbol(),
				     PaDiseno[3],PaDiseno[4],PaDiseno[5])
	_elif PaDiseno.size=6
	_then
		LoDibujo.crea_figura(PaDiseno[1],
				     PaDiseno[2].as_symbol(),
				     PaDiseno[3],PaDiseno[4],PaDiseno[5],PaDiseno[6])
	_elif PaDiseno.size=7
	_then
		LoDibujo.crea_figura(PaDiseno[1],
				     PaDiseno[2].as_symbol(),
				     PaDiseno[3],PaDiseno[4],PaDiseno[5],PaDiseno[6],PaDiseno[7])
	_elif PaDiseno.size=8
	_then
		LoDibujo.crea_figura(PaDiseno[1],
				     PaDiseno[2].as_symbol(),
				     PaDiseno[3],PaDiseno[4],PaDiseno[5],PaDiseno[6],PaDiseno[7],PaDiseno[8])
		
	_endif
	LoDibujo.LoObjRel<<PoRegistro
	LoDibujo.nIdObjRel<<PoRegistro.id
	LoDibujo.LyCampoGeoObjRel<<PyCampoGeom
	LoDibujo.oVp<<RoViewport
	_self.layout_document.current_page.add_element(LoDibujo)
_endmethod
$
_pragma(classify_level=restricted, usage={redefinable})
_method layout_element.obtener_elementos_bd_gis()
## Metodo que obtiene los elementos del dataset GIS, los id de
## estos elementos deben estar guardados en el atributo
## elementos_bd_gis, regresa un rope.
## Si se desea recuperar algo diferente en este atributo,
## este metodo se puede subclasear junto con el metodo
## guardar_elementos_bd_gis. 

_local l_dataset << mit_manager.modelit_dataset
_local l_elementos_bd << rope.new()

    _if _self.elementos_bd_gis _isnt _unset _andif _self.elementos_bd_gis.size > 0
    _then
	    _for an_obj _over _self.elementos_bd_gis.elements()
	    _loop
		    _for a_key,ele _over an_obj.keys_and_elements()
		    _loop
			    _if l_dataset.collection(a_key) _isnt _unset _andif
				(l_dato <<  l_dataset.collection(a_key).at(ele)) _isnt _unset 
			    _then
		    		    l_elementos_bd.add_last(l_dato)
			    _endif
		    _endloop
	    _endloop		
    _endif
    
    _return l_elementos_bd
    
_endmethod
$
