_pragma(classify_level=restricted)
_method layout_element.TransformaCoordenada(PoAreaDibujo,PoCoordenada,PfEScala,PoSegTransformacion)
## Objetivo: Transformar la coordenada de acuerdo el tipo de
##           canvas y al parametro para la segunda transformacion.
## Parametros de Entrada:
##     PoAreadibujo:    Canvas donde se dibuja el plano.
##     PoCoordenada:    Coordenada que se dibujara dentro del canvas.
##     PfEscala:        Escala de la transformacion la primer
##                      tranformacion a la coordenada.
##     PoSegTransformacion: Tranformacion que debe ser aplicada
##                          a la coordenada.
## Parametros de Salida: Ninguno
## Regresa: LoCoordenada. Ya sea con el mismo valor o transformada
## Fecha de ultima modificacion: 18/Nov./2004
## Autor de la modificacion: rbsaldan
## Descripcion de la modificacion: Metodo nuevo.

_local LoCoord  ##Coordenada transformada segun el tipo de canvas.

         ## Esta transformacion se aplica de acuerdo al tipo de
         ## canvas. Cuando se envia a plotter o se imprime en algun
         ## archivo (svg,jpg,acrobat) es necesario esta tranformacion.
	_if PoAreaDibujo.is_kind_of?(canvas)
	_then
		LoCoord<<PoCoordenada.transformed(transform.new().scalexy(PfEScala,PfEScala))
	_else
		LoCoord<<PoCoordenada
	_endif

	_if PoSegTransformacion _isnt _unset
	_then
		LoCoord<<LoCoord.transformed(PoSegTransformacion)
	_endif
	

	## Indica si la coordenada LoCoord esta dentro del "extent" de
	## la pagina.
#	_if _self.layout_page.bounds.surrounds_coord??(LoCoord).not 
#	_then
#		#write("Hay puntos fuera de los limites de la pagina.")
#	_endif
	>>LoCoord
_endmethod
$
