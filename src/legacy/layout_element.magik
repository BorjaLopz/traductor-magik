_package sw
$
layout_element.define_shared_constant( :defined_attributes,
	rope.new_with ( layout_attribute_definition.new ( :outline_style, :line_style,
							  :description, "Renders the outline of the element",
							  :default_value, composite_line_style.new(line_style)),
			
			layout_attribute_definition.new ( :fill_style, :fill_style,
							  :description, "When defined renders given style as background fill style",
							  :default_value, fill_style.new_solid(colour.called(:white))),
			
			layout_attribute_definition.new ( :shadow_style, :fill_style,
							  :description, "Render a bottom right shadow",
							  :default_value, _unset ),

			layout_attribute_definition.new ( :locked, :boolean,
							  :description, "Object locked or not",
							  :default_value, _false,
							  :allowed_on_properties_page?, _false ),
			
			layout_attribute_definition.new( :elementos_bd_gis, :unset,
							 :description, "Elementos Gis",
							 :default_value, _unset  ,
							 :allowed_on_properties_page?, _false ),
			
			layout_attribute_definition.new( :elementos_bd_lb, :unset,
							 :description, "Elementos Landbase",
							 :default_value, _unset  ,
							 :allowed_on_properties_page?, _false ),
			
			layout_attribute_definition.new(:elementos_modificados,
							      :unset,
							      :description,
							      "Elementos Modificados Plano",
							      :default_value,
							      _unset,
							      :allowed_on_properties_page?,
							      _false ),
			
			layout_attribute_definition.new(:cedos,
							_unset ,
							:description,
							"Cedos del plano",
							:default_value,
							_unset,
							:allowed_on_properties_page?,
							_false ),

			layout_attribute_definition.new ( :agregar_cedos, :boolean,
							  :description, "Bandera que indica agregar cedos",
							  :default_value, _true ,
							  :allowed_on_properties_page?, _false  )
					
			
	     ), :public )
$
layout_element.define_attributes()
$
_pragma(classify_level=restricted, usage={redefinable})
_method layout_element.guardar_elementos_bd_gis(PoElementos)
## Metodo para guardar los id de los elementos de BD en la
## lista PoElementos, estos elementos se guardan en el atributo
## elementos_bd_gis.
## PoElementos : rope con elementos del dataset GIS
## Si se desea guardar algo diferente en este atributo,
## este metodo se puede subclasear junto con el metodo
## obtener_elementos_bd_gis. 
	
_local 	l_elementos_bd << rope.new()
    _for obj _over PoElementos.elements()
    _loop
	    l_collection << obj.source_collection.name
	    l_id << obj.id
	    l_ele << property_list.new()
	    l_ele[l_collection] << l_id
	    l_elementos_bd.add_last(l_ele)
    _endloop
    
    _self.elementos_bd_gis << l_elementos_bd
    
_endmethod
$
