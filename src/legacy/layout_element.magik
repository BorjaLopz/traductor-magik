_local l_dataset << gis_program_manager.cached_dataset(:landbase)
_local l_elementos_bd << rope.new()

    _if _self.elementos_bd_lb _isnt _unset _andif _self.elementos_bd_lb.size > 0
    _then
	    _for an_obj _over _self.elementos_bd_lb.elements()
