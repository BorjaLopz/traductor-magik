_pragma(classify_level=restricted, topic={plugins})
_method layout_manager_plugin.habilita_centralizar_plano?
	## 
	##

	_local LoApp           << smallworld_product.pni_application()
	_local LoPlugin
	_local LoModuloActivo? << _false
	_local LoDiseno
	_local LoDisenoActivo?
	_local LoSeleccion

	# (17/07/11 bernardoa) : Validamos que el modulo de
	# comparticion este activado
	LoPlugin << LoApp.plugin(:admin_solicitud)

	# Identificamos la presencia del plugin admin_solicitud
	_if LoPlugin _isnt _unset
	_then
		LoModuloActivo? << LoPlugin.dialogs[:admin_solicitud_gui] _isnt _unset
	_endif

	# Identificamos si tenemos un diseno activo
	LoDiseno        << swg_dsn_admin_engine.active_design
	LoDisenoActivo? << LoDiseno _isnt _unset

	# Validamos que el modulo este activado y que no tengamos un
	# diseno activo
	_if LoModuloActivo? _andif
	    _not LoDisenoActivo? 
	_then
		# Si tenemos el modulo de Comparticion y un diseno activo,
		# evitamos que se pueda usar el centralizado
		_if LoDisenoActivo?
		_then
			_return _false
		_else
			# Validamos si se detectaron estructuras faltantes para la trayectoria
			LoSeleccion << LoPlugin.estructuras_faltantes.
				       select(predicate.eq(:class_name, :extdb_adhoc_record))
			# Si existe al menos un registro MySQL en el slot significa que
			# tenemos estructuras faltantes
			_if LoSeleccion.size > 0
			_then
				_return _false
			_else
				_return _true 
			_endif			
		_endif
	_else
		# Se valida la presencia de un documento actual
		_if _self.current_document _is _unset 
		_then
			_return _false 
		_endif
		
		_if LoDisenoActivo?
		_then
			# Obtenemos el estado del diseno
			LoEstado << LoDiseno.status

			# Lo comparamos con los estados permitidos para centralizado
			_if LoEstado = "Conciliado"   _orif
			    LoEstado = "Construcción" _orif
			# (17/08/22 bernardoa) : Tambien permitiremos los diseños
			# Secundarios con estado Existente
			    (LoDiseno.tipo_diseno _is :secundaria _andif
			     LoEstado = "Existente")
			_then
				_return _true 
			_endif
		_endif
	_endif	
	_return _false

_endmethod
$

_pragma(classify_level=restricted, topic={plugins})
_method layout_manager_plugin.obten_info_plano()
	## se obtienen los atributos del viewport principal.
	##
	_local LoElementos << _self.current_document.current_page.elements

	_for el _over LoElementos.elements()
	_loop
		_if el.responds_to?(:ace_name)
		_then
			_return el.attributes
		_endif
	_endloop

	
_endmethod
$
_pragma(classify_level=restricted, topic={plugins})
_method layout_manager_plugin.obten_viewport_ep()
	## metodo para obtener el viewport principal de cada plano de
	## estudio de poblacion
	##
	_if _self.current_document _isnt _unset
	_then
		_local LoElementos << _self.current_document.current_page.elements
		
		_for el _over LoElementos.elements()
		_loop
			_if el.responds_to?(:ace_name)
			_then
				_return el
			_endif
		_endloop
	_endif

_endmethod
