_pragma(classify_level=restricted, topic={plugins})
_method layout_manager_plugin.abrir_centralizar_plano()
	## 
	## plano

	cp << user:c_centraliza_planos.new()
	r << cp.centralizar_planos()
	_if r _isnt _unset 
	_then
		_self.show_alert(r);
	_else
		_self.show_alert("Existe un error con el centralizado de planos, favor de reportarlo con su administrador.")
	_endif

	
_endmethod
