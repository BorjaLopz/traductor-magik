_pragma(classify_level=restricted, topic={plugins})
_method layout_manager_plugin.actualiza_sellos()
## 
## Metodo para refrescar los sellos del Plano.
## vbluna (31-julio-2006) 
##
	
_for page _over _self.current_document.pages()
_loop
	_for elemento _over page.elements.fast_elements()
	_loop
		_if elemento.is_kind_of?(layout_element)
		_then
			# (2011-03-22 Aarón Hernández Ramírez, SIGMATAO) : SE ELIMINA
			# TRY PUES IMPIDE ENCONTRAR FALLAS EN LOS SELLOS.
#			_try _with LoError
			     
			     _if  elemento.responds_to?(:actualiza_datos|()|)
			     _then
			
				     _if elemento.window _isnt _unset 
				     _then			
					     elemento.actualiza_datos()					     
				     _endif

			     _endif
			     
#			_when error, does_not_understand
#			      _continue
			      
#			_endtry
		_endif
	_endloop
_endloop

_self.action(:layout_view_refresh).execute_action()

_endmethod
