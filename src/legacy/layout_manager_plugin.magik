_pragma(classify_level=restricted, topic={plugins})
_method layout_manager_plugin.verifica_publicar_a_web()
	## se apaga o enciende la opcion de publicar plano a web del
	## menu archivo de la aplicacion dependiendo si el plano es
	## válido para se publicado.
	## 
	_self.action ( :publica_a_web ).enabled? << _self.publicar_plano_a_web?
	
_endmethod
$
_method layout_manager_plugin.zoom_to()
	## Obtener la aplicacion layout designer.
	LoLayoutDesigner<<smallworld_product.pni_application().plugin(:layout_plugin).start_layout_designer()
	## Obtener el layout manager
	LoLayoutManager<<LoLayoutDesigner.plugin(:layout_manager)
	
	#LoViewport<<LoLayoutManager.current_document.current_page.all_elements_of(c_viewport_layout_sigc).an_element()
	LoViewport<<LoLayoutManager.current_layout_view.current_selection.an_element()
	
	_if LoViewport _isnt _unset _and LoViewport.is_kind_of?(c_viewport_layout_sigc) 
	_then
		LoViewport.zoom_to()  #usando el viewport
	_else
		LoLayoutDesigner.show_message("Seleccione un Viewport y haga un trazo (punto o área) sobre el Viewport.")
	_endif 
	
_endmethod
$
