_pragma(classify_level=restricted, topic={plugins})
_method layout_manager_plugin.save_layout ()
	## 
	## Saves the current layout to the same file it was loaded
	## from. Happens only when the layout has a filename, else it
	## will default to the save_as_layout().
	##
	
	_if ( a_layout << _self.current_document ) _is _unset 
	_then
		condition.raise ( :user_error, :string, _self.message(:no_current_layout) )
	_endif

	_if ( filename << a_layout.filename ) _isnt _unset
	_then
		LoAns << _self.show_alert("Esta acción actualiza el archivo de configuración del plano previo. ¿Continuar con la operación? ", "SI", "NO")

                _if LoAns #_andif _self.int!save(a_layout,filename)
		_then
			a_layout.user!_guardar_plano()
			_return _true
                _endif  		     
	_else
		mh << message_handler ( :layout_document )
		tipo_plano << a_layout.get_attribute(mh.human_string (:user!_tipo_plano).as_symbol())
		_if tipo_plano _isnt _unset
		_then
			#
			# Steve Hall (Ten Sails Consulting) 01/03/06
			# Guardar el layout relacionado con el diseño
			# utilizando user!_guardar_plano.
			#
			a_layout.user!_guardar_plano()
                        _return _true 
		_endif
	_endif
	
	>> _self.save_as_layout ()

_endmethod
