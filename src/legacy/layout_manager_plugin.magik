_pragma(classify_level=restricted, usage={redefinable})
_method layout_manager_plugin.units
	## 
	##

	>> _if (LvUnit << _self.framework.application_coordinate_system_unit) _isnt _unset 
	   _then
		   >> unit_system.new( LvUnit )
	   _endif
	
_endmethod
