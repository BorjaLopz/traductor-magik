_pragma(classify_level=restricted, topic={plugins})
_method layout_manager_plugin.init_actions()
	## 
	## Define this plugin's actions.
	##

	# (22/08/24 des_aaron) : sw 526
	_super.init_actions ()
	
	# New/Open/Close/Delete
	_self.add_action( sw_action.new( :new,
					 :engine, _self,
					 :help_id, 30100,
					 :action_message, :new_layout|()|,
					 :image, {:new_layout, _self.module_name}))

	_self.add_action( sw_action.new( :new_existing,
					 :engine, _self,
					 :help_id, 30100,
					 :action_message, :new_existing|()|,
					 :image, {:new_layout, _self.module_name}))
					 
	_self.add_action( sw_action.new( :open,
					 :engine, _self,
					 :help_id, 30105,
					 :action_message, :open_layout|()|,
					 :image, {:open_layout, _self.module_name}))

	_self.add_action( sw_action.new( :save,
					 :engine, _self,
					 :help_id, 30125,
					 :action_message, :save_layout|()|,
					 :image, {:save, _self.module_name}))

	_self.add_action( sw_action.new( :save_as,
					 :engine, _self,
					 :help_id, 30125,
					 :action_message, :save_as_layout|()|,
					 :image, {:save, _self.module_name}))

	# We do not support deleting files from disk at this release,
	# just use the Windows Explorer or another tool to do so (same
	# as other Windows apps)
	#_self.add_action( sw_action.new( :delete,
	#				 :engine, _self,
	#				 :action_message, :delete_layout|()|,
	#				 :image, {:delete, _self.module_name}))

	_self.add_action( sw_action.new ( :close,
					  :help_id, 30125,
					  :engine, _self,
					  :action_message, :close_layout|()|,
					  :image, {:close_pane, :ui_resources }))

	_self.add_action( sw_action.new( :exit,
					 :engine, _self.framework,
					 :action_message, :close|()|,
					 :help_id, 14000))

	# Page Setup
	_self.add_action ( sw_action.new( :page_setup,
					  :help_id, 30110,
					  :engine, _self,
					  :action_message, :page_setup|()|,
					  :image, {:page_setup, _self.module_name}))

	# Page Properties
	_self.add_action ( sw_action.new( :properties,
					  :help_id, 30115,
					  :engine, _self,
					  :action_message, :properties|()|,
					  :image, {:properties, :ui_resources}))


	# Layout selection action
	_self.add_action ( sw_action.new ( :layout_selection,
					   :engine, _self,
					   :help_id, 30000,
					   :value_change_message, :activate_layout|()|,
					   :toolbar_control, :image_radio_set,
					   :menubar_control, :radio_set ) )

	# Actual Plotting 
	_self.add_action ( sw_action.new( :plot,
					  :engine, _self,
					  :help_id, 30700,
					  :action_message, :plot_layout|()|,
					  :image, {:print, :ui_resources}))
	
	_self.add_action ( sw_action.new( :plot_setup,
					  :engine, _self,
					  :help_id, 30700,
					  :action_message, :plot_setup_layout|()|,
					  :image, {:print, :ui_resources }))

	# Preview in Outlook bar?
	_self.add_action ( sw_action.new ( :preview,
					   :engine, _self,
					   :value, _true,
					   :help_id, 30230,
					   :menubar_control, :toggle_item,
					   :toolbar_control, :image_toggle_item ) )

	# Add Custom Properties Action
	_self.add_action ( sw_action.new ( :custom_properties,
					   :engine, _self,
					   :help_id, 30120,
					   :action_message, :activate_custom_properties_dialog|()|,
					   :image, { :properties, :ui_resources } ) )


	_self.add_action ( sw_action.new ( :select_template,
					   :engine, _self,
					   :enabled?, _true,
					   #:help_id, 30460,
					   :toolbar_control, { :combo_box_item, :min_width, 80 },
					   :items, _self.get_template_names,
					   :value_change_message, :select_template|()| ) )
	

	# Add actions from outlook_bar_component
	show_hide_action << .outlook_bar.action ( :show_hide ).copy(:show_hide,
								    :help_id, 30235,
								    :caption, _self.message(:show_hide),
								    :tooltip, _self.message(:show_hide_tooltip),
								    :short_help_text, _self.message(:show_hide_sh ) )
	_self.add_action ( show_hide_action )


	_self.add_action ( sw_action.new ( :quick_pdf,
					   :engine, _self,
					   :image, { :pdf, :swift_view_application },
					   :action_message, :|pdf_plot()| ) )

	## Descripcion: Esta accion debe etiquetar dos objetos layout element
	## que esten seleccionados y que hacen referencia a pozos.
	
	_self.add_action ( sw_action.new ( :plano_etiqueta_2pozos_action,
					   :engine, _self,
					   :action_message, :plano_etiqueta_2pozos|()|))

	
	## Descripcion: Esta accion debe hace un acercamiento a un
	## punto senalado en un viewport. El acercamiento se muestra en
	## un viewport que se agrega a un layout_page
	
	_self.add_action ( sw_action.new ( :zoom_to_action,
					   :engine, _self,
					   :action_message, :zoom_to|()|))
	
	_self.add_action ( sw_action.new(:actualiza_sellos,
					 :image, {:query, :ui_resources},
					 :engine,   _self,
					 :enabled?, _true,
					## :toolbar_control, :button_item,  #volver a habilitar como boton?
					 :action_message, :actualiza_sellos|()|))
	
	
	_self.add_action ( sw_action.new(:exporta_shapefile_desde_plano,
					  :engine,   _self,
					  :enabled?, _true,
					  :toolbar_control, :button_item,
					  :action_message, :exporta_shapefile_desde_plano|()|))

	_self.add_action ( sw_action.new(:exporta_shapefile_desde_vista,
					  :engine,   _self,
					  :enabled?, _true,
					  :toolbar_control, :button_item,
					  :action_message, :exporta_shapefile_desde_vista|()|))

	_self.add_action( sw_action.new( :publica_a_web,
					 :engine, _self,
					 :action_message, :publica_a_web|()|))
	
	_self.add_action( sw_action.new( :centralizar_plano,
					 :engine, _self,
					 :action_message, :centralizar_plano|()|))
	
	# Add proxy actions for layout_gui, layout_view and trail

	## Actions from layout_gui_framework are prefixed with "layout_gui_"
	_self.build_proxy_actions ( layout_gui_framework, "layout_gui_" )

	## Actions from layout_view are prefixed with "layout_view_"
	_self.build_proxy_actions ( layout_view, "layout_view_" )

	## Actions from map_trail are prefixed with "trail_"
	_self.build_proxy_actions ( map_trail, "trail_" )
	
_endmethod
