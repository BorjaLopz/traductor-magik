_pragma(classify_level=restricted, topic={plugins})
_method layout_manager_plugin.check_actions ()
	## se agregan acciones para  /publicar centralziar planos
	## 
	# (22/08/24 des_aaron) : sw 526
	have_layout?   << ( current_layout << _self.current_document ) _isnt _unset
	have_filename? << have_layout? _andif current_layout.filename _isnt _unset

	_self.action ( :save ).enabled? << have_layout?
	_self.action ( :save_as ).enabled? << have_layout?
	_self.action ( :close ).enabled? << have_layout?
	_self.action ( :page_setup ).enabled? << have_layout?
	_self.action ( :properties ).enabled? << have_layout?
	_self.action ( :plot ).enabled? << have_layout?
	_self.action ( :select_template ).items << _self.get_template_names
	_self.action ( :publica_a_web ).enabled? << have_layout? _andif _self.publicar_plano_a_web?	
	_self.action ( :centralizar_plano ).enabled? << _self.habilita_centralizar_plano?
	
_endmethod
