_pragma(classify_level=restricted, topic={plugins})
_method layout_manager_plugin.plano_etiqueta_2pozos()
## Objetivo: Crear una linea entre dos estilos que esten
##           agregados en una pagina de layout designer y que hagan
##           referencia a un pozo.
## Parametros de Entrada: Ninguno.
## Parametros de Salida: Ninguno.
## Regresa: Ninguno.
## Fecha de ultima modificacion: 
## Autor de la modificacion:24/Nov./2004
## Descripcion de la modificacion: Metodo nuevo
_local LoLayoutDesigner   ## Referencia a la aplicacion de layout designer.
_local LoApp              ## Referencia a la aplicacion de pni.
_local LoEstiloDePozo     ## Referenica a un estilo que hace referencia a un pozo.

        ## Obtener la aplicacion pni.
	LoApp<<smallworld_product.pni_application()
	
	## Obtener la aplicacion layout designer.
	LoLayoutDesigner<<LoApp.plugin(:layout_plugin).start_layout_designer().plugin(:layout_manager)
	_if LoLayoutDesigner _isnt _unset 
	_then
		## Elegir el objero que esta agregado en el plano y que realiza
		## el dibujo del plano. 
		LoEstiloDePozo<<LoLayoutDesigner.current_document.current_page.all_elements_of(c_geom_set_layout).an_element()
		write(LoEstiloDePozo.class_name)
		_if LoEstiloDePozo _isnt _unset
		_then
			LoEstiloDePozo.dibuja_linea_entre_pozos()
		_else
			write("No hay que hacer")
		_endif
	_endif
	
_endmethod
$

_pragma(classify_level=restricted, topic={plugins})
_method layout_manager_plugin.progress_indicator_dialog(Lotitulo, LoLabel, Loinfo)
	## Lotitulo: titulo de la barra de progreso
	## LoLabel: Etiqueta de la barra
	## Loinfo: Tarea ejecutandos
	# (12/08/28 jtlelo) : declaracion de progress_indicator_dialog
	.barra_desp << progress_indicator_dialog.open_dialog ( _self.top_frame, Lotitulo,
								:interrupt_handler, handler.new (_self, :close|()|),
								:interrupt_message, "Cancelar",
								:info_string, Loinfo,
								:bar_label, LoLabel,
								:image, { :help, _unset } )
		
	.barra_desp.top_frame.position << pixel_coordinate.new(500, 500)

		
	_return .barra_desp
	
_endmethod
$
_pragma(classify_level=restricted, topic={plugins})
_method layout_manager_plugin.publica_a_web ()

	_self.busy? << _true
	_local LoEngine << user:c_publica_archivo_a_web_engine.new()
	_local LodtsEP << gis_program_manager.cached_dataset(:estudio_poblacion)
	_local LoTabLimNCO << LodtsEP.collection(:user!_limite_nco_ftth)
	
	_if LoEngine.existe_repositorio_temporal? _is _false _orif
	    LoEngine.existe_registro_de_servidor?(1) _is _false
	_then
		msg << "Error: No Existe Repositorio para publicar archivos a SIGC11WEB"+%newline
		msg +<< "O no tiene permisos. Consulte a su Administrador"
		_self.show_alert(msg)
		_self.busy? << _false
		_return
	_endif

	_local LoConfiguraciones << property_list.new()
	_local LoLayout << _self.current_document
	_local LoNomReporte << _self.obten_info_plano()[:nombre_plano].value.default("X")
	carpetas << rope.new()
	_if _self.obten_info_plano()[:siglasNCO].value _is _unset
	_then
		_for limite _over LoTabLimNCO.fast_elements()
		_loop
			_if LoEngine.existe_limite_publicado?(limite.user!_siglas)
			_then
				carpetas.add(limite.user!_siglas)
			_endif
		_endloop
	_else
		_if LoEngine.existe_limite_publicado?(_self.obten_info_plano()[:siglasNCO].value)
		_then
			carpetas.add(_self.obten_info_plano()[:siglasNCO].value)
		_endif 
	_endif

	_if carpetas.size = 0
	_then
		msg << "Error: No existen Límites de NCO publicados"
		_self.show_alert(msg)
		_self.busy? << _false
		_return
	_endif
	
	_for carpeta _over carpetas.elements()
	_loop
		LoEngine.crea_path_archivo(carpeta,LoNomReporte,".jpg")
		#llenamos las propiedades del plano
		plot_system.init ()
		LoConfiguraciones[:device] << plot_system.plotter_info[:file]
		LoConfiguraciones[:filename] << LoEngine.path_archivo
		LoConfiguraciones[:filetype] << :jpeg
		LoConfiguraciones[:raster_quality] << :high
		LoConfiguraciones[:pages] << _unset
		LoConfiguraciones[:copies] << _unset
		
		pos << _self.top_frame.actual.bounds.centre
		eng << layout_plot_engine.new ()
		job << layout_plot_job.new ( LoLayout, LoConfiguraciones )
		eng.add_job ( job )
		eng.int!do_plot()
		system.gc(_true)		
	_endloop

	_if LoEngine.actualiza_archivos_en_servidor()
	_then
		_self.show_alert("Publicación a SIGC11WEB Finalizada Satisfactoriamente")
		_self.busy? << _false
	_else
		_self.show_alert("Error: No se pudo publicar el archivo por falta de conectividad con el servidor. Consulte a Soporte Técnico")
		_self.busy? << _false
	_endif

_endmethod
$
_pragma(classify_level=restricted, topic={plugins})
_method layout_manager_plugin.publicar_plano_a_web?
	## se analiza el atributo boleano de publicaraweb del viewport principal
	##
	_local publicar? << _false

	_if _self.current_document _isnt _unset _andif
	    _self.current_document.current_page _isnt _unset
	_then
		_for el _over _self.current_document.current_page.elements.fast_elements()
		_loop
			_if el.responds_to?(:ace_name) _andif
			    el.attributes[:publicarAweb] _isnt _unset
			_then
				publicar? << el.attributes[:publicarAweb].value
				_leave
			_endif
		_endloop
	_endif
	_return publicar?
_endmethod
$

