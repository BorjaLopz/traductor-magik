_pragma(classify_level=restricted, topic={plugins})
_method layout_plugin.start_application_copy ( app_name )
	## 
	## Starts a copy of the requested application and owns it privately.
	##

	_if ( an_app_def << .applications [ app_name ] ) _is _unset 
	_then
		_if ( app_def << smallworld_product.application_definition ( app_name ) ) _is _unset
		_then
			condition.raise ( :warning, :string, _self.message(:functionality_not_available) )
			_return 
		_endif

		an_app_def << .applications [ app_name ] << app_def.copy ()
	_endif
	
	_if an_app_def.state _isnt :active 
	_then
		# Start the application removing any left overs by performing a
		# stop first
		an_app_def.int!restart ()

		# And hook the Help system into the owning Application 
		_if ( app << an_app_def.application ) _isnt _unset
		_then 
			app.html_help_file_name << _self.application.html_help_file_name
			app.html_help_resource_module_name << _self.application.html_help_resource_module_name

			# Actually should make self dependent on the
			# application_definition and wait for a message
			# where :state is :active
			_proc ( app, app_name )
				app.post_activation ()
				#
				# Steve Hall (Ten Sails Consulting) 10/03/06
				# Se añade 'elif' para dejar sin cambiar
				# el título del 'visualizador_planos'.
				#
				_if app_name _is :layout_preview
				_then
					#
					# Modificación: Para el manejo de mensajes
					# Autor: llruiz 
					# Fecha: 11/05/2005
					#app.top_frame.title << app.external_name
					#
					app.top_frame.title << app.message(:quick_preview_title)
				_elif :app_name _is :layout_designer 
				_then
					_local title
					title << app.top_frame.title
					title << title.replace_substring(app.external_name.write_string,app.message(:layout_designer_title))
					app.top_frame.title << title 
				_endif
				
			_endproc.fork_at ( _thisthread.background_priority - 1, app, app_name )
		_endif 
	_else
		# If the application is currently minimized then pop it up.
		_if ( app << an_app_def.application ) _isnt _unset _andif
		    ( tf << app.top_frame ) _isnt _unset _andif
		    tf.minimized? _is _true
		_then
			tf.minimized? << _false
		_endif 
	_endif
	
	

	>> an_app_def.application

_endmethod
$
_pragma(classify_level=restricted, usage={redefinable})
_method layout_plugin.start_layout_designer ()
#	## 
#	## This will start the 'hidden' layout designer application.
#	## Will set the gs_factory and map_manager to the appropriate
#	## values.
#	## 
#
#	an_app << _self.start_application_copy ( :layout_designer )
#	
#	a_layout_manager << an_app.plugin ( :layout_manager )
#	a_layout_manager.post_init_layout_handlers ( _self.map_manager, _self.gs_factory )
##		
## Steve Hall (Ten Sails Spain) 21/06/04
## Devolver la applicación que se ha arrancado.
##
#	_return an_app

# (22/02/09 des_aaron) : sw52
## 
	## Start the Layout Designer 
	## 

	a_layout_designer << _self.activate_as_dialog ( :layout_designer )
	a_layout_manager  << a_layout_designer.layout_manager
	a_layout_manager.post_init_layout_handlers ( _self.map_manager, _self.gs_factory )
	
	_if ( dir << _self.saved_layouts_directory ) _isnt _unset _andif
	    ( a_layout_manager.get_preference( :saved_layouts_folder ) _is _unset _orif
	      a_layout_manager.get_preference( :saved_layouts_folder)  = "" )
	_then
		a_layout_manager.set_preference( :saved_layouts_folder, dir )
	_endif

	_if ( dir << _self.template_directory ) _isnt _unset _andif
	    ( a_layout_manager.get_preference( :templates_folder ) _is _unset _orif
	      a_layout_manager.get_preference( :templates_folder)  = "" )
	_then 
		a_layout_manager.set_preference( :templates_folder, dir)
	_endif

	_if ( dir << _self.stencil_directory ) _isnt _unset _andif
	    ( a_layout_manager.get_preference( :stencils_folder ) _is _unset _orif
	      a_layout_manager.get_preference( :stencils_folder)  = "" )
	_then 
		a_layout_manager.set_preference( :stencils_folder, dir)
	_endif

	_if (l_reset? << _self.get_preference(:reset_viewport)) _isnt _unset
	_then
		a_layout_manager.set_preference(:reset_viewport, l_reset?)
	_endif
		
_endmethod
$
_method layout_plugin.user!_visualizar_plano ( plano )
#
# Visualiza un plano.
# El argumento 'plano' es un registro de la tabla
# 'user!_planos'.
# Steve Hall (Ten Sails Consulting) 10/03/06
#
# Obtener diseño del plano y posicionarse en ello.
#
proyecto << plano.swg_dsn_scheme
diseno << plano.swg_dsn_scheme
_if diseno _is _unset
_then
	#
	# Diseno original ha sido borrado.
	# Buscar diseño correspondiente al oei.
	#
	oei << plano.user!_oei
	_if oei _isnt _unset
	_then
		diseno << _self.diseno_oei ( oei )
		_if diseno _is _unset
		_then
			diseno << _self.diseno_combinado
		_endif
		_if diseno _is _unset
		_then
			condition.raise ( :user_error, :string,
			"No se encuentra diseño correspondiente a este plano" )
		_endif
	_endif 
_endif 	
swg_dsn_admin_engine.activate_design ( diseno )
#
# Crear layout_document a raíz del archivo .xml.
#
archivo << plano.id_plano + ".xml"
directorio << plano.directorio
archivo << system.pathname_from_components ( archivo, directorio )
ld << layout_document.new_from_xml ( archivo )
#
# Displayarlo.
#
_self.preview_layout ( ld, _unset, :visualizador_planos )
_endmethod
$
_pragma(classify_level=restricted, usage={redefinable})
_method layout_plugin.verifica_status()
# Objetivo: Checa si la pantalla de edición de planos
# se encuentra activa, si está activa pregunta al usuario si
# desea continuar con la generación del plano, si es así el
# pano se sobreescribe a lo que contenga el plano actual. 
#
#	
# Parámetros de entrada:  ninguno.
# Parámetros de salida:   ninguno  
# Regresa: LBBandera bandera que indica si design layout esta abierto. 
# Fecha  de última modificación: 18 febrero 2005
# Autor de la modificación: hramirea
# Descripción de la modificación: Método nuevo.
#
	_local LoAn_app           << _self.start_application_copy(:layout_designer )
	_local LoA_layout_manager << LoAn_app.plugin (:layout_manager )
	_local LBBandera          << _true
	
	_if     LoA_layout_manager.current_document.current_page.empty?.not  
	_then	
        LBBandera  <<  _self.show_question("Si", "No", "La pantalla de edición de planos se encuentra abierta. Se recomienda Salvar su plano actual antes de continuar. Desea Continuar? ")
_endif
     
_return LBBandera	

_endmethod
$
