# (22/02/09 des_aaron) : 5.2
_pragma(classify_level=restricted)
_method layout_plugin.quick_preview( _optional a_template_name )
	## 
	## Creates a new layout based on the Tools/Options/QuickPlot/PaperSize
	## gets the current_map_view settings and figures the
	## orientation of the plot (Landscape/Portrait) and creates a
	## viewport as large as possible to fit on that piece of paper.
	## 

	# START CHANGE
	# (22/02/09 des_aaron) : 
	#
	# (04/07/22 llruiz) : Modified.
	_if system.getenv("SW_TEMPLATES_DB_DIR") _is _unset 
	_then
		_self.template_directory << system.getenv("SMALLWORLD_GIS") + "\..\sigp\templates_xml"
		path << system.putenv("SW_TEMPLATES_DB_DIR", _self.template_directory )
	_else
		path <<  system.getenv("SW_TEMPLATES_DB_DIR")
	_endif
	
	_if path _is _unset 
	_then
		path <<  system.getenv("SW_TEMPLATES_DB_DIR")
	_endif
	
	
	default_layout_name << path + "\p_libre_plot.xml"
	a_template_name << path + "\p_libre_plot.xml"
	
	_self.options [ :default_landscape_layout] << default_layout_name
	
	#
	# END CHANGE
	
	_if _self.options[:viewport_mapping] _is :manual
	_then
		# Do select the map you want to use
		_self.click_on_map ()
	_elif ( a_map_plugin << _self.get_service_provider( :map_plugin ) ) _isnt _unset 
	_then
		# SWIFT
		_self.quick_preview_for_map ( a_map_plugin.map_container, a_template_name )
	_elif ( a_map_view << _self.current_map_view ) _isnt _unset
	_then
		# SWAF
		_self.quick_preview_for_map ( a_map_view, a_template_name )
	_else 
		condition.raise ( :warning, :string, _self.message( :no_map_available) )
	_endif
	
	
_endmethod
