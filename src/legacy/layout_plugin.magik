_package sw
$
layout_plugin.define_shared_constant(:meses, {"Enero", "Febrero",
				              "Marzo", "Abril",
				              "Mayo",  "Junio",
				              "Julio", "Agosto",
				              "Septiembre", "Octubre",
				              "Noviembre", "Diciembre"},
				     :public)
$
_pragma(classify_level=restricted, usage={redefinable})
_method layout_plugin.fecha_med()
	## Devuelve la fecha en formato "dd-mm-yyyy"
	
	# (1/03/2006 llruiz, SigmaTao)
	
	fecha << date_now()

	dia << fecha.day_of_month_number
	mes << _self.meses[fecha.month_number]
	anio << fecha.year
	
	_return dia.write_string + "/" + mes + "/" + anio.write_string
	
_endmethod
$
_pragma(classify_level=restricted, topic={plugins})
_method layout_plugin.init_actions ()
	## 
	## 
	_super.init_actions ()

	_self.add_action ( sw_action.new ( :quick_preview,
					   :engine, _self,
					   :image, { :print, _self.module_name },
					   :short_help_text, _self.message( :quick_preview_sh ),
					   :action_message, :quick_preview|()| ) )
					   
	_self.add_action ( sw_action.new ( :layout_designer,
					   :engine, _self,
					   :image, { :new_layout, layout_plugin.module_name },
					   :action_message, :start_layout_designer|()| ) )


	# New actions for SWIFT - these would need some more work to
	# enable them to work in swaf; specifically creating a
	# gui_framework earlier e.g. in init() rather than in
	# build_gui()
	_self.add_action ( sw_action.new ( :quick_print,
					   :engine, _self,
					   :image, { :print, :swift_view_application },
					   :action_message, :|quick_print()| ) )
	
	_self.add_action ( sw_action.new ( :quick_pdf,
					   :engine, _self,
					   :image, { :pdf, :swift_view_application },
					   :action_message, :|quick_pdf()| ) )
	
	
#	###### rraragon (23/02/2007) se agrega la accion para el plano
#	## libre de coaxial
#	_self.add_action ( sw_action.new (:plano_coaxial,
#					   :engine, _self,
#					   :image, { :new_layout, :layout_gui },
#					   :action_message, :start_layout_designer|()| ) )
	##########################################################################

	_self.add_action ( sw_action.new ( :plano_de_captura,
					   :engine, _self,
					   :image, { :print, _self.module_name },
					   :short_help_text, _self.message( :plano_de_captura),
					   :action_message, :plano_de_captura|()| ) )

	
_endmethod
$
_method layout_plugin.layout_designer
#
# Devuelve la applicación del layout_designer
# se está arrancada (pero no la arranca caso
# que no).
# Steve Hall (Ten Sails Consulting) 02/03/06
#
app_def << .applications[:layout_designer]
_if app_def _isnt _unset
_then 
	_return app_def.application
_else
	_return _unset
_endif 
_endmethod
$
_pragma(classify_level=restricted, topic={plugins})
_method layout_plugin.plano_de_captura ()
	## 
	#  Objetivo: Escriba aquí el objetivo.
	#  Parámetros de entrada:  Ninguno 
	#  Parámetros de salida:     Ninguno.
	#                                 	
	paf << smallworld_product.pni_application()
	mpg << paf.plugin(:map_plugin)
	sch<< swg_dsn_admin_engine.active_scheme
	
	_if sch _isnt _unset 
	_then
		
		LoProyecto<< sch.project
		
		existente_fibra? << LoProyecto  _isnt _unset _andif
				    LoProyecto.job_type.lowercase = "existente"   _andif 
				    sch.tipo_diseno = :secundaria _andif
				    swg_dsn_admin_engine.active_design.id_dto_optico   _isnt _unset
		
		
		_if existente_fibra?   	  
		_then

			LoPlanoConstr << user:c_plano_de_captura_fo.new()
			LoDtoOptico << swg_dsn_admin_engine.active_scheme.distrito_optico
			LoPlanoConstr.genera_plano(LoDtoOptico)
			
			_return _true
		_endif
		
		lyd << paf.plugin(:layout_plugin).start_layout_designer()
		lym                    << lyd.plugin(:layout_manager)
		LoDoc                  << lym.current_document
		LoDoc.user!_tipo_plano << :construccion
		LoPage                 << LoDoc.current_page	
		LoPage.layout_document.user!_tipo_plano <<"construccion"	
		LoPage.layout_document.user!_proyecto <<swg_dsn_admin_engine.active_scheme.project
		
		## Agregar marco.
		LoMarco << user:c_marco.new_with(:bounds,bounding_box.new(0, 0, 1, 1))
		LoMarco.Largo << 4
		LoMarco.Alto  << 2
		LoMarco.set_fill_colour(_unset)
		LoPage.add_element(LoMarco)
		##agregar norte
		LoNorte << user:c_norte.new_with(:bounds,bounding_box.new(0, 0, 1, 1))
		LoNorte.limites << bounding_box.new(LoMarco.bounds.xmin + 50,
						    LoMarco.bounds.ymin + 50,
						    LoMarco.bounds.xmax - 50,
						    LoMarco.bounds.ymax - 50)
		
		LoNorte.tamano<<"B"
		LoPage.add_element(LoNorte)
		
		##agregar titulo
		LoTitulo << user:c_titulo_de_plano.new_with(:bounds,      bounding_box.new(0, 0, 3000, 1400),
						       :font_name,        "bold",
						       :font_size,        12,
						       :fill_style,       _unset,
						       :outline_style,    _unset,
						       :text,             "PLANO DE CAPTURA",
						       :wrap,             _false,
						       :align_horizontal, :centre,
						       :align_vertical,   :centre,
						       :orientation,      :left_right)
		LoPage.add_element(LoTitulo)
		
		LoTitulo.oBoundContenedor << bounding_box.new(LoMarco.bounds.xmin + 50,
							      LoMarco.bounds.ymin + 50,
							      LoMarco.bounds.xmax,
							      LoMarco.bounds.ymax)
		
		
		##agregar sello estandar
		LoSello << user:c_sello_estandar_construccion.new_with(:bounds, bounding_box.new(LoMarco.bounds.xmin+50,
											    LoMarco.bounds.ymin+50,
											    LoMarco.bounds.xmin+200+2950,
											    LoMarco.bounds.ymin+50+2740))
		LoPage.add_element(LoSello)
		
		LoTituloPlano << "PLANO DE CONSTRUCCIÓN" +%newline	
		LoStrDit << sch.user!_distrito.user!_distrito.default("")
		LoStrProg<< sch.project.user!_programa_tipo.default("" )
		LoStrAnyo<< sch.project.user!_programa_anyo.default("" )
		LoTituloPlano +<< LoStrDit + % +%/ + % + LoStrProg + %- + LoStrAnyo
		
		LoDibujaPlano << user:c_geom_set_layout_plano_captura.new_with(:bounds,bounding_box.new(10,10,100,100))	
		LoDibujaPlano.oAppLayoutDesigner << lyd
		LoDibujaPlano.oRegistro          << sch.user!_distrito
		LoDibujaPlano.nIdRegistro        << sch.user!_distrito.id
		LoDibujaPlano.sidproyecto        << sch.project.id
		LoDibujaPlano.nMargenVp          << 800
		LoDibujaPlano.sTipoPlano         << "CONSTRUCCION"
		LoDibujaPlano.snombreplano       << "CONSTRUCCION"
		LoDibujaPlano.modulos_ancho      << 4
		LoDibujaPlano.modulos_alto       << 2		
		LoPage.add_element(LoDibujaPlano)

	_endif
		
_endmethod 
$
_pragma(classify_level=restricted, topic={plugins})
_method layout_plugin.preview_layout ( a_layout, _optional activate_custom_properties?, title )

	## 
	## This will start the 'hidden' layout preview application.
	## And put the document (a_layout) in a new layout_view
	##

	_if ( a_previewer << _self.gui_framework ) _is _unset
	_then
		_if _self.map_manager.responds_to?( :map_container )
		_then
			# SWIFT
			# we never want the dialog so simply return if there is no embedded gui
			_return
		_else 
			# SWAF
			# We aren't using an embedded gui framework, so go from the app.
			a_previewer << _self.activate_as_dialog ( :layout_preview )
			
			# Set the title again as layout_manager_plugin just changed it
			a_previewer.top_frame.title << title.default(a_previewer.external_name)
		_endif 
	_endif

	template_dir << _if (dir << _self.quick_template_directory) _isnt _unset
			_then
				>> dir
			_else
				>> _self.template_directory
			_endif

	a_previewer.set_current_layout( a_layout,
					:template_directory, template_dir,
					:measurement_unit, _self.options[:measurement_unit].default( :mm ),
					:activate_custom_properties?, activate_custom_properties?,
					:pdf_output_directory, _self.options[:pdf_output_directory] )
	
