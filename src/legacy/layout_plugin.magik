_pragma(classify_level=restricted, topic={plugins})
_method layout_plugin.quick_preview_for_map ( a_map_view, _optional a_template_name )
	## 
	## Creates a new layout based on the Tools/Options/QuickPlot/PaperSize
	## gets the current_map_view settings and figures the
	## orientation of the plot (Landscape/Portrait) and creates a
	## viewport as large as possible to fit on that piece of paper.
	## 
	# Always get the current view bounds 
	bb << a_map_view.current_view_bounds
	
	#
	# Check for existing layout 
	#
	a_layout << _unset 
	preview_app << _self.get_dialog ( :layout_preview )
	_if preview_app _isnt _unset
	_then
		lay_manager << preview_app.plugin ( :layout_manager )
		_if lay_manager _isnt _unset _andif
		    (cd << lay_manager.current_document) _isnt _unset 
		_then
			a_filename << cd.filename
		_endif
	_endif

	_if a_layout _is _unset
	_then
		# Default to landscape
		landscape? << _true 
		_if _self.options [ :page_orientation ] _is :automatic
		_then
			landscape? << bb.width > bb.height
		_elif _self.options [ :page_orientation ] _is :portrait
		_then
			landscape? << _false 
		_endif

		_if a_template_name _isnt _unset _andif
		    (_self.quick_template_directory _isnt _unset _orif
		     _self.template_directory _isnt _unset)
		_then
			_if _self.quick_template_directory _isnt _unset
			_then
				filename << write_string(_self.quick_template_directory, a_template_name)
			_else
				filename << write_string(_self.template_directory, a_template_name)
			_endif
		_else
			filename << _if a_filename _isnt _unset
				    _then
					    >> a_filename
				    _elif landscape?
				    _then
					    >> _self.options [ :default_landscape_layout ]
				    _else
					    >> _self.options [ :default_portrait_layout ]
				    _endif
		_endif
		
		a_layout << _unset 
		_if filename _isnt _unset _andif
		    system.file_exists? ( filename )
		_then 
			a_layout << layout_document.new_from_xml ( filename )
		_endif
		
		_if a_layout _is _unset 
		_then
			# Create a default layout
			a_layout << layout_document.new ( _self.default_page_size )
			a_layout.current_page.landscape? << landscape?
		_endif
	_endif 
	
	a_layout.gs_factory << _self.gs_factory
	a_layout.map_manager << _self.map_manager

	viewports << rope.new()
	_for i _over a_layout.all_elements_of( viewport_layout ).fast_elements()
	_loop
		_if i.parent_viewport _is _unset
		_then
			viewports.add(i)
		_endif
	_endloop
	
	_if viewports.empty?
	_then
		a_page << a_layout.current_page 
		inside_bounds << a_page.bounds.new_enlarging ( 0.95 )
		# relay the map_view for the new viewport to be created. This
		# will be used later on, in the method 
		# abstract_geometry_set_factory.get_geometry_set_for() to
		# derive the worlds where the geometries to be displayed are.
		a_viewport << viewport_layout.new_with ( :bounds, inside_bounds,
							 :map_view, a_map_view ) 
		a_layout.add_element ( a_viewport )
		viewports.add(a_viewport)
	_endif

	_for a_viewpt _over viewports.fast_elements()
	_loop
		_self.map_viewport_on_map_view ( a_viewpt, a_map_view, bb )
	_endloop

	_self.preview_layout ( a_layout, _true )

_endmethod
$

