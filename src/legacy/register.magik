#
# Registrar visualizador de planos.
#
smallworld_product.register_application( :visualizador_planos,
					 :application,
					 :resource_module_name,        :layout_gui,
					 :description,                 "Visualizador de planos",
					 :external_name,               "Visualizador de planos",
					 :gui_definition_file_name,    "visualizador_planos_gui.xml",
					 :config_definition_file_name, "visualizador_planos_config.xml",
					 :can_update_database?,        _false,
					 :hidden,                      _true 
                                       )
$

