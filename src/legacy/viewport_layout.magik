_pragma(classify_level=basic, topic={plotting}, usage={subclassable})
_method viewport_layout.es_plano_esquema?
   ##  
   ## Retorna true si el plano se trata de un esquema.
   ## en otro caso retorna false
  
   _if _self.class_name = :c_pagrefs_viewport_layout
   _then
      _return _true
   _else
      _return _false 	   
   _endif 

_endmethod
$
_pragma(classify_level=basic, topic={plotting}, usage={subclassable})
_method viewport_layout.es_plano_estudio_poblacion?
   ##  
   ## Objetivo. Retorna true si se trata de un plano de estudio de
   ## poblacion, en otro caso retorna false.
   _if _self.class_name = :c_vp_radios_atencion_ftth _orif
       _self.class_name = :c_vp_limites_nco_ftth _orif
       _self.class_name = :c_vp_fibras_propuestas_ftth
   _then 
	_return _true
   _endif 
 _return _false 
_endmethod
$
