_package sw
$
viewport_layout.define_shared_variable(:data_vp_copy,_unset,:public )
$
viewport_layout.define_shared_variable(:geoms_symb_anotac, _unset , :public)
$
viewport_layout.define_shared_variable(:Lista_Objs_geoms_symb_anotac, _unset , :public)
$

_pragma(classify_level=restricted, usage={redefinable})
_method viewport_layout.actualizar_geoms_symbols_size()
## Objetivo: Actualizar los atributos,  con los valores de la variable
## data_vp_copy, este metodo es invocado cuando copia-pega un
## elemento de tipo viewport_layout en una pagina del layout_designer
##	
    _if  (datos << _self.data_vp_copy) _isnt _unset
    _then
	    _if (l_symbols_size << datos[:geoms_symbols_size]) _isnt _unset 
	    _then
		    _self.geoms_symbols_size << property_list.new_from_with_deep_copy(l_symbols_size)	    
	    _endif
	    _if (l_elementos_mod << datos[:elementos_modificados]) _isnt _unset 
	    _then
		    _self.elementos_modificados << property_list.new_from_with_deep_copy(l_elementos_mod)
	    _endif
	    _if (l_elementos_gis << datos[:elementos_bd_gis]) _isnt _unset 
	    _then
		    _self.elementos_bd_gis << property_list.new_from_with_deep_copy(l_elementos_gis)
	    _endif
	    _if (l_elementos_lb << datos[:elementos_bd_lb]) _isnt _unset 
	    _then
		    _self.elementos_bd_lb << property_list.new_from_with_deep_copy(l_elementos_lb)
	    _endif
    _endif	
    
_endmethod
$
_pragma(classify_level=basic, topic={plotting}, usage={subclassable})
_method viewport_layout.agrega_lista_elementos_falc()
	## 
	## 
	## fhramire 08-Agosto-2011
	## Se agregan los elementos FALC para la escalacion y
	## movimientos de elementos. Version 11.7.2.1	
	lista1 << property_list.new_with(:cedo_simbolo,1,            
				          :cedo_anotacion,1,
					  :cedo_rot,1,
					  :cedo_hor,1,
					  :cedo_ver,1,				       
					  :reserva_fo_simbolo,1,			       
					  :reserva_fo_anotacion,1,
					  :reserva_fo_rot,1,
					  :reserva_fo_hor,1,
					  :reserva_fo_ver,1,				       
					  :terminal_fo_simbolo,1,           
					  :terminal_fo_anotacion,1,
					  :terminal_fo_rot,1,
					  :terminal_fo_hor,1,
					  :terminal_fo_ver,1,				       			 
					  :ont_anotacion,1,
					  :ont_rot,1,
					  :ont_hor,1,
					  :ont_ver,1,				       	       
					  :limite_opt_anotacion,1,     
					  :limite_opt_rot,1,
					  :limite_opt_hor,1,
					  :limite_opt_ver,1
				 )

	## Se agregan los elementos FALC para el control de apagado y
	## prendido de capas en el plano, quedan en la lista 8.
	lista2 << property_list.new_with(		
			  :cedo_simbolo_vista,_false,
			  :cedo_anotacion_vista,_false,
			  :reserva_fo_simbolo_vista, _false,
			  :reserva_fo_anotacion_vista, _false,
			  :terminal_fo_simbolo_vista, _false,
			  :terminal_fo_anotacion_vista, _false,
			  :ont_anotacion_vista, _false,
			  :limite_opt_anotacion_vista, _false 
				)
	
	_return lista1, lista2
	
_endmethod
$
_pragma(classify_level=basic, topic={plotting}, usage={subclassable})
_method viewport_layout.asigna_lista_simbolos(LoLista_datos) 
   ##  
   ## Objetivo.- Se construye el property_list, desde un xml
   ## donde se toman los valores tales como: caja_simbolo, central_anotacion,
   ## :caja_simbolo,1  asingandole 1 que es la escala inicial.
   ## Retorna un rope con las lista de nombres.
	 
  Lista_nombres_campos << property_list.new()
  
  _for elemento _over LoLista_datos.fast_elements()
  _loop 
    _for k,e _over elemento.fast_keys_and_elements()
    _loop 
       _for i,j _over e.fast_keys_and_elements()
       _loop		
	      Lista_nombres_campos[i] << j  
       _endloop
    _endloop
  _endloop  
  
  _return Lista_nombres_campos
_endmethod
$
_pragma(classify_level=basic, topic={plotting}, usage={subclassable})
_method viewport_layout.defined_attributes
	## 
	## 

	attribs << rope.new_from ( _super.defined_attributes )

	attribs.add ( layout_attribute_definition.new ( :name, :string,
							:description, "Name",
							:default_value, _unset ) )
	
	attribs.add ( layout_attribute_definition.new ( :coordinate_system, :string,
							:description, "Coordinate System of Centre",
							:allowed_on_properties_page?, _false,
							:default_value, _unset ) )
	
	attribs.add ( layout_attribute_definition.new ( :centre_x, :coordinate,
							:description, "Centre X",
							:default_value, 0.0 ) )
	
	attribs.add ( layout_attribute_definition.new ( :centre_y, :coordinate,
							:description, "Centre Y",
							:default_value, 0.0 ) )
	
	attribs.add ( layout_attribute_definition.new ( :view_scale, :float,
							:description, "Scale",
							:value_mgr, scale_value_manager.new_with_properties(:value_required?,_true),
							:enum_method, :enum_view_scales,
							:editor, in_place_combo_editor,
							:default_value, 1.0 ) )

	attribs.add ( layout_attribute_definition.new ( :view_angle, :float,
							:description, "Angle",
							:enum_method, :enum_view_angles,
							:value_mgr, unit_value_manager.new ( unit_manager.unit ( :degree ) ),
							:editor, in_place_combo_editor,
							:get_method, :view_angle_value,
							:set_method, :|view_angle_value<<|,
							:default_value, 0.0 ) )
	
	attribs.add ( layout_attribute_definition.new ( :projection, :string,
							:description, "View Projection",
							:default_value, _unset,
							:enum_method, :enum_projections ) )

	attribs.add ( layout_attribute_definition.new ( :soc_name, :string,
							:description, "SOC Name",
							:default_value, _unset,
							:allowed_on_properties_page?, _false ) )
	
	attribs.add ( layout_attribute_definition.new ( :ace_name, :string,
							:description, "Ace name",
							:default_value, "Default",
							:enum_method, :enum_ace_names ) )
	
	attribs.add ( layout_attribute_definition.new ( :display_style, :string,
							:description, "Display style",
							:default_value, "Auto",
							:enum_method, :enum_display_styles ) )

	attribs.add ( layout_attribute_definition.new ( :draw_scale, :float,
							:description, "Magnification draw scale",
							:default_value, _unset,
							:allowed_on_properties_page?, _false ) )
	
	attribs.add ( layout_attribute_definition.new ( :style_system_category, :string,
							:description, "Style Category",
							:default_value, "default",
							:enum_method, :enum_style_categories ) )

	attribs.add ( layout_attribute_definition.new ( :universe_id, :integer,
							:description, "Universe ID",
							:default_value, -1,
							:allowed_on_properties_page?, _false ) )
	
	attribs.add ( layout_attribute_definition.new ( :world_id, :integer,
							:description, "World ID",
							:default_value, -1,
							:allowed_on_properties_page?, _false ) )
	
	attribs.add ( layout_attribute_definition.new ( :trail, :boolean,
							:description, "Trail",
							:default_value, _true ) )

	attribs.add ( layout_attribute_definition.new ( :selection, :boolean,
							:description, "Selection",
							:default_value, _true ) )
	
	attribs.add ( layout_attribute_definition.new ( :post_render, :boolean,
							:description, "Post Render",
							:default_value, _true ) )

	attribs.add ( layout_attribute_definition.new ( :geoms_symbols_size, :unset,
							:description, "Geometrias",
							:default_value, _unset  ,
							:allowed_on_properties_page?, _false ) )
	
		
	>> attribs
	
_endmethod
$
